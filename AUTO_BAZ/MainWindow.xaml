<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AUTO_BAZ"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        x:Class="AUTO_BAZ.MainWindow"
        mc:Ignorable="d"
        FontFamily="pack://application:,,,/AUTO_BAZ;component/Assets/#IRANYekanFN"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        Title="بازسازی" MinWidth="800" MinHeight="600" 
        Loaded="Window_Loaded" WindowStartupLocation="CenterScreen" ContentRendered="Window_ContentRendered" Height="600" Width="1125">

    <Window.Resources>
        <AlternationConverter x:Key="BackgroundConverter">
            <SolidColorBrush Color="#FFF9F9F9" />
            <SolidColorBrush Color="White" />
        </AlternationConverter>

        <Style x:Key="HistoryItemStyle" TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource MaterialDesignListBoxItem}">
            <Setter Property="Background" Value="{Binding RelativeSource={RelativeSource Self}, Path=(ItemsControl.AlternationIndex), Converter={StaticResource BackgroundConverter}}"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>

        <Style x:Key="SmallCircularProgress" TargetType="ProgressBar" BasedOn="{StaticResource MaterialDesignCircularProgressBar}">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Foreground" Value="#FF0389C7"/>
        </Style>

        <Style x:Key="SmallProgressLabel" TargetType="Label">
            <Setter Property="Visibility" Value="Hidden"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="HeaderTextStyle" TargetType="Label">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF333333"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="mygrid" Margin="-1,0,1,0" DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
        <Border Background="#FFF0F2F5" CornerRadius="12" BorderBrush="#E0E0E0" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border x:Name="TitleDrawBar" Background="{Binding Background, ElementName=GENERAL_RANG, FallbackValue=#FF0389C7}" CornerRadius="11,11,0,0" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                    <Grid>
                        <Label x:Name="LBL_HEADER" Content="اتوباز" Foreground="White" FontWeight="Bold" FontSize="16" Margin="20,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center">
                            <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="White" Height="30" Width="40" Padding="0" IsTabStop="False">
                                <materialDesign:PackIcon Kind="WindowMinimize" Width="20" Height="20"/>
                            </Button>
                            <Button x:Name="Btn_Max" Click="Btn_Max_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="White" Height="30" Width="40" Padding="0" IsTabStop="False">
                                <materialDesign:PackIcon Kind="WindowMaximize" Width="20" Height="20"/>
                            </Button>
                            <Button x:Name="Btn_Close" Click="Btn_Close_Click" Style="{StaticResource MaterialDesignFlatButton}" Foreground="White" Height="30" Width="40" Padding="0" IsTabStop="False">
                                <materialDesign:PackIcon Kind="WindowClose" Width="20" Height="20"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Button x:Name="GENERAL_RANG" Tag="RD" Visibility="Collapsed" Background="#FF03A9F4"/>

                <Grid Grid.Row="1" Margin="15" FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280"/>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="335"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <materialDesign:Card Grid.Row="0" UniformCornerRadius="10" Padding="20" Background="#FF2A99CC" Foreground="White" Margin="0,0,0,15" materialDesign:ElevationAssist.Elevation="Dp3">
                            <StackPanel>
                                <Label x:Name="YEAR_LBL" Content="نام شرکت و سال مالی" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20" Foreground="White"/>

                                <Button x:Name="BtnCNNConf" Click="BtnCNNConf_Click" Background="White" Foreground="#FF0389C7" Height="45" materialDesign:ButtonAssist.CornerRadius="8" Cursor="Hand" Margin="0,0,0,20">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="DatabaseSettings" Width="24" Height="24" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="اتصال به سرور" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <TextBlock x:Name="SERVER_NAME_LBL" Text="MERCEDES\SQL2019 Yazdsepar1401" TextAlignment="Center" TextWrapping="Wrap" FontSize="13" Opacity="0.9"/>
                                <TextBlock Text="نسخه 1404/12/03 • 1.4.6" TextAlignment="Center" FontSize="11" Opacity="0.7" Margin="0,15,0,0"/>
                            </StackPanel>
                        </materialDesign:Card>

                        <materialDesign:Card Grid.Row="1" UniformCornerRadius="10" Padding="15" materialDesign:ElevationAssist.Elevation="Dp1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                    <materialDesign:PackIcon Kind="Cog" Foreground="#FF0389C7" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Label Content="تنظیمات پردازش" Style="{StaticResource HeaderTextStyle}"/>
                                </StackPanel>

                                <CheckBox x:Name="UseParallelProcessing" Foreground="#FF7A7A7A" Content="پردازش موازی (Parallel)" IsChecked="True" Margin="0,5" Click="UseParallelProcessing_Click" Cursor="Hand"/>
                                <CheckBox x:Name="chkUseSmartThrottling" Content="پردازش با حداقل ظرفیت" ToolTip="بررسی هوشمند ظرفیت CPU" IsChecked="False" Margin="0,5" Click="chkUseSmartThrottling_Click" Cursor="Hand"/>

                                <Grid Margin="0,15,0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="تعداد روز بازگشت:" VerticalAlignment="Center" Foreground="#555"/>
                                    <TextBox x:Name="daysb" Grid.Column="1" Text="365" Foreground="#D81A1A1A" BorderThickness="0,0,0,0" Background="#FFF2F2F2" Style="{StaticResource MaterialDesignOutlinedTextBox}" TextAlignment="Center" Height="35" Padding="0,5" PreviewLostKeyboardFocus="daysb_PreviewLostKeyboardFocus"/>

                                </Grid>

                                <Grid Margin="0,5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="تعداد تکرار:" VerticalAlignment="Center" Foreground="#555"/>
                                    <TextBox x:Name="repeatb" Foreground="#D81A1A1A" BorderThickness="0,0,0,0" Background="#FFF2F2F2" Grid.Column="1" Text="1" Style="{StaticResource MaterialDesignOutlinedTextBox}" TextAlignment="Center" Height="35" Padding="0,5" PreviewLostKeyboardFocus="repeatb_PreviewLostKeyboardFocus"/>
                                </Grid>

                                <CheckBox x:Name="FORMOL" Visibility="Collapsed" IsChecked="True"/>
                                <CheckBox x:Name="defacc" Visibility="Collapsed" IsChecked="True" Click="defacc_Click"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </Grid>

                    <Grid Grid.Column="1" Margin="5,0,5,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <UniformGrid Columns="3" Grid.Row="0" Margin="0,0,0,15">
                            <materialDesign:Card UniformCornerRadius="8" Padding="15" Margin="5" materialDesign:ElevationAssist.Elevation="Dp1">
                                <StackPanel>
                                    <TextBlock x:Name="Text19" Text="0" FontSize="28" FontWeight="Bold" Foreground="#FF0389C7" HorizontalAlignment="Center"/>
                                    <TextBlock Text="تعداد پردازش" Foreground="#777" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </materialDesign:Card>
                            <materialDesign:Card UniformCornerRadius="8" Padding="15" Margin="5" materialDesign:ElevationAssist.Elevation="Dp1">
                                <StackPanel>
                                    <TextBlock x:Name="co" Text="0" FontSize="28" FontWeight="Bold" Foreground="#FF0389C7" HorizontalAlignment="Center"/>
                                    <TextBlock Text="کد کالا" Foreground="#777" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </materialDesign:Card>
                            <materialDesign:Card UniformCornerRadius="8" Padding="15" Margin="5" materialDesign:ElevationAssist.Elevation="Dp1">
                                <StackPanel>
                                    <TextBlock x:Name="Text23" Text="0" FontSize="28" FontWeight="Bold" Foreground="#FF0389C7" HorizontalAlignment="Center"/>
                                    <TextBlock Text="تعداد کالا" Foreground="#777" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </materialDesign:Card>
                        </UniformGrid>

                        <materialDesign:Card Grid.Row="1" UniformCornerRadius="10" Padding="20" Margin="5,0,5,5" materialDesign:ElevationAssist.Elevation="Dp1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20" Cursor="Hand" PreviewMouseLeftButtonDown="StackPanel_PreviewMouseLeftButtonDown">
                                    <materialDesign:PackIcon Kind="CheckAll" Foreground="#FF03A9F4" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Label x:Name="lblchecks" Content="انتخاب همه اسناد و عملیات" Style="{StaticResource HeaderTextStyle}"/>
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <UniformGrid Columns="2">

                                        <StackPanel Orientation="Horizontal" Margin="0,10" Cursor="Hand" MinWidth="150">
                                            <Grid Width="40" Height="40" Margin="0,0,10,0">
                                                <ProgressBar x:Name="PRGR_C0" Style="{StaticResource SmallCircularProgress}" FlowDirection="LeftToRight"/>
                                                <Label x:Name="LBL_C0" Content="0.00%" Style="{StaticResource SmallProgressLabel}"/>
                                            </Grid>
                                            <CheckBox x:Name="C0" Content="باز سازی نرخ میانگین" Click="C0_Click" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,10" Cursor="Hand" MinWidth="150">
                                            <Grid Width="40" Height="40" Margin="0,0,10,0">
                                                <ProgressBar x:Name="PRGR_C6" Style="{StaticResource SmallCircularProgress}" FlowDirection="LeftToRight"/>
                                                <Label x:Name="LBL_C6" Content="0.00%" Style="{StaticResource SmallProgressLabel}"/>
                                            </Grid>
                                            <CheckBox x:Name="c6" Content="سند خروج سایر" Click="c6_Click" VerticalAlignment="Center" Cursor="Hand"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,10" Cursor="Hand" MinWidth="150">
                                            <Grid Width="40" Height="40" Margin="0,0,10,0">
                                                <ProgressBar x:Name="PRGR_C00" Style="{StaticResource SmallCircularProgress}" FlowDirection="LeftToRight"/>
                                                <Label x:Name="LBL_C00" Content="0.00%" Style="{StaticResource SmallProgressLabel}"/>
                                            </Grid>
                                            <CheckBox x:Name="C00" Content="باز سازی موجودی انبار" Click="C00_Click" VerticalAlignment="Center" Cursor="Hand"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,10" Cursor="Hand" MinWidth="150">
                                            <Grid Width="40" Height="40" Margin="0,0,10,0">
                                                <ProgressBar x:Name="PRGR_C7" Style="{StaticResource SmallCircularProgress}" FlowDirection="LeftToRight"/>
                                                <Label x:Name="LBL_C7" Content="0.00%" Style="{StaticResource SmallProgressLabel}"/>
                                            </Grid>
                                            <CheckBox x:Name="c7" Content="سند تولید ورود" Click="c7_Click" VerticalAlignment="Center" Cursor="Hand"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,10" Cursor="Hand" MinWidth="150">
                                            <Grid Width="40" Height="40" Margin="0,0,10,0">
                                                <ProgressBar x:Name="PRGR_C1" Style="{StaticResource SmallCircularProgress}" FlowDirection="LeftToRight"/>
                                                <Label x:Name="LBL_C1" Content="0.00%" Style="{StaticResource SmallProgressLabel}"/>
                                            </Grid>
                                            <CheckBox x:Name="c1" Content="سند فروش" Click="c1_Click" VerticalAlignment="Center" Cursor="Hand"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,10" Cursor="Hand" MinWidth="150">
                                            <Grid Width="40" Height="40" Margin="0,0,10,0">
                                                <ProgressBar x:Name="PRGR_C8" Style="{StaticResource SmallCircularProgress}" FlowDirection="LeftToRight"/>
                                                <Label x:Name="LBL_C8" Content="0.00%" Style="{StaticResource SmallProgressLabel}"/>
                                            </Grid>
                                            <CheckBox x:Name="c8" Content="سند برگشت فروش" Click="c8_Click" VerticalAlignment="Center" Cursor="Hand"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,10" Cursor="Hand" MinWidth="150">
                                            <Grid Width="40" Height="40" Margin="0,0,10,0">
                                                <ProgressBar x:Name="PRGR_C2" Style="{StaticResource SmallCircularProgress}" FlowDirection="LeftToRight"/>
                                            </Grid>
                                            <CheckBox x:Name="c2" Content="سند خرید" Click="c2_Click" VerticalAlignment="Center" Cursor="Hand"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,10" Cursor="Hand" MinWidth="150">
                                            <Grid Width="40" Height="40" Margin="0,0,10,0">
                                                <ProgressBar x:Name="PRGR_C9" Style="{StaticResource SmallCircularProgress}" FlowDirection="LeftToRight"/>
                                                <Label x:Name="LBL_C9" Content="0.00%" Style="{StaticResource SmallProgressLabel}"/>
                                            </Grid>
                                            <CheckBox x:Name="c9" Content="سند خدمات" Click="c9_Click" VerticalAlignment="Center" Cursor="Hand"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,10" Cursor="Hand" MinWidth="150">
                                            <Grid Width="40" Height="40" Margin="0,0,10,0">
                                                <ProgressBar x:Name="PRGR_C3" Style="{StaticResource SmallCircularProgress}" FlowDirection="LeftToRight"/>
                                                <Label x:Name="LBL_C3" Content="0.00%" Style="{StaticResource SmallProgressLabel}"/>
                                            </Grid>
                                            <CheckBox x:Name="c3" Content="سند خزانه" Click="c3_Click" VerticalAlignment="Center" Cursor="Hand"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,10" Cursor="Hand" MinWidth="150">
                                            <Grid Width="40" Height="40" Margin="0,0,10,0">
                                                <ProgressBar x:Name="PRGR_C10" Style="{StaticResource SmallCircularProgress}" FlowDirection="LeftToRight"/>
                                                <Label x:Name="LBL_C10" Content="0.00%" Style="{StaticResource SmallProgressLabel}"/>
                                            </Grid>
                                            <CheckBox x:Name="c10" Content="سند انبار گردانی" Click="c10_Click" VerticalAlignment="Center" Cursor="Hand"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,10" Cursor="Hand" MinWidth="150">
                                            <Grid Width="40" Height="40" Margin="0,0,10,0">
                                                <ProgressBar x:Name="PRGR_C4" Style="{StaticResource SmallCircularProgress}" FlowDirection="LeftToRight"/>
                                                <Label x:Name="LBL_C4" Content="0.00%" Style="{StaticResource SmallProgressLabel}"/>
                                            </Grid>
                                            <CheckBox x:Name="c4" Content="سند انتقالی" Click="c4_Click" VerticalAlignment="Center" Cursor="Hand"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,10" Cursor="Hand" MinWidth="150">
                                            <Grid Width="40" Height="40" Margin="0,0,10,0">
                                                <ProgressBar x:Name="PRGR_C11" Style="{StaticResource SmallCircularProgress}" FlowDirection="LeftToRight"/>
                                                <Label x:Name="LBL_C11" Content="0.00%" Style="{StaticResource SmallProgressLabel}"/>
                                            </Grid>
                                            <CheckBox x:Name="c11" Content="سند وصولی اسناد دریافتنی" Click="c11_Click" VerticalAlignment="Center" Cursor="Hand"/>
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Margin="0,10" Cursor="Hand" MinWidth="150">
                                            <Grid Width="40" Height="40" Margin="0,0,10,0">
                                                <ProgressBar x:Name="PRGR_C5" Style="{StaticResource SmallCircularProgress}" FlowDirection="LeftToRight"/>
                                                <Label x:Name="LBL_C5" Content="0.00%" Style="{StaticResource SmallProgressLabel}"/>
                                            </Grid>
                                            <CheckBox x:Name="c5" Content="سند خروج مواد" Click="c5_Click" VerticalAlignment="Center" Cursor="Hand"/>
                                        </StackPanel>

                                        <StackPanel MinWidth="150"/>

                                    </UniformGrid>
                                </ScrollViewer>

                            </Grid>
                        </materialDesign:Card>
                    </Grid>

                    <Grid Grid.Column="2" Margin="10,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <materialDesign:Card Grid.Row="0" UniformCornerRadius="10" Padding="20" Margin="0,0,0,15" materialDesign:ElevationAssist.Elevation="Dp2" Background="#FAFAFA">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,20" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Circle" Foreground="#FF03A9F4" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Label Content="وضعیت عملیات" Style="{StaticResource HeaderTextStyle}"/>
                                </StackPanel>

                                <Grid HorizontalAlignment="Center" Margin="0,10,0,30">
                                    <ProgressBar x:Name="TOGHER_PROGRESS" FlowDirection="LeftToRight" Style="{StaticResource MaterialDesignCircularProgressBar}" Value="0" Minimum="0" Maximum="100" Width="140" Height="140" Foreground="#FF03A9F4"/>
                                    <Label x:Name="COUNTER_TXBL" Content="0.00%" FontSize="24" Foreground="#333" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="LetsGoBtn" Grid.Column="0" Content="شروع" Click="LetsGoBtn_Click" Background="#FF03A9F4" BorderBrush="{x:Null}" Foreground="White" Height="45" materialDesign:ButtonAssist.CornerRadius="8" FontSize="14" />
                                    <Button x:Name="Btn_DoCancel" Grid.Column="2" Content="توقف" Click="Btn_DoCancel_Click" Background="#FFE27C7C" BorderBrush="{x:Null}" Foreground="White" Height="45" materialDesign:ButtonAssist.CornerRadius="8" FontSize="14" IsEnabled="False"/>
                                </Grid>
                            </StackPanel>
                        </materialDesign:Card>

                        <materialDesign:Card Grid.Row="1" UniformCornerRadius="10" Padding="15" materialDesign:ElevationAssist.Elevation="Dp1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel x:Name="HRSTK1" Orientation="Horizontal" Margin="0,0,0,15" Cursor="Hand" PreviewMouseLeftButtonDown="HRSTK1_PreviewMouseLeftButtonDown">
                                    <materialDesign:PackIcon Kind="History" Foreground="#FFE8B502" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Label Content="سوابق بازسازی" Style="{StaticResource HeaderTextStyle}"/>
                                </StackPanel>

                                <ListBox x:Name="List5" Grid.Row="1" ItemsSource="{Binding LST_DATA5}" AlternationCount="2" ItemContainerStyle="{StaticResource HistoryItemStyle}" Background="Transparent" BorderThickness="0" d:ItemsSource="{d:SampleData ItemCount=10}"/>
                            </Grid>
                        </materialDesign:Card>
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" CornerRadius="12"/>
    </WindowChrome.WindowChrome>
</Window>