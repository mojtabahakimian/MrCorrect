<Window x:Class="AUTO_BAZ.WinConnectionChoose"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AUTO_BAZ"
        mc:Ignorable="d"
        Topmost="True"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        FontFamily="pack://application:,,,/AUTO_BAZ;component/Assets/#IRANYekanFN"
        WindowStartupLocation="CenterScreen"
        Background="{x:Null}" AllowsTransparency="True"
        AllowDrop="True"
        WindowStyle="None" MinWidth="400" MinHeight="320"
        Title="WinConnectionChoose" Height="385" Width="664" Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="BordG" TargetType="{x:Type Border}">
            <Setter Property="CornerRadius" Value="10,10,0,0" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="129*"/>
            <ColumnDefinition Width="157*"/>
            <ColumnDefinition Width="65*"/>
            <ColumnDefinition Width="168*"/>
            <ColumnDefinition Width="146*"/>
        </Grid.ColumnDefinitions>
        <Border CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5"	  Background="{StaticResource MaterialDesignPaper}" BorderBrush="{Binding ElementName=GENERAL_RANG,Path=Background}"   Grid.ColumnSpan="5" BorderThickness="1,0,1,1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding ElementName=GENERAL_RANG,Path=Background}" Margin="-8,-8,-8,0" VerticalAlignment="Top" MinHeight="50" UseLayoutRounding="False" Height="23" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Button x:Name="Btn_Close" Margin="0,15,10,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="20" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" Grid.Column="4" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,15,39,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="20" VerticalAlignment="Top" HorizontalAlignment="Right" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" Grid.Column="4" >
                        <materialDesign:PackIcon Kind="WindowRestore" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,15,68,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="20" VerticalAlignment="Top" HorizontalAlignment="Right" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" Grid.Column="3" Grid.ColumnSpan="2" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Button x:Name="Btn_TestConnection" Content="تست اتصال" Margin="3,270,3,0" Cursor="Hand"    Height="36" VerticalAlignment="Top" TabIndex="5" Grid.Column="1" Foreground="#DDFFFFFF" FontSize="11" Click="Btn_TestConnection_Click"/>
        <TextBox x:Name="Textbox_Servername" Visibility="Hidden"   Padding="3" HorizontalAlignment="Left" Height="26" Margin="13,94,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="158"  Text="{Binding SelectedItem, ElementName=ServerChooser}" TabIndex="0" Grid.ColumnSpan="2" Grid.Column="1"/>
        <Label Content="نام یا آیپی سرور :"  HorizontalAlignment="Right" Margin="0,94,58,0" VerticalAlignment="Top" Width="93"  FlowDirection="RightToLeft" Height="27" Grid.Column="3" Grid.ColumnSpan="2"/>
        <Label Content="نام دیتابیس :" Margin="0,130,76,0" VerticalAlignment="Top"  FlowDirection="RightToLeft" Height="27" HorizontalAlignment="Right" Width="75" Grid.Column="3" Grid.ColumnSpan="2"/>
        <Label IsEnabled="{Binding IsChecked, ElementName=rd_SqlAuth}" Content="نام کاربری :" Margin="0,164,87,0" VerticalAlignment="Top"  FlowDirection="RightToLeft" Height="27" HorizontalAlignment="Right" Width="66" Grid.Column="3" Grid.ColumnSpan="2"/>
        <TextBox x:Name="Textbox_Dataname" Visibility="Hidden"   Padding="3" HorizontalAlignment="Left" Height="23" Margin="-13,71,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="158"  Text="" TabIndex="1" Grid.ColumnSpan="2"/>
        <TextBox IsEnabled="{Binding IsChecked, ElementName=rd_SqlAuth}"    Padding="3" x:Name="Textbox_DataUsername" Height="23" Margin="13,167,68,0" TextWrapping="Wrap" VerticalAlignment="Top"  TabIndex="2" Grid.ColumnSpan="3" Grid.Column="1"/>
        <Button x:Name="Btn_SaveConnection" Content="تایید" Margin="3,270,4,0" Cursor="Hand"      Height="36" VerticalAlignment="Top" FontWeight="Bold" TabIndex="6" Grid.Column="3" FontSize="11" Foreground="#DDFFFFFF" Click="Btn_SaveConnection_Click"/>
        <Label  IsEnabled="{Binding IsChecked, ElementName=rd_SqlAuth}" Content="رمز عبور :" Margin="0,196,98,0" VerticalAlignment="Top"  FlowDirection="RightToLeft" Height="27" HorizontalAlignment="Right" Width="53" Grid.Column="3" Grid.ColumnSpan="2"/>
        <TextBox IsEnabled="{Binding IsChecked, ElementName=rd_SqlAuth}"  Padding="3" x:Name="Textbox_Datapass" Height="23" Margin="13,202,68,0" TextWrapping="Wrap" VerticalAlignment="Top"  TabIndex="3" Grid.ColumnSpan="3" Grid.Column="1"/>
        <RadioButton x:Name="rd_SqlAuth" GroupName="auth" Content="SQL Athentication" Margin="0,238,0,0" VerticalAlignment="Top" IsChecked="True" HorizontalAlignment="Center" Width="137" Grid.Column="3" Height="23"/>
        <RadioButton x:Name="rd_WinAuth" GroupName="auth" Content="Windows Athentication" Margin="0,238,0,0" VerticalAlignment="Top" IsChecked="True" TabIndex="4" HorizontalAlignment="Center" Width="144" Grid.Column="1" Height="23"/>
        <ComboBox x:Name="ServerChooser" TextBoxBase.TextChanged="ServerChooser_TextChanged"  Padding="7,3,10,3"  Margin="13,94,68,0" VerticalAlignment="Top" Height="26"   SelectedIndex="0" Foreground="#FF252526" FlowDirection="RightToLeft" IsEditable="True" IsTextSearchEnabled="True" ToolTip="نام سرور رو انتخاب کنید یا  اسم یا آیپی شبکه" Grid.ColumnSpan="3" Grid.Column="1" SelectionChanged="ServerChooser_SelectionChanged" >
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <ComboBox x:Name="DbChooser"  Padding="7,3,10,3"  IsTextSearchEnabled="True" Margin="13,130,68,0" VerticalAlignment="Top" Height="27"   IsEditable="True" SelectedIndex="0" Foreground="#FF252526" FlowDirection="RightToLeft" Grid.ColumnSpan="3" Grid.Column="1" DropDownOpened="DbChooser_DropDownOpened">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <Label Content="اتصال به سرور"   HorizontalContentAlignment="Center" Margin="0,50,0,0" VerticalAlignment="Top"  FlowDirection="RightToLeft" FontSize="16" Foreground="#E51B1B1C" Height="34" Grid.ColumnSpan="5" PreviewMouseLeftButtonDown="Label_PreviewMouseLeftButtonDown"/>

        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="109,204,15,149"/>
        <Button x:Name="Btn_GetServers"  Style="{StaticResource MaterialDesignFlatButton}" Content="دریافت سرور ها" HorizontalAlignment="Center" Margin="0,89,0,0" VerticalAlignment="Top" Height="31" Width="108" Click="Btn_GetServers_Click" FontSize="11" Foreground="#FF1A1A1A" Background="{x:Null}" BorderBrush="{x:Null}"/>
        <Label x:Name="lblconnecting" Visibility="Hidden" Content=". . . در حال تست" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#D8252526" Foreground="White"  FontSize="22" Grid.ColumnSpan="5"/>
    </Grid>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
</Window>
