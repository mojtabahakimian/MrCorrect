<Window x:Class="Prg_UI.HelperWins.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="پالودن با متن سفارشی"
        Width="500" Height="270"
        MinWidth="440" MinHeight="250"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource IRANYEKAN}"
        FlowDirection="RightToLeft"
        PreviewKeyDown="Window_PreviewKeyDown"
        ContentRendered="Window_ContentRendered">
    <Border Margin="12"
            Padding="0"
            CornerRadius="10"
            Background="{DynamicResource MaterialDesign.Brush.Background}"
            BorderBrush="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"
            BorderThickness="1"
            materialDesign:ShadowAssist.ShadowDepth="Depth3">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    CornerRadius="9,9,0,0"
                    Background="{Binding AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                        <materialDesign:PackIcon Kind="TextSearch" Width="20" Height="20" Foreground="White"/>
                        <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Foreground="White"
                                   FontWeight="SemiBold" Text="پالودن با متن سفارشی"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Left" Width="36" Height="36" Margin="4,0"
                            Background="Transparent" BorderThickness="0" Foreground="White"
                            ToolTip="بستن" Click="Cancel_Click">
                        <materialDesign:PackIcon Kind="Close" Width="19" Height="19"/>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="22,18,22,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                           Text="عبارت مورد نظر را وارد کنید. تفاوت فاصله، نیم‌فاصله و نویسه‌های ی و ک فارسی/عربی نادیده گرفته می‌شود."/>

                <TextBox x:Name="SearchTextBox" Grid.Row="1" Height="48" Margin="0,16,0,0"
                         Padding="10,4" FontSize="13" TextAlignment="Right"
                         VerticalContentAlignment="Center"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="متن جست‌وجو"
                         materialDesign:TextFieldAssist.HasClearButton="True"/>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                    <Button Content="انصراف" Width="92" Height="38" Margin="8,0,0,0"
                            Style="{StaticResource MaterialDesignFlatButton}" Click="Cancel_Click"/>
                    <Button Content="اعمال پالودن" Width="118" Height="38"
                            Style="{StaticResource MaterialDesignRaisedButton}" Click="Apply_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
