<Window x:Class="Prg_UI.HelperWins.Win_CustomTextSearch"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="پالودن با : سفارشی متنی"
        Height="420" Width="460"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="{x:Null}"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        FontFamily="{StaticResource IRANYEKAN}"
        FlowDirection="RightToLeft"
        PreviewKeyDown="RootWindow_PreviewKeyDown">
    <Border Background="{DynamicResource MaterialDesign.Brush.Background}"
            BorderBrush="{DynamicResource MaterialDesignDivider}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- نوار عنوان -->
            <Border Grid.Row="0" Background="{DynamicResource MaterialDesign.Brush.Primary}"
                    CornerRadius="10,10,0,0" Height="40" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Label Content="پالودن با : سفارشی متنی" Foreground="White" Padding="14,0,0,0"
                           VerticalAlignment="Center" FontWeight="Bold"/>
                    <Button x:Name="Btn_Close" Click="Btn_Close_Click" Width="24" Height="24" Margin="0,0,10,0"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Background="Transparent"
                            BorderBrush="{x:Null}" IsTabStop="False">
                        <materialDesign:PackIcon Kind="WindowClose" Foreground="White" Width="18" Height="18"/>
                    </Button>
                </Grid>
            </Border>

            <!-- بدنه -->
            <StackPanel Grid.Row="1" Margin="16,16,16,8">

                <TextBlock Text="جستجو در ستون‌های زیر (حداقل یکی را انتخاب کنید):" Margin="0,0,0,6"
                           Foreground="{DynamicResource MaterialDesignBody}" FontWeight="Bold" FontSize="12"/>

                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="4" Padding="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="110">
                        <WrapPanel x:Name="Panel_Columns"/>
                    </ScrollViewer>
                </Border>

                <TextBox x:Name="Txt_SearchInput" materialDesign:HintAssist.Hint="متن جستجو" Margin="0,12,0,0"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         FontSize="14" Padding="8" AcceptsReturn="False"
                         PreviewKeyDown="Txt_SearchInput_PreviewKeyDown"/>

                <CheckBox x:Name="Chk_Exclude" Content="نتایجی که شامل این متن هستند حذف شوند (فیلتر منفی)"
                          Margin="0,10,0,0" Foreground="{DynamicResource MaterialDesignBody}"/>

                <TextBlock x:Name="Txt_ValidationError" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                           Foreground="#FFD32F2F" Visibility="Collapsed"/>

                <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.7" Margin="0,10,0,0"
                           Foreground="{DynamicResource MaterialDesignBody}"
                           Text="نکته: این جستجو تفاوت نیم‌فاصله و حروف عربی/فارسی (ی، ک) را نادیده می‌گیرد و کلمات به‌صورت مستقل جستجو می‌شوند."/>
            </StackPanel>

            <!-- دکمه‌ها -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="16,0,16,16">
                <Button x:Name="Btn_Cancel" Content="انصراف" Click="Btn_Cancel_Click" Width="90" Margin="8,0,0,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
                <Button x:Name="Btn_Ok" Content="جستجو" Click="Btn_Ok_Click" Width="90" IsDefault="True"
                        Style="{StaticResource MaterialDesignRaisedButton}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>