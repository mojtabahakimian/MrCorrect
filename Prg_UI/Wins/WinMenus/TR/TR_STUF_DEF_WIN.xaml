                                            <TextBlock x:Name="TXT_COUNT_REWARDS" Text="0" Foreground="White" FontSize="10"/>
                                        </Border>
                                    </StackPanel>
                                </TabItem.Header>
                                <Grid FlowDirection="RightToLeft">
                                    <syncfusion:SfDataGrid x:Name="SF_REWARDS" 
                                            ItemsSource="{Binding REWARDS_DATA}" 
