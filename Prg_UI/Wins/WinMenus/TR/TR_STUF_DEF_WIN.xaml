<Window x:Class="Prg_UI.Wins.WinMenus.TR.TR_STUF_DEF_WIN"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.TR"
        mc:Ignorable="d"
        
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:sfusion="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:VLD="clr-namespace:Prg_UI.Validatory"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="{StaticResource IRANYEKAN}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        Title="" Height="720" Width="1740" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>

        <!-- Style for SfDataGrid -->
        <Style x:Key="KDG"  TargetType="syncfusion:SfDataGrid" BasedOn="{StaticResource SfDataGridStyle}">
            <Setter Property="CurrentCellBorderBrush" Value="{StaticResource GENERAL_Grlicom}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="BorderBrush" Value="{StaticResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="HeaderRowHeight" Value="40" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="GridLinesVisibility" Value="Both" />
        </Style>
        <!-- Modified Column Header Style -->
        <Style x:Key="KDGHeader" TargetType="syncfusion:GridHeaderCellControl" BasedOn="{StaticResource GridHeaderCellControlStyle}">
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="BorderBrush" Value="{Binding Background, ElementName=GENERAL_RANG}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="Auto"/>
        </Style>

        <Style TargetType="sfusion:GridCell" BasedOn="{StaticResource GridCellStyle}">
            <Setter Property="BorderBrush" Value="{Binding BorderBrush, ElementName=GENERAL_RANG}" />
        </Style>

        <Style x:Key="SFCELL" TargetType="sfusion:GridCell" BasedOn="{StaticResource GridCellStyle}">
            <Setter Property="BorderBrush" Value="{Binding BorderBrush, ElementName=GENERAL_RANG}" />
            <Setter Property="BorderThickness" Value="0.6" />
        </Style>


        <!-- Header style: clean -->
        <Style x:Key="KDGHeader_Fluent"
               TargetType="syncfusion:GridHeaderCellControl"
               BasedOn="{StaticResource GridHeaderCellControlStyle}">
            <Setter Property="Background" Value="{StaticResource MaterialDesignPaper}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="FontWeight" Value="SemiBold" />

            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{StaticResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>


        <Style x:Key="FluentDataGridStyle" TargetType="syncfusion:SfDataGrid" BasedOn="{StaticResource SfDataGridStyle}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HeaderRowHeight" Value="45"/>
            <Setter Property="RowHeight" Value="38"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HeaderStyle">
                <Setter.Value>
                    <Style TargetType="syncfusion:GridHeaderCellControl" BasedOn="{StaticResource GridHeaderCellControlStyle}">
                        <Setter Property="Background" Value="#F8F9FA"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="#455A64"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#ECEFF1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentGroupBox" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryHueMidBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}"/>
            <Setter Property="FontFamily" Value="{StaticResource IRANYEKAN}"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Border Container -->
                            <Border Grid.Row="0" 
                            Grid.RowSpan="2"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Background="{StaticResource MaterialDesignPaper}"
                            Margin="0,0,0,0" BorderThickness="0,2,0,0"/>

                            <!-- Header -->
                            <Border Grid.Row="0" 
                            HorizontalAlignment="Right" FlowDirection="RightToLeft"
                            Background="{StaticResource MaterialDesignPaper}"
                            Margin="20,-12,-2,1" Padding="7,0,0,0">
                                <DockPanel>
                                    <ContentPresenter ContentSource="Header" 
                                            RecognizesAccessKey="True"
                                            TextBlock.Foreground="{TemplateBinding BorderBrush}"
                                            TextBlock.FontWeight="SemiBold"
                                            TextBlock.FontSize="14"
                                            VerticalAlignment="Center"/>
                                    <materialDesign:PackIcon Kind="FileDocumentOutline" 
                                                    Width="20" 
                                                    Height="20"
                                                    VerticalAlignment="Center"
                                                    Foreground="{TemplateBinding BorderBrush}"
                                                    DockPanel.Dock="Right"
                                                    Margin="0,0,2,0"/>
                                </DockPanel>
                            </Border>

                            <!-- Content -->
                            <ContentPresenter Grid.Row="1" 
                                    Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FluentGroupBox2" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryHueMidBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}"/>
            <Setter Property="FontFamily" Value="{StaticResource IRANYEKAN}"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Border Container -->
                            <Border Grid.Row="0" 
                          Grid.RowSpan="2"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          Background="{StaticResource MaterialDesignPaper}"
                          Margin="0,0,0,0" BorderThickness="0,2,0,0"/>

                            <!-- Header -->
                            <Border Grid.Row="0" 
                          HorizontalAlignment="Right" FlowDirection="RightToLeft"
                          Background="{StaticResource MaterialDesignPaper}"
                          Margin="20,-12,-2,1" Padding="7,0,0,0">
                                <DockPanel>
                                    <ContentPresenter ContentSource="Header" 
                                          RecognizesAccessKey="True"
                                          TextBlock.Foreground="{TemplateBinding BorderBrush}"
                                          TextBlock.FontWeight="SemiBold"
                                          TextBlock.FontSize="14"
                                          VerticalAlignment="Center"/>
                                    <materialDesign:PackIcon Kind="ViewList" 
                                                  Width="20" 
                                                  Height="20"
                                                  VerticalAlignment="Center"
                                                  Foreground="{TemplateBinding BorderBrush}"
                                                  DockPanel.Dock="Right"
                                                  Margin="0,0,2,0"/>
                                </DockPanel>
                            </Border>

                            <!-- Content -->
                            <ContentPresenter Grid.Row="1" 
                                  Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="DataGridContextMenu" FontFamily="{StaticResource IRANYEKAN}">
            <MenuItem Header="پالودن با این بخش" Click="FilterBySelection_Click">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="Filter"  FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <!--Filter Excluding Selection-->
            <MenuItem Header="پالودن بدون این بخش" Click="FilterExcludingSelection_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FilterRemove" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="کـپـی" Click="MenuItem_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="ContentCopy" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="حذف پالودن (فیلتر)" Click="RemoveFilterSort_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FilterRemoveOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="خروجی اکسل" Click="EXPORTEXCEL_BTN" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FileExcelOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="mygrid">
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="557,410,462,353"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label x:Name="WINTILENAME" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="History" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="سوابق تعریف کالا" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                    </Label>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                                                       Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <!--HEADER↑-->

        <Grid Margin="10,38,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Tag="0" Height="400"/>
                <RowDefinition Tag="1" MinHeight="5" Height="10"/>
                <RowDefinition Tag="2" Height="*"/>
            </Grid.RowDefinitions>
            <!--Section 1-->

            <GroupBox Header="سربرگ کالا" Style="{StaticResource FluentGroupBox}" FlowDirection="LeftToRight" Grid.Row="0"  Margin="10,30,10,10">
                <materialDesign:Card 
                      Padding="12"
                      UniformCornerRadius="14"
                      materialDesign:ElevationAssist.Elevation="Dp2">
                    <DockPanel LastChildFill="True">
                        <DockPanel  FlowDirection="RightToLeft" Margin="5" DockPanel.Dock="Bottom">
                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" FlowDirection="LeftToRight">

                                <Button ToolTip="بارگذاری مجدد" Click="Btn_Reload_Click" Style="{StaticResource MaterialDesignIconButton}" Width="30" Height="30" Foreground="Gray">
                                    <materialDesign:PackIcon Kind="Refresh" Width="20" Height="20"/>
                                </Button>

                                <Border Width="1" Height="20" Background="LightGray" Margin="5,0"/>

                                <Button ToolTip="اولین رکورد" Click="Btn_First_Click" Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32">
                                    <materialDesign:PackIcon Kind="PageFirst" Width="22" Height="22" Foreground="{StaticResource PrimaryHueMidBrush}"/>
                                </Button>

                                <Button ToolTip="رکورد قبلی" Click="Btn_Prev_Click" Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32">
                                    <materialDesign:PackIcon Kind="ChevronLeft" Width="24" Height="24" Foreground="{StaticResource PrimaryHueMidBrush}"/>
                                </Button>

                                <Border Background="#10000000" CornerRadius="4" Margin="5,0" Padding="8,2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TXT_CURRENT_INDEX" Text="0" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <TextBlock Text=" / " Foreground="Gray" Margin="4,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="TXT_TOTAL_COUNT" Text="0" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Button ToolTip="رکورد بعدی" Click="Btn_Next_Click" Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32">
                                    <materialDesign:PackIcon Kind="ChevronRight" Width="24" Height="24" Foreground="{StaticResource PrimaryHueMidBrush}"/>
                                </Button>

                                <Button ToolTip="آخرین رکورد" Click="Btn_Last_Click" Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32">
                                    <materialDesign:PackIcon Kind="PageLast" Width="22" Height="22" Foreground="{StaticResource PrimaryHueMidBrush}"/>
                                </Button>

                            </StackPanel>
                            <Button Content="حذف همه فیلتر ها" Style="{StaticResource MaterialDesignFlatButton}" Click="Button_Click" FontSize="12" HorizontalAlignment="Right"/>
                        </DockPanel>
                        <syncfusion:SfDataGrid x:Name="SYNCFUSION_DG" Visibility="Collapsed" d:Visibility="Visible"
                             ContextMenu="{StaticResource DataGridContextMenu}"
                             ItemsSource="{Binding PRODUCT_DATA}" 
                             CellStyle="{StaticResource SFCELL}"
                             AutoGenerateColumns="False"
                             EnableDataVirtualization="True"
                             SelectionUnit="Row"
                             AllowEditing="True"
                             IsReadOnly="True"
                             AllowDraggingColumns="True"
                             AllowResizingColumns="True"
                             AllowFiltering="True"
                             AllowSorting="True"
                             FilterRowPosition="Top"
                                                 
                             SelectionMode="Extended"
                             RowHeight="38"
                             FrozenColumnCount="0"
                             FlowDirection="RightToLeft"
                             d:ItemsSource="{d:SampleData ItemCount=5}"
                             Style="{StaticResource FluentDataGridStyle}"
                             SelectedIndex="-1"                          
                             HeaderStyle="{StaticResource KDGHeader_Fluent}"
                             SelectionChanged="SYNCFUSION_DG_SelectionChanged" 
                             CurrentCellActivated="SYNCFUSION_DG_CurrentCellActivated"
                             PreviewMouseRightButtonDown="SYNCFUSION_DG_PreviewMouseRightButtonDown"
                             AllowRowHoverHighlighting="True" AllowSelectionOnPointerPressed="True" ScrollMode="Async" ShowRowHeader="True" ShowGroupDropArea="True" PreviewKeyDown="SYNCFUSION_DG_PreviewKeyDown">

                            <syncfusion:SfDataGrid.Columns>
                                <!-- Update Date -->
                                <syncfusion:GridTextColumn MappingName="UP_DATE" HeaderText="تاریخ اصلاح" MinimumWidth="110">
                                    <syncfusion:GridTextColumn.DisplayBinding>
                                        <Binding Path="UP_DATE" StringFormat="####/##/##" />
                                    </syncfusion:GridTextColumn.DisplayBinding>
                                </syncfusion:GridTextColumn>

                                <!-- Update Time -->
                                <syncfusion:GridTextColumn MappingName="UpTimeDisplay" HeaderText="زمان اصلاح" MinimumWidth="160" AllowEditing="False">
                                    <syncfusion:GridTextColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding UpTimeDisplay}" 
                                                       FlowDirection="LeftToRight"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"                                                     
                                                       Margin="5,0"/>
                                        </DataTemplate>
                                    </syncfusion:GridTextColumn.CellTemplate>
                                </syncfusion:GridTextColumn>

                                <!-- User Name -->
                                <syncfusion:GridTextColumn MappingName="UP_USER_NAME" HeaderText="کاربر اصلاح کننده" MinimumWidth="150" AllowEditing="False"/>

                                <!-- PC Name -->
                                <syncfusion:GridTextColumn MappingName="PC_NAME" HeaderText="نام کامپیوتر" MinimumWidth="150" AllowEditing="False"/>

                                <!-- IP Address -->
                                <syncfusion:GridTextColumn MappingName="IPADD" HeaderText="IP" MinimumWidth="120" AllowEditing="False"/>

                                <syncfusion:GridTextColumn MappingName="CODE" HeaderText="کد کالا" Width="100"/>
                                <syncfusion:GridTextColumn MappingName="NAME" HeaderText="نام کالا" Width="250"/>
                                <syncfusion:GridTextColumn MappingName="N_FANI" HeaderText="شماره فنی" Width="120"/>
                                <syncfusion:GridTextColumn MappingName="BARCODE" HeaderText="بارکد" Width="120"/>

                                <syncfusion:GridComboBoxColumn x:Name="VAHED_COLUMN" MappingName="VAHED" HeaderText="واحد" MinimumWidth="100" DisplayMemberPath="NAMES" SelectedValuePath="CODE"/>
                                <syncfusion:GridComboBoxColumn x:Name="RADAH_COLUMN" MappingName="RADAH" HeaderText="گروه کالا" MinimumWidth="150" DisplayMemberPath="NAMES" SelectedValuePath="CODE"/>

                                <syncfusion:GridCheckBoxColumn MappingName="CMBAA" HeaderText="مالیات ب.ا.ا"/>

                                <syncfusion:GridTextColumn MappingName="MIN_M" HeaderText="حداقل موجودی"/>
                                <syncfusion:GridTextColumn MappingName="MAX_M" HeaderText="حداکثر موجودی"/>
                                <syncfusion:GridTextColumn MappingName="N_SEF" HeaderText="نقطه سفارش"/>

                                <syncfusion:GridTextColumn MappingName="MABL_F" HeaderText="فی عمده فروش">
                                    <syncfusion:GridTextColumn.DisplayBinding>
                                        <Binding Path="MABL_F" StringFormat="{}{0:N0}" />
                                    </syncfusion:GridTextColumn.DisplayBinding>
                                </syncfusion:GridTextColumn>
                                <syncfusion:GridTextColumn MappingName="B_SEF" HeaderText="فی خرده فروش">
                                    <syncfusion:GridTextColumn.DisplayBinding>
                                        <Binding Path="B_SEF" StringFormat="{}{0:N0}" />
                                    </syncfusion:GridTextColumn.DisplayBinding>
                                </syncfusion:GridTextColumn>

                                <syncfusion:GridTextColumn MappingName="TOZIH" HeaderText="توضیحات" Width="200"/>
                                <syncfusion:GridCheckBoxColumn MappingName="OKF" HeaderText="فعال"/>

                            </syncfusion:SfDataGrid.Columns>
                        </syncfusion:SfDataGrid>
                    </DockPanel>
                </materialDesign:Card>
            </GroupBox>

            <!--Splitter ↓↑-->
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#FF00A7FF"/>

            <!--Section 2-->
            <Grid Grid.Row="2" Margin="5">
                <Grid x:Name="BusyOverlay" Visibility="Collapsed" Panel.ZIndex="1000">
                    <Border Background="White" Opacity="0.5" CornerRadius="4"/>

                    <materialDesign:Card UniformCornerRadius="50" Width="50" Height="50" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center" materialDesign:ElevationAssist.Elevation="Dp4">
                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" Value="0" IsIndeterminate="True" Width="30" Height="30" Foreground="{StaticResource PrimaryHueMidBrush}"/>
                    </materialDesign:Card>
                </Grid>
                <GroupBox Header="جزئیات" Style="{StaticResource FluentGroupBox2}" FlowDirection="LeftToRight" Margin="0,15,0,0">
                    <DockPanel>
                        <TabControl  materialDesign:TransitionAssist.DisableTransitions="True">
                            <TabItem  x:Name="PAGE_FSK" IsSelected="True">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="انبار و موجودی"/>
                                        <Border Background="{StaticResource PrimaryHueMidBrush}" CornerRadius="4" Margin="5,0,0,0" Padding="4,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TXT_COUNT_FSK" Text="0" Foreground="White" FontSize="10"/>
                                        </Border>
                                    </StackPanel>
                                </TabItem.Header>
                                <Grid FlowDirection="RightToLeft">
                                    <syncfusion:SfDataGrid x:Name="SF_FSK" Grid.Column="0"
                                        ItemsSource="{Binding FSK_DATA}" 
                                        AutoGenerateColumns="False" SelectedIndex="0"
                                        EnableDataVirtualization="True"
                                        SelectionUnit="Row"
                                        AllowEditing="True"
                                        IsReadOnly="True"
                                        AllowDraggingColumns="True"
                                        AllowResizingColumns="True"
                                        AllowFiltering="True"
                                        AllowSorting="True"                                       
                                        SelectionMode="Extended"
                                        RowHeight="30"
                                        FrozenColumnCount="0"
                                        FlowDirection="RightToLeft"
                                        d:ItemsSource="{d:SampleData ItemCount=5}"
                                        Style="{StaticResource KDG}"
                                        HeaderStyle="{StaticResource KDGHeader}"
                                        AllowRowHoverHighlighting="True" AllowSelectionOnPointerPressed="True" ScrollMode="Async" ShowRowHeader="True" ShowGroupDropArea="True" >

                                        <syncfusion:SfDataGrid.Columns>
                                            <syncfusion:GridComboBoxColumn x:Name="ANBAR_COLUMN_DETAIL" MappingName="ANBAR" HeaderText="انبار" MinimumWidth="150" DisplayMemberPath="NAMES" SelectedValuePath="CODE"/>
                                            <syncfusion:GridTextColumn MappingName="MOGODI_A" HeaderText="موجودی" MinimumWidth="80"/>
                                            <syncfusion:GridTextColumn MappingName="FI_A" HeaderText="فی" MinimumWidth="100">
                                                <syncfusion:GridTextColumn.DisplayBinding>
                                                    <Binding Path="FI_A" StringFormat="{}{0:N0}" />
                                                </syncfusion:GridTextColumn.DisplayBinding>
                                            </syncfusion:GridTextColumn>
                                            <syncfusion:GridTextColumn MappingName="MABL_A" HeaderText="مبلغ" MinimumWidth="100">
                                                <syncfusion:GridTextColumn.DisplayBinding>
                                                    <Binding Path="MABL_A" StringFormat="{}{0:N0}" />
                                                </syncfusion:GridTextColumn.DisplayBinding>
                                            </syncfusion:GridTextColumn>
                                            <syncfusion:GridTextColumn MappingName="POSITION" HeaderText="موقعیت" MinimumWidth="100"/>
                                        </syncfusion:SfDataGrid.Columns>
                                    </syncfusion:SfDataGrid>
                                </Grid>
                            </TabItem>

                            <TabItem x:Name="PAGE_MODULE_D">
                                <TabItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="واحد های فرعی"/>
                                        <Border Background="{StaticResource PrimaryHueMidBrush}" CornerRadius="4" Margin="5,0,0,0" Padding="4,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="TXT_COUNT_MODULE_D" Text="0" Foreground="White" FontSize="10"/>
                                        </Border>
                                    </StackPanel>
                                </TabItem.Header>
                                <Grid FlowDirection="RightToLeft">
                                    <syncfusion:SfDataGrid x:Name="SF_MODULE_D" 
                                            ItemsSource="{Binding MODULE_D_DATA}" 
                                            AutoGenerateColumns="False" SelectedIndex="0"
                                            EnableDataVirtualization="True"
                                            SelectionUnit="Row"
                                            AllowEditing="True"
                                            IsReadOnly="True"
                                            AllowDraggingColumns="True"
                                            AllowResizingColumns="True"
                                            AllowFiltering="True"
                                            AllowSorting="True"
                                            SelectionMode="Extended"
                                            RowHeight="30"
                                            FrozenColumnCount="0"
                                            FlowDirection="RightToLeft"
                                            d:ItemsSource="{d:SampleData ItemCount=5}"
