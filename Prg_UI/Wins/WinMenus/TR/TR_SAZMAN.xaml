        <!-- Modern Fluent GroupBox Style -->
        <Style x:Key="FluentGroupBox" TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryHueMidBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}"/>
            <Setter Property="FontFamily" Value="{StaticResource IRANYEKAN}"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Border Container -->
                            <Border Grid.Row="0" 
                            Grid.RowSpan="2"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            Background="{StaticResource MaterialDesignPaper}"
                            Margin="0,0,0,0" BorderThickness="0,2,0,0"/>

                            <!-- Header -->
                            <Border Grid.Row="0" 
                            HorizontalAlignment="Right" FlowDirection="RightToLeft"
                            Background="{StaticResource MaterialDesignPaper}"
                            Margin="20,-12,-2,1" Padding="7,0,0,0">
                                <DockPanel>
                                    <ContentPresenter ContentSource="Header" 
                                            RecognizesAccessKey="True"
                                            TextBlock.Foreground="{TemplateBinding BorderBrush}"
                                            TextBlock.FontWeight="SemiBold"
                                            TextBlock.FontSize="14"
                                            VerticalAlignment="Center"/>
                                    <materialDesign:PackIcon Kind="FileDocumentOutline" 
                                                    Width="20" 
                                                    Height="20"
                                                    VerticalAlignment="Center"
                                                    Foreground="{TemplateBinding BorderBrush}"
                                                    DockPanel.Dock="Right"
                                                    Margin="0,0,2,0"/>
                                </DockPanel>
                            </Border>

                            <!-- Content -->
                            <ContentPresenter Grid.Row="1" 
                                    Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

