<Window x:Class="Prg_UI.Wins.WinMenus.ANBAR.HEAD_SERCH_MAIN_ADVANC"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.ANBAR"
        mc:Ignorable="d"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        x:Name="RootWindow"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        MaxHeight="{Binding Height, Source={x:Static SystemParameters.WorkArea}}"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="{StaticResource IRANYEKAN}"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing"
        Title="" Height="768" Width="1278" d:Height="1650" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="mygrid" d:Margin="0,0,0,-600">
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="557,410,462,353"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label x:Name="LABEL_HEADER" Content="جستجو در گردش کالا های پیشرفته" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Click="Btn_Close_Click" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False">
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False">
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False">
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                                                   Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <!--HEADER↑-->

        <Grid Margin="0,40,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Tag="0" Height="681*">
                    <!--Main Elements-->
                </RowDefinition>
                <RowDefinition Tag="1" Height="5">
                    <!--Spliiter-->
                </RowDefinition>
                <RowDefinition Tag="2" Height="60*">
                    <!--Action Buttons-->
                </RowDefinition>
            </Grid.RowDefinitions>
            <ScrollViewer Grid.Row="0" Margin="5" FlowDirection="RightToLeft" VerticalScrollBarVisibility="Auto" Grid.ColumnSpan="2">
                <Grid Margin="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="130*" />
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="97*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                        <RowDefinition Height="40" />
                    </Grid.RowDefinitions>

                    <!--Column 1-->
                    <Label Content="شماره برگه :" Grid.Row="0" Grid.Column="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"/>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.ColumnSpan="4" Margin="125,0,0,0">
                        <CNC:NumericTextBox x:Name="NUMBER" Text="" TextAlignment="Right" DoesAcceptDouble="False" RestoreLastValidValue="False" LastValueShouldZero="False" Width="150" Height="30"/>
                        <ComboBox Padding="7,0,10,0" Width="70" 
                                  HorizontalContentAlignment="Center"
                                  DisplayMemberPath="OpDisplay" 
                                  SelectedValuePath="OpValue"
                                  ItemsSource="{Binding DataContext.NUMERIC_OP_DATA, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                  x:Name="NUMBERB" Margin="5,0,0,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Height="30" IsEditable="True" Background="{x:Null}" BorderThickness="1">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>
                        <CheckBox IsChecked="False"  x:Name="NUMBERC" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        <ComboBox Padding="7,0,10,0" Width="100" x:Name="NUMBERBS" 
                                  HorizontalContentAlignment="Center"
                                  DisplayMemberPath="OpDisplay" 
                                  SelectedValuePath="OpValue"
                                  ItemsSource="{Binding DataContext.AGG_OP_DATA, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Margin="5,0,0,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Height="30" IsEditable="True" Background="{x:Null}" BorderThickness="1">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>
                    </StackPanel>

                    <Label Content="نوع برگه :" Grid.Row="1" Grid.Column="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"/>
                    <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.ColumnSpan="4" Margin="125,0,0,0">
                        <ComboBox Padding="7,0,10,0" Width="150" x:Name="TAGCODE" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Height="30" IsEditable="True" Background="{x:Null}" BorderThickness="1" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" SelectedValuePath="CODE" DisplayMemberPath="BARGAH">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>

                        <ComboBox Padding="7,0,10,0" Width="70" x:Name="TAGCODEB" Margin="5,0,0,0" 
                                  HorizontalContentAlignment="Center"
                                  DisplayMemberPath="OpDisplay" 
                                  SelectedValuePath="OpValue"
                                  ItemsSource="{Binding DataContext.NUMERIC_OP_DATA, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                  Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Height="30" IsEditable="True" Background="{x:Null}" BorderThickness="1">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>
                        <CheckBox IsChecked="False"  x:Name="TAGCODEC" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        <ComboBox Padding="7,0,10,0" Width="100" x:Name="TAGCODEBS" 
                                  HorizontalContentAlignment="Center"
                                  DisplayMemberPath="OpDisplay" 
                                  SelectedValuePath="OpValue"
                                  ItemsSource="{Binding DataContext.AGG_OP_DATA, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Margin="5,0,0,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Height="30" IsEditable="True" Background="{x:Null}" BorderThickness="1">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>
                    </StackPanel>

                    <Label Content="تاريخ برگه :" Grid.Row="2" Grid.Column="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"/>
                    <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.ColumnSpan="4" Margin="125,0,0,0">
                        <xctk:MaskedTextBox x:Name="DATE_N" Style="{StaticResource FuzzyOut}" FlowDirection="LeftToRight" Padding="3" Mask="0000/00/00" Height="30" BorderThickness="1" FontSize="12" Width="150"/>
                        <ComboBox Padding="7,0,10,0" Width="70" x:Name="DATE_NB" Margin="5"
                                  HorizontalContentAlignment="Center"
                                  DisplayMemberPath="OpDisplay" 
                                  SelectedValuePath="OpValue"
                                  ItemsSource="{Binding DataContext.DATE_OP_DATA, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                  Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Height="30" IsEditable="True" Background="{x:Null}" BorderThickness="1" SelectionChanged="DATE_NB_SelectionChanged">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>
                        <CheckBox IsChecked="False"  x:Name="DATE_NC" VerticalAlignment="Center"/>
                        <ComboBox Padding="7,0,10,0" Width="100" x:Name="DATE_NBS" 
                                  HorizontalContentAlignment="Center"
                                  DisplayMemberPath="OpDisplay" 
                                  SelectedValuePath="OpValue"
                                  ItemsSource="{Binding DataContext.AGG_OP_DATA, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Margin="5,0,0,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Height="30" IsEditable="True" Background="{x:Null}" BorderThickness="1">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>
                        <StackPanel x:Name="DATE_NT_SP" Visibility="Hidden" Orientation="Horizontal" Margin="5,0,0,0">
                            <Label Content="تا تاریخ برگه :" Grid.Row="2" Grid.Column="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"/>
                            <xctk:MaskedTextBox x:Name="DATE_NT" Style="{StaticResource FuzzyOut}" FlowDirection="LeftToRight" Padding="3" Mask="0000/00/00" Height="30" BorderThickness="1" FontSize="12" Width="100"/>
                        </StackPanel>
                    </StackPanel>

                    <Label Content="كد كالا :" Grid.Row="3" Grid.Column="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"/>
                    <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.ColumnSpan="4" Margin="125,0,0,0">
                        <CNC:NumericTextBox x:Name="CODE" Text="" TextAlignment="Right" DoesAcceptDouble="False" RestoreLastValidValue="False" LastValueShouldZero="False" Width="150" Height="30"/>
                        <ComboBox Padding="7,0,10,0" Width="70" x:Name="CODEB"                                 
                                  HorizontalContentAlignment="Center"
                                  DisplayMemberPath="OpDisplay" 
                                  SelectedValuePath="OpValue"
                                  ItemsSource="{Binding DataContext.NUMERIC_OP_DATA, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                  Margin="5,0,0,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Height="30" IsEditable="True" Background="{x:Null}" BorderThickness="1">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>
                        <CheckBox IsChecked="False"  x:Name="CODEC" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        <ComboBox Padding="7,0,10,0" Width="100" x:Name="CODEBS" 
                                  HorizontalContentAlignment="Center"
                                  DisplayMemberPath="OpDisplay" 
                                  SelectedValuePath="OpValue"
                                  ItemsSource="{Binding DataContext.AGG_OP_DATA, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Margin="5,0,0,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Height="30" IsEditable="True" Background="{x:Null}" BorderThickness="1">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>
                    </StackPanel>

                    <Label Content="نام كالا :" Grid.Row="4" Grid.Column="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"/>
                    <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.ColumnSpan="4" Margin="125,0,0,0">
                        <TextBox x:Name="KALA" Height="30" Style="{StaticResource FuzzyOut}" Padding="3" Width="150"/>
                        <ComboBox Padding="7,0,10,0" Width="70" x:Name="KALAB" 
                                  HorizontalContentAlignment="Center"
                                  DisplayMemberPath="OpDisplay" 
                                  SelectedValuePath="OpValue"
                                  ItemsSource="{Binding DataContext.TEXT_OP_DATA, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                  Margin="5,0,0,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Height="30" IsEditable="True" Background="{x:Null}" BorderThickness="1">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>
                        <CheckBox IsChecked="False"  x:Name="KALAC" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        <ComboBox Padding="7,0,10,0" Width="100" x:Name="KALABS"
                                  HorizontalContentAlignment="Center"
                                  DisplayMemberPath="OpDisplay"
                                  SelectedValuePath="OpValue"
                                  ItemsSource="{Binding DataContext.AGG_OP_DATA_TEXT, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Margin="5,0,0,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Height="30" IsEditable="True" Background="{x:Null}" BorderThickness="1">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>
                    </StackPanel>

                    <Label Content="مقدار کالا :" Grid.Row="5" Grid.Column="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"/>
                    <StackPanel Orientation="Horizontal" Grid.Row="5" Grid.ColumnSpan="4" Margin="125,0,0,0">
                        <CNC:NumericTextBox x:Name="MEGH" Text="" TextAlignment="Right" DoesAcceptDouble="True" RestoreLastValidValue="False" LastValueShouldZero="False" Width="150" Height="30"/>
                        <ComboBox Padding="7,0,10,0" Width="70" x:Name="MEGHB" 
                                  HorizontalContentAlignment="Center"
                                  DisplayMemberPath="OpDisplay" 
                                  SelectedValuePath="OpValue"
                                  ItemsSource="{Binding DataContext.NUMERIC_OP_DATA, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Margin="5,0,0,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Height="30" IsEditable="True" Background="{x:Null}" BorderThickness="1">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>
                        <CheckBox IsChecked="False"  x:Name="MEGHC" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        <ComboBox Padding="7,0,10,0" Width="100" x:Name="MEGHBS" 
                                  HorizontalContentAlignment="Center"
                                  DisplayMemberPath="OpDisplay" 
                                  SelectedValuePath="OpValue"
                                  ItemsSource="{Binding DataContext.AGG_OP_DATA, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Margin="5,0,0,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Height="30" IsEditable="True" Background="{x:Null}" BorderThickness="1">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>
                    </StackPanel>

                    <Label Content="مقدار كل كالا :" Grid.Row="6" Grid.Column="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"/>
                    <StackPanel Orientation="Horizontal" Grid.Row="6" Grid.ColumnSpan="4" Margin="125,0,0,0">
                        <CNC:NumericTextBox x:Name="MEGHk" Text="" TextAlignment="Right" DoesAcceptDouble="True" RestoreLastValidValue="False" LastValueShouldZero="False" Width="150" Height="30"/>
                        <ComboBox Padding="7,0,10,0" Width="70" x:Name="MEGHkB" 
                                  HorizontalContentAlignment="Center"
                                  DisplayMemberPath="OpDisplay" 
                                  SelectedValuePath="OpValue"
                                  ItemsSource="{Binding DataContext.NUMERIC_OP_DATA, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Margin="5,0,0,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Height="30" IsEditable="True" Background="{x:Null}" BorderThickness="1">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>
                        <CheckBox IsChecked="False"  x:Name="MEGHkC" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        <ComboBox Padding="7,0,10,0" Width="100" x:Name="MEGHkBS" 
                                  HorizontalContentAlignment="Center"
                                  DisplayMemberPath="OpDisplay" 
                                  SelectedValuePath="OpValue"
                                  ItemsSource="{Binding DataContext.AGG_OP_DATA, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Margin="5,0,0,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Height="30" IsEditable="True" Background="{x:Null}" BorderThickness="1">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>
                    </StackPanel>

                    <Label Content="نام شخص :" Grid.Row="7" Grid.Column="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"/>
                    <StackPanel Orientation="Horizontal" Grid.Row="7" Grid.ColumnSpan="4" Margin="125,0,0,0">
                        <TextBox x:Name="CUSTNAME" Height="30" Style="{StaticResource FuzzyOut}" Padding="3" Width="150"/>
                        <ComboBox Padding="7,0,10,0" Width="70" x:Name="CUSTNAMEB"  
                                  HorizontalContentAlignment="Center"
                                  DisplayMemberPath="OpDisplay" 
                                  SelectedValuePath="OpValue"
                                  ItemsSource="{Binding DataContext.TEXT_OP_DATA, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Margin="5,0,0,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Height="30" IsEditable="True" Background="{x:Null}" BorderThickness="1">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>
                        <CheckBox IsChecked="False"  x:Name="CUSTNAMEC" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        <ComboBox Padding="7,0,10,0" Width="100" x:Name="CUSTNAMEBS"
                                  HorizontalContentAlignment="Center"
                                  DisplayMemberPath="OpDisplay"
                                  SelectedValuePath="OpValue"
                                  ItemsSource="{Binding DataContext.AGG_OP_DATA_TEXT, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Margin="5,0,0,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Height="30" IsEditable="True" Background="{x:Null}" BorderThickness="1">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>
                    </StackPanel>

                    <Label Content="کد شخص :" Grid.Row="8" Grid.Column="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"/>
                    <StackPanel Orientation="Horizontal" Grid.Row="8" Grid.ColumnSpan="4" Margin="125,0,0,0">
                        <TextBox x:Name="hes" Height="30" Style="{StaticResource FuzzyOut}" Padding="3" Width="150"/>
                        <ComboBox Padding="7,0,10,0" Width="70" x:Name="hesB" 
                                  HorizontalContentAlignment="Center"
                                  DisplayMemberPath="OpDisplay" 
                                  SelectedValuePath="OpValue"
                                  ItemsSource="{Binding DataContext.TEXT_OP_DATA, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Margin="5,0,0,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Height="30" IsEditable="True" Background="{x:Null}" BorderThickness="1">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>
                        <CheckBox IsChecked="False"  x:Name="hesC" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        <ComboBox Padding="7,0,10,0" Width="100" x:Name="hesBS"
                                  HorizontalContentAlignment="Center"
                                  DisplayMemberPath="OpDisplay"
                                  SelectedValuePath="OpValue"
                                  ItemsSource="{Binding DataContext.AGG_OP_DATA_TEXT, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Margin="5,0,0,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Height="30" IsEditable="True" Background="{x:Null}" BorderThickness="1">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>
                    </StackPanel>

                    <Label Content="مبلغ :" Grid.Row="9" Grid.Column="0" VerticalContentAlignment="Center" HorizontalContentAlignment="Right"/>
                    <StackPanel Orientation="Horizontal" Grid.Row="9" Grid.ColumnSpan="4" Margin="125,0,0,0">
                        <CNC:NumericTextBox x:Name="MABL" RestoreLastValidValue="False" LastValueShouldZero="False"  DoesAcceptDouble="False" TextAlignment="Right" IsDigitGroupActive="True" DigitGroupOnEnter="True" ThreeTwoZero="True" Text="" Width="150" MaxLength="16"/>
                        <ComboBox Padding="7,0,10,0" Width="70" x:Name="MABLB" 
                                  HorizontalContentAlignment="Center"
