                                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>
                    </StackPanel>

                </Grid>
            </ScrollViewer>

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="{Binding ElementName=GENERAL_RANG,Path=Background}" ShowsPreview="True" ResizeBehavior="BasedOnAlignment" Margin="0,-20,0,0"/>

            <StackPanel Grid.Row="2" Orientation="Vertical" Margin="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="اجرای گزارش" Width="120" Margin="5" x:Name="ExecuteButton" BorderBrush="{x:Null}" Height="34" FontSize="10" Foreground="#DDFFFFFF" Click="ExecuteButton_Click"/>
                    <Button Content="ذخیره گزارش" Width="120" Margin="5" x:Name="BTN_SAVE" BorderBrush="{x:Null}" Height="34" FontSize="10" Foreground="#DDFFFFFF" Click="BTN_SAVE_Click"/>
                    <CheckBox IsChecked="True"  x:Name="RSUM" Content="جمع زیر گزارش اضافه شود" Visibility="Collapsed" VerticalAlignment="Center"/>
                    <ComboBox x:Name="ANDOR" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" Height="30" IsEditable="True" Background="{x:Null}" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="80" VerticalAlignment="Center" SelectedIndex="0" Margin="10,0" SelectionChanged="ANDOR_SelectionChanged">
                        <ComboBoxItem Content="و"/>
                        <ComboBoxItem Content="یا"/>
                    </ComboBox>
                    <Label Content="شرط بعدی بوسیله" VerticalAlignment="Center"/>
                    <Button Content="مشاهده گزارش های قبلی" Width="150" Margin="5" x:Name="BTN_OPENREPORT" BorderBrush="{x:Null}" Height="34" FontSize="10" Foreground="#DDFFFFFF" Click="BTN_OPENREPORT_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>

    </Grid>
</Window>