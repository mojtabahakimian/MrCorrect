            </ScrollViewer>

            <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Left" Margin="430,20,0,0" Grid.ColumnSpan="2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="اجرای گزارش" Width="120" Margin="5" x:Name="ExecuteButton" BorderBrush="{x:Null}" Height="34" FontSize="10" Foreground="#DDFFFFFF"/>
                    <Button Content="ذخیره گزارش" Width="120" Margin="5" x:Name="BTN_SAVE" BorderBrush="{x:Null}" Height="34" FontSize="10" Foreground="#DDFFFFFF"/>
                    <Button Content="بارگذاری گزارش" Width="120" Margin="5" x:Name="LoadButton" BorderBrush="{x:Null}" Height="34" FontSize="10" Foreground="#DDFFFFFF"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <CheckBox x:Name="RSUM" Content="جمع زیر گزارش اضافه شود" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    <ComboBox x:Name="ANDOR" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" Height="30" IsEditable="True" Background="{x:Null}" BorderThickness="1" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="80" VerticalAlignment="Center" SelectedIndex="0" Margin="10,0">
                        <ComboBoxItem Content="و"/>
                        <ComboBoxItem Content="یا"/>
                    </ComboBox>
                    <Label Content="شرط بعدی بوسیله" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
