<Window x:Class="Prg_UI.Wins.WinMenus.ANBAR.SQLSTATEFORM"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.ANBAR"
        mc:Ignorable="d"
        
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:sfusion="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        MaxHeight="{Binding Height, Source={x:Static SystemParameters.WorkArea}}"
        Background="{x:Null}"
        AllowsTransparency="True"
        WindowState="Maximized"
        AllowDrop="True" WindowStyle="None"
        FontFamily="{StaticResource IRANYEKAN}"
        WindowStartupLocation="CenterScreen"
        Title="" Height="450" Width="800" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>

        <!-- Style for SfDataGrid -->
        <Style x:Key="KDG"  TargetType="syncfusion:SfDataGrid" BasedOn="{StaticResource SfDataGridStyle}">
            <Setter Property="CurrentCellBorderBrush" Value="{StaticResource GENERAL_Grlicom}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="BorderBrush" Value="{StaticResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="HeaderRowHeight" Value="40" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="GridLinesVisibility" Value="Both" />
        </Style>
        <!-- Modified Column Header Style -->
        <Style x:Key="KDGHeader" TargetType="syncfusion:GridHeaderCellControl" BasedOn="{StaticResource GridHeaderCellControlStyle}">
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="BorderBrush" Value="{Binding Background, ElementName=GENERAL_RANG}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="Auto"/>
        </Style>

        <Style TargetType="sfusion:GridCell" BasedOn="{StaticResource GridCellStyle}">
            <Setter Property="BorderBrush" Value="{Binding BorderBrush, ElementName=GENERAL_RANG}" />
        </Style>

        <!--FilterStylePopup { -->

        <!--FilterStylePopup } -->
        <ContextMenu x:Key="DataGridContextMenu" FontFamily="{StaticResource IRANYEKAN}">
            <MenuItem Header="پالودن با این بخش" Click="FilterBySelection_Click">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="Filter"  FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <!--Filter Excluding Selection-->
            <MenuItem Header="پالودن بدون این بخش" Click="FilterExcludingSelection_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FilterRemove" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="کـپـی" Click="MenuItem_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="ContentCopy" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="حذف پالودن (فیلتر)" Click="RemoveFilterSort_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FilterRemoveOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="خروجی اکسل" Click="EXPORTEXCEL_BTN" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FileExcelOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="mygrid">
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="557,410,462,353"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label x:Name="LABEL_HEADER" Content="لیست گزارشات ساخته شده توسط کاربران" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Click="Btn_Close_Click" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False">
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False">
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False">
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                                                       Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <!--HEADER↑-->

        <DockPanel Margin="10,45,10,46">
            <StackPanel x:Name="SP_HEIGHCHANGE" Visibility="Collapsed" d:Visibility="Visible" Orientation="Horizontal" Margin="10" DockPanel.Dock="Top">
                <TextBlock Text="Row:" Margin="0,0,6,0"/>
                <Slider Minimum="30" Maximum="500" Value="{Binding ElementName=SYNCFUSION_DG, Path=RowHeight, Mode=TwoWay}" Width="160" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                <TextBlock Text="Header:" Margin="12,0,6,0"/>
                <Slider Minimum="24" Maximum="80" Value="{Binding ElementName=SYNCFUSION_DG, Path=HeaderRowHeight, Mode=TwoWay}" Width="160"/>
            </StackPanel>

            <syncfusion:SfDataGrid x:Name="SYNCFUSION_DG" 
                ContextMenu="{StaticResource DataGridContextMenu}"
                ItemsSource="{Binding SFG_DATA}" 
                AutoGenerateColumns="False"
                EnableDataVirtualization="True"
                SelectionUnit="Row"
                AllowEditing="True"
                IsReadOnly="True"
                AllowDraggingColumns="True"
                AllowResizingColumns="True"
                AllowFiltering="True"
                AllowSorting="True"
                FilterRowPosition="Top"
                SelectionMode="Extended"
                RowHeight="30"
                RowValidating="SYNCFUSION_DG_RowValidating"
                RowValidated="SYNCFUSION_DG_RowValidated"
                FrozenColumnCount="0"
                FlowDirection="RightToLeft"
                d:ItemsSource="{d:SampleData ItemCount=5}"
                Style="{StaticResource KDG}"
                HeaderStyle="{StaticResource KDGHeader}"
                CurrentCellActivated="SYNCFUSION_DG_CurrentCellActivated"
                PreviewMouseRightButtonDown="SYNCFUSION_DG_PreviewMouseRightButtonDown" PreviewMouseDoubleClick="SYNCFUSION_DG_PreviewMouseDoubleClick"
                AllowRowHoverHighlighting="True" AllowSelectionOnPointerPressed="True" ScrollMode="Async" ShowRowHeader="True" ShowGroupDropArea="True" SelectionChanged="SYNCFUSION_DG_SelectionChanged" PreviewKeyDown="SYNCFUSION_DG_PreviewKeyDown">

                <syncfusion:SfDataGrid.Resources>
                    <ResourceDictionary>
                        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                            <Setter Property="AcceptsReturn" Value="True" />
                            <Setter Property="Height" Value="30" />
                        </Style>
                    </ResourceDictionary>
                </syncfusion:SfDataGrid.Resources>

                <syncfusion:SfDataGrid.Columns>
                    <!-- Core Information -->
                    <syncfusion:GridTextColumn HeaderText="شماره" MappingName="IDD" x:Name="IDD" TextAlignment="Left" IsReadOnly="True" />
                    <syncfusion:GridTextColumn HeaderText="SQL STATMENT" MappingName="SQLST" x:Name="SQLST" ColumnSizer="Star" TextAlignment="Right" IsHidden="True"/>
                    <syncfusion:GridTextColumn HeaderText="عنوان گزارش" MappingName="TITEL" x:Name="TITEL" ColumnSizer="Star" IsReadOnly="True"  TextAlignment="Left"/>
                    <syncfusion:GridTextColumn HeaderText="كاربر سازنده" MappingName="USER_NAME" ColumnSizer="Star" x:Name="USER_NAME" IsReadOnly="True"  TextAlignment="Left"/>

                    <syncfusion:GridComboBoxColumn x:Name="LETOTHER_COLUMN" HeaderText="اجازه برای دیگران" MappingName="LETOTHER"  IsReadOnly="True" TextAlignment="Left"
                                            SelectedValuePath="CODE" DisplayMemberPath="NAME"/>

                    <syncfusion:GridDateTimeColumn x:Name="CR_DATE" HeaderText="زمان ایجاد"  IsReadOnly="True"  ColumnSizer="Star" MappingName="CR_DATE" Pattern="FullDateTime"/>
                </syncfusion:SfDataGrid.Columns>

            </syncfusion:SfDataGrid>
        </DockPanel>



        <Label x:Name="LBL_COUNT" Content="تعداد رکورد ها:" Margin="0,0,16,11" FlowDirection="RightToLeft" Width="84" HorizontalAlignment="Right" Height="27" VerticalAlignment="Bottom"/>
        <TextBlock x:Name="ROWCOUNT_TEXTBLK" Text=""  Margin="0,0,100,11"  FlowDirection="RightToLeft" Width="230" HorizontalAlignment="Right" Height="23" VerticalAlignment="Bottom"/>



    </Grid>
</Window>
