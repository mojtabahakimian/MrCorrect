<Window x:Class="Prg_UI.Wins.WinMenus.ANBAR.ZF_IVO_EXTENDED"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.ANBAR"
        mc:Ignorable="d"
        
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="{StaticResource IRANYEKAN}"
        Title="پارامترها" Height="270" Width="460" MinWidth="460" MinHeight="270" WindowStartupLocation="CenterScreen" WindowState="Normal" MaxWidth="460" MaxHeight="270"  Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">

    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="557,410,462,353"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1" Grid.ColumnSpan="2" Grid.RowSpan="6">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label Content="پارامترها" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                                              Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>

        <Grid x:Name="mygrid" Margin="0,45,10,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>


            <Label Content="چربی :" Margin="0,7,10,0"  FlowDirection="RightToLeft" FontSize="10" Height="28" VerticalAlignment="Top" Grid.Column="1" HorizontalAlignment="Right" Width="36"/>
            <CNC:NumericTextBox  DoesAcceptDouble="True" x:Name="FLD1" Tag="RD"  Text="0" Height="28" Margin="0,7,46,0"        VerticalAlignment="Top"   Visibility="Visible"   Grid.Column="1" HorizontalAlignment="Right" Width="120" TabIndex="0" />


            <Label Content="ماده خشک :" Margin="0,7,3,0"  FlowDirection="RightToLeft" FontSize="10" Height="28" VerticalAlignment="Top" HorizontalAlignment="Right" Width="58"/>
            <CNC:NumericTextBox DoesAcceptDouble="True"  x:Name="FLD2" Tag="RD"  Text="0" Height="28" Margin="0,7,62,0"        VerticalAlignment="Top"   Visibility="Visible"   HorizontalAlignment="Right" Width="120" TabIndex="1" />
            <Label Content="رطوبت :" Margin="0,6,2,0"  FlowDirection="RightToLeft" FontSize="10" Height="28" VerticalAlignment="Top" Grid.Column="1" Grid.Row="1" HorizontalAlignment="Right" Width="44"/>
            <CNC:NumericTextBox DoesAcceptDouble="True"  x:Name="FLD3" Tag="RD"  Text="0" Height="28" Margin="0,6,46,0"        VerticalAlignment="Top"   Visibility="Visible"   Grid.Column="1" Grid.Row="1" HorizontalAlignment="Right" Width="120" TabIndex="2" />
            <Label Content="PH :" Margin="0,6,33,0"  FlowDirection="RightToLeft" FontSize="10" Height="28" VerticalAlignment="Top" Grid.Row="1" HorizontalAlignment="Right" Width="28"/>
            <CNC:NumericTextBox DoesAcceptDouble="True"  x:Name="FLD4" Tag="RD"  Text="0" Height="28" Margin="0,6,62,0"        VerticalAlignment="Top"   Visibility="Visible"   Grid.Row="1" HorizontalAlignment="Right" Width="120" TabIndex="3" />
            <Label Content="نمک :" Margin="0,7,14,0"  FlowDirection="RightToLeft" FontSize="10" Height="28" VerticalAlignment="Top" Grid.Column="1" Grid.Row="2" HorizontalAlignment="Right" Width="32"/>
            <CNC:NumericTextBox DoesAcceptDouble="True"  x:Name="FLD5" Tag="RD"  Text="0" Height="28" Margin="0,7,46,0"        VerticalAlignment="Top"   Visibility="Visible"   Grid.Column="1" Grid.Row="2" HorizontalAlignment="Right" Width="120" TabIndex="4" />
            <Label Content="دانسیته :" Margin="0,7,17,0"  FlowDirection="RightToLeft" FontSize="10" Height="28" VerticalAlignment="Top" Grid.Row="2" HorizontalAlignment="Right" Width="44"/>
            <CNC:NumericTextBox DoesAcceptDouble="True"  x:Name="FLD6"  Tag="RD"  Text="0" Height="28" Margin="0,7,62,0"        VerticalAlignment="Top"   Visibility="Visible"   Grid.Row="2" HorizontalAlignment="Right" Width="120" TabIndex="5" />
            <Label Content="پروتیین :" Margin="0,6,4,0"  FlowDirection="RightToLeft" FontSize="10" Grid.Column="1" Grid.Row="3" Height="28" VerticalAlignment="Top" HorizontalAlignment="Right" Width="42"/>
            <CNC:NumericTextBox DoesAcceptDouble="True"  x:Name="FLD7" Tag="RD"  Text="0" Height="28" Margin="0,6,46,0"        VerticalAlignment="Top"   Visibility="Visible"   Grid.Column="1" Grid.Row="3" HorizontalAlignment="Right" Width="120" TabIndex="6" />
            <Label Content="انجماد :" Margin="0,6,23,0"  FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="38" Height="28" VerticalAlignment="Top" Grid.Row="3"/>
            <CNC:NumericTextBox DoesAcceptDouble="True"  x:Name="FLD8" Tag="RD"  Text="0" Height="28" Margin="0,6,62,0"        VerticalAlignment="Top"   Visibility="Visible"  HorizontalAlignment="Right" Width="120"   Grid.Row="3" TabIndex="7" />
            <Label Content="اسید :" Margin="0,6,12,0"  FlowDirection="RightToLeft" FontSize="10" Height="28" VerticalAlignment="Top" Grid.Column="1" Grid.Row="4" HorizontalAlignment="Right" Width="34"/>
            <CNC:NumericTextBox DoesAcceptDouble="True"  x:Name="FLD9" Tag="RD"  Text="0" Height="28" Margin="0,6,46,0"        VerticalAlignment="Top"   Visibility="Visible"  HorizontalAlignment="Right" Width="120"   Grid.Column="1" Grid.Row="4" TabIndex="8" />
            <Label Content="الکل :" Margin="0,6,31,0"  FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="30" Height="28" VerticalAlignment="Top" Grid.Row="4"/>
            <CNC:NumericTextBox DoesAcceptDouble="True"  x:Name="FLD10" Tag="RD"  Text="0" Height="28" Margin="0,6,62,0"        VerticalAlignment="Top"   Visibility="Visible"  HorizontalAlignment="Right" Width="120"   Grid.Row="4" TabIndex="9" />
            <Button x:Name="Save" Content="ذخیره" Margin="48,0,0,0"    BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="10" Height="32" VerticalAlignment="Top" Foreground="#DDFFFFFF" FontWeight="Bold" Grid.Row="5" HorizontalAlignment="Left" Width="100" TabIndex="10" Click="Save_Click" Padding="16,1,16,4"/>

        </Grid>
    </Grid>
</Window>
