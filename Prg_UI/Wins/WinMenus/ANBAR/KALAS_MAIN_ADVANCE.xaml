<Window x:Class="Prg_UI.Wins.WinMenus.ANBAR.KALAS_MAIN_ADVANCE"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.ANBAR"
        mc:Ignorable="d"
        WindowState="Maximized"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:sfusion="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        MaxHeight="{Binding Height, Source={x:Static SystemParameters.WorkArea}}"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="{StaticResource IRANYEKAN}"
        WindowStartupLocation="CenterScreen"
        Title="" Height="450" Width="800" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>

        <!-- Style for SfDataGrid -->
        <Style x:Key="KDG"  TargetType="syncfusion:SfDataGrid" BasedOn="{StaticResource SfDataGridStyle}">
            <Setter Property="CurrentCellBorderBrush" Value="{StaticResource GENERAL_Grlicom}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="BorderBrush" Value="{StaticResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="HeaderRowHeight" Value="40" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="GridLinesVisibility" Value="Both" />
        </Style>
        <!-- Modified Column Header Style -->
        <Style x:Key="KDGHeader" TargetType="syncfusion:GridHeaderCellControl" BasedOn="{StaticResource GridHeaderCellControlStyle}">
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="BorderBrush" Value="{Binding Background, ElementName=GENERAL_RANG}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="Auto"/>
        </Style>

        <Style TargetType="sfusion:GridCell" BasedOn="{StaticResource GridCellStyle}">
            <Setter Property="BorderBrush" Value="{Binding BorderBrush, ElementName=GENERAL_RANG}" />
        </Style>


        <!--FilterStylePopup { -->

        <!--FilterStylePopup } -->


        <ContextMenu x:Key="DataGridContextMenu" FontFamily="{StaticResource IRANYEKAN}">
            <MenuItem Header="پالودن با این بخش" Click="FilterBySelection_Click">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="Filter"  FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <!--Filter Excluding Selection-->
            <MenuItem Header="پالودن بدون این بخش" Click="FilterExcludingSelection_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FilterRemove" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="کـپـی" Click="MenuItem_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="ContentCopy" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="حذف پالودن (فیلتر)" Click="RemoveFilterSort_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FilterRemoveOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="خروجی اکسل" Click="EXPORTEXCEL_BTN" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FileExcelOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="mygrid">
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="557,410,462,353"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label x:Name="LABEL_HEADER" Content="نتیجه جستجو در گردش کالا" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Click="Btn_Close_Click" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False">
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False">
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False">
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                                                   Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <!--HEADER↑-->

        <DockPanel Margin="10,45,10,45" LastChildFill="True">
            <Label x:Name="LBL_STATE" DockPanel.Dock="Top" Content="" Margin="5" Visibility="Collapsed" FlowDirection="RightToLeft"/>
            <syncfusion:SfDataGrid x:Name="SYNCFUSION_DG" 
                ContextMenu="{StaticResource DataGridContextMenu}"
                ItemsSource="{Binding FACTOR_DATA}" 
                AutoGenerateColumns="False"
                EnableDataVirtualization="True"
                SelectionUnit="Row"
                AllowEditing="True"
                IsReadOnly="True"
                AllowDraggingColumns="True"
                AllowResizingColumns="True"
                AllowFiltering="True"
                AllowSorting="True"
                FilterRowPosition="Top"
                SelectionMode="Extended"
                RowHeight="30"
                FrozenColumnCount="0"
                FlowDirection="RightToLeft"
                d:ItemsSource="{d:SampleData ItemCount=5}"
                Style="{StaticResource KDG}"
                HeaderStyle="{StaticResource KDGHeader}"
                CurrentCellActivated="SYNCFUSION_DG_CurrentCellActivated"
                PreviewMouseRightButtonDown="SYNCFUSION_DG_PreviewMouseRightButtonDown"
                AllowRowHoverHighlighting="True" AllowSelectionOnPointerPressed="True" ScrollMode="Async" ShowRowHeader="True" ShowGroupDropArea="True" SelectionChanged="SYNCFUSION_DG_SelectionChanged" PreviewKeyDown="SYNCFUSION_DG_PreviewKeyDown">

                <syncfusion:SfDataGrid.Resources>
                    <ResourceDictionary>
                        <Style TargetType="TextBox">
                            <Setter Property="AcceptsReturn" Value="True" />
                            <Setter Property="Height" Value="30" />
                        </Style>
                    </ResourceDictionary>
                </syncfusion:SfDataGrid.Resources>

                <syncfusion:SfDataGrid.Columns>
                    <!-- Core Information -->
                    <syncfusion:GridTextColumn HeaderText="کد کالا" MappingName="code" x:Name="CODE" TextAlignment="Left" IsHidden="True"/>
                    <syncfusion:GridTextColumn HeaderText="نام کالا" MappingName="kala" x:Name="KALA" Width="300" ColumnSizer="SizeToCells"  IsHidden="True" TextAlignment="Left" />
                    <!--BARGAH-->
                    <!--<syncfusion:GridTextColumn HeaderText="نوع برگه" MappingName="BARGAH" IsHidden="True" TextAlignment="Left" />-->
                    <syncfusion:GridComboBoxColumn 
                    x:Name="TAGCODE" IsHidden="True"
                    HeaderText="نوع برگه"
                    MappingName="TAGCODE"
                    SelectedValuePath="CODE"
                    DisplayMemberPath="BARGAH"/>

                    <syncfusion:GridTextColumn HeaderText="شماره برگه" MappingName="NUMBER"  x:Name="NUMBER" TextAlignment="Left" IsHidden="True">

                    </syncfusion:GridTextColumn>
                    <syncfusion:GridTextColumn HeaderText="تاریخ برگه" MappingName="DATE_N" x:Name="DATE_N"  TextAlignment="Left"  IsHidden="True">
                        <syncfusion:GridTextColumn.DisplayBinding>
                            <Binding Path="DATE_N" StringFormat="####/##/##" />
                        </syncfusion:GridTextColumn.DisplayBinding>
                    </syncfusion:GridTextColumn>

                    <!-- Quantity and Financials -->
                    <syncfusion:GridTextColumn HeaderText="مقدار کالا" MappingName="MEGH" x:Name="MEGH" TextAlignment="Left"  IsHidden="True">
                        <!--<syncfusion:GridTextColumn.DisplayBinding>
                            <Binding Path="MEGH" StringFormat="N2" />
                        </syncfusion:GridTextColumn.DisplayBinding>-->
                    </syncfusion:GridTextColumn>
                    <syncfusion:GridTextColumn HeaderText="مقدار کل کالا" MappingName="MEGHk" x:Name="MEGHk"  TextAlignment="Left"  IsHidden="True">
                        <!--<syncfusion:GridTextColumn.DisplayBinding>
                            <Binding Path="MEGHk" StringFormat="N2" />
                        </syncfusion:GridTextColumn.DisplayBinding>-->
                    </syncfusion:GridTextColumn>

                    <syncfusion:GridTextColumn HeaderText="مقدار مرجوعی" MappingName="MEGH_MAR" x:Name="MEGH_MAR"  TextAlignment="Left"  IsHidden="True">
                        <!--<syncfusion:GridTextColumn.DisplayBinding>
                            <Binding Path="MEGH_MAR" StringFormat="N2" />
                        </syncfusion:GridTextColumn.DisplayBinding>-->
                    </syncfusion:GridTextColumn>

                    <syncfusion:GridTextColumn HeaderText="مبلغ" MappingName="MABL" x:Name="MABL"  TextAlignment="Left" IsHidden="True" >
                        <syncfusion:GridTextColumn.DisplayBinding>
                            <Binding Path="MABL" StringFormat="{}{0:#,0}" />
                        </syncfusion:GridTextColumn.DisplayBinding>
                    </syncfusion:GridTextColumn>

                    <syncfusion:GridTextColumn HeaderText="فی عمده" MappingName="MABL_F" x:Name="MABL_F"  TextAlignment="Left" IsHidden="True" >
                        <syncfusion:GridTextColumn.DisplayBinding>
                            <Binding Path="MABL_F"  StringFormat="{}{0:#,0}" />
                        </syncfusion:GridTextColumn.DisplayBinding>
                    </syncfusion:GridTextColumn>
                    <syncfusion:GridTextColumn HeaderText="مبلغ کل" MappingName="MABL_K" x:Name="MABL_K" TextAlignment="Left" IsHidden="True">
                        <syncfusion:GridTextColumn.DisplayBinding>
                            <Binding Path="MABL_K"  StringFormat="{}{0:#,0}" />
                        </syncfusion:GridTextColumn.DisplayBinding>
                    </syncfusion:GridTextColumn>
                    <syncfusion:GridTextColumn HeaderText="مبلغ خالص" MappingName="KHFR" x:Name="KHFR" TextAlignment="Left"  IsHidden="True">
                        <syncfusion:GridTextColumn.DisplayBinding>
                            <Binding Path="KHFR"  StringFormat="{}{0:#,0}" />
                        </syncfusion:GridTextColumn.DisplayBinding>
                    </syncfusion:GridTextColumn>
                    <syncfusion:GridTextColumn HeaderText="قابل پرداخت" MappingName="GHFR" x:Name="GHFR"  TextAlignment="Left" IsHidden="True">
                        <syncfusion:GridTextColumn.DisplayBinding>
                            <Binding Path="GHFR"  StringFormat="{}{0:#,0}" />
                        </syncfusion:GridTextColumn.DisplayBinding>
                    </syncfusion:GridTextColumn>
                    <syncfusion:GridTextColumn HeaderText="مبلغ تخفیف" MappingName="N_MOIN" x:Name="N_MOIN" TextAlignment="Left"  IsHidden="True">
                        <syncfusion:GridTextColumn.DisplayBinding>
                            <Binding Path="N_MOIN"  StringFormat="{}{0:#,0}" />
                        </syncfusion:GridTextColumn.DisplayBinding>
                    </syncfusion:GridTextColumn>

                    <syncfusion:GridTextColumn HeaderText="Price" MappingName="N_TAF" x:Name="N_TAF" TextAlignment="Left" IsHidden="True">
                        <syncfusion:GridTextColumn.DisplayBinding>
                            <Binding Path="N_TAF"  StringFormat="{}{0:#,0}" />
                        </syncfusion:GridTextColumn.DisplayBinding>
                    </syncfusion:GridTextColumn>

                    <syncfusion:GridTextColumn HeaderText="Total Price" MappingName="TOTALARZ" x:Name="TOTALARZ" TextAlignment="Left" IsHidden="True">
                        <syncfusion:GridTextColumn.DisplayBinding>
                            <Binding Path="TOTALARZ"  StringFormat="{}{0:#,0}" />
                        </syncfusion:GridTextColumn.DisplayBinding>
                    </syncfusion:GridTextColumn>

                    <syncfusion:GridTextColumn HeaderText="ارزش افزوده" MappingName="IMBAA" x:Name="IMBAA" TextAlignment="Left"  IsHidden="True">
                        <syncfusion:GridTextColumn.DisplayBinding>
                            <Binding Path="IMBAA"  StringFormat="{}{0:#,0}" />
                        </syncfusion:GridTextColumn.DisplayBinding>
                    </syncfusion:GridTextColumn>

                    <syncfusion:GridTextColumn HeaderText="درصد تخفیف" MappingName="N_KOL" x:Name="N_KOL" TextAlignment="Left"  IsHidden="True">
                        <syncfusion:GridTextColumn.DisplayBinding>
                            <Binding Path="N_KOL" StringFormat="N2" />
                        </syncfusion:GridTextColumn.DisplayBinding>
                    </syncfusion:GridTextColumn>

                    <syncfusion:GridTextColumn HeaderText="درصد تخفیف نقدی" MappingName="TKHN" x:Name="TKHN" TextAlignment="Left" IsHidden="True">
                        <syncfusion:GridTextColumn.DisplayBinding>
                            <Binding Path="TKHN" StringFormat="N2" />
                        </syncfusion:GridTextColumn.DisplayBinding>
                    </syncfusion:GridTextColumn>

                    <syncfusion:GridTextColumn HeaderText="فی میانگین" MappingName="AVRAGE" x:Name="AVRAGE" TextAlignment="Left"  IsHidden="True">
                        <syncfusion:GridTextColumn.DisplayBinding>
                            <Binding Path="AVRAGE"  StringFormat="{}{0:#,0}" />
                        </syncfusion:GridTextColumn.DisplayBinding>
                    </syncfusion:GridTextColumn>

                    <syncfusion:GridTextColumn HeaderText="مبلغ ریالی" MappingName="mabrial" x:Name="MABRIAL" TextAlignment="Left"  IsHidden="True">
                        <syncfusion:GridTextColumn.DisplayBinding>
                            <Binding Path="mabrial"  StringFormat="{}{0:#,0}" />
                        </syncfusion:GridTextColumn.DisplayBinding>
                    </syncfusion:GridTextColumn>

                    <syncfusion:GridTextColumn HeaderText="حداقل موجودی" MappingName="MIN_M" x:Name="MIN_M" TextAlignment="Left"  IsHidden="True">
                        <syncfusion:GridTextColumn.DisplayBinding>
                            <Binding Path="MIN_M" StringFormat="N2" />
                        </syncfusion:GridTextColumn.DisplayBinding>
                    </syncfusion:GridTextColumn>

                    <syncfusion:GridTextColumn HeaderText="حداکثر موجودی" MappingName="MAX_M" x:Name="MAX_M" TextAlignment="Left" IsHidden="True">
                        <syncfusion:GridTextColumn.DisplayBinding>
                            <Binding Path="MAX_M" StringFormat="N2" />
                        </syncfusion:GridTextColumn.DisplayBinding>
                    </syncfusion:GridTextColumn>

                    <syncfusion:GridTextColumn HeaderText="نقطه سفارش" MappingName="N_SEF" x:Name="N_SEF" TextAlignment="Left" IsHidden="True">
                        <syncfusion:GridTextColumn.DisplayBinding>
                            <Binding Path="N_SEF" StringFormat="N2" />
                        </syncfusion:GridTextColumn.DisplayBinding>
                    </syncfusion:GridTextColumn>

                    <syncfusion:GridTextColumn HeaderText="بهینه سفارش" MappingName="B_SEF" x:Name="B_SEF" TextAlignment="Left" IsHidden="True">
                        <syncfusion:GridTextColumn.DisplayBinding>
                            <Binding Path="B_SEF" StringFormat="N2" />
                        </syncfusion:GridTextColumn.DisplayBinding>
                    </syncfusion:GridTextColumn>

                    <syncfusion:GridTextColumn HeaderText="مدت" MappingName="MAS" x:Name="MAS" TextAlignment="Left" IsHidden="True">
                        <syncfusion:GridTextColumn.DisplayBinding>
                            <Binding Path="MAS" StringFormat="N0" />
                        </syncfusion:GridTextColumn.DisplayBinding>
                    </syncfusion:GridTextColumn>

                    <syncfusion:GridTextColumn HeaderText="وزن" MappingName="vazn" x:Name="VAZN" TextAlignment="Left"  IsHidden="True">
                        <syncfusion:GridTextColumn.DisplayBinding>
                            <Binding Path="vazn" StringFormat="N2" />
                        </syncfusion:GridTextColumn.DisplayBinding>
                    </syncfusion:GridTextColumn>

                    <!-- Customer and Personnel Information -->
                    <syncfusion:GridTextColumn HeaderText="کد شخص" MappingName="hes" x:Name="HES" TextAlignment="Left" IsHidden="True"/>
                    <syncfusion:GridTextColumn HeaderText="نام شخص" MappingName="CUSTNAME" Width="300" x:Name="CUSTNAME" ColumnSizer="SizeToCells" TextAlignment="Left"  IsHidden="True"/>
                    <!--<syncfusion:GridTextColumn HeaderText="نوع مشتری" MappingName="CUSTKNAME" TextAlignment="Left"  IsHidden="True" />-->
                    <syncfusion:GridComboBoxColumn 
                    x:Name="CUST_COD" IsHidden="True"
                    HeaderText="نوع مشتری"
                    MappingName="CUST_COD"
                    SelectedValuePath="CUST_COD"
                    DisplayMemberPath="CUSTKNAME"/>

                    <syncfusion:GridTextColumn HeaderText="نام کاربر" MappingName="USER_NAME" x:Name="USER_NAME" TextAlignment="Left"  IsHidden="True" />
                    <!--<syncfusion:GridComboBoxColumn 
                    x:Name="USER_NAME" IsHidden="True"
                    HeaderText="نام کاربری"
                    MappingName="USER_NAME"
                    SelectedValuePath="SAL_NAME"
                    DisplayMemberPath="SAL_NAME"/>-->

                    <syncfusion:GridTextColumn HeaderText="ملاحظات" MappingName="SHARAYET" Width="150" x:Name="SHARAYET" TextAlignment="Left"  IsHidden="True" />

                    <!-- Warehouse and Grouping -->
                    <!--<syncfusion:GridTextColumn HeaderText="نام انبار" MappingName="ANBNAME" TextAlignment="Left" IsHidden="True"/>-->
                    <syncfusion:GridComboBoxColumn IsHidden="True"
                    x:Name="ANBARCODE"
                    HeaderText="نام انبار"
                    MappingName="ANBARCODE"
                    SelectedValuePath="CODE"
                    DisplayMemberPath="NAMES"/>

                    <!--<syncfusion:GridTextColumn HeaderText="نام گروه کالا" MappingName="GRPNAME" TextAlignment="Left"  IsHidden="True"/>-->
                    <syncfusion:GridComboBoxColumn IsHidden="True" 
                    x:Name="GRPCODE"
                    HeaderText="گروه کالا"  ColumnSizer="SizeToCells" 
                    MappingName="GRPCODE"
                    SelectedValuePath="CODE"
                    DisplayMemberPath="NAMES"/>

                    <!--<syncfusion:GridTextColumn HeaderText="نام واحد کالا" MappingName="VAHEDNAME" TextAlignment="Left" IsHidden="True"/>-->
                    <syncfusion:GridComboBoxColumn 
                    x:Name="VAHCODE" IsHidden="True"
                    HeaderText="واحد کالا"
                    MappingName="VAHCODE"
                    SelectedValuePath="CODE"
                    DisplayMemberPath="NAMES"/>

                    <!--<syncfusion:GridTextColumn HeaderText="واحد" MappingName="DEPNAME" TextAlignment="Left"  IsHidden="True" />-->
                    <syncfusion:GridComboBoxColumn 
                    x:Name="DEPATMAN" IsHidden="True"
                    HeaderText="واحد | دپارتمان"
                    MappingName="DEPATMAN"
                    SelectedValuePath="DEPATMAN"
                    DisplayMemberPath="DEPNAME"/>

                    <!--<syncfusion:GridTextColumn HeaderText="شیفت" MappingName="SHNAME" TextAlignment="Left"  IsHidden="True" />-->
                    <syncfusion:GridComboBoxColumn 
                    x:Name="SHIFT_ID" IsHidden="True"
                    HeaderText="شیفت"
                    MappingName="SHIFT_ID"
                    SelectedValuePath="SHNAME"
                    DisplayMemberPath="SHIFT_ID"/>

                    <syncfusion:GridTextColumn HeaderText="ماه" MappingName="MM" x:Name="MM" TextAlignment="Left" IsHidden="True" />
                    <syncfusion:GridComboBoxColumn IsHidden="{Binding ElementName=MM,Path=IsHidden}"
                    x:Name="MM_COLUMN"
                    HeaderText="ماه"
                    MappingName="MM"
                    SelectedValuePath="MON_ID"
                    DisplayMemberPath="MON"/>

                    <syncfusion:GridComboBoxColumn x:Name="N_RASID_COLUMN" IsHidden="{Binding ElementName=N_RASID,Path=IsHidden}"
                    HeaderText="محل مصرف"
                    MappingName="N_RASID"
                    SelectedValuePath="FNUMB"
                    DisplayMemberPath="NAM"/>
                    <syncfusion:GridTextColumn HeaderText="کد محصل مصرف" MappingName="N_RASID"  x:Name="N_RASID" TextAlignment="Left"  IsHidden="True" />

                    <!-- Document and Order Details -->
                    <syncfusion:GridTextColumn HeaderText="شماره سند" MappingName="N_S"  TextAlignment="Left"  x:Name="N_S" IsHidden="True" />
                    <syncfusion:GridTextColumn HeaderText="شماره فاکتور برگشت" MappingName="NUMBER1" x:Name="NUMBER1"   TextAlignment="Left"  IsHidden="True"/>
                    <syncfusion:GridTextColumn HeaderText="شماره فاکتور فروشنده" MappingName="FNUMCO" x:Name="FNUMCO"   TextAlignment="Left"  IsHidden="True"/>
                    <syncfusion:GridTextColumn HeaderText="ملاحظات سطر" MappingName="MANDAH" Width="200" x:Name="MANDAH" TextAlignment="Left"   IsHidden="True"/>
                    <syncfusion:GridTextColumn HeaderText="توضیحات فاکتور" MappingName="MOLAH"  x:Name="MOLAH" TextAlignment="Left"  Width="250" IsHidden="True" />
                    <syncfusion:GridTextColumn HeaderText="شماره فنی" MappingName="N_FANI" x:Name="N_FANI"  TextAlignment="Left"   IsHidden="True"/>
                    <syncfusion:GridTextColumn HeaderText="بارگیری" MappingName="TAMIR" x:Name="TAMIR"  TextAlignment="Left" IsHidden="True"/>

                    <!-- Flags and Ticks -->
                    <syncfusion:GridCheckBoxColumn HeaderText="محاسبه ارزش افزوده" MappingName="TICMBAA" x:Name="TICMBAA"  TextAlignment="Left"  IsHidden="True" />
                    <syncfusion:GridCheckBoxColumn HeaderText="تایید برگه" MappingName="OKF" x:Name="OKF"  TextAlignment="Left"  IsHidden="True" />
                    <syncfusion:GridCheckBoxColumn HeaderText="مشمول مالیات" MappingName="CMBAA" x:Name="CMBAA"  TextAlignment="Left"   IsHidden="True"/>

                    <!-- Additional/Optional Columns from the model -->
                    <syncfusion:GridTextColumn HeaderText="آدرس" MappingName="ADDRESS" x:Name="ADDRESS"  Width="300" TextAlignment="Left"  IsHidden="True"/>
                    <syncfusion:GridTextColumn HeaderText="تلفن" MappingName="TEL"  x:Name="TEL" TextAlignment="Left"  IsHidden="True"/>
                    <syncfusion:GridTextColumn HeaderText="موبایل" MappingName="MOBILE" x:Name="MOBILE"  TextAlignment="Left"  IsHidden="True"/>

                    <!--<syncfusion:GridTextColumn HeaderText="استان" MappingName="OSNAME" x:Name="OSNAME"  TextAlignment="Left" IsHidden="True"/>-->
                    <syncfusion:GridComboBoxColumn IsHidden="True"
                    x:Name="OSTANID"
                    HeaderText="استان"
                    MappingName="OSTANID"
                    SelectedValuePath="OSCODE"
                    DisplayMemberPath="OSNAME"/>

                    <!--<syncfusion:GridTextColumn HeaderText="شهر" MappingName="CITYNAME" x:Name="CITYNAME" TextAlignment="Left"  IsHidden="True"/>-->
                    <syncfusion:GridComboBoxColumn IsHidden="True"
                    x:Name="SHAHRID"
                    HeaderText="شهر"
                    MappingName="SHAHRID"
                    SelectedValuePath="CITYCODE"
                    DisplayMemberPath="CITYNAME"/>

                    <syncfusion:GridTextColumn HeaderText="مسیر ویزیت" MappingName="ROUTE_NAME" x:Name="ROUTE_NAME"  TextAlignment="Left"  IsHidden="True"/>
                    <!--<syncfusion:GridComboBoxColumn 
                    x:Name="ROUTE_NAME"
                    HeaderText="مسیر ویزیت"
                    MappingName="ROUTE_NAME"
                    SelectedValuePath="ROUTE_NAME"
                    DisplayMemberPath="Expr1"/>-->


                    <syncfusion:GridTextColumn HeaderText="col1" MappingName="col1" x:Name="col1" TextAlignment="Left" IsHidden="True"/>
                    <syncfusion:GridTextColumn HeaderText="col2" MappingName="col2" x:Name="col2" TextAlignment="Left" IsHidden="True"/>
