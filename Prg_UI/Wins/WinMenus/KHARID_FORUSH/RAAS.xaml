<Window x:Class="Prg_UI.Wins.WinMenus.KHARID_FORUSH.RAAS"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.KHARID_FORUSH"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        mc:Ignorable="d"
        FontFamily="{StaticResource IRANYEKAN}"
        Background="{x:Null}"
        AllowsTransparency="True"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Title="RAAS" Height="500" Width="800"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>

    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="mygrid">
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"
                CornerRadius="10" Padding="8" BorderThickness="1" Margin="2,0,3,0">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label Content="راس گیری" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0" BorderBrush="{x:Null}" Background="Transparent" FontSize="12" Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0" BorderBrush="{x:Null}" Background="Transparent" FontSize="12" Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0" BorderBrush="{x:Null}" Background="Transparent" FontSize="12" Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Width="1" Height="1"/>
        <Grid Margin="10,50,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Content="تاریخ مبنا:" Margin="5"/>
            <TextBox x:Name="Text0" Style="{StaticResource FuzzyOut}" Grid.Row="0" Grid.Column="1" Width="120" Margin="5" PreviewLostKeyboardFocus="Text0_PreviewLostKeyboardFocus" TextChanged="Text0_TextChanged"/>

            <TextBox x:Name="USERID" Style="{StaticResource FuzzyOut}" Grid.Row="0" Grid.Column="3" Width="80" Margin="5" IsReadOnly="True"/>
            <Label Grid.Row="0" Grid.Column="2" Content="کاربر:" Margin="5"/>

            <Label Grid.Row="0" Grid.Column="4" Content="راس:" Margin="5"/>
            <TextBox x:Name="MABL" Grid.Row="0" Style="{StaticResource FuzzyOut}" Grid.Column="5" Width="120" Margin="5" IsReadOnly="True"/>

            <DataGrid x:Name="RAAS_SUB"
                      Grid.Row="1"
                      Grid.Column="0"
                      Grid.ColumnSpan="6"
                      KeyboardNavigation.TabNavigation="Contained"
                      ItemsSource="{Binding RAAS_DATA}"
                      ColumnHeaderStyle="{StaticResource CenteryHeaderstyle}"
                      CellStyle="{StaticResource CellFocusyBorder}"
                      HorizontalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                      VerticalGridLinesBrush="{StaticResource GENERAL_Grlicom}" 
                      EnableColumnVirtualization="True"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"         
                      FlowDirection="RightToLeft"
                      AutoGenerateColumns="False"
                      CellEditEnding="RAAS_SUB_CellEditEnding"
                      RowEditEnding="RAAS_SUB_RowEditEnding"
                      PreviewKeyDown="RAAS_SUB_PreviewKeyDown"
                      SelectionMode="Extended"
                      SelectionUnit="FullRow"
                      Margin="0,5,0,5">
                
                <DataGrid.Style>
                    <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource MaterialDesignDataGrid}">
                        <Setter Property="materialDesign:DataGridAssist.EnableEditBoxAssist" Value="False"/>
                        <Setter Property="GridLinesVisibility" Value="All"/>
                    </Style>
                </DataGrid.Style>
                
                <DataGrid.Columns>
                    <DataGridTextColumn Header="تاریخ سررسید" Width="0.7*" Binding="{Binding DATE_S, StringFormat=####/##/##}"/>
                    <DataGridTextColumn Header="مبلغ" Width="0.7*" Binding="{Binding MABL,StringFormat={}{0:N0}}"/>
                    <DataGridTextColumn Header="مدت" Width="0.4*" Binding="{Binding ROOS}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="مبلغ کل" Width="*" Binding="{Binding MABK,StringFormat={}{0:N0}}" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="6" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,5,0,0">
                <Label Content="جمع مبلغ:" Margin="5,0"/>
                <TextBox x:Name="Text6" Style="{StaticResource FuzzyOut}" Width="120" Margin="5,0" IsReadOnly="True"/>
                <Label Content="جمع مبلغ کل:" Margin="15,0,5,0"/>
                <TextBox x:Name="SMABK" Style="{StaticResource FuzzyOut}" Width="120" Margin="5,0" IsReadOnly="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
