                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding JAY}" Value="0">
                                                <Setter Property="Background" Value="{Binding ElementName=NUMBER_COLUMN,Path=Background}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding JAY}" Value="{x:Null}">
                                                <Setter Property="Background" Value="{Binding ElementName=NUMBER_COLUMN,Path=Background}" />
