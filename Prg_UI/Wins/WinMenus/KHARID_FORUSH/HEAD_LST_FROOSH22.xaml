    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True"  VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>

        <ContextMenu x:Key="ContextUtilityMenu1" FontSize="12" FontFamily="IRANYekanFN">
            <MenuItem Header="صورت حساب این مشتری" x:Name="F8_CUSTOMER" Click="F8_CUSTOMER_Click">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FileDocument" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="لیست چکهای پاس نشده این مشتری"  x:Name="CheksNotPassed" Click="CheksNotPassed_Click">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="Checkbook" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="سابقه فروش کالا"  x:Name="SalesCutsNo" Click="SalesCutsNo_Click">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="Checkbook" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <ContextMenu x:Key="ContextUtilityMenu2" IsEnabled="{Binding ElementName=INVO_LST_sub,Path=IsEnabled}" FontSize="12" FontFamily="IRANYekanFN">
            <MenuItem Header="مرتب سازی مجدد سطر (کالا) های فاکتور و ذخیره"  Click="MenuItem_Click">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="Sort" />
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem Header="کارت انبار این کالا"  Click="MenuItem_Click_1">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="Warehouse" />
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem Header="محاسبه و اعمال مجدد تخفیف" Click="MenuItem_Click_2">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="Calculator" />
                </MenuItem.Icon>
                <MenuItem.Style>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource MaterialDesignMenuItem}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=PEID, Path=SelectedIndex}" Value="-1">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>

        </ContextMenu>

    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>

    <!--<Grid x:Name="mygrid" DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}">-->
    <Grid x:Name="mygrid" ContextMenu="{StaticResource ContextUtilityMenu1}" DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}">

        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Border  Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
