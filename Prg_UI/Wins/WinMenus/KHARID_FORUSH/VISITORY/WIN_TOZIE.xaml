<Window x:Class="Prg_UI.Wins.WinMenus.KHARID_FORUSH.VISITORY.WIN_TOZIE"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.KHARID_FORUSH.VISITORY"
        mc:Ignorable="d"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="{StaticResource IRANYEKAN}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterScreen"
        Title="تعيين مسير وزيت براي مشتريان" Height="690" Width="710" MinHeight="690" MinWidth="1105" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="mygrid">
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="600,410,504,273"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label x:Name="LABEL_HEADER" Content="تنظیم لیست دستی توضیع" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                                                   Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <!--HEADER↑-->

        <Grid Margin="5,40,5,5">
            <Label Content="شماره برگه:" Margin="0,14,5,0"  FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="54" Height="26" VerticalAlignment="Top"/>
            <TextBox x:Name="USER_NAME" IsReadOnly="True" Text="نام کاربر" Height="30" Margin="605,57,267,0"   Style="{StaticResource FuzzyOut}"   TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible"  Padding="3" IsTabStop="False" />
            <Label Content="کاربر:" Margin="0,58,237,0"  FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="30" Height="28" VerticalAlignment="Top"/>
            <Button x:Name="ESLAH" Content="اصلاح برگه" Margin="110,105,0,0"  Style="{StaticResource GerdC}"  BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="10" Height="34" VerticalAlignment="Top" HorizontalAlignment="Left" Width="105" Foreground="#DDFFFFFF" FontWeight="Bold" Click="ESLAH_Click"/>

            <ComboBox x:Name="TDRIVER" FlowDirection="RightToLeft" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" DisplayMemberPath="TDRIVER" SelectedValuePath="TDRIVER" IsTextSearchEnabled="True" PreviewLostKeyboardFocus="TDRIVER_PreviewLostKeyboardFocus" IsEditable="True" Height="30" Margin="0,12,376,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="337">
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
            </ComboBox>
            <ComboBox x:Name="TCITY" Style="{StaticResource FuzzyOutComboBox}" FlowDirection="RightToLeft" Padding="7,0,10,0" DisplayMemberPath="TCITY" SelectedValuePath="TCITY"  IsTextSearchEnabled="True" PreviewLostKeyboardFocus="TCITY_PreviewLostKeyboardFocus" IsEditable="True" Height="28" Margin="0,58,61,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="176">
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
            </ComboBox>

            <DataGrid   
                d:ItemsSource="{d:SampleData ItemCount=2}"
                x:Name="DG_SUB"
                EnableColumnVirtualization="True"
                EnableRowVirtualization="True"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                SelectedIndex="0"
                ColumnHeaderStyle="{StaticResource CenteryHeaderstyle}"
                CellStyle="{StaticResource CellFocusyBorder}"
                HorizontalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                VerticalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                ItemsSource="{Binding TOZIE_SUB_DATA}"
                KeyboardNavigation.TabNavigation="Contained"
                IsReadOnly="True"
                VirtualizingPanel.ScrollUnit="Pixel"
                ScrollViewer.CanContentScroll="True"
                
                AutoGenerateColumns="False" 
                FlowDirection="RightToLeft" 
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                SelectionUnit="FullRow" 
                Margin="4,176,4,65" BorderThickness="1" CellEditEnding="DG_SUB_CellEditEnding" PreviewMouseLeftButtonUp="DG_SUB_PreviewMouseLeftButtonUp" SelectionChanged="DG_SUB_SelectionChanged" RowEditEnding="DG_SUB_RowEditEnding" PreviewKeyDown="DG_SUB_PreviewKeyDown" PreparingCellForEdit="DG_SUB_PreparingCellForEdit" BeginningEdit="DG_SUB_BeginningEdit"  ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <!--<DataGrid.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                    </ItemsPanelTemplate>
                </DataGrid.ItemsPanel>-->

                <DataGrid.Style>
                    <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource MaterialDesignDataGrid}">
                        <Setter Property="materialDesign:DataGridAssist.EnableEditBoxAssist" Value="False"/>
                        <Setter Property="GridLinesVisibility" Value="All"/>
                    </Style>
                </DataGrid.Style>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="شماره حواله" Binding="{Binding NUMBER}" MinWidth="100" IsReadOnly="True"/>
                    <DataGridTextColumn Header="تاریخ حواله"  Binding="{Binding DATE_N, StringFormat=####/##/##}" IsReadOnly="True" MinWidth="65"/>
                    <DataGridTextColumn Header="کد مشتری" Binding="{Binding CUST_NO}"  MinWidth="120" IsReadOnly="False">
                        <!-- ظاهر تکست‌باکس وقتی در مد ادیت هست -->
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                                <!-- خواندنی باشد -->
                                <Setter Property="IsReadOnly" Value="True"/>
                                <!-- اما فوکوس و انتخاب متن را همچنان مجاز بدار -->
                                <Setter Property="Focusable" Value="True"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="نام مشتری" Binding="{Binding NAME_HES}"  Width="*" IsReadOnly="False">
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                                <Setter Property="IsReadOnly" Value="True"/>
                                <Setter Property="Focusable" Value="True"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>

            </DataGrid>

            <Button x:Name="BTN_DELETE" Content="حذف" Tag="hazfer" BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Margin="6,105,0,0" Height="34" VerticalAlignment="Top" HorizontalAlignment="Left" Width="94" Click="BTN_DELETE_Click" />

            <Button x:Name="BTN_SAVE" Click="BTN_SAVE_Click" Content="ذخیره" BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="10" Foreground="#DDFFFFFF" Height="34" Margin="0,105,2,0" VerticalAlignment="Top" TabIndex="4" HorizontalAlignment="Right" Width="115" />
            <Button x:Name="Command106" Content="چاپ" Margin="4,54,0,0"  Style="{StaticResource GerdC}"  BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="10" Height="36" VerticalAlignment="Top" HorizontalAlignment="Left" Width="101" Foreground="#DDFFFFFF" FontWeight="Bold" Click="Command106_Click"/>
            <CNC:NumericTextBox x:Name="TID" Height="30" Margin="0,12,61,0" IsReadOnly="False" DoesAcceptDouble="False" DigitGroupOnEnter="False" RestoreLastValidValue="True" LastValueShouldZero="False" Text="" VerticalAlignment="Top" Visibility="Visible"  HorizontalAlignment="Right" Width="120"/>

            <xctk:MaskedTextBox x:Name="TDATE" TabIndex="0"  Style="{StaticResource FuzzyOut}" Padding="3"  Mask="0000/00/00" Height="30" Margin="0,12,238,0" TextWrapping="Wrap" VerticalAlignment="Top"  BorderThickness="1" FontSize="12"  HorizontalAlignment="Right" Width="88" />

            <Label Content="نام راننده:" FlowDirection="RightToLeft" Width="Auto" Height="Auto" HorizontalAlignment="Right" VerticalAlignment="Top" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,14,327,0" FontSize="10"/>
            <Label Content="شهر:" FlowDirection="RightToLeft" Width="Auto" Height="Auto" HorizontalAlignment="Right" VerticalAlignment="Top" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,59,31,0" FontSize="10"/>
            <ComboBox x:Name="TMAMUR" Style="{StaticResource FuzzyOutComboBox}" FlowDirection="RightToLeft" Padding="7,0,10,0" DisplayMemberPath="TMAMUR" SelectedValuePath="TMAMUR"  IsTextSearchEnabled="True" PreviewLostKeyboardFocus="TMAMUR_PreviewLostKeyboardFocus" IsEditable="True" Height="28" Margin="4,14,779,0" VerticalAlignment="Top">
                <ComboBox.Resources>
                    <Style TargetType="TextBox" BasedOn="{StaticResource FuzzyOut}" >
                        <Setter Property="MaxLength" Value="40"/>
                        <Setter Property="Padding" Value="3"/>
                    </Style>
                </ComboBox.Resources>
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
            </ComboBox>
            <Label Content="مامور توضیع:" FlowDirection="RightToLeft" Width="Auto" Height="Auto" HorizontalAlignment="Right" VerticalAlignment="Top" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,14,713,0" FontSize="10"/>
            <Label Content="مشتریان زیرمجموعه:" FlowDirection="RightToLeft" Width="Auto" Height="Auto" HorizontalAlignment="Right" VerticalAlignment="Top" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,149,2,0" FontSize="10"/>
            <Label Content="تاریخ برگه:" Margin="0,14,186,0"  FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="52" Height="26" VerticalAlignment="Top"/>
            <Button x:Name="Command106_Copy" Content="چاپ حواله" Margin="110,55,0,0"  Style="{StaticResource GerdC}"  BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="10" Height="34" VerticalAlignment="Top" HorizontalAlignment="Left" Width="105" Foreground="#DDFFFFFF" FontWeight="Bold" Click="Command106_Copy_Click"/>
            <Button x:Name="BTN_HAVLAH_KALA" Content="دریافت لیست فاکتور ها برای حواله" Margin="350,56,0,0"  Style="{StaticResource GerdC}"  BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="10" Height="34" VerticalAlignment="Top" HorizontalAlignment="Left" Width="245" Foreground="#DDFFFFFF" FontWeight="Bold" Click="BTN_HAVLAH_KALA_Click"/>
            <Button x:Name="BTN_FACTOS" Content="چاپ فاکتور ها" Margin="222,56,0,0"  Style="{StaticResource GerdC}"  BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="10" Height="34" VerticalAlignment="Top" HorizontalAlignment="Left" Width="120" Foreground="#DDFFFFFF" FontWeight="Bold" Click="BTN_FACTOS_Click"/>
        </Grid>

        <CNC:RecordNavigatorControl x:Name="navigatorControl" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="427,0,0,18"/>
    </Grid>
</Window>
