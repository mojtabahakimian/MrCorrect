                                          FontSize="{TemplateBinding FontSize}"
                                          FontStretch="{TemplateBinding FontWeight}"
                                          FontStyle="{TemplateBinding FontStyle}"
                                          FontWeight="{TemplateBinding FontWeight}"
                                          Foreground="{TemplateBinding Foreground}"
                                          IsThreeState="True"
                                          Visibility="{Binding Visibility,
                                                               ElementName=PART_ItemsControl}" />
                                            </Border>
                                        </Grid>

                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Improve filter performance by using AdvancedFilter without generating unique items -->
        <Style TargetType="{x:Type sfusion:AdvancedFilterControl}">
            <Setter Property="CanGenerateUniqueItems" Value="True" />
        </Style>
        <Style x:Key="filterControlStyle" TargetType="{x:Type sfusion:GridFilterControl}">
            <Setter Property="FilterMode" Value="AdvancedFilter" />
        </Style>
        <!--FilterStylePopup } -->

        <ContextMenu x:Key="DataGridContextMenu" FontFamily="{StaticResource IRANYEKAN}">
            <MenuItem Header="پالودن با این بخش" Click="FilterBySelection_Click">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="Filter"  FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <!--Filter Excluding Selection-->
            <MenuItem Header="پالودن بدون این بخش" Click="FilterExcludingSelection_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FilterRemove" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="کـپـی" Click="MenuItem_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="ContentCopy" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="حذف پالودن (فیلتر)" Click="RemoveFilterSort_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FilterRemoveOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="خروجی اکسل" Click="EXPORTEXCEL_BTN" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FileExcelOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <DataTemplate x:Key="StatCheckedTemplate">
            <CheckBox 
    IsChecked="True"
    IsEnabled="False"
    Style="{StaticResource MaterialDesignCheckBox}"
    materialDesign:ColorZoneAssist.Mode="PrimaryDark"
            Foreground="#2196F3"
              BorderBrush="#2196F3"
              Background="#E3F2FD"
              FocusVisualStyle="{x:Null}"/>
        </DataTemplate>

        <DataTemplate x:Key="StatUncheckedTemplate">
            <CheckBox IsChecked="False" IsEnabled="False"
              Foreground="#B0B0B0"
              BorderBrush="#B0B0B0"
              Background="White"
              FocusVisualStyle="{x:Null}"/>
        </DataTemplate>

        <local:StatCheckBoxTemplateSelector 
    x:Key="StatCheckBoxTemplateSelector"
    CheckedTemplate="{StaticResource StatCheckedTemplate}"
    UncheckedTemplate="{StaticResource StatUncheckedTemplate}" />
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="mygrid">
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="557,410,462,353"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label x:Name="WINTILENAME" Content="لیست پورسانت ها" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                                                       Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <!--HEADER↑-->
         
        <syncfusion:SfDataGrid x:Name="SYNCFUSION_DG" ContextMenu="{StaticResource DataGridContextMenu}"
           ItemsSource="{Binding FLIST_PORSANT_DATA}" FilterRowPosition="Top"
           AutoGenerateColumns="False" SelectedIndex="0"
           EnableDataVirtualization="True"
           SelectionUnit="Row"
           IsReadOnly="True"
           AllowDraggingColumns="True"
           AllowResizingColumns="True"
           AllowFiltering="True"
           AllowSorting="True"
           RowHeight="30"
           SelectionMode="Extended"                   
           FrozenColumnCount="0"
           FlowDirection="RightToLeft"
           d:ItemsSource="{d:SampleData ItemCount=5}"
           Style="{StaticResource KDG}"
           HeaderStyle="{StaticResource KDGHeader}"
           BorderBrush="{StaticResource GENERAL_Grlicom}"
           PreviewMouseRightButtonDown="SYNCFUSION_DG_PreviewMouseRightButtonDown"
           CurrentCellActivated="SYNCFUSION_DG_CurrentCellActivated"
		   SelectionChanged="SYNCFUSION_DG_SelectionChanged"
		   PreviewKeyDown="SYNCFUSION_DG_PreviewKeyDown"
           Margin="10,49,10,10" AllowRowHoverHighlighting="True" AllowSelectionOnPointerPressed="True" ScrollMode="Async" ShowRowHeader="True" ShowGroupDropArea="True"  AlternationCount="2" AlternatingRowStyle="{StaticResource AlternatingRowStyle}">

            <syncfusion:SfDataGrid.Resources>
                <ResourceDictionary>
                    <Style TargetType="TextBox">
                        <Setter Property="AcceptsReturn" Value="True" />
                        <Setter Property="Height" Value="30" />
                    </Style>
                </ResourceDictionary>
            </syncfusion:SfDataGrid.Resources>

            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn HeaderText="ماه" MappingName="mm" Width="60"/>
                <syncfusion:GridTextColumn HeaderText="تاریخ فاکتور" MappingName="DATE_N" Width="130">
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="DATE_N" StringFormat="####/##/##" />
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>
                <syncfusion:GridTextColumn HeaderText="کد ویزیتور" MappingName="CUST_NO" Width="130"/>
                <syncfusion:GridTextColumn HeaderText="نام ویزیتور" MappingName="Expr1" Width="400"/>
                <syncfusion:GridTextColumn HeaderText="درصد" MappingName="DARSAD" Width="100" />

                <syncfusion:GridTextColumn HeaderText="پورسانت" MappingName="PURSANT" Width="200">
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="PURSANT" StringFormat="{}{0:#,0}" />
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>

                <syncfusion:GridTextColumn HeaderText="شماره فاکتور" MappingName="NUMBER" Width="150">

                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="NUMBER" StringFormat="{}{0:#,0}" />
                    </syncfusion:GridTextColumn.DisplayBinding>


                    <!--<syncfusion:GridTextColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding GHABEL}"   Background="MediumVioletRed"/>
                        </DataTemplate>
                    </syncfusion:GridTextColumn.CellTemplate>-->


                </syncfusion:GridTextColumn>

                <syncfusion:GridTextColumn HeaderText="شماره حواله" MappingName="NUMBER" Width="150">
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="NUMBER" StringFormat="{}{0:#,0}" />
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>

                <syncfusion:GridTextColumn HeaderText="کد مشتری" MappingName="hes" Width="180"/>
                
                <syncfusion:GridTextColumn HeaderText="نام مشتری" MappingName="NAME" Width="400"/>
                
                <syncfusion:GridTextColumn HeaderText="تعداد اقلام" MappingName="AGHLAM" Width="130"/>

                <syncfusion:GridTextColumn HeaderText="مبلغ فاکتور" MappingName="SumOfMABL_K" Width="250">
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="SumOfMABL_K" StringFormat="{}{0:#,0}" />
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>

                <syncfusion:GridTextColumn HeaderText="مبلغ خالص" MappingName="Expr2" Width="250">
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="Expr2" StringFormat="{}{0:#,0}" />
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>
                
                <syncfusion:GridTextColumn HeaderText="توضیح" MappingName="TOZIH" Width="150"/>
                
                <syncfusion:GridComboBoxColumn x:Name="PORID_COLUMN" HeaderText="الگوی پرداخت پورسانت" SelectedValuePath="PORID" DisplayMemberPath="Expr1" MappingName="PORID" Width="400"/>

                <syncfusion:GridTextColumn HeaderText="تلفن" MappingName="TEL" Width="300"/>
                <syncfusion:GridTextColumn HeaderText="موبایل" MappingName="MOBILE" Width="200"/>
                
                <syncfusion:GridTemplateColumn HeaderText="مبلغ ثابت" MappingName="STAT" Width="90">
                    <syncfusion:GridTemplateColumn.CellTemplateSelector>
                        <StaticResource ResourceKey="StatCheckBoxTemplateSelector"/>
                    </syncfusion:GridTemplateColumn.CellTemplateSelector>
                </syncfusion:GridTemplateColumn>

                <syncfusion:GridComboBoxColumn x:Name="DEPATMAN_COLUMN" HeaderText="واحد" SelectedValuePath="DEPATMAN" DisplayMemberPath="DEPNAME" MappingName="DEPATMAN" Width="150"/>
                <syncfusion:GridComboBoxColumn x:Name="SHIFT_COLUMN" HeaderText="شیفت" SelectedValuePath="SHIFT_ID" DisplayMemberPath="SHNAME" MappingName="SHIFT" Width="150"/>
                <syncfusion:GridComboBoxColumn x:Name="CUST_KIND_COLUMN" HeaderText="نوع مشتری" SelectedValuePath="SHIFT_ID" DisplayMemberPath="SHNAME" MappingName="CUST_KIND" Width="150"/>

                <syncfusion:GridTextColumn HeaderText="کاربر" MappingName="USER_NAME" Width="150"/>
                <syncfusion:GridTextColumn HeaderText="مسیر ویزیت" MappingName="ROUTE_NAME" Width="400"/>
                
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

    </Grid>
</Window>
