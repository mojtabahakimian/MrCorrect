<Window x:Class="Prg_UI.Wins.WinMenus.KHARID_FORUSH.VISITORY.VISITOR_DAY_HEAD"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.KHARID_FORUSH.VISITORY"
        mc:Ignorable="d"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="IRANYekanFN"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterScreen"
        Title="تعيين ویزیتو روزانه" Height="690" Width="710" MinHeight="690" MinWidth="1105" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>

        
        <!-- استایل آگاه از ReadOnly برای CheckBox  -->
        <Style x:Key="ReadOnlyAwareCheckBox" TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
            <!-- تنظیمات ظاهری ثابت -->
            <Setter Property="FlowDirection" Value="RightToLeft"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <!-- اگر سلول یا گرید ReadOnly شد ⇒ CheckBox غیرفعال -->
            <Style.Triggers>
                <!-- ستون یا سلول -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGridCell}, Path=IsReadOnly}" Value="True">
                    <Setter Property="IsHitTestVisible" Value="False"/>
                    <Setter Property="Focusable"        Value="False"/>
                </DataTrigger>
                <!-- کل گرید -->
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=DataGrid}, Path=IsReadOnly}" Value="True">
                    <Setter Property="IsHitTestVisible" Value="False"/>
                    <Setter Property="Focusable"        Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>


    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="mygrid">
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="600,410,504,273"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label x:Name="LABEL_HEADER" Content="تعيين ویزیتو روزانه" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                                                       Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <!--HEADER↑-->

        <Grid Margin="5,40,5,5">
            <Label Content="تاریخ ویزیت:" Margin="0,14,2,0"  FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="63" Height="26" VerticalAlignment="Top"/>
            <TextBox x:Name="USER_NAME" IsReadOnly="True" Text="نام کاربر" Height="30" Margin="6,56,894,0"   Style="{StaticResource FuzzyOut}"   TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible"  Padding="3" IsTabStop="False" />
            <Label Content="کاربر:" Margin="204,58,0,0"  FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Left" Width="30" Height="28" VerticalAlignment="Top"/>
            <Label Content="ویزیتور:" Margin="0,14,160,0"  FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="41" Height="26" VerticalAlignment="Top"/>
            <ComboBox x:Name="HES" StaysOpenOnEdit="True" IsSynchronizedWithCurrentItem="True" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Margin="211,12,200,0" VerticalAlignment="Top" Height="30" FlowDirection="RightToLeft"   IsEditable="True"  Background="{x:Null}" BorderThickness="1" PreviewLostKeyboardFocus="HES_PreviewLostKeyboardFocus" TabIndex="1">
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
            </ComboBox>
            <ComboBox x:Name="HES2"  IsSynchronizedWithCurrentItem="True" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Margin="6,12,0,0" VerticalAlignment="Top" Height="30" FlowDirection="RightToLeft"   IsEditable="True"  Background="{x:Null}" BorderThickness="1" HorizontalAlignment="Left" Width="195">
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
            </ComboBox>
            <Button x:Name="ESLAH" Content="اصلاح برگه" Margin="548,54,0,0"  Style="{StaticResource GerdC}"  BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="10" Height="36" VerticalAlignment="Top" HorizontalAlignment="Left" Width="92" Foreground="#DDFFFFFF" FontWeight="Bold" Click="ESLAH_Click"/>
            <CheckBox x:Name="OKF" IsChecked="False"  Content="فعال" HorizontalAlignment="Left" Margin="242,61,0,0" VerticalAlignment="Top" Width="49" FontSize="10" IsHitTestVisible="False" Focusable="False"/>

            <DataGrid   
                 d:ItemsSource="{d:SampleData ItemCount=2}"
                 x:Name="DG_SUB"
                 EnableColumnVirtualization="True"
                 EnableRowVirtualization="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 SelectedIndex="0"
                 ColumnHeaderStyle="{StaticResource CenteryHeaderstyle}"
                 CellStyle="{StaticResource CellFocusyBorder}"
                 HorizontalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                 VerticalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                 ItemsSource="{Binding VISIT_DAY_DATA}"
                 KeyboardNavigation.TabNavigation="Contained"
               
                 VirtualizingPanel.ScrollUnit="Pixel"
                 ScrollViewer.CanContentScroll="True"
               
                 AutoGenerateColumns="False" 
                 FlowDirection="RightToLeft" 
                 SelectionUnit="FullRow" 
                 CanUserDeleteRows="False"
                 Margin="4,105,4,111" BorderThickness="1" CellEditEnding="DG_SUB_CellEditEnding" PreviewMouseLeftButtonUp="DG_SUB_PreviewMouseLeftButtonUp" SelectionChanged="DG_SUB_SelectionChanged" RowEditEnding="DG_SUB_RowEditEnding" PreviewKeyDown="DG_SUB_PreviewKeyDown" PreparingCellForEdit="DG_SUB_PreparingCellForEdit" BeginningEdit="DG_SUB_BeginningEdit" >

                <DataGrid.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                    </ItemsPanelTemplate>
                </DataGrid.ItemsPanel>

                <DataGrid.Style>
                    <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource MaterialDesignDataGrid}">
                        <Setter Property="materialDesign:DataGridAssist.EnableEditBoxAssist" Value="False"/>
                        <Setter Property="GridLinesVisibility" Value="All"/>
                    </Style>
                </DataGrid.Style>

                <DataGrid.Columns>
                    <DataGridTemplateColumn SortMemberPath="NAME_HES" x:Name="GR_HES_COLUMN" Header="نام مشتری" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding NAME_HES}" Focusable="False"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>

                        <DataGridTemplateColumn.CellEditingTemplate>
                            <!-- Edit mode: show a ComboBox that searches DB on KeyUp -->
                            <DataTemplate>
                                <ComboBox x:Name="HESEditCombo" 
                                         Loaded="HESEditCombo_Loaded" 
                                         IsEditable="True"
                                         IsTextSearchEnabled="False"
                                         StaysOpenOnEdit="True"
                                         SelectedValuePath="hes"
                                         SelectedValue="{Binding COUST_NO, UpdateSourceTrigger=PropertyChanged}"
                                         VerticalContentAlignment="Center"
                                         MaxDropDownHeight="200"
                                         KeyUp="HESGRP_ComboBox_KeyUp"
                                         SelectionChanged="HESEditCombo_SelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate >
                                            <StackPanel Orientation="Horizontal" >
                                                <TextBlock Text="{Binding NAME}" TextAlignment="Justify" Width="400" Margin="3" />
                                                <TextBlock Text="{Binding hes}"  TextAlignment="Justify" Width="100" Margin="3" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="کد مشتری"
                                       Binding="{Binding COUST_NO}"
                                       Width="Auto"
                                       MinWidth="120"
                                       IsReadOnly="False">
                        <!-- ظاهر تکست‌باکس وقتی در مد ادیت هست -->
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                                <!-- خواندنی باشد -->
                                <Setter Property="IsReadOnly" Value="True"/>
                                <!-- اما فوکوس و انتخاب متن را همچنان مجاز بدار -->
                                <Setter Property="Focusable" Value="True"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>

                    <DataGridCheckBoxColumn x:Name="RACTIVE_COLUMN" Binding="{Binding RACTIVE, UpdateSourceTrigger=LostFocus}" Header="فعال" MinWidth="70" Width="auto">
                        <DataGridCheckBoxColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                <Setter Property="IsTabStop" Value="False"/>
                                <Setter Property="Focusable" Value="False"/>
                            </Style>
                        </DataGridCheckBoxColumn.CellStyle>
                        
                        

                        <DataGridCheckBoxColumn.EditingElementStyle>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource ReadOnlyAwareCheckBox}">
                                <Setter Property="FlowDirection" Value="RightToLeft" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="IsTabStop" Value="False"/>
                                <EventSetter Event="Click" Handler="RACTIVE_CheckBox_Click"/>
                            </Style>
                        </DataGridCheckBoxColumn.EditingElementStyle>
                        <DataGridCheckBoxColumn.ElementStyle>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource ReadOnlyAwareCheckBox}">
                                <Setter Property="FlowDirection" Value="RightToLeft" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="IsTabStop"   Value="True"/>
                                <EventSetter Event="Click" Handler="RACTIVE_CheckBox_Click"/>
                            </Style>
                        </DataGridCheckBoxColumn.ElementStyle>
                    </DataGridCheckBoxColumn>
                    
                    <DataGridComboBoxColumn x:Name="CLASS_COLUMN" MinWidth="120" Width="auto" Header="کلاس مشتری" SelectedValueBinding="{Binding CLASS,UpdateSourceTrigger=LostFocus}" DisplayMemberPath="CLASS" SelectedValuePath="CLASS">
                        <DataGridComboBoxColumn.EditingElementStyle>
                            <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource MaterialDesignComboBox}">
                                <Setter Property="IsEditable" Value="True"/>
                                <Setter Property="ItemsPanel" Value="{StaticResource VSP}"/>
                                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                            </Style>
                        </DataGridComboBoxColumn.EditingElementStyle>
                        <DataGridComboBoxColumn.ElementStyle>
                            <Style TargetType="{x:Type ComboBox}">
                            </Style>
                        </DataGridComboBoxColumn.ElementStyle>
                    </DataGridComboBoxColumn>

                    <DataGridCheckBoxColumn x:Name="TOPLACE_COLUMN" Binding="{Binding TOPLACE, UpdateSourceTrigger=LostFocus}" Header="فقط حضوری" MinWidth="70" Width="auto">

                        <DataGridCheckBoxColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                <Setter Property="IsTabStop" Value="False"/>
                                <Setter Property="Focusable" Value="False"/>
                            </Style>
                        </DataGridCheckBoxColumn.CellStyle>

                        <DataGridCheckBoxColumn.EditingElementStyle>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource ReadOnlyAwareCheckBox}">
                                <Setter Property="FlowDirection" Value="RightToLeft" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="IsTabStop" Value="False"/>
                                <EventSetter Event="Click" Handler="CheckBox_Click"/>
                            </Style>
                        </DataGridCheckBoxColumn.EditingElementStyle>
                        <DataGridCheckBoxColumn.ElementStyle>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource ReadOnlyAwareCheckBox}">
                                <Setter Property="FlowDirection" Value="RightToLeft" />
                                <Setter Property="HorizontalContentAlignment" Value="Center" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="IsTabStop" Value="True"/>
                                <EventSetter Event="Click" Handler="CheckBox_Click"/>
                            </Style>
                        </DataGridCheckBoxColumn.ElementStyle>

                    </DataGridCheckBoxColumn>


                </DataGrid.Columns>

            </DataGrid>

            <TextBox x:Name="TAH" Visibility="Hidden" Height="27" Margin="10,209,0,0" Style="{StaticResource FuzzyOut}" TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  HorizontalAlignment="Left" Width="159"  Padding="3" />

            <Button x:Name="BTN_DELETE" Content="حذف" Tag="hazfer" BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Margin="434,54,0,0" Height="36" VerticalAlignment="Top" HorizontalAlignment="Left" Width="84" Click="BTN_DELETE_Click" />

            <Button x:Name="BTN_SAVE" Click="BTN_SAVE_Click" Content="ذخیره" BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="10" Foreground="#DDFFFFFF" Height="36" Margin="0,54,316,0" VerticalAlignment="Top" TabIndex="4" HorizontalAlignment="Right" Width="115" />
            <Button x:Name="Command106" Content="چاپ" Margin="306,54,0,0"  Style="{StaticResource GerdC}"  BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="10" Height="36" VerticalAlignment="Top" HorizontalAlignment="Left" Width="101" Foreground="#DDFFFFFF" FontWeight="Bold" Click="Command106_Click"/>
            <xctk:MaskedTextBox x:Name="VDATE" Mask="0000/00/00" Style="{StaticResource FuzzyOut}" Padding="3" Height="30" Margin="0,12,65,0" TextWrapping="Wrap" VerticalAlignment="Top"  BorderThickness="1" FontSize="12" HorizontalAlignment="Right" Width="88" />
            <Button x:Name="BTN_GETMASIR" Content="دريافت ليست مشتريان از مسیرهای تعيين شده " Margin="0,54,6,0"  Style="{StaticResource GerdC}"  BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="10" Height="36" VerticalAlignment="Top" HorizontalAlignment="Right" Width="286" Foreground="#DDFFFFFF" FontWeight="Bold" Click="BTN_GETMASIR_Click" IsEnabled="False"/>

        </Grid>

        <CNC:RecordNavigatorControl x:Name="navigatorControl" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="459,0,0,47"/>

    </Grid>
</Window>
