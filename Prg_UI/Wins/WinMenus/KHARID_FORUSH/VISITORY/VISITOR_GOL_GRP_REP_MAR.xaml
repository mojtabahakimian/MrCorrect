<Window x:Class="Prg_UI.Wins.WinMenus.KHARID_FORUSH.VISITORY.VISITOR_GOL_GRP_REP_MAR"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wins.WinMenus.Checkha"
        mc:Ignorable="d" 
        
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:sfusion="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="IRANYekanFN"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Title="VISITOR_GOL_GRP_REP_MAR" Height="450" MinWidth="1320" Width="1320" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>
        <!-- Style for SfDataGrid -->
        <Style x:Key="KDG"  TargetType="syncfusion:SfDataGrid" BasedOn="{StaticResource SfDataGridStyle}">
            <Setter Property="CurrentCellBorderBrush" Value="{StaticResource GENERAL_Grlicom}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="BorderBrush" Value="{StaticResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="HeaderRowHeight" Value="40" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="GridLinesVisibility" Value="Both" />
        </Style>

        <!-- Modified Column Header Style -->
        <Style x:Key="KDGHeader" TargetType="syncfusion:GridHeaderCellControl" BasedOn="{StaticResource GridHeaderCellControlStyle}">
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="BorderBrush" Value="{Binding Background, ElementName=GENERAL_RANG}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="Auto"/>
        </Style>
        <Style TargetType="sfusion:GridCell" BasedOn="{StaticResource GridCellStyle}">
            <Setter Property="BorderBrush" Value="{Binding BorderBrush, ElementName=GENERAL_RANG}" />
        </Style>

        <ContextMenu x:Key="DataGridContextMenu" FontFamily="IRANYekanFN">
            <MenuItem Header="پالودن با این بخش" Click="FilterBySelection_Click">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="Filter"  FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <!--Filter Excluding Selection-->
            <MenuItem Header="پالودن بدون این بخش" Click="FilterExcludingSelection_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FilterRemove" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="کـپـی" Click="MenuItem_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="ContentCopy" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="حذف پالودن (فیلتر)" Click="RemoveFilterSort_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FilterRemoveOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="خروجی اکسل" Click="EXPORTEXCEL_BTN" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FileExcelOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="mygrid">
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="643,410,328,158"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label Content="عملکرد هر ویزیتور به تفکیک ماه و کالا" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                                                   Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <!--Start.......................................................................................-->

        <UniformGrid x:Name="Frame13" Rows="1" Columns="12" FlowDirection="RightToLeft" Margin="4,51,4,0" Height="42" VerticalAlignment="Top">
            <Button BorderBrush="{x:Null}" Tag="12" Click="Button_Click"  Content="اسفند" Height="34" FontSize="12" Foreground="White" FontWeight="Bold"/>
            <Button BorderBrush="{x:Null}" Tag="11" Click="Button_Click"  Content="بهمن" Height="34" FontSize="12" Foreground="White" FontWeight="Bold" />
            <Button BorderBrush="{x:Null}" Tag="10" Click="Button_Click"  Content="دی" Height="34" FontSize="12" Foreground="White" FontWeight="Bold" />
            <Button BorderBrush="{x:Null}" Tag="09" Click="Button_Click"  Content="آذر" Height="34" FontSize="12" Foreground="White" FontWeight="Bold" />
            <Button BorderBrush="{x:Null}" Tag="08" Click="Button_Click"  Content="آبان" Height="34" FontSize="12" Foreground="White" FontWeight="Bold" />
            <Button BorderBrush="{x:Null}" Tag="07" Click="Button_Click"  Content="مهر" Height="34" FontSize="12" Foreground="White" FontWeight="Bold" />
            <Button BorderBrush="{x:Null}" Tag="06" Click="Button_Click"  Content="شهریور" Height="34" FontSize="12" Foreground="White" FontWeight="Bold" />
            <Button BorderBrush="{x:Null}" Tag="05" Click="Button_Click"  Content="مرداد" Height="34" FontSize="12" Foreground="White" FontWeight="Bold" />
            <Button BorderBrush="{x:Null}" Tag="04" Click="Button_Click"  Content="تیر" Height="34" FontSize="12" Foreground="White" FontWeight="Bold" />
            <Button BorderBrush="{x:Null}" Tag="03" Click="Button_Click"  Content="خرداد" Height="34" FontSize="12" Foreground="White" FontWeight="Bold" />
            <Button BorderBrush="{x:Null}" Tag="02" Click="Button_Click"  Content="اردیبهشت" Height="34" FontSize="12" Foreground="White" FontWeight="Bold" />
            <Button BorderBrush="{x:Null}" Tag="01" Click="Button_Click"  Content="فروردین" Height="34" FontSize="12" Foreground="White" FontWeight="Bold" />
        </UniformGrid>

        <syncfusion:SfDataGrid x:Name="VGR_GRID" ContextMenu="{StaticResource DataGridContextMenu}"
                     ItemsSource="{Binding VISITOR_GOL_GRP_REP_MAR_DATA}" 
                     AutoGenerateColumns="False"     
                     EnableDataVirtualization="True"
                     SelectionUnit="Row"
                     AllowDraggingColumns="True"
                     AllowResizingColumns="True"
                     AllowFiltering="True"
                     AllowSorting="True"
                     SelectionMode="Extended"
                     RowHeight="30"
                     FrozenColumnCount="0"
                     FlowDirection="RightToLeft"
                     d:ItemsSource="{d:SampleData ItemCount=5}"
                     Style="{StaticResource KDG}"
                               
                     HeaderStyle="{StaticResource KDGHeader}"
                     AllowEditing="True"
                     IsReadOnly="True"
                     PreviewMouseRightButtonDown="VGR_GRID_PreviewMouseRightButtonDown"
                     CurrentCellActivated="VGR_GRID_CurrentCellActivated"
                     Margin="10,164,10,51" AllowRowHoverHighlighting="True" AllowSelectionOnPointerPressed="True" ScrollMode="Async" ShowRowHeader="True" ShowGroupDropArea="True" SelectionChanged="VGR_GRID_SelectionChanged" PreviewKeyDown="VGR_GRID_PreviewKeyDown">


            <syncfusion:SfDataGrid.Columns>

                <syncfusion:GridTextColumn MappingName="MENUIT" HeaderText="کد گروه" Width="100" />
                <syncfusion:GridTextColumn MappingName="NAMES" HeaderText="نام گروه" Width="300"/>

                <syncfusion:GridTextColumn MappingName="MEGHk" HeaderText="مقدار کل فروش" Width="130">

                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="MEGHkS" StringFormat="{}{0:#,0}" />
                    </syncfusion:GridTextColumn.DisplayBinding>


                    <syncfusion:GridTextColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding MEGHkS}"   Background="Green"/>
                        </DataTemplate>
                    </syncfusion:GridTextColumn.CellTemplate>

                </syncfusion:GridTextColumn>

                <syncfusion:GridTextColumn MappingName="MEGHkGOL" HeaderText="هدف" Width="130">

                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="MEGHkGOL" StringFormat="{}{0:#,0}" />
                    </syncfusion:GridTextColumn.DisplayBinding>


                    <syncfusion:GridTextColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding MEGHkGOL}"   Background="DeepSkyBlue"/>
                        </DataTemplate>
                    </syncfusion:GridTextColumn.CellTemplate>

                </syncfusion:GridTextColumn>

                <syncfusion:GridTextColumn MappingName="MANDMEGH" HeaderText="مانده" Width="130">

                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="MANDMEGH" StringFormat="{}{0:#,0}" />
                    </syncfusion:GridTextColumn.DisplayBinding>

                </syncfusion:GridTextColumn>
                <syncfusion:GridTextColumn MappingName="MABL_KS" HeaderText="مبلغ فروش" Width="200">

                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="MABL_KS" StringFormat="{}{0:#,0}" />
                    </syncfusion:GridTextColumn.DisplayBinding>

                </syncfusion:GridTextColumn>
                <syncfusion:GridTextColumn MappingName="DAYMAND" HeaderText="روز مانده" Width="130"/>

                <syncfusion:GridTextColumn MappingName="DARSADFR" HeaderText="درصد تحقق" Width="130">

                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="DARSADFR" StringFormat="{}{0:#,0}" />
                    </syncfusion:GridTextColumn.DisplayBinding>


                    <syncfusion:GridTextColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DARSADFR}"   Background="Orange"/>
                        </DataTemplate>
                    </syncfusion:GridTextColumn.CellTemplate>

                </syncfusion:GridTextColumn>

                <syncfusion:GridTextColumn MappingName="MABMARS" HeaderText="مبلغ مرجوعی" Width="150">

                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="MABMARS" StringFormat="{}{0:#,0}" />
                    </syncfusion:GridTextColumn.DisplayBinding>

                </syncfusion:GridTextColumn>
                <syncfusion:GridTextColumn MappingName="MEGH_MARS" HeaderText="مقدار مرجوعی" Width="150"/>


            </syncfusion:SfDataGrid.Columns>


        </syncfusion:SfDataGrid>

        <Label Content="ویزیتور:" HorizontalAlignment="Right" Margin="0,112,9,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <ComboBox x:Name="HES" SelectedIndex="-1" IsSynchronizedWithCurrentItem="True" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Margin="0,114,60,0" VerticalAlignment="Top" Height="28" FlowDirection="RightToLeft"   IsEditable="True"  Background="{x:Null}" BorderThickness="1" TabIndex="0" PreviewLostKeyboardFocus="HES_PreviewLostKeyboardFocus" HorizontalAlignment="Right" Width="405">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <ComboBox x:Name="HES2"  SelectedIndex="-1" IsSynchronizedWithCurrentItem="True" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Margin="0,114,470,0" VerticalAlignment="Top" Height="28" FlowDirection="RightToLeft"   IsEditable="True"  Background="{x:Null}" BorderThickness="1" HorizontalAlignment="Right" Width="255" PreviewLostKeyboardFocus="HES2_PreviewLostKeyboardFocus">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>

        <Button x:Name="Command55" Content="چاپ" BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Margin="4,107,0,0" Height="34" VerticalAlignment="Top" HorizontalAlignment="Left" Width="181" Click="Command55_Click" />
        <StackPanel x:Name="FG" Margin="0,96,749,0" Orientation="Horizontal" HorizontalAlignment="Right" Width="361" Height="63" VerticalAlignment="Top">

            <RadioButton x:Name="Option56" Checked="FilterCheckBox_Changed" Content="گروه کالا در F12" Margin="50,0,0,0" FlowDirection="RightToLeft"/>
            <RadioButton x:Name="Option58" Checked="FilterCheckBox_Changed" IsChecked="True" Content="گروه بندی ویزیت و منو" Margin="20,0,0,0" FlowDirection="RightToLeft"/>

        </StackPanel>


    </Grid>
</Window>
