<Window x:Class="Prg_UI.Wins.WinMenus.KHARID_FORUSH.VISITORY.VISITORS_PORSANT_HEAD"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.KHARID_FORUSH.VISITORY"
        mc:Ignorable="d"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="{StaticResource IRANYEKAN}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterScreen"
        Title="تعيين پورسانت ويزيتور براي هر كالا" Height="768" Width="1024" MinHeight="600" MinWidth="800" 
        Closing="Window_Closing" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>

        <ContextMenu x:Key="ContextUtilityMenu2" IsEnabled="{Binding ElementName=DG_SUB,Path=IsEnabled}" FontSize="12" FontFamily="{StaticResource IRANYEKAN}">
            <MenuItem Header="کپـــی | Copy" Click="COPY_CLICK" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="ContentCopy" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="انتقال کپی | Paste" Click="PASTE_CLICK" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="ContentPaste" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="خروجی اکسل" Click="EXPORTEXCEL_BTN" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FileExcelOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="mygrid">
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="0" Width="1"/>

        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}" CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label x:Name="LABEL_HEADER" Content="تعيين پورسانت ويزيتور براي هر كالا" Padding="21,10,10,10" Foreground="White" Margin="0,0,800,0" FlowDirection="RightToLeft"/>

                    <Button x:Name="Btn_Close" Margin="0,10,13,0" BorderBrush="{x:Null}" Background="Transparent" FontSize="12" Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False">
                        <materialDesign:PackIcon Kind="WindowClose" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0" BorderBrush="{x:Null}" Background="Transparent" FontSize="12" Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False">
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0" BorderBrush="{x:Null}" Background="Transparent" FontSize="12" Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False">
                        <materialDesign:PackIcon Kind="WindowMaximize" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>

        <Popup x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative" Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1" VerticalAlignment="Center" Background="{x:Null}" FlowDirection="RightToLeft"
                             Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>

        <Grid Margin="5,40,5,5">

            <TextBox x:Name="PORID" Text="0" Height="30" Margin="0,14,92,0" IsReadOnly="True" IsHitTestVisible="False" Style="{StaticResource FuzzyOut}" Padding="3" TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right" Visibility="Visible" HorizontalAlignment="Right" Width="90" Tag="RD" IsTabStop="False" />
            <Label Content="شناسه پورسانت:" Margin="0,16,14,0" FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="78" Height="26" VerticalAlignment="Top"/>

            <xctk:MaskedTextBox x:Name="VDATE" TabIndex="0" Style="{StaticResource FuzzyOut}"  Padding="3" Mask="0000/00/00" Height="30" Margin="0,14,218,0" TextWrapping="Wrap" VerticalAlignment="Top" BorderThickness="1" FontSize="12" HorizontalAlignment="Right" Width="88" PreviewLostKeyboardFocus="DATE_N_PreviewLostKeyboardFocus" />
            <Label Content="تاریخ:" Margin="0,16,184,0" FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="33" Height="26" VerticalAlignment="Top"/>

            <TextBox x:Name="USERNAME" IsReadOnly="True" Height="30" Margin="0,14,346,0"  Style="{StaticResource FuzzyOut}" Padding="3" VerticalAlignment="Top" TextAlignment="Right" HorizontalAlignment="Right" Width="231" IsTabStop="False"/>
            <Label Content="کاربر:" Margin="0,17,316,0" FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="30" Height="26" VerticalAlignment="Top"/>

            <ComboBox x:Name="HES" DisplayMemberPath="NAME" SelectedValuePath="HES" IsSynchronizedWithCurrentItem="True" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Margin="0,54,92,0" VerticalAlignment="Top" Height="30" FlowDirection="RightToLeft" IsEditable="True" Background="{x:Null}" BorderThickness="1" TabIndex="1" HorizontalAlignment="Right" Width="300">
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
            </ComboBox>
            <Label Content="ویزیتور:" Margin="0,56,50,0" FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="41" Height="26" VerticalAlignment="Top"/>

            <ComboBox x:Name="HES2" DisplayMemberPath="HES" SelectedValuePath="HES" IsSynchronizedWithCurrentItem="True" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Margin="0,54,457,0" VerticalAlignment="Top" Height="30" FlowDirection="RightToLeft" IsEditable="True" Background="{x:Null}" BorderThickness="1" TabIndex="2" HorizontalAlignment="Right" Width="120">
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
            </ComboBox>
            <Label Content="کد ویزیتور:" Margin="0,55,400,0" FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="55" Height="26" VerticalAlignment="Top"/>

            <ComboBox x:Name="CUST_COD" DisplayMemberPath="CUSTKNAME" SelectedValuePath="CUST_COD" IsSynchronizedWithCurrentItem="True" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Margin="0,93,92,0" VerticalAlignment="Top" Height="30" FlowDirection="RightToLeft" IsEditable="True" Background="{x:Null}" BorderThickness="1" TabIndex="3" HorizontalAlignment="Right" Width="224">
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
            </ComboBox>
            <Label Content="گروه مشتری:" Margin="0,95,28,0" FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="62" Height="26" VerticalAlignment="Top"/>

            <!--<xctk:MaskedTextBox x:Name="CDATE" TabIndex="4" Style="{StaticResource FuzzyOut}" Padding="3" Mask="0000/00/00" Height="30" Margin="0,92,361,0" TextWrapping="Wrap" VerticalAlignment="Top" BorderThickness="1" FontSize="12" HorizontalAlignment="Right" Width="88"/>
            <Label Content="تا تاریخ:" Margin="0,94,317,0" FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="42" Height="26" VerticalAlignment="Top"/>-->

            <Label Content="تاريخ صرفا براي اطلاع است و تاثيري در محاسبه پورسانت ندارد" Margin="0,94,327,0" Foreground="Gray" FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Top"/>

            <TextBox x:Name="COMMENT" Text="" Height="30" Margin="10,132,92,0" Style="{StaticResource FuzzyOut}" Padding="3" TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right" Visibility="Visible" TabIndex="5" MaxLength="250"/>
            <Label Content="توضیحات:" Margin="0,134,39,0" FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="51" Height="26" VerticalAlignment="Top"/>

            <TextBox x:Name="OKF" Visibility="Collapsed" Text="True"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,12,0,0">
                <Button x:Name="Command100" Content="چاپ" Style="{StaticResource MaterialDesignOutlinedSecondaryButton}" materialDesign:ButtonAssist.CornerRadius="15" FontSize="10" Margin="5" Width="100" Click="Command100_Click"/>
                <Button x:Name="Command23" Content="دریافت لیست کالاها از طریق گروه کالا" IsEnabled="False" Style="{StaticResource MaterialDesignOutlinedSecondaryButton}" materialDesign:ButtonAssist.CornerRadius="15" FontSize="10" Margin="5" Width="220" Click="Command23_Click"/>
            </StackPanel>

            <Button x:Name="BTN_SAVE" Click="BTN_SAVE_Click" Content="ذخیره" BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5" FontSize="10" Foreground="#DDFFFFFF" Height="35" Margin="0,170,14,0" VerticalAlignment="Top" TabIndex="6" HorizontalAlignment="Right" Width="115" />
            <Button x:Name="BTN_DELETE" Content="حذف" Tag="hazfer" BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Margin="4,170,0,0" Height="35" VerticalAlignment="Top" HorizontalAlignment="Left" Width="94" Click="BTN_DELETE_Click" />

            <DataGrid
                d:ItemsSource="{d:SampleData ItemCount=5}"
                x:Name="DG_SUB"
                EnableColumnVirtualization="True"
                EnableRowVirtualization="True"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                SelectedIndex="0"
                ColumnHeaderStyle="{StaticResource CenteryHeaderstyle}"
                CellStyle="{StaticResource CellFocusyBorder}"
                HorizontalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                VerticalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                ItemsSource="{Binding SUB_DATA}"
                ContextMenu="{StaticResource ContextUtilityMenu2}" 
                KeyboardNavigation.TabNavigation="Contained"
                AutoGenerateColumns="False" 
                FlowDirection="RightToLeft" 
                SelectionUnit="FullRow" 
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                CanUserResizeColumns="True" ContextMenuOpening="DG_SUB_ContextMenuOpening" PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown"
                CanUserDeleteRows="False" MouseRightButtonUp="DG_SUB_MouseRightButtonUp"
                Margin="4,215,4,50" BorderThickness="1" 
                CellEditEnding="DG_SUB_CellEditEnding" 
                PreviewMouseLeftButtonUp="DG_SUB_PreviewMouseLeftButtonUp" 
                SelectionChanged="DG_SUB_SelectionChanged" 
                RowEditEnding="DG_SUB_RowEditEnding" 
                PreviewKeyDown="DG_SUB_PreviewKeyDown" 
                PreparingCellForEdit="DG_SUB_PreparingCellForEdit" 
                BeginningEdit="DG_SUB_BeginningEdit" IsReadOnly="True" >

                <DataGrid.Style>
                    <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource MaterialDesignDataGrid}">
                        <Setter Property="materialDesign:DataGridAssist.EnableEditBoxAssist" Value="False"/>
                        <Setter Property="GridLinesVisibility" Value="All"/>
                    </Style>
                </DataGrid.Style>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="کد کالا" Width="80" MinWidth="80" Binding="{Binding CODE,UpdateSourceTrigger=LostFocus}" IsReadOnly="True">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="KeyboardNavigation.IsTabStop" Value="False"/>
                                <Setter Property="IsTabStop"  Value="False"/>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="نام کالا" Binding="{Binding NAME_CODE,UpdateSourceTrigger=LostFocus}" Width="*"/>
                    <DataGridTextColumn Header="درصد پورسانت" Binding="{Binding PORSANT,UpdateSourceTrigger=LostFocus, StringFormat=N2}" Width="Auto"/>
                    <!--<DataGridTextColumn Header="مبلغ پورسانت" Binding="{Binding MABL, StringFormat=N0}" Width="Auto"/>-->
                </DataGrid.Columns>

            </DataGrid>

            <CNC:RecordNavigatorControl x:Name="navigatorControl" VerticalAlignment="Bottom" Margin="10,0,10,10"/>
            <Button x:Name="ESLAH" Click="ESLAH_Click" Content="اصلاح" BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5" FontSize="10" Foreground="#DDFFFFFF" Height="35" Margin="0,170,174,0" VerticalAlignment="Top" TabIndex="6" HorizontalAlignment="Right" Width="88" />
        </Grid>
    </Grid>
</Window>