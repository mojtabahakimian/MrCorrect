<Window x:Class="Prg_UI.Wins.WinMenus.KHARID_FORUSH.WIN_ORDR_HED"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.KHARID_FORUSH"
        mc:Ignorable="d"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Height="655" Width="995"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MinHeight="400"
        FontFamily="{StaticResource IRANYEKAN}"
        Background="{x:Null}"
        AllowsTransparency="True" AllowDrop="True"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="15"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Color="{Binding ElementName=GENERAL_RANG, Path=Background.Color}" Opacity="0.3"/>


        <ContextMenu x:Key="ContextUtilityMenu2" IsEnabled="{Binding ElementName=ORDER_LST_SUB,Path=IsEnabled}" FontSize="12" FontFamily="{StaticResource IRANYEKAN}">
            <MenuItem Header="کارت انبار این کالا"  Click="MenuItem_Click_1">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="Warehouse" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>

    <Grid x:Name="mygrid" Margin="8,8,8,0">
        <!-- Hidden button for color binding reference -->
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Width="1" Height="1"/>
        <!-- Main container -->
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding ElementName=GENERAL_RANG, Path=Background}" BorderThickness="1" CornerRadius="10" Padding="8">
            <!-- Title bar -->
            <Border  x:Name="TitleDrawBar" Style="{StaticResource BordG}"  Background="{Binding ElementName=GENERAL_RANG, Path=Background}"  CornerRadius="10,10,0,0" Margin="-9,-9,-9,0"  Height="38"  VerticalAlignment="Top" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <!-- Window title -->
                    <Label x:Name="LABEL_HEADER" Content="ثبت سفارشات کالا" Padding="17,8,10,10" Foreground="White" Margin="0,0,110,0" VerticalAlignment="Center"/>
                    <!-- Window control buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0">
                        <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0,0,0,-1" IsTabStop="False" ToolTip="Minimize">
                            <materialDesign:PackIcon Kind="WindowMinimize" Width="18" Height="18" Foreground="White"/>
                        </Button>
                        <Button x:Name="Btn_Max" Click="Btn_Max_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" FontSize="12" Height="24" Padding="0" Margin="4,0,0,0" IsTabStop="False" ToolTip="Maximize">
                            <materialDesign:PackIcon Kind="WindowMaximize" Width="17" Height="17" Foreground="White"/>
                        </Button>
                        <Button x:Name="Btn_Close" Click="Btn_Close_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0" Margin="4,0,0,0" FontSize="12" IsTabStop="False" ToolTip="Close">
                            <materialDesign:PackIcon Kind="WindowClose" Width="19" Height="19" Foreground="White"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
        <!-- Notification popup -->
        <Popup x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative" Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Width="{Binding ElementName=mygrid, Path=ActualWidth, Mode=OneWay}" Height="84" Padding="10">
                <TextBox x:Name="Pop1Text1" IsReadOnly="True" Background="Transparent" FlowDirection="RightToLeft" BorderBrush="Transparent" Foreground="White" Text="محل نمایش اعلان های سیستم" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
            </Border>
        </Popup>

        <!-- Content area -->
        <Grid Margin="0,38,0,0" FlowDirection="LeftToRight">

            <TextBox x:Name="NUMBER" Text="0" Height="30" Margin="0,12,81,0" IsReadOnly="True" Style="{StaticResource FuzzyOut}" Padding="3" TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible"  HorizontalAlignment="Right" Width="90" Tag="RD" IsTabStop="False" />
            <xctk:MaskedTextBox x:Name="DATE_N" TabIndex="0"  Style="{StaticResource FuzzyOut}" Padding="3"  Mask="0000/00/00" Height="30" Margin="0,12,211,0" TextWrapping="Wrap" VerticalAlignment="Top"  BorderThickness="1" FontSize="12"  HorizontalAlignment="Right" Width="91" PreviewLostKeyboardFocus="DATE_N_PreviewLostKeyboardFocus" />
            <Label Content="شماره سفارش:" Margin="0,14,12,0"  FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="69" Height="27" VerticalAlignment="Top"/>
            <TextBox x:Name="USER_NAME" IsReadOnly="True" Text="نام کاربر" Height="30" Margin="0,12,341,0"   Style="{StaticResource FuzzyOut}"   TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible"  Padding="3" IsTabStop="False" Width="201" HorizontalAlignment="Right"/>
            <Label Content="تاریخ:" Margin="0,14,176,0"  FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="33" Height="27" VerticalAlignment="Top"/>
            <Label Content="کاربر:" Margin="0,14,306,0"  FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="31" Height="28" VerticalAlignment="Top"/>
            <Label Content="سفارش دهنده:" Margin="0,54,10,0"  FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="72" Height="25" VerticalAlignment="Top"/>
            <Label Content="ملاحظات :" Margin="0,53,347,0"  FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="50" Height="25" VerticalAlignment="Top"/>

            <ComboBox x:Name="CUST_NO" IsSynchronizedWithCurrentItem="True" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Margin="0,52,81,0" VerticalAlignment="Top" Height="30" FlowDirection="RightToLeft"   IsEditable="True"  Background="{x:Null}" BorderThickness="1" PreviewLostKeyboardFocus="CUST_NO_PreviewLostKeyboardFocus" TabIndex="1" HorizontalAlignment="Right" Width="263">
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
            </ComboBox>

            <TextBox x:Name="MOLAH" Text="" Height="30" Margin="125,52,400,0"    Style="{StaticResource FuzzyOut}" Padding="3"    TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible" MaxLength="255" TabIndex="2" />

            <Label Content="قرارداد پیش‌فرض:" Margin="0,99,650,0" FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="85" Height="27" VerticalAlignment="Top"/>
            <ComboBox x:Name="ContractID" Margin="0,94,738,0" VerticalAlignment="Top" Height="30" HorizontalAlignment="Right" Width="240"
                      Style="{StaticResource FuzzyOutComboBox}" DisplayMemberPath="DisplayName" SelectedValuePath="ContractID"
                      IsTextSearchEnabled="True" IsEditable="False" ToolTip="فقط مقدار پیش‌فرض ردیف‌های جدید است؛ قرارداد قطعی در ستون قرارداد ردیف تعیین می‌شود."/>

            <Button x:Name="ESLAH" Content="اصلاح" Margin="0,92,158,0"  Style="{StaticResource GerdC}"  BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="10" Height="35" VerticalAlignment="Top" HorizontalAlignment="Right" Width="92" Foreground="#DDFFFFFF" FontWeight="Bold" Click="ESLAH_Click"/>

            <DataGrid   
                  d:ItemsSource="{d:SampleData ItemCount=2}"
                  x:Name="ORDER_LST_SUB"
                  EnableColumnVirtualization="True"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                
                  SelectedIndex="0"
                  ColumnHeaderStyle="{StaticResource CenteryHeaderstyle}"
                  CellStyle="{StaticResource CellFocusyBorder}"
                  HorizontalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                  VerticalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                  ItemsSource="{Binding ORDR_LST_DATA}"
                  ContextMenu="{StaticResource ContextUtilityMenu2}" 
                  KeyboardNavigation.TabNavigation="Contained"
                  AutoGenerateColumns="False" 
                  FlowDirection="RightToLeft" 
                  SelectionUnit="FullRow" 
                  CanUserDeleteRows="False" MouseRightButtonUp="ORDER_LST_SUB_MouseRightButtonUp"
                  Margin="4,136,4,160" BorderThickness="1" IsKeyboardFocusWithinChanged="ORDER_LST_SUB_IsKeyboardFocusWithinChanged" CellEditEnding="ORDER_LST_SUB_CellEditEnding" PreviewMouseLeftButtonUp="ORDER_LST_SUB_PreviewMouseLeftButtonUp" SelectionChanged="ORDER_LST_SUB_SelectionChanged" RowEditEnding="ORDER_LST_SUB_RowEditEnding" PreviewKeyDown="ORDER_LST_SUB_PreviewKeyDown" PreparingCellForEdit="ORDER_LST_SUB_PreparingCellForEdit" BeginningEdit="ORDER_LST_SUB_BeginningEdit"  ScrollViewer.HorizontalScrollBarVisibility="Auto">

                <DataGrid.Style>
                    <!--خط بندی سطر های دیتاگرید-->
                    <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource MaterialDesignDataGrid}">
                        <Setter Property="materialDesign:DataGridAssist.EnableEditBoxAssist" Value="False"/>
                        <Setter Property="GridLinesVisibility" Value="All"/>
                    </Style>
                </DataGrid.Style>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="کد کالا" Width="80" MinWidth="80" Binding="{Binding CODE}" IsReadOnly="True">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="KeyboardNavigation.IsTabStop" Value="False"/>
                                <Setter Property="IsTabStop"  Value="False"/>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn x:Name="NAME_CODE_COLUMN" Binding="{Binding NAME_CODE,UpdateSourceTrigger=LostFocus}" Header="نام کالا" Width="300" MinWidth="100">
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource MaterialDesignTextBox}">
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>

                    <DataGridComboBoxColumn x:Name="ContractID_COLUMN" Header="قرارداد ردیف" Width="180" MinWidth="150"
                                            SelectedValueBinding="{Binding ContractID, UpdateSourceTrigger=PropertyChanged}"
                                            DisplayMemberPath="DisplayName" SelectedValuePath="ContractID">
                        <DataGridComboBoxColumn.EditingElementStyle>
                            <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource MaterialDesignComboBox}">
                                <Setter Property="IsEditable" Value="True"/>
                                <Setter Property="IsTextSearchEnabled" Value="True"/>
                                <Setter Property="ItemsPanel" Value="{StaticResource VSP}"/>
                            </Style>
                        </DataGridComboBoxColumn.EditingElementStyle>
                    </DataGridComboBoxColumn>

                    <DataGridComboBoxColumn x:Name="VAHED_K_COLUMN"  
                                          Width="auto"   MinWidth="90" Header=" واحد کالا " Visibility="Visible" 
                                          SelectedValueBinding="{Binding VAHED_K, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="NAMES" SelectedValuePath="VAHED">
                        <DataGridComboBoxColumn.EditingElementStyle>
                            <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource MaterialDesignComboBox}">
                                <Setter Property="IsEditable" Value="True"/>
                                <Setter Property="ItemsPanel" Value="{StaticResource VSP}"/>
                                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                            </Style>
                        </DataGridComboBoxColumn.EditingElementStyle>
                        <DataGridComboBoxColumn.ElementStyle>
                            <Style TargetType="{x:Type ComboBox}">
                            </Style>
                        </DataGridComboBoxColumn.ElementStyle>
                        <DataGridComboBoxColumn.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                <Setter Property = "IsTabStop" Value = "False" />
                            </Style>
                        </DataGridComboBoxColumn.CellStyle>
                    </DataGridComboBoxColumn>

                    <DataGridTextColumn 	x:Name="MEGH_COLUMN"	  Binding="{Binding MEGH,UpdateSourceTrigger=LostFocus}"       Header="مقدار"           Width="auto" MinWidth="70" >
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                                <Setter Property="MaxLength" Value="30" />
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn 	x:Name="MEGHK_COLUMN" 	      Binding="{Binding MEGHK,UpdateSourceTrigger=LostFocus}"                                  Header="مقدار کل"               Width="auto" MinWidth="90" >
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                <Setter Property = "IsTabStop" Value = "False" />
                            </Style>
                        </DataGridTextColumn.CellStyle>
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                                <Setter Property="MaxLength" Value="30" />
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn x:Name="CUST_NO_COLUMN" Binding="{Binding CUST_NO,UpdateSourceTrigger=LostFocus}" Header="توضیحات" MinWidth="150" Width="auto">
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource MaterialDesignTextBox}">
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>

                </DataGrid.Columns>

            </DataGrid>

            <TextBox x:Name="MOGU" Text="" Height="30" Margin="10,0,0,122" IsReadOnly="True" Style="{StaticResource FuzzyOut}" Padding="3" TextWrapping="Wrap" VerticalAlignment="Bottom" TextAlignment="Right"  Visibility="Visible"  HorizontalAlignment="Left" Width="150" Tag="RD" IsTabStop="False" />


            <Button x:Name="BTN_DELETE" Content="حذف" Tag="hazfer" BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Margin="5,0,0,483" Height="34" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="84" Click="BTN_DELETE_Click" />

            <Button x:Name="BTN_SAVE" Click="BTN_SAVE_Click" Content="ذخیره" BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="10" Foreground="#DDFFFFFF" Height="35" Margin="0,92,10,0" VerticalAlignment="Top" TabIndex="4" HorizontalAlignment="Right" Width="115" />

            <Button x:Name="BTN_PRINT" Content="چاپ سفارش فروش" Margin="5,0,0,568"  Style="{StaticResource GerdC}"  BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="10" Height="34" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="120" Foreground="#DDFFFFFF" FontWeight="Bold" Click="BTN_PRINT_Click"/>
            <Button x:Name="BTN_PRINT_TOLID" Content="چاپ درخواست تولید" Margin="135,0,0,568"  Style="{StaticResource GerdC}"  BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="10" Height="34" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="127" Foreground="#DDFFFFFF" FontWeight="Bold" Click="BTN_PRINT_TOLID_Click"/>

        </Grid>

        <CheckBox x:Name="SGN1" IsChecked="False" Content="تنظیم کننده"  Margin="0,0,16,124" HorizontalAlignment="Right" Width="90" VerticalAlignment="Bottom" Tag="RD"  Click="SGN1_Click" />
        <CheckBox x:Name="SGN2" IsChecked="False" Content="مدیر مالی"  Margin="0,0,16,91" HorizontalAlignment="Right" Width="90" VerticalAlignment="Bottom" Tag="RD" Click="SGN2_Click"/>
        <CheckBox x:Name="SGN3" IsChecked="False" Content="مدیر عامل"  Margin="0,0,16,56" HorizontalAlignment="Right" Width="90" VerticalAlignment="Bottom" Tag="RD"  Click="SGN3_Click" />

        <ComboBox x:Name="PERSONEL" Tag="RD"
            Style="{StaticResource FuzzyOutComboBox}" Padding="7,0,10,0" IsTextSearchEnabled="True" Margin="0,0,380,122" VerticalAlignment="Bottom" Height="30" FlowDirection="RightToLeft" IsEditable="True" HorizontalAlignment="Right" Width="378" SelectionChanged="PERSONEL_SelectionChanged">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <Label Content="ارجاع به:" HorizontalAlignment="Right" Margin="0,0,325,122" VerticalAlignment="Bottom" FlowDirection="RightToLeft" Width="auto"/>

        <TextBox x:Name="SGN1usid"   Style="{StaticResource FuzzyOut}" Padding="3"  Margin="0,0,114,121" VerticalAlignment="Bottom" Height="28" FlowDirection="RightToLeft" HorizontalAlignment="Right" Width="202" IsReadOnly="True"/>
        <TextBox x:Name="SGN2usid"   Style="{StaticResource FuzzyOut}" Padding="3"  Margin="0,0,114,87" VerticalAlignment="Bottom" Height="28" FlowDirection="RightToLeft" HorizontalAlignment="Right" Width="202" IsReadOnly="True"/>
        <TextBox x:Name="SGN3usid"   Style="{StaticResource FuzzyOut}" Padding="3"  Margin="0,0,114,54" VerticalAlignment="Bottom" Height="28" FlowDirection="RightToLeft"  HorizontalAlignment="Right" Width="202" IsReadOnly="True"/>

        <CNC:RecordNavigatorControl x:Name = "navigatorControl" Margin = "273,0,273,9" Height="38" VerticalAlignment="Bottom" />
        <Label Content="موجودی:" HorizontalAlignment="Right" Margin="0,0,762,123" VerticalAlignment="Bottom" FlowDirection="RightToLeft" Width="auto"/>


    </Grid>
</Window>
