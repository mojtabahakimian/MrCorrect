<Window x:Class="Prg_UI.Wins.WinMenus.KHARID_FORUSH.WIN_CONTRACT_DEF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        Title="مدیریت قراردادهای تولید" Height="720" Width="1180" MinHeight="600" MinWidth="980"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource IRANYEKAN}"
        Background="{x:Null}" AllowsTransparency="True" WindowStyle="None" FlowDirection="RightToLeft"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Color="{Binding ElementName=GENERAL_RANG, Path=Background.Color}" Opacity="0.3"/>
    </Window.Resources>

    <Grid x:Name="mygrid" Margin="8">
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Width="1" Height="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}"
                BorderBrush="{Binding ElementName=GENERAL_RANG, Path=Background}" BorderThickness="1"
                CornerRadius="10" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="42"/>
                </Grid.RowDefinitions>

                <Border x:Name="TitleDrawBar" Grid.Row="0" Style="{StaticResource BordG}"
                        Background="{Binding ElementName=GENERAL_RANG, Path=Background}"
                        CornerRadius="10,10,0,0" Margin="-9,-9,-9,0"
                        MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                    <Grid FlowDirection="LeftToRight">
                        <Label Content="مدیریت قراردادهای تولید" Padding="17,8,10,8" Foreground="White" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0">
                            <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0" IsTabStop="False">
                                <materialDesign:PackIcon Kind="WindowMinimize" Width="18" Height="18" Foreground="White"/>
                            </Button>
                            <Button x:Name="Btn_Max" Click="Btn_Max_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0" Margin="4,0,0,0" IsTabStop="False">
                                <materialDesign:PackIcon Kind="WindowMaximize" Width="17" Height="17" Foreground="White"/>
                            </Button>
                            <Button x:Name="Btn_Close" Click="Btn_Close_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0" Margin="4,0,0,0" IsTabStop="False">
                                <materialDesign:PackIcon Kind="WindowClose" Width="19" Height="19" Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="4,10,4,4" FlowDirection="RightToLeft">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border BorderBrush="{Binding ElementName=GENERAL_RANG, Path=Background}" BorderThickness="1" CornerRadius="5" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Label Content="شماره قرارداد:" VerticalAlignment="Center"/>
                                <TextBox x:Name="ContractNo" Grid.Column="1" Margin="5" Height="30" MaxLength="50" Style="{StaticResource FuzzyOut}"/>
                                <Label Grid.Column="2" Content="تاریخ شمسی:" VerticalAlignment="Center"/>
                                <TextBox x:Name="ContractDate" Grid.Column="3" Margin="5" Height="30" MaxLength="10" Style="{StaticResource FuzzyOut}" TextAlignment="Center"/>
                                <Label Grid.Column="4" Content="برند:" VerticalAlignment="Center"/>
                                <ComboBox x:Name="BrandName" Grid.Column="5" Margin="5" Height="30"
                                          Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}"
                                          SelectedValuePath="NAMES" DisplayMemberPath="NAMES" IsTextSearchEnabled="True"
                                          IsEditable="True" Background="{x:Null}" BorderThickness="1">
                                    <ComboBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True"
                                                                    VirtualizingPanel.VirtualizationMode="Recycling"/>
                                        </ItemsPanelTemplate>
                                    </ComboBox.ItemsPanel>
                                </ComboBox>
                                <StackPanel Grid.Column="6" Orientation="Horizontal"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Margin="8,0,0,0">
                                    <Button x:Name="BTN_SAVE" Content="ذخیره" Click="BTN_SAVE_Click"
                                            Style="{StaticResource GerdC}" Width="96" Height="34" FontSize="10"
                                            Margin="4,0" Foreground="#DDFFFFFF" BorderBrush="{x:Null}"/>
                                    <Button x:Name="ESLAH" Content="اصلاح" Click="ESLAH_Click"
                                            Style="{StaticResource GerdC}" Width="80" Height="34" FontSize="10"
                                            Margin="4,0" Foreground="#DDFFFFFF" BorderBrush="{x:Null}"/>
                                    <Button x:Name="BTN_DELETE" Content="حذف" Click="BTN_DELETE_Click" Tag="hazfer"
                                            Style="{StaticResource GerdC}" Width="90" Height="34" FontSize="10"
                                            Margin="4,0" Foreground="#DDFFFFFF" BorderBrush="{x:Null}"/>
                                </StackPanel>

                                <Label Grid.Row="1" Content="مشتری:" VerticalAlignment="Center"/>
                                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="5" Margin="5">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="146"/>
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CUST_NO" Grid.Column="0" Height="30"
                                              Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}"
                                              IsSynchronizedWithCurrentItem="True" IsEditable="True" IsTextSearchEnabled="True"
                                              Background="{x:Null}" BorderThickness="1" DisplayMemberPath="NAME" SelectedValuePath="hes"
                                              PreviewLostKeyboardFocus="CUST_NO_PreviewLostKeyboardFocus"
                                              SelectionChanged="CUST_NO_SelectionChanged">
                                        <ComboBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True"
                                                                        VirtualizingPanel.VirtualizationMode="Recycling"/>
                                            </ItemsPanelTemplate>
                                        </ComboBox.ItemsPanel>
                                    </ComboBox>
                                    <ComboBox x:Name="CUST_NO2" Grid.Column="1" Height="30" Margin="8,0,0,0"
                                              Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}"
                                              IsSynchronizedWithCurrentItem="True" IsEditable="True" IsTextSearchEnabled="True"
                                              Background="{x:Null}" BorderThickness="1" DisplayMemberPath="hes" SelectedValuePath="hes"
                                              PreviewLostKeyboardFocus="CUST_NO2_PreviewLostKeyboardFocus"
                                              SelectionChanged="CUST_NO_SelectionChanged">
                                        <ComboBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True"
                                                                        VirtualizingPanel.VirtualizationMode="Recycling"/>
                                            </ItemsPanelTemplate>
                                        </ComboBox.ItemsPanel>
                                    </ComboBox>
                                </Grid>
                                <CheckBox x:Name="IsClosed" Grid.Row="1" Grid.Column="6" Content="مختومه" Margin="10,5" VerticalAlignment="Center"/>
                                <Label Grid.Row="2" Content="ملاحظات:" VerticalAlignment="Center"/>
                                <TextBox x:Name="MOLAH" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="5"
                                         Margin="5" Height="30" MaxLength="500" Style="{StaticResource FuzzyOut}"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Margin="0,10,0,0" BorderBrush="{Binding ElementName=GENERAL_RANG, Path=Background}" BorderThickness="1" CornerRadius="5">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Border Background="{Binding ElementName=GENERAL_RANG, Path=Background}" CornerRadius="4,4,0,0">
                                    <TextBlock Text="کالاها و مقدار تعهد قرارداد" Foreground="White" FontWeight="Bold" Margin="12,0" VerticalAlignment="Center"/>
                                </Border>
                                <DataGrid Grid.Row="1" x:Name="DG_DTL" Margin="8" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                                          IsReadOnly="True" BeginningEdit="DG_DTL_BeginningEdit" PreviewKeyDown="DG_DTL_PreviewKeyDown"
                                          CellEditEnding="DG_DTL_CellEditEnding" RowEditEnding="DG_DTL_RowEditEnding"
                                          ColumnHeaderStyle="{StaticResource CenteryHeaderstyle}" CellStyle="{StaticResource CellFocusyBorder}"
                                          HorizontalGridLinesBrush="{StaticResource GENERAL_Grlicom}" VerticalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                                          GridLinesVisibility="All" Style="{StaticResource MaterialDesignDataGrid}"
                                          materialDesign:DataGridAssist.EnableEditBoxAssist="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn x:Name="CODE_COLUMN" Binding="{Binding CODE, UpdateSourceTrigger=LostFocus}"
                                                            Header="کد کالا" Width="Auto" MinWidth="50" IsReadOnly="True" Visibility="Hidden"/>
                                        <DataGridTextColumn Header="کد کالا" Width="80" MinWidth="80" Binding="{Binding CODE}" IsReadOnly="True">
                                            <DataGridTextColumn.CellStyle>
                                                <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                                    <Setter Property="Focusable" Value="False"/>
                                                    <Setter Property="KeyboardNavigation.IsTabStop" Value="False"/>
                                                    <Setter Property="IsTabStop" Value="False"/>
                                                </Style>
                                            </DataGridTextColumn.CellStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn x:Name="NAME_CODE_COLUMN" Binding="{Binding NAME_CODE, UpdateSourceTrigger=LostFocus}"
                                                            Header="نام کالا" Visibility="Visible" Width="*" MinWidth="180">
                                            <DataGridTextColumn.EditingElementStyle>
                                                <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource MaterialDesignTextBox}"/>
                                            </DataGridTextColumn.EditingElementStyle>
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}"/>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="واحد پایه" Width="100" IsReadOnly="True"
                                                            Binding="{Binding UnitName}"/>
                                        <DataGridTextColumn Header="مقدار تعهد" Width="150"
                                            Binding="{Binding Qty, UpdateSourceTrigger=LostFocus, StringFormat=N4}"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                    </Grid>
                </Grid>

                <Border Grid.Row="2" Margin="4,5,4,3" Padding="8,4"
                        Background="#08000000" CornerRadius="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="LBL_TotalQty" Grid.Column="0" Text="جمع مقدار تعهد: 0"
                                   FontSize="14" FontWeight="Bold" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" Margin="8,0"/>

                        <CNC:RecordNavigatorControl x:Name="navigatorControl" Grid.Column="1"
                                                    Width="350" Height="40"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    FlowDirection="LeftToRight"/>

                    </Grid>
                </Border>

                <Border Grid.Row="3" Background="#0F000000" CornerRadius="4" Margin="4,4,4,0">
                    <TextBlock x:Name="LBL_STATUS" Margin="10,0" VerticalAlignment="Center" Foreground="{Binding ElementName=GENERAL_RANG, Path=Background}"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
