<Window x:Class="Prg_UI.Wins.WinMenus.KHARID_FORUSH.WIN_LASTPRICE"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.KHARID_FORUSH"
        mc:Ignorable="d"        
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Height="600" Width="815"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MinHeight="400"
        FontFamily="{StaticResource IRANYEKAN}"
        Background="{x:Null}"
        AllowsTransparency="True" AllowDrop="True"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="15"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Color="{Binding ElementName=GENERAL_RANG, Path=Background.Color}" Opacity="0.3"/>

        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryHueMidBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}"/>
            <Setter Property="FontFamily" Value="{StaticResource IRANYEKAN}"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FlowDirection" Value="RightToLeft"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Border Container -->
                            <Border Grid.Row="0" CornerRadius="5"
                                    Grid.RowSpan="2"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    Background="{StaticResource MaterialDesignPaper}"
                                    Margin="0,0,0,0" BorderThickness="0,0,1,0"/>

                            <!-- Header -->
                            <Border Grid.Row="0" 
                                    HorizontalAlignment="Left" FlowDirection="RightToLeft"
                                    Background="{StaticResource MaterialDesignPaper}"
                                    Margin="5" Padding="7,0,0,0">
                                <DockPanel>
                                    <ContentPresenter ContentSource="Header" 
                                           RecognizesAccessKey="True"
                                           TextBlock.Foreground="{TemplateBinding BorderBrush}"
                                           TextBlock.FontWeight="SemiBold"
                                           TextBlock.FontSize="14"
                                           VerticalAlignment="Center"/>

                                </DockPanel>
                            </Border>

                            <!-- Content -->
                            <ContentPresenter Grid.Row="1" 
                                   Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid x:Name="mygrid" Margin="8,8,8,0">
        <!-- Hidden button for color binding reference -->
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Width="1" Height="1"/>
        <!-- Main container -->
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding ElementName=GENERAL_RANG, Path=Background}" BorderThickness="1" CornerRadius="10" Padding="8">
            <!-- Title bar -->
            <Border  x:Name="TitleDrawBar" Style="{StaticResource BordG}"  Background="{Binding ElementName=GENERAL_RANG, Path=Background}"  CornerRadius="10,10,0,0" Margin="-9,-9,-9,0"  Height="38"  VerticalAlignment="Top" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <!-- Window title -->
                    <Label x:Name="LABEL_HEADER" Content="آخرین قیمت ها" Padding="17,8,10,10" Foreground="White" Margin="0,0,110,0" VerticalAlignment="Center"/>
                    <!-- Window control buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0">
                        <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0,0,0,-1" IsTabStop="False" ToolTip="Minimize">
                            <materialDesign:PackIcon Kind="WindowMinimize" Width="18" Height="18" Foreground="White"/>
                        </Button>
                        <Button x:Name="Btn_Max" Click="Btn_Max_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" FontSize="12" Height="24" Padding="0" Margin="4,0,0,0" IsTabStop="False" ToolTip="Maximize">
                            <materialDesign:PackIcon Kind="WindowMaximize" Width="17" Height="17" Foreground="White"/>
                        </Button>
                        <Button x:Name="Btn_Close" Click="Btn_Close_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0" Margin="4,0,0,0" FontSize="12" IsTabStop="False" ToolTip="Close">
                            <materialDesign:PackIcon Kind="WindowClose" Width="19" Height="19" Foreground="White"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
        <!-- Notification popup -->
        <Popup x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative" Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Width="{Binding ElementName=mygrid, Path=ActualWidth, Mode=OneWay}" Height="84" Padding="10">
                <TextBox x:Name="Pop1Text1" IsReadOnly="True" Background="Transparent" FlowDirection="RightToLeft" BorderBrush="Transparent" Foreground="White" Text="محل نمایش اعلان های سیستم" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
            </Border>
        </Popup>

        <!-- Content area -->
        <Grid Margin="0,38,0,0" FlowDirection="RightToLeft">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <GroupBox Header="انتخاب کالا" Padding="10,8,10,10" FlowDirection="RightToLeft">
                    <Grid>
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,733,0"><Run FlowDirection="RightToLeft" Language="fa-ir" Text="کالا:"/></TextBlock>
                        <ComboBox x:Name="CODE" IsSynchronizedWithCurrentItem="True"                                 
                                  Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}"
                                  MinWidth="260" Margin="280,0,0,0"
                                  Height="30" PreviewLostKeyboardFocus="CODE_PreviewLostKeyboardFocus"
                                  VerticalContentAlignment="Center"
                                  DisplayMemberPath="NAME"
                                  SelectedValuePath="CODE"
                                  SelectionChanged="CODE_SelectionChanged"
                                  IsTextSearchEnabled="True"
                                  IsEditable="True" >
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>
                        <ComboBox x:Name="Combo13" IsSynchronizedWithCurrentItem="True"
                          MinWidth="180" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}"
                          Height="30" Margin="25,0,480,0"
                          VerticalContentAlignment="Center"
                          DisplayMemberPath="CODE"
                          SelectedValuePath="CODE"
                          SelectionChanged="Combo13_SelectionChanged"
                          LostFocus="Combo13_LostFocus"
                          IsTextSearchEnabled="True"
                          IsEditable="True" >
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>
                    </Grid>
                </GroupBox>

                <GroupBox Grid.Row="1" Header="انتخاب مشتری" Padding="10,8,10,10">
                    <Grid>

                        <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,716,0"><Run FlowDirection="RightToLeft" Language="fa-ir" Text="مشتری:"/></TextBlock>
                        <ComboBox x:Name="HMOIN1" IsSynchronizedWithCurrentItem="True"                         
                                  Padding="7,0,10,0"
                                  Style="{StaticResource FuzzyOutComboBox}"
                                  MinWidth="260" PreviewLostKeyboardFocus="HMOIN1_PreviewLostKeyboardFocus"
                                  Height="30"
                                  VerticalContentAlignment="Center"
                                  DisplayMemberPath="HES"
                                  SelectedValuePath="HES"
                                  SelectionChanged="HMOIN1_SelectionChanged"      
                                  IsTextSearchEnabled="True"
                                  IsEditable="True" Margin="47,0,0,0" HorizontalAlignment="Left" Width="238">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>
                        <ComboBox x:Name="HHMOIN1" IsSynchronizedWithCurrentItem="True"                                
                                  Padding="7,0,10,0"
                                  Style="{StaticResource FuzzyOutComboBox}"
                                  MinWidth="260"
                                  Height="30"
                                  VerticalContentAlignment="Center"
                                  DisplayMemberPath="NAME"
                                  SelectedValuePath="HES"
                                  SelectionChanged="HHMOIN1_SelectionChanged"
                                  IsTextSearchEnabled="True"
                                  IsEditable="True" Margin="312,0,0,0">
                            <ComboBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                                </ItemsPanelTemplate>
                            </ComboBox.ItemsPanel>
                        </ComboBox>
                    </Grid>
                </GroupBox>

                <Button Grid.Row="2"
                        Style="{StaticResource MaterialDesignOutlinedSecondaryButton}" 
                        materialDesign:ButtonAssist.CornerRadius="15" Click="Button_Click" Margin="0,5,0,0">
                    <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight">
                        <materialDesign:PackIcon Kind="Refresh" 
                                 Width="20" 
                                 Height="20" 
                                 VerticalAlignment="Center" 
                                 Margin="0,0,8,0" />
                        <TextBlock Text="پردازش و دریافت آخرین قیمت " 
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <GroupBox Grid.Row="3" Header="آخرین قیمت‌ها" Padding="10,8,10,10" Margin="0,10,0,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="80"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="80"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*" MinWidth="80"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" Text="آخرین قیمت فروش:"/>
                        <CNC:NumericTextBox DoesAcceptDouble="False" IsDigitGroupActive="True" DigitGroupOnEnter="True" x:Name="LFP" Grid.Row="0" Grid.Column="1" Height="28" IsReadOnly="True"/>

                        <TextBlock Grid.Row="0" Grid.Column="3" VerticalAlignment="Center" Margin="0,0,8,0" Text="آخرین قیمت خرید:"/>
                        <CNC:NumericTextBox DoesAcceptDouble="False" IsDigitGroupActive="True" DigitGroupOnEnter="True" x:Name="LKP" Grid.Row="0" Grid.Column="4" Height="28" IsReadOnly="True"/>

                        <TextBlock Grid.Row="0" Grid.Column="6" VerticalAlignment="Center" Margin="0,0,8,0" Text="قیمت اولیه:"/>
                        <CNC:NumericTextBox DoesAcceptDouble="False" IsDigitGroupActive="True" DigitGroupOnEnter="True" x:Name="LP" Grid.Row="0" Grid.Column="7" Height="28" IsReadOnly="True"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,10,8,0" Text="آخرین فروش به این مشتری:"/>
                        <CNC:NumericTextBox DoesAcceptDouble="False" IsDigitGroupActive="True" DigitGroupOnEnter="True" x:Name="LFPM" Grid.Row="1" Grid.Column="1" Height="28" Margin="0,10,0,0" IsReadOnly="True"/>

                        <TextBlock Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" Margin="0,10,8,0" Text="تاریخ:"/>
                        <xctk:MaskedTextBox x:Name="DT" Style="{StaticResource FuzzyOut}" FlowDirection="LeftToRight" TextAlignment="Left" Padding="3" Mask="0000/00/00" Text="" Grid.Row="1" Grid.Column="4" Height="28" Margin="0,10,0,0" HorizontalContentAlignment="Right" VerticalContentAlignment="Center" LostFocus="DT_LostFocus"/>
                    </Grid>
                </GroupBox>

                <TabControl Grid.Row="4" Margin="0,0,0,8">
                    <TabItem Header="سابقه فروش کالا به مشتری">
                        <DataGrid x:Name="DGR_SaleHistory"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="شماره" Binding="{Binding NUMBER}" Width="90" Visibility="Hidden"/>
                                <DataGridTextColumn Header="تاریخ" Binding="{Binding DATE_N_FM, StringFormat=####/##/##}" Width="110"/>
                                <DataGridTextColumn Header="مبلغ" Binding="{Binding MABL, StringFormat=N0}" Width="140"/>
                                <DataGridTextColumn Header="مبلغ کل" Binding="{Binding MABL_K, StringFormat=N0}" Width="140"/>
                                <DataGridTextColumn Header="طرف حساب" Binding="{Binding CUST_NAME}" Width="*" Visibility="Hidden"/>
                                <DataGridTextColumn Header="مقدار کل کالا" Binding="{Binding MEGHk, StringFormat=N2}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="سابقه خرید کالا">
                        <DataGrid x:Name="DGR_BuyHistory"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  GridLinesVisibility="Horizontal"
                                  HeadersVisibility="Column"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="شماره" Binding="{Binding NUMBER}" Width="90" Visibility="Hidden"/>
                                <DataGridTextColumn Header="تاریخ" Binding="{Binding DATE_N_FM, StringFormat=####/##/##}" Width="110"/>
                                <DataGridTextColumn Header="مبلغ" Binding="{Binding MABL, StringFormat=N0}" Width="140"/>
                                <DataGridTextColumn Header="مبلغ کل" Binding="{Binding MABL_K, StringFormat=N0}" Width="140"/>
                                <DataGridTextColumn Header="طرف حساب" Binding="{Binding CUST_NAME}" Width="*" Visibility="Hidden"/>
                                <DataGridTextColumn Header="مقدار کل کالا" Binding="{Binding MEGHk, StringFormat=N2}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>

                <DockPanel Grid.Row="4" LastChildFill="False"/>
            </Grid>
        </Grid>
    </Grid>
</Window>