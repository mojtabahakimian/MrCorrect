<Window x:Class="Prg_UI.Wins.WinMenus.KHARID_FORUSH.KARTBANK"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.KHARID_FORUSH"
        mc:Ignorable="d"
         xmlns:CNC="clr-namespace:Prg_UI.CUC"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Background="{x:Null}"
    FontFamily="IRANYekanFN"
    AllowsTransparency="True"
    AllowDrop="True" WindowStyle="None"
    Title="" Height="100" Width="430"  WindowStartupLocation="CenterScreen"  KeyDown="Window_KeyDown" Loaded="Window_Loaded">
    <Grid x:Name="mygrid">
        <Border CornerRadius="10,10,10,10"  Padding="8" RenderTransformOrigin="0.5,0.5" Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding ElementName=GENERAL_RANG,Path=Background}" Grid.ColumnSpan="5">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding ElementName=GENERAL_RANG,Path=Background}"  Margin="-7.999,-7.928,-8,0" VerticalAlignment="Top" MinHeight="27" UseLayoutRounding="False" Height="16.667" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Label Content="کارت بانک" Padding="10,6,6,6" Foreground="White" FontSize="9"/>
            </Border>
        </Border>
        <CNC:NumericTextBox DoesAcceptDouble="False" IsDigitGroupActive="True" ThreeTwoZero="True"   x:Name="Text0"  Height="27"   VerticalAlignment="Bottom"   Visibility="Visible"  HorizontalAlignment="Left" Width="166"  Text="0" Margin="193,0,0,24" />
        <TextBlock Text="کارت بانک :" HorizontalAlignment="Left" Height="23" Margin="361,50,0,0" VerticalAlignment="Top" Width="60" FlowDirection="RightToLeft"/>
        <Button x:Name="OK_BTN" FontSize="8"   Width="67" Height="35" Content="تایید" HorizontalAlignment="Left" Margin="6,43,0,0" VerticalAlignment="Top"  Padding="1,1,1,4" TabIndex="1" BorderBrush="{x:Null}" Foreground="#DDFFFFFF" Click="OK_BTN_Click"/>

        <ComboBox x:Name="PORTP"  Padding="7,0,10,0" Style="{StaticResource MaterialDesignOutlinedComboBox}" IsTextSearchEnabled="True" Margin="78,48,0,0" VerticalAlignment="Top" Height="28" FlowDirection="RightToLeft"   IsEditable="True"  Background="{x:Null}" BorderThickness="1" HorizontalAlignment="Left" Width="110" SelectedValue="COM1" SelectedValuePath="Content">
            <ComboBoxItem Content="COM1"/>
            <ComboBoxItem Content="COM2"/>
            <ComboBoxItem Content="COM3"/>
            <ComboBoxItem Content="COM4"/>
            <ComboBoxItem Content="COM5"/>
            <ComboBoxItem Content="COM6"/>
            <ComboBoxItem Content="COM7"/>
            <ComboBoxItem Content="COM8"/>
            <ComboBoxItem Content="COM9"/>
            <ComboBoxItem Content="COM10"/>
            <ComboBoxItem Content="COM11"/>
            <ComboBoxItem Content="COM12"/>
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>

        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="95,56,0,0"  Width="1"/>
        <Button x:Name="Btn_Close_Copy" Margin="0,4,11,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="20" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
            <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
        </Button>
        <Button x:Name="Btn_Minimize_Copy" Click="Btn_Minimize_Click" Margin="0,4,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="20" VerticalAlignment="Top" HorizontalAlignment="Right" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
            <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
        </Button>

    </Grid>
</Window>
