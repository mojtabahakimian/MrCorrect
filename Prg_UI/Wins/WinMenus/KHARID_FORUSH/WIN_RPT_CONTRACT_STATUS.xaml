<Window x:Class="Prg_UI.Wins.WinMenus.KHARID_FORUSH.WIN_RPT_CONTRACT_STATUS"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="گزارش وضعیت قراردادهای تولید" Height="720" Width="1280" MinHeight="560" MinWidth="1050"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource IRANYEKAN}"
        Background="{x:Null}" AllowsTransparency="True" WindowStyle="None" FlowDirection="RightToLeft"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/></WindowChrome.WindowChrome>
    <Window.Resources><SolidColorBrush x:Key="GENERAL_Grlicom" Color="{Binding ElementName=GENERAL_RANG, Path=Background.Color}" Opacity="0.3"/></Window.Resources>

    <Grid x:Name="mygrid" Margin="8">
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Width="1" Height="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding ElementName=GENERAL_RANG, Path=Background}" BorderThickness="1" CornerRadius="10" Padding="8">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="76"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
                <Border x:Name="TitleDrawBar" Grid.Row="0" Style="{StaticResource BordG}" Background="{Binding ElementName=GENERAL_RANG, Path=Background}" CornerRadius="10,10,0,0" Margin="-9,-9,-9,0" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                    <Grid FlowDirection="LeftToRight">
                        <Label Content="گزارش فورس وضعیت قراردادهای تولید و فروش" Padding="17,8,10,8" Foreground="White" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0">
                            <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0" IsTabStop="False"><materialDesign:PackIcon Kind="WindowMinimize" Width="18" Height="18" Foreground="White"/></Button>
                            <Button x:Name="Btn_Max" Click="Btn_Max_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0" Margin="4,0,0,0" IsTabStop="False"><materialDesign:PackIcon Kind="WindowMaximize" Width="17" Height="17" Foreground="White"/></Button>
                            <Button x:Name="Btn_Close" Click="Btn_Close_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0" Margin="4,0,0,0" IsTabStop="False"><materialDesign:PackIcon Kind="WindowClose" Width="19" Height="19" Foreground="White"/></Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Margin="4,10,4,4" BorderBrush="{Binding ElementName=GENERAL_RANG, Path=Background}" BorderThickness="1" CornerRadius="5" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="260"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="140"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
                        <Label Content="قرارداد:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CMB_CONTRACT" Grid.Column="1" Margin="5" Height="30" Style="{StaticResource FuzzyOutComboBox}" DisplayMemberPath="DisplayName" SelectedValuePath="ContractID"/>
                        <Label Grid.Column="2" Content="از تاریخ:" VerticalAlignment="Center"/>
                        <TextBox x:Name="TXT_FROM_DATE" Grid.Column="3" Margin="5" Height="30" MaxLength="10" Style="{StaticResource FuzzyOut}" TextAlignment="Center" ToolTip="خالی یعنی بدون محدودیت"/>
                        <CheckBox x:Name="CHK_OPEN_ONLY" Grid.Column="4" Content="فقط قراردادهای باز" Margin="12,5" VerticalAlignment="Center" IsChecked="True"/>
                        <Button Grid.Column="6" Content="نمایش گزارش" Click="BTN_REFRESH_Click" Style="{StaticResource GerdC}" Height="34" Margin="4" Foreground="White"/>
                    </Grid>
                </Border>

                <DataGrid Grid.Row="2" x:Name="DG_REPORT" Margin="4" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True" FrozenColumnCount="3"
                          ColumnHeaderStyle="{StaticResource CenteryHeaderstyle}" CellStyle="{StaticResource CellFocusyBorder}"
                          HorizontalGridLinesBrush="{StaticResource GENERAL_Grlicom}" VerticalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                          GridLinesVisibility="All" Style="{StaticResource MaterialDesignDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="شماره قرارداد" Binding="{Binding ContractNo}" Width="110"/>
                        <DataGridTextColumn Header="مشتری" Binding="{Binding CustName}" Width="180"/>
                        <DataGridTextColumn Header="برند" Binding="{Binding BrandName}" Width="140"/>
                        <DataGridTextColumn Header="طرح / کالا" Binding="{Binding ProductName}" Width="200"/>
                        <DataGridTextColumn Header="مقدار قرارداد" Binding="{Binding ContractedQty, StringFormat=N4}" Width="115"/>
                        <DataGridTextColumn Header="تولید شده" Binding="{Binding ProducedQty, StringFormat=N4}" Width="110"/>
                        <DataGridTextColumn Header="مانده تولید" Binding="{Binding RemainToProduce, StringFormat=N4}" Width="110"/>
                        <DataGridTextColumn Header="مازاد تولید" Binding="{Binding OverProducedQty, StringFormat=N4}" Width="105"/>
                        <DataGridTextColumn Header="فروش خالص" Binding="{Binding SoldQty, StringFormat=N4}" Width="110"/>
                        <DataGridTextColumn Header="مانده تولید قرارداد" Binding="{Binding RemainInWarehouse, StringFormat=N4}" Width="145"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="3" Margin="4,6,4,0" BorderBrush="{Binding ElementName=GENERAL_RANG, Path=Background}" BorderThickness="1" CornerRadius="5" Background="#0A000000">
                    <Grid Margin="10,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="TXT_CONTRACTED" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TXT_PRODUCED" Grid.Column="1" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TXT_REMAIN" Grid.Column="2" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TXT_SOLD" Grid.Column="3" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TXT_STOCK" Grid.Column="4" FontWeight="Bold" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
