<Window x:Class="Prg_UI.Wins.WinMenus.KHARID_FORUSH.WIN_RPT_CONTRACT_STATUS"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="گزارش وضعیت قراردادهای تولید" Height="780" Width="1360" MinHeight="680" MinWidth="1120"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterScreen" FontFamily="{StaticResource IRANYEKAN}"
        Background="{x:Null}" AllowsTransparency="True" WindowStyle="None" FlowDirection="RightToLeft"
        Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Color="{Binding ElementName=GENERAL_RANG, Path=Background.Color}" Opacity="0.3"/>
        <Style x:Key="KpiTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style x:Key="KpiValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="mygrid" Margin="8">
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Width="1" Height="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}"
                BorderBrush="{Binding ElementName=GENERAL_RANG, Path=Background}" BorderThickness="1"
                CornerRadius="10" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="52"/>
                    <RowDefinition Height="120"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border x:Name="TitleDrawBar" Grid.Row="0" Style="{StaticResource BordG}"
                        Background="{Binding ElementName=GENERAL_RANG, Path=Background}"
                        CornerRadius="10,10,0,0" Margin="-9,-9,-9,0"
                        MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                    <Grid FlowDirection="LeftToRight">
                        <Label Content="گزارش فورس وضعیت قراردادهای تولید و فروش" Padding="17,8,10,8" Foreground="White" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0">
                            <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0" IsTabStop="False">
                                <materialDesign:PackIcon Kind="WindowMinimize" Width="18" Height="18" Foreground="White"/>
                            </Button>
                            <Button x:Name="Btn_Max" Click="Btn_Max_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0" Margin="4,0,0,0" IsTabStop="False">
                                <materialDesign:PackIcon Kind="WindowMaximize" Width="17" Height="17" Foreground="White"/>
                            </Button>
                            <Button x:Name="Btn_Close" Click="Btn_Close_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0" Margin="4,0,0,0" IsTabStop="False">
                                <materialDesign:PackIcon Kind="WindowClose" Width="19" Height="19" Foreground="White"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Margin="4,7,4,2" BorderBrush="{Binding ElementName=GENERAL_RANG, Path=Background}"
                        BorderThickness="1" CornerRadius="6" Padding="6" Background="#04FFFFFF">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="350"/>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="275"/>
                        </Grid.ColumnDefinitions>
                        <Label Content="قرارداد:" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CMB_CONTRACT" Grid.Column="1" Margin="5" Height="30"
                                  Style="{StaticResource FuzzyOutComboBox}" DisplayMemberPath="DisplayName"
                                  SelectedValuePath="ContractID" IsTextSearchEnabled="True"/>
                        <Label Grid.Column="2" Content="از تاریخ:" VerticalAlignment="Center"/>
                        <CNC:DateNavigator x:Name="TXT_FROM_DATE" Grid.Column="3" Margin="2"
                                           VerticalAlignment="Center" ToolTip="خالی یعنی بدون محدودیت"/>
                        <CheckBox x:Name="CHK_OPEN_ONLY" Grid.Column="4" Content="فقط قراردادهای باز"
                                  Margin="12,5" VerticalAlignment="Center" IsChecked="True"/>
                        <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                            <Button Content="به‌روزرسانی گزارش" Click="BTN_REFRESH_Click"
                                    Style="{StaticResource GerdC}" Width="125" Height="34" FontSize="10" Margin="4"
                                    Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    BorderBrush="{x:Null}" Foreground="#DDFFFFFF"/>
                            <Button Content="چاپ گزارش کامل" Click="BTN_PRINT_Click"
                                    Style="{StaticResource GerdC}" Width="125" Height="34" FontSize="10" Margin="4"
                                    Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    BorderBrush="{x:Null}" Foreground="#DDFFFFFF"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Margin="4,3,4,2" Padding="12,3" CornerRadius="6"
                        BorderBrush="#18000000" BorderThickness="1" Background="#FFFFFFFF">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TXT_SELECTED_TITLE" Text="نمایش تجمیعی قراردادها"
                                       FontSize="14" FontWeight="Bold" Foreground="#FF165A72"/>
                            <TextBlock x:Name="TXT_SELECTED_META" Margin="0,2,0,0" Foreground="#FF666666"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <UniformGrid Grid.Row="3" Columns="6" Margin="4,4,4,3">
                    <Border Margin="3" Padding="5" CornerRadius="8" Background="#FFEAF2FF" BorderBrush="#FFB8D3FF" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="FileDocument" Width="22" Height="22" Foreground="#FF2864DC" HorizontalAlignment="Center"/>
                            <TextBlock Text="متراژ قرارداد" Style="{StaticResource KpiTitleStyle}" Foreground="#FF2255B8"/>
                            <TextBlock x:Name="TXT_CONTRACTED" Style="{StaticResource KpiValueStyle}" Foreground="#FF163F91"/>
                        </StackPanel>
                    </Border>
                    <Border Margin="3" Padding="5" CornerRadius="8" Background="#FFE9FBF4" BorderBrush="#FFAAE8CF" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Factory" Width="22" Height="22" Foreground="#FF00A878" HorizontalAlignment="Center"/>
                            <TextBlock Text="مقدار تولید شده" Style="{StaticResource KpiTitleStyle}" Foreground="#FF087A5B"/>
                            <TextBlock x:Name="TXT_PRODUCED" Style="{StaticResource KpiValueStyle}" Foreground="#FF006B50"/>
                        </StackPanel>
                    </Border>
                    <Border Margin="3" Padding="5" CornerRadius="8" Background="#FFFFF7E2" BorderBrush="#FFF1D891" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="ClockOutline" Width="22" Height="22" Foreground="#FFF39A00" HorizontalAlignment="Center"/>
                            <TextBlock Text="مانده تولید / پیشرفت" Style="{StaticResource KpiTitleStyle}" Foreground="#FF8B6500"/>
                            <TextBlock x:Name="TXT_REMAIN" Style="{StaticResource KpiValueStyle}" Foreground="#FF765500"/>
                            <TextBlock x:Name="TXT_PROGRESS" FontSize="9" HorizontalAlignment="Center"
                                       TextAlignment="Center" Foreground="#FF9B7000"/>
                        </StackPanel>
                    </Border>
                    <Border Margin="3" Padding="5" CornerRadius="8" Background="#FFFFEDF5" BorderBrush="#FFF5BDD7" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Cart" Width="22" Height="22" Foreground="#FFEB3E8A" HorizontalAlignment="Center"/>
                            <TextBlock Text="فروش خالص" Style="{StaticResource KpiTitleStyle}" Foreground="#FF9B285C"/>
                            <TextBlock x:Name="TXT_SOLD" Style="{StaticResource KpiValueStyle}" Foreground="#FF7B1948"/>
                        </StackPanel>
                    </Border>
                    <Border Margin="3" Padding="5" CornerRadius="8" Background="#FFF0ECFF" BorderBrush="#FFD3C7FF" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="PackageVariantClosed" Width="22" Height="22" Foreground="#FF7454D6" HorizontalAlignment="Center"/>
                            <TextBlock Text="مانده قراردادی" Style="{StaticResource KpiTitleStyle}" Foreground="#FF6043B2"/>
                            <TextBlock x:Name="TXT_CONTRACT_BALANCE" Style="{StaticResource KpiValueStyle}" Foreground="#FF4C3298"/>
                        </StackPanel>
                    </Border>
                    <Border Margin="3" Padding="5" CornerRadius="8" Background="#FFEFF9FF" BorderBrush="#FFB9DEEF" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <materialDesign:PackIcon Kind="Warehouse" Width="22" Height="22" Foreground="#FF1787B3" HorizontalAlignment="Center"/>
                            <TextBlock Text="موجودی واقعی انبار" Style="{StaticResource KpiTitleStyle}" Foreground="#FF146D8E"/>
                            <TextBlock x:Name="TXT_ACTUAL_INVENTORY" Style="{StaticResource KpiValueStyle}" Foreground="#FF0F5875"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="4" Margin="4" Padding="4" CornerRadius="6" Background="#07000000">
                    <DataGrid x:Name="DG_REPORT" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              CanUserResizeRows="False" HeadersVisibility="Column" RowHeaderWidth="0"
                              AlternatingRowBackground="#06000000"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True" FrozenColumnCount="3"
                              ColumnHeaderStyle="{StaticResource CenteryHeaderstyle}" CellStyle="{StaticResource CellFocusyBorder}"
                              HorizontalGridLinesBrush="{StaticResource GENERAL_Grlicom}" VerticalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                              GridLinesVisibility="All" Style="{StaticResource MaterialDesignDataGrid}"
                              materialDesign:DataGridAssist.EnableEditBoxAssist="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="شماره قرارداد" Binding="{Binding ContractNo}" Width="100" MinWidth="110"/>
                            <DataGridTextColumn Header="مشتری" Binding="{Binding CustName}" Width="180" MinWidth="150"/>
                            <DataGridTextColumn Header="برند" Binding="{Binding BrandName}" Width="110" MinWidth="90"/>
                            <DataGridTextColumn Header="کد طرح" Binding="{Binding CODE}" Width="80" MinWidth="70"/>
                            <DataGridTextColumn Header="نام طرح / کالا" Binding="{Binding ProductName}" Width="350" MinWidth="180"/>
                            <DataGridTextColumn Header="متراژ تعهد" Binding="{Binding ContractedQty, StringFormat=N4}" Width="105" MinWidth="95"/>
                            <DataGridTextColumn Header="تولید شده" Binding="{Binding ProducedQty, StringFormat=N4}" Width="100" MinWidth="90"/>
                            <DataGridTextColumn Header="مانده تولید" Binding="{Binding RemainToProduce, StringFormat=N4}" Width="105" MinWidth="95"/>
                            <DataGridTextColumn Header="مازاد تولید" Binding="{Binding OverProducedQty, StringFormat=N4}" Width="100" MinWidth="90"/>
                            <DataGridTextColumn Header="فروش خالص" Binding="{Binding SoldQty, StringFormat=N4}" Width="110" MinWidth="110"/>
                            <DataGridTextColumn Header="مانده قراردادی" Binding="{Binding RemainInWarehouse, StringFormat=N4}" Width="115" MinWidth="100"/>
                            <DataGridTextColumn Header="موجودی واقعی" Binding="{Binding ActualInventoryQty, StringFormat=N4}" Width="115" MinWidth="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Row="5" Margin="4,3,4,0" Padding="9,4" CornerRadius="5"
                        Background="#0B000000" BorderBrush="#14000000" BorderThickness="1">
                    <TextBlock x:Name="TXT_INVENTORY_NOTE" VerticalAlignment="Center" Foreground="#FF666666"
                               TextWrapping="Wrap" FontSize="10"/>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
