<Window x:Class="Prg_UI.Wins.WinMenus.KHARID_FORUSH.HINVOLST"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.KHARID_FORUSH"
        mc:Ignorable="d"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit" 
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        FontFamily="{StaticResource IRANYEKAN}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        Title="پیش فاکتور ها" Height="450" Width="800" Closed="Window_Closed" WindowState="Maximized" Loaded="Window_Loaded" WindowStartupLocation="CenterScreen"  PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>
    </Window.Resources>
    <Grid  x:Name="mygrid">
        <Border CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" 	  Background="{DynamicResource MaterialDesign.Brush.Background}" BorderBrush="{Binding ElementName=GENERAL_RANG,Path=Background}"  Grid.ColumnSpan="5">
            <Border x:Name="TitleDrawBar" Style="{DynamicResource BordG}" Background="{Binding ElementName=GENERAL_RANG,Path=Background}" Margin="-7.999,-7.928,-8,0" VerticalAlignment="Top" MinHeight="50" UseLayoutRounding="False" Height="16.667" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Label Content="لیست پیش فاکتور ها" Padding="25,15,15,15" Foreground="White"/>
            </Border>
        </Border>


        <DataGrid  x:Name="DGR_HEAD_LSTPISHFACTOR2" 
                  Margin="10,129,8,10" AutoGenerateColumns="False"
                    Style="{StaticResource DATAGRIDSTYLISH}"
                    ColumnHeaderStyle="{StaticResource CenteryHeaderstyle}"           
                    HorizontalGridLinesBrush="{StaticResource GENERAL_Grlicom}" VerticalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                   
                  FlowDirection="RightToLeft"
                  SelectionChanged="DGR_HEAD_LSTPISHFACTOR2_SelectionChanged"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  PreviewMouseLeftButtonUp="DGR_HEAD_LSTPISHFACTOR2_PreviewMouseLeftButtonUp" SelectedIndex="0" PreviewKeyDown="DGR_HEAD_LSTPISHFACTOR2_PreviewKeyDown" SelectionMode="Single" PreviewMouseDoubleClick="DGR_HEAD_LSTPISHFACTOR2_PreviewMouseDoubleClick" BorderThickness="1">

            <DataGrid.Columns >
                <DataGridTextColumn Header="شماره" Binding="{Binding NUMBER}" MinWidth="80"/>
                <DataGridTextColumn Header="نام مشتری" Binding="{Binding NAME}" MinWidth="150"/>
                <DataGridTextColumn Header="تاریخ"  Binding="{Binding DATE_N, StringFormat=####/##/##}"  MinWidth="65"/>

                <!--<DataGridCheckBoxColumn Header="وضعیت" x:Name="Vaziyat_Col" Binding="{Binding OKF}" MinWidth="35" FrameworkElement.FlowDirection="LeftToRight">
                </DataGridCheckBoxColumn>-->

                <!--وضعیت-->
                <DataGridCheckBoxColumn x:Name="Vaziyat_Col" Header="وضعیت" Binding="{Binding OKF}" MinWidth="35">
                    <DataGridCheckBoxColumn.ElementStyle>
                        <Style TargetType="{x:Type CheckBox}">
                            <Setter Property="FrameworkElement.FlowDirection" Value="LeftToRight"/>
                        </Style>
                    </DataGridCheckBoxColumn.ElementStyle>
                </DataGridCheckBoxColumn>

                <DataGridTextColumn Header="حالت" Binding="{Binding TAMIR}" MinWidth="120" Visibility="Hidden" />
                <DataGridTemplateColumn Header="حالت">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TAMIR}" Value="0">
                                                <Setter Property="Text" Value="عادی" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TAMIR}" Value="1">
                                                <Setter Property="Text" Value="رزرو شده" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TAMIR}" Value="2">
                                                <Setter Property="Text" Value="تبدیل به حواله" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TAMIR}" Value="3">
                                                <Setter Property="Text" Value="لغو" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TAMIR}" Value="4">
                                                <Setter Property="Text" Value="رزرو قطعی" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn Header="نوع مشتری" Binding="{Binding CUSTKNAME}" MinWidth="90"/>
                <DataGridTextColumn Header="مدت" Binding="{Binding MAS}" MinWidth="30"/>
                <DataGridTextColumn Header="ملاحظات" Binding="{Binding MOLAH}" Width="*"/>
            </DataGrid.Columns>

        </DataGrid>
        <TextBox x:Name="Number_Search" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="3" HorizontalAlignment="Right" Height="26" Margin="0,84,52,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="68" FlowDirection="RightToLeft"  PreviewLostKeyboardFocus="Number_Search_PreviewLostKeyboardFocus" />
        <Label Content="نام مشتری :" HorizontalAlignment="Right" Height="30" Margin="0,80,123,0" VerticalAlignment="Top" Width="69" FlowDirection="RightToLeft" />
        <TextBox x:Name="Custno_Search"  Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="3"  Height="26" Margin="444,84,194,0" TextWrapping="Wrap" VerticalAlignment="Top" FlowDirection="RightToLeft"  PreviewLostKeyboardFocus="Custno_Search_PreviewLostKeyboardFocus"/>
        <Label Content="تاریخ :" Height="30" Margin="397,80,0,0" VerticalAlignment="Top" FlowDirection="RightToLeft"  HorizontalAlignment="Left" Width="42"/>

        <xctk:MaskedTextBox x:Name="DATE_N_Search" Mask="0000/00/00"  Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="3"  Height="26" Margin="317,84,0,0" TextWrapping="Wrap" VerticalAlignment="Top"  BorderThickness="1" TabIndex="0" FontSize="12" PreviewLostKeyboardFocus="DATE_N_Search_PreviewLostKeyboardFocus" HorizontalAlignment="Left" Width="80" />
        <Label Content="ملاحظات :" Height="30" Margin="258,80,0,0" VerticalAlignment="Top" FlowDirection="RightToLeft"  HorizontalAlignment="Left" Width="60"/>
        <TextBox x:Name="Molah_Search"  Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="3"  Height="26" Margin="124,84,0,0" TextWrapping="Wrap" VerticalAlignment="Top" FlowDirection="RightToLeft"  PreviewLostKeyboardFocus="Molah_Search_PreviewLostKeyboardFocus" HorizontalAlignment="Left" Width="133"/>
        <TextBox x:Name="Mas_Search"  Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="3"   HorizontalAlignment="Left" Height="26" Margin="10,84,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="66" FlowDirection="RightToLeft"  PreviewLostKeyboardFocus="Mas_Search_PreviewLostKeyboardFocus"/>
        <CheckBox x:Name="SmartCheckBox" Visibility="Collapsed" Content="جستجوی هوشمند" HorizontalAlignment="Left" Margin="13,106,0,0" VerticalAlignment="Top" Width="115" Height="18"  Checked="SmartCheckBox_Checked"/>
        <Label Content="شماره:" HorizontalAlignment="Right" Height="30" Margin="0,80,5,0" VerticalAlignment="Top" Width="42" FlowDirection="RightToLeft" />

        <Button x:Name="Btn_Close" Margin="0,13,12,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="20" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
            <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
        </Button>
        <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,13,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="20" VerticalAlignment="Top" HorizontalAlignment="Right" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
            <materialDesign:PackIcon Kind="WindowRestore" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
        </Button>
        <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,13,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="20" VerticalAlignment="Top" HorizontalAlignment="Right" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
            <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
        </Button>
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="95,56,0,0"  Width="1"/>
        <Label Content="مدت :" HorizontalAlignment="Left" Height="30" Margin="77,80,0,0" VerticalAlignment="Top" Width="40" FlowDirection="RightToLeft" PreviewMouseDown="Label_PreviewMouseDown" />

    </Grid>
</Window>
