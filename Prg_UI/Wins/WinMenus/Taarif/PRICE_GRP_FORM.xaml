<Window x:Class="Prg_UI.Wins.WinMenus.Taarif.PRICE_GRP_FORM"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.Taarif"
        mc:Ignorable="d"
        Title=""
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:sfusion="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Height="600" Width="800"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MinHeight="400"
        FontFamily="{StaticResource IRANYEKAN}"
        Background="{x:Null}"
        AllowsTransparency="True" AllowDrop="True"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="15"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Color="{Binding ElementName=GENERAL_RANG, Path=Background.Color}" Opacity="0.3"/>
        <!-- Style for SfDataGrid -->
        <Style x:Key="KDG"  TargetType="syncfusion:SfDataGrid" BasedOn="{StaticResource SfDataGridStyle}">
            <Setter Property="CurrentCellBorderBrush" Value="{StaticResource GENERAL_Grlicom}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="BorderBrush" Value="{StaticResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="HeaderRowHeight" Value="40" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="GridLinesVisibility" Value="Both" />
        </Style>
        <!-- Modified Column Header Style -->
        <Style x:Key="KDGHeader" TargetType="syncfusion:GridHeaderCellControl" BasedOn="{StaticResource GridHeaderCellControlStyle}">
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="BorderBrush" Value="{Binding Background, ElementName=GENERAL_RANG}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="Auto"/>
        </Style>

        <Style TargetType="sfusion:GridCell" BasedOn="{StaticResource GridCellStyle}">
            <Setter Property="BorderBrush" Value="{Binding BorderBrush, ElementName=GENERAL_RANG}" />
        </Style>

        <!--FilterPopupCustomized{-->
        <Style TargetType="{x:Type sfusion:CheckboxFilterControl}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type sfusion:CheckboxFilterControl}">
                        <Grid Height="{TemplateBinding Height}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Filtered Indicator -->
                            <Border Grid.Column="0"
                                    Width="19"
                                    Height="19"
                                    Margin="4,39,4,4"
                                    VerticalAlignment="Top"
                                    BorderBrush="#FFB2B2B2"
                                    BorderThickness="1"
                                    Visibility="{Binding FilteredFrom, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type syncfusion:GridFilterControl}}, Converter={StaticResource filteredFromCheckVisibilityConverter}}">
                                <Path x:Name="PART_FilteredFromCheck1"
                                      Width="15"
                                      Height="15"
                                      Data="M 12.4227,0.00012207C 12.4867,0.126587 12.5333,0.274536 12.6787,0.321411C 9.49199,3.24792 6.704,6.57336 4.69865,10.6827C 4.04399,11.08 3.47066,11.5573 2.83199,11.9706C 2.09467,10.2198 1.692,8.13196 3.8147e-006,7.33606C 0.500004,6.79871 1.31733,6.05994 1.93067,6.2428C 2.85999,6.51868 3.14,7.9054 3.60399,8.81604C 5.80133,5.5387 8.53734,2.19202 12.4227,0.00012207 Z "
                                      Fill="#FF0078D7"
                                      Stretch="Uniform">
                                    <Path.RenderTransform>
                                        <TransformGroup>
                                            <RotateTransform Angle="0" />
                                            <ScaleTransform ScaleX="1" ScaleY="1" />
                                        </TransformGroup>
                                    </Path.RenderTransform>
                                </Path>
                            </Border>

                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- ============================================ -->
                                <!-- SEARCH BOX - COMPLETE FIX -->
                                <!-- ============================================ -->
                                <Grid Grid.Row="0"
                                      Margin="0,10,6,8" 
                                      Background="{TemplateBinding Background}" 
                                      Visibility="{TemplateBinding SearchOptionVisibility}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Border اصلی -->
                                    <Border Grid.Column="0"
                                            BorderBrush="#FF999999"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Background="White">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <!-- فضای آیکون‌ها در سمت چپ -->
                                                <ColumnDefinition Width="Auto"/>
                                                <!-- فضای اصلی TextBox -->
                                                <ColumnDefinition Width="*"/>
                                                <!-- فضای خالی در سمت راست -->
                                                <ColumnDefinition Width="15"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- آیکون‌ها در سمت چپ -->
                                            <StackPanel Grid.Column="0"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Margin="8,0,5,0">

                                                <!-- Delete Button - فقط وقتی متن وجود دارد -->
                                                <Button x:Name="PART_DeleteButton"
                                                        Width="26"
                                                        Height="26"
                                                        Margin="0"
                                                        Padding="0"
                                                        Style="{StaticResource deleteBtnStyle}"
                                                        ToolTip="پاک کردن جستجو"
                                                        Cursor="Hand"
                                                        Visibility="{Binding Text, ElementName=PART_SearchTextBox, ConverterParameter=deletebtn, Converter={StaticResource textBlockVisibilityConverter}}" />
                                                <!-- Search Icon - فقط وقتی متن خالی است -->
                                                <Border Width="22"
                                                        Height="22"
                                                        Margin="2,0"
                                                        Visibility="{Binding Text, ElementName=PART_SearchTextBox, ConverterParameter=searchIcon, Converter={StaticResource textBlockVisibilityConverter}}">
                                                    <Path Data="F1M-185.925,-2026.96L-203.062,-2048.74C-197.485,-2056.51 -197.433,-2067.31 -203.64,-2075.2 -211.167,-2084.76 -225.019,-2086.42 -234.588,-2078.89 -244.154,-2071.36 -245.808,-2057.51 -238.282,-2047.94 -231.986,-2039.95 -221.274,-2037.5 -212.337,-2041.31L-195.262,-2019.61 -185.925,-2026.96z M-231.201,-2053.51C-235.653,-2059.17 -234.674,-2067.36 -229.02,-2071.81 -223.36,-2076.26 -215.169,-2075.29 -210.721,-2069.63 -206.269,-2063.97 -207.245,-2055.78 -212.902,-2051.33 -218.559,-2046.88 -226.752,-2047.86 -231.201,-2053.51z"
                                                          Fill="#FF888888"
                                                          RenderTransformOrigin="0.5,0.5"
                                                          Stretch="Uniform"
                                                          Opacity="0.6">
                                                        <Path.RenderTransform>
                                                            <TransformGroup>
                                                                <RotateTransform Angle="0" />
                                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                                            </TransformGroup>
                                                        </Path.RenderTransform>
                                                    </Path>
                                                </Border>
                                            </StackPanel>

                                            <!-- TextBox اصلی در وسط -->
                                            <TextBox x:Name="PART_SearchTextBox"
                                                     Grid.Column="1"
                                                     MinHeight="38"
                                                     MaxHeight="50"
                                                     HorizontalAlignment="Stretch"
                                                     VerticalAlignment="Center"
                                                     VerticalContentAlignment="Center"
                                                     FontFamily="{StaticResource IRANYEKAN}"
                                                     FontSize="13"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     Padding="10,8,10,8"
                                                     TextWrapping="NoWrap"
                                                     AcceptsReturn="False"
                                                     MaxLines="1"
                                                     CaretBrush="#FF0078D7"
                                                     TextAlignment="Left" />
                                            <!-- Placeholder Text - فقط وقتی متن خالی است -->
                                            <TextBlock Grid.Column="1"
                                                       Margin="10,0"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center"
                                                       Foreground="#FFAAAAAA"
                                                       FontFamily="{StaticResource IRANYEKAN}"
                                                       FontSize="12"
                                                       IsHitTestVisible="False"
                                                       Opacity="0.7"
                                                       TextAlignment="Left"
                                                       Text="جستجو در موارد فیلتر...">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <!-- نمایش فقط وقتی TextBox خالی است -->
                                                            <DataTrigger Binding="{Binding Text, ElementName=PART_SearchTextBox}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Text, ElementName=PART_SearchTextBox}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Items List -->
                                <Border Grid.Row="1"
                                        Margin="0,0,6,6"
                                        BorderBrush="#FFC0C0C0"
                                        BorderThickness="1"
                                        CornerRadius="3">
                                    <Grid>
                                        <!-- No Items Message -->
                                        <TextBlock Margin="0,25,0,0"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Top"
                                                   FontFamily="{StaticResource IRANYEKAN}"
                                                   FontSize="13"
                                                   Text="موردی یافت نشد"
                                                   Foreground="#FF888888"
                                                   Visibility="{Binding HasItemsSource, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource reverseVisibilityConverter}}" />

                                        <Grid Visibility="{Binding HasItemsSource, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource boolToVisiblityConverter}}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <!-- Loading Animation -->
                                            <Grid Grid.Row="1">
                                                <Grid.Resources>
                                                    <Storyboard x:Key="LoadingAnimation" RepeatBehavior="Forever">
                                                        <DoubleAnimationUsingKeyFrames Storyboard.TargetName="Path" 
                                                                              Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(RotateTransform.Angle)">
                                                            <EasingDoubleKeyFrame KeyTime="0" Value="0" />
                                                            <EasingDoubleKeyFrame KeyTime="0:0:2" Value="360" />
                                                        </DoubleAnimationUsingKeyFrames>
                                                    </Storyboard>
                                                </Grid.Resources>

                                                <Path x:Name="Path"
                                                      Width="28"
                                                      Height="28"
                                                      Data="M33.091251,58.314999C35.398258,58.314999 37.268002,60.186188 37.268002,62.490997 37.268002,64.797111 35.398258,66.667 33.091251,66.667 30.786645,66.667 28.917001,64.797111 28.917001,62.490997 28.917001,60.186188 30.786645,58.314999 33.091251,58.314999z M47.2943,55.271999C49.601437,55.271999 51.471003,57.141811 51.471003,59.447948 51.471003,61.752788 49.601437,63.624 47.2943,63.624 44.989765,63.624 43.119999,61.752788 43.119999,59.447948 43.119999,57.141811 44.989765,55.271999 47.2943,55.271999z M18.6666,54.257999C21.252921,54.257999 23.352,56.354423 23.352,58.94035 23.352,61.526379 21.252921,63.624 18.6666,63.624 16.08058,63.624 13.984001,61.526379 13.984001,58.94035 13.984001,56.354423 16.08058,54.257999 18.6666,54.257999z M57.4405,45.199001C59.3416,45.199001 60.891001,46.743435 60.891001,48.651199 60.891001,50.557564 59.3416,52.102001 57.4405,52.102001 55.534201,52.102001 53.99,50.557564 53.99,48.651199 53.99,46.743435 55.534201,45.199001 57.4405,45.199001z M8.3045502,43.967003C10.890694,43.967003 12.987,46.064644 12.987,48.6507 12.987,51.236656 10.890694,53.333 8.3045502,53.333 5.7185383,53.333 3.6219997,51.236656 3.6219997,48.6507 3.6219997,46.064644 5.7185383,43.967003 8.3045502,43.967003z M61.643499,30.851999C63.544542,30.851999 65.093996,32.396133 65.093996,34.30365 65.093996,36.209869 63.544542,37.754002 61.643499,37.754002 59.737253,37.754002 58.193001,36.209869 58.193001,34.30365 58.193001,32.396133 59.737253,30.851999 61.643499,30.851999z M4.6824703,29.619999C7.268652,29.619999 9.3649998,31.717722 9.3649998,34.30365 9.3649998,36.88958 7.268652,38.986 4.6824703,38.986 2.0965385,38.986 0,36.88958 0,34.30365 0,31.717722 2.0965385,29.619999 4.6824703,29.619999z M57.440451,16.938999C59.101923,16.938999 60.455999,18.287865 60.455999,19.9543 60.455999,21.620834 59.101923,22.971001 57.440451,22.971001 55.773779,22.971001 54.425001,21.620834 54.425001,19.9543 54.425001,18.287865 55.773779,16.938999 57.440