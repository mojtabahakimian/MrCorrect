                                                      Fill="#FF0078D7"
                                                      RenderTransformOrigin="0.5,0.5"
                                                      Stretch="Uniform"
                                                      Visibility="{Binding IsItemSourceLoaded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}, ConverterParameter={StaticResource LoadingAnimation}, Converter={StaticResource loadingVisiblityConverter}}">
                                                    <Path.RenderTransform>
                                                        <TransformGroup>
                                                            <ScaleTransform />
                                                            <SkewTransform />
                                                            <RotateTransform />
                                                            <TranslateTransform />
                                                        </TransformGroup>
                                                    </Path.RenderTransform>
                                                </Path>

                                                <!-- Items TreeGrid -->
                                                <syncfusion:SfTreeGrid x:Name="PART_ItemsControl" 
                                                              Margin="0,35,0,0"
                                                              ColumnSizer="SizeToCells"
                                                              Height="{TemplateBinding Height}"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Stretch"
                                                              GridLinesVisibility="None"
                                                              BorderThickness="0"
                                                              IsTabStop="False"
                                                              ShowCheckBox="True"
                                                              SelectionMode="None"
                                                              AllowEditing="False"
                                                              RowHeight="30"
                                                              FontFamily="{StaticResource IRANYEKAN}"
                                                              FontSize="12"
                                                              AutoExpandMode="AllNodesExpanded"
                                                              CheckBoxMappingName="IsSelected"
                                                              HorizontalContentAlignment="Stretch"
                                                              VerticalContentAlignment="Stretch"
                                                              EnableRecursiveChecking="False"
                                                              ItemsSource="{TemplateBinding ItemsSource}"
                                                              AutoGenerateColumns="False"
                                                              HeaderRowHeight="0"
                                                              ParentPropertyName="DisplayText"
                                                              ChildPropertyName="ActualValue"
                                                              SelfRelationRootValue="Variable"
                                                              KeyboardNavigation.TabNavigation="Continue"
                                                              Visibility="{Binding IsItemSourceLoaded, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource boolToVisiblityConverter}}">
                                                    <syncfusion:SfTreeGrid.Columns>
                                                        <syncfusion:TreeGridTextColumn HeaderText="DisplayText" 
                                                                              MappingName="DisplayText" 
                                                                              ColumnSizer="Star" />
                                                    </syncfusion:SfTreeGrid.Columns>
                                                </syncfusion:SfTreeGrid>
                                            </Grid>

                                            <!-- Select All CheckBox -->
                                            <Border Grid.Row="1"
                                                    Margin="0,0,20,0"
                                                    VerticalAlignment="Top"
                                                    Background="{TemplateBinding Background}"
                                                    Visibility="{Binding ItemsSource, ElementName=PART_ItemsControl, ConverterParameter=ItemsControl, Converter={StaticResource listItemsVisiblityConverter}}">
                                                <CheckBox x:Name="PART_CheckBox"
                                                          Margin="16,5,0,0"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center"
                                                          Content="انتخاب همه"
                                                          Focusable="True"
                                                          FontFamily="{StaticResource IRANYEKAN}"
                                                          FontSize="12"
                                                          IsThreeState="True"
                                                          Visibility="{Binding Visibility, ElementName=PART_ItemsControl}" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--FilterPopupCustomized}-->

        <!--<Style TargetType="{x:Type sfusion:AdvancedFilterControl}">
            <Setter Property="CanGenerateUniqueItems" Value="True" />
            <Setter Property="FontFamily" Value="{StaticResource IRANYEKAN}" />
            <Setter Property="FontSize" Value="12" />
        </Style>-->

    </Window.Resources>

    <Grid x:Name="mygrid" Margin="8,8,8,0">
        <!-- Hidden button for color binding reference -->
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Width="1" Height="1"/>
        <!-- Main container -->
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding ElementName=GENERAL_RANG, Path=Background}" BorderThickness="1" CornerRadius="10" Padding="8">
            <!-- Title bar -->
            <Border  x:Name="TitleDrawBar" Style="{StaticResource BordG}"  Background="{Binding ElementName=GENERAL_RANG, Path=Background}"  CornerRadius="10,10,0,0" Margin="-9,-9,-9,0"  Height="38"  VerticalAlignment="Top" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <!-- Window title -->
                    <Label x:Name="LABEL_HEADER" Content="تعریف گروه بندی قیمتی" Padding="17,8,10,10" Foreground="White" Margin="0,0,110,0" VerticalAlignment="Center"/>
                    <!-- Window control buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0">
                        <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0,0,0,-1" IsTabStop="False" ToolTip="Minimize">
                            <materialDesign:PackIcon Kind="WindowMinimize" Width="18" Height="18" Foreground="White"/>
                        </Button>
                        <Button x:Name="Btn_Max" Click="Btn_Max_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" FontSize="12" Height="24" Padding="0" Margin="4,0,0,0" IsTabStop="False" ToolTip="Maximize">
                            <materialDesign:PackIcon Kind="WindowMaximize" Width="17" Height="17" Foreground="White"/>
                        </Button>
                        <Button x:Name="Btn_Close" Click="Btn_Close_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0" Margin="4,0,0,0" FontSize="12" IsTabStop="False" ToolTip="Close">
                            <materialDesign:PackIcon Kind="WindowClose" Width="19" Height="19" Foreground="White"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
        <!-- Notification popup -->
        <Popup x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative" Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Width="{Binding ElementName=mygrid, Path=ActualWidth, Mode=OneWay}" Height="84" Padding="10">
                <TextBox x:Name="Pop1Text1" IsReadOnly="True" Background="Transparent" BorderBrush="Transparent" Foreground="White" Text="محل نمایش اعلان های سیستم" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
            </Border>
        </Popup>

        <!-- Content area -->
        <Grid Margin="0,38,0,0">
            <syncfusion:SfDataGrid x:Name="SYNCFUSION_DG"
                               FlowDirection="RightToLeft"
                               d:ItemsSource="{d:SampleData ItemCount=5}"
                               Margin="10,10,10,10"
                               Style="{StaticResource KDG}"
                               HeaderStyle="{StaticResource KDGHeader}"
                               ItemsSource="{Binding SFDG_DATA}" 
                               AllowRowHoverHighlighting="True" 
                               AllowSelectionOnPointerPressed="True" 
                               ScrollMode="Async" 
                               ShowRowHeader="True" 
                               ShowGroupDropArea="True"
                               AutoGenerateColumns="False"
                               AllowEditing="True"
                               EnableDataVirtualization="True"
                               SelectionUnit="Row"
                               SelectionMode="Extended"
                               AllowDraggingColumns="True"
                               AllowResizingColumns="True"
                               AllowFiltering="True"
                               AllowDeleting="True"
                               AllowSorting="True"
                               RowHeight="35"
                               FrozenColumnCount="0"
                                   
                               KeyboardNavigation.TabNavigation="Contained"
                               KeyboardNavigation.ControlTabNavigation="Contained"
                               
                               PreviewKeyDown="SYNCFUSION_DG_PreviewKeyDown"
                               SelectionChanged="SYNCFUSION_DG_SelectionChanged"
                               PreviewMouseRightButtonDown="SYNCFUSION_DG_PreviewMouseRightButtonDown"
                               CurrentCellActivated="SYNCFUSION_DG_CurrentCellActivated"
                               
                               RowValidating="DG_SUB_RowValidating"
                               RowValidated="DG_SUB_RowValidated"
                               CurrentCellBeginEdit="DG_SUB_CurrentCellBeginEdit"
                               CurrentCellEndEdit="DG_SUB_CurrentCellEndEdit"
                               RecordDeleting="DG_SUB_RecordDeleting"
                               RecordDeleted="DG_SUB_RecordDeleted"
                               
                               NavigationMode="Cell"
                               AddNewRowPosition="Bottom"
                               GridValidationMode="InEdit" 
                               GroupDropAreaText="برای گروه‌بندی، سربرگ ستون را به اینجا بکشید"
                               GridLinesVisibility="Horizontal"
                               >
                <syncfusion:SfDataGrid.Resources>
                    <ResourceDictionary>
                        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                            <Setter Property="Height" Value="35" />
                        </Style>
                    </ResourceDictionary>
                </syncfusion:SfDataGrid.Resources>

                <syncfusion:SfDataGrid.AddNewRowText>
                    برای سطر جدید دابل کلیک کنید
                </syncfusion:SfDataGrid.AddNewRowText>

                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn HeaderText="کد" MappingName="PGID" Width="100" IsReadOnly="True" AllowFocus="False"/>
