<Window x:Class="Wins.WinMenus.Taarif.GRADE_FORMAT_WIN"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wins.WinMenus.Taarif"
        mc:Ignorable="d"
        xmlns:sf="http://schemas.syncfusion.com/wpf"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="{StaticResource IRANYEKAN}"
        WindowStartupLocation="CenterScreen"
        Title="Window3" Height="450" Width="800" Loaded="Window_Loaded">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True"  VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>

        <Style x:Key="KDG" TargetType="{x:Type sf:SfDataGrid}">
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="BorderBrush" Value="{StaticResource MaterialDesignDivider}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="HeaderRowHeight" Value="40" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="GridLinesVisibility" Value="Both" />
        </Style>

        <Style  x:Key="KDGHeader" TargetType="{x:Type sf:GridHeaderCellControl}">
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}"/>
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}"/>
        </Style>

        <Style x:Key="KDGCell" TargetType="{x:Type sf:GridCell}">
            <Setter Property="Background" Value="{StaticResource MaterialDesignCardBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}"/>
            <Setter Property="BorderBrush" Value="{StaticResource MaterialDesignDivider}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="mygrid">
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="557,410,462,353"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label Content="فرمت رده بندی مشتری" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>

                </Grid>
            </Border>
        </Border>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                             Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <!--HEADER↑-->

        <sf:SfDataGrid x:Name="GRADE_SUB" Visibility="Visible"
                 AutoGenerateColumns="False" 
                 ItemsSource="{Binding MASTER_GRADE_DATA}" Style="{StaticResource KDG}"
                 FlowDirection="RightToLeft"
                 HeaderStyle="{StaticResource KDGHeader}"
                 AutoGenerateRelations="False" Margin="10,50,10,10" PreviewMouseDoubleClick="GRADE_SUB_PreviewMouseDoubleClick">

            <sf:SfDataGrid.Columns>
                <sf:GridTextColumn MappingName="IDD" HeaderText="شماره"/>
                <sf:GridTextColumn MappingName="GFNAME" HeaderText="عنوان فرمت"/>
                <sf:GridTextColumn MappingName="TOZIH" HeaderText="توضیحات"/>
                <sf:GridTextColumn MappingName="GFDATE" HeaderText="تاریخ">
                    <sf:GridTextColumn.DisplayBinding>
                        <Binding Path="GFDATE" StringFormat="####/##/##" />
                    </sf:GridTextColumn.DisplayBinding>
                </sf:GridTextColumn>
                <sf:GridTextColumn MappingName="USERNAME" HeaderText="نام کاربر" AllowResizing="True" TextAlignment="Justify" ColumnSizer="AutoLastColumnFill"/>

            </sf:SfDataGrid.Columns>

            <sf:SfDataGrid.DetailsViewDefinition>
                <sf:GridViewDefinition RelationalColumn="GRADETABFT">
                    <sf:GridViewDefinition.DataGrid>
                        <sf:SfDataGrid AutoGenerateColumns="False" Style="{StaticResource KDG}" HeaderStyle="{StaticResource KDGHeader}">
                            <sf:SfDataGrid.Columns>
                                <sf:GridTextColumn MappingName="GFTID" HeaderText="شماره"/>
                                <sf:GridTextColumn MappingName="GFNAMEFT" HeaderText="نام گروه"/>
                                <sf:GridTextColumn MappingName="GFGZARIB" HeaderText="ضریب"/>
                                <!-- Add other columns for GRADE_TAB_FT as needed -->
                            </sf:SfDataGrid.Columns>
                            <sf:SfDataGrid.DetailsViewDefinition>
                                <sf:GridViewDefinition RelationalColumn="GRADEGRPFT">
                                    <sf:GridViewDefinition.DataGrid>
                                        
                                        <sf:SfDataGrid AutoGenerateColumns="False" Style="{StaticResource KDG}" HeaderStyle="{StaticResource KDGHeader}" AllowResizingColumns="True">
                                            <sf:SfDataGrid.Columns>
                                                <sf:GridTextColumn MappingName="GFGRPNAMEFT" HeaderText="عنوان سنجش"/>
                                                <sf:GridComboBoxColumn x:Name="ArezeshComboColumn" DisplayMemberPath="GSCANAME" MinimumWidth="50" SelectedValuePath="GSCACOD" MappingName="GVALUESCALE" HeaderText="ارزش">
                                                    <sf:GridComboBoxColumn.DisplayBinding>
                                                        <Binding Path="GVALUESCALE" />
                                                    </sf:GridComboBoxColumn.DisplayBinding>
                                                </sf:GridComboBoxColumn>
                                                
                                                <sf:GridTextColumn MappingName="GFGRPGRADE" HeaderText="امتیاز"/>
                                                <sf:GridTextColumn MappingName="GFGRPZARIB" HeaderText="ضریب"/>
                                            </sf:SfDataGrid.Columns>
                                        </sf:SfDataGrid>
                                    </sf:GridViewDefinition.DataGrid>
                                </sf:GridViewDefinition>
                            </sf:SfDataGrid.DetailsViewDefinition>
                        </sf:SfDataGrid>
                    </sf:GridViewDefinition.DataGrid>
                </sf:GridViewDefinition>
            </sf:SfDataGrid.DetailsViewDefinition>
        </sf:SfDataGrid>

    </Grid>
</Window>
