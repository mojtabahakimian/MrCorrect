<Window x:Class="Wins.WinMenus.Taarif.KHAD_DEF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wins.WinMenus.Taarif"
        mc:Ignorable="d"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="IRANYekanFN"
        WindowStartupLocation="CenterScreen"
        Title="Window3" Height="450" Width="800" PreviewKeyDown="Window_PreviewKeyDown" Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True"  VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="mygrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="5*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="37*"/>
            <ColumnDefinition Width="43*"/>
        </Grid.ColumnDefinitions>
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="187,58,242,-15" Grid.Row="1" Grid.Column="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1" Grid.RowSpan="2" Grid.ColumnSpan="2">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label Content="تعریف خدمات" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>

                </Grid>
            </Border>
        </Border>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True" Grid.RowSpan="2" Grid.ColumnSpan="2">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                             Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <!--HEADER↑-->

        <Grid Margin="0,45,10,0" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="11*"/>
                <RowDefinition Height="56*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36*"/>
                <ColumnDefinition Width="43*"/>
            </Grid.ColumnDefinitions>
            <Label Content="تخفیفات مصوب" Margin="10,10,18,0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Top" FontSize="14"/>
            <DataGrid x:Name="TAKHPERS_SUB"  
                      EnableColumnVirtualization="True"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="False"
                      SelectedIndex="0"
                      ColumnHeaderStyle="{StaticResource CenteryHeaderstyle}"
                      CellStyle="{StaticResource CellFocusyBorder}"
                      HorizontalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                      VerticalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                      ItemsSource="{Binding TAKHPERS_DATA}"
                      KeyboardNavigation.TabNavigation="Contained"
                      IsKeyboardFocusWithinChanged="TAKHPERS_SUB_IsKeyboardFocusWithinChanged"
                      Margin="10,10,8,10" AutoGenerateColumns="False" FlowDirection="RightToLeft" SelectionUnit="FullRow" BorderThickness="1" Grid.Row="1" BeginningEdit="TAKHPERS_SUB_BeginningEdit" CellEditEnding="TAKHPERS_SUB_CellEditEnding" RowEditEnding="TAKHPERS_SUB_RowEditEnding" PreviewMouseLeftButtonDown="TAKHPERS_SUB_PreviewMouseLeftButtonDown" PreviewKeyDown="TAKHPERS_SUB_PreviewKeyDown" SelectionChanged="TAKHPERS_SUB_SelectionChanged">

                <DataGrid.Style>
                    <!--خط بندی سطر های دیتاگرید-->
                    <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource MaterialDesignDataGrid}"> <Setter Property="materialDesign:DataGridAssist.EnableEditBoxAssist" Value="False"/>
                        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                    </Style>
                </DataGrid.Style>

                <DataGrid.Columns>
                    <DataGridTextColumn  Binding="{Binding TAKH_COD,UpdateSourceTrigger=LostFocus}" Header="کد کالا و خدمات" Visibility="Hidden" Width="auto" MinWidth="100" />

                    <DataGridComboBoxColumn x:Name="COLUMN_CUST_CO" MinWidth="80"  Width="auto" Header="کد نوع متشری" SelectedValueBinding="{Binding CUST_CO,UpdateSourceTrigger=LostFocus}" DisplayMemberPath="CUSTKNAME" SelectedValuePath="CUST_COD">
                        <DataGridComboBoxColumn.EditingElementStyle>
                            <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource MaterialDesignComboBox}">
                                <Setter Property="IsEditable" Value="True"/>
                                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                            </Style>
                        </DataGridComboBoxColumn.EditingElementStyle>
                        <DataGridComboBoxColumn.ElementStyle>
                            <Style TargetType="{x:Type ComboBox}">
                            </Style>
                        </DataGridComboBoxColumn.ElementStyle>
                    </DataGridComboBoxColumn>
                    <DataGridTextColumn  Binding="{Binding TAFPER,UpdateSourceTrigger=LostFocus}" Header="درصد تخفیف"  Width="auto" MinWidth="100" >
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource MaterialDesignTextBox}">
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn  Binding="{Binding PRICE_M,UpdateSourceTrigger=LostFocus}" Header="مبلغ" Width="auto" MinWidth="100" >
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource MaterialDesignTextBox}">
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                    </DataGridTextColumn>

                </DataGrid.Columns>
            </DataGrid>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="9,3,14,10" FlowDirection="RightToLeft" Grid.Column="1" Grid.Row="1">
                <StackPanel x:Name="SP_PANEL" Height="auto">
                    <Label Content="کد"/>
                    <CNC:NumericTextBox x:Name="CODE" RestoreLastValidValue="False"  DoesAcceptDouble="False"  FlowDirection="LeftToRight"  Text="" Height="29" LastValueShouldZero="False" MaxLength="15" />
                    <Label Content="نام"/>
                    <TextBox x:Name="NAM"  Style="{StaticResource FuzzyOut}" Padding="3" Text="" Height="29" MaxLength="79" />
                    <Label Content="شماره فنی"/>
                    <TextBox x:Name="N_FANI"  Style="{StaticResource FuzzyOut}" Padding="3" Text="" Height="29" MaxLength="29" />
                    <Label Content="توضیح"/>
                    <TextBox x:Name="TOZIH"  Style="{StaticResource FuzzyOut}" Padding="3" Text="" Height="29" MaxLength="39"/>
                    <Label Content="واحد"/>
                    <ComboBox Padding="7,0,10,0" x:Name="VAHED" DisplayMemberPath="NAMES" SelectedValuePath="CODE"  IsTextSearchEnabled="True" IsEditable="True" Height="29">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource FuzzyOutComboBox}">
                                <Style.Triggers>
                                    <!--<DataTrigger Binding="{Binding ElementName=OSTANID, Path=SelectedIndex}" Value="-1">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>-->
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>
                    <Label Content="گروه"/>
                    <ComboBox Padding="7,0,10,0" x:Name="RADAH" DisplayMemberPath="NAMES" SelectedValuePath="CODE" SelectedIndex="0" IsTextSearchEnabled="True" IsEditable="True" Height="29">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource FuzzyOutComboBox}">
                                <Style.Triggers>
                                    <!--<DataTrigger Binding="{Binding ElementName=OSTANID, Path=SelectedIndex}" Value="-1">
                      <Setter Property="IsEnabled" Value="False"/>
                  </DataTrigger>-->
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>
                    <Label Content="قیمت واحد"/>
                    <CNC:NumericTextBox x:Name="MABL_F" DoesAcceptDouble="False"  FlowDirection="LeftToRight"  Text="0" Height="29"  LastValueShouldZero="True" MaxLength="30"/>
                    <Label Content="واحد ارائه کننده خدمات"/>
                    <ComboBox Padding="7,0,10,0" x:Name="DEPART" DisplayMemberPath="DEPNAME" SelectedValuePath="DEPATMAN" IsTextSearchEnabled="True" IsEditable="True" Height="29">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource FuzzyOutComboBox}">
                                <Style.Triggers>
                                    <!--<DataTrigger Binding="{Binding ElementName=OSTANID, Path=SelectedIndex}" Value="-1">
                      <Setter Property="IsEnabled" Value="False"/>
                  </DataTrigger>-->
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>

                    <CheckBox x:Name="CMBAA" Content="مشمول مالیات ب.ا.ا" Height="23" Cursor="Hand"/>

                </StackPanel>
            </ScrollViewer>
            <Button x:Name="Command39" Content="مرتب بر اساس کد" Style="{StaticResource MaterialDesignFlatButton}" Margin="27,0,32,0" VerticalAlignment="Center" Grid.Column="1" Click="Command39_Click" Cursor="Hand" Visibility="Collapsed" />
        </Grid>
        <Button x:Name="SAVE_KHAD" Click="SAVE_KHAD_Click" Content="ذخیره" Margin="141,16,14,0" VerticalAlignment="Top" Height="36" Foreground="#DDFFFFFF" Grid.Row="1" Grid.Column="1" Padding="16,2,16,4" Cursor="Hand"/>
        <Button x:Name="End" Tag ="RD" Click="End_Click" Style="{StaticResource GerdB}" BorderBrush="{x:Null}"
            RenderTransformOrigin="0.5,0.5"  FontSize="10" Margin="0,21,126,0" Height="25" VerticalAlignment="Top" HorizontalAlignment="Right" Width="34" Grid.Row="1">
            <materialDesign:PackIcon  Kind="SkipNext"  HorizontalAlignment="Center" VerticalAlignment="Center" Height="20" Width="21" Foreground="#CCFFFFFF" RenderTransformOrigin="0.206,0.45"  FontSize="10" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="26,-44,0,0" Margin="-19,0,-18,0">
                <materialDesign:PackIcon.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </materialDesign:PackIcon.RenderTransform>
            </materialDesign:PackIcon>
        </Button>
        <Button x:Name="First" Click="First_Click"  Tag ="RD"  Style="{StaticResource GerdB}" BorderBrush="{x:Null}"
            RenderTransformOrigin="0.5,0.5"  FontSize="10" Margin="0,21,322,0" HorizontalAlignment="Right" Width="34" Height="25" VerticalAlignment="Top" Grid.Row="1">
            <materialDesign:PackIcon Kind="SkipNext"  HorizontalAlignment="Right" VerticalAlignment="Top" Height="20" Width="23" Foreground="#CCFFFFFF" RenderTransformOrigin="0.515,0.533"  FontSize="10" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="-30,-1,-5,0">
                <materialDesign:PackIcon.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="-1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform X="4.946"/>
                    </TransformGroup>
                </materialDesign:PackIcon.RenderTransform>
            </materialDesign:PackIcon>
        </Button>
        <Button x:Name="Next" Click="Next_Click" Tag ="RD" Style="{StaticResource GerdB}" BorderBrush="{x:Null}"
            RenderTransformOrigin="0.5,0.5"  FontSize="10" Margin="0,21,168,0"  Height="25" VerticalAlignment="Top" HorizontalAlignment="Right" Width="34" Grid.Row="1">
            <materialDesign:PackIcon Kind="triangle"  HorizontalAlignment="Center" VerticalAlignment="Center" Height="15" Width="15" Foreground="#CCFFFFFF" RenderTransformOrigin="0.254,0.083"  FontSize="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0" Margin="-24,-13,-32,0">
                <materialDesign:PackIcon.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                        <SkewTransform/>
                        <RotateTransform Angle="90"/>
                        <TranslateTransform X="5" Y="10"/>
                    </TransformGroup>
                </materialDesign:PackIcon.RenderTransform>
            </materialDesign:PackIcon>
        </Button>
        <Button x:Name="Back"  Tag ="RD" Click="Back_Click" Style="{StaticResource GerdB}" BorderBrush="{x:Null}"
            RenderTransformOrigin="0.5,0.5"  FontSize="10" Margin="0,21,282,0" HorizontalAlignment="Right" Width="34"  Height="25" VerticalAlignment="Top" Grid.Row="1">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Button.RenderTransform>
            <materialDesign:PackIcon  Kind="triangle"  HorizontalAlignment="Center" VerticalAlignment="Center" Height="15" Width="15" Foreground="#CCFFFFFF" RenderTransformOrigin="0.254,0.083"  FontSize="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0" Margin="-24,-13,-32,0">
                <materialDesign:PackIcon.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                        <SkewTransform/>
                        <RotateTransform Angle="90"/>
                        <TranslateTransform X="5" Y="10"/>
                    </TransformGroup>
                </materialDesign:PackIcon.RenderTransform>
            </materialDesign:PackIcon>
        </Button>
        <Button x:Name="NEWRECORD_BTN" Click="NEWRECORD_BTN_Click"  Tag ="RD" Style="{StaticResource GerdB}" BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="10"  Margin="0,21,86,0" Height="25" VerticalAlignment="Top" HorizontalAlignment="Right" Width="34" Grid.Row="1">
            <materialDesign:PackIcon Kind="AddBold"  HorizontalAlignment="Center" VerticalAlignment="Center" Height="15" Width="15" Foreground="#CCFFFFFF" RenderTransformOrigin="0.254,0.083"  FontSize="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0" Margin="-24,-13,-32,0">
                <materialDesign:PackIcon.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                        <SkewTransform/>
                        <RotateTransform Angle="90"/>
                        <TranslateTransform X="5" Y="10"/>
                    </TransformGroup>
                </materialDesign:PackIcon.RenderTransform>
            </materialDesign:PackIcon>
        </Button>
        <TextBox x:Name="RecCount"  HorizontalContentAlignment="Center" TextAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource FuzzyOut}" IsReadOnly="True" Tag="RD" Padding="7,0,10,0" Margin="0,19,9,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Background="{x:Null}" BorderThickness="1" Height="30" HorizontalAlignment="Right" Width="72" Grid.Row="1" />
        <TextBox x:Name="Current_Rec"   HorizontalContentAlignment="Center" TextAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource FuzzyOut}" IsReadOnly="True" Tag="RD" Padding="7,0,10,0" Margin="0,19,207,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Background="{x:Null}" BorderThickness="1" Height="30" HorizontalAlignment="Right" Width="72" Grid.Row="1" />
        <Button x:Name="DELETE_KHAD" Click="DELETE_KHAD_Click" Content="حذف" Margin="11,16,0,0" VerticalAlignment="Top" Height="36" Foreground="#DDFFFFFF" Grid.Row="1" Grid.Column="1" Padding="16,2,16,4" Cursor="Hand" HorizontalAlignment="Left" Width="111"/>

    </Grid>
</Window>
