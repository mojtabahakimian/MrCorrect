<Window x:Class="Wins.WinMenus.Taarif.FCODE_CUSTOMER_MORE"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wins.WinMenus.Taarif"
        mc:Ignorable="d"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="IRANYekanFN"
        WindowStartupLocation="CenterScreen"
        Title="Window3" Height="635" Width="785"  MinHeight="595" MinWidth="785" Loaded="Window_Loaded" ContentRendered="Window_ContentRendered" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>

        <ContextMenu x:Key="ContextUtilityMenu1" FontSize="12" FlowDirection="LeftToRight" FontFamily="IRANYekanFN" ContextMenuOpening="ContextMenu_ContextMenuOpening">
            <MenuItem Header="اصلاح عکس این سطر" x:Name="EditCurrentRowIMG" Click="EditCurrentRowIMG_Click">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="ImageEdit" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="حذف عکس این سطر" x:Name="DeleteCurrentRowIMG" Click="DeleteCurrentRowIMG_Click">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="ImageRemove" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="mygrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="557,410,227,193"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>

                </Grid>
            </Border>
        </Border>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10"  x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                             Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <!--HEADER↑-->

        <Label Content="تاریخ تولد" FlowDirection="RightToLeft" HorizontalAlignment="Right" FontSize="10" Margin="0,65,25,0" VerticalAlignment="Top" Width="auto"/>
        <xctk:MaskedTextBox x:Name="TAVALOD_DATE"  Style="{StaticResource FuzzyOut}" Padding="3"  Mask="0000/00/00" Height="28" Margin="0,62,79,0" TextWrapping="Wrap" VerticalAlignment="Top"  BorderThickness="1" FontSize="12"  HorizontalAlignment="Right" Width="88" PreviewLostKeyboardFocus="TAVALOD_DATE_PreviewLostKeyboardFocus"/>
        <Label Content="تاریخ ازدواج" FlowDirection="RightToLeft" HorizontalAlignment="Right" FontSize="10" Margin="0,64,172,0" VerticalAlignment="Top" Width="auto"/>
        <xctk:MaskedTextBox x:Name="MARRID_DATE"  Style="{StaticResource FuzzyOut}" Padding="3"  Mask="0000/00/00" Height="26" Margin="0,64,233,0" TextWrapping="Wrap" VerticalAlignment="Top"  BorderThickness="1" FontSize="12"  HorizontalAlignment="Right" Width="88" PreviewLostKeyboardFocus="MARRID_DATE_PreviewLostKeyboardFocus"/>
        <Label Content="ایمیل" FlowDirection="RightToLeft"  HorizontalAlignment="Right" FontSize="10" Margin="0,130,44,0" VerticalAlignment="Top" Width="auto"/>
        <TextBox x:Name="EMAILM"  Style="{StaticResource FuzzyOut}" Padding="3" Text="" MaxHeight="100" Height="28" Margin="0,130,79,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="242" PreviewLostKeyboardFocus="EMAILM_PreviewLostKeyboardFocus" />
        <Label Content="سایت" FlowDirection="RightToLeft"  HorizontalAlignment="Right" FontSize="10" Margin="0,164,42,0" VerticalAlignment="Top" Width="auto"/>
        <TextBox x:Name="SITEM"  Style="{StaticResource FuzzyOut}" Padding="3" Text=""  MaxHeight="100"  Height="28" Margin="0,162,79,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="242" />
        <Label Content="واتساپ" FlowDirection="RightToLeft"  HorizontalAlignment="Right" FontSize="10" Margin="0,194,35,0" VerticalAlignment="Top" Width="auto"/>
        <TextBox x:Name="WATSAP"  Style="{StaticResource FuzzyOut}" Padding="3" Text=""  MaxHeight="100"  Height="28" Margin="0,194,79,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="242" />
        <Label Content="تلگرام" FlowDirection="RightToLeft"  HorizontalAlignment="Right" FontSize="10" Margin="0,226,43,0" VerticalAlignment="Top" Width="auto"/>
        <TextBox x:Name="TELEGRAM"  Style="{StaticResource FuzzyOut}" Padding="3" Text="" MaxHeight="100"  Height="28" Margin="0,226,79,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="242" />
        <Label Content="اینستاگرام" FlowDirection="RightToLeft"  HorizontalAlignment="Right" FontSize="10" Margin="0,260,24,0" VerticalAlignment="Top" Width="auto"/>
        <TextBox x:Name="INSTAM"  Style="{StaticResource FuzzyOut}" Padding="3" Text="" MaxHeight="100"  Height="28" Margin="0,258,79,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="242" />
        <Label Content="LinkedIn" FlowDirection="RightToLeft"  HorizontalAlignment="Right" FontSize="10" Margin="0,292,28,0" VerticalAlignment="Top" Width="auto"/>
        <TextBox x:Name="LINKEDINM"  Style="{StaticResource FuzzyOut}" Padding="3" Text="" MaxHeight="100"  Height="28" Margin="0,290,79,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="242" />
        <ComboBox x:Name="MOTAHEL" Padding="7,0,10,0" FlowDirection="RightToLeft" Style="{StaticResource FuzzyOutComboBox}" DisplayMemberPath="NAME" SelectedValuePath="ID" IsTextSearchEnabled="True" IsEditable="True" Height="30" Margin="0,322,79,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="242">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <Label Content="تاهل" FlowDirection="RightToLeft"  HorizontalAlignment="Right" FontSize="10" Margin="0,324,47,0" VerticalAlignment="Top" Width="auto"/>
        <materialDesign:PackIcon Kind="Email" Margin="0,130,326,0" Height="28" Width="29" Foreground="{Binding Background, ElementName=GENERAL_RANG}" HorizontalAlignment="Right" />
        <materialDesign:PackIcon Kind="Web" Margin="0,164,326,0" Height="26" Width="29" Foreground="{Binding Background, ElementName=GENERAL_RANG}" HorizontalAlignment="Right" />
        <materialDesign:PackIcon Kind="Whatsapp" Margin="0,194,326,0" Height="28" Width="29" Foreground="{Binding Background, ElementName=GENERAL_RANG}" HorizontalAlignment="Right" />
        <materialDesign:PackIcon Kind="Instagram" Margin="0,260,326,0" Height="26" Width="29" Foreground="{Binding Background, ElementName=GENERAL_RANG}" HorizontalAlignment="Right" />
        <materialDesign:PackIcon Kind="Linkedin" Margin="0,290,326,0" Height="26" Width="29" Foreground="{Binding Background, ElementName=GENERAL_RANG}" HorizontalAlignment="Right" />
        <TextBox x:Name="ADDRESSMANZEL"  Style="{StaticResource FuzzyOut}" FlowDirection="RightToLeft" Padding="3" Text="" MaxLength="249" TextWrapping="Wrap" Height="86" Margin="0,356,78,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="404" />
        <Label Content="آدرس منزل" FlowDirection="RightToLeft"  HorizontalAlignment="Right" FontSize="10" Margin="0,358,20,0" VerticalAlignment="Top" Width="auto"/>
        <Border Margin="20,60,505,0" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}" CornerRadius="5" Height="188" VerticalAlignment="Top">
            <Image x:Name="AKS" Stretch="Uniform" d:IsLocked="True" Cursor="Hand" PreviewMouseLeftButtonDown="AKS_PreviewMouseLeftButtonDown"/>
        </Border>

        <materialDesign:PackIcon Kind="ImageAdd"  x:Name="StorePicBtn"  Cursor="Hand"  FontSize="12" Margin="19,251,0,0" Height="32" PreviewMouseLeftButtonUp="StorePicBtn_PreviewMouseLeftButtonUp" Width="32" Foreground="{Binding Background, ElementName=GENERAL_RANG}" />

        <Label Content="خانواده و اقوام" FlowDirection="RightToLeft" HorizontalAlignment="Right" FontSize="10" Margin="0,450,13,0" VerticalAlignment="Top" Width="auto"/>
        <DataGrid 
            x:Name="FCODE_CUSTOMER_MORE_SUB"
            ItemsSource="{Binding MORINFO_SUB_DATA}"
            ColumnHeaderStyle="{StaticResource CenteryHeaderstyle}"
            CellStyle="{StaticResource CellFocusyBorder}"
            HorizontalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
            VerticalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
            AutoGenerateColumns="False"
            CanUserAddRows="True"
            ContextMenu="{StaticResource ContextUtilityMenu1}"
            FlowDirection="RightToLeft" Margin="17,480,15,14" CellEditEnding="FCODE_CUSTOMER_MORE_SUB_CellEditEnding" RowEditEnding="FCODE_CUSTOMER_MORE_SUB_RowEditEnding" SelectionChanged="FCODE_CUSTOMER_MORE_SUB_SelectionChanged" PreviewMouseLeftButtonDown="FCODE_CUSTOMER_MORE_SUB_PreviewMouseLeftButtonDown" PreviewKeyDown="FCODE_CUSTOMER_MORE_SUB_PreviewKeyDown">
            <DataGrid.Style>
                <!--خط بندی سطر های دیتاگرید-->
                <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource MaterialDesignDataGrid}"> <Setter Property="materialDesign:DataGridAssist.EnableEditBoxAssist" Value="False"/>
                    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                </Style>
            </DataGrid.Style>

            <DataGrid.Columns>
                <!--<DataGridTextColumn Header="کد" Binding="{Binding HES}" />-->
                <DataGridTextColumn Header="کدملی" Binding="{Binding CODEMELLI,UpdateSourceTrigger=LostFocus}" >
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                            <Setter Property="MaxLength" Value="100" />
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="نام و نام خانوادگی" Binding="{Binding NAMP,UpdateSourceTrigger=LostFocus}" >
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                            <Setter Property="MaxLength" Value="100" />
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>

                <DataGridComboBoxColumn x:Name="COLUMN_NESBAT"  Width="auto" Header=" نسبت " SelectedValueBinding="{Binding NESBAT,UpdateSourceTrigger=LostFocus}" DisplayMemberPath="NAME" SelectedValuePath="ID">
                    <DataGridComboBoxColumn.EditingElementStyle>
                        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource MaterialDesignComboBox}">
                            <Setter Property="IsEditable" Value="True"/>
                            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                        </Style>
                    </DataGridComboBoxColumn.EditingElementStyle>
                    <DataGridComboBoxColumn.ElementStyle>
                        <Style TargetType="{x:Type ComboBox}">
                        </Style>
                    </DataGridComboBoxColumn.ElementStyle>
                </DataGridComboBoxColumn>

                <DataGridTextColumn Header="تاریخ تولد" Binding="{Binding TAVALOD_DATE,UpdateSourceTrigger=LostFocus, StringFormat=####/##/##}" >
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                            <Setter Property="MaxLength" Value="12" />
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="تاریخ ازدواج" Binding="{Binding MARRID_DATE,UpdateSourceTrigger=LostFocus, StringFormat=####/##/##}" >
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                            <Setter Property="MaxLength" Value="12" />
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="ایمیل" Binding="{Binding EMAILM,UpdateSourceTrigger=LostFocus}" >
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                            <Setter Property="MaxLength" Value="100" />
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="سایت" Binding="{Binding SITEM,UpdateSourceTrigger=LostFocus}" >
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                            <Setter Property="MaxLength" Value="100" />
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="واتساپ" Binding="{Binding WATSAP,UpdateSourceTrigger=LostFocus}" >
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                            <Setter Property="MaxLength" Value="100" />
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="تلگرام" Binding="{Binding TELEGRAM,UpdateSourceTrigger=LostFocus}" >
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                            <Setter Property="MaxLength" Value="100" />
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="اینستاگرام" Binding="{Binding INSTAM,UpdateSourceTrigger=LostFocus}" >
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                            <Setter Property="MaxLength" Value="100" />
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="LINKEDINM" Binding="{Binding LINKEDINM,UpdateSourceTrigger=LostFocus}" >
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                            <Setter Property="MaxLength" Value="100" />
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>

                <DataGridComboBoxColumn x:Name="COLUMN_TAHOL"  Width="auto" Header=" تاهل " SelectedValueBinding="{Binding MOTAHEL,UpdateSourceTrigger=LostFocus}" DisplayMemberPath="NAME" SelectedValuePath="ID">
                    <DataGridComboBoxColumn.EditingElementStyle>
                        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource MaterialDesignComboBox}">
                            <Setter Property="IsEditable" Value="True"/>
                            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                        </Style>
                    </DataGridComboBoxColumn.EditingElementStyle>
                    <DataGridComboBoxColumn.ElementStyle>
                        <Style TargetType="{x:Type ComboBox}">
                        </Style>
                    </DataGridComboBoxColumn.ElementStyle>
                </DataGridComboBoxColumn>

                <DataGridTextColumn Header="آدرس منزل" Binding="{Binding ADDRESSMANZEL,UpdateSourceTrigger=LostFocus}" >
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                            <Setter Property="MaxLength" Value="249" />
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header=" عکس ">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <!--<materialDesign:PackIcon Kind="ImageEditOutline"/>-->
                            <Image Source="{Binding AKS,UpdateSourceTrigger=PropertyChanged,IsAsync=True}" Stretch="Uniform" Width="auto" Height="auto"  MaxWidth="50" MaxHeight="50"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <Button x:Name="AksSubBtn" Click="AksSubBtn_Click" Cursor="Hand" Tag="{Binding}" BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5" FontSize="10" Background="{x:Null}">
                                <Button.Content>
                                    <materialDesign:PackIcon Kind="Image"/>
                                </Button.Content>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <Button x:Name="SAVER_BTN" FontSize="12" Content="ذخیره" Margin="0,356,487,0" Cursor="Hand" Foreground="#DDFFFFFF" Padding="16,1,16,4" HorizontalAlignment="Right" Width="105" Click="SAVER_BTN_Click" Height="36" VerticalAlignment="Top"/>
        <materialDesign:PackIcon x:Name="IMGREMOVE" Kind="ImageRemove" Cursor="Hand" FontSize="12" Margin="0,251,505,0" Height="32" PreviewMouseLeftButtonUp="IMGREMOVE_PreviewMouseLeftButtonUp" Width="32" Foreground="{Binding Background, ElementName=GENERAL_RANG}" HorizontalAlignment="Right" />
        <ComboBox x:Name="TAVALOD_CITY" Padding="7,0,10,0" FlowDirection="RightToLeft" Style="{StaticResource FuzzyOutComboBox}" DisplayMemberPath="CITYNAME" SelectedValuePath="CITYNAME" IsTextSearchEnabled="True" IsEditable="True" Height="30" Margin="0,95,80,0" VerticalAlignment="Top" HorizontalAlignment="Right" Width="242">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <Label Content="محل تولد" FlowDirection="RightToLeft"  HorizontalAlignment="Right" FontSize="10" Margin="0,97,29,0" VerticalAlignment="Top" Width="auto"/>
        <Button x:Name="ESLAH" FontSize="12" Content="اصلاح" Margin="0,406,487,0" Height="36" Cursor="Hand" Foreground="#DDFFFFFF" Padding="16,1,16,4" VerticalAlignment="Top" HorizontalAlignment="Right" Width="105" Click="ESLAH_Click"/>
        <Button x:Name="DELETER_BTN" FontSize="12" Tag="hazfer" Content="حذف" Margin="0,406,617,0" Height="36" Cursor="Hand" Foreground="#DDFFFFFF" Padding="16,1,16,4" VerticalAlignment="Top" HorizontalAlignment="Right" Width="104" Click="DELETER_BTN_Click"/>

    </Grid>
</Window>
