<Window x:Class="Wins.WinMenus.Taarif.FCODE_CUSTOMER"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wins.WinMenus.Taarif"
        mc:Ignorable="d"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="{StaticResource IRANYEKAN}"
        WindowStartupLocation="CenterScreen"
        Title="تعریف مشتری" MinHeight="600" MinWidth="550" Height="558" d:Height="1920" Width="556"  PreviewTextInput="Window_PreviewTextInput"  ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="mygrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="557,410,-8,8"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1" Grid.RowSpan="2">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label x:Name="LBL_HEADER" Content="تعریف مشتری" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>

                </Grid>
            </Border>
        </Border>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True" Grid.RowSpan="2">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                             Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <!--HEADER↑-->

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="23,60,32,23" FlowDirection="RightToLeft">
            <StackPanel x:Name="SP_CUSTOMER_PANEL" Height="1060">
                <Label Content="کد"/>
                <CNC:NumericTextBox DoesAcceptDouble="False" x:Name="CustomerCode" FlowDirection="LeftToRight" IsReadOnly="True" Text="" Height="29" LastValueShouldZero="False" RestoreLastValidValue="False" />
                <Label Content="نام"/>
                <TextBox x:Name="NAMES"  Style="{StaticResource FuzzyOut}" Padding="3" Text="" Height="29" />
                <Label Content="آدرس"/>
                <TextBox x:Name="ADDRESS"  Style="{StaticResource FuzzyOut}" Padding="3" Text="" Height="29" />
                <Label Content="تلفن"/>
                <TextBox x:Name="TEL"  Style="{StaticResource FuzzyOut}" Padding="3" Text="" Height="29" />
                <Label Content="کد اقتصادی"/>
                <CNC:NumericTextBox DoesAcceptDouble="False"  FlowDirection="LeftToRight"  x:Name="ECODE" Text="" Height="29"  LastValueShouldZero="False" />
                <Label Content="کد پستی"/>
                <CNC:NumericTextBox DoesAcceptDouble="False"  FlowDirection="LeftToRight"  x:Name="PCODE" Text="" Height="29"  LastValueShouldZero="False" />
                <Label Content="استان"/>
                <ComboBox x:Name="OSTANID" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" DisplayMemberPath="OSNAME" SelectedValuePath="OSCODE" IsTextSearchEnabled="True" IsEditable="True" Height="29" SelectionChanged="OSTANID_SelectionChanged">
                    <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                        </ItemsPanelTemplate>
                    </ComboBox.ItemsPanel>
                </ComboBox>
                <Label Content="شهرستان"/>
                <ComboBox x:Name="SHAHRID" Padding="7,0,10,0" DisplayMemberPath="CITYNAME" SelectedValuePath="CITYCODE"  IsTextSearchEnabled="True" IsEditable="True" Height="29">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource FuzzyOutComboBox}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=OSTANID, Path=SelectedIndex}" Value="-1">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                    <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                        </ItemsPanelTemplate>
                    </ComboBox.ItemsPanel>
                </ComboBox>
                <Label Content="کد ملی"/>
                <CNC:NumericTextBox DoesAcceptDouble="False" FlowDirection="LeftToRight"  x:Name="MCODEM" Text="" Height="29"  LastValueShouldZero="False"  PreviewLostKeyboardFocus="MCODEM_PreviewLostKeyboardFocus" />
                <Label Content="توضیح"/>
                <TextBox x:Name="TOZIH"  Style="{StaticResource FuzzyOut}" Padding="3" Text="" Height="86" />
                <Label Content="سایر"/>
                <TextBox x:Name="CODE_E"  Style="{StaticResource FuzzyOut}" Padding="3" Text=""/>
                <Label Content="نوع مشتری"/>
                <ComboBox x:Name="CUST_COD" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" DisplayMemberPath="CUSTKNAME" SelectedValuePath="CUST_COD" IsTextSearchEnabled="True" IsEditable="True" Height="29">
                    <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                        </ItemsPanelTemplate>
                    </ComboBox.ItemsPanel>
                </ComboBox>
                <Label Content="موبایل جهت ارسال پیامک"/>
                <TextBox x:Name="MOBILE"  Style="{StaticResource FuzzyOut}" Padding="3" Text=""/>
                <Label Content="مسیر ویزیت"/>
                <ComboBox x:Name="ROUTE_NAME" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" DisplayMemberPath="Expr1" SelectedValuePath="ROUTE_NAME" IsTextSearchEnabled="True" IsEditable="True" Height="29" PreviewLostKeyboardFocus="ROUTE_NAME_PreviewLostKeyboardFocus">
                    <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                        </ItemsPanelTemplate>
                    </ComboBox.ItemsPanel>
                </ComboBox>
                <Label Content="طول جغرافیایی"/>
                <CNC:NumericTextBox x:Name="Latitude"  DoesAcceptDouble="True" LastValueShouldZero="{x:Null}" Text="" MaxDecimalPlaces="10" MaxLength="15"/>
                <Label Content="عرض جغرافیایی"/>
                <CNC:NumericTextBox x:Name="Longitude" DoesAcceptDouble="True" LastValueShouldZero="{x:Null}" Text="" MaxDecimalPlaces="10" MaxLength="15"/>
                <Label Content="شخصیت"/>
                <ComboBox x:Name="tob" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" DisplayMemberPath="NAME" SelectedValuePath="CODE" IsTextSearchEnabled="True" IsEditable="True" Height="29">
                    <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                        </ItemsPanelTemplate>
                    </ComboBox.ItemsPanel>
                </ComboBox>
            </StackPanel>
        </ScrollViewer>

        <Border BorderThickness="1" Margin="0,4,0,0" Background="#FF03A9F4" Height="5" VerticalAlignment="Top" Grid.Row="1"/>

        <UniformGrid Rows="1" Columns="4" FlowDirection="RightToLeft" Margin="9,18,10,97" Grid.Row="1">
            <Button x:Name="Command25" Content="ذخیره" Click="Command25_Click" FontSize="12" Margin="5,5,5,-10" Height="35"  Foreground="#DDFFFFFF" Padding="16,1,16,4"/>
            <Button x:Name="ESLAH" Content="اصلاح" Click="ESLAH_Click" FontSize="12" Height="35"  Margin="5,5,6,-10" Foreground="#DDFFFFFF" Padding="16,2,16,4"/>
            <Button x:Name="Command41" Content="اطلاعات بیشتر" Click="Command41_Click" FontSize="12" Margin="4,5,5,-10" Height="35"  Foreground="#DDFFFFFF" Padding="16,2,16,4"/>
            <Button x:Name="Customer_Delete_Btn" Tag="hazfer" Content="حذف مشتری"  FontSize="12" Margin="5,5,5,-10" Height="35"  Foreground="#DDFFFFFF" Padding="16,2,16,4" Click="Customer_Delete_Btn_Click"/>
        </UniformGrid>
        <Button x:Name="End" Tag ="RD" Click="End_Click" Style="{StaticResource GerdB}" BorderBrush="{x:Null}"
            RenderTransformOrigin="0.5,0.5"  FontSize="10" Margin="388,90,0,0" Height="26" VerticalAlignment="Top" HorizontalAlignment="Left" Width="34" Grid.Row="1">
            <materialDesign:PackIcon  Kind="SkipNext"  HorizontalAlignment="Center" VerticalAlignment="Center" Height="20" Width="21" Foreground="#CCFFFFFF" RenderTransformOrigin="0.206,0.45"  FontSize="10" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="26,-44,0,0" Margin="-19,0,-18,0">
                <materialDesign:PackIcon.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </materialDesign:PackIcon.RenderTransform>
            </materialDesign:PackIcon>
        </Button>
        <Button x:Name="First" Click="First_Click"  Tag ="RD"  Style="{StaticResource GerdB}" BorderBrush="{x:Null}"
            RenderTransformOrigin="0.5,0.5"  FontSize="10" Margin="192,90,0,0" HorizontalAlignment="Left" Width="34" Height="26" VerticalAlignment="Top" Grid.Row="1">
            <materialDesign:PackIcon Kind="SkipNext"  HorizontalAlignment="Right" VerticalAlignment="Top" Height="20" Width="23" Foreground="#CCFFFFFF" RenderTransformOrigin="0.515,0.533"  FontSize="10" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="-30,-1,-5,0">
                <materialDesign:PackIcon.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="-1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform X="4.946"/>
                    </TransformGroup>
                </materialDesign:PackIcon.RenderTransform>
            </materialDesign:PackIcon>
        </Button>
        <Button x:Name="Next" Click="Next_Click" Tag ="RD" Style="{StaticResource GerdB}" BorderBrush="{x:Null}"
            RenderTransformOrigin="0.5,0.5"  FontSize="10" Margin="346,90,0,0"  Height="26" VerticalAlignment="Top" HorizontalAlignment="Left" Width="34" Grid.Row="1">
            <materialDesign:PackIcon Kind="triangle"  HorizontalAlignment="Center" VerticalAlignment="Center" Height="15" Width="15" Foreground="#CCFFFFFF" RenderTransformOrigin="0.254,0.083"  FontSize="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0" Margin="-24,-13,-32,0">
                <materialDesign:PackIcon.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                        <SkewTransform/>
                        <RotateTransform Angle="90"/>
                        <TranslateTransform X="5" Y="10"/>
                    </TransformGroup>
                </materialDesign:PackIcon.RenderTransform>
            </materialDesign:PackIcon>
        </Button>
        <Button x:Name="Back"  Tag ="RD" Click="Back_Click" Style="{StaticResource GerdB}" BorderBrush="{x:Null}"
            RenderTransformOrigin="0.5,0.5"  FontSize="10" Margin="232,90,0,0" HorizontalAlignment="Left" Width="34"  Height="26" VerticalAlignment="Top" Grid.Row="1">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Button.RenderTransform>
            <materialDesign:PackIcon  Kind="triangle"  HorizontalAlignment="Center" VerticalAlignment="Center" Height="15" Width="15" Foreground="#CCFFFFFF" RenderTransformOrigin="0.254,0.083"  FontSize="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0" Margin="-24,-13,-32,0">
                <materialDesign:PackIcon.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                        <SkewTransform/>
                        <RotateTransform Angle="90"/>
                        <TranslateTransform X="5" Y="10"/>
                    </TransformGroup>
                </materialDesign:PackIcon.RenderTransform>
            </materialDesign:PackIcon>
        </Button>
        <Button x:Name="NEWRECORD_BTN" Click="NEWRECORD_BTN_Click"  Tag ="RD" Style="{StaticResource GerdB}" BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="10"  Margin="428,90,0,0" Height="26" VerticalAlignment="Top" HorizontalAlignment="Left" Width="34" Grid.Row="1">
            <materialDesign:PackIcon Kind="AddBold"  HorizontalAlignment="Center" VerticalAlignment="Center" Height="15" Width="15" Foreground="#CCFFFFFF" RenderTransformOrigin="0.254,0.083"  FontSize="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0" Margin="-24,-13,-32,0">
                <materialDesign:PackIcon.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                        <SkewTransform/>
                        <RotateTransform Angle="90"/>
                        <TranslateTransform X="5" Y="10"/>
                    </TransformGroup>
                </materialDesign:PackIcon.RenderTransform>
            </materialDesign:PackIcon>
        </Button>
        <TextBox x:Name="RecCount"  HorizontalContentAlignment="Center" TextAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource FuzzyOut}" IsReadOnly="True" Tag="RD" Padding="7,0,10,0" Margin="467,88,0,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Background="{x:Null}" BorderThickness="1" Height="30" HorizontalAlignment="Left" Width="72" Grid.Row="1" />
        <TextBox x:Name="Current_Rec"   HorizontalContentAlignment="Center" TextAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource FuzzyOut}" IsReadOnly="True" Tag="RD" Padding="7,0,10,0" Margin="269,88,0,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Background="{x:Null}" BorderThickness="1" Height="30" HorizontalAlignment="Left" Width="72" Grid.Row="1" />
        <Button x:Name="SERVERRELOAD_Btn" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Tag ="RD"  Style="{StaticResource GerdB}" BorderBrush="{x:Null}"  FontSize="10" Margin="153,90,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Foreground="#DDFFFFFF" Height="26" Width="34" Click="SERVERRELOAD_Btn_Click" Grid.Row="1">
            <Viewbox Margin="-9,0,-9,0" >
                <materialDesign:PackIcon Kind="Refresh" />
            </Viewbox>
        </Button>
        <Button x:Name="ALLCUSTOMERS" Content="لیست مشتریان" Click="ALLCUSTOMERS_Click" FontSize="10" Margin="13,88,427,0" Height="34"  Foreground="#DDFFFFFF" Padding="16,2,16,4" Grid.Row="1" VerticalAlignment="Top"/>
    </Grid>
</Window>
