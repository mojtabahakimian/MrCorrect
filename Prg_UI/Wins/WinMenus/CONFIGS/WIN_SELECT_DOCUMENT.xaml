<Window x:Class="Prg_UI.Wins.WinMenus.CONFIGS.WIN_SELECT_DOCUMENT"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.CONFIGS"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Background="{x:Null}"
        AllowsTransparency="True"
        WindowStyle="None"
        FontFamily="{StaticResource IRANYEKAN}"
        WindowStartupLocation="CenterOwner"
        Title="انتخاب اقلام سند جهت اتصال" Height="680" Width="850" Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="mygrid">
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Width="1" Background="#FF014547"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}" CornerRadius="10" Padding="8" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!--HEADER-->
                <Border x:Name="TitleDrawBar" Grid.Row="0" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" Height="45" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                    <Grid>
                        <Label x:Name="LblTitle" Content="انتخاب اقلام سند جهت اتصال به قرارداد" Padding="21,10,10,10" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,110,0" FlowDirection="RightToLeft"/>
                        <Button x:Name="Btn_Close" Margin="0,10,13,0" BorderBrush="{x:Null}" Background="Transparent" FontSize="12" Height="25" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Cancel_Click" Foreground="White" Width="30" Padding="1" IsTabStop="False">
                            <materialDesign:PackIcon Kind="WindowClose" Height="17" Width="21" Foreground="White"/>
                        </Button>
                    </Grid>
                </Border>

                <!--BODY-->
                <Grid Grid.Row="1" Margin="10,15,10,10" FlowDirection="RightToLeft">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>

                    <!-- Search Box -->
                    <TextBox x:Name="TxtSearchDoc" Grid.Row="0" materialDesign:HintAssist.Hint="جستجو در اسناد (شماره سند، تاریخ، تحویل دهنده)..." Style="{StaticResource MaterialDesignFloatingHintTextBox}" TextChanged="TxtSearchDoc_TextChanged" Margin="5,0,5,10"/>

                    <!-- Documents List (Top Pane) -->
                    <Grid Grid.Row="1" Margin="5,0,5,5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="۱. انتخاب سند تجاری (رسید/فاکتور)" FontSize="12" FontWeight="Bold" Foreground="#4B5563" Margin="0,0,0,5"/>
                        <DataGrid x:Name="DG_Docs" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="DG_Docs_SelectionChanged" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="شماره سند" Binding="{Binding NUMBER}" Width="1.5*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                                <DataGridTextColumn Header="تاریخ ثبت" Binding="{Binding DATE_N}" Width="1.5*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                                <DataGridTextColumn Header="تحویل‌دهنده / شرح سند" Binding="{Binding TAH}" Width="4*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                                <DataGridTextColumn Header="مبلغ کل (ریال)" Binding="{Binding MAS, StringFormat={}{0:N0}}" Width="2*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Splitter -->
                    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="#E5E7EB" Margin="0,5"/>

                    <!-- Document Lines / Items (Bottom Pane) -->
                    <Grid Grid.Row="3" Margin="5,5,5,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="۲. انتخاب اقلام سند جهت اتصال (می‌توانید چند ردیف را با استفاده از Ctrl یا Shift انتخاب کنید)" FontSize="12" FontWeight="Bold" Foreground="#4B5563" Margin="0,0,0,5"/>
                        <DataGrid x:Name="DG_Lines" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="کد کالا / طرح" Binding="{Binding CODE}" Width="2*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                                <DataGridTextColumn Header="نام طرح / محصول" Binding="{Binding ProductName}" Width="4*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                                <DataGridTextColumn Header="متراژ" Binding="{Binding MEGHk, StringFormat={}{0:N2}}" Width="1.5*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                                <DataGridTextColumn Header="فی واحد" Binding="{Binding MABL, StringFormat={}{0:N0}}" Width="1.5*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                                <DataGridTextColumn Header="مبلغ کل" Binding="{Binding MABL_K, StringFormat={}{0:N0}}" Width="2*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>

                <!--FOOTER-->
                <Border Grid.Row="2" Background="#F9FAFB" Margin="-9,0,-9,-9" Padding="10" CornerRadius="0,0,10,10" BorderThickness="0,1,0,0" BorderBrush="#E5E7EB">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" FlowDirection="RightToLeft">
                        <Button x:Name="Btn_Select" Content="اتصال اقلام انتخاب شده" Style="{StaticResource MaterialDesignRaisedButton}" Background="#0284C7" BorderBrush="{x:Null}" Width="180" Click="Btn_Select_Click" Margin="0,0,10,0"/>
                        <Button x:Name="Btn_Cancel" Content="انصراف" Style="{StaticResource MaterialDesignOutlinedButton}" BorderBrush="#9CA3AF" Foreground="#4B5563" Width="100" Click="Btn_Cancel_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Toast Notifications Pop -->
        <Popup x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative" Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1" VerticalAlignment="Center" Background="{x:Null}"
                             Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
    </Grid>
</Window>