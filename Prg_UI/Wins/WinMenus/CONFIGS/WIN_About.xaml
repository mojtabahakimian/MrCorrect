<Window x:Class="Prg_UI.Wins.WinMenus.CONFIGS.WIN_About"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.CONFIGS"
        mc:Ignorable="d"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Height="600" Width="800"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MinHeight="400"
        FontFamily="{StaticResource IRANYEKAN}"
        Background="{x:Null}"
        AllowsTransparency="True" AllowDrop="True"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="15"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Color="{Binding ElementName=GENERAL_RANG, Path=Background.Color}" Opacity="0.3"/>
    </Window.Resources>

    <Grid x:Name="mygrid" Margin="8,8,8,0">
        <!-- Hidden button for color binding reference -->
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Width="1" Height="1"/>
        <!-- Main container -->
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding ElementName=GENERAL_RANG, Path=Background}" BorderThickness="1" CornerRadius="10" Padding="8">
            <!-- Title bar -->
            <Border  x:Name="TitleDrawBar" Style="{StaticResource BordG}"  Background="{Binding ElementName=GENERAL_RANG, Path=Background}"  CornerRadius="10,10,0,0" Margin="-9,-9,-9,0"  Height="38"  VerticalAlignment="Top" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <!-- Window title -->
                    <Label x:Name="LABEL_HEADER" Content="درباره تهیه کنندگان" Padding="17,8,10,10" Foreground="White" Margin="0,0,110,0" VerticalAlignment="Center"/>
                    <!-- Window control buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0">
                        <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0,0,0,-1" IsTabStop="False" ToolTip="Minimize">
                            <materialDesign:PackIcon Kind="WindowMinimize" Width="18" Height="18" Foreground="White"/>
                        </Button>
                        <Button x:Name="Btn_Max" Click="Btn_Max_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" FontSize="12" Height="24" Padding="0" Margin="4,0,0,0" IsTabStop="False" ToolTip="Maximize">
                            <materialDesign:PackIcon Kind="WindowMaximize" Width="17" Height="17" Foreground="White"/>
                        </Button>
                        <Button x:Name="Btn_Close" Click="Btn_Close_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0" Margin="4,0,0,0" FontSize="12" IsTabStop="False" ToolTip="Close">
                            <materialDesign:PackIcon Kind="WindowClose" Width="19" Height="19" Foreground="White"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
        <!-- Notification popup -->
        <Popup x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative" Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Width="{Binding ElementName=mygrid, Path=ActualWidth, Mode=OneWay}" Height="84" Padding="10">
                <TextBox x:Name="Pop1Text1" IsReadOnly="True" Background="Transparent" BorderBrush="Transparent" Foreground="White" Text="محل نمایش اعلان های سیستم" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
            </Border>
        </Popup>

        <!-- Content area -->
        <Grid Margin="0,38,0,0">
            <TabControl Margin="10">
                <TabItem Header="قائم رایانه عرش">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                        </Grid.ColumnDefinitions>


                        <Border CornerRadius="5" Grid.Column="0"  Margin="15,15,15,99" IsHitTestVisible="False" Focusable="False" BorderThickness="2" BorderBrush="White">
                            <Label HorizontalAlignment="Center" Foreground="{Binding ElementName=GENERAL_RANG, Path=Background}" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="25">Mr Correct</Label>
                            <Border.Effect>
                                <BlurEffect Radius="1"/>
                            </Border.Effect>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-90,0,0">
                            <TextBlock Margin="2" Text="نرم افزار حسابداری، تولید، خرید، فروش با نام Mr Correct" FontSize="14" FontWeight="Bold" FlowDirection="RightToLeft"/>
                            <TextBlock Margin="2"  Text="دارای حق کپی رایت © ۱۳۸۱" FlowDirection="RightToLeft"/>
                            <TextBlock Margin="2" FlowDirection="RightToLeft">
                            <Run Text="Email: "/>
                            <Hyperlink NavigateUri="mailto:info@mr-correct.com">info@mr-correct.com</Hyperlink>
                            </TextBlock>
                            <TextBlock x:Name="VersionLabel" FlowDirection="RightToLeft" Margin="2" Text="Version: 7.1.1"/>
                            <TextBlock HorizontalAlignment="Right" Margin="2">
                                <Hyperlink NavigateUri="http://2.184.57.153:90/update/negin.zip">
                                    <Run Text="آپدیت نرم افزار"/>
                                </Hyperlink>
                            </TextBlock>
                            <StackPanel FlowDirection="RightToLeft" Margin="2">
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <Label Content="نام سرور قفل :"/>
                                    <TextBox x:Name="SERVERNAM" Width="250" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextAlignment="Right" PreviewLostKeyboardFocus="SERVERNAM_PreviewLostKeyboardFocus"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <Label Content="تاریخ پایان خدمات پشتیبانی :"/>
                                    <TextBox x:Name="Whether" Width="172" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextAlignment="Right" IsHitTestVisible="False" IsTabStop="False"/>
                                </StackPanel>
                            </StackPanel>

                        </StackPanel>

                        <UniformGrid Grid.ColumnSpan="2" Columns="4" VerticalAlignment="Bottom" Margin="10">
                            <Button FontSize="10" Style="{StaticResource MaterialDesignOutlinedSecondaryButton}" materialDesign:ButtonAssist.CornerRadius="15" x:Name="Command38" Content="تست قفل" Margin="5" Click="Command38_Click"/>
                            <Button FontSize="10" Style="{StaticResource MaterialDesignOutlinedSecondaryButton}" materialDesign:ButtonAssist.CornerRadius="15" x:Name="Command43" Content="اصلاح کدپیج" Margin="5" Click="Command43_Click"/>
                            <Button FontSize="10" Style="{StaticResource MaterialDesignOutlinedSecondaryButton}" materialDesign:ButtonAssist.CornerRadius="15" x:Name="Command39" Content="کدینگ استان" Margin="5" Click="Command39_Click"/>
                            <Button FontSize="10" Style="{StaticResource MaterialDesignOutlinedSecondaryButton}" materialDesign:ButtonAssist.CornerRadius="15" x:Name="Command41" Content="اسکریپت" Margin="5" Click="Command41_Click"/>
                            <Button FontSize="10" Style="{StaticResource MaterialDesignOutlinedSecondaryButton}" materialDesign:ButtonAssist.CornerRadius="15" x:Name="Command42" Content="تبدیل ۱۴۰۰" Margin="5" Click="Command42_Click"/>
                        </UniformGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="مشخصات خریدار">
                    <Grid Margin="15" FlowDirection="RightToLeft">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Row="0" Grid.Column="0" Content="شماره کارگاه:" VerticalAlignment="Center"/>
                        <TextBox x:Name="UNIVERSITY_CO" Grid.Row="0" Grid.Column="1" Margin="5" IsReadOnly="True"/>

                        <Label Grid.Row="1" Grid.Column="0" Content="نام واحد:" VerticalAlignment="Center"/>
                        <TextBox x:Name="NAME" Grid.Row="1" Grid.Column="1" Margin="5" IsReadOnly="True"/>

                        <Label Grid.Row="2" Grid.Column="0" Content="نام استان:" VerticalAlignment="Center"/>
                        <TextBox x:Name="IYALAT" Grid.Row="2" Grid.Column="1" Margin="5" IsReadOnly="True"/>

                        <Label Grid.Row="3" Grid.Column="0" Content="نام شهر:" VerticalAlignment="Center"/>
                        <TextBox x:Name="CITY" Grid.Row="3" Grid.Column="1" Margin="5" IsReadOnly="True"/>

                        <Label Grid.Row="4" Grid.Column="0" Content="کد اقتصادی:" VerticalAlignment="Center"/>
                        <TextBox x:Name="ECODE" Grid.Row="4" Grid.Column="1" Margin="5" IsReadOnly="True"/>

                        <Label Grid.Row="5" Grid.Column="0" Content="کد پستی:" VerticalAlignment="Center"/>
                        <TextBox x:Name="PCODE" Grid.Row="5" Grid.Column="1" Margin="5" IsReadOnly="True"/>

                        <Label Grid.Row="6" Grid.Column="0" Content="شماره ثبت:" VerticalAlignment="Center"/>
                        <TextBox x:Name="MCODEM" Grid.Row="6" Grid.Column="1" Margin="5" IsReadOnly="True"/>

                        <Label Grid.Row="7" Grid.Column="0" Content="ریاست واحد:" VerticalAlignment="Center"/>
                        <TextBox x:Name="MANAGER" Grid.Row="7" Grid.Column="1" Margin="5" IsReadOnly="True"/>

                        <Label Grid.Row="8" Grid.Column="0" Content="معاون اداری مالی:" VerticalAlignment="Center"/>
                        <TextBox x:Name="MOAVEN" Grid.Row="8" Grid.Column="1" Margin="5" IsReadOnly="True"/>

                        <Label Grid.Row="9" Grid.Column="0" Content="مدیر مالی:" VerticalAlignment="Center"/>
                        <TextBox x:Name="ZIHESAB" Grid.Row="9" Grid.Column="1" Margin="5" IsReadOnly="True"/>

                        <Label Grid.Row="10" Grid.Column="0" Content="شعبه تامین اجتماعی:" VerticalAlignment="Center"/>
                        <TextBox x:Name="AMINAMVAL" Grid.Row="10" Grid.Column="1" Margin="5" IsReadOnly="True"/>
                    </Grid>
                </TabItem>
            </TabControl>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0" Height="48" VerticalAlignment="Bottom">
                <Button x:Name="BTN_ESLAH" Content="اصلاح" Width="100" Margin="5" Click="BTN_ESLAH_Click" BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF"/>
                <Button x:Name="BTN_SAVE" Content="ذخیره" Width="150" IsEnabled="False" Margin="5" Click="BTN_SAVE_Click" BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
