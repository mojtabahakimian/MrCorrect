<Window x:Class="Prg_UI.Wins.WinMenus.CONFIGS.WIN_AUDIT_TRAIL"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.CONFIGS"
        mc:Ignorable="d"
        Title=""
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Height="700" Width="1250"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MinHeight="450" MinWidth="900"
        FontFamily="{StaticResource IRANYEKAN}"
        Background="{x:Null}"
        AllowsTransparency="True" AllowDrop="True"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="15"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Color="{Binding ElementName=GENERAL_RANG, Path=Background.Color}" Opacity="0.3"/>
    </Window.Resources>

    <Grid x:Name="mygrid" Margin="8,8,8,0">
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Width="1" Height="1"/>

        <Border Background="{StaticResource MaterialDesign.Brush.Background}"
                BorderBrush="{Binding ElementName=GENERAL_RANG, Path=Background}"
                BorderThickness="1" CornerRadius="10" Padding="8">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}"
                    Background="{Binding ElementName=GENERAL_RANG, Path=Background}"
                    CornerRadius="10,10,0,0" Margin="-9,-9,-9,0" Height="38"
                    VerticalAlignment="Top" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label x:Name="LABEL_HEADER" Content="سوابق و ردیابی فعالیت کاربران"
                           Padding="17,8,10,10" Foreground="White" Margin="0,0,110,0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0">
                        <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0,0,0,-1" IsTabStop="False" ToolTip="Minimize">
                            <materialDesign:PackIcon Kind="WindowMinimize" Width="18" Height="18" Foreground="White"/>
                        </Button>
                        <Button x:Name="Btn_Max" Click="Btn_Max_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" FontSize="12" Height="24" Padding="0" Margin="4,0,0,0" IsTabStop="False" ToolTip="Maximize">
                            <materialDesign:PackIcon Kind="WindowMaximize" Width="17" Height="17" Foreground="White"/>
                        </Button>
                        <Button x:Name="Btn_Close" Click="Btn_Close_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0" Margin="4,0,0,0" FontSize="12" IsTabStop="False" ToolTip="Close">
                            <materialDesign:PackIcon Kind="WindowClose" Width="19" Height="19" Foreground="White"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <Grid Margin="4,42,4,4" FlowDirection="RightToLeft">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- نوار فیلترها -->
            <Border Grid.Row="0" Padding="6" Margin="0,0,0,6"
                    BorderBrush="{StaticResource GENERAL_Grlicom}" BorderThickness="1" CornerRadius="6">
                <WrapPanel Orientation="Horizontal">
                    <StackPanel Orientation="Vertical" Margin="4,0">
                        <TextBlock Text="کاربر" FontSize="10" Opacity="0.7"/>
                        <ComboBox x:Name="CMB_USER" Width="170" DisplayMemberPath="SAL_NAME" SelectedValuePath="IDD"
                                  IsEditable="False" materialDesign:HintAssist.Hint="همه کاربران"/>
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Margin="4,0">
                        <TextBlock Text="از تاریخ" FontSize="10" Opacity="0.7"/>
                        <TextBox x:Name="TXT_FROM" Width="100" MaxLength="10" TextAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Margin="4,0">
                        <TextBlock Text="تا تاریخ" FontSize="10" Opacity="0.7"/>
                        <TextBox x:Name="TXT_TO" Width="100" MaxLength="10" TextAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Margin="4,0">
                        <TextBlock Text="دسته" FontSize="10" Opacity="0.7"/>
                        <ComboBox x:Name="CMB_CATEGORY" Width="150" DisplayMemberPath="Title" SelectedValuePath="Value"/>
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Margin="4,0">
                        <TextBlock Text="نوع عملیات" FontSize="10" Opacity="0.7"/>
                        <ComboBox x:Name="CMB_ACTION" Width="150" DisplayMemberPath="Title" SelectedValuePath="Value"/>
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Margin="4,0">
                        <TextBlock Text="شماره سند" FontSize="10" Opacity="0.7"/>
                        <TextBox x:Name="TXT_DOC" Width="120"/>
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Margin="4,0">
                        <TextBlock Text="جستجو در شرح" FontSize="10" Opacity="0.7"/>
                        <TextBox x:Name="TXT_SEARCH" Width="180"/>
                    </StackPanel>

                    <StackPanel Orientation="Vertical" Margin="4,0" VerticalAlignment="Bottom">
                        <CheckBox x:Name="CHK_SENSITIVE" Content="فقط موارد حساس" Margin="0,0,0,4"/>
                    </StackPanel>

                    <Button x:Name="BTN_SEARCH" Content="جستجو" Click="BTN_SEARCH_Click" Margin="8,12,4,0"
                            Style="{StaticResource MaterialDesignRaisedButton}" Width="90"/>
                </WrapPanel>
            </Border>

            <!-- خط زمانی -->
            <DataGrid x:Name="DG_MAIN" Grid.Row="1"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      IsReadOnly="True"
                      FlowDirection="RightToLeft"
                      EnableRowVirtualization="True"
                      EnableColumnVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ItemsSource="{Binding Rows}"
                      ColumnHeaderStyle="{StaticResource CenteryHeaderstyle}"
                      HorizontalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                      VerticalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                      SelectionUnit="FullRow"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                <DataGrid.Style>
                    <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource MaterialDesignDataGrid}">
                        <Setter Property="GridLinesVisibility" Value="All"/>
                    </Style>
                </DataGrid.Style>

                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border Padding="10,6" Background="{StaticResource GENERAL_Grlicom}">
                            <StackPanel>
                                <TextBlock Text="{Binding DETAIL}" TextWrapping="Wrap" FontSize="11"/>
                                <TextBlock FontSize="10" Opacity="0.75" Margin="0,4,0,0">
                                    <Run Text="کامپیوتر:"/><Run Text="{Binding MACHINE_NAME, Mode=OneWay}"/>
                                    <Run Text="   |   IP:"/><Run Text="{Binding CLIENT_IP, Mode=OneWay}"/>
                                    <Run Text="   |   کاربر ویندوز:"/><Run Text="{Binding WIN_USER, Mode=OneWay}"/>
                                    <Run Text="   |   نسخه:"/><Run Text="{Binding APP_VERSION, Mode=OneWay}"/>
                                    <Run Text="   |   نشست:"/><Run Text="{Binding SESSION_ID, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="تاریخ" Binding="{Binding DateText}" Width="90"/>
                    <DataGridTextColumn Header="ساعت" Binding="{Binding TimeText}" Width="70"/>
                    <DataGridTextColumn Header="کاربر" Binding="{Binding USER_NAME}" Width="130"/>
                    <DataGridTextColumn Header="دسته" Binding="{Binding CategoryText}" Width="90"/>
                    <DataGridTextColumn Header="عملیات" Binding="{Binding ActionText}" Width="110"/>
                    <DataGridTextColumn Header="شرح" Binding="{Binding TITLE}" Width="*"/>
                    <DataGridTextColumn Header="سند" Binding="{Binding DocumentText}" Width="180"/>
                    <DataGridTextColumn Header="فرم" Binding="{Binding FORM_NAME}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- نوار وضعیت -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="BTN_MORE" Content="نمایش بیشتر" Click="BTN_MORE_Click"
                        Style="{StaticResource MaterialDesignRaisedButton}" Width="120" IsEnabled="False"/>
                <TextBlock x:Name="LBL_STATUS" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.8"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
