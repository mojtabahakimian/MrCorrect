                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="Check61" Grid.Column="0" Content="موجودي بر اساس کاردکس در جستجوي کالا نشان داده شود" Style="{StaticResource SettingCheckBox}"/>
                            <Label Grid.Column="1" Content="41" Style="{StaticResource SettingNumberLabel}"/>
