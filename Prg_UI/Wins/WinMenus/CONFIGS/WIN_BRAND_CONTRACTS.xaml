<Window x:Class="Prg_UI.Wins.WinMenus.CONFIGS.WIN_BRAND_CONTRACTS"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.CONFIGS"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Background="{x:Null}"
        AllowsTransparency="True"
        WindowStyle="None"
        FontFamily="{StaticResource IRANYEKAN}"
        WindowStartupLocation="CenterScreen"
        Title="مدیریت و گزارش پیشرفت قراردادها" Height="750" Width="1200" Loaded="Window_Loaded">
    <Window.Resources>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="mygrid">
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Width="1" Background="#FF014547"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}" CornerRadius="10" Padding="8" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!--HEADER-->
                <Border x:Name="TitleDrawBar" Grid.Row="0" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" Height="45" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                    <Grid>
                        <Label Content="مدیریت و گزارش پیشرفت قراردادها (آرمان سرام)" Padding="21,10,10,10" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,110,0" FlowDirection="RightToLeft"/>
                        <Button x:Name="Btn_Close" Margin="0,10,13,0" BorderBrush="{x:Null}" Background="Transparent" FontSize="12" Height="25" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click" Foreground="White" Width="30" Padding="1" IsTabStop="False">
                            <materialDesign:PackIcon Kind="WindowClose" Height="17" Width="21" Foreground="White"/>
                        </Button>
                        <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,75,0" BorderBrush="{x:Null}" Background="Transparent" FontSize="12" Height="25" VerticalAlignment="Top" HorizontalAlignment="Right" Foreground="White" Width="30" Padding="1" IsTabStop="False">
                            <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White"/>
                        </Button>
                        <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,44,0" BorderBrush="{x:Null}" Background="Transparent" FontSize="12" Height="25" VerticalAlignment="Top" HorizontalAlignment="Right" Foreground="White" Width="30" Padding="1" IsTabStop="False">
                            <materialDesign:PackIcon Kind="WindowMaximize" Height="17" Width="21" Foreground="White"/>
                        </Button>
                    </Grid>
                </Border>

                <!--MAIN CONTENT-->
                <Grid Grid.Row="1" Margin="5,15,5,5" FlowDirection="RightToLeft">
                    <Grid.ColumnDefinitions>
                        <!-- Right Sidebar: Contracts List -->
                        <ColumnDefinition Width="320"/>
                        <!-- Splitter -->
                        <ColumnDefinition Width="5"/>
                        <!-- Left Panel: Selected Contract Details and Status -->
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Right Sidebar -->
                    <Border Grid.Column="0" Background="{StaticResource MaterialDesign.Brush.Card.Background}" CornerRadius="5" Padding="8" BorderThickness="1" BorderBrush="#E0E0E0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="لیست قراردادها" FontSize="14" FontWeight="Bold" Foreground="{Binding Background, ElementName=GENERAL_RANG}" Margin="0,0,0,10"/>

                            <!-- Search -->
                            <TextBox x:Name="TxtSearchContract" Grid.Row="1" materialDesign:HintAssist.Hint="جستجو در قراردادها (شماره، برند، مشتری)..." Style="{StaticResource MaterialDesignFloatingHintTextBox}" TextChanged="TxtSearchContract_TextChanged" Margin="0,0,0,10"/>

                            <!-- Contracts List -->
                            <DataGrid x:Name="DG_Contracts" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" SelectionChanged="DG_Contracts_SelectionChanged" Background="Transparent" BorderThickness="0" RowHeaderWidth="0" GridLinesVisibility="None">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="شماره قرارداد" Binding="{Binding ContractNumber}" Width="2*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                                    <DataGridTextColumn Header="نام برند" Binding="{Binding BrandName}" Width="2*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                                    <DataGridTextColumn Header="متراژ کل" Binding="{Binding TotalQuantity, StringFormat={}{0:N0} متر}" Width="1*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Actions -->
                            <UniformGrid Grid.Row="3" Columns="3" Margin="0,10,0,0">
                                <Button Content="جدید" Background="#10B981" BorderBrush="{x:Null}" Foreground="White" Click="Btn_NewContract_Click" Margin="2"/>
                                <Button Content="ویرایش" Background="#3B82F6" BorderBrush="{x:Null}" Foreground="White" Click="Btn_EditContract_Click" Margin="2"/>
                                <Button Content="حذف" Background="#EF4444" BorderBrush="{x:Null}" Foreground="White" Click="Btn_DeleteContract_Click" Margin="2"/>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <!-- Splitter -->
                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"/>

                    <!-- Left Area: Details and Reports -->
                    <Grid Grid.Column="2" Margin="10,0,0,0">
                        <Grid.RowDefinitions>
                            <!-- Selected Contract Info Header -->
                            <RowDefinition Height="Auto"/>
                            <!-- KPI Summary Cards -->
                            <RowDefinition Height="Auto"/>
                            <!-- Tab Control for Detailed Info -->
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Selected Contract Header -->
                        <Border Grid.Row="0" Background="{StaticResource MaterialDesign.Brush.Card.Background}" CornerRadius="5" Padding="15" Margin="0,0,0,10" BorderThickness="1" BorderBrush="#E0E0E0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                        <TextBlock Text="قرارداد: " FontSize="16" FontWeight="Bold" Foreground="#374151"/>
                                        <TextBlock x:Name="LblContractNumber" Text="---" FontSize="16" FontWeight="Bold" Foreground="#2563EB" Margin="0,0,20,0"/>
                                        <TextBlock Text="برند: " FontSize="16" FontWeight="Bold" Foreground="#374151"/>
                                        <TextBlock x:Name="LblBrandName" Text="---" FontSize="16" FontWeight="Bold" Foreground="#059669"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="مشتری: " FontSize="12" Foreground="#6B7280"/>
                                        <TextBlock x:Name="LblCustomer" Text="---" FontSize="12" FontWeight="Bold" Foreground="#374151" Margin="0,0,20,0"/>
                                        <TextBlock Text="تاریخ ثبت: " FontSize="12" Foreground="#6B7280"/>
                                        <TextBlock x:Name="LblContractDate" Text="---" FontSize="12" Foreground="#374151" Margin="0,0,20,0"/>
                                        <TextBlock Text="توضیحات: " FontSize="12" Foreground="#6B7280"/>
                                        <TextBlock x:Name="LblDescription" Text="---" FontSize="12" Foreground="#374151"/>
                                    </StackPanel>
                                </StackPanel>

                                <Button Grid.Column="1" Style="{StaticResource MaterialDesignOutlinedButton}" Content="چاپ گزارش کامل" Click="Btn_PrintReport_Click" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}" Foreground="{Binding Background, ElementName=GENERAL_RANG}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- KPI Summary Cards -->
                        <UniformGrid Grid.Row="1" Columns="5" Margin="0,0,0,10">
                            <!-- Card 1: Total Contracted -->
                            <Border Background="#EFF6FF" CornerRadius="8" Padding="12" Margin="4" BorderThickness="1" BorderBrush="#BFDBFE">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Contract" HorizontalAlignment="Center" Foreground="#2563EB" Height="24" Width="24" Margin="0,0,0,5"/>
                                    <TextBlock Text="متراژ کل قرارداد" FontSize="11" Foreground="#1E3A8A" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="KpiTotalContracted" Text="0" FontSize="18" FontWeight="Bold" Foreground="#1E3A8A" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 2: Total Produced -->
                            <Border Background="#ECFDF5" CornerRadius="8" Padding="12" Margin="4" BorderThickness="1" BorderBrush="#A7F3D0">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Factory" HorizontalAlignment="Center" Foreground="#10B981" Height="24" Width="24" Margin="0,0,0,5"/>
                                    <TextBlock Text="مقدار تولید شده" FontSize="11" Foreground="#064E3B" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="KpiTotalProduced" Text="0" FontSize="18" FontWeight="Bold" Foreground="#064E3B" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 3: Remaining to Produce -->
                            <Border Background="#FFFBEB" CornerRadius="8" Padding="12" Margin="4" BorderThickness="1" BorderBrush="#FDE68A">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ProgressWrench" HorizontalAlignment="Center" Foreground="#F59E0B" Height="24" Width="24" Margin="0,0,0,5"/>
                                    <TextBlock Text="باقی‌مانده جهت تولید" FontSize="11" Foreground="#78350F" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="KpiTotalRemaining" Text="0" FontSize="18" FontWeight="Bold" Foreground="#78350F" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 4: Total Sold -->
                            <Border Background="#FDF2F8" CornerRadius="8" Padding="12" Margin="4" BorderThickness="1" BorderBrush="#FBCFE8">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Cart" HorizontalAlignment="Center" Foreground="#EC4899" Height="24" Width="24" Margin="0,0,0,5"/>
                                    <TextBlock Text="کل فروش رفته" FontSize="11" Foreground="#701A75" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="KpiTotalSold" Text="0" FontSize="18" FontWeight="Bold" Foreground="#701A75" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Card 5: In Warehouse -->
                            <Border Background="#F5F3FF" CornerRadius="8" Padding="12" Margin="4" BorderThickness="1" BorderBrush="#DDD6FE">
                                <StackPanel HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Warehouse" HorizontalAlignment="Center" Foreground="#8B5CF6" Height="24" Width="24" Margin="0,0,0,5"/>
                                    <TextBlock Text="موجودی در انبار" FontSize="11" Foreground="#4C1D95" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="KpiTotalInWarehouse" Text="0" FontSize="18" FontWeight="Bold" Foreground="#4C1D95" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Tab Control -->
                        <TabControl Grid.Row="2" Style="{StaticResource MaterialDesignNavigationRailTabControl}">
                            <!-- Tab 1: Detailed Items Status -->
                            <TabItem Header="گزارش وضعیت تفکیکی طرح‌ها (اقلام)">
                                <Border Background="{StaticResource MaterialDesign.Brush.Card.Background}" CornerRadius="0,0,5,5" Padding="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <DataGrid x:Name="DG_ItemStatus" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="کد طرح / کالا" Binding="{Binding ProductCode}" Width="1.5*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                                                <DataGridTextColumn Header="نام طرح" Binding="{Binding ProductName}" Width="3*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                                                <DataGridTextColumn Header="متراژ تعهد شده" Binding="{Binding ContractedQty, StringFormat={}{0:N0} متر}" Width="1.5*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                                                <DataGridTextColumn Header="تولید شده" Binding="{Binding ProducedQty, StringFormat={}{0:N0} متر}" Width="1.5*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                                                <DataGridTextColumn Header="باقی‌مانده جهت تولید" Binding="{Binding NotProducedQty, StringFormat={}{0:N0} متر}" Width="1.8*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                                                    <DataGridTextColumn.CellStyle>
                                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding NotProducedQty}" Value="0">
                                                                    <Setter Property="Foreground" Value="#10B981"/>
                                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGridTextColumn.CellStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="فروش رفته" Binding="{Binding SoldQty, StringFormat={}{0:N0} متر}" Width="1.5*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                                                <DataGridTextColumn Header="موجودی در انبار" Binding="{Binding InWarehouseQty, StringFormat={}{0:N0} متر}" Width="1.5*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}">
                                                    <DataGridTextColumn.CellStyle>
                                                        <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding InWarehouseQty}" Value="0">
                                                                    <Setter Property="Foreground" Value="#9CA3AF"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </DataGridTextColumn.CellStyle>
                                                </DataGridTextColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <TextBlock Grid.Row="1" Text="* مقادیر باقی‌مانده و موجودی انبار به صورت داینامیک بر اساس تفاوت تولید و فروش اسناد متصل محاسبه می‌شوند." FontSize="11" Margin="0,5,0,0" Foreground="#6B7280"/>
                                    </Grid>
                                </Border>
                            </TabItem>

                            <!-- Tab 2: Linked Documents -->
                            <TabItem Header="اسناد متصل به قرارداد">
                                <Border Background="{StaticResource MaterialDesign.Brush.Card.Background}" CornerRadius="0,0,5,5" Padding="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                            <Button Style="{StaticResource MaterialDesignRaisedButton}" Background="#10B981" BorderBrush="{x:Null}" Content="اتصال رسید تولید جدید (TAG = 9)" Click="Btn_LinkProduction_Click" Margin="0,0,10,0"/>
                                            <Button Style="{StaticResource MaterialDesignRaisedButton}" Background="#3B82F6" BorderBrush="{x:Null}" Content="اتصال حواله فروش جدید (TAG = 2)" Click="Btn_LinkSales_Click" Margin="0,0,10,0"/>
                                            <Button Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="#EF4444" BorderBrush="#EF4444" Content="قطع اتصال سند" Click="Btn_UnlinkDocument_Click"/>
                                        </StackPanel>

                                        <DataGrid x:Name="DG_LinkedDocs" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="شماره سند" Binding="{Binding NUMBER}" Width="1.5*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                                                <DataGridTextColumn Header="نوع سند" Binding="{Binding DocumentTypeName}" Width="2*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                                                <DataGridTextColumn Header="تاریخ ثبت" Binding="{Binding DATE_N}" Width="1.5*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                                                <DataGridTextColumn Header="شرح / تحویل‌دهنده" Binding="{Binding TAH}" Width="4*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                                                <DataGridTextColumn Header="جمع مبلغ ریالی" Binding="{Binding MAS, StringFormat={}{0:N0} ریال}" Width="2*" ElementStyle="{StaticResource MaterialDesignDataGridTextColumnStyle}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Toast Notifications Pop -->
        <Popup x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative" Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1" VerticalAlignment="Center" Background="{x:Null}"
                             Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
    </Grid>
</Window>