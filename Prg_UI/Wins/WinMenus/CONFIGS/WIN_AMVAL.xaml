<Window x:Class="Prg_UI.Wins.WinMenus.CONFIGS.WIN_AMVAL"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.CONFIGS"
        mc:Ignorable="d"
        Title=""
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Height="855" Width="1024"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MinHeight="400"
        FontFamily="{StaticResource IRANYEKAN}"
        Background="{x:Null}"
        AllowsTransparency="True" AllowDrop="True"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="15"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Color="{Binding ElementName=GENERAL_RANG, Path=Background.Color}" Opacity="0.3"/>


    </Window.Resources>

    <Grid x:Name="mygrid" Margin="8,8,8,0">
        <!-- Hidden button for color binding reference -->
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Width="1" Height="1"/>
        <!-- Main container -->
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding ElementName=GENERAL_RANG, Path=Background}" BorderThickness="1" CornerRadius="10" Padding="8">
            <!-- Title bar -->
            <Border  x:Name="TitleDrawBar" Style="{StaticResource BordG}"  Background="{Binding ElementName=GENERAL_RANG, Path=Background}"  CornerRadius="10,10,0,0" Margin="-9,-9,-9,0"  Height="38"  VerticalAlignment="Top" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <!-- Window title -->
                    <Label x:Name="LABEL_HEADER" Content="عنوان این پنجره" Padding="17,8,10,10" Foreground="White" Margin="0,0,110,0" VerticalAlignment="Center"/>
                    <!-- Window control buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0">
                        <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0,0,0,-1" IsTabStop="False" ToolTip="Minimize">
                            <materialDesign:PackIcon Kind="WindowMinimize" Width="18" Height="18" Foreground="White"/>
                        </Button>
                        <Button x:Name="Btn_Max" Click="Btn_Max_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" FontSize="12" Height="24" Padding="0" Margin="4,0,0,0" IsTabStop="False" ToolTip="Maximize">
                            <materialDesign:PackIcon Kind="WindowMaximize" Width="17" Height="17" Foreground="White"/>
                        </Button>
                        <Button x:Name="Btn_Close" Click="Btn_Close_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0" Margin="4,0,0,0" FontSize="12" IsTabStop="False" ToolTip="Close">
                            <materialDesign:PackIcon Kind="WindowClose" Width="19" Height="19" Foreground="White"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
        <!-- Notification popup -->
        <Popup x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative" Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Width="{Binding ElementName=mygrid, Path=ActualWidth, Mode=OneWay}" Height="84" Padding="10">
                <TextBox x:Name="Pop1Text1" IsReadOnly="True" Background="Transparent" BorderBrush="Transparent" Foreground="White" Text="محل نمایش اعلان های سیستم" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
            </Border>
        </Popup>

        <!-- Content area -->
        <Grid Margin="0,38,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="50"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" 
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="10"
                    Margin="0,0,15,0"
                    Background="White">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" 
                               Text="تصویر دارایی" 
                               FontWeight="Bold" 
                               FontSize="12"
                               Margin="0,0,0,10"
                               Foreground="{DynamicResource PrimaryHueMidBrush}" TextAlignment="Center"/>

                                <Border Grid.Row="1"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Background="#F5F5F5">
                                    <Image x:Name="PIC" 
                               Stretch="Uniform" 
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1" FlowDirection="RightToLeft">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- برچسب -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="برچسب:" Width="150" VerticalAlignment="Center" FontWeight="Bold"/>
                                <TextBox x:Name="BARCHASB"
                                    Width="200"
                                    Text="0"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    IsReadOnly="True"/>
                            </StackPanel>

                            <!-- نام -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="نام:" Width="150" VerticalAlignment="Center" FontWeight="Bold"/>
                                <TextBox x:Name="ANAME" 
                                    Width="500" 
                                    materialDesign:HintAssist.Hint="نام دارایی"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    FontWeight="Bold"/>
                            </StackPanel>

                            <!-- روش محاسبه استهلاک -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="روش محاسبه استهلاک:" Width="150" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CALMETHOD" 
                                Width="200"
                                materialDesign:HintAssist.Hint="انتخاب کنید"
                                Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                DisplayMemberPath="Value"
                                SelectedValuePath="Key"/>
                            </StackPanel>

                            <!-- ضریب محاسبه استهلاک -->
                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="ضریب محاسبه استهلاک:" Width="150" VerticalAlignment="Center"/>
                                <CNC:NumericTextBox DoesAcceptDouble="True" TextAlignment="Left" x:Name="RATE" Text="0" MaxLength="6" Width="200" CustomUpdateSourceTrigger="PropertyChanged"/>

                            </StackPanel>

                            <!-- حساب معادل در حسابداری -->
                            <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="حساب معادل در حسابداری:" Width="150" VerticalAlignment="Center"/>
                                <ComboBox x:Name="HESAB" 
                                     Width="341"
                                     IsSynchronizedWithCurrentItem="True"
                                     materialDesign:HintAssist.Hint="انتخاب حساب"
                                     Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                     IsEditable="True"
                                     DisplayMemberPath="NAME"
                                     SelectedValuePath="hes"
                                     Background="#FCE4D6"
                                     Foreground="#800000">
                                    <ComboBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                                        </ItemsPanelTemplate>
                                    </ComboBox.ItemsPanel>
                                </ComboBox>

                                <ComboBox x:Name="HESAB2" Margin="3"
                                          Width="180"
                                          IsSynchronizedWithCurrentItem="True"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          IsEditable="True"
                                          DisplayMemberPath="hes"
                                          SelectedValuePath="hes"
                                          Background="#FCE4D6"
                                          Foreground="#800000">
                                    <ComboBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                                        </ItemsPanelTemplate>
                                    </ComboBox.ItemsPanel>
                                </ComboBox>
                            </StackPanel>

                            <!-- تاریخ خرید -->
                            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="تاریخ خرید:" Width="150" VerticalAlignment="Center"/>
                                <xctk:MaskedTextBox x:Name="KHDATE" Mask="0000/00/00" Style="{StaticResource FuzzyOut}" Padding="3" Margin="0,16,203,0" TextWrapping="Wrap" VerticalAlignment="Top"  BorderThickness="1" FontSize="12" HorizontalAlignment="Right" Width="200"/>
                            </StackPanel>

                            <!-- قیمت خرید -->
                            <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="قیمت خرید:" Width="150" VerticalAlignment="Center"/>
                                <CNC:NumericTextBox x:Name="PRICE" DoesAcceptDouble="False" IsDigitGroupActive="True" DigitGroupOnEnter="True" ThreeTwoZero="True"
                                    Width="200" 
                                    TextAlignment="Left"/>
                            </StackPanel>

                            <!-- موقعیت مکانی -->
                            <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="موقعیت مکانی:" Width="150" VerticalAlignment="Center"/>
                                <ComboBox x:Name="PLACE" 
                                    Width="450"
                                    materialDesign:HintAssist.Hint="محل استقرار"
                                    Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                    IsEditable="True"/>
                            </StackPanel>

                            <!-- ارزش دفتری -->
                            <StackPanel Grid.Row="8" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="ارزش دفتری:" Width="150" VerticalAlignment="Center"/>
                                <CNC:NumericTextBox x:Name="ARZESH" 
                                    Width="200" 
                                    DoesAcceptDouble="False" IsDigitGroupActive="True" DigitGroupOnEnter="True" ThreeTwoZero="True"
                                    TextAlignment="Left"
                                    IsReadOnly="True"/>
                            </StackPanel>

                            <!-- وضعیت -->
                            <StackPanel Grid.Row="9" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="وضعیت:" Width="150" VerticalAlignment="Center"/>
                                <ComboBox x:Name="ASTATUS" 
                                    Width="200"
                                    materialDesign:HintAssist.Hint="انتخاب وضعیت"
                                    Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                    DisplayMemberPath="Value"
                                    SelectedValuePath="Key"/>
                            </StackPanel>

                            <!-- شرح -->
                            <StackPanel Grid.Row="10" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="شرح:" Width="150" VerticalAlignment="Top" Margin="0,10,0,0"/>
                                <TextBox x:Name="DESCRIPTION" 
                                    Width="504" 
                                    Height="80"
                                    materialDesign:HintAssist.Hint="توضیحات تکمیلی..."
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    TextWrapping="Wrap"
                                    AcceptsReturn="True"
                                    VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Background="#F5F5F5"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="0,1,0,0" Margin="5,0,7,4">
                    <Grid Margin="10,0">
                        <StackPanel FlowDirection="RightToLeft" Orientation="Horizontal" HorizontalAlignment="Right" Width="350">

                            <Button x:Name="BTN_SAVE" 
                                    Content="ذخیره"
                                    BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" 
                                    Margin="5,0"                                  
                                    Width="100"
                                    Click="BTN_SAVE_Click"/>

                            <Button x:Name="BTN_ESLAH" 
                                Content="اصلاح"
                                BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" 
                                Margin="5,0"
                                Width="100"
                                Click="ESLAH_Click"/>

                            <Button x:Name="BTN_DELETE" Tag="hazfer"
                                Content="حذف"
                                BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" 
                                Margin="5,0"
                                Width="100"
                                Click="BTN_DELETE_Click"/>
                        </StackPanel>

                        <CNC:RecordNavigatorControl x:Name="navigatorControl" 
                                        VerticalAlignment="Center" 
                                        HorizontalAlignment="Left"
                                        Margin="10,0"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>