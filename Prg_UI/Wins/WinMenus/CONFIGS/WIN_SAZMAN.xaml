<Window x:Class="Wins.WinMenus.CONFIGS.WIN_SAZMAN"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wins.WinMenus.CONFIGS"
        mc:Ignorable="d"
        
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:wpf="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        MaxHeight="{Binding Height, Source={x:Static SystemParameters.WorkArea}}"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="{StaticResource IRANYEKAN}"
        WindowStartupLocation="CenterScreen"
        Height="540" Width="800" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>


        <Style x:Key="CustomOutlinedPasswordBo2x" TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}">
            <!-- Retain all the original setters from MaterialDesignOutlinedPasswordBox -->
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="BorderBrush" Value="Blue"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Margin" Value="163,49,317,0"/>
        </Style>

    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="mygrid">
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="557,410,462,353"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label Content="مشخصات سیستم" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Click="Btn_Close_Click" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False">
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False">
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False">
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                                                       Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <!--HEADER↑-->

        <!--Start.......................................................................................-->
        <TabControl Margin="10,46,10,10">
            <TabItem Header="عمومی" IsSelected="True">
                <Grid>
                    <Label Content="متن بالای فاكتور:" FlowDirection="RightToLeft" HorizontalAlignment="Right" Margin="0,10,8,0" VerticalAlignment="Top" Width="auto"/>
                    <TextBox x:Name="WIDTH_D" Height="30" Margin="10,10,117,0" Style="{StaticResource FuzzyOut}" Padding="3"  TextWrapping="Wrap" VerticalAlignment="Top"  Visibility="Visible" MaxLength="200" FlowDirection="RightToLeft" />
                    <Label Content="متن پائين فاكتور:" FlowDirection="RightToLeft" HorizontalAlignment="Right" Margin="0,48,8,0" VerticalAlignment="Top" Width="auto"/>
                    <TextBox x:Name="HIGH_D" Height="30" Margin="10,48,117,0" Style="{StaticResource FuzzyOut}" Padding="3"  TextWrapping="Wrap" VerticalAlignment="Top"  Visibility="Visible" MaxLength="400" FlowDirection="RightToLeft" />
                    <Label Content="مسير فايل تصاوير:" FlowDirection="RightToLeft" HorizontalAlignment="Right" Margin="0,90,5,0" VerticalAlignment="Top" Width="auto"/>
                    <TextBox x:Name="BACKPATH" Height="30" Margin="10,88,117,0" Style="{StaticResource FuzzyOut}" Padding="3"  TextWrapping="Wrap" VerticalAlignment="Top" Visibility="Visible" MaxLength="50" FlowDirection="LeftToRight" />
                    <Grid Margin="10,131,10,185">
                        <InkCanvas x:Name="EMZA_CANVAS" Background="White" EditingMode="None">
                            <InkCanvas.DefaultDrawingAttributes>
                                <DrawingAttributes Color="Black"
                                                   Height="3" 
                                                   Width="3" 
                                                   FitToCurve="True"
                                                   IgnorePressure="False"/>
                            </InkCanvas.DefaultDrawingAttributes>
                        </InkCanvas>
                    </Grid>
                    <Button x:Name="BTN_UPIMAGE" Click="BTN_UPIMAGE_Click" Content="آپلود تصویر"  BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Height="34" Margin="10,0,0,139" HorizontalAlignment="Left" Width="100" VerticalAlignment="Bottom"  />
                    <Label Content="آدرس:" FlowDirection="RightToLeft" HorizontalAlignment="Right" Margin="0,0,10,140" VerticalAlignment="Bottom" Width="auto"/>
                    <Label Content="تلفن:" FlowDirection="RightToLeft" HorizontalAlignment="Right" Margin="0,0,13,102" VerticalAlignment="Bottom" Width="auto"/>
                    <Label Content="نام سرور:" FlowDirection="RightToLeft" HorizontalAlignment="Right" Margin="0,0,3,63" VerticalAlignment="Bottom" Width="auto"/>
                    <TextBox x:Name="TFADDRESS" Height="30" Margin="125,0,67,139" Style="{StaticResource FuzzyOut}" Padding="3"  TextWrapping="Wrap" VerticalAlignment="Bottom"  Visibility="Visible" MaxLength="150" FlowDirection="RightToLeft" />
                    <TextBox x:Name="TFTEL" Height="30" Margin="497,0,67,100" Style="{StaticResource FuzzyOut}" Padding="3"  TextWrapping="Wrap" VerticalAlignment="Bottom"  Visibility="Visible" MaxLength="60" FlowDirection="RightToLeft" />
                    <TextBox x:Name="SERVERNAM" Height="30" Margin="497,0,67,61" Style="{StaticResource FuzzyOut}" Padding="3"  TextWrapping="Wrap" VerticalAlignment="Bottom"  Visibility="Visible" MaxLength="50" FlowDirection="RightToLeft" TextAlignment="Right" />
                    <Button x:Name="BTN_MORE" Content="تنظيمات بيشتر"  BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Height="34" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="100" Click="BTN_MORE_Click" Margin="10,0,0,98" />
                    <TextBox x:Name="OPTIONSS" Height="30" Margin="125,0,0,100" Style="{StaticResource FuzzyOut}" Padding="3"  TextWrapping="Wrap" VerticalAlignment="Bottom"  Visibility="Visible" MaxLength="48" FlowDirection="RightToLeft" TextAlignment="Center" IsReadOnly="True" HorizontalAlignment="Left" Width="311" />
                    <Button x:Name="BTN_SAVE_G" Content="ذخیره"  BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Height="34" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="115" Click="BTN_SAVE_Click" Margin="0,0,8,10" />
                    <Button x:Name="BTN_ESLAH_G" Content="اصلاح"  BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Height="34" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="115" Click="BTN_ESLAH_Click" Margin="0,0,168,10" />

                </Grid>
            </TabItem>

            <!--<TabItem Header="اسناد و حساب">
                <Grid>
                    <Label Content="متن بالای فاكتور:" FlowDirection="RightToLeft" HorizontalAlignment="Right" Margin="0,10,8,0" VerticalAlignment="Top" Width="auto"/>
                    <TextBox Height="30" Margin="10,10,117,0" Style="{StaticResource FuzzyOut}" Padding="3"  TextWrapping="Wrap" VerticalAlignment="Top"  Visibility="Visible" MaxLength="200" FlowDirection="RightToLeft" />

                    <Button Content="ذخیره"  BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Height="34" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="115" Click="BTN_SAVE_Click" Margin="0,0,8,10" />
                    <Button Content="اصلاح"  BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Height="34" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="115" Click="BTN_ESLAH_Click" Margin="0,0,168,10" />
                </Grid>
            </TabItem>-->

            <TabItem Header="اسناد و حساب">
                <Grid>
                    <GroupBox Header="اشخاص مشخص شده  در حسابها" Style="{x:Null}" FlowDirection="RightToLeft" Margin="299,20,275,0" Height="91" VerticalAlignment="Top">
                        <UniformGrid Margin="5" Rows="2" Columns="1">
                            <RadioButton GroupName="HH" Content="نمايش داده شوند" IsChecked="True"/>
                            <RadioButton GroupName="HH" Content="نمايش داده نشوند"/>
                        </UniformGrid>
                    </GroupBox>

                    <CheckBox x:Name="SIGN" Content="گردش كاری و فرمها با امضاء عمل شود" Width="216" Height="20" Margin="0,23,10,0" Padding="4,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    <TextBlock FlowDirection="RightToLeft" HorizontalAlignment="Right" Margin="0,125,10,0" VerticalAlignment="Top" Width="144" TextWrapping="Wrap" Height="44" LineHeight="22"><Run Text="تعداد تاريخهاي قابل برگشت"/><LineBreak/><Run Text=" ومشاهده در فاكتور فروش:"/></TextBlock>
                    <CNC:NumericTextBox x:Name="CPI" Text="365" TextAlignment="Center" Margin="0,133,168,0" Height="28" VerticalAlignment="Top" HorizontalAlignment="Right" Width="58"/>

                    <Button Content="ذخیره"  BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Height="34" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="115" Click="BTN_SAVE_Click" Margin="0,0,8,10" />
                    <Button Content="اصلاح"  BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Height="34" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="115" Click="BTN_ESLAH_Click" Margin="0,0,143,10" />
                    <CheckBox x:Name="CTL_DT" Content="تاريخ فقط مربوط به همين سال باشد" Width="216" Height="20" Margin="0,52,10,0" Padding="4,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    <CheckBox x:Name="SNDKH" Content="سند ها روزانه باشد" Width="216" Height="20" Margin="0,80,10,0" Padding="4,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>

                    <GroupBox Header="سند زدن" Style="{x:Null}" FlowDirection="RightToLeft" Margin="34,20,0,0" Height="112" VerticalAlignment="Top" HorizontalAlignment="Left" Width="206">
                        <UniformGrid Margin="5" Rows="3" Columns="1">
                            <RadioButton GroupName="HH1" Content="در هر زمان اتوماتيک" IsChecked="True"/>
                            <RadioButton GroupName="HH1" Content="در زمان تائيد توسط حسابداری"/>
                            <RadioButton GroupName="HH1" Content="هيچكدام"/>
                        </UniformGrid>
                    </GroupBox>
                    <GroupBox Header="تخفیفات فاکتورها" Style="{x:Null}" FlowDirection="RightToLeft" Margin="0,136,275,0" Height="115" VerticalAlignment="Top" HorizontalAlignment="Right" Width="206">
                        <UniformGrid Margin="5" Rows="3" Columns="1">
                            <RadioButton GroupName="HH" Content="مصوب عمل شود"/>
                            <RadioButton GroupName="HH" Content="مبلغ كلی پشت فاكتور"/>
                            <RadioButton GroupName="HH" Content="به ريز كالا عمل شود" IsChecked="True"/>
                        </UniformGrid>
                    </GroupBox>
                    <TextBlock FlowDirection="RightToLeft" Margin="0,182,10,0" VerticalAlignment="Top" TextWrapping="Wrap" Height="22" LineHeight="22" Text="درصد ماليات بر ارزش افزوده:" HorizontalAlignment="Right" Width="144"/>
                    <CNC:NumericTextBox x:Name="ARSESH" Text="10" DoesAcceptDouble="True" TextAlignment="Center" Margin="0,179,168,0" Height="28" VerticalAlignment="Top" HorizontalAlignment="Right" Width="58"/>
                    <TextBlock FlowDirection="RightToLeft" Margin="0,283,257,0" VerticalAlignment="Top" TextWrapping="Wrap" Height="22" LineHeight="22" Text="فاصله از پائين كاغذ در چاپ سند :" HorizontalAlignment="Right" Width="174"/>
                    <CNC:NumericTextBox x:Name="TFTPAGE" Text="2.5" DoesAcceptDouble="True" TextAlignment="Center" Margin="0,280,435,0" Height="28" VerticalAlignment="Top" HorizontalAlignment="Right" Width="58"/>
                    <CheckBox x:Name="CTL_DT_Copy" Content="سقف اعتبار اشخاص بر اساس مانده  حساب  كنترل گردد" Width="306" Height="20" Margin="217,329,0,0" Padding="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <CheckBox x:Name="CTL_DT_Copy1" Content="سقف اعتبار اشخاص بر اساس مانده   اسناد   كنترل گردد" Width="306" Height="20" Margin="217,357,0,0" Padding="4,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                    <Label Content="دفتر اسناد دريافتنی" Margin="77,134,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                    <DataGrid 
                        d:ItemsSource="{d:SampleData}"
                        x:Name="DAFT_ASN_SUB" 
                        EnableColumnVirtualization="True"
                        EnableRowVirtualization="True"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.VirtualizationMode="Recycling"
                        SelectedIndex="0"
                        ColumnHeaderStyle="{StaticResource CenteryHeaderstyle}"
                        CellStyle="{StaticResource CellFocusyBorder}"
                        HorizontalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                        VerticalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                        ItemsSource="{Binding DAFT_ASN_DATA}"
                        KeyboardNavigation.TabNavigation="Contained"
                        AutoGenerateColumns="False"
                        SelectionUnit="FullRow" 
                        CanUserDeleteRows="False"
                        Margin="17,168,510,128" BorderThickness="1">
                        <DataGrid.Style>
                            <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource MaterialDesignDataGrid}">
                                <Setter Property="materialDesign:DataGridAssist.EnableEditBoxAssist" Value="False"/>
                                <Setter Property="GridLinesVisibility" Value="All"/>
                            </Style>
                        </DataGrid.Style>
                        <DataGrid.Columns >
                            <DataGridTextColumn x:Name="FIRSTNUM_COL" Header="شماره شروع" Binding="{Binding FIRSTNUM,UpdateSourceTrigger=LostFocus}" Width="auto" MinWidth="90">
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource MaterialDesignTextBox}">
                                        <Setter Property="MaxLength" Value="50" />
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn x:Name="BOOKNUM_COL" Header="شماره دفتر" Binding="{Binding BOOKNUM,UpdateSourceTrigger=LostFocus}" Width="auto" MinWidth="90">
                                <DataGridTextColumn.EditingElementStyle>
                                    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource MaterialDesignTextBox}">
                                        <Setter Property="MaxLength" Value="50" />
                                    </Style>
                                </DataGridTextColumn.EditingElementStyle>
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="SMS تنظیمات">
                <Grid>
                    <RadioButton x:Name="RB_TUBA"  GroupName="SMSGRP" Content="شرکت توبا TSMS.ir" HorizontalAlignment="Left" Margin="164,15,0,0" VerticalAlignment="Top" Width="128" Padding="4,0,0,0" IsChecked="True" Click="RB_TUBA_Click"/>
                    <RadioButton x:Name="RB_SMSIR" GroupName="SMSGRP" Content="شرکت ایده پردازان SMS.ir" HorizontalAlignment="Left" Margin="303,15,0,0" VerticalAlignment="Top" Width="160" Padding="4,0,0,0" Click="RB_SMSIR_Click"/>
                    <Button x:Name="BTN_SAVE" Content="ذخیره"  BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Margin="330,0,0,49" Height="34" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="148" Click="BTN_SAVE_Click" />
                    <Label Content="سرویس ارائه دهنده پیامک :" HorizontalAlignment="Left" Margin="6,11,0,0" VerticalAlignment="Top" Width="auto"/>
                    <TextBox x:Name="SMS_USERNAME" Text="" Height="30" Margin="162,53,318,0"  Style="{StaticResource FuzzyOut}" Padding="3"  TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible" MaxLength="48" FlowDirection="RightToLeft" />
                    <CNC:NumericTextBox x:Name="SMS_TSMSHOST" DoesAcceptDouble="False"  LastValueShouldZero="False" Text="" Height="30" Margin="162,136,0,0" VerticalAlignment="Top" Visibility="Visible"  HorizontalAlignment="Left" Width="214" FlowDirection="RightToLeft"/>
                    <Label Content="Username :" HorizontalAlignment="Left" Margin="89,53,0,0" VerticalAlignment="Top" Width="auto"/>
                    <Label Content="Password :" HorizontalAlignment="Left" Margin="90,94,0,0" VerticalAlignment="Top" Width="auto"/>
                    <PasswordBox x:Name="SMS_PASSWORD" Style="{StaticResource FuzzyOutPasswordBox}" Foreground="{Binding ElementName=GENERAL_RANG,Path=Background}" CommandManager.PreviewExecuted="SMS_PASSWORD_PreviewExecuted" Padding="3" Height="30" Margin="162,94,318,0" FlowDirection="LeftToRight" VerticalAlignment="Top"  />
                    <Label Content="Api Key :" HorizontalAlignment="Left" Margin="102,179,0,0" VerticalAlignment="Top" Width="auto"/>

                    <PasswordBox x:Name="SMS_LIBKEY" Style="{StaticResource FuzzyOutPasswordBox}" CommandManager.PreviewExecuted="SMS_PASSWORD_PreviewExecuted" Padding="3" Height="30" Margin="162,179,24,0" FlowDirection="LeftToRight" Foreground="{Binding ElementName=GENERAL_RANG,Path=Background}" IsEnabled="False" VerticalAlignment="Top" />

                    <Label Content="Line Number :" HorizontalAlignment="Left" Margin="74,136,0,0" VerticalAlignment="Top" Width="auto"/>

                    <CheckBox x:Name="PRMFR" Content="ارسال پيامك با تاييد كاربر باشد" Width="183" Height="20" Margin="0,80,85,0" Padding="4,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    <CheckBox x:Name="DSMS" Content="ارسال پيامك فقط از طريق سرور انجام  شود" Width="242" Height="24" Margin="0,44,26,0" Padding="4,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    <Label Content="عنوان پیامک :" HorizontalAlignment="Left" Margin="78,219,0,0" VerticalAlignment="Top" Width="auto"/>
                    <TextBox x:Name="SMS_OWNER" Style="{StaticResource FuzzyOut}" TextAlignment="Center" Padding="3" Height="30" Margin="164,220,358,0" VerticalAlignment="Top"  />
                    <CheckBox x:Name="SMSACT" Content="ارسال پيامك فعال باشد" Width="146" Height="19" Margin="0,15,122,0" Padding="4,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                    <Button x:Name="BTN_SMSFORMAT" Content="تعريف فرمت ارسال پيامك"  BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Margin="498,0,0,49" Height="34" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="160" Click="BTN_SMSFORMAT_Click" />
                    <Button x:Name="BTN_ESLAH" Content="اصلاح"  BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Margin="162,0,0,49" Height="34" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="143" Click="BTN_ESLAH_Click" />

                </Grid>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
