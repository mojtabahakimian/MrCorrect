<Window x:Class="Prg_UI.Wins.WinMenus.SANATI.WIN_HEAD_MANF_DAY"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.SANATI"
        mc:Ignorable="d"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="{StaticResource IRANYEKAN}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterScreen"
        Title="ایجاد فرمول ساخت" Height="768" Width="885" MinHeight="690" MinWidth="1105" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>

        <ContextMenu x:Key="ContextUtilityMenu2" IsEnabled="{Binding ElementName=DG_SUB,Path=IsEnabled}" FontSize="12" FontFamily="{StaticResource IRANYEKAN}">
        </ContextMenu>

    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="mygrid">
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="600,410,504,273"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label x:Name="LABEL_HEADER" Content="فرمول توليد محصول" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                                                    Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <!--HEADER↑-->
        <Grid Margin="5,40,5,5">
            <TextBox x:Name="PRGID" Text="0" Height="30" Margin="0,12,74,0" IsReadOnly="True" Style="{StaticResource FuzzyOut}" Padding="3" TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible"  HorizontalAlignment="Right" Width="90" Tag="RD" IsTabStop="False" />
            <xctk:MaskedTextBox x:Name="PRG_DATE" TabIndex="0"  Style="{StaticResource FuzzyOut}" Padding="3"  Mask="0000/00/00" Height="30" Margin="0,90,74,0" TextWrapping="Wrap" VerticalAlignment="Top"  BorderThickness="1" FontSize="12"  HorizontalAlignment="Right" Width="88" PreviewLostKeyboardFocus="DATE_N_PreviewLostKeyboardFocus" />
            <Label Content="شماره:" Margin="0,14,38,0"  FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="36" Height="26" VerticalAlignment="Top"/>
            <Label Content="تاریخ برگه:" Margin="0,91,21,0"  FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="52" Height="28" VerticalAlignment="Top"/>
            <Label Content="کالا:" Margin="0,54,49,0"  FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="24" Height="24" VerticalAlignment="Top"/>
            <Label Content="نرخ ساعت کار استاندارد:" FlowDirection="RightToLeft" Margin="0,14,349,683" FontSize="10" HorizontalAlignment="Right" Width="109"/>
            <Label Content="توضیحات:" Margin="0,14,757,0"  FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="51" Height="25" VerticalAlignment="Top"/>
            <ComboBox x:Name="PCODE" DisplayMemberPath="NAME" SelectedValuePath="CODE" IsSynchronizedWithCurrentItem="True" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Margin="0,51,74,0" VerticalAlignment="Top" Height="30" FlowDirection="RightToLeft" IsEditable="True" Background="{x:Null}" BorderThickness="1" PreviewLostKeyboardFocus="CODE_PreviewLostKeyboardFocus" TabIndex="1" HorizontalAlignment="Right" Width="481">
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
            </ComboBox>

            <TextBox x:Name="TOZIH" Text="" Height="114" Margin="10,13,813,0"    Style="{StaticResource FuzzyOut}" Padding="3"    TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible" MaxLength="250" TabIndex="3" AcceptsReturn="True" />
            <Button x:Name="CHAP_BTN" Click="CHAP_BTN_Click" Content="چاپ" Margin="0,51,657,0"  Style="{StaticResource GerdC}"  BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="10" Height="34" VerticalAlignment="Top" HorizontalAlignment="Right" Width="95" Foreground="#DDFFFFFF" FontWeight="Bold"/>


            <DataGrid   
                d:ItemsSource="{d:SampleData ItemCount=2}"
                x:Name="DG_SUB"
                EnableColumnVirtualization="True"
                EnableRowVirtualization="True"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                SelectedIndex="0"
                ColumnHeaderStyle="{StaticResource CenteryHeaderstyle}"
                CellStyle="{StaticResource CellFocusyBorder}"
                HorizontalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                VerticalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                ItemsSource="{Binding SUB_DATA}"
                ContextMenu="{StaticResource ContextUtilityMenu2}" 
                KeyboardNavigation.TabNavigation="Contained"
                AutoGenerateColumns="False" 
                FlowDirection="RightToLeft"
                IsReadOnly="True"
                SelectionUnit="FullRow" 
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                CanUserResizeColumns="True"
                CanUserDeleteRows="False" MouseRightButtonUp="DG_SUB_MouseRightButtonUp"
                Margin="6,140,7,138" BorderThickness="1" CellEditEnding="DG_SUB_CellEditEnding" PreviewMouseLeftButtonUp="DG_SUB_PreviewMouseLeftButtonUp" SelectionChanged="DG_SUB_SelectionChanged" RowEditEnding="DG_SUB_RowEditEnding" PreviewKeyDown="DG_SUB_PreviewKeyDown" PreparingCellForEdit="DG_SUB_PreparingCellForEdit" BeginningEdit="DG_SUB_BeginningEdit" >
                <DataGrid.Style>
                    <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource MaterialDesignDataGrid}">
                        <Setter Property="materialDesign:DataGridAssist.EnableEditBoxAssist" Value="False"/>
                        <Setter Property="GridLinesVisibility" Value="All"/>
                    </Style>
                </DataGrid.Style>

                <DataGrid.Columns>
                    <!--<DataGridComboBoxColumn x:Name="ANBAR_COLUMN" Header="انبار" MinWidth="120" Width="auto" SelectedValueBinding="{Binding ANBAR, UpdateSourceTrigger=LostFocus}" DisplayMemberPath="NAMES" SelectedValuePath="CODE">
                        <DataGridComboBoxColumn.EditingElementStyle>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignComboBox}">
                                <Setter Property="IsEditable" Value="True"/>
                                <Setter Property="ItemsPanel" Value="{StaticResource VSP}"/>
                            </Style>
                        </DataGridComboBoxColumn.EditingElementStyle>
                        <DataGridComboBoxColumn.ElementStyle>
                            <Style TargetType="{x:Type ComboBox}">
                            </Style>
                        </DataGridComboBoxColumn.ElementStyle>
                    </DataGridComboBoxColumn>-->

                    <!-- ستون ماده اولیه: اصلی‌ترین ستون است و بیشترین فضا را به خود اختصاص می‌دهد. -->
                    <DataGridTextColumn x:Name="NAME_CODE_COLUMN" Header="ماده اولیه / نام کالا" MinWidth="250" Width="3*" Binding="{Binding NAME, UpdateSourceTrigger=LostFocus}"/>

                    <!-- ستون واحد کالا: اندازه خودکار بهترین گزینه است چون محتوای کوتاهی دارد. -->
                    <DataGridComboBoxColumn x:Name="VAHED_K_COLUMN" Header="واحد" MinWidth="110" Width="Auto" SelectedValueBinding="{Binding VAHED, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="NAMES" SelectedValuePath="VAHED">
                        <DataGridComboBoxColumn.EditingElementStyle>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignComboBox}">
                                <Setter Property="IsEditable" Value="True"/>
                                <Setter Property="ItemsPanel" Value="{StaticResource VSP}"/>
                            </Style>
                        </DataGridComboBoxColumn.EditingElementStyle>
                        <DataGridComboBoxColumn.ElementStyle>
                            <Style TargetType="{x:Type ComboBox}">
                            </Style>
                        </DataGridComboBoxColumn.ElementStyle>
                    </DataGridComboBoxColumn>

                    <!-- ستون‌های عددی: با اندازه ستاره‌ای، فضای باقیمانده را به نسبت مساوی تقسیم می‌کنند که ظاهری متعادل ایجاد می‌کند. -->
                    <DataGridTextColumn x:Name="MEGH_COLUMN" Header="مقدار مواد" MinWidth="100" Width="auto" Binding="{Binding MEGH, UpdateSourceTrigger=LostFocus, StringFormat=G}"/>

                    <DataGridTextColumn x:Name="MEGHK_COLUMN" Header="مقدار کل مواد" MinWidth="120" Width="auto" Binding="{Binding MEGHK, UpdateSourceTrigger=LostFocus, StringFormat=G}"/>

                    <DataGridTextColumn Header="پرت" MinWidth="90" Width="auto" Binding="{Binding PERT, UpdateSourceTrigger=LostFocus, StringFormat=G}"/>
                    <!-- ستون‌های مبلغ: کمی فضای بیشتری می‌گیرند تا اعداد بزرگ و جداکننده هزارگان به خوبی نمایش داده شوند. -->
                    <DataGridTextColumn Header="مبلغ" MinWidth="120" Width="1.1*" Binding="{Binding SumOfMABL, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N0}}"/>

                    <DataGridTextColumn Header="مبلغ کل" MinWidth="130" Width="1.2*" Binding="{Binding SumOfMABLK, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N0}}"/>

                </DataGrid.Columns>

            </DataGrid>

            <TextBox x:Name="TAH" Visibility="Hidden" Height="27" Margin="10,209,0,0" Style="{StaticResource FuzzyOut}" TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  HorizontalAlignment="Left" Width="159"  Padding="3" />
            <CNC:NumericTextBox x:Name="SA_HOUR" RestoreLastValidValue="False"  MaxLength="12" Text="0" Height="30" Margin="0,12,248,0" VerticalAlignment="Top" Visibility="Visible" HorizontalAlignment="Right" Width="95" DoesAcceptDouble="False" IsDigitGroupActive="True" DigitGroupOnEnter="True"/>
            <Label Content="جذب ساعت کار:" Margin="0,14,170,0"  FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="76" Height="26" VerticalAlignment="Top"/>
            <CNC:NumericTextBox x:Name="SA_NHOU" RestoreLastValidValue="False" MaxLength="12" Text="0" Height="30" Margin="0,12,460,0" VerticalAlignment="Top" Visibility="Visible" HorizontalAlignment="Right" Width="95" DoesAcceptDouble="False" IsDigitGroupActive="True" DigitGroupOnEnter="True"/>
            <CNC:NumericTextBox x:Name="IMBIBE_MANF" RestoreLastValidValue="False"  MaxLength="12" Text="0" Height="30" Margin="0,12,657,0" VerticalAlignment="Top" Visibility="Visible" HorizontalAlignment="Right" Width="95" DoesAcceptDouble="False" IsDigitGroupActive="True" DigitGroupOnEnter="True"/>
            <Label Content="جذب هزينه دستمزد:" Margin="0,14,560,0"  FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="94" Height="26" VerticalAlignment="Top"/>
            <Label Content="جذب هزینه سربار:" FlowDirection="RightToLeft" Margin="682,92,329,605" FontSize="10"/>
            <CNC:NumericTextBox x:Name="IMBIBE_SAR" RestoreLastValidValue="False"  MaxLength="12" Text="0" Height="30" Margin="0,90,414,0" VerticalAlignment="Top" Visibility="Visible" HorizontalAlignment="Right" Width="141" DoesAcceptDouble="False" IsDigitGroupActive="True" DigitGroupOnEnter="True"/>
            <Label Content="جمع مواد اولیه مصرفی:" Margin="0,0,227,99"  FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="105" Height="26" VerticalAlignment="Bottom"/>
            <CNC:NumericTextBox x:Name="SUM_TAMAMSHODEH" IsDigitGroupActive="True" DigitGroupOnEnter="True"  RestoreLastValidValue="False"  MaxLength="12" Text="0" Height="36" Margin="0,0,629,94" VerticalAlignment="Bottom" Visibility="Visible" FontSize="16" HorizontalAlignment="Right" Width="241" IsReadOnly="True"/>
            <CNC:NumericTextBox x:Name="SUM_AVALIEH" DoesAcceptDouble="True" IsDigitGroupActive="True" DigitGroupOnEnter="True" RestoreLastValidValue="False"  MaxLength="12" Text="0" Height="30" Margin="0,0,333,97" VerticalAlignment="Bottom" Visibility="Visible" HorizontalAlignment="Right" Width="170" MaxDecimalPlaces="4" IsReadOnly="True"/>
            <Label Content="قیمت تمام شده استاندارد:" Margin="0,0,509,99"  FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="119" Height="26" VerticalAlignment="Bottom"/>
        </Grid>

        <CNC:RecordNavigatorControl x:Name="navigatorControl" Visibility="Hidden" VerticalAlignment="Bottom" Margin="10,0,10,18"/>
    </Grid>
</Window>