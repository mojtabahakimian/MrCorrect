<Window x:Class="Prg_UI.Wins.WinMenus.SANATI.WIN_HEAD_MANF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.SANATI"
        mc:Ignorable="d"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="{StaticResource IRANYEKAN}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterScreen"
        Title="ایجاد فرمول ساخت" Height="768" Width="885" MinHeight="690" MinWidth="1105" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>

        <ContextMenu x:Key="ContextUtilityMenu2" IsEnabled="{Binding ElementName=DG_SUB,Path=IsEnabled}" FontSize="12" FontFamily="{StaticResource IRANYEKAN}">
            <MenuItem Header="کارت انبار این کالا"  Click="MenuItem_Click_1">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="Warehouse" />
                </MenuItem.Icon>
            </MenuItem>

            <MenuItem Header="کپـــی | Copy" Click="COPY_CLICK" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="ContentCopy" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="انتقال کپی | Paste" Click="PASTE_CLICK" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="ContentPaste" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="خروجی اکسل" Click="EXPORTEXCEL_BTN" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FileExcelOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="mygrid">
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="600,410,504,273"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label x:Name="LABEL_HEADER" Content="ایجاد فرمول ساخت" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                                                    Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <!--HEADER↑-->
        <Grid Margin="5,40,5,5">
            <TextBox x:Name="FNUMB" Text="0" Height="30" Margin="0,12,74,0" IsReadOnly="True" IsHitTestVisible="False" Style="{StaticResource FuzzyOut}" Padding="3" TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible"  HorizontalAlignment="Right" Width="90" Tag="RD" IsTabStop="False" />
            <xctk:MaskedTextBox x:Name="DATE_ACTIV" TabIndex="0" Style="{StaticResource FuzzyOut}" Padding="3"  Mask="0000/00/00" Height="30" Margin="0,90,74,0" TextWrapping="Wrap" VerticalAlignment="Top"  BorderThickness="1" FontSize="12"  HorizontalAlignment="Right" Width="88" PreviewLostKeyboardFocus="DATE_N_PreviewLostKeyboardFocus" />
            <Label Content="شماره فرمول:" Margin="0,14,12,0"  FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="62" Height="26" VerticalAlignment="Top"/>
            <Label Content="تاریخ برگه:" Margin="0,91,21,0"  FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="52" Height="28" VerticalAlignment="Top"/>
            <Label Content="کالا:" Margin="0,54,49,0"  FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="24" Height="24" VerticalAlignment="Top"/>
            <Label Content="نرخ ساعت کار استاندارد:" FlowDirection="RightToLeft" Margin="0,14,349,683" FontSize="10" HorizontalAlignment="Right" Width="109"/>
            <Label Content="توضیحات:" Margin="0,14,757,0"  FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="51" Height="25" VerticalAlignment="Top"/>
            <ComboBox x:Name="CODE" DisplayMemberPath="NAME" SelectedValuePath="CODE" IsSynchronizedWithCurrentItem="True" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Margin="0,51,74,0" VerticalAlignment="Top" Height="30" FlowDirection="RightToLeft" IsEditable="True" Background="{x:Null}" BorderThickness="1" PreviewLostKeyboardFocus="CODE_PreviewLostKeyboardFocus" TabIndex="1" HorizontalAlignment="Right" Width="461">
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
            </ComboBox>

            <TextBox x:Name="TOZIH" Text="" Height="114" Margin="10,13,813,0"    Style="{StaticResource FuzzyOut}" Padding="3"    TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible" MaxLength="250" TabIndex="3" AcceptsReturn="True" />
            <Button x:Name="ESLAH" Content="اصلاح برگه" Margin="0,135,139,0"  Style="{StaticResource GerdC}"  BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="10" Height="35" VerticalAlignment="Top" HorizontalAlignment="Right" Width="92" Foreground="#DDFFFFFF" FontWeight="Bold" Click="ESLAH_Click"/>

            <UniformGrid Rows="2" Columns="2" Margin="0,45,547,0" MinWidth="260" HorizontalAlignment="Right" Width="261" Height="85" VerticalAlignment="Top">
                <Button Style="{StaticResource MaterialDesignOutlinedSecondaryButton}" materialDesign:ButtonAssist.CornerRadius="15" Content="چاپ فرمول" FontSize="10" Margin="5" Click="Button_Click_3"/>
                <Button Style="{StaticResource MaterialDesignOutlinedSecondaryButton}" materialDesign:ButtonAssist.CornerRadius="15" Content="قيمت تمام شده روز" FontSize="10" Margin="5" Click="Button_Click_1"/>
                <Button Style="{StaticResource MaterialDesignOutlinedSecondaryButton}" materialDesign:ButtonAssist.CornerRadius="15" Content="چاپ فرمول 2" FontSize="10" Margin="5" Click="Button_Click_2"/>
                <Button Style="{StaticResource MaterialDesignOutlinedSecondaryButton}" materialDesign:ButtonAssist.CornerRadius="15" Content="ليست فرمولها و مواد" FontSize="10" Margin="5" Click="Button_Click"/>
            </UniformGrid>

            <DataGrid   
                d:ItemsSource="{d:SampleData ItemCount=2}"
                x:Name="DG_SUB"
                EnableColumnVirtualization="True"
                EnableRowVirtualization="True"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                SelectedIndex="0"
                ColumnHeaderStyle="{StaticResource CenteryHeaderstyle}"
                CellStyle="{StaticResource CellFocusyBorder}"
                HorizontalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                VerticalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                ItemsSource="{Binding SUB_DATA}"
                ContextMenu="{StaticResource ContextUtilityMenu2}" 
                KeyboardNavigation.TabNavigation="Contained"
                AutoGenerateColumns="False" 
                FlowDirection="RightToLeft" 
                SelectionUnit="FullRow" 
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                CanUserResizeColumns="True" ContextMenuOpening="DG_SUB_ContextMenuOpening" PreviewMouseRightButtonDown="DataGrid_PreviewMouseRightButtonDown"
                CanUserDeleteRows="False" MouseRightButtonUp="DG_SUB_MouseRightButtonUp"
                Margin="4,180,4,138" BorderThickness="1" CellEditEnding="DG_SUB_CellEditEnding" PreviewMouseLeftButtonUp="DG_SUB_PreviewMouseLeftButtonUp" SelectionChanged="DG_SUB_SelectionChanged" RowEditEnding="DG_SUB_RowEditEnding" PreviewKeyDown="DG_SUB_PreviewKeyDown" PreparingCellForEdit="DG_SUB_PreparingCellForEdit" BeginningEdit="DG_SUB_BeginningEdit" IsReadOnly="True" >
                <DataGrid.Style>
                    <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource MaterialDesignDataGrid}">
                        <Setter Property="materialDesign:DataGridAssist.EnableEditBoxAssist" Value="False"/>
                        <Setter Property="GridLinesVisibility" Value="All"/>
                    </Style>
                </DataGrid.Style>

                <DataGrid.Columns>
                    <DataGridComboBoxColumn x:Name="ANBAR_COLUMN" Header="انبار" MinWidth="160" Width="auto" SelectedValueBinding="{Binding ANBAR, UpdateSourceTrigger=LostFocus}" DisplayMemberPath="NAMES" SelectedValuePath="CODE">
                        <DataGridComboBoxColumn.EditingElementStyle>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignComboBox}">
                                <Setter Property="IsEditable" Value="True"/>
                                <Setter Property="ItemsPanel" Value="{StaticResource VSP}"/>
                            </Style>
                        </DataGridComboBoxColumn.EditingElementStyle>
                        <DataGridComboBoxColumn.ElementStyle>
                            <Style TargetType="{x:Type ComboBox}">
                            </Style>
                        </DataGridComboBoxColumn.ElementStyle>
                    </DataGridComboBoxColumn>
                    <DataGridTextColumn Header="کد کالا" Width="80" MinWidth="80" Binding="{Binding CODE}" IsReadOnly="True">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="KeyboardNavigation.IsTabStop" Value="False"/>
                                <Setter Property="IsTabStop"  Value="False"/>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <!-- ستون ماده اولیه: اصلی‌ترین ستون است و بیشترین فضا را به خود اختصاص می‌دهد. -->
                    <DataGridTextColumn x:Name="NAME_CODE_COLUMN" Header="ماده اولیه / نام کالا" MinWidth="250" Width="Auto" Binding="{Binding NAME_CODE, UpdateSourceTrigger=LostFocus}"/>

                    <!-- ستون واحد کالا: اندازه خودکار بهترین گزینه است چون محتوای کوتاهی دارد. -->
                    <DataGridComboBoxColumn x:Name="VAHED_K_COLUMN" Header="واحد" MinWidth="120" Width="Auto" SelectedValueBinding="{Binding VAHED_K, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="NAMES" SelectedValuePath="VAHED">
                        <DataGridComboBoxColumn.EditingElementStyle>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignComboBox}">
                                <Setter Property="IsEditable" Value="True"/>
                                <Setter Property="ItemsPanel" Value="{StaticResource VSP}"/>
                            </Style>
                        </DataGridComboBoxColumn.EditingElementStyle>
                        <DataGridComboBoxColumn.ElementStyle>
                            <Style TargetType="{x:Type ComboBox}">
                            </Style>
                        </DataGridComboBoxColumn.ElementStyle>
                    </DataGridComboBoxColumn>

                    <!-- ستون‌های عددی: با اندازه ستاره‌ای، فضای باقیمانده را به نسبت مساوی تقسیم می‌کنند که ظاهری متعادل ایجاد می‌کند. -->
                    <DataGridTextColumn x:Name="MEGH_COLUMN" Header="مقدار مواد" MinWidth="100" Width="Auto" Binding="{Binding MEGH, UpdateSourceTrigger=LostFocus, StringFormat=G}"/>

                    <DataGridTextColumn x:Name="MEGHK_COLUMN" Header="مقدار کل" MinWidth="100" Width="Auto" Binding="{Binding MEGHk, UpdateSourceTrigger=LostFocus, StringFormat=G}"/>
                    
                    <DataGridTextColumn Header="پرت" MinWidth="70" Width="Auto" Binding="{Binding PERT, UpdateSourceTrigger=LostFocus, StringFormat=G}"/>
                    <!-- ستون‌های مبلغ: کمی فضای بیشتری می‌گیرند تا اعداد بزرگ و جداکننده هزارگان به خوبی نمایش داده شوند. -->
                    <DataGridTextColumn Header="مبلغ استاندارد" MinWidth="130" Width="Auto" Binding="{Binding SMABL, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N0}}"/>

                    <DataGridTextColumn Header="مبلغ کل" MinWidth="140" Width="Auto" Binding="{Binding MABLK, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N0}}"/>

                </DataGrid.Columns>

            </DataGrid>

            <TextBox x:Name="TAH" Visibility="Hidden" Height="27" Margin="10,209,0,0" Style="{StaticResource FuzzyOut}" TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  HorizontalAlignment="Left" Width="159"  Padding="3" />

            <Button x:Name="BTN_DELETE" Content="حذف" Tag="hazfer" BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Margin="6,135,0,0" Height="35" VerticalAlignment="Top" HorizontalAlignment="Left" Width="94" Click="BTN_DELETE_Click" />

            <Button x:Name="BTN_SAVE" Click="BTN_SAVE_Click" Content="ذخیره" BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="10" Foreground="#DDFFFFFF" Height="35" Margin="0,135,6,0" VerticalAlignment="Top" TabIndex="4" HorizontalAlignment="Right" Width="115" />

            <Button x:Name="BTN_FACTORHA" Content="لیست فرمول ساخت ها" Margin="121,135,0,0"  Style="{StaticResource GerdC}"  BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="10" Height="35" VerticalAlignment="Top" HorizontalAlignment="Left" Width="161" Foreground="#DDFFFFFF" FontWeight="Bold" Click="BTN_FACTORHA_Click"/>
            <CNC:NumericTextBox x:Name="SA_HOUR" NumericLostFocus="SA_HOUR_NumericLostFocus" RestoreLastValidValue="True"  MaxLength="12" Text="0" Height="30" Margin="0,12,248,0" VerticalAlignment="Top" Visibility="Visible" HorizontalAlignment="Right" Width="95" DoesAcceptDouble="False" IsDigitGroupActive="True" DigitGroupOnEnter="True"/>
            <Label Content="جذب ساعت کار:" Margin="0,14,170,0"  FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="76" Height="26" VerticalAlignment="Top"/>
            <ComboBox x:Name="GHEYMAT" DisplayMemberPath="NAME" SelectedValuePath="ID" IsSynchronizedWithCurrentItem="True" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Margin="0,91,191,0" VerticalAlignment="Top" Height="30" FlowDirection="RightToLeft" IsEditable="True" Background="{x:Null}" BorderThickness="1" PreviewLostKeyboardFocus="CODE_PreviewLostKeyboardFocus" TabIndex="1" HorizontalAlignment="Right" Width="116">
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
            </ComboBox>
            <Label Content="ماه:" Margin="0,93,167,0"  FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="24" Height="24" VerticalAlignment="Top"/>
            <CNC:NumericTextBox x:Name="SA_NHOU" NumericLostFocus="SA_NHOU_NumericLostFocus" MaxLength="12" Text="0" Height="30" Margin="0,12,460,0" VerticalAlignment="Top" Visibility="Visible" HorizontalAlignment="Right" Width="95" DoesAcceptDouble="False" IsDigitGroupActive="True" DigitGroupOnEnter="True"/>
            <CNC:NumericTextBox x:Name="IMBIBE_MANF"  MaxLength="12" Text="0" Height="30" Margin="0,12,657,0" VerticalAlignment="Top" Visibility="Visible" HorizontalAlignment="Right" Width="95" DoesAcceptDouble="False" IsDigitGroupActive="True" DigitGroupOnEnter="True"/>
            <Label Content="جذب هزينه دستمزد:" Margin="0,14,560,0"  FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="94" Height="26" VerticalAlignment="Top"/>
            <Label Content="جذب هزینه سربار:" FlowDirection="RightToLeft" Margin="702,92,309,605" FontSize="10"/>
            <CNC:NumericTextBox x:Name="IMBIBE_SAR"  MaxLength="12" Text="0" Height="30" Margin="0,91,394,0" VerticalAlignment="Top" Visibility="Visible" HorizontalAlignment="Right" Width="141" DoesAcceptDouble="False" IsDigitGroupActive="True" DigitGroupOnEnter="True"/>
            <Label Content="جمع مواد اولیه مصرفی:" Margin="0,0,227,99"  FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="105" Height="26" VerticalAlignment="Bottom"/>
            <CNC:NumericTextBox x:Name="SUM_TAMAMSHODEH" IsDigitGroupActive="True" DigitGroupOnEnter="True"  RestoreLastValidValue="False"  MaxLength="12" Text="0" Height="36" Margin="0,0,629,94" VerticalAlignment="Bottom" Visibility="Visible" FontSize="16" HorizontalAlignment="Right" Width="241" IsReadOnly="True"/>
            <CNC:NumericTextBox x:Name="SUM_AVALIEH" DoesAcceptDouble="True" IsDigitGroupActive="True" DigitGroupOnEnter="True" RestoreLastValidValue="False"  MaxLength="12" Text="0" Height="30" Margin="0,0,333,97" VerticalAlignment="Bottom" Visibility="Visible" HorizontalAlignment="Right" Width="170" MaxDecimalPlaces="4" IsReadOnly="True"/>
            <Label Content="قیمت تمام شده استاندارد:" Margin="0,0,509,99"  FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="119" Height="26" VerticalAlignment="Bottom"/>
        </Grid>
        <!--<CheckBox x:Name="SGN1" IsChecked="False" Content="مدیر واحد"  Margin="0,0,22,100" HorizontalAlignment="Right" Width="78" VerticalAlignment="Bottom" Tag="RD"  Click="SGN1_Click" Visibility="Collapsed" />
        <CheckBox x:Name="SGN2" IsChecked="False" Content="انبار"  Margin="0,0,22,68" HorizontalAlignment="Right" Width="78" VerticalAlignment="Bottom" Tag="RD" Click="SGN2_Click" Visibility="Collapsed"/>
        <CheckBox x:Name="SGN3" IsChecked="False" Content="حسابداری"  Margin="0,0,26,35" HorizontalAlignment="Right" Width="74" VerticalAlignment="Bottom" Tag="RD"  Click="SGN3_Click" Visibility="Collapsed" />-->
        <!--<ComboBox x:Name="PERSONEL" Tag="RD"
         Style="{StaticResource FuzzyOutComboBox}" Padding="7,0,10,0" IsTextSearchEnabled="True" Margin="0,0,371,96" VerticalAlignment="Bottom" Height="30" FlowDirection="RightToLeft" IsEditable="True" HorizontalAlignment="Right" Width="311" SelectionChanged="PERSONEL_SelectionChanged" Visibility="Collapsed">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>-->
        <!--<Label Content="ارجاع به:" HorizontalAlignment="Right" Margin="0,0,316,96" VerticalAlignment="Bottom" FlowDirection="RightToLeft" Width="auto" Visibility="Collapsed"/>
        <TextBox x:Name="SGN1usid"   Style="{StaticResource FuzzyOut}" Padding="3"  Margin="0,0,102,97" VerticalAlignment="Bottom" Height="28" FlowDirection="RightToLeft" HorizontalAlignment="Right" Width="202" IsReadOnly="True" Visibility="Collapsed"/>
        <TextBox x:Name="SGN2usid"   Style="{StaticResource FuzzyOut}" Padding="3"  Margin="0,0,102,64" VerticalAlignment="Bottom" Height="28" FlowDirection="RightToLeft" HorizontalAlignment="Right" Width="202" IsReadOnly="True" Visibility="Collapsed"/>
        <TextBox x:Name="SGN3usid"   Style="{StaticResource FuzzyOut}" Padding="3"  Margin="0,0,102,31" VerticalAlignment="Bottom" Height="28" FlowDirection="RightToLeft"  HorizontalAlignment="Right" Width="202" IsReadOnly="True" Visibility="Collapsed"/>-->

        <CNC:RecordNavigatorControl x:Name="navigatorControl" VerticalAlignment="Bottom" Margin="10,0,10,18"/>
    </Grid>
</Window>