<Window x:Class="Wins.WinMenus.HESABDARI.GOZARESHAT.F_MENU_KOL_MOIN_DATE_AI"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wins.WinMenus.HESABDARI.GOZARESHAT"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="IRANYekanFN"
        WindowStartupLocation="CenterScreen"
        Title="F_MENU_KART" Height="383" Width="908" MinHeight="230" MinWidth="510" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown" >
    <Grid>
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="557,410,462,353"  Width="1"/>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True" Grid.RowSpan="2">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                     Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10">
                <Grid>
                    <Label Content="دفتر معین" Padding="21,10,10,10" Foreground="White"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowRestore" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>

                </Grid>
            </Border>
        </Border>



        <Button x:Name="Command5" Width="81" VerticalAlignment="Top" TabIndex="7" Margin="0,326,0,0" Height="37" HorizontalAlignment="Center" FontSize="12" Foreground="#DDFFFFFF" Content="تایید" Click="Commnd5_Click"/>
        <Label VerticalAlignment="Top" Margin="646,73,0,0" FlowDirection="RightToLeft" Content=" از حساب :" HorizontalAlignment="Left" Width="70"/>
        <ComboBox x:Name="Combo34"    FlowDirection="RightToLeft"
            Style="{StaticResource FuzzyOutComboBox}"  
            IsEditable="True"
            IsSynchronizedWithCurrentItem="True"
            Margin="345,74,0,0" Padding="7,0,10,0" Height="30"  TabIndex="1" VerticalAlignment="Top"  IsTabStop="True" HorizontalAlignment="Left" Width="298" PreviewLostKeyboardFocus="Combo34_PreviewLostKeyboardFocus" >
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <ComboBox x:Name="Combo36"    FlowDirection="RightToLeft"
            Style="{StaticResource FuzzyOutComboBox}"  
            IsEditable="True"
            IsSynchronizedWithCurrentItem="True"
            Margin="183,75,0,0" Padding="7,0,10,0" Height="30"  TabIndex="2" VerticalAlignment="Top"  IsTabStop="True" HorizontalAlignment="Left" Width="158" PreviewLostKeyboardFocus="Combo36_PreviewLostKeyboardFocus">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>


        <StackPanel x:Name="BEDBES" Margin="370,180,0,0" Orientation="Horizontal" Height="35" VerticalAlignment="Top" HorizontalAlignment="Left" Width="144">


            <RadioButton x:Name="RB2" Content="بستانکار" GroupName="Second" FlowDirection="RightToLeft"  Margin="0,0,0,0" />
            <RadioButton x:Name="RB1" Content="بدهکار" GroupName="Second" IsChecked="True" FlowDirection="RightToLeft" Margin="20,0,0,0" />

        </StackPanel>
        <Label VerticalAlignment="Top" Margin="646,129,0,0" FlowDirection="RightToLeft" Content=" تا حساب :" HorizontalAlignment="Left" Width="70"/>
        <ComboBox x:Name="Combo39"    FlowDirection="RightToLeft"
            Style="{StaticResource FuzzyOutComboBox}"  
            IsEditable="True"
            IsSynchronizedWithCurrentItem="True"
            Margin="344,130,0,0" Padding="7,0,10,0" Height="30"  TabIndex="1" VerticalAlignment="Top"  IsTabStop="True" HorizontalAlignment="Left" Width="299" PreviewLostKeyboardFocus="Combo39_PreviewLostKeyboardFocus" >
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <ComboBox x:Name="Combo41"    FlowDirection="RightToLeft"
            Style="{StaticResource FuzzyOutComboBox}"  
            IsEditable="True"
            IsSynchronizedWithCurrentItem="True"
            Margin="183,131,0,0" Padding="7,0,10,0" Height="30"  TabIndex="2" VerticalAlignment="Top"  IsTabStop="True" HorizontalAlignment="Left" Width="158" PreviewLostKeyboardFocus="Combo41_PreviewLostKeyboardFocus">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <Label VerticalAlignment="Top" Margin="808,242,0,0" FlowDirection="RightToLeft" Content=" مسیر ویزیت :" HorizontalAlignment="Left" Width="81"/>
        
        <ComboBox x:Name="visit" FlowDirection="RightToLeft" Style="{StaticResource FuzzyOutComboBox}" IsEditable="True"
            Margin="41,243,0,0" Padding="7,0,10,0" Height="30"  TabIndex="1" VerticalAlignment="Top"  IsTabStop="True" HorizontalAlignment="Left" Width="764" >
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding hes}" TextAlignment="Justify" Width="100" Margin="3" />
                        <TextBlock Text="{Binding Expr1}"  TextAlignment="Justify" Width="400" Margin="3" />
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

    </Grid>
</Window>
