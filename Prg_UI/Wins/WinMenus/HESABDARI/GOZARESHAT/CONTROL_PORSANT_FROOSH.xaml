<Window x:Class="Prg_UI.Wins.WinMenus.HESABDARI.GOZARESHAT.CONTROL_PORSANT_FROOSH"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.HESABDARI.GOZARESHAT"
        mc:Ignorable="d"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Height="640" Width="1150"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MinHeight="400" MinWidth="700"
        FontFamily="{StaticResource IRANYEKAN}"
        Background="{x:Null}"
        AllowsTransparency="True" AllowDrop="True"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="15"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>

        <Style x:Key="KDG" TargetType="syncfusion:SfDataGrid" BasedOn="{StaticResource SfDataGridStyle}">
            <Setter Property="CurrentCellBorderBrush" Value="{StaticResource GENERAL_Grlicom}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="BorderBrush" Value="{StaticResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="HeaderRowHeight" Value="40" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="GridLinesVisibility" Value="Both" />
        </Style>
        <Style x:Key="KDGHeader" TargetType="syncfusion:GridHeaderCellControl" BasedOn="{StaticResource GridHeaderCellControlStyle}">
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="BorderBrush" Value="{Binding Background, ElementName=GENERAL_RANG}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="Auto"/>
        </Style>
        <Style TargetType="syncfusion:GridCell" BasedOn="{StaticResource GridCellStyle}">
            <Setter Property="BorderBrush" Value="{Binding BorderBrush, ElementName=GENERAL_RANG}" />
        </Style>
    </Window.Resources>

    <Grid x:Name="mygrid" Margin="8,8,8,0">
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Width="1" Height="1"/>

        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding ElementName=GENERAL_RANG, Path=Background}" BorderThickness="1" CornerRadius="10" Padding="8">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding ElementName=GENERAL_RANG, Path=Background}" CornerRadius="10,10,0,0" Margin="-9,-9,-9,0" Height="38" VerticalAlignment="Top" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label Content="کنترل پورسانت فاکتور فروش" Padding="17,8,10,10" Foreground="White" Margin="0,0,110,0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0">
                        <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0,0,0,-1" IsTabStop="False" ToolTip="کوچک کردن">
                            <materialDesign:PackIcon Kind="WindowMinimize" Width="18" Height="18" Foreground="White"/>
                        </Button>
                        <Button x:Name="Btn_Max" Click="Btn_Max_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" FontSize="12" Height="24" Padding="0" Margin="4,0,0,0" IsTabStop="False" ToolTip="بزرگ کردن">
                            <materialDesign:PackIcon Kind="WindowMaximize" Width="17" Height="17" Foreground="White"/>
                        </Button>
                        <Button x:Name="Btn_Close" Click="Btn_Close_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0" Margin="4,0,0,0" FontSize="12" IsTabStop="False" ToolTip="بستن">
                            <materialDesign:PackIcon Kind="WindowClose" Width="19" Height="19" Foreground="White"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <!-- Content -->
        <Grid Margin="0,38,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- توضیح کوتاه -->
            <TextBlock Grid.Row="0" Margin="10,10,10,4" TextWrapping="Wrap" Foreground="{StaticResource MaterialDesignBody}"
                       FlowDirection="RightToLeft"
                       Text="این فهرست فاکتورهای فروشی است که مبلغ پورسانتِ ثبت‌شده‌ی آنها با درصد/الگوی تعریف‌شده نمی‌خواند. ستون «وضعیت فعلی» یعنی همین حالا در دیتابیس چه چیزی ذخیره شده؛ ستون «باید باشد» یعنی مقدار درست طبق درصد/الگوی همان سطر."/>

            <syncfusion:SfDataGrid x:Name="SYNCFUSION_DG" Grid.Row="1"
                ItemsSource="{Binding AUDIT_DATA}" FilterRowPosition="Top"
                AutoGenerateColumns="False"
                SelectionUnit="Row"
                IsReadOnly="True"
                SelectionMode="Extended"
                AllowDraggingColumns="True"
                AllowResizingColumns="True"
                AllowFiltering="True"
                AllowSorting="True"
                RowHeight="30"
                FrozenColumnCount="0"
                FlowDirection="RightToLeft"
                Style="{StaticResource KDG}"
                HeaderStyle="{StaticResource KDGHeader}"
                Margin="10,0,10,10" AllowRowHoverHighlighting="True" AllowSelectionOnPointerPressed="True" ShowRowHeader="True">

                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn HeaderText="شماره فاکتور" MappingName="NUMBER" Width="100"/>
                    <syncfusion:GridTextColumn HeaderText="تاریخ" MappingName="DATE_N" Width="100"/>
                    <syncfusion:GridTextColumn HeaderText="کد ویزیتور" MappingName="CUST_NO" Width="110"/>
                    <syncfusion:GridTextColumn HeaderText="نام ویزیتور" MappingName="CUST_NAME" Width="150"/>
                    <syncfusion:GridTextColumn HeaderText="الگوی پورسانت" MappingName="HAS_PATTERN_TEXT" Width="100"/>
                    <syncfusion:GridTextColumn HeaderText="درصد" MappingName="DARSAD" Width="80">
                        <syncfusion:GridTextColumn.DisplayBinding>
                            <Binding Path="DARSAD" StringFormat="{}{0:0.###}"/>
                        </syncfusion:GridTextColumn.DisplayBinding>
                    </syncfusion:GridTextColumn>
                    <syncfusion:GridTextColumn HeaderText="پورسانت (وضعیت فعلی)" MappingName="OLD_PURSANT" Width="150">
                        <syncfusion:GridTextColumn.DisplayBinding>
                            <Binding Path="OLD_PURSANT" StringFormat="{}{0:N0}"/>
                        </syncfusion:GridTextColumn.DisplayBinding>
                    </syncfusion:GridTextColumn>
                    <syncfusion:GridTextColumn HeaderText="پورسانت (باید باشد)" MappingName="NEW_PURSANT" Width="150">
                        <syncfusion:GridTextColumn.DisplayBinding>
                            <Binding Path="NEW_PURSANT" StringFormat="{}{0:N0}"/>
                        </syncfusion:GridTextColumn.DisplayBinding>
                    </syncfusion:GridTextColumn>
                    <syncfusion:GridTextColumn HeaderText="اختلاف" MappingName="DIFF" Width="130">
                        <syncfusion:GridTextColumn.DisplayBinding>
                            <Binding Path="DIFF" StringFormat="{}{0:N0}"/>
                        </syncfusion:GridTextColumn.DisplayBinding>
                    </syncfusion:GridTextColumn>
                    <syncfusion:GridTextColumn HeaderText="هشدار" MappingName="WARNING" ColumnSizer="Star"/>
                </syncfusion:SfDataGrid.Columns>

            </syncfusion:SfDataGrid>

            <!-- نوار پایین: خلاصه و دکمه‌ها -->
            <Grid Grid.Row="2" Margin="10,0,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label x:Name="SummaryLabel" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold" FlowDirection="RightToLeft" Content="..."/>

                <Button x:Name="RefreshButton" Grid.Column="1" Content="بروزرسانی فهرست" Click="RefreshButton_Click"
                        Style="{StaticResource MaterialDesignOutlinedSecondaryButton}" materialDesign:ButtonAssist.CornerRadius="15"
                        FontSize="10" Height="35" Margin="0,0,10,0" Padding="14,4"/>

                <Button x:Name="FixButton" Grid.Column="2" Content="اصلاح پورسانت و صدور مجدد سند"
                        Click="FixButton_Click"
                        Style="{StaticResource GerdC}"
                        BorderBrush="{x:Null}" FontSize="10" Height="35" Width="200"
                        Foreground="#DDFFFFFF" FontWeight="Bold"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
