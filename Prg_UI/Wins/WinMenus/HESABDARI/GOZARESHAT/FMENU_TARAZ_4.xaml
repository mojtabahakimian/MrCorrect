<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wins.WinMenus.HESABDARI.GOZARESHAT"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:CUC="clr-namespace:Prg_UI.CUC" x:Class="Wins.WinMenus.HESABDARI.GOZARESHAT.FMENU_TARAZ_4"
        mc:Ignorable="d"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="IRANYekanFN"
        WindowStartupLocation="CenterScreen"
        Title="F_MENU_KART" Height="320" Width="531" MinHeight="230" MinWidth="510" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown" >
    <Grid>
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="557,410,462,353"  Width="1"/>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True" Grid.RowSpan="2">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                     Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10">
                <Grid>
                    <Label Content="گزارش" x:Name="LABEL_HEADER" Padding="21,10,10,10" Foreground="White"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowRestore" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>

                </Grid>
            </Border>
        </Border>



        <Button x:Name="Command5" Width="136" VerticalAlignment="Bottom" TabIndex="6" Margin="205,0,0,17" Height="38" HorizontalAlignment="Left" FontSize="12" Foreground="#DDFFFFFF" Content="تایید" Click="Commnd5_Click"/>

        <Label x:Name="L_HHHS" VerticalAlignment="Top" d:Visibility="Visible" Visibility="Hidden" Margin="178,155,0,0" FlowDirection="RightToLeft" Content="حساب کل :" HorizontalAlignment="Left" Width="69"/>
        <ComboBox x:Name="HHHS"    FlowDirection="RightToLeft" d:Visibility="Visible"
            Style="{StaticResource FuzzyOutComboBox}"  
            IsEditable="True"
            Visibility="Hidden"
            IsSynchronizedWithCurrentItem="True"
            Margin="57,0,0,137" Padding="7,0,10,0" Height="27"  TabIndex="5" VerticalAlignment="Bottom"  IsTabStop="True" HorizontalAlignment="Left" Width="114">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>

        <Label x:Name="L_HHHM"  VerticalAlignment="Top"  Visibility="Hidden" d:Visibility="Visible" Margin="177,189,0,0" FlowDirection="RightToLeft" Content="حساب معین :" HorizontalAlignment="Left" Width="84"/>
        <CUC:NumericTextBox x:Name="HHHM" d:Visibility="Visible" DoesAcceptDouble="False"  LastValueShouldZero="False" Text="" Height="27" Margin="0,190,360,0" VerticalAlignment="Top" Visibility="Hidden"  HorizontalAlignment="Right" Width="114" TabIndex="3"/>

        <Label x:Name="L_HHHT" VerticalAlignment="Top" d:Visibility="Visible" Visibility="Hidden" Margin="177,224,0,0" FlowDirection="RightToLeft" Content="حساب تفضیلی :" HorizontalAlignment="Left" Width="95"/>
        <ComboBox x:Name="HHHT"    FlowDirection="RightToLeft" d:Visibility="Visible"
            Style="{StaticResource FuzzyOutComboBox}"  
            IsEditable="True"
            Visibility="Hidden"
            IsSynchronizedWithCurrentItem="True"
            Margin="57,224,0,0" Padding="7,0,10,0" Height="27"  TabIndex="4" VerticalAlignment="Top"  IsTabStop="True" HorizontalAlignment="Left" Width="114">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>

        <xctk:MaskedTextBox x:Name="DT1" Style="{StaticResource FuzzyOut}" Padding="3"  Mask="0000/00/00" Text="11111111" Height="30" Margin="0,78,92,0" TextWrapping="Wrap" VerticalAlignment="Top"  BorderThickness="1" FontSize="12" TabIndex="1" HorizontalAlignment="Right" Width="88" />
        <Label Content="از تاریخ:" FlowDirection="RightToLeft" Margin="0,78,40,0" VerticalAlignment="Top" Width="49" HorizontalAlignment="Right"/>
        <xctk:MaskedTextBox x:Name="DT2" Style="{StaticResource FuzzyOut}" Padding="3"  Mask="0000/00/00" Text="99991230" Height="30" Margin="0,78,386,0" TextWrapping="Wrap" VerticalAlignment="Top"  BorderThickness="1" FontSize="12" TabIndex="2" HorizontalAlignment="Right" Width="88" />
        <Label Content="تا تاریخ:" FlowDirection="RightToLeft" Margin="0,77,332,0" VerticalAlignment="Top" Width="49" HorizontalAlignment="Right"/>


        <StackPanel x:Name="VI" Margin="0,166,15,0" Orientation="Vertical" HorizontalAlignment="Right" Width="245" Height="63" VerticalAlignment="Top">


            <RadioButton x:Name="RB1" IsChecked="True" Content="حسابهای بدون مانده نمایش داده شود" GroupName="Second" FlowDirection="RightToLeft" Margin="0,0,0,0" />
            <RadioButton x:Name="RB2" Content="فقط حسابهای دارای مانده نمایش داده شود" GroupName="Second" FlowDirection="RightToLeft"  Margin="0,10,0,0" />

        </StackPanel>

        <Label Width="auto" VerticalAlignment="Top" Margin="0,116,13,0" HorizontalAlignment="Right" FlowDirection="RightToLeft" Content="از سند شماره:"/>
        <CUC:NumericTextBox x:Name="SNDNUM1" DoesAcceptDouble="False"  LastValueShouldZero="False" Text="" Height="30" Margin="0,116,92,0" VerticalAlignment="Top" Visibility="Visible"  HorizontalAlignment="Right" Width="88" TabIndex="3"/>
        <Label Content="تا سند شماره:" HorizontalAlignment="Right" Margin="0,116,305,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <CUC:NumericTextBox x:Name="SNDNUM2" DoesAcceptDouble="False"  LastValueShouldZero="False" Text="" Height="30" Margin="0,116,386,0" VerticalAlignment="Top" Visibility="Visible"  HorizontalAlignment="Right" Width="88" TabIndex="9"/>

    </Grid>
</Window>
