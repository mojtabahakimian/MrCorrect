<Window x:Class="Prg_UI.Wins.WinMenus.HESABDARI.GOZARESHAT.HES1HES2MOGHYERAT"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.HESABDARI.GOZARESHAT"
        mc:Ignorable="d"
                xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:sfusion="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Height="600" Width="800"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MinHeight="400"
        FontFamily="{StaticResource IRANYEKAN}"
        Background="{x:Null}"
        AllowsTransparency="True" AllowDrop="True"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="15"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>
        <!-- Style for SfDataGrid -->
        <Style x:Key="KDG"  TargetType="syncfusion:SfDataGrid" BasedOn="{StaticResource SfDataGridStyle}">
            <Setter Property="CurrentCellBorderBrush" Value="{StaticResource GENERAL_Grlicom}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="BorderBrush" Value="{StaticResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="HeaderRowHeight" Value="40" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="GridLinesVisibility" Value="Both" />
        </Style>
        <!-- Modified Column Header Style -->
        <Style x:Key="KDGHeader" TargetType="syncfusion:GridHeaderCellControl" BasedOn="{StaticResource GridHeaderCellControlStyle}">
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="BorderBrush" Value="{Binding Background, ElementName=GENERAL_RANG}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="Auto"/>
        </Style>

        <Style TargetType="sfusion:GridCell" BasedOn="{StaticResource GridCellStyle}">
            <Setter Property="BorderBrush" Value="{Binding BorderBrush, ElementName=GENERAL_RANG}" />
        </Style>


        <!-- Context Menu defined in XAML -->
        <ContextMenu x:Key="DataGridContextMenu" FontFamily="{StaticResource IRANYEKAN}">
            <MenuItem Header="پالودن با این بخش" Click="FilterBySelection_Click">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="Filter"  FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <!--Filter Excluding Selection-->
            <MenuItem Header="پالودن بدون این بخش" Click="FilterExcludingSelection_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FilterRemove" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="کـپـی" Click="MenuItem_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="ContentCopy" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="حذف پالودن (فیلتر)" Click="RemoveFilterSort_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FilterRemoveOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="خروجی اکسل" Click="EXPORTEXCEL_BTN" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FileExcelOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>
    <Grid x:Name="mygrid" Margin="8,8,8,0">
        <!-- Hidden button for color binding reference -->
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Width="1" Height="1"/>
        <!-- Main container -->
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding ElementName=GENERAL_RANG, Path=Background}" BorderThickness="1" CornerRadius="10" Padding="8">
            <!-- Title bar -->
            <Border  x:Name="TitleDrawBar" Style="{StaticResource BordG}"  Background="{Binding ElementName=GENERAL_RANG, Path=Background}"  CornerRadius="10,10,0,0" Margin="-9,-9,-9,0"  Height="38"  VerticalAlignment="Top" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <!-- Window title -->
                    <Label x:Name="LABEL_HEADER" Content="ليست فاکتورهايي که کد مشتري در حواله و رسيد با فاکتور متفاوت است" Padding="17,8,10,10" Foreground="White" Margin="0,0,110,0" VerticalAlignment="Center"/>
                    <!-- Window control buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0">
                        <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0,0,0,-1" IsTabStop="False" ToolTip="Minimize">
                            <materialDesign:PackIcon Kind="WindowMinimize" Width="18" Height="18" Foreground="White"/>
                        </Button>
                        <Button x:Name="Btn_Max" Click="Btn_Max_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" FontSize="12" Height="24" Padding="0" Margin="4,0,0,0" IsTabStop="False" ToolTip="Maximize">
                            <materialDesign:PackIcon Kind="WindowMaximize" Width="17" Height="17" Foreground="White"/>
                        </Button>
                        <Button x:Name="Btn_Close" Click="Btn_Close_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0" Margin="4,0,0,0" FontSize="12" IsTabStop="False" ToolTip="Close">
                            <materialDesign:PackIcon Kind="WindowClose" Width="19" Height="19" Foreground="White"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
        <!-- Notification popup -->
        <Popup x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative" Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Width="{Binding ElementName=mygrid, Path=ActualWidth, Mode=OneWay}" Height="84" Padding="10">
                <TextBox x:Name="Pop1Text1" IsReadOnly="True" Background="Transparent" BorderBrush="Transparent" Foreground="White" Text="محل نمایش اعلان های سیستم" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
            </Border>
        </Popup>

        <!-- Content area -->
        <Grid Margin="0,38,0,0">

            <syncfusion:SfDataGrid x:Name="SYNCFUSION_DG" ContextMenu="{StaticResource DataGridContextMenu}"
                ItemsSource="{Binding SFDATA}" FilterRowPosition="Top"
                AutoGenerateColumns="False"
                AllowEditing="True"
                EnableDataVirtualization="True"
                SelectionUnit="Row"
                IsReadOnly="True"
                              
                SelectionMode="Extended"
                AllowDraggingColumns="True"
                AllowResizingColumns="True"
                AllowFiltering="True"
                AllowSorting="True"
                RowHeight="30"
                FrozenColumnCount="0"
                FlowDirection="RightToLeft"
                d:ItemsSource="{d:SampleData ItemCount=5}"
                Style="{StaticResource KDG}"
                HeaderStyle="{StaticResource KDGHeader}"
                PreviewMouseRightButtonDown="SYNCFUSION_DG_PreviewMouseRightButtonDown"
                CurrentCellActivated="SYNCFUSION_DG_CurrentCellActivated"
                Margin="10,10,10,10" AllowRowHoverHighlighting="True" AllowSelectionOnPointerPressed="True" ScrollMode="Async" ShowRowHeader="True" ShowGroupDropArea="True" SelectionChanged="SYNCFUSION_DG_SelectionChanged" PreviewKeyDown="SYNCFUSION_DG_PreviewKeyDown">

                <syncfusion:SfDataGrid.Resources>
                    <ResourceDictionary>
                        <Style TargetType="TextBox">
                            <Setter Property="AcceptsReturn" Value="True" />
                            <Setter Property="Height" Value="40" />
                        </Style>
                    </ResourceDictionary>
                </syncfusion:SfDataGrid.Resources>

                <syncfusion:SfDataGrid.Columns>

                    <syncfusion:GridTextColumn HeaderText="شماره حواله" MappingName="nb" Width="100"/>

                    <syncfusion:GridTextColumn HeaderText="نوع برگه" MappingName="TagName" Width="120"/>

                    <syncfusion:GridTextColumn HeaderText="تاريخ" MappingName="dt" Width="110"/>

                    <syncfusion:GridTextColumn HeaderText="کد مشتري" MappingName="mf" Width="100"/>

                    <syncfusion:GridTextColumn HeaderText="نام حساب مشتري" MappingName="NAME" ColumnSizer="Star"/>

                    <syncfusion:GridTextColumn HeaderText="کد نوع" MappingName="tg2" Width="60" IsHidden="True"/>

                </syncfusion:SfDataGrid.Columns>

            </syncfusion:SfDataGrid>

        </Grid>
    </Grid>
</Window>