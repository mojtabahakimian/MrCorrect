<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wins.WinMenus.HESABDARI"
        x:Class="Wins.WinMenus.HESABDARI.PGET_HED_LIST"
        mc:Ignorable="d" 
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
 	    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit" 
 	    Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        WindowStartupLocation="CenterScreen" 
        FontFamily="IRANYekanFN"
        Title="PGET_HED_LIST" Height="578" Width="988" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Border  Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5"  Grid.ColumnSpan="5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="28.579" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowRestore" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="95,56,0,0"  Width="1"/>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True" Grid.RowSpan="2">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
               Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <!--EndOfHeader ↑-->
        <Label HorizontalContentAlignment="Center" Foreground="White" VerticalContentAlignment="Center" Content="لیست خزانه" Margin="10,1,885,540"/>

        <TextBox x:Name="ID" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="3" HorizontalAlignment="Right" Height="28" Margin="0,63,83,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="68" FlowDirection="RightToLeft" TabIndex="0" />
        <Label Content="شماره خزانه :" HorizontalAlignment="Right" Height="30" Margin="0,62,10,0" VerticalAlignment="Top" Width="73" FlowDirection="RightToLeft" />
        <UniformGrid Columns="1" Margin="10,168,10,10">
            <!-- DataGrid for the header/master data (PGET_HED) -->

            <!-- DataGrid for the body/detail data (PGET_LST) -->
            <!-- DataGrid for the header/master data (PGET_HED) -->
            <DataGrid x:Name="MasterDataGrid" AutoGenerateColumns="False" ItemsSource="{Binding PGET_HED_List}" IsReadOnly="True" FlowDirection="RightToLeft" PreviewKeyDown="MasterDataGrid_PreviewKeyDown" IsTabStop="True" TabIndex="2">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="iDColumn" Binding="{Binding ID}" Header="شماره خزانه" Width="auto"/>
                    <DataGridTextColumn x:Name="dATEColumn" Binding="{Binding DATE, StringFormat=####/##/##}" Header="تاریخ" Width="auto"/>
                    <DataGridTextColumn x:Name="mOLAHColumn" Binding="{Binding MOLAH}" Header="ملاحضات" Width="auto"/>
                    <DataGridTextColumn x:Name="dEPATMANColumn" Binding="{Binding DEPATMAN}" Header="واحد" Width="auto"/>
                    <DataGridTextColumn x:Name="sHIFTColumn" Binding="{Binding SHIFT}" Header="شیف" Width="auto"/>
                    <DataGridTextColumn x:Name="uSER_NAMEColumn" Binding="{Binding USER_NAME}" Header="کاربر" Width="auto"/>
                    <DataGridTextColumn x:Name="kINDColumn" Binding="{Binding KIND}" Header="نوع برگه" Width="auto"/>
                    <DataGridTextColumn x:Name="iDKColumn" Binding="{Binding IDK}" Header="شماره برگه" Width="auto"/>
                </DataGrid.Columns>
            </DataGrid>
            <!-- DataGrid for the body/detail data (PGET_LST) -->
            <DataGrid x:Name="DetailDataGrid" AutoGenerateColumns="False" Visibility="Collapsed" FlowDirection="RightToLeft" ItemsSource="{Binding SelectedItem.Details, ElementName=MasterDataGrid}" IsReadOnly="True" Margin="0,10,0,0">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="idcolumn_pget_lst" Binding="{Binding ID}" Header="شماره خزانه" Width="auto"/>
                    <DataGridTextColumn x:Name="datecolumn_pget_lst" Binding="{Binding DATE, StringFormat=####/##/##}" Header="تاریخ" Width="auto"/>
                    <DataGridTextColumn x:Name="rADIFColumn" Binding="{Binding RADIF}" Header="ردیف" Width="auto"/>
                    <DataGridTextColumn x:Name="nO_AMColumn" Binding="{Binding NO_AM}" Header="نوع عملیات" Width="auto"/>
                    <DataGridTextColumn x:Name="nAHVAColumn" Binding="{Binding NAHVA}" Header="نحوه" Width="auto"/>
                    <DataGridTextColumn x:Name="sHARHColumn" Binding="{Binding SHARH}" Header="شرح" Width="auto"/>
                    <DataGridTextColumn x:Name="mABLColumn" Binding="{Binding MABL, StringFormat=\{0:N0\}}" Header="مبلغ" Width="auto"/>
                    <DataGridTextColumn x:Name="fHESColumn" Binding="{Binding FHES}" Header="از حساب" Width="auto"/>
                    <DataGridTextColumn x:Name="tHESColumn" Binding="{Binding THES}" Header=" به حساب" Width="auto"/>
                    <DataGridTextColumn x:Name="n_SERIColumn" Binding="{Binding N_SERI}" Header="شماره سریال" Width="auto"/>
                    <DataGridTextColumn x:Name="bANKColumn" Binding="{Binding BANK}" Header="بانک" Width="auto"/>
                </DataGrid.Columns>
            </DataGrid>

        </UniformGrid>
        <TextBox x:Name="IDK" Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="3" HorizontalAlignment="Right" Height="28" Margin="0,64,224,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="68" FlowDirection="RightToLeft" />
        <Label Content="شماره برگه :" HorizontalAlignment="Right" Height="30" Margin="0,63,156,0" VerticalAlignment="Top" Width="73" FlowDirection="RightToLeft" />

        <Label Width="42" VerticalAlignment="Top" Margin="0,63,295,0" Height="30" HorizontalAlignment="Right" FlowDirection="RightToLeft" Content="تاریخ :"/>

        <xctk:MaskedTextBox x:Name="DATE" Mask="0000/00/00"  Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="3"  Height="28" Margin="0,65,337,0" TextWrapping="Wrap" VerticalAlignment="Top"  BorderThickness="1" FontSize="12" HorizontalAlignment="Right" Width="80" />
        <Label Content="ملاحظات :" Height="30" Margin="0,63,422,0" VerticalAlignment="Top" FlowDirection="RightToLeft"  HorizontalAlignment="Right" Width="60"/>
        <TextBox x:Name="SHARAYET_SR"  Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="3"  Height="28" Margin="10,66,482,0" TextWrapping="Wrap" VerticalAlignment="Top" FlowDirection="RightToLeft"/>
        <Button x:Name="REFLOAD_ALL"  Content="باز خوانی مجدد" Margin="0,109,10,0"    BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="10" Height="37" VerticalAlignment="Top" HorizontalAlignment="Right" Width="114" Foreground="#DDFFFFFF" FontWeight="Bold" Click="REFLOAD_ALL_Click" />
        <Button x:Name="CLEANFILTERS"  Content="حذف همه فیلتر ها" Margin="0,109,248,0"    BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="10" Height="37" VerticalAlignment="Top" HorizontalAlignment="Right" Width="114" Foreground="#DDFFFFFF" FontWeight="Bold" Click="CLEANFILTERS_Click" />
        <Button x:Name="BTN_SEARCH"  Content="جستجو" Margin="0,109,129,0"    BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="10" Height="37" VerticalAlignment="Top" HorizontalAlignment="Right" Width="114" Foreground="#DDFFFFFF" FontWeight="Bold" Click="BTN_SEARCH_Click" TabIndex="1" />
        <Label Content="تعداد ردیف ها : " HorizontalAlignment="Left" Margin="10,113,0,0" VerticalAlignment="Top" Width="87"/>
        <Label Content="{Binding Items.Count, ElementName=MasterDataGrid, IsAsync=True}" HorizontalAlignment="Left" Margin="102,113,0,0" VerticalAlignment="Top" Width="94" Height="29"/>

    </Grid>
</Window>
