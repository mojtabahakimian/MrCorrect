<Window x:Class="Wins.WinMenus.HESABDARI.chek_pass_nashodah"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wins.WinMenus.HESABDARI"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="{StaticResource IRANYEKAN}"
        WindowStartupLocation="CenterScreen"
        Title="لیست چکهای پاس نشده" Height="450" Width="800">
    <Window.Resources>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>
    </Window.Resources>
    <Grid>
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="557,410,462,353"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10">
                <Grid>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowRestore" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>

        <DataGrid x:Name="none_passecheck" ColumnHeaderStyle="{StaticResource CenteryHeaderstyle}" FlowDirection="RightToLeft" AutoGenerateColumns="False" EnableRowVirtualization="True" Margin="5,50,10,20" ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="n_SERIColumn" Binding="{Binding N_SERI}" Header="شماره سریال" Width="auto"/>
                <DataGridTextColumn x:Name="bknColumn" Binding="{Binding bkn}" Header="بانک" Width="auto"/>
                <DataGridTextColumn x:Name="dATE_SColumn" Binding="{Binding DATE_S}" Header="تاریخ سررسید" Width="auto"/>
                <DataGridTextColumn x:Name="dATEColumn" Binding="{Binding DATE}" Header="تاریخ دریافت" Width="auto"/>
                <DataGridTextColumn x:Name="sHOBEHColumn" Binding="{Binding SHOBEH}" Header="نام شعبه" Width="auto"/>
                <DataGridTextColumn x:Name="mABLColumn" Binding="{Binding MABL}" Header="مبلغ" Width="auto"/>
                <DataGridTextColumn x:Name="nAME_TAHColumn" Binding="{Binding NAME_TAH}" Header="نام تحویل گیرنده" Width="auto"/>
                <DataGridTextColumn x:Name="n_HESABColumn" Binding="{Binding N_HESAB}" Header="شماره حساب" Width="auto"/>
                <DataGridTextColumn x:Name="cUST_NOColumn" Binding="{Binding CUST_NO}" Header="شماره مشتری" Width="auto"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>