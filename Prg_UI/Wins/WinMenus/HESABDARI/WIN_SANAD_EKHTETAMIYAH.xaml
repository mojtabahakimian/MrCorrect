<Window x:Class="Prg_UI.Wins.WinMenus.HESABDARI.WIN_SANAD_EKHTETAMIYAH"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.HESABDARI"
        mc:Ignorable="d"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Height="350" Width="800"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MinHeight="350"
        FontFamily="{StaticResource IRANYEKAN}"
        Background="{x:Null}"
        AllowsTransparency="True" AllowDrop="True"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="15"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Color="{Binding ElementName=GENERAL_RANG, Path=Background.Color}" Opacity="0.3"/>
    </Window.Resources>

    <!-- Main container acting as mygrid to preserve bindings -->
    <Border x:Name="mygrid" Margin="8,8,8,0" Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding ElementName=GENERAL_RANG, Path=Background}" BorderThickness="1" CornerRadius="10">
        <DockPanel>

            <!-- Hidden button for color binding reference -->
            <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Width="1" Height="1" DockPanel.Dock="Top"/>

            <!-- Title bar -->
            <Border x:Name="TitleDrawBar" DockPanel.Dock="Top" Style="{StaticResource BordG}" Background="{Binding ElementName=GENERAL_RANG, Path=Background}" CornerRadius="9,9,0,0" Height="38" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <DockPanel>
                    <!-- Window control buttons -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,13,0">
                        <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0,0,0,-1" IsTabStop="False" ToolTip="Minimize">
                            <materialDesign:PackIcon Kind="WindowMinimize" Width="18" Height="18" Foreground="White"/>
                        </Button>
                        <Button x:Name="Btn_Max" Click="Btn_Max_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" FontSize="12" Height="24" Padding="0" Margin="4,0,0,0" IsTabStop="False" ToolTip="Maximize">
                            <materialDesign:PackIcon Kind="WindowMaximize" Width="17" Height="17" Foreground="White"/>
                        </Button>
                        <Button x:Name="Btn_Close" Click="Btn_Close_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0" Margin="4,0,0,0" FontSize="12" IsTabStop="False" ToolTip="Close">
                            <materialDesign:PackIcon Kind="WindowClose" Width="19" Height="19" Foreground="White"/>
                        </Button>
                    </StackPanel>

                    <!-- Window title -->
                    <Label x:Name="LABEL_HEADER" Content="سند اخـتتامیـه" Padding="17,8,10,10" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                </DockPanel>
            </Border>

            <!-- Notification popup -->
            <Popup x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative" Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Width="{Binding ElementName=mygrid, Path=ActualWidth, Mode=OneWay}" Height="84" Padding="10">
                    <TextBox x:Name="Pop1Text1" IsReadOnly="True" Background="Transparent" FlowDirection="RightToLeft" BorderBrush="Transparent" Foreground="White" Text="محل نمایش اعلان های سیستم" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                </Border>
            </Popup>

            <!-- Content area -->
            <StackPanel FlowDirection="RightToLeft" Height="263" Margin="20,20,20,20">

                <!-- Voucher Number -->
                <StackPanel Orientation="Horizontal" Margin="0,10,0,5" VerticalAlignment="Center">
                    <Label Content="شماره سند اختتامیه:" VerticalAlignment="Center" Width="125"/>
                    <TextBox x:Name="S2" Width="130" Text="" TextAlignment="Right" Style="{StaticResource FuzzyOut}"/>
                </StackPanel>

                <!-- Voucher Date -->
                <StackPanel Orientation="Horizontal" Margin="0,5,0,5" VerticalAlignment="Center">
                    <Label Content="تاریخ سند اختتامیه:" VerticalAlignment="Center" Width="125"/>
                    <xctk:MaskedTextBox x:Name="DT" Mask="0000/00/00" Width="130" FlowDirection="LeftToRight" TextAlignment="Left" Style="{StaticResource FuzzyOut}" Padding="3"/>
                </StackPanel>

                <!-- Description -->
                <StackPanel Orientation="Horizontal" Margin="0,5,0,5" VerticalAlignment="Center">
                    <Label Content="شرح سند اختتامیه:" VerticalAlignment="Center" Width="125"/>
                    <TextBox x:Name="SH" Width="310" Text="سند اختتامیه" Style="{StaticResource FuzzyOut}"/>
                </StackPanel>

                <!-- Options -->
                <GroupBox Style="{x:Null}" Header="نوع سند" Margin="0,10,0,10" Padding="5">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" FlowDirection="LeftToRight">
                        <RadioButton x:Name="Option29" Content="کلیه حسابها" Margin="10,0,10,0"/>
                        <RadioButton x:Name="Option27" Content="فقط حسابهای دائمی" IsChecked="True" Margin="10,0,10,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- Buttons -->
                <DockPanel Margin="0,15,0,0">
                    <Button x:Name="BTN_GO" Content="صدور سند اختتامیه" BorderBrush="{x:Null}" FontSize="11" Foreground="#DDFFFFFF" Height="34" Click="BTN_GO_Click" />
                </DockPanel>

            </StackPanel>
        </DockPanel>
    </Border>
</Window>