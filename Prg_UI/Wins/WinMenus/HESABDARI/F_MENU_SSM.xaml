<Window x:Class="Prg_UI.Wins.WinMenus.HESABDARI.F_MENU_SSM"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.HESABDARI"
        mc:Ignorable="d"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:sfusion="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Height="600" Width="800"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MinHeight="400"
        FontFamily="{StaticResource IRANYEKAN}"
        Background="{x:Null}"
        AllowsTransparency="True" AllowDrop="True"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="15"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style TargetType="sfusion:GridCell" x:Key="JamFactorCellStyle">
            <Setter Property="Background" Value="#FF99CC"/>
        </Style>

        <Style TargetType="sfusion:GridCell" x:Key="TakhirCellStyle">
            <Setter Property="Background" Value="#FF6600"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style TargetType="sfusion:GridCell" x:Key="TagilCellStyle">
            <Setter Property="Background" Value="#CCFFCC"/>
        </Style>

        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Color="{Binding ElementName=GENERAL_RANG, Path=Background.Color}" Opacity="0.3"/>

        <!-- Style for SfDataGrid -->
        <Style x:Key="KDG"  TargetType="syncfusion:SfDataGrid" BasedOn="{StaticResource SfDataGridStyle}">
            <Setter Property="CurrentCellBorderBrush" Value="{StaticResource GENERAL_Grlicom}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="BorderBrush" Value="{StaticResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="HeaderRowHeight" Value="40" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="GridLinesVisibility" Value="Both" />
        </Style>
        <!-- Modified Column Header Style -->
        <Style x:Key="KDGHeader" TargetType="syncfusion:GridHeaderCellControl" BasedOn="{StaticResource GridHeaderCellControlStyle}">
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="BorderBrush" Value="{Binding Background, ElementName=GENERAL_RANG}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="Auto"/>
        </Style>

        <Style TargetType="sfusion:GridCell" BasedOn="{StaticResource GridCellStyle}">
            <Setter Property="BorderBrush" Value="{Binding BorderBrush, ElementName=GENERAL_RANG}" />
        </Style>
    </Window.Resources>

    <Grid x:Name="mygrid" Margin="8,8,8,0">
        <!-- Hidden button for color binding reference -->
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Width="1" Height="1"/>
        <!-- Main container -->
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding ElementName=GENERAL_RANG, Path=Background}" BorderThickness="1" CornerRadius="10" Padding="8">
            <!-- Title bar -->
            <Border  x:Name="TitleDrawBar" Style="{StaticResource BordG}"  Background="{Binding ElementName=GENERAL_RANG, Path=Background}"  CornerRadius="10,10,0,0" Margin="-9,-9,-9,0"  Height="38"  VerticalAlignment="Top" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <!-- Window title -->
                    <Label x:Name="LABEL_HEADER" Content="تاخیر پرداختها" Padding="17,8,10,10" Foreground="White" Margin="0,0,110,0" VerticalAlignment="Center"/>
                    <!-- Window control buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0">
                        <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0,0,0,-1" IsTabStop="False" ToolTip="Minimize">
                            <materialDesign:PackIcon Kind="WindowMinimize" Width="18" Height="18" Foreground="White"/>
                        </Button>
                        <Button x:Name="Btn_Max" Click="Btn_Max_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" FontSize="12" Height="24" Padding="0" Margin="4,0,0,0" IsTabStop="False" ToolTip="Maximize">
                            <materialDesign:PackIcon Kind="WindowMaximize" Width="17" Height="17" Foreground="White"/>
                        </Button>
                        <Button x:Name="Btn_Close" Click="Btn_Close_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0" Margin="4,0,0,0" FontSize="12" IsTabStop="False" ToolTip="Close">
                            <materialDesign:PackIcon Kind="WindowClose" Width="19" Height="19" Foreground="White"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
        <!-- Notification popup -->
        <Popup x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative" Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Width="{Binding ElementName=mygrid, Path=ActualWidth, Mode=OneWay}" Height="84" Padding="10">
                <TextBox x:Name="Pop1Text1" IsReadOnly="True" Background="Transparent" FlowDirection="RightToLeft" BorderBrush="Transparent" Foreground="White" Text="محل نمایش اعلان های سیستم" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
            </Border>
        </Popup>

        <!-- Content area -->
        <Grid Margin="0,38,0,0" FlowDirection="RightToLeft">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0" TextWrapping="Wrap" TextAlignment="Center" Margin="10" Foreground="Blue" FontSize="14">
            من براساس مقادیر تنظیم شده در مشخصات سیستم  برای هر ماه  اقدام به محاسبه تاخیر مینمایم  این محاسبات نهایتا در قالب یک لیست ارائه شده و با تایید شما تبدیل به سند حسابداری میگردد.بهتر است برای محاسبه تاخیر هر ماه یک ماه حداقل دیرتر اقدام کنید تا تمام بدهکاری و بستانکاری مشتری ها ثبت شده باشد ..مستر کارکت
                </TextBlock>

                <!-- Controls -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                    <Label Content="ماه:" VerticalAlignment="Center" Margin="5"/>
                    <ComboBox x:Name="MMO" Width="150" SelectionChanged="MMO_SelectionChanged" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}"  Height="30" VerticalAlignment="Center" Margin="5">
                        <ComboBoxItem Content="فروردین" Tag="1"/>
                        <ComboBoxItem Content="اردیبهشت" Tag="2"/>
                        <ComboBoxItem Content="خرداد" Tag="3"/>
                        <ComboBoxItem Content="تیر" Tag="4"/>
                        <ComboBoxItem Content="مرداد" Tag="5"/>
                        <ComboBoxItem Content="شهریور" Tag="6"/>
                        <ComboBoxItem Content="مهر" Tag="7"/>
                        <ComboBoxItem Content="آبان" Tag="8"/>
                        <ComboBoxItem Content="آذر" Tag="9"/>
                        <ComboBoxItem Content="دی" Tag="10"/>
                        <ComboBoxItem Content="بهمن" Tag="11"/>
                        <ComboBoxItem Content="اسفند" Tag="12"/>
                        <ComboBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                            </ItemsPanelTemplate>
                        </ComboBox.ItemsPanel>
                    </ComboBox>
                    <Button x:Name="Command5" Content="تایید" Height="34" BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Click="Command5_Click" Margin="5" Width="100"/>
                    <Button x:Name="ESLAH" Content="اصلاح" Click="ESLAH_Click"  Height="34" BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Margin="5" Width="100"/>
                    <Button x:Name="Command24" Content="صدور سند حسابداری"  Height="34" BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Click="Command24_Click" Margin="5" Width="150"/>
                </StackPanel>

                <!-- Grid -->
                <syncfusion:SfDataGrid x:Name="SSM_CUST_ANALYS_form" Grid.Row="2" Margin="5"
                               AutoGenerateColumns="False"
                               AllowEditing="False"
                               AllowSorting="True"
                               AllowFiltering="True"
                               ColumnSizer="Auto"
                               Style="{StaticResource KDG}"
                               HeaderStyle="{StaticResource KDGHeader}"
                               ItemsSource="{Binding SSM_DATA}"
                               d:ItemsSource="{d:SampleData ItemCount=5}"
                               AllowRowHoverHighlighting="True" 
                               AllowSelectionOnPointerPressed="True" 
                               ScrollMode="Async" 
                               ShowRowHeader="True" 
                               ShowGroupDropArea="True"
                               EnableDataVirtualization="True"
                               SelectionUnit="Row"
                               SelectionMode="Extended"
                               AllowResizingColumns="True"
                               RowHeight="35"
                               FrozenColumnCount="0"
                               KeyboardNavigation.TabNavigation="Contained"
                               KeyboardNavigation.ControlTabNavigation="Contained"
                               GridLinesVisibility="Horizontal"
                               CellDoubleTapped="SSM_CUST_ANALYS_form_CellDoubleTapped">
                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTextColumn MappingName="SCAID" HeaderText="شماره" IsHidden="False"/>
                        <syncfusion:GridTextColumn MappingName="CUST_NO" HeaderText="کد مشتری" Width="150"/>
                        <syncfusion:GridTextColumn MappingName="NAM" HeaderText="مشتری" Width="250"/>
                        <syncfusion:GridTextColumn MappingName="SCADATE" HeaderText="تاریخ" >
                            <syncfusion:GridTextColumn.DisplayBinding>
                                <Binding Path="SCADATE" StringFormat="####/##/##" />
                            </syncfusion:GridTextColumn.DisplayBinding>
                        </syncfusion:GridTextColumn>

                        <syncfusion:GridTextColumn MappingName="SCAJAMF" HeaderText="جمع فاکتور" DisplayBinding="{Binding SCAJAMF, StringFormat='#,##0'}" CellStyle="{StaticResource JamFactorCellStyle}"/>
                        <syncfusion:GridTextColumn MappingName="TAKHIR" HeaderText="مبلغ تاخیر" DisplayBinding="{Binding TAKHIR, StringFormat='#,##0'}" CellStyle="{StaticResource TakhirCellStyle}"/>
                        <syncfusion:GridTextColumn MappingName="TAGIL" HeaderText="مبلغ تعجیل" DisplayBinding="{Binding TAGIL, StringFormat='#,##0'}" CellStyle="{StaticResource TagilCellStyle}"/>
                        <syncfusion:GridTextColumn MappingName="SCATAFAVOT" HeaderText="تاخیر"/>
                        <syncfusion:GridTextColumn MappingName="SCARASFR" HeaderText="راس فاکتورها"/>
                        <syncfusion:GridTextColumn MappingName="SCARASTAV" HeaderText="راس توافق"/>
                        <syncfusion:GridTextColumn MappingName="SCARASPAY" HeaderText="راس پرداخت"/>
                        <syncfusion:GridTextColumn MappingName="SCAMABNADATE" HeaderText="تاریخ مبنا">
                            <syncfusion:GridTextColumn.DisplayBinding>
                                <Binding Path="SCAMABNADATE" StringFormat="####/##/##" />
                            </syncfusion:GridTextColumn.DisplayBinding>
                        </syncfusion:GridTextColumn>
                        <syncfusion:GridTextColumn MappingName="SCAMABP" HeaderText="درصد کسر و اضافه"/>
                        <syncfusion:GridTextColumn MappingName="CTIM" HeaderText="تاریخ">
         
                        </syncfusion:GridTextColumn>
                        <syncfusion:GridTextColumn MappingName="MONTH" HeaderText="ماه"/>
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>

                <!-- Footer Actions -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10">

                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>