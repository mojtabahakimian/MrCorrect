<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wins.WinMenus.HESABDARI"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit" x:Class="Wins.WinMenus.HESABDARI.MOGHAYERAT"
        mc:Ignorable="d"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="IRANYekanFN"
        WindowStartupLocation="CenterScreen"
        Title="صورت مغایرت های گرفته شده" Height="540" Width="800" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="mygrid">

        <Grid.RowDefinitions>
            <RowDefinition Height="23*"/>
            <RowDefinition Height="13*"/>
        </Grid.RowDefinitions>
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="557,65,242,98"  Width="1" Grid.Row="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1" Grid.RowSpan="2">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label Content="صورت مغایرت های گرفته شده" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True" Grid.RowSpan="2">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                                                       Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <!--HEADER↑-->


        <!--Start.......................................................................................-->
        <Button x:Name="BAZKHANI" Content="بازخوانی حساب باکنترل"  BorderBrush="{x:Null}" FontSize="12" Foreground="#DDFFFFFF" Margin="0,10,105,0" Height="40" VerticalAlignment="Top" HorizontalAlignment="Right" Width="171" Grid.Row="1" Click="BAZKHANI_Click" />
        <Label Content="شماره:" HorizontalAlignment="Right" Margin="0,52,12,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <TextBox x:Name="ONVAN" Text="" Height="30" Margin="254,51,186,0"  Style="{StaticResource FuzzyOut}" Padding="3"  TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible" MaxLength="48" />
        <CNC:NumericTextBox x:Name="MONUM" DoesAcceptDouble="False" RestoreLastValidValue="False"  LastValueShouldZero="False" Text="" Height="30" Margin="0,51,53,0" VerticalAlignment="Top" Visibility="Visible"  HorizontalAlignment="Right" Width="88" IsReadOnly="True"/>

        <DataGrid   
                  x:Name="MOGH_DG"
                  EnableColumnVirtualization="True"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="False"
                  SelectedIndex="0"
                  ColumnHeaderStyle="{StaticResource CenteryHeaderstyle}"
                  CellStyle="{StaticResource CellFocusyBorder}"
                  HorizontalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                  VerticalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                  ItemsSource="{Binding MOGH_SUB_DATA}"
                  KeyboardNavigation.TabNavigation="Contained"
                  AutoGenerateColumns="False" 
                  FlowDirection="RightToLeft" 
                  SelectionUnit="FullRow" 
                  CanUserDeleteRows="False"
                  Margin="4,140,4,5" BorderThickness="1" IsKeyboardFocusWithinChanged="MOGH_DG_IsKeyboardFocusWithinChanged"  CellEditEnding="MOGH_DG_CellEditEnding" PreviewMouseLeftButtonUp="MOGH_DG_PreviewMouseLeftButtonUp" SelectionChanged="MOGH_DG_SelectionChanged" RowEditEnding="MOGH_DG_RowEditEnding" PreviewKeyDown="MOGH_DG_PreviewKeyDown" PreparingCellForEdit="MOGH_DG_PreparingCellForEdit" BeginningEdit="MOGH_DG_BeginningEdit" CanUserAddRows="False" >

            <DataGrid.Style>
                <!--خط بندی سطر های دیتاگرید-->
                <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource MaterialDesignDataGrid}"> <Setter Property="materialDesign:DataGridAssist.EnableEditBoxAssist" Value="False"/>
                    <Setter Property="GridLinesVisibility" Value="All"/>
                </Style>
            </DataGrid.Style>

            <DataGrid.Columns>
                <DataGridTextColumn IsReadOnly="true" Header="تاریخ سند" Binding="{Binding DATE_S,UpdateSourceTrigger=LostFocus,StringFormat=####/##/##}" Width="Auto"/>
                <DataGridTextColumn IsReadOnly="true" Header="سند" Binding="{Binding N_S,UpdateSourceTrigger=LostFocus}" Width="Auto"/>
                <DataGridTextColumn IsReadOnly="true" Header="شرح" Binding="{Binding SHARH,UpdateSourceTrigger=LostFocus}" Width="Auto"/>
                <DataGridTextColumn IsReadOnly="true" Header="بدهکار" Binding="{Binding BED,UpdateSourceTrigger=LostFocus,StringFormat='#,#'}" Width="Auto"/>
                <DataGridTextColumn IsReadOnly="true" Header="بستانکار" Binding="{Binding BES,UpdateSourceTrigger=LostFocus,StringFormat='#,#'}" Width="Auto"/>

                <DataGridCheckBoxColumn x:Name="TICK_COLUMN" Header="تیک"  Binding="{Binding TICK, UpdateSourceTrigger=PropertyChanged}" Width="Auto">
                    <DataGridCheckBoxColumn.ElementStyle>
                        <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
                            <EventSetter Event="Click" Handler="TICK_COLUMN_Click" />
                        </Style>
                    </DataGridCheckBoxColumn.ElementStyle>
                    <DataGridCheckBoxColumn.EditingElementStyle>
                        <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
                        </Style>
                    </DataGridCheckBoxColumn.EditingElementStyle>
                </DataGridCheckBoxColumn>

                <DataGridTextColumn IsReadOnly="true" Header="شماره سری" Binding="{Binding N_SERI,UpdateSourceTrigger=LostFocus}" Width="Auto"/>
                <DataGridTextColumn IsReadOnly="true" Header="بانک" Binding="{Binding BANK,UpdateSourceTrigger=LostFocus}" Width="Auto"/>
                <DataGridTextColumn IsReadOnly="true" Header="شماره فاکتور" Binding="{Binding NUMBER,UpdateSourceTrigger=LostFocus}" Width="Auto"/>
                <DataGridTextColumn IsReadOnly="true" Header="برچسب" Binding="{Binding TAG,UpdateSourceTrigger=LostFocus}" Width="Auto"/>
            </DataGrid.Columns>

        </DataGrid>

        <Button x:Name="End" Tag ="RD" Click="End_Click" Style="{StaticResource GerdB}" BorderBrush="{x:Null}"
                                    RenderTransformOrigin="0.5,0.5"  FontSize="10" Margin="0,0,302,17" Height="26" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="34" Grid.Row="1">
            <materialDesign:PackIcon  Kind="SkipNext"  HorizontalAlignment="Center" VerticalAlignment="Center" Height="20" Width="21" Foreground="#CCFFFFFF" RenderTransformOrigin="0.206,0.45"  FontSize="10" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="26,-44,0,0" Margin="-19,0,-18,0">
                <materialDesign:PackIcon.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </materialDesign:PackIcon.RenderTransform>
            </materialDesign:PackIcon>
        </Button>
        <Button x:Name="First" Click="First_Click"  Tag ="RD"  Style="{StaticResource GerdB}" BorderBrush="{x:Null}"
                                    RenderTransformOrigin="0.5,0.5"  FontSize="10" Margin="0,0,498,17" HorizontalAlignment="Right" Width="34" Height="26" VerticalAlignment="Bottom" Grid.Row="1">
            <materialDesign:PackIcon Kind="SkipNext"  HorizontalAlignment="Right" VerticalAlignment="Top" Height="20" Width="23" Foreground="#CCFFFFFF" RenderTransformOrigin="0.515,0.533"  FontSize="10" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="-30,-1,-5,0">
                <materialDesign:PackIcon.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="-1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform X="4.946"/>
                    </TransformGroup>
                </materialDesign:PackIcon.RenderTransform>
            </materialDesign:PackIcon>
        </Button>
        <Button x:Name="Next" Click="Next_Click" Tag ="RD" Style="{StaticResource GerdB}" BorderBrush="{x:Null}"
                                    RenderTransformOrigin="0.5,0.5"  FontSize="10" Margin="0,0,344,17"  Height="26" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="34" Grid.Row="1">
            <materialDesign:PackIcon Kind="triangle"  HorizontalAlignment="Center" VerticalAlignment="Center" Height="15" Width="15" Foreground="#CCFFFFFF" RenderTransformOrigin="0.254,0.083"  FontSize="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0" Margin="-24,-13,-32,0">
                <materialDesign:PackIcon.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                        <SkewTransform/>
                        <RotateTransform Angle="90"/>
                        <TranslateTransform X="5" Y="10"/>
                    </TransformGroup>
                </materialDesign:PackIcon.RenderTransform>
            </materialDesign:PackIcon>
        </Button>
        <Button x:Name="Back"  Tag ="RD" Click="Back_Click" Style="{StaticResource GerdB}" BorderBrush="{x:Null}"
                                    RenderTransformOrigin="0.5,0.5"  FontSize="10" Margin="0,0,458,17" HorizontalAlignment="Right" Width="34"  Height="26" VerticalAlignment="Bottom" Grid.Row="1">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Button.RenderTransform>
            <materialDesign:PackIcon  Kind="triangle"  HorizontalAlignment="Center" VerticalAlignment="Center" Height="15" Width="15" Foreground="#CCFFFFFF" RenderTransformOrigin="0.254,0.083"  FontSize="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0" Margin="-24,-13,-32,0">
                <materialDesign:PackIcon.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                        <SkewTransform/>
                        <RotateTransform Angle="90"/>
                        <TranslateTransform X="5" Y="10"/>
                    </TransformGroup>
                </materialDesign:PackIcon.RenderTransform>
            </materialDesign:PackIcon>
        </Button>
        <Button x:Name="NEWRECORD_BTN" Click="NEWRECORD_BTN_Click"  Tag ="RD" Style="{StaticResource GerdB}" BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="10"  Margin="0,0,262,17" Height="26" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="34" Grid.Row="1" IsEnabled="False">
            <materialDesign:PackIcon Kind="AddBold"  HorizontalAlignment="Center" VerticalAlignment="Center" Height="15" Width="15" Foreground="#CCFFFFFF" RenderTransformOrigin="0.254,0.083"  FontSize="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0" Margin="-24,-13,-32,0">
                <materialDesign:PackIcon.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                        <SkewTransform/>
                        <RotateTransform Angle="90"/>
                        <TranslateTransform X="5" Y="10"/>
                    </TransformGroup>
                </materialDesign:PackIcon.RenderTransform>
            </materialDesign:PackIcon>
        </Button>
        <TextBox x:Name="RecCount"  HorizontalContentAlignment="Center" TextAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource FuzzyOut}" IsReadOnly="True" Tag="RD" Padding="7,0,10,0" Margin="0,0,185,15" VerticalAlignment="Bottom" FlowDirection="RightToLeft" Background="{x:Null}" BorderThickness="1" Height="30" HorizontalAlignment="Right" Width="72" Grid.Row="1" />
        <TextBox x:Name="Current_Rec"   HorizontalContentAlignment="Center" TextAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource FuzzyOut}" IsReadOnly="True" Tag="RD" Padding="7,0,10,0" Margin="0,0,383,15" VerticalAlignment="Bottom" FlowDirection="RightToLeft" Background="{x:Null}" BorderThickness="1" Height="30" HorizontalAlignment="Right" Width="72" Grid.Row="1" />
        <Button x:Name="SERVERRELOAD_Btn" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Tag ="RD"  Style="{StaticResource GerdB}" BorderBrush="{x:Null}"  FontSize="10" Margin="0,0,537,17" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="#DDFFFFFF" Height="26" Width="34" Click="SERVERRELOAD_Btn_Click" Grid.Row="1">
            <Viewbox Margin="-9,0,-9,0" >
                <materialDesign:PackIcon Kind="Refresh" />
            </Viewbox>
        </Button>


        <xctk:MaskedTextBox x:Name="MODATE" Tag="RD"  Style="{StaticResource FuzzyOut}" Padding="3"  Mask="0000/00/00" Height="30" Margin="0,90,53,0" TextWrapping="Wrap" VerticalAlignment="Top"  BorderThickness="1" FontSize="12"  HorizontalAlignment="Right" Width="88" TabIndex="0" />
        <Label Content="تاریخ:" HorizontalAlignment="Right" Margin="0,90,15,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <Label Content="عنوان:" HorizontalAlignment="Right" Margin="0,52,146,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <Label Content="شماره حساب:" HorizontalAlignment="Right" Margin="0,91,146,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <ComboBox x:Name="HES" DisplayMemberPath="NAME" SelectedValuePath="hes" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Margin="254,90,221,0" VerticalAlignment="Top" Height="30" FlowDirection="RightToLeft"   IsEditable="True"  Background="{x:Null}" BorderThickness="1">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <xctk:MaskedTextBox x:Name="FDATE" Tag="RD"  Style="{StaticResource FuzzyOut}" Padding="3"  Mask="0000/00/00" Height="30" Margin="16,51,0,0" TextWrapping="Wrap" VerticalAlignment="Top"  BorderThickness="1" FontSize="12"  HorizontalAlignment="Left" Width="88" TabIndex="0" />
        <Label Content="از تاریخ:" HorizontalAlignment="Left" Margin="105,51,0,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <xctk:MaskedTextBox x:Name="TDATE" Tag="RD"  Style="{StaticResource FuzzyOut}" Padding="3"  Mask="0000/00/00" Height="30" Margin="16,91,0,0" TextWrapping="Wrap" VerticalAlignment="Top"  BorderThickness="1" FontSize="12"  HorizontalAlignment="Left" Width="88" TabIndex="0" />
        <Label Content="تا تاریخ:" HorizontalAlignment="Left" Margin="105,91,0,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <Button x:Name="CHATP_BTN" Content="چاپ مغایرت"  BorderBrush="{x:Null}" FontSize="12" Foreground="#DDFFFFFF" Margin="0,67,105,0" Height="40" VerticalAlignment="Top" Grid.Row="1" HorizontalAlignment="Right" Width="171" Click="CHATP_BTN_Click" />
        <Label Content="جمع کل:" HorizontalAlignment="Left" Margin="319,8,0,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto" Grid.Row="1"/>
        <Label Content="جمع تیک خورده:" HorizontalAlignment="Left" Margin="319,44,0,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto" Grid.Row="1"/>
        <Label Content="مانده تیک نخورده:" HorizontalAlignment="Left" Margin="319,80,0,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto" Grid.Row="1"/>
        <CNC:NumericTextBox x:Name="SBED" DoesAcceptDouble="False" LastValueShouldZero="False" Text="0" DigitGroupOnEnter="True" IsDigitGroupActive="True" Height="30" Margin="166,8,0,0" VerticalAlignment="Top" Visibility="Visible"  HorizontalAlignment="Left" Width="152" Grid.Row="1" IsReadOnly="True"/>
        <CNC:NumericTextBox x:Name="SBES" DoesAcceptDouble="False" LastValueShouldZero="False" Text="0" DigitGroupOnEnter="True" IsDigitGroupActive="True" Height="30" Margin="9,7,0,0" VerticalAlignment="Top" Visibility="Visible"  HorizontalAlignment="Left" Width="152" Grid.Row="1" IsReadOnly="True"/>
        <CNC:NumericTextBox x:Name="STBED" DoesAcceptDouble="False" LastValueShouldZero="False" Text="0" DigitGroupOnEnter="True" IsDigitGroupActive="True" Height="30" Margin="166,44,0,0" VerticalAlignment="Top" Visibility="Visible"  HorizontalAlignment="Left" Width="152" Grid.Row="1" IsReadOnly="True"/>
        <CNC:NumericTextBox x:Name="STBES" DoesAcceptDouble="False" LastValueShouldZero="False" Text="0" DigitGroupOnEnter="True" IsDigitGroupActive="True" Height="30" Margin="9,43,0,0" VerticalAlignment="Top" Visibility="Visible"  HorizontalAlignment="Left" Width="152" Grid.Row="1" IsReadOnly="True"/>
        <CNC:NumericTextBox x:Name="UTICK_SBED" DoesAcceptDouble="False" LastValueShouldZero="False" Text="0" DigitGroupOnEnter="True" IsDigitGroupActive="True" Height="30" Margin="166,80,0,0" VerticalAlignment="Top" Visibility="Visible"  HorizontalAlignment="Left" Width="152" Grid.Row="1" IsReadOnly="True"/>
        <CNC:NumericTextBox x:Name="UTICK_SBES" DoesAcceptDouble="False" LastValueShouldZero="False" Text="0" DigitGroupOnEnter="True" IsDigitGroupActive="True" Height="30" Margin="9,79,0,0" VerticalAlignment="Top" Visibility="Visible"  HorizontalAlignment="Left" Width="152" Grid.Row="1" IsReadOnly="True"/>

        <Button x:Name="BTN_SAVE" Content="ذخیره"  BorderBrush="{x:Null}" FontSize="12" Foreground="#DDFFFFFF" Margin="0,8,34,0" Height="40" VerticalAlignment="Top" HorizontalAlignment="Right" Width="132" Grid.Row="1" Click="BTN_SAVE_Click" IsEnabled="False" Visibility="Collapsed" />

    </Grid>
</Window>

