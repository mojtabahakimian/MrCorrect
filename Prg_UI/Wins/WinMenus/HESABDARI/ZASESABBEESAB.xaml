<Window x:Class="Wins.WinMenus.HESABDARI.ZASESABBEESAB"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wins.WinMenus.HESABDARI"
        mc:Ignorable="d"
        
        MaxHeight="360"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:sfusion="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="{StaticResource IRANYEKAN}"
        WindowStartupLocation="CenterScreen"
        MinHeight="360" MinWidth="702" MaxWidth="702" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="mygrid">
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="643,410,328,158"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label Content="جایگزینی حساب" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" IsEnabled="False" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                                                   Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <!--Start.......................................................................................-->


        <Label Content="تبدیل از حساب:" Margin="0,63,36,0" HorizontalAlignment="Right" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>

        <xctk:MaskedTextBox x:Name="DT1" Style="{StaticResource FuzzyOut}" Text="10000101" Padding="3"  Mask="0000/00/00" Height="30" Margin="0,144,128,0" TextWrapping="Wrap" VerticalAlignment="Top"  BorderThickness="1" FontSize="12"  HorizontalAlignment="Right" Width="88" PreviewLostKeyboardFocus="DT1_PreviewLostKeyboardFocus" />
        <TextBox x:Name="AZHES"   Text="" Height="30" Margin="440,64,128,0"    Style="{StaticResource FuzzyOut}" Padding="3"    TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible" MaxLength="48" PreviewLostKeyboardFocus="AZHES_PreviewLostKeyboardFocus" />
        <Label Content="تبدیل بــه حساب:" Margin="0,103,29,0" HorizontalAlignment="Right" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <Label Content="از تاریخ:" Margin="579,145,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <Label Content="از سند شماره:" Margin="579,185,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <Label Content="تا سند شماره:" Margin="380,185,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <Label Content="تا تاریخ:" Margin="436,145,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <Label Content="محدوده شماره سند برای چکها و ویزیتور لحاظ نمیشود و فقط محدوده تاریخی اعمال میشود" Margin="1,0,0,21" VerticalAlignment="Bottom" FlowDirection="RightToLeft" Foreground="#DDD00000" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        <TextBox x:Name="AZHES2"   Text="" Height="30" Margin="33,64,267,0"    Style="{StaticResource FuzzyOut}" Padding="3"    TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible" MaxLength="48" PreviewLostKeyboardFocus="AZHES2_PreviewLostKeyboardFocus" />
        <TextBox x:Name="TOHES"   Text="" Height="30" Margin="440,103,128,0"    Style="{StaticResource FuzzyOut}" Padding="3"    TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible" MaxLength="48" PreviewLostKeyboardFocus="TOHES_PreviewLostKeyboardFocus" />
        <TextBox x:Name="TOHES2"   Text="" Height="30" Margin="33,103,267,0"    Style="{StaticResource FuzzyOut}" Padding="3"    TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible" MaxLength="48" PreviewLostKeyboardFocus="TOHES2_PreviewLostKeyboardFocus" />
        <xctk:MaskedTextBox x:Name="DT2" Style="{StaticResource FuzzyOut}" Padding="3" Text="99991230" Mask="0000/00/00" Height="30" Margin="0,144,267,0" TextWrapping="Wrap" VerticalAlignment="Top"  BorderThickness="1" FontSize="12"  HorizontalAlignment="Right" Width="88" PreviewLostKeyboardFocus="DT2_PreviewLostKeyboardFocus" />
        <CNC:NumericTextBox DoesAcceptDouble="False" LastValueShouldZero="False" Text="" x:Name="SNDNUM1"  Height="30" Margin="0,184,128,0" VerticalAlignment="Top" Visibility="Visible"  HorizontalAlignment="Right" Width="114"  />

        <UniformGrid Columns="2" Rows="1" Margin="33,232,37,60" FlowDirection="RightToLeft">
            <Button Style="{StaticResource MaterialDesignFlatButton}"  Margin="10" Content="شروع" BorderBrush="{x:Null}" FontSize="12" Height="34" Click="Button_Click_1"  />
            <Button Style="{StaticResource MaterialDesignFlatButton}" Margin="10"  Content="بستن" BorderBrush="{x:Null}" FontSize="12" Height="34" Foreground="#FF337694" Click="Button_Click"/>

        </UniformGrid>
        <CNC:NumericTextBox DoesAcceptDouble="False" LastValueShouldZero="False" Text="" x:Name="SNDNUM2" Height="30" Margin="0,185,322,0" VerticalAlignment="Top" Visibility="Visible"  HorizontalAlignment="Right" Width="114"  />
    </Grid>
</Window>
