<Window x:Class="Prg_UI.Wins.WinMenus.HESABDARI.R_DAFTAR_MOIN_LIST"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.HESABDARI"
        mc:Ignorable="d"
        
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:sfusion="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        FontFamily="{StaticResource IRANYEKAN}"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        WindowState="Maximized"
        Title="" Height="415" Width="1024" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>
        <!-- Style for SfDataGrid -->
        <Style x:Key="KDG"  TargetType="syncfusion:SfDataGrid" BasedOn="{StaticResource SfDataGridStyle}">
            <Setter Property="CurrentCellBorderBrush" Value="{StaticResource GENERAL_Grlicom}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="BorderBrush" Value="{StaticResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="HeaderRowHeight" Value="40" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="GridLinesVisibility" Value="Both" />
        </Style>
        <!-- Modified Column Header Style -->
        <Style x:Key="KDGHeader" TargetType="syncfusion:GridHeaderCellControl" BasedOn="{StaticResource GridHeaderCellControlStyle}">
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="BorderBrush" Value="{Binding Background, ElementName=GENERAL_RANG}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="Auto"/>
        </Style>

        <Style TargetType="sfusion:GridCell" BasedOn="{StaticResource GridCellStyle}">
            <Setter Property="BorderBrush" Value="{Binding BorderBrush, ElementName=GENERAL_RANG}" />
        </Style>


        <!-- Context Menu defined in XAML -->
        <ContextMenu x:Key="DataGridContextMenu" FontFamily="{StaticResource IRANYEKAN}">
            <MenuItem Header="پالودن با این بخش" Click="FilterBySelection_Click">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="Filter"  FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <!--Filter Excluding Selection-->
            <MenuItem Header="پالودن بدون این بخش" Click="FilterExcludingSelection_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FilterRemove" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="کـپـی" Click="MenuItem_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="ContentCopy" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="حذف پالودن (فیلتر)" Click="RemoveFilterSort_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FilterRemoveOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="خروجی اکسل" Click="EXPORTEXCEL_BTN" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FileExcelOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>

            <Separator/>
            <MenuItem Header="ریشه مانده نهایی" InputGestureText="1" Click="MenuItem_Click_2">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="ArrowUpBoldCircleOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="ریشه مانده سطر انتخابی" InputGestureText="Ctrl+1" Click="MenuItem_Click_3">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="ArrowUpCircleOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="mygrid">
        <Border  	  Background="{DynamicResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5"  Grid.ColumnSpan="5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{DynamicResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label x:Name="Label_hesab" Content="نتیجه لیست دفتر تفضیلی" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="95,56,0,0" Opacity="0.2" Width="1"/>
        <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
            <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
        </Button>
        <!--EndOfHeader ↑-->
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True" Grid.RowSpan="2">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
             Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <DataGrid x:Name="mOIN132DataGrid" IsReadOnly="True" Visibility="Hidden" ColumnHeaderStyle="{StaticResource CenteryHeaderstyle}" FlowDirection="RightToLeft"  Style="{StaticResource DATAGRIDSTYLISH}" AutoGenerateColumns="False" EnableRowVirtualization="True" Margin="10,45,10,10" HorizontalGridLinesBrush="{StaticResource GENERAL_Grlicom}" VerticalGridLinesBrush="{StaticResource GENERAL_Grlicom}" ScrollViewer.HorizontalScrollBarVisibility="Auto">

            <!--<DataGrid.Columns>
                <DataGridTextColumn x:Name="n_SColumn" Binding="{Binding N_S}" Header="شماره سند"  MinWidth="50"  Width="auto" />
                <DataGridTextColumn x:Name="_baseColumn" Binding="{Binding base}" Header="" Visibility="Hidden"  MinWidth="50"  Width="auto" />
                <DataGridTextColumn x:Name="dATE_SColumn" Binding="{Binding DATE_S,StringFormat=####/##/##}" Header="تاریخ سند"  MinWidth="50"  Width="auto" />
                <DataGridTextColumn x:Name="nUMBERColumn" Binding="{Binding NUMBER}" Header="حواله"  MinWidth="50"  Width="auto" />
                <DataGridTextColumn x:Name="sHARHColumn" Binding="{Binding SHARH}" Header="شرح"  MinWidth="200"  Width="auto" />
                <DataGridTextColumn x:Name="bEDColumn" Binding="{Binding BED,StringFormat='#,#'}" Header="بدهکار"  MinWidth="50"  Width="auto" />
                <DataGridTextColumn x:Name="bESColumn" Binding="{Binding BES,StringFormat='#,#'}" Header="بستانکار"  MinWidth="50"  Width="auto" />

                <DataGridTextColumn x:Name="tshColumn" Binding="{Binding TSH}" Header="تشخیص"  MinWidth="50"  Width="auto" />

                <DataGridTextColumn x:Name="mANDColumn" Binding="{Binding MAND,StringFormat='#,#'}" Header="مانده"  MinWidth="50"  Width="auto" />
                <DataGridTextColumn x:Name="aRZDColumn" Binding="{Binding ARZD}" Header="نرخ ارز"  MinWidth="50"  Width="auto" />

                <DataGridTextColumn x:Name="hES_KColumn" Binding="{Binding HES_K}" Visibility="Hidden" Header="حساب کل"  MinWidth="50"  Width="auto" />
                <DataGridTextColumn x:Name="hES_MColumn" Binding="{Binding HES_M}" Visibility="Hidden" Header="حساب معین"  MinWidth="50"  Width="auto" />
                <DataGridTextColumn x:Name="hES_TColumn" Binding="{Binding HES_T}" Visibility="Hidden" Header="تفضیلی"  MinWidth="50"  Width="auto" />
                <DataGridTextColumn x:Name="hES_T2Column" Binding="{Binding HES_T2}" Visibility="Hidden" Header="تفضیلی 2"  MinWidth="50"  Width="auto" />
                <DataGridTextColumn x:Name="idColumn" Binding="{Binding id}"  Header="id" Visibility="Hidden"  MinWidth="50"  Width="auto" />
                <DataGridTextColumn x:Name="nO_SColumn" Binding="{Binding NO_S}" Visibility="Hidden" Header="نوع سند"  MinWidth="50"  Width="auto" />
                <DataGridTextColumn x:Name="n_SERIColumn" Binding="{Binding N_SERI}" Visibility="Hidden" Header="شماره سریال"  MinWidth="50"  Width="auto" />
                <DataGridTextColumn x:Name="bANKColumn" Binding="{Binding BANK}" Visibility="Hidden" Header="بانک"  MinWidth="50"  Width="auto" />
                <DataGridTextColumn x:Name="tAGColumn" Binding="{Binding TAG}" Visibility="Hidden" Header="نوع فاکتور"  MinWidth="50"  Width="auto" />
                <DataGridTextColumn x:Name="hES_T3Column" Binding="{Binding HES_T3}" Visibility="Hidden" Header="تفضیلی 3"  MinWidth="50"  Width="auto" />
                <DataGridTextColumn x:Name="hES_T4Column" Binding="{Binding HES_T4}" Visibility="Hidden" Header="تفضیلی 4"  MinWidth="50"  Width="auto" />
                <DataGridTextColumn x:Name="tAFZILNColumn" Binding="{Binding TAFZILN}" Visibility="Hidden" Header="نام حساب تفضیلی 2"  MinWidth="50"  Width="auto" />
                <DataGridTextColumn x:Name="hESColumn" Binding="{Binding HES}" Visibility="Hidden" Header="حساب"  MinWidth="50"  Width="auto" />

            </DataGrid.Columns>-->
        </DataGrid>

        <syncfusion:SfDataGrid x:Name="SYNCFUSION_DG" ContextMenu="{StaticResource DataGridContextMenu}"
                ItemsSource="{Binding DAFTAR_DATA}" FilterRowPosition="Top"
                AutoGenerateColumns="False"
                AllowEditing="True"
                EnableDataVirtualization="True"
                SelectionUnit="Row"
                IsReadOnly="True"
                              
                SelectionMode="Extended"
                AllowDraggingColumns="True"
                AllowResizingColumns="True"
                AllowFiltering="True"
                AllowSorting="True"
                RowHeight="30"
                FrozenColumnCount="0"
                FlowDirection="RightToLeft"
                d:ItemsSource="{d:SampleData ItemCount=5}"
                Style="{StaticResource KDG}"
                HeaderStyle="{StaticResource KDGHeader}"
                PreviewMouseRightButtonDown="SYNCFUSION_DG_PreviewMouseRightButtonDown"
                CurrentCellActivated="SYNCFUSION_DG_CurrentCellActivated"
                Margin="10,49,10,10" AllowRowHoverHighlighting="True" AllowSelectionOnPointerPressed="True" ScrollMode="Async" ShowRowHeader="True" ShowGroupDropArea="True" SelectionChanged="SYNCFUSION_DG_SelectionChanged" PreviewKeyDown="SYNCFUSION_DG_PreviewKeyDown">

            <syncfusion:SfDataGrid.Resources>
                <ResourceDictionary>
                    <Style TargetType="TextBox">
                        <Setter Property="AcceptsReturn" Value="True" />
                        <Setter Property="Height" Value="40" />
                    </Style>
                </ResourceDictionary>
            </syncfusion:SfDataGrid.Resources>

            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn x:Name="n_SColumn" HeaderText="شماره سند" MappingName="N_S" Width="100" />
                <syncfusion:GridTextColumn x:Name="_baseColumn" HeaderText="" MappingName="base" IsHidden="True" />
                <syncfusion:GridTextColumn x:Name="dATE_SColumn" HeaderText="تاریخ سند" MappingName="DATE_S" Width="110">
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="DATE_S" StringFormat="####/##/##" />
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>
                <syncfusion:GridTextColumn x:Name="nUMBERColumn" HeaderText="حواله" MappingName="NUMBER" Width="100"  />
                <syncfusion:GridTextColumn x:Name="sHARHColumn" HeaderText="شرح" MappingName="SHARH" Width="550" ColumnSizer="AutoLastColumnFill"/>
                <syncfusion:GridTextColumn x:Name="bEDColumn" HeaderText="بدهکار" MappingName="BED" Width="150" >
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="BED"  StringFormat="{}{0:#,0;#,0}" />
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>
                <syncfusion:GridTextColumn x:Name="bESColumn" HeaderText="بستانکار" MappingName="BES" Width="150"  >
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="BES"  StringFormat="{}{0:#,0;#,0}" />
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>
                <syncfusion:GridTextColumn x:Name="tshColumn" HeaderText="تش" MappingName="TSH" Width="60" TextAlignment="Center"/>
                <syncfusion:GridTextColumn x:Name="mANDColumn" HeaderText="مانده" MappingName="MAND"  Width="150" >
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="MAND"  StringFormat="{}{0:#,0;#,0}" />
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>

                <syncfusion:GridTextColumn x:Name="aRZDColumn" HeaderText="نرخ ارز" MappingName="ARZD">
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="ARZD"  StringFormat="{}{0:#,0;#,0}" />
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>
                <syncfusion:GridTextColumn x:Name="hES_KColumn" HeaderText="حساب کل" MappingName="HES_K" IsHidden="True"  />
                <syncfusion:GridTextColumn x:Name="hES_MColumn" HeaderText="حساب معین" MappingName="HES_M" IsHidden="True"  />
                <syncfusion:GridTextColumn x:Name="hES_TColumn" HeaderText="تفضیلی" MappingName="HES_T" IsHidden="True"  />
                <syncfusion:GridTextColumn x:Name="hES_T2Column"  HeaderText="تفضیلی 2" MappingName="HES_T2" IsHidden="True"  />
                <syncfusion:GridTextColumn x:Name="idColumn" HeaderText="id" MappingName="id" IsHidden="True"  />
                <syncfusion:GridTextColumn x:Name="nO_SColumn" HeaderText="نوع سند" MappingName="NO_S" IsHidden="True"  />
                <syncfusion:GridTextColumn x:Name="n_SERIColumn" HeaderText="شماره سریال" MappingName="N_SERI" IsHidden="True"  />
                <syncfusion:GridTextColumn x:Name="bANKColumn" HeaderText="بانک" MappingName="BANK" IsHidden="True"  />
                <syncfusion:GridTextColumn x:Name="tAGColumn" HeaderText="نوع فاکتور" MappingName="TAG" IsHidden="True"  />
                <syncfusion:GridTextColumn x:Name="hES_T3Column" HeaderText="تفضیلی 3" MappingName="HES_T3" IsHidden="True"  />
                <syncfusion:GridTextColumn x:Name="hES_T4Column" HeaderText="تفضیلی 4" MappingName="HES_T4" IsHidden="True"  />
                <syncfusion:GridTextColumn x:Name="tAFZILNColumn" HeaderText="نام حساب تفضیلی 2" MappingName="TAFZILN" IsHidden="True"  />
                <syncfusion:GridTextColumn x:Name="hESColumn" HeaderText="حساب" MappingName="HES" IsHidden="True"  />
            </syncfusion:SfDataGrid.Columns>


        </syncfusion:SfDataGrid>

    </Grid>
</Window>
