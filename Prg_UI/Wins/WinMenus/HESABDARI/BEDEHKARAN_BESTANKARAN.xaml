<Window x:Class="Wins.WinMenus.HESABDARI.BEDEHKARAN_BESTANKARAN"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wins.WinMenus.HESABDARI"
        mc:Ignorable="d"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:sfusion="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="{StaticResource IRANYEKAN}" d:Width="2000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Title="" Height="450" Width="800" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>
        <!-- Style for SfDataGrid -->
        <Style x:Key="KDG"  TargetType="syncfusion:SfDataGrid" BasedOn="{StaticResource SfDataGridStyle}">
            <Setter Property="CurrentCellBorderBrush" Value="{StaticResource GENERAL_Grlicom}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="BorderBrush" Value="{StaticResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="HeaderRowHeight" Value="40" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="GridLinesVisibility" Value="Both" />
        </Style>
        <!-- Modified Column Header Style -->
        <Style x:Key="KDGHeader" TargetType="syncfusion:GridHeaderCellControl" BasedOn="{StaticResource GridHeaderCellControlStyle}">
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="BorderBrush" Value="{Binding Background, ElementName=GENERAL_RANG}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="Auto"/>
        </Style>
        <Style TargetType="sfusion:GridCell" BasedOn="{StaticResource GridCellStyle}">
            <Setter Property="BorderBrush" Value="{Binding BorderBrush, ElementName=GENERAL_RANG}" />
        </Style>
        <!-- Context Menu defined in XAML -->
        <ContextMenu x:Key="DataGridContextMenu" FontFamily="{StaticResource IRANYEKAN}">
            <!--Filter By Selection-->
            <MenuItem Header="پالودن با این بخش" Click="FilterBySelection_Click" />
            <!--Filter Excluding Selection-->
            <MenuItem Header="پالودن بدون این بخش" Click="FilterExcludingSelection_Click" />
            <Separator/>
            <!--Remove Filter/Sort-->
            <MenuItem Header="حذف پالودن (فیلتر)" Click="RemoveFilterSort_Click" />
            <Separator/>
            <MenuItem Header="خروجی اکسل" Click="EXPORTEXCEL_BTN" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FileExcelOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>


    </Window.Resources>

    <Grid x:Name="mygrid">
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="557,410,462,353"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label x:Name="WINTILENAME" Content="لیست بدهکاران و بستانکاران" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                                                       Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <!--HEADER↑-->

        <syncfusion:SfDataGrid x:Name="SYNCFUSION_DG" ContextMenu="{StaticResource DataGridContextMenu}" 
            ItemsSource="{Binding FACTOR_DATA}" 
            AutoGenerateColumns="False"     
            EnableDataVirtualization="True"
            SelectionUnit="Row"
            IsReadOnly="True"
            
            AllowDraggingColumns="True"
            AllowResizingColumns="True"
            AllowFiltering="True"
            AllowSorting="True"
            RowHeight="30"
            SelectionMode="Extended"                   
            FrozenColumnCount="0"
            FlowDirection="RightToLeft"
            d:ItemsSource="{d:SampleData ItemCount=5}"
            Style="{StaticResource KDG}"
            HeaderStyle="{StaticResource KDGHeader}"
            CurrentCellActivated="SYNCFUSION_DG_CurrentCellActivated"
            Margin="10,49,10,50" AllowRowHoverHighlighting="True" AllowSelectionOnPointerPressed="True" ScrollMode="Async" ShowRowHeader="True" ShowGroupDropArea="True" SelectionChanged="SYNCFUSION_DG_SelectionChanged">

            <syncfusion:SfDataGrid.Columns>

                <syncfusion:GridTemplateColumn MappingName="IsButtony" HeaderText="" IsReadOnly="True" AllowResizing="False" ColumnSizer="Auto" AllowFiltering="False" AllowSorting="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button 
                                    IsTabStop="False"
                                    Click="Button_Click"
                                    Tag="{Binding}"
                                    materialDesign:ButtonAssist.CornerRadius="1"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    VerticalContentAlignment="Center"
                                    HorizontalContentAlignment="Center">
                                <materialDesign:PackIcon Kind="Plus"/>
                            </Button>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                    <syncfusion:GridTemplateColumn.CellStyle>
                        <Style TargetType="sfusion:GridCell">
                            <Setter Property="IsTabStop" Value="False"/>
                            <Setter Property="Focusable" Value="False"/>
                        </Style>
                    </syncfusion:GridTemplateColumn.CellStyle>
                </syncfusion:GridTemplateColumn>
                <syncfusion:GridTemplateColumn MappingName="IsButtony" HeaderText="" IsReadOnly="True" AllowResizing="False" Width="60" AllowFiltering="False" AllowSorting="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button 
                                IsTabStop="False"
                                Click="Button_Click_1"
                                Tag="{Binding}"
                                materialDesign:ButtonAssist.CornerRadius="1"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Center">
                                <materialDesign:PackIcon Kind="InvoiceListOutline"/>
                            </Button>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                    <syncfusion:GridTemplateColumn.CellStyle>
                        <Style TargetType="sfusion:GridCell">
                            <Setter Property="IsTabStop" Value="False"/>
                            <Setter Property="Focusable" Value="False"/>
                        </Style>
                    </syncfusion:GridTemplateColumn.CellStyle>
                </syncfusion:GridTemplateColumn>
                <syncfusion:GridTextColumn HeaderText="کد کل" MappingName="HES_K" Width="100"/>
                <syncfusion:GridTextColumn HeaderText="کد معین" MappingName="HES_M" Width="110" />
                <syncfusion:GridTextColumn HeaderText="کد تفضیلی" MappingName="HES_T" Width="120"/>
                <syncfusion:GridTextColumn HeaderText="کد حساب" MappingName="HES" Width="130"/>
                <syncfusion:GridTextColumn HeaderText="نام تفضیلی" MappingName="tafname" Width="250" />

                <syncfusion:GridTextColumn HeaderText="جمع بدهکار" MappingName="SumOfBED">
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="SumOfBED" StringFormat="{}{0:#,0}" />
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>

                <syncfusion:GridTextColumn HeaderText="جمع بستانکار" MappingName="SumOfBES">
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="SumOfBES"  StringFormat="{}{0:#,0}" />
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>

                <syncfusion:GridTextColumn HeaderText="مانده بدهکار" MappingName="BEDM">
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="BEDM"  StringFormat="{}{0:#,0}" />
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>

                <syncfusion:GridTextColumn HeaderText="مانده بستانکار" MappingName="BESM">
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="BESM"  StringFormat="{}{0:#,0}" />
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>

                <syncfusion:GridTextColumn HeaderText="نام حساب کل" MappingName="NAME" />
                <syncfusion:GridTextColumn HeaderText="نام حساب معین" MappingName="MOIN" />
                <syncfusion:GridTextColumn HeaderText="حساب تفضیلی" MappingName="TAFZIL" />

                <syncfusion:GridTextColumn HeaderText="توضیحات" MappingName="TOZIH" />
                <syncfusion:GridTextColumn HeaderText="آدرس" MappingName="ADDRESS" />
                <syncfusion:GridTextColumn HeaderText="تلفن" MappingName="TEL" />
                <syncfusion:GridTextColumn HeaderText="سایر" MappingName="CODE_E" />
                <syncfusion:GridTextColumn HeaderText="سایر" MappingName="CODE_E" />
                <syncfusion:GridTextColumn HeaderText="کد اقتصادی" MappingName="ECODE" />
                <syncfusion:GridTextColumn HeaderText="نوع مشتری" MappingName="CUST_COD" />
                <syncfusion:GridTextColumn HeaderText="مسیر ویزیت" MappingName="ROUTE_NAME" />
                <syncfusion:GridTextColumn HeaderText="کد ویزیتور" MappingName="VCOD" />
                <syncfusion:GridTextColumn HeaderText="نام ویزیتور" MappingName="VNAME" />
                <syncfusion:GridTextColumn HeaderText="تفضیلی 2" MappingName="HES_T2" />
                <syncfusion:GridTextColumn HeaderText="تفضیلی 3" MappingName="HES_T3" />
                <syncfusion:GridTextColumn HeaderText="تفضیلی 4" MappingName="HES_T4" />
                <syncfusion:GridTextColumn HeaderText="استان" MappingName="OSTANID" />
                <syncfusion:GridTextColumn HeaderText="شهر" MappingName="SHAHRID" />


                <!--<syncfusion:GridDateTimeColumn x:Name="CRT_COLUMN" HeaderText="تاریخ ایجاد فاکتور" MappingName="CRT" Pattern="FullDateTime"/>-->

            </syncfusion:SfDataGrid.Columns>

        </syncfusion:SfDataGrid>
        <Label Content="تعداد رکورد ها:" Margin="0,0,11,10" FlowDirection="RightToLeft" Width="84" HorizontalAlignment="Right" Height="27" VerticalAlignment="Bottom"/>
        <TextBlock x:Name="ROWCOUNT_TEXTBLK" Text=""  Margin="0,0,95,10"  FlowDirection="RightToLeft" Width="230" HorizontalAlignment="Right" Height="23" VerticalAlignment="Bottom"/>

    </Grid>
</Window>
