<Window x:Class="Wins.WinMenus.HESABDARI.WIN_ALLSANAD"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wins.WinMenus.HESABDARI"
        mc:Ignorable="d"

        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:sfusion="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        FontFamily="IRANYekanFN"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        WindowState="Maximized"
        Title="" Height="415" Width="1024" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>
        <!-- Style for SfDataGrid -->
        <Style x:Key="KDG"  TargetType="syncfusion:SfDataGrid" BasedOn="{StaticResource SfDataGridStyle}">
            <Setter Property="CurrentCellBorderBrush" Value="{StaticResource GENERAL_Grlicom}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="BorderBrush" Value="{StaticResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="HeaderRowHeight" Value="40" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="GridLinesVisibility" Value="Both" />
        </Style>
        <!-- Modified Column Header Style -->
        <Style x:Key="KDGHeader" TargetType="syncfusion:GridHeaderCellControl" BasedOn="{StaticResource GridHeaderCellControlStyle}">
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="BorderBrush" Value="{Binding Background, ElementName=GENERAL_RANG}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="Auto"/>
        </Style>

        <Style TargetType="sfusion:GridCell" BasedOn="{StaticResource GridCellStyle}">
            <Setter Property="BorderBrush" Value="{Binding BorderBrush, ElementName=GENERAL_RANG}" />
        </Style>

        <!-- Context Menu defined in XAML -->
        <ContextMenu x:Key="DataGridContextMenu" FontFamily="IRANYekanFN">
            <MenuItem Header="پالودن با این بخش" Click="FilterBySelection_Click">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="Filter"  FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <!--Filter Excluding Selection-->
            <MenuItem Header="پالودن بدون این بخش" Click="FilterExcludingSelection_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FilterRemove" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="کـپـی" Click="MenuItem_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="ContentCopy" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="حذف پالودن (فیلتر)" Click="RemoveFilterSort_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FilterRemoveOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="خروجی اکسل" Click="EXPORTEXCEL_BTN" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FileExcelOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <ContextMenu x:Key="ContextUtilityMenu1" FontSize="12" FontFamily="IRANYekanFN">
            <MenuItem Header="صورت حساب" x:Name="F8_CUSTOMER" Click="F8_CUSTOMER_Click">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FileDocument"/>
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="کپـــی | Copy" Click="COPY_CLICK" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="ContentCopy" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="خروجی اکسل" Click="EXPORTEXCEL_BTNSUB" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FileExcelOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="mygrid">
        <Border  	  Background="{DynamicResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5"  Grid.ColumnSpan="5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{DynamicResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label x:Name="Label_hesab" Content="کلیه اسناد" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="95,56,0,0" Opacity="0.2" Width="1"/>
        <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
            <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
        </Button>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True" Grid.RowSpan="2">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                             Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <!--EndOfHeader ↑-->

        <Grid>
            <!-- Define two rows for the horizontal layout -->
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="5" />
                <!-- Height of the splitter -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top content -->
            <syncfusion:SfDataGrid x:Name="SYNCFUSION_DG" ContextMenu="{StaticResource DataGridContextMenu}" Grid.Row="0"
                     ItemsSource="{Binding HEADSANAD_DATA}" 
                     AutoGenerateColumns="False"
                     AllowEditing="True"
                     EnableDataVirtualization="True"
                     SelectionUnit="Row"
                     IsReadOnly="True"
                                   
                     ColumnSizer="Star"       
                     SelectionMode="Extended"
                     AllowDraggingColumns="True"
                     AllowResizingColumns="True"
                     AllowFiltering="True"
                     AllowSorting="True"
                     RowHeight="30"
                     FrozenColumnCount="0"
                     FlowDirection="RightToLeft"
                     d:ItemsSource="{d:SampleData ItemCount=5}"
                     Style="{StaticResource KDG}"
                     HeaderStyle="{StaticResource KDGHeader}"
                     PreviewMouseRightButtonDown="SYNCFUSION_DG_PreviewMouseRightButtonDown"
                     CurrentCellActivated="SYNCFUSION_DG_CurrentCellActivated"
                     Margin="10,49,10,10" AllowRowHoverHighlighting="True" AllowSelectionOnPointerPressed="True" ScrollMode="Async" ShowRowHeader="True" ShowGroupDropArea="True" SelectionChanged="SYNCFUSION_DG_SelectionChanged" PreviewKeyDown="SYNCFUSION_DG_PreviewKeyDown">

                <syncfusion:SfDataGrid.Columns>
                    <syncfusion:GridTextColumn HeaderText="شماره سند" MappingName="N_S" Width="100" />
                    <syncfusion:GridTextColumn HeaderText="تاریخ سند" MappingName="DATE_S" Width="110">
                        <syncfusion:GridTextColumn.DisplayBinding>
                            <Binding Path="DATE_S" StringFormat="####/##/##" />
                        </syncfusion:GridTextColumn.DisplayBinding>
                    </syncfusion:GridTextColumn>

                    <syncfusion:GridTextColumn HeaderText="شرح" MappingName="SHARH_S" Width="550"/>
                    <syncfusion:GridTextColumn HeaderText="شماره مبنا" MappingName="base" Width="100" />
                    <syncfusion:GridTextColumn HeaderText="شماره بایگانی" MappingName="BAYEG" Width="130" />
                    <syncfusion:GridTextColumn HeaderText="نوع سند" MappingName="NO_S" Width="130" />
                    <syncfusion:GridCheckBoxColumn HeaderText="قطعی" MappingName="GHATEI" Width="80" />
                    <syncfusion:GridCheckBoxColumn HeaderText="تایید" MappingName="OKF" Width="80" />
                    <syncfusion:GridTextColumn HeaderText="تاریخ ایجاد" MappingName="CRT" MaximumWidth="170"/>
                    <syncfusion:GridTextColumn HeaderText="نام کاربری" MappingName="USER_NAME"  ColumnSizer="AutoLastColumnFill"/>
                </syncfusion:SfDataGrid.Columns>
            </syncfusion:SfDataGrid>

            <!-- GridSplitter for resizing -->
            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="{Binding ElementName=GENERAL_RANG,Path=Background}" VerticalAlignment="Center"/>

            <DataGrid x:Name="SANAD_DETAIL" AutoGenerateColumns="False"  Grid.Row="2" ContextMenuOpening="SANAD_DETAIL_ContextMenuOpening" MouseRightButtonUp="SANAD_DETAIL_MouseRightButtonUp"
                    ContextMenu="{StaticResource ContextUtilityMenu1}" 
                    ColumnHeaderStyle="{StaticResource CenteryHeaderstyle}"
                    CellStyle="{StaticResource CellFocusyBorder}"
                    HorizontalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                    VerticalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                    ItemsSource = "{Binding SANAD_DATA}"
                    FlowDirection="RightToLeft" EnableRowVirtualization="True" Margin="9,4,9,45" CanUserDeleteRows="False" PreviewKeyDown="SANAD_DETAIL_PreviewKeyDown">
                <DataGrid.Style>
                    <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource MaterialDesignDataGrid}"> <Setter Property="materialDesign:DataGridAssist.EnableEditBoxAssist" Value="False"/>
                        <Setter Property="GridLinesVisibility" Value="All"/>
                    </Style>
                </DataGrid.Style>
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="hESColumn" Binding="{Binding HES, UpdateSourceTrigger=LostFocus}" Header="کد حساب" Width="120"/>
                    <DataGridTextColumn x:Name="NAME_HES" Binding="{Binding NAME_HES, UpdateSourceTrigger=LostFocus}" Header="نام حساب " Width="300"/>
                    <DataGridTextColumn x:Name="sHARHColumn" Binding="{Binding SHARH, UpdateSourceTrigger=LostFocus}" Header="شرح" Width="*"/>
                    <DataGridTextColumn x:Name="bEDColumn" Binding="{Binding BED, UpdateSourceTrigger=LostFocus,StringFormat=\{0:N0\}}" Header="بدهکار" Width="auto" MinWidth="140"/>
                    <DataGridTextColumn x:Name="bESColumn" Binding="{Binding BES, UpdateSourceTrigger=LostFocus,StringFormat=\{0:N0\}}" Header="بستانکار" Width="auto" MinWidth="140"/>
                </DataGrid.Columns>
            </DataGrid>

        </Grid>
        <Label Content="جمع(ریال) ها:" Margin="0,0,662,14" FlowDirection="RightToLeft" FontSize="10" Height="26" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="65"/>
        <CNC:NumericTextBox x:Name="SUM_BED_TEXTBOX" TextAlignment="Center" DoesAcceptDouble="False" IsDigitGroupActive="True" DigitGroupOnEnter="True" IsReadOnly="True" Height="30" Margin="158,0,0,12" VerticalAlignment="Bottom" Visibility="Visible" HorizontalAlignment="Left" Width="136" />
        <CNC:NumericTextBox x:Name="SUM_BES_TEXTBOX" TextAlignment="Center" DoesAcceptDouble="False" IsDigitGroupActive="True" DigitGroupOnEnter="True" IsReadOnly="True" Height="30" VerticalAlignment="Bottom" Visibility="Visible" HorizontalAlignment="Left" Width="136" Margin="10,0,0,12" />
    </Grid>
</Window>
