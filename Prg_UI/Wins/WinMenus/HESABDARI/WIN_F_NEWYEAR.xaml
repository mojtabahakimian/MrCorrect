<Window x:Class="Prg_UI.Wins.WinMenus.HESABDARI.WIN_F_NEWYEAR"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.HESABDARI"
        mc:Ignorable="d"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Height="800" Width="800"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        FontFamily="{StaticResource IRANYEKAN}"
        Background="{x:Null}"
        AllowsTransparency="True" AllowDrop="True"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="15"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Color="{Binding ElementName=GENERAL_RANG, Path=Background.Color}" Opacity="0.3"/>
    </Window.Resources>

    <Grid x:Name="mygrid" Margin="8,8,8,0">
        <!-- Hidden button for color binding reference -->
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Width="1" Height="1"/>
        <!-- Main container -->
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding ElementName=GENERAL_RANG, Path=Background}" BorderThickness="1" CornerRadius="10" Padding="8">
            <!-- Title bar -->
            <Border  x:Name="TitleDrawBar" Style="{StaticResource BordG}"  Background="{Binding ElementName=GENERAL_RANG, Path=Background}"  CornerRadius="10,10,0,0" Margin="-9,-9,-9,0"  Height="38"  VerticalAlignment="Top" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <!-- Window title -->
                    <Label x:Name="LABEL_HEADER" Content="ایجاد سال مالی جدید" Padding="17,8,10,10" Foreground="White" Margin="0,0,110,0" VerticalAlignment="Center"/>
                    <!-- Window control buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0">
                        <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0,0,0,-1" IsTabStop="False" ToolTip="Minimize">
                            <materialDesign:PackIcon Kind="WindowMinimize" Width="18" Height="18" Foreground="White"/>
                        </Button>
                        <Button x:Name="Btn_Max" Click="Btn_Max_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" FontSize="12" Height="24" Padding="0" Margin="4,0,0,0" IsTabStop="False" ToolTip="Maximize">
                            <materialDesign:PackIcon Kind="WindowMaximize" Width="17" Height="17" Foreground="White"/>
                        </Button>
                        <Button x:Name="Btn_Close" Click="Btn_Close_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0" Margin="4,0,0,0" FontSize="12" IsTabStop="False" ToolTip="Close">
                            <materialDesign:PackIcon Kind="WindowClose" Width="19" Height="19" Foreground="White"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
        <!-- Notification popup -->
        <Popup x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative" Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Width="{Binding ElementName=mygrid, Path=ActualWidth, Mode=OneWay}" Height="84" Padding="10">
                <TextBox x:Name="Pop1Text1" IsReadOnly="True" Background="Transparent" FlowDirection="RightToLeft" BorderBrush="Transparent" Foreground="White" Text="محل نمایش اعلان های سیستم" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
            </Border>
        </Popup>

        <!-- Content area -->
        <Grid Margin="0,38,0,0" FlowDirection="RightToLeft">          
            <!-- Main Form Content -->
            <Border Margin="20" Padding="15" Background="White" CornerRadius="8">
                <StackPanel>

                    <DockPanel Margin="0,10,0,10">
                        <TextBlock DockPanel.Dock="Left" Width="220" Text="نام دیتابیس در سال جاری:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                        <TextBox x:Name="txtCurrentDbName" IsReadOnly="True" Style="{StaticResource MaterialDesignOutlinedTextBox}" Background="#F0F0F0"/>
                    </DockPanel>

                    <DockPanel Margin="0,10,0,10">
                        <TextBlock DockPanel.Dock="Left" Width="220" Text="مسیر دیتابیس در سال جاری:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                        <TextBox x:Name="txtCurrentDbPath" IsReadOnly="True" Style="{StaticResource MaterialDesignOutlinedTextBox}" Background="#F0F0F0"/>
                    </DockPanel>

                    <DockPanel Margin="0,10,0,10">
                        <TextBlock DockPanel.Dock="Left" Width="220" Text="فایل دیتابیس خام (neginsql.bak):" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                        <TextBox x:Name="txtTemplateBackupFile" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    </DockPanel>

                    <DockPanel Margin="0,10,0,10">
                        <TextBlock DockPanel.Dock="Left" Width="220" Text="مسیر ایجاد فایل‌های دیتابیس جدید:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                        <TextBox x:Name="txtNewDbPath" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    </DockPanel>

                    <DockPanel Margin="0,10,0,10">
                        <TextBlock DockPanel.Dock="Left" Width="220" Text="نام دیتابیس برای سال جدید:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                        <TextBox x:Name="txtNewDbName" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    </DockPanel>

                    <DockPanel Margin="0,10,0,10">
                        <TextBlock DockPanel.Dock="Left" Width="220" Text="سال مالی جدید:" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="Bold"/>
                        <TextBox x:Name="YEA" Width="150" HorizontalAlignment="Right" Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                    </DockPanel>

                    <!-- Warning and Fluent Progress Area -->
                    <StackPanel Margin="0,30,0,0">
                        <TextBlock Text="این عملیات فقط باید روی سرور اصلی انجام شود." Foreground="Red" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ProgressBar x:Name="prgBar" Style="{StaticResource MaterialDesignCircularProgressBar}" Value="0" IsIndeterminate="True" Visibility="Collapsed" Width="24" Height="24" Margin="0,0,10,0"/>
                            <TextBlock x:Name="txtStatus" Text="آماده عملیات..." Foreground="Teal" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <DockPanel Margin="30" LastChildFill="True">
                        <Button x:Name="Command3" Content="تایید و ایجاد سال مالی" Click="Command3_Click" BorderBrush="{x:Null}" FontSize="14" Foreground="#DDFFFFFF" Height="40" />
                    </DockPanel>
         

                </StackPanel>
            </Border>
        </Grid>
        
    </Grid>
</Window>