<Window x:Class="Wins.WinMenus.HESABDARI.froosh_customer"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wins.WinMenus.HESABDARI"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="{StaticResource IRANYEKAN}"
        WindowStartupLocation="CenterScreen"
        Title="سابقه فروش" Height="450" Width="800">
    <Window.Resources>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>
    </Window.Resources>
    <Grid>
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="557,410,462,353"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10">
                <Grid>
                    <Label Content="سابقه فروش" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowRestore" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>

                </Grid>
            </Border>
        </Border>
        
        <DataGrid x:Name="SaleHistory" FlowDirection="RightToLeft"
                  AutoGenerateColumns="False" ColumnHeaderStyle="{StaticResource CenteryHeaderstyle}" EnableRowVirtualization="True" Margin="14,50,11,33" ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="dATE_NColumn" Binding="{Binding DATE_N}" Header="تاریخ" Width="auto"/>
                <DataGridTextColumn x:Name="cUST_NOColumn" Binding="{Binding CUST_NO}" Header="کد مشتری" Width="auto"/>
                <DataGridTextColumn x:Name="customerColumn" Binding="{Binding customer}" Header="نام مشتری" Width="auto"/>
                <DataGridTextColumn x:Name="nAMEColumn" Binding="{Binding NAME}" Header="نام کالا" Width="auto"/>
                <DataGridTextColumn x:Name="mEGHkColumn" Binding="{Binding MEGHk}" Header="مقدار کل" Width="auto"/>
                <DataGridTextColumn x:Name="mABL_KColumn" Binding="{Binding MABL_K}" Header="مبلغ" Width="auto"/>
                <DataGridTextColumn x:Name="nUMBERColumn" Binding="{Binding NUMBER}" Header="شماره فاکتور" Width="auto"/>
                <DataGridTextColumn x:Name="mEGHColumn" Binding="{Binding MEGH}" Header="مقدار" Width="auto"/>
                <DataGridTextColumn x:Name="vAHEDColumn" Binding="{Binding VAHED}" Header="واحد" Width="auto"/>
                <DataGridTextColumn x:Name="mABLColumn" Binding="{Binding MABL}" Header="مبلغ" Width="auto"/>
                <DataGridTextColumn x:Name="n_KOLColumn" Binding="{Binding N_KOL}" Header="درصد" Width="auto"/>
                <DataGridTextColumn x:Name="n_MOINColumn" Binding="{Binding N_MOIN}" Header="تخفیف" Width="auto"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
