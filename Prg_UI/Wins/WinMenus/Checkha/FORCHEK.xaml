<Window x:Class="Prg_UI.Wins.WinMenus.Checkha.FORCHEK"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        FontFamily="{StaticResource IRANYEKAN}"
   	    Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        WindowStartupLocation="CenterScreen" 
        Height="455" Width="610" Loaded="Window_Loaded" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid x:Name="mygrid" Margin="-1,0,1,0" DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
        <Border  Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1" Margin="3,0,2,0">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="28.579" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label Padding="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,107,0" Foreground="White"  FontSize="11">
                        <Label.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text=" واگذاری چک" Margin="0,0,-100,0"  FontSize="14" Foreground="White" Width="104" Height="36"/>
                            </StackPanel>
                        </Label.Content>
                    </Label>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowRestore" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="95,56,0,0"  Width="1"/>
        <Label x:Name="Label64" Content=": ردیف دفتر" HorizontalAlignment="Left" Margin="486,52,0,0" VerticalAlignment="Top" Width="auto"/>
        <TextBox x:Name="RADIF" Height="27" Margin="0,54,129,0" IsReadOnly="True" Tag="RD"  Style="{StaticResource FuzzyOut}" Padding="3"   TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible"  HorizontalAlignment="Right" Width="81" IsTabStop="False" IsHitTestVisible="False" IsEnabled="False" />
        <Label x:Name="Label1" Content=": شماره سریال" HorizontalAlignment="Left" Margin="486,86,0,0" VerticalAlignment="Top" Width="auto"/>
        <ComboBox x:Name="BANK" IsReadOnly="True" TabIndex="2" Tag="RD" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Margin="346,119,130,0" VerticalAlignment="Top" Height="28" FlowDirection="RightToLeft"   IsEditable="True" SelectedIndex="0" Background="{x:Null}" BorderThickness="1" LostFocus="BANK_LostFocus" IsTabStop="True">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <Label x:Name="Label3" Content=": بانک" HorizontalAlignment="Left" Margin="487,119,0,0" VerticalAlignment="Top" Width="auto"/>
        <ComboBox x:Name="N_SERI" TabIndex="1" IsEditable="True" Tag="RD" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Margin="362,86,130,0" VerticalAlignment="Top" Height="28" FlowDirection="RightToLeft" SelectedIndex="0" Background="{x:Null}" BorderThickness="1" LostFocus="N_SERI_LostFocus" IsTabStop="True">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <xctk:MaskedTextBox x:Name="DATE_S"  Style="{StaticResource FuzzyOut}" Padding="3"  Mask="0000/00/00" Height="26" Margin="394,183,0,0" TextWrapping="Wrap" VerticalAlignment="Top"  BorderThickness="1" FontSize="12" HorizontalAlignment="Left" Width="86" LostFocus="DATE_S_LostFocus" IsTabStop="False" IsHitTestVisible="False" IsEnabled="False" />
        <Label x:Name="Label3_Copy3" Content=": تاریخ سررسید" HorizontalAlignment="Left" Margin="487,180,0,0" VerticalAlignment="Top" Width="auto"/>
        <Label x:Name="Label3_Copy" Content=": نام شعبه" HorizontalAlignment="Left" Margin="487,152,0,0" VerticalAlignment="Top" Width="auto"/>
        <TextBox x:Name="SHOBEH"  Height="27" TabIndex="3" Margin="0,152,129,0" IsReadOnly="True" Tag="RD"  Style="{StaticResource FuzzyOut}" Padding="3"   TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible"  HorizontalAlignment="Right" Width="200" />
        <xctk:MaskedTextBox x:Name="DATE" IsReadOnly="True" TabIndex="4" Style="{StaticResource FuzzyOut}" Padding="3"  Mask="0000/00/00" Height="26" Margin="394,213,0,0" TextWrapping="Wrap" VerticalAlignment="Top"  BorderThickness="1" FontSize="12" HorizontalAlignment="Left" Width="86" PreviewLostKeyboardFocus="DATE_PreviewLostKeyboardFocus" />
        <Label x:Name="Label3_Copy2" Content=": تاریخ دریافت" HorizontalAlignment="Left" Margin="487,212,0,0" VerticalAlignment="Top" Width="auto"/>
        <CNC:NumericTextBox DoesAcceptDouble="False" Text="" DigitGroupOnEnter="True" IsDigitGroupActive="True" x:Name="MABL" Height="27" Margin="280,243,0,0" IsReadOnly="True" Tag="RD" VerticalAlignment="Top"  Visibility="Visible"  HorizontalAlignment="Left" Width="200" IsHitTestVisible="False" IsEnabled="False"/>
        <Label x:Name="Label3_Copy4" Content=": مبلغ" HorizontalAlignment="Left" Margin="487,242,0,0" VerticalAlignment="Top" Width="auto"/>
        <Label x:Name="Label3_Copy5" Content=": نام پرداخت کننده" HorizontalAlignment="Left" Margin="487,274,0,0" VerticalAlignment="Top" Width="auto"/>
        <TextBox x:Name="N_HESAB" Height="27" TabIndex="6" Margin="0,306,130,0" IsReadOnly="True" Tag="RD"  Style="{StaticResource FuzzyOut}" Padding="3"   TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible"  HorizontalAlignment="Right" Width="161" />
        <Label x:Name="Label3_Copy6" Content=": شماره حساب" HorizontalAlignment="Left" Margin="487,303,0,0" VerticalAlignment="Top" Width="auto"/>
        <TextBox x:Name="NAME_TAH" TabIndex="5" Height="27" Margin="65,275,0,0" IsReadOnly="True" Tag="RD"  Style="{StaticResource FuzzyOut}" Padding="3"   TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible"  HorizontalAlignment="Left" Width="415" />
        <ComboBox x:Name="SANDUGH" TabIndex="7" SelectedValue="0" Tag="RD" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Margin="319,338,129,0" VerticalAlignment="Top" Height="28" FlowDirection="RightToLeft"   IsEditable="True" SelectedIndex="0" Background="{x:Null}" BorderThickness="1" IsTabStop="True">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <Label x:Name="Label3_Copy8" Content=": موقعیت چک" HorizontalAlignment="Left" Margin="488,337,0,0" VerticalAlignment="Top" Width="auto"/>
        <Button x:Name="_SaveExit" TabIndex="8" Content="تصویب و خروج" Margin="176,0,0,14"    BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="12" Height="38" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="122" Foreground="#DDFFFFFF" FontWeight="Bold" Click="_SaveExit_Click"/>
        <Button x:Name="_Exit" Content="خروج" Margin="319,0,0,15"    BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="12" Height="37" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="112" Foreground="#DDFFFFFF" FontWeight="Bold" Click="_Exit_Click" IsTabStop="False"/>
    </Grid>
</Window>
