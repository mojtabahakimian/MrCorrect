<Window x:Class="Wins.WinMenus.Checkha.WIN_CHECK_MON"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wins.WinMenus.Checkha"
        mc:Ignorable="d" 
        
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:sfusion="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="IRANYekanFN"
        WindowStartupLocation="CenterScreen"
        Height="600" Width="1024" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>
        <!-- Style for SfDataGrid -->
        <Style x:Key="KDG"  TargetType="syncfusion:SfDataGrid" BasedOn="{StaticResource SfDataGridStyle}">
            <Setter Property="CurrentCellBorderBrush" Value="{StaticResource GENERAL_Grlicom}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="BorderBrush" Value="{StaticResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="HeaderRowHeight" Value="40" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="GridLinesVisibility" Value="Both" />
        </Style>

        <!-- Modified Column Header Style -->
        <Style x:Key="KDGHeader" TargetType="syncfusion:GridHeaderCellControl" BasedOn="{StaticResource GridHeaderCellControlStyle}">
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="BorderBrush" Value="{Binding Background, ElementName=GENERAL_RANG}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="Auto"/>
        </Style>
        <Style TargetType="sfusion:GridCell" BasedOn="{StaticResource GridCellStyle}">
            <Setter Property="BorderBrush" Value="{Binding BorderBrush, ElementName=GENERAL_RANG}" />
        </Style>

        <ContextMenu x:Key="DataGridContextMenu" FontFamily="IRANYekanFN">
            <MenuItem Header="پالودن با این بخش" Click="FilterBySelection_Click">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="Filter"  FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <!--Filter Excluding Selection-->
            <MenuItem Header="پالودن بدون این بخش" Click="FilterExcludingSelection_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FilterRemove" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="کـپـی" Click="MenuItem_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="ContentCopy" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="حذف پالودن (فیلتر)" Click="RemoveFilterSort_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FilterRemoveOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="خروجی اکسل" Click="EXPORTEXCEL_BTN" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FileExcelOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="mygrid">
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="643,410,328,158"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label Content="لیست چکهای دریافتی به تفکیک ماه  |  دفتر ماهانه چکهای دریافتی" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                                                   Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <!--Start.......................................................................................-->
        <CNC:NumericTextBox PreviewLostKeyboardFocus="YEAR_PreviewLostKeyboardFocus" x:Name="YEAR" DoesAcceptDouble="False" LastValueShouldZero="False" Text="" Height="30" MaxLength="4" Margin="0,113,42,0" VerticalAlignment="Top" Visibility="Visible" HorizontalAlignment="Right" Width="48"/>
        <Label Content="سال:" HorizontalAlignment="Right" Margin="0,114,7,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>

        <UniformGrid x:Name="MONTH_BUTTONS_UG" Rows="1" Columns="12" FlowDirection="RightToLeft" Margin="4,51,4,0" Height="42" VerticalAlignment="Top">
            <Button BorderBrush="{x:Null}" Tag="12" Click="Button_Click"  Content="اسفند" Height="34" FontSize="10" Foreground="#DDFFFFFF"/>
            <Button BorderBrush="{x:Null}" Tag="11" Click="Button_Click"  Content="بهمن" Height="34" FontSize="10" Foreground="#DDFFFFFF" />
            <Button BorderBrush="{x:Null}" Tag="10" Click="Button_Click"  Content="دی" Height="34" FontSize="10" Foreground="#DDFFFFFF" />
            <Button BorderBrush="{x:Null}" Tag="09" Click="Button_Click"  Content="آذر" Height="34" FontSize="10" Foreground="#DDFFFFFF" />
            <Button BorderBrush="{x:Null}" Tag="08" Click="Button_Click"  Content="آبان" Height="34" FontSize="10" Foreground="#DDFFFFFF" />
            <Button BorderBrush="{x:Null}" Tag="07" Click="Button_Click"  Content="مهر" Height="34" FontSize="10" Foreground="#DDFFFFFF" />
            <Button BorderBrush="{x:Null}" Tag="06" Click="Button_Click"  Content="شهریور" Height="34" FontSize="10" Foreground="#DDFFFFFF" />
            <Button BorderBrush="{x:Null}" Tag="05" Click="Button_Click"  Content="مرداد" Height="34" FontSize="10" Foreground="#DDFFFFFF" />
            <Button BorderBrush="{x:Null}" Tag="04" Click="Button_Click"  Content="تیر" Height="34" FontSize="10" Foreground="#DDFFFFFF" />
            <Button BorderBrush="{x:Null}" Tag="03" Click="Button_Click"  Content="خرداد" Height="34" FontSize="10" Foreground="#DDFFFFFF" />
            <Button BorderBrush="{x:Null}" Tag="02" Click="Button_Click"  Content="اردیبهشت" Height="34" FontSize="10" Foreground="#DDFFFFFF" />
            <Button BorderBrush="{x:Null}" Tag="01" Click="Button_Click"  Content="فروردین" Height="34" FontSize="10" Foreground="#DDFFFFFF" />
        </UniformGrid>

        <StackPanel x:Name="GRO" Margin="503,111,90,0" Orientation="Horizontal" FlowDirection="RightToLeft" Height="34" VerticalAlignment="Top">
            <RadioButton x:Name="HAMEH"     GroupName="HeadFilter" Click="HAMEH_Click" Content="همه چکها"   Tag="1" IsChecked="True" Margin="5" VerticalAlignment="Top" HorizontalAlignment="Right" Width="auto" FlowDirection="RightToLeft" FontSize="11" />
            <RadioButton x:Name="NON_VOSUL" GroupName="HeadFilter" Click="NON_VOSUL_Click" Content="وصول نشده"  Tag="2" Margin="5" VerticalAlignment="Top" HorizontalAlignment="Right" Width="auto" FlowDirection="RightToLeft" FontSize="11"  />
            <RadioButton x:Name="VOSULED"   GroupName="HeadFilter" Click="VOSULED_Click" Content="وصول شده"   Tag="3" Margin="5" VerticalAlignment="Top" HorizontalAlignment="Right" Width="auto" FlowDirection="RightToLeft" FontSize="11" />
            <RadioButton x:Name="TRANSFER"  GroupName="HeadFilter" Click="TRANSFER_Click" Content="واگذار شده" Tag="4" Margin="5" VerticalAlignment="Top" HorizontalAlignment="Right" Width="auto" FlowDirection="RightToLeft" FontSize="11" />
            <RadioButton x:Name="BARGASHT"  GroupName="HeadFilter" Click="BARGASHT_Click" Content="برگشت شده"  Tag="5" Margin="5" VerticalAlignment="Top" HorizontalAlignment="Right" Width="auto" FlowDirection="RightToLeft" FontSize="11" />
        </StackPanel>

        <syncfusion:SfDataGrid x:Name="TOHESAB_SUB" ContextMenu="{StaticResource DataGridContextMenu}"
                     ItemsSource="{Binding TOHESAB_DATA}" 
                     AutoGenerateColumns="False"     
                     EnableDataVirtualization="True"
                     SelectionUnit="Row"
                     AllowDraggingColumns="True"
                     AllowResizingColumns="True"
                     AllowFiltering="True"
                     AllowSorting="True"
                     SelectionMode="Extended"
                     RowHeight="30"
                     FrozenColumnCount="0"
                     FlowDirection="RightToLeft"
                     d:ItemsSource="{d:SampleData ItemCount=5}"
                     Style="{StaticResource KDG}"
                               
                     HeaderStyle="{StaticResource KDGHeader}"
                     AllowEditing="True"
                     IsReadOnly="True"
                     PreviewMouseRightButtonDown="TOHESAB_SUB_PreviewMouseRightButtonDown"
                     CurrentCellActivated="TOHESAB_SUB_CurrentCellActivated"
                     Margin="10,164,10,51" AllowRowHoverHighlighting="True" AllowSelectionOnPointerPressed="True" ScrollMode="Async" ShowRowHeader="True" ShowGroupDropArea="True" SelectionChanged="TOHESAB_SUB_SelectionChanged" PreviewKeyDown="TOHESAB_SUB_PreviewKeyDown">


            <syncfusion:SfDataGrid.Columns>

                <syncfusion:GridTextColumn MappingName="N_SERI" HeaderText="شماره سریال" ColumnSizer="Auto" />
                <syncfusion:GridTextColumn MappingName="BANK_NAME" HeaderText="بانک" ColumnSizer="Auto" />
                <syncfusion:GridTextColumn MappingName="SHOBEH" HeaderText="نام شعبه" ColumnSizer="Auto" />
                <syncfusion:GridTextColumn MappingName="N_HESAB" HeaderText="شماره حساب" ColumnSizer="Auto" />

                <syncfusion:GridTextColumn HeaderText="تاریخ سررسید" MappingName="DATE_S">
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="DATE_S" StringFormat="####/##/##" />
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>

                <syncfusion:GridTextColumn HeaderText="تاریخ دریافت" MappingName="DATE">
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="DATE" StringFormat="####/##/##" />
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>

                <syncfusion:GridTextColumn HeaderText="مبلغ" MappingName="MABL">
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="MABL" StringFormat="{}{0:#,0}" />
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>

                <syncfusion:GridTextColumn MappingName="NAME_TAH" HeaderText="نام پرداخت کننده" ColumnSizer="AutoLastColumnFill" />

            </syncfusion:SfDataGrid.Columns>


        </syncfusion:SfDataGrid>

        <Label Content="جمع مبالغ (ریال) :" Margin="210,0,0,10" FlowDirection="RightToLeft" Width="96" HorizontalAlignment="Left" Height="27" VerticalAlignment="Bottom"/>
        <CNC:NumericTextBox x:Name="MABL_JAM" DoesAcceptDouble="False" DigitGroupOnEnter="True" IsDigitGroupActive="True" IsReadOnly="True" Height="27" Margin="4,0,0,10"    VerticalAlignment="Bottom"  Visibility="Visible"  HorizontalAlignment="Left" Width="206" Text="0" />
        <Label x:Name="MONTH_LABEL" Content="" Foreground="{Binding ElementName=GENERAL_RANG,Path=Background}" Margin="10,113,0,0" VerticalAlignment="Top" FlowDirection="RightToLeft" FontSize="12" HorizontalAlignment="Left" Width="490" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        <Label x:Name="ROWCOUNT_LABEL" Content="تعداد رکورد ها:" Margin="0,0,16,10" FlowDirection="RightToLeft" Width="326" HorizontalAlignment="Right" Height="27" VerticalAlignment="Bottom"/>


    </Grid>
</Window>
