<Window x:Class="Wins.WinMenus.Checkha.CHECK_PVLIST"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wins.WinMenus.Checkha"
        mc:Ignorable="d"
        
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:sfusion="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="IRANYekanFN"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Height="600" Width="1024" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>

        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>
        <!-- Style for SfDataGrid -->
        <Style x:Key="KDG"  TargetType="syncfusion:SfDataGrid" BasedOn="{StaticResource SfDataGridStyle}">
            <Setter Property="CurrentCellBorderBrush" Value="{StaticResource GENERAL_Grlicom}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="BorderBrush" Value="{StaticResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="HeaderRowHeight" Value="40" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="GridLinesVisibility" Value="Both" />
        </Style>

        <!-- Modified Column Header Style -->
        <Style x:Key="KDGHeader" TargetType="syncfusion:GridHeaderCellControl" BasedOn="{StaticResource GridHeaderCellControlStyle}">
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="BorderBrush" Value="{Binding Background, ElementName=GENERAL_RANG}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="Auto"/>
        </Style>
        <Style TargetType="sfusion:GridCell" BasedOn="{StaticResource GridCellStyle}">
            <Setter Property="BorderBrush" Value="{Binding BorderBrush, ElementName=GENERAL_RANG}" />
        </Style>

        <ContextMenu x:Key="DataGridContextMenu" FontFamily="IRANYekanFN">
            <MenuItem Header="پالودن با این بخش" Click="FilterBySelection_Click">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="Filter"  FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <!--Filter Excluding Selection-->
            <MenuItem Header="پالودن بدون این بخش" Click="FilterExcludingSelection_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FilterRemove" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="کـپـی" Click="MenuItem_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="ContentCopy" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="حذف پالودن (فیلتر)" Click="RemoveFilterSort_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FilterRemoveOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="خروجی اکسل" Click="EXPORTEXCEL_BTN" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FileExcelOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="mygrid">
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="643,410,328,158"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label Content="لیست چکهای پـــــرداختی اعلام وصول نشده" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                                                   Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <!--Start.......................................................................................-->

        <syncfusion:SfDataGrid x:Name="SFDATAGRID_SUB" ContextMenu="{StaticResource DataGridContextMenu}"
                     ItemsSource="{Binding SFDATAGRID_DATA}" 
                     AutoGenerateColumns="False"     
                     EnableDataVirtualization="True"
                     SelectionUnit="Row"
                     AllowDraggingColumns="True"
                     AllowResizingColumns="True"
                     AllowFiltering="True"
                     AllowSorting="True"
                     SelectionMode="Extended"
                     RowHeight="30"
                     FrozenColumnCount="0"
                     FlowDirection="RightToLeft"
                     d:ItemsSource="{d:SampleData ItemCount=5}"
                     Style="{StaticResource KDG}"
                     HeaderStyle="{StaticResource KDGHeader}"
                     AllowEditing="True"
                     
                     PreviewMouseRightButtonDown="SFDATAGRID_SUB_PreviewMouseRightButtonDown"
                     CurrentCellActivated="SFDATAGRID_SUB_CurrentCellActivated"
                     PreviewKeyDown="SFDATAGRID_SUB_PreviewKeyDown"
                     Margin="10,112,10,46" AllowRowHoverHighlighting="True" AllowSelectionOnPointerPressed="True" ScrollMode="Async" ShowRowHeader="True" ShowGroupDropArea="True" SelectionChanged="SFDATAGRID_SUB_SelectionChanged"  CurrentCellEndEdit="SFDATAGRID_SUB_CurrentCellEndEdit" CurrentCellValidating="SFDATAGRID_SUB_CurrentCellValidating" >

            <syncfusion:SfDataGrid.Columns>

                <syncfusion:GridTextColumn MappingName="N_SERI" HeaderText="شماره سریال" MinimumWidth="90" IsReadOnly="True" />

                <syncfusion:GridTextColumn HeaderText="تاریخ سررسید" MappingName="DATE_S" IsReadOnly="True" >
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="DATE_S" StringFormat="####/##/##" />
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>

                <syncfusion:GridTextColumn HeaderText="تاریخ پرداخت" MappingName="DATE" IsReadOnly="True" >
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="DATE" StringFormat="####/##/##" />
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>

                <!--SELECT CODE,NAMES FROM dbo.TCOD_BANKS-->
                <syncfusion:GridComboBoxColumn x:Name="BANK_COLUMN" HeaderText="نام بانک" MappingName="BANK" SelectedValuePath="CODE" DisplayMemberPath="NAMES" IsReadOnly="True"  />

                <syncfusion:GridTextColumn MappingName="SHOBEH" HeaderText="نام شعبه" IsReadOnly="True"  />

                <syncfusion:GridTextColumn HeaderText="مبلغ" MappingName="MABL" IsReadOnly="True" >
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="MABL" StringFormat="{}{0:#,0}" />
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>

                <syncfusion:GridTextColumn MappingName="NAME_TAH" HeaderText="نام تحویل گیرنده" IsReadOnly="True" MinimumWidth="350" />

                <!--<syncfusion:GridComboBoxColumn x:Name="VAZ_COLUMN" HeaderText="وضعیت چک" AllowEditing="False" IsReadOnly="True" MappingName="VAZ" SelectedValuePath="ID" DisplayMemberPath="NAME" />
                <syncfusion:GridComboBoxColumn x:Name="SANDUGH_COLUMN" MappingName="SANDUGH" HeaderText="موقعیت چک*" SelectedValuePath="TNUMBER" DisplayMemberPath="NAME" IsReadOnly="True"  />-->

                <syncfusion:GridTextColumn MappingName="N_HESAB" HeaderText="شماره حساب" IsReadOnly="True"  />
                <syncfusion:GridTextColumn MappingName="N_S" HeaderText="شماره سند"  IsReadOnly="True" />
                <syncfusion:GridTextColumn MappingName="N_KOL" HeaderText="از حساب کل" IsReadOnly="True"  />
                <syncfusion:GridTextColumn MappingName="N_MOIN" HeaderText="از حساب معین"  IsReadOnly="True" />
                <syncfusion:GridTextColumn MappingName="N_TAF" HeaderText="از حساب تفضیلی"  IsReadOnly="True" />

                <syncfusion:GridTextColumn MappingName="N_KOL2" HeaderText="برگشت از حساب کل" MinimumWidth="180"  IsReadOnly="True" />
                <syncfusion:GridTextColumn MappingName="N_MOIN2" HeaderText="برگشت از حساب معین" MinimumWidth="180"  IsReadOnly="True"  />
                <syncfusion:GridTextColumn MappingName="N_TAF2" HeaderText="برگشت از حساب تفضیلی" MinimumWidth="180"  IsReadOnly="True"  />

                <syncfusion:GridTextColumn MappingName="N_KOL3" HeaderText="وصول از حساب کل" MinimumWidth="180" IsReadOnly="True"  />
                <syncfusion:GridTextColumn MappingName="N_MOIN3" HeaderText="وصول از حساب معین" MinimumWidth="180"  IsReadOnly="True" />
                <syncfusion:GridTextColumn MappingName="N_TAF3" HeaderText="وصول از حساب تفضیلی" MinimumWidth="180" IsReadOnly="True"  />

                <!--<syncfusion:GridTextColumn MappingName="SANDUGH" HeaderText="صندوق" IsReadOnly="True" />-->

                <syncfusion:GridComboBoxColumn HeaderText="نوع" MappingName="KIND" IsReadOnly="True"  >
                    <syncfusion:GridComboBoxColumn.ItemsSource>
                        <x:Array Type="{x:Type sys:String}">
                            <sys:String>1;تجاري</sys:String>
                            <sys:String>0;غير تجاري</sys:String>
                        </x:Array>
                    </syncfusion:GridComboBoxColumn.ItemsSource>
                    <syncfusion:GridComboBoxColumn.DisplayMemberPath>
                        <Binding Path="Value" />
                    </syncfusion:GridComboBoxColumn.DisplayMemberPath>
                    <syncfusion:GridComboBoxColumn.SelectedValuePath>
                        <Binding Path="Key" />
                    </syncfusion:GridComboBoxColumn.SelectedValuePath>
                </syncfusion:GridComboBoxColumn>

                <!--<syncfusion:GridTextColumn MappingName="CUST_KIND" HeaderText="نوع مشتری" IsReadOnly="True" />-->

                <!--<syncfusion:GridTextColumn MappingName="DEPATMAN" HeaderText="دپارتمان" IsReadOnly="True" />
                <syncfusion:GridTextColumn MappingName="SHIFT" HeaderText="شیفت" IsReadOnly="True" />-->

                <syncfusion:GridTextColumn x:Name="HES1_COLUMN" MappingName="HES1" HeaderText="پرداخت از حساب" IsReadOnly="True" />
                <syncfusion:GridTextColumn x:Name="HES2_COLUMN" MappingName="HES2" HeaderText=" برگشت به حساب " IsReadOnly="True"  />
                <syncfusion:GridTextColumn x:Name="HES3_COLUMN" MappingName="HES3" HeaderText=" وصول به حساب "  IsReadOnly="True" />

                <syncfusion:GridTextColumn MappingName="SAYADI" HeaderText="شماره صیادی"  IsReadOnly="True" />
                <syncfusion:GridTextColumn MappingName="USER_NAME" HeaderText="نام کاربر" IsReadOnly="True" />

            </syncfusion:SfDataGrid.Columns>

        </syncfusion:SfDataGrid>
        <Label Content="تعداد رکورد ها:" Margin="0,0,16,14" FlowDirection="RightToLeft" Width="84" HorizontalAlignment="Right" Height="27" VerticalAlignment="Bottom"/>
        <Label x:Name="ROWCOUNT_LABEL" Content="{Binding ElementName=SFDATAGRID_SUB,Path=View.Records.Count}" Margin="0,0,100,14" FlowDirection="RightToLeft" Width="230" HorizontalAlignment="Right" Height="27" VerticalAlignment="Bottom"/>

        <Grid Margin="0,50,0,0" FlowDirection="RightToLeft" Height="50" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Button 1 -->
            <Button x:Name="BTN_SINGLE_PASS_CHECK" Grid.Column="0" Style="{StaticResource MaterialDesignFlatButton}" Click="BTN_SINGLE_PASS_CHECK_Click" FontSize="12" Height="50">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="CheckCircleOutline" VerticalAlignment="Center" />
                    <TextBlock Text="اعلام وصول (پاس شدن) چک" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Button>

            <!-- Button 3 -->
            <!--<Button x:Name="BTN_GROUP_PASS" Grid.Column="1" Style="{StaticResource MaterialDesignFlatButton}" Click="BTN_GROUP_PASS_Click" FontSize="12" Height="50">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="CheckboxMultipleMarkedCircleOutline" VerticalAlignment="Center" />
                    <TextBlock Text="اعلام وصول (پاس شدن) چک گروهی" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
            </Button>-->

        </Grid>


    </Grid>
</Window>