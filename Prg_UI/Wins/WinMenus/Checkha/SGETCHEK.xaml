<Window x:Class="Wins.WinMenus.Checkha.SGETCHEK"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wins.WinMenus.Checkha"
        mc:Ignorable="d"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        FontFamily="{StaticResource IRANYEKAN}"
   	    Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        Title="SGETCHEK" Height="602" Width="610" Closing="Window_Closing" Loaded="Window_Loaded" ContentRendered="Window_ContentRendered" PreviewKeyDown="Window_PreviewKeyDown">

    <Grid x:Name="mygrid">
        <Border  Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1" Margin="2,0,3,0">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="28.579" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label Padding="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,107,0" Foreground="White"  FontSize="11">
                        <Label.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text=" دریافت چک" Margin="0,0,-100,0"  FontSize="17" Foreground="White" Width="104" Height="36"/>
                            </StackPanel>
                        </Label.Content>
                    </Label>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowRestore" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="95,56,0,0"  Width="1"/>
        <!--HEADER↑-->
        <!--EndOfHeader ↑-->
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True" Grid.RowSpan="2">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                  Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>

        <Label x:Name="Label64" Content=": ردیف دفتر" HorizontalAlignment="Left" Margin="486,52,0,0" VerticalAlignment="Top" Width="auto"/>
        <TextBox x:Name="RADIF" Height="27" Margin="0,54,129,0" IsReadOnly="True" Tag="RD"  Style="{StaticResource FuzzyOut}" Padding="3"   TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible"  HorizontalAlignment="Right" Width="81" IsTabStop="False" IsHitTestVisible="False" IsEnabled="False" />
        <Label x:Name="Label1" Content=": شماره سریال" HorizontalAlignment="Left" Margin="486,86,0,0" VerticalAlignment="Top" Width="auto"/>
        <CNC:NumericTextBox DoesAcceptDouble="False" IsDigitGroupActive="False"  x:Name="N_SERI" Height="27" Margin="361,87,0,0" IsReadOnly="False" Tag="RD" Text="" VerticalAlignment="Top" Visibility="Visible"  HorizontalAlignment="Left" Width="120" TabIndex="1" Focusable="True" IsTabStop="True" />
        <Grid>
            <Label x:Name="Label3" Content=": بانک" HorizontalAlignment="Left" Margin="487,119,0,0" VerticalAlignment="Top" Width="auto"/>
            <Label x:Name="Label3_Copy" Content=": نام شعبه" HorizontalAlignment="Left" Margin="487,152,0,0" VerticalAlignment="Top" Width="auto"/>
            <Label x:Name="Label3_Copy1" Content=": کد شعبه" HorizontalAlignment="Left" Margin="487,186,0,0" VerticalAlignment="Top" Width="auto"/>
            <Label x:Name="Label3_Copy2" Content=": تاریخ دریافت" HorizontalAlignment="Left" Margin="487,218,0,0" VerticalAlignment="Top" Width="auto"/>
            <Label x:Name="Label3_Copy3" Content=": تاریخ سررسید" HorizontalAlignment="Left" Margin="487,247,0,0" VerticalAlignment="Top" Width="auto"/>
            <Label x:Name="Label3_Copy4" Content=": مبلغ" HorizontalAlignment="Left" Margin="487,281,0,0" VerticalAlignment="Top" Width="auto"/>
            <Label x:Name="Label3_Copy5" Content=": نام پرداخت کننده" HorizontalAlignment="Left" Margin="487,315,0,0" VerticalAlignment="Top" Width="auto"/>
            <Label x:Name="Label3_Copy6" Content=": جاری چک" HorizontalAlignment="Left" Margin="487,344,0,0" VerticalAlignment="Top" Width="auto"/>
            <Label x:Name="Label3_Copy7" Content=": به حساب" HorizontalAlignment="Left" Margin="487,378,0,0" VerticalAlignment="Top" Width="auto"/>
            <Label x:Name="Label3_Copy8" Content=": موقعیت چک" HorizontalAlignment="Left" Margin="488,446,0,0" VerticalAlignment="Top" Width="auto"/>
            <Label x:Name="Label3_Copy9" Content=": شماره صیادی" HorizontalAlignment="Left" Margin="488,477,0,0" VerticalAlignment="Top" Width="auto"/>
            <Label x:Name="Label3_Copy10" Content=": حساب مشتری" HorizontalAlignment="Left" Margin="487,411,0,0" VerticalAlignment="Top" Width="auto"/>
        </Grid>
        <ComboBox x:Name="BANK"  Tag="RD" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Margin="281,119,129,0" VerticalAlignment="Top" Height="28" FlowDirection="RightToLeft"   IsEditable="True" SelectedIndex="0" Background="{x:Null}" BorderThickness="1" PreviewLostKeyboardFocus="BANK_PreviewLostKeyboardFocus" IsTabStop="True" TabIndex="2" Width="200">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <ComboBox x:Name="SHOBEH" Tag="RD" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Margin="281,152,129,0" VerticalAlignment="Top" Height="28" FlowDirection="RightToLeft"   IsEditable="True" SelectedIndex="0" Background="{x:Null}" BorderThickness="1" IsTabStop="True" TabIndex="3" Width="200" PreviewLostKeyboardFocus="SHOBEH_PreviewLostKeyboardFocus">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <ComboBox x:Name="LIST_NO" Tag="RD" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Margin="347,185,129,0" VerticalAlignment="Top" Height="28" FlowDirection="RightToLeft"   IsEditable="True" SelectedIndex="0" Background="{x:Null}" BorderThickness="1" TabIndex="4" IsTabStop="True" PreviewLostKeyboardFocus="LIST_NO_PreviewLostKeyboardFocus">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <CNC:NumericTextBox DoesAcceptDouble="False" Text="" DigitGroupOnEnter="True" IsDigitGroupActive="True" x:Name="MABL" Height="27" Margin="0,282,129,0" IsReadOnly="True" Tag="RD" VerticalAlignment="Top" Visibility="Visible"  HorizontalAlignment="Right" Width="161" LostFocus="MABL_LostFocus" IsHitTestVisible="False" IsEnabled="False" />
        <ComboBox x:Name="NAME_TAH" Tag="RD" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Margin="72,314,129,0" VerticalAlignment="Top" Height="28" FlowDirection="RightToLeft"   IsEditable="True" SelectedIndex="0" Background="{x:Null}" BorderThickness="1" TabIndex="6" IsTabStop="True">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <CNC:ACT x:Name="N_HESAB" AutoSuggestFirstItem="True" IsFuzzySearch="False" SearchMemberPaths="N_HESAB" DisplayMemberPath="N_HESAB" SelectedValuePath="hes" Margin="319,346,129,225" TabIndex="7" IsTabStop="True" />
        <ComboBox x:Name="HES" Tag="RD" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Margin="71,379,129,0" VerticalAlignment="Top" Height="28" FlowDirection="RightToLeft"   IsEditable="True" SelectedIndex="0" Background="{x:Null}" BorderThickness="1" LostFocus="HES_LostFocus" IsTabStop="True" TabIndex="8">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <ComboBox x:Name="SANDUGH"  Tag="RD" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Margin="319,446,129,0" VerticalAlignment="Top" Height="28" FlowDirection="RightToLeft"   IsEditable="True" SelectedIndex="0" Background="{x:Null}" BorderThickness="1" TabIndex="9" IsTabStop="True">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <Button x:Name="_Exit" Content="خروج" Margin="319,543,0,0"    BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="12" Height="37" VerticalAlignment="Top" HorizontalAlignment="Left" Width="112" Foreground="#DDFFFFFF" FontWeight="Bold" Click="_Exit_Click" IsTabStop="False"/>
        <Button x:Name="_SaveExit" Content="تصویب و خروج" Margin="176,543,0,0"   BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="12" Height="38" VerticalAlignment="Top" HorizontalAlignment="Left" Width="122" Foreground="#DDFFFFFF" FontWeight="Bold" Click="_SaveExit_Click" TabIndex="11">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource GerdC}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedItem, ElementName=BANK}" Value="{x:Null}">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                      
                        <DataTrigger Binding="{Binding SelectedItem, ElementName=SANDUGH}" Value="{x:Null}">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Text, ElementName=N_SERI}" Value="{x:Null}">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Text, ElementName=DATE_S}" Value="{x:Null}">
                            <Setter Property="IsEnabled" Value="False" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <CNC:NumericTextBox DoesAcceptDouble="False" IsDigitGroupActive="False" DigitGroupOnEnter="False" InnerTabStop="True"  Text="" x:Name="SAYADI" Height="27" Margin="0,480,130,0" IsReadOnly="False" Tag="RD" VerticalAlignment="Top"  Visibility="Visible"  HorizontalAlignment="Right" Width="161" TabIndex="10" Focusable="True" LostFocus="SAYADI_LostFocus" />
        <ComboBox x:Name="KIND" IsEnabled="False" Visibility="Hidden" Text="KIND" Tag="RD" Padding="7,0,10,0" Style="{StaticResource MaterialDesignOutlinedComboBox}" IsTextSearchEnabled="True" Margin="124,412,373,0" VerticalAlignment="Top" Height="28" FlowDirection="RightToLeft"   IsEditable="True" SelectedIndex="0" Background="{x:Null}" BorderThickness="1">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <xctk:MaskedTextBox x:Name="DATE" Style="{StaticResource FuzzyOut}" Padding="3"  Mask="0000/00/00" Height="26" Margin="394,219,0,0" TextWrapping="Wrap" VerticalAlignment="Top"  BorderThickness="1" FontSize="12" HorizontalAlignment="Left" Width="86" PreviewLostKeyboardFocus="DATE_PreviewLostKeyboardFocus" IsTabStop="False" />
        <xctk:MaskedTextBox x:Name="DATE_S"   Style="{StaticResource FuzzyOut}" Padding="3"  Mask="0000/00/00" Height="26" Margin="394,250,0,0" TextWrapping="Wrap" VerticalAlignment="Top"  BorderThickness="1" FontSize="12" HorizontalAlignment="Left" Width="86" TabIndex="5" PreviewLostKeyboardFocus="DATE_S_PreviewLostKeyboardFocus" />
        <ComboBox x:Name="CUST_NO" Tag="RD" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Margin="212,412,129,0" VerticalAlignment="Top" Height="28" FlowDirection="RightToLeft"   IsEditable="True" SelectedIndex="0" Background="{x:Null}" BorderThickness="1" IsTabStop="True" TabIndex="8" LostFocus="CUST_NO_LostFocus">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <ComboBox x:Name="CUST_NO_2" Tag="RD" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Margin="71,412,407,0" VerticalAlignment="Top" Height="28" FlowDirection="RightToLeft"   IsEditable="True" SelectedIndex="0" Background="{x:Null}" BorderThickness="1" IsTabStop="True" TabIndex="8" LostFocus="CUST_NO_2_LostFocus">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <!--EndOfHeader ↑-->
    </Grid>
</Window>
