<Window x:Class="Wins.WinMenus.Checkha.WIN_CHKE_DLIST"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wins.WinMenus.Checkha"
        mc:Ignorable="d"
        
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:sfusion="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="{StaticResource IRANYEKAN}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Height="600" Width="1024" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>

        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>
        <!-- Style for SfDataGrid -->
        <Style x:Key="KDG"  TargetType="syncfusion:SfDataGrid" BasedOn="{StaticResource SfDataGridStyle}">
            <Setter Property="CurrentCellBorderBrush" Value="{StaticResource GENERAL_Grlicom}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="BorderBrush" Value="{StaticResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="HeaderRowHeight" Value="40" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="GridLinesVisibility" Value="Both" />
        </Style>

        <!-- Modified Column Header Style -->
        <Style x:Key="KDGHeader" TargetType="syncfusion:GridHeaderCellControl" BasedOn="{StaticResource GridHeaderCellControlStyle}">
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="BorderBrush" Value="{Binding Background, ElementName=GENERAL_RANG}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="Auto"/>
        </Style>
        <Style TargetType="sfusion:GridCell" BasedOn="{StaticResource GridCellStyle}">
            <Setter Property="BorderBrush" Value="{Binding BorderBrush, ElementName=GENERAL_RANG}" />
        </Style>

        <ContextMenu x:Key="DataGridContextMenu" FontFamily="{StaticResource IRANYEKAN}">
            <MenuItem Header="پالودن با این بخش" Click="FilterBySelection_Click">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="Filter"  FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <!--Filter Excluding Selection-->
            <MenuItem Header="پالودن بدون این بخش" Click="FilterExcludingSelection_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FilterRemove" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="کـپـی" Click="MenuItem_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="ContentCopy" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="حذف پالودن (فیلتر)" Click="RemoveFilterSort_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FilterRemoveOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="خروجی اکسل" Click="EXPORTEXCEL_BTN" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FileExcelOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="mygrid">
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="643,410,328,158"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label Content="لیست کل چکهای دریافتی" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                                                   Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <!--Start.......................................................................................-->

        <syncfusion:SfDataGrid x:Name="SFDATAGRID_SUB" ContextMenu="{StaticResource DataGridContextMenu}"
                ItemsSource="{Binding SFDATAGRID_DATA}" 
                AutoGenerateColumns="False"     
                EnableDataVirtualization="True"
                SelectionUnit="Row"
                AllowDraggingColumns="True"
                AllowResizingColumns="True"
                AllowFiltering="True"
                AllowSorting="True"
                SelectionMode="Extended"
                RowHeight="30"
                FrozenColumnCount="0"
                FlowDirection="RightToLeft"
                d:ItemsSource="{d:SampleData ItemCount=5}"
                Style="{StaticResource KDG}"
                HeaderStyle="{StaticResource KDGHeader}"
                AllowEditing="True"
                
                PreviewMouseRightButtonDown="SFDATAGRID_SUB_PreviewMouseRightButtonDown"
                CurrentCellActivated="SFDATAGRID_SUB_CurrentCellActivated"
                PreviewKeyDown="SFDATAGRID_SUB_PreviewKeyDown"
                Margin="10,50,10,46" AllowRowHoverHighlighting="True" AllowSelectionOnPointerPressed="True" ScrollMode="Async" ShowRowHeader="True" ShowGroupDropArea="True" SelectionChanged="SFDATAGRID_SUB_SelectionChanged"  CurrentCellEndEdit="SFDATAGRID_SUB_CurrentCellEndEdit" CurrentCellValidating="SFDATAGRID_SUB_CurrentCellValidating" >

            <syncfusion:SfDataGrid.Columns>

                <syncfusion:GridTextColumn MappingName="RADIF" HeaderText="شماره" MinimumWidth="90" IsReadOnly="True" />
                <syncfusion:GridTemplateColumn HeaderText="سوابق تغییر وضعیت چک" Width="180" MappingName="IsButtony" AllowSorting="False" AllowFiltering="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button IsTabStop="False" Click="BTN_RECORD_Click" Tag="{Binding}"
								materialDesign:ButtonAssist.CornerRadius="2"
								Style="{StaticResource MaterialDesignFlatButton}"
								HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Center"
								HorizontalContentAlignment="Center">
                                <materialDesign:PackIcon Kind="History"/>
                            </Button>

                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>
                <syncfusion:GridTextColumn MappingName="N_SERI" HeaderText="شماره سریال" MinimumWidth="90" IsReadOnly="True" />
                <syncfusion:GridTextColumn HeaderText="مبلغ" MappingName="MABL" IsReadOnly="True" >
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="MABL" StringFormat="{}{0:#,0}" />
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>

                <syncfusion:GridTextColumn HeaderText="تاریخ سررسید" MappingName="DATE_S" IsReadOnly="True" >
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="DATE_S" StringFormat="####/##/##" />
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>

                <syncfusion:GridTextColumn HeaderText="تاریخ دریافت" MappingName="DATE" IsReadOnly="True" >
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="DATE" StringFormat="####/##/##" />
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>
                <syncfusion:GridTextColumn MappingName="modat" HeaderText="مدت" MinimumWidth="90" IsReadOnly="True" />

                <syncfusion:GridComboBoxColumn x:Name="BANK_COLUMN" HeaderText="نام بانک" MappingName="BANK" SelectedValuePath="CODE" DisplayMemberPath="NAMES" IsReadOnly="True"  />

                <syncfusion:GridTextColumn MappingName="SHOBEH" HeaderText="نام شعبه" IsReadOnly="True" />
                <syncfusion:GridTextColumn MappingName="CUST_NO" HeaderText="کد مشتری" IsReadOnly="True"  />
                <syncfusion:GridTextColumn MappingName="NAME_TAH" HeaderText="نام پرداخت کننده*" IsReadOnly="True" MinimumWidth="350" />
                <syncfusion:GridTextColumn MappingName="N_HESAB" HeaderText="شماره حساب" IsReadOnly="True"  />

                <syncfusion:GridTemplateColumn HeaderText="وضعیت چک" Width="110" MappingName="IsButtony" AllowSorting="False" AllowFiltering="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button IsTabStop="False" Click="Button_Click" Tag="{Binding}"
								materialDesign:ButtonAssist.CornerRadius="2"
								Style="{StaticResource MaterialDesignFlatButton}"
								HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Center"
								HorizontalContentAlignment="Center">
                                <materialDesign:PackIcon Kind="FileDocumentCheck"/>
                            </Button>

                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>
                <syncfusion:GridComboBoxColumn x:Name="VAZ_COLUMN" HeaderText="وضعیت چک" AllowEditing="False" IsReadOnly="True" MappingName="VAZ" SelectedValuePath="ID" DisplayMemberPath="NAME" />

                <syncfusion:GridTemplateColumn HeaderText="موقعیت چک" Width="110" MappingName="IsButtony" AllowSorting="False" AllowFiltering="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button IsTabStop="False" Click="Button_Click_1" Tag="{Binding}"
								materialDesign:ButtonAssist.CornerRadius="2"
								Style="{StaticResource MaterialDesignFlatButton}"
								HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Center"
								HorizontalContentAlignment="Center">
                                <materialDesign:PackIcon Kind="Location"/>
                            </Button>

                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>
                <syncfusion:GridComboBoxColumn x:Name="SANDUGH_COLUMN" MappingName="SANDUGH" HeaderText="موقعیت چک*" SelectedValuePath="TNUMBER" DisplayMemberPath="NAME" IsReadOnly="True"  />
                <syncfusion:GridTextColumn MappingName="ESTELAM" HeaderText="توضیحات" IsReadOnly="True"  />
                <syncfusion:GridTemplateColumn HeaderText="توضیحات" Width="110" MappingName="IsButtony" AllowSorting="False" AllowFiltering="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button IsTabStop="False" Click="Button_Click_2" Tag="{Binding}"
                                    materialDesign:ButtonAssist.CornerRadius="2"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                    HorizontalContentAlignment="Center">
                                <materialDesign:PackIcon Kind="StickyNoteText"/>
                            </Button>

                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>

                <syncfusion:GridTextColumn MappingName="N_KOL" HeaderText="به حساب کل" IsReadOnly="True"  />
                <syncfusion:GridTextColumn MappingName="N_MOIN" HeaderText="به حساب معین"  IsReadOnly="True" />
                <syncfusion:GridTextColumn MappingName="N_TAF" HeaderText="به حساب تفضیلی"  IsReadOnly="True" />
                <syncfusion:GridTextColumn MappingName="NAME" HeaderText="نام حساب" IsReadOnly="True" MinimumWidth="350"/>
                <syncfusion:GridTextColumn MappingName="N_S" HeaderText="شماره سند" IsReadOnly="True" />

                <syncfusion:GridTextColumn MappingName="N_KOL2" HeaderText="برگشت به حساب کل" MinimumWidth="180"  IsReadOnly="True" />
                <syncfusion:GridTextColumn MappingName="N_MOIN2" HeaderText="برگشت به حساب معین" MinimumWidth="180"  IsReadOnly="True"  />
                <syncfusion:GridTextColumn MappingName="N_TAF2" HeaderText="برگشت به حساب تفضیلی" MinimumWidth="180"  IsReadOnly="True"  />

                <syncfusion:GridTextColumn MappingName="N_KOL3" HeaderText="وصول به حساب کل" MinimumWidth="180" IsReadOnly="True"  />
                <syncfusion:GridTextColumn MappingName="N_MOIN3" HeaderText="وصول به حساب معین" MinimumWidth="180"  IsReadOnly="True" />
                <syncfusion:GridTextColumn MappingName="N_TAF3" HeaderText="وصول به حساب تفضیلی" MinimumWidth="180" IsReadOnly="True"  />

                <syncfusion:GridTextColumn MappingName="LISTNO" HeaderText="شماره لیست" MinimumWidth="180" IsReadOnly="True"  />
                <syncfusion:GridComboBoxColumn HeaderText="نوع" MappingName="KIND" IsReadOnly="True"  >
                    <syncfusion:GridComboBoxColumn.ItemsSource>
                        <x:Array Type="{x:Type sys:String}">
                            <sys:String>1;تجاري</sys:String>
                            <sys:String>0;غير تجاري</sys:String>
                        </x:Array>
                    </syncfusion:GridComboBoxColumn.ItemsSource>
                    <syncfusion:GridComboBoxColumn.DisplayMemberPath>
                        <Binding Path="Value" />
                    </syncfusion:GridComboBoxColumn.DisplayMemberPath>
                    <syncfusion:GridComboBoxColumn.SelectedValuePath>
                        <Binding Path="Key" />
                    </syncfusion:GridComboBoxColumn.SelectedValuePath>
                </syncfusion:GridComboBoxColumn>
                <syncfusion:GridTextColumn MappingName="SHOB_COD" HeaderText="کد شعبه" IsReadOnly="True"  />

                <syncfusion:GridTextColumn x:Name="HES1_COLUMN" MappingName="HES1" HeaderText=" به حساب " IsReadOnly="True" />
                <syncfusion:GridTextColumn x:Name="HES2_COLUMN" MappingName="HES2" HeaderText=" برگشت به حساب " IsReadOnly="True"  />
                <syncfusion:GridTextColumn x:Name="HES3_COLUMN" MappingName="HES3" HeaderText=" وصول به حساب "  IsReadOnly="True" />
                <syncfusion:GridTextColumn MappingName="BANK" HeaderText=" بانک "  IsReadOnly="True" />
                <syncfusion:GridTextColumn MappingName="ds" HeaderText="روز سررسید" IsReadOnly="True" />
                <syncfusion:GridTextColumn MappingName="ms" HeaderText="ماه سررسید" IsReadOnly="True" />
                <syncfusion:GridTextColumn MappingName="ys" HeaderText="سال سررسید" IsReadOnly="True" />
                <syncfusion:GridTextColumn MappingName="dd" HeaderText="روز دریافت" IsReadOnly="True" />
                <syncfusion:GridTextColumn MappingName="md" HeaderText="ماه دریافت" IsReadOnly="True" />
                <syncfusion:GridTextColumn MappingName="yd" HeaderText="سال دریافت" IsReadOnly="True" />

                <syncfusion:GridTextColumn MappingName="SAYADI" HeaderText="شماره صیادی"  IsReadOnly="True" />

            </syncfusion:SfDataGrid.Columns>

        </syncfusion:SfDataGrid>
        <Label Content="تعداد رکورد ها:" Margin="0,0,16,14" FlowDirection="RightToLeft" Width="84" HorizontalAlignment="Right" Height="27" VerticalAlignment="Bottom"/>
        <Label x:Name="ROWCOUNT_LABEL" Content="{Binding ElementName=SFDATAGRID_SUB,Path=View.Records.Count}" Margin="0,0,100,14" FlowDirection="RightToLeft" Width="230" HorizontalAlignment="Right" Height="27" VerticalAlignment="Bottom"/>

        <Popup x:Name="VAZ_Popup" IsOpen="False" Placement="MousePoint" StaysOpen="True" AllowsTransparency="True">
            <Border BorderThickness="1,1,1,1" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}" CornerRadius="5" Margin="0,5,0,5" Width="230" Height="262">
                <Grid Background="White" Margin="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderThickness="1,1,1,1" BorderBrush="Gray" CornerRadius="5" Margin="0,5,0,5">
                        <ListBox x:Name="VAZ_LISTBOX" Cursor="Hand" DisplayMemberPath="NAME" SelectedValuePath="ID"
                         FlowDirection="RightToLeft" />
                    </Border>

                    <Button Grid.Row="1" x:Name="BTN_APPLY_VAZ" Style="{StaticResource MaterialDesignFlatButton}" Click="BTN_APPLY_VAZ_Click" Content="ذخیره وضعیت چک" Margin="2" Height="34" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
        </Popup>

        <Popup x:Name="SANDUGH_Popup" IsOpen="False" Placement="MousePoint" StaysOpen="True" AllowsTransparency="True">

            <Border BorderThickness="1,1,1,1" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}" CornerRadius="5" Margin="0,5,0,5" Width="230" Height="262">
                <Grid Background="White" Margin="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderThickness="1,1,1,1" BorderBrush="Gray" CornerRadius="5" Margin="0,5,0,5">
                        <ListBox x:Name="SANDUGH_LISTBOX" Cursor="Hand" SelectedValuePath="TNUMBER" DisplayMemberPath="NAME"
                                 FlowDirection="RightToLeft" />
                    </Border>

                    <Button Grid.Row="1" x:Name="BTN_APPLY_SANDUGH" Style="{StaticResource MaterialDesignFlatButton}" Click="BTN_APPLY_SANDUGH_Click" Content="ذخیره موقعیت" Margin="2" Height="34" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
        </Popup>

        <Popup x:Name="ESTELAM_Popup" IsOpen="False" Placement="MousePoint" StaysOpen="True" AllowsTransparency="True">
            <Border BorderThickness="1,1,1,1" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}" CornerRadius="5" Margin="0,5,0,5" Width="230" Height="262">
                <Grid Background="White" Margin="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderThickness="1,1,1,1" BorderBrush="Gray" CornerRadius="5" Margin="0,5,0,5">
                        <TextBox x:Name="ESTELAM_TXB" FlowDirection="RightToLeft" AcceptsReturn="True" Text="" Style="{StaticResource FuzzyOut}" Padding="3" TextWrapping="Wrap" MaxLength="254"/>
                    </Border>

                    <Button Grid.Row="1" x:Name="BTN_APPLY_ESTELAM" Style="{StaticResource MaterialDesignFlatButton}" Click="BTN_APPLY_ESTELAM_Click" Content="ذخیره توضیحات" Margin="2" Height="34" VerticalAlignment="Bottom"/>
                </Grid>

            </Border>
        </Popup>

    </Grid>
</Window>