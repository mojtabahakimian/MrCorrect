<Window x:Class="Prg_UI.Wins.WinMenus.Checkha.CHEKS_BESTANKAR"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.Checkha"        
        mc:Ignorable="d"

        
        xmlns:sfusion="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:grid="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
        
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="{StaticResource IRANYEKAN}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Title="CHEKS_BESTANKAR" Height="450" Width="3853" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>

        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>

        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>

        <!-- Style for SfDataGrid NOW -->
        <Style x:Key="AlternatingRowStyle" TargetType="grid:VirtualizingCellsControl">
            <Setter Property="Background" Value="LightBlue"/>
        </Style>

        <!-- Style for SfDataGrid old -->
        <Style x:Key="KDG"  TargetType="syncfusion:SfDataGrid" BasedOn="{StaticResource SfDataGridStyle}">
            <Setter Property="CurrentCellBorderBrush" Value="{StaticResource GENERAL_Grlicom}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="BorderBrush" Value="{StaticResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="HeaderRowHeight" Value="40" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="GridLinesVisibility" Value="Both" />
        </Style>
        <!-- Modified Column Header Style -->
        <Style x:Key="KDGHeader" TargetType="syncfusion:GridHeaderCellControl" BasedOn="{StaticResource GridHeaderCellControlStyle}">
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="BorderBrush" Value="{Binding Background, ElementName=GENERAL_RANG}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="Auto"/>
        </Style>

        <Style TargetType="sfusion:GridCell" BasedOn="{StaticResource GridCellStyle}">
            <Setter Property="BorderBrush" Value="{Binding BorderBrush, ElementName=GENERAL_RANG}" />
        </Style>


        <!-- Context Menu defined in XAML -->
        <ContextMenu x:Key="DataGridContextMenu" FontFamily="{StaticResource IRANYEKAN}">
            <MenuItem Header="پالودن با این بخش" Click="FilterBySelection_Click">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="Filter"  FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <!--Filter Excluding Selection-->
            <MenuItem Header="پالودن بدون این بخش" Click="FilterExcludingSelection_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FilterRemove" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="کـپـی" Click="MenuItem_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="ContentCopy" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="حذف پالودن (فیلتر)" Click="RemoveFilterSort_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FilterRemoveOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <Separator/>
            <MenuItem Header="خروجی اکسل" Click="EXPORTEXCEL_BTN" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FileExcelOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="mygrid">
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="557,410,462,353"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label x:Name="WINTILENAME" Content="چکهای پرداختی اعلام وصول یا برگشت شده" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                                                       Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <!--HEADER↑-->

        <syncfusion:SfDataGrid x:Name="SYNCFUSION_DG" ContextMenu="{StaticResource DataGridContextMenu}"
           ItemsSource="{Binding CHECKS_B_DATA}" 
           AutoGenerateColumns="False"
           EnableDataVirtualization="True"
           SelectionUnit="Row"
           IsReadOnly="True"
           AllowDraggingRows="True"
           AllowDraggingColumns="True"
           AllowResizingColumns="True"
           AllowFiltering="True"
           AllowSorting="True"
           RowHeight="30"
                              
           FrozenColumnCount="0"
           FlowDirection="RightToLeft"
           d:ItemsSource="{d:SampleData ItemCount=5}"
           Style="{StaticResource KDG}"
           HeaderStyle="{StaticResource KDGHeader}"
           BorderBrush="{StaticResource GENERAL_Grlicom}"
           PreviewMouseRightButtonDown="SYNCFUSION_DG_PreviewMouseRightButtonDown"
           CurrentCellActivated="SYNCFUSION_DG_CurrentCellActivated"
		   SelectionChanged="SYNCFUSION_DG_SelectionChanged"
		   PreviewKeyDown="SYNCFUSION_DG_PreviewKeyDown"
           Margin="10,49,10,10" AllowRowHoverHighlighting="True" AllowSelectionOnPointerPressed="True" ScrollMode="Async" ShowRowHeader="True" ShowGroupDropArea="True"  AlternationCount="2" AlternatingRowStyle="{StaticResource AlternatingRowStyle}">

            <syncfusion:SfDataGrid.Resources>
                <ResourceDictionary>
                    <Style TargetType="TextBox">
                        <Setter Property="AcceptsReturn" Value="True" />
                        <Setter Property="Height" Value="40" />
                    </Style>
                </ResourceDictionary>
            </syncfusion:SfDataGrid.Resources>

            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn HeaderText="شماره سریال" MappingName="N_SERI" Width="150"/>

                <syncfusion:GridTextColumn HeaderText="مبلغ" MappingName="MABL" Width="200">
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="MABL" StringFormat="{}{0:#,0}" />
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>

                <syncfusion:GridTextColumn HeaderText="تاریخ سررسید" MappingName="DATE_S" Width="130">
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="DATE_S" StringFormat="####/##/##" />
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>

                <syncfusion:GridTextColumn HeaderText="تاریخ دریافت" MappingName="DATE" Width="130">
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="DATE" StringFormat="####/##/##" />
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>

                <syncfusion:GridTextColumn HeaderText="نام بانک" MappingName="NAMES" Width="90"/>
                <syncfusion:GridTextColumn HeaderText="نام شعبه" MappingName="SHOBEH" Width="200"/>
                <syncfusion:GridTextColumn HeaderText="نام دریافت کننده" MappingName="NAME_TAH" Width="350"/>
                <syncfusion:GridTextColumn HeaderText="شماره حساب" MappingName="N_HESAB" Width="150"/>
                <syncfusion:GridTextColumn HeaderText="شماره سند" MappingName="N_S" Width="100"/>
                <syncfusion:GridTextColumn HeaderText="به حساب کل" MappingName="N_KOL" Width="150"/>
                <syncfusion:GridTextColumn HeaderText="به حساب معین" MappingName="N_MOIN" Width="150"/>
                <syncfusion:GridTextColumn HeaderText="به حساب تفضیلی" MappingName="N_TAF" Width="150"/>
                <syncfusion:GridTextColumn HeaderText="برگشت به حساب کل" MappingName="N_KOL2" Width="200"/>
                <syncfusion:GridTextColumn HeaderText="برگشت به حساب میعن" MappingName="N_MOIN2" Width="200"/>
                <syncfusion:GridTextColumn HeaderText="برگشت به حساب تفضیلی" MappingName="N_TAF2" Width="200"/>
                <syncfusion:GridTextColumn HeaderText="وصول به حساب کل" MappingName="N_KOL3" Width="200"/>
                <syncfusion:GridTextColumn HeaderText="وصول به حساب معین" MappingName="N_MOIN3" Width="200"/>
                <syncfusion:GridTextColumn HeaderText="وصول به حساب تفضیلی" MappingName="N_TAF3" Width="200"/>
                <syncfusion:GridTextColumn HeaderText="صندوق" MappingName="VAZ" Width="90"/>
                <syncfusion:GridComboBoxColumn x:Name="VAZ_COLUMN" SelectedValuePath="CODE" DisplayMemberPath="NAME" HeaderText="نوع" MappingName="KIND" Width="130"/>

                <syncfusion:GridTextColumn HeaderText="شماره" MappingName="RADIF" Width="130" IsHidden="True"/>

            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

    </Grid>
</Window>
