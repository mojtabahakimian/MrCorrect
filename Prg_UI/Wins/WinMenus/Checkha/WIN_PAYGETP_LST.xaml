<Window x:Class="Wins.WinMenus.Checkha.WIN_PAYGETP_LST"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wins.WinMenus.Checkha"
        mc:Ignorable="d"
        
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:sfusion="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="{StaticResource IRANYEKAN}"
        WindowStartupLocation="CenterScreen"
        Title="دفتر چک های دریافتی" Height="600" Width="1024" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>

        <!-- Style for SfDataGrid -->
        <Style x:Key="KDG"  TargetType="syncfusion:SfDataGrid" BasedOn="{StaticResource SfDataGridStyle}">
            <Setter Property="CurrentCellBorderBrush" Value="{StaticResource GENERAL_Grlicom}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="BorderBrush" Value="{StaticResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="HeaderRowHeight" Value="40" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="GridLinesVisibility" Value="Both" />
        </Style>

        <!-- Modified Column Header Style -->
        <Style x:Key="KDGHeader" TargetType="syncfusion:GridHeaderCellControl" BasedOn="{StaticResource GridHeaderCellControlStyle}">
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="BorderBrush" Value="{Binding Background, ElementName=GENERAL_RANG}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="Auto"/>
        </Style>
        <Style TargetType="sfusion:GridCell" BasedOn="{StaticResource GridCellStyle}">
            <Setter Property="BorderBrush" Value="{Binding BorderBrush, ElementName=GENERAL_RANG}" />
        </Style>

        <ContextMenu x:Key="DataGridContextMenu" FontFamily="{StaticResource IRANYEKAN}">
            <MenuItem Header="پالودن با این بخش" Click="FilterBySelection_Click" />
            <!--Filter Excluding Selection-->
            <MenuItem Header="پالودن بدون این بخش" Click="FilterExcludingSelection_Click" />
            <Separator/>
            <!--Remove Filter/Sort-->
            <MenuItem Header="حذف پالودن (فیلتر)" Click="RemoveFilterSort_Click" />
        </ContextMenu>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="mygrid">
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="557,410,242,158"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label Content="دفتر چک های پرداختی" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                                                   Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <!--Start.......................................................................................-->

        <Button x:Name="BTN_UI_DELETE" Tag="hazfer" Visibility="Hidden" Margin="557,410,242,158"  Width="1"/>

        <syncfusion:SfDataGrid x:Name="PAY_GETP_SUB" ContextMenu="{StaticResource DataGridContextMenu}"
            ItemsSource="{Binding PAY_GETP_DATA}" 
            AutoGenerateColumns="False"     
            EnableDataVirtualization="True"
            SelectionUnit="Row"
            AllowDraggingRows="True"
            AllowDraggingColumns="True"
            AllowResizingColumns="True"
            AllowFiltering="True"
            AllowSorting="True"
            RowHeight="30"
            FrozenColumnCount="0"
            FlowDirection="RightToLeft"
            d:ItemsSource="{d:SampleData ItemCount=5}"
            Style="{StaticResource KDG}"
            HeaderStyle="{StaticResource KDGHeader}"
            AllowEditing="True"
            IsReadOnly="True"
            PreviewMouseRightButtonDown="PAY_GETP_SUB_PreviewMouseRightButtonDown"
            CurrentCellActivated="PAY_GETP_SUB_CurrentCellActivated"
            CurrentCellBeginEdit="PAY_GETP_SUB_CurrentCellBeginEdit"
            CurrentCellValidating="PAY_GETP_SUB_CurrentCellValidating"
            Margin="10,49,10,10" AllowRowHoverHighlighting="True" AllowSelectionOnPointerPressed="True" ScrollMode="Async" ShowRowHeader="True" ShowGroupDropArea="True" SelectionChanged="PAY_GETP_SUB_SelectionChanged" >

            <syncfusion:SfDataGrid.Columns>

                <syncfusion:GridTemplateColumn MappingName="IsButtony" HeaderText="سند" IsReadOnly="True" AllowResizing="False" Width="50" AllowFiltering="False" AllowSorting="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button 
                                IsTabStop="False"
                                Click="Button_Click"
                                Tag="{Binding}"
                                materialDesign:ButtonAssist.CornerRadius="1"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Center">
                                <materialDesign:PackIcon Kind="FileDocument"/>
                            </Button>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                    <syncfusion:GridTemplateColumn.CellStyle>
                        <Style TargetType="sfusion:GridCell">
                            <Setter Property="IsTabStop" Value="False"/>
                            <Setter Property="Focusable" Value="False"/>
                        </Style>
                    </syncfusion:GridTemplateColumn.CellStyle>
                </syncfusion:GridTemplateColumn>

                <syncfusion:GridTextColumn MappingName="N_SERI" HeaderText="شماره سریال" ColumnSizer="Auto" />
                <syncfusion:GridTextColumn MappingName="BANK_NAME" HeaderText="بانک" ColumnSizer="Auto" />
                <syncfusion:GridTextColumn MappingName="SHOBEH" HeaderText="نام شعبه" ColumnSizer="Auto" />

                <syncfusion:GridTextColumn HeaderText="تاریخ پرداخت" MappingName="DATE">
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="DATE" StringFormat="####/##/##" />
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>

                <syncfusion:GridTextColumn HeaderText="تاریخ سررسید" MappingName="DATE_S">
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="DATE_S" StringFormat="####/##/##" />
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>

                <syncfusion:GridTextColumn HeaderText="مبلغ" MappingName="MABL">
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="MABL" StringFormat="{}{0:#,0}" />
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>
                <syncfusion:GridTextColumn MappingName="NAME_TAH" HeaderText="نام دریافت کننده" ColumnSizer="Auto" />
                <syncfusion:GridTextColumn MappingName="N_HESAB" HeaderText="جاری چک" ColumnSizer="Auto" />
                <syncfusion:GridTextColumn MappingName="RADIF" HeaderText="ردیف" ColumnSizer="Auto" />
                <syncfusion:GridTextColumn MappingName="VAZ" HeaderText="صندوق" ColumnSizer="Auto" />
                <syncfusion:GridTextColumn MappingName="SAYADI" HeaderText="شماره صیادی" ColumnSizer="Auto" />

                <syncfusion:GridTemplateColumn HeaderText="حذف" MinimumWidth="90" MappingName="IsButtony" AllowSorting="False" AllowFiltering="False" d:IsHidden="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="BTN_DELETE_PAYCH" IsTabStop="False" Click="BTN_DELETE_PAYCH_Click" Tag="{Binding}"
                                materialDesign:ButtonAssist.CornerRadius="2"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Center">
                                <materialDesign:PackIcon Kind="RemoveBoxOutline"/>
                            </Button>

                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>

                <!--پرداخت از محل حساب-->
                <syncfusion:GridTextColumn MappingName="N_KOL" ColumnSizer="Auto" >
                    <syncfusion:GridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="حساب کل" Height="21" TextAlignment="Center"/>
                                <TextBlock FontSize="9" Foreground="Gray" Text="پرداخت از محل حساب" Margin="0,-1,0,0" TextAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </syncfusion:GridTextColumn.HeaderTemplate>
                </syncfusion:GridTextColumn>
                <syncfusion:GridTextColumn MappingName="N_KOL_NAME" HeaderText="نام کل" ColumnSizer="Auto" >
                    <syncfusion:GridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="نام کل" Height="21" TextAlignment="Center"/>
                                <TextBlock FontSize="9" Foreground="Gray" Text="پرداخت از محل حساب" Margin="0,-1,0,0" TextAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </syncfusion:GridTextColumn.HeaderTemplate>
                </syncfusion:GridTextColumn>
                <syncfusion:GridTextColumn MappingName="N_MOIN" ColumnSizer="Auto">
                    <syncfusion:GridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="حساب معین" Height="21" TextAlignment="Center"/>
                                <TextBlock FontSize="9" Foreground="Gray" Text="پرداخت از محل حساب" Margin="0,-1,0,0" TextAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </syncfusion:GridTextColumn.HeaderTemplate>
                </syncfusion:GridTextColumn>
                <syncfusion:GridTextColumn MappingName="N_MOIN_NAME" HeaderText="نام معین" ColumnSizer="Auto" >
                    <syncfusion:GridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="نام معین" Height="21" TextAlignment="Center"/>
                                <TextBlock FontSize="9" Foreground="Gray" Text="پرداخت از محل حساب" Margin="0,-1,0,0" TextAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </syncfusion:GridTextColumn.HeaderTemplate>
                </syncfusion:GridTextColumn>
                <syncfusion:GridTextColumn MappingName="N_TAF" ColumnSizer="Auto" >
                    <syncfusion:GridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="حساب تفضیلی" Height="21" TextAlignment="Center"/>
                                <TextBlock FontSize="9" Foreground="Gray" Text="پرداخت از محل حساب" Margin="0,-1,0,0" TextAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </syncfusion:GridTextColumn.HeaderTemplate>
                </syncfusion:GridTextColumn>
                <syncfusion:GridTextColumn MappingName="N_TAF_NAME" ColumnSizer="Auto" >
                    <syncfusion:GridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="نام تفضیلی" Height="21" TextAlignment="Center"/>
                                <TextBlock FontSize="9" Foreground="Gray" Text="پرداخت از محل حساب" Margin="0,-1,0,0" TextAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </syncfusion:GridTextColumn.HeaderTemplate>
                </syncfusion:GridTextColumn>

                <!--برگشت به حساب-->
                <syncfusion:GridTextColumn MappingName="N_KOL2" ColumnSizer="Auto" >
                    <syncfusion:GridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="حساب کل" Height="21" TextAlignment="Center"/>
                                <TextBlock FontSize="9" Foreground="Gray" Text="برگشت به حساب" Margin="0,-1,0,0" TextAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </syncfusion:GridTextColumn.HeaderTemplate>
                </syncfusion:GridTextColumn>
                <syncfusion:GridTextColumn MappingName="N_KOL2_NAME" ColumnSizer="Auto" >
                    <syncfusion:GridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="نام کل" Height="21" TextAlignment="Center"/>
                                <TextBlock FontSize="9" Foreground="Gray" Text="برگشت به حساب" Margin="0,-1,0,0" TextAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </syncfusion:GridTextColumn.HeaderTemplate>
                </syncfusion:GridTextColumn>
                <syncfusion:GridTextColumn MappingName="N_MOIN2" ColumnSizer="Auto" >
                    <syncfusion:GridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="حساب معین" Height="21" TextAlignment="Center"/>
                                <TextBlock FontSize="9" Foreground="Gray" Text="برگشت به حساب" Margin="0,-1,0,0" TextAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </syncfusion:GridTextColumn.HeaderTemplate>
                </syncfusion:GridTextColumn>
                <syncfusion:GridTextColumn MappingName="N_MOIN2_NAME" ColumnSizer="Auto" >
                    <syncfusion:GridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="نام معین" Height="21" TextAlignment="Center"/>
                                <TextBlock FontSize="9" Foreground="Gray" Text="برگشت به حساب" Margin="0,-1,0,0" TextAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </syncfusion:GridTextColumn.HeaderTemplate>
                </syncfusion:GridTextColumn>
                <syncfusion:GridTextColumn MappingName="N_TAF2" ColumnSizer="Auto" >
                    <syncfusion:GridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="حساب تفضیلی" Height="21" TextAlignment="Center"/>
                                <TextBlock FontSize="9" Foreground="Gray" Text="برگشت به حساب" Margin="0,-1,0,0" TextAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </syncfusion:GridTextColumn.HeaderTemplate>
                </syncfusion:GridTextColumn>
                <syncfusion:GridTextColumn MappingName="N_TAF2_NAME" ColumnSizer="Auto">
                    <syncfusion:GridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="نام تفضیلی" Height="21" TextAlignment="Center"/>
                                <TextBlock FontSize="9" Foreground="Gray" Text="برگشت به حساب" Margin="0,-1,0,0" TextAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </syncfusion:GridTextColumn.HeaderTemplate>
                </syncfusion:GridTextColumn>

                <!--وصول از حساب-->
                <syncfusion:GridTemplateColumn HeaderText="پاک کردن وضعیت" MinimumWidth="90" MappingName="IsButtony" AllowSorting="False" AllowFiltering="False" d:IsHidden="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="BTN_CLEAR_VOSUL" IsTabStop="False" Click="BTN_CLEAR_VOSUL_Click" Tag="{Binding}"
                                materialDesign:ButtonAssist.CornerRadius="2"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                HorizontalContentAlignment="Center">
                                <materialDesign:PackIcon Kind="ClearCircle"/>
                            </Button>

                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>

                <syncfusion:GridTextColumn MappingName="N_KOL3" ColumnSizer="Auto" >
                    <syncfusion:GridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="حساب کل" Height="21" TextAlignment="Center"/>
                                <TextBlock FontSize="9" Foreground="Gray" Text="وصول از حساب" Margin="0,-1,0,0" TextAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </syncfusion:GridTextColumn.HeaderTemplate>
                </syncfusion:GridTextColumn>
                <syncfusion:GridTextColumn MappingName="N_KOL3_NAME" ColumnSizer="Auto" >
                    <syncfusion:GridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="نام کل" Height="21" TextAlignment="Center"/>
                                <TextBlock FontSize="9" Foreground="Gray" Text="وصول از حساب" Margin="0,-1,0,0" TextAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </syncfusion:GridTextColumn.HeaderTemplate>
                </syncfusion:GridTextColumn>
                <syncfusion:GridTextColumn MappingName="N_MOIN3" ColumnSizer="Auto" >
                    <syncfusion:GridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="حساب معین" Height="21" TextAlignment="Center"/>
                                <TextBlock FontSize="9" Foreground="Gray" Text="وصول از حساب" Margin="0,-1,0,0" TextAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </syncfusion:GridTextColumn.HeaderTemplate>
                </syncfusion:GridTextColumn>
                <syncfusion:GridTextColumn MappingName="N_MOIN3_NAME" HeaderText="نام معین" ColumnSizer="Auto">
                    <syncfusion:GridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="نام معین" Height="21" TextAlignment="Center"/>
                                <TextBlock FontSize="9" Foreground="Gray" Text="وصول از حساب" Margin="0,-1,0,0" TextAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </syncfusion:GridTextColumn.HeaderTemplate>
                </syncfusion:GridTextColumn>
                <syncfusion:GridTextColumn MappingName="N_TAF3" HeaderText="وصول از حساب : تفضیلی" ColumnSizer="Auto" >
                    <syncfusion:GridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="حساب تفضیلی" Height="21" TextAlignment="Center"/>
                                <TextBlock FontSize="9" Foreground="Gray" Text="وصول از حساب" Margin="0,-1,0,0" TextAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </syncfusion:GridTextColumn.HeaderTemplate>
                </syncfusion:GridTextColumn>
                <syncfusion:GridTextColumn MappingName="N_TAF3_NAME" ColumnSizer="Auto" >
                    <syncfusion:GridTextColumn.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="نام تفضیلی" Height="21" TextAlignment="Center"/>
                                <TextBlock FontSize="9" Foreground="Gray" Text="وصول از حساب" Margin="0,-1,0,0" TextAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </syncfusion:GridTextColumn.HeaderTemplate>
                </syncfusion:GridTextColumn>

                <syncfusion:GridTextColumn MappingName="N_S" HeaderText="شماره سند" ColumnSizer="Auto" />
                <syncfusion:GridTextColumn MappingName="NUMBER" HeaderText="شماره فاکتور" ColumnSizer="Auto" />
                <syncfusion:GridTextColumn MappingName="TAG" HeaderText="نوع فاکتور" ColumnSizer="Auto" />

            </syncfusion:SfDataGrid.Columns>


        </syncfusion:SfDataGrid>

    </Grid>
</Window>
