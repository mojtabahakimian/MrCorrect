<Window x:Class="Prg_UI.Wins.WinMenus.Checkha.BAKCHEK"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.Checkha"
        mc:Ignorable="d"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        FontFamily="{StaticResource IRANYEKAN}"
   	    Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        WindowStartupLocation="CenterScreen" 
        Title="Window1" Height="575" Width="610" Closing="Window_Closing" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid x:Name="mygrid" Margin="-1,0,1,0" DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
        <Border  Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1" Margin="3,0,2,0">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="28.579" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label Padding="5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,0,107,0" Foreground="White"  FontSize="11">
                        <Label.Content>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text=" چک برگشتی" Margin="0,0,-100,0"  FontSize="15" Foreground="White" Width="104" Height="36"/>
                            </StackPanel>
                        </Label.Content>
                    </Label>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowRestore" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="95,56,0,0"  Width="1"/>
        <TextBox x:Name="RADIF" Height="27" Margin="0,54,129,0" IsReadOnly="True" Tag="RD"  Style="{StaticResource FuzzyOut}" Padding="3"   TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible"  HorizontalAlignment="Right" Width="81" IsTabStop="False" IsHitTestVisible="False" IsEnabled="False" />
        <Label x:Name="Label1_Copy" Content=": ردیف دفتر" HorizontalAlignment="Left" Margin="486,54,0,0" VerticalAlignment="Top" Width="auto"/>
        <ComboBox x:Name="N_SERI" Tag="RD" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Margin="371,87,130,0" VerticalAlignment="Top" Height="28" FlowDirection="RightToLeft"   IsEditable="True" SelectedIndex="0" Background="{x:Null}" BorderThickness="1" LostFocus="N_SERI_LostFocus" IsTabStop="True" TabIndex="1">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <Label x:Name="Label1" Content=": شماره سریال" HorizontalAlignment="Left" Margin="486,86,0,0" VerticalAlignment="Top" Width="auto"/>
        <ComboBox x:Name="BANK" Tag="RD" IsEnabled="False" IsReadOnly="True" Padding="7,0,10,0" Style="{StaticResource MaterialDesignOutlinedComboBox}" IsTextSearchEnabled="True" Margin="280,120,130,0" VerticalAlignment="Top" Height="28" FlowDirection="RightToLeft"   IsEditable="True" SelectedIndex="0" Background="{x:Null}" BorderThickness="1" Width="200">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <Label x:Name="Label3" Content=": بانک" HorizontalAlignment="Left" Margin="487,119,0,0" VerticalAlignment="Top" Width="auto"/>
        <xctk:MaskedTextBox x:Name="DATE"  Style="{StaticResource FuzzyOut}" Padding="3"  Mask="0000/00/00" Height="26" Margin="394,215,0,0" TextWrapping="Wrap" VerticalAlignment="Top"  BorderThickness="1" FontSize="12" HorizontalAlignment="Left" Width="86" TabIndex="4" />
        <Label x:Name="Label3_Copy2" Content=": تاریخ دریافت" HorizontalAlignment="Left" Margin="487,215,0,0" VerticalAlignment="Top" Width="auto"/>
        <xctk:MaskedTextBox x:Name="DATE_S" IsReadOnly="True" Style="{StaticResource FuzzyOut}" Padding="3"  Mask="0000/00/00" Height="26" Margin="394,152,0,0" TextWrapping="Wrap" VerticalAlignment="Top"  BorderThickness="1" FontSize="12" HorizontalAlignment="Left" Width="86" TabIndex="2" />
        <Label x:Name="Label3_Copy" Content=": تاریخ سررسید" HorizontalAlignment="Left" Margin="487,152,0,0" VerticalAlignment="Top" Width="auto"/>
        <Label x:Name="Label3_Copy1" Content=": نام شعبه" HorizontalAlignment="Left" Margin="487,183,0,0" VerticalAlignment="Top" Width="auto"/>
        <TextBox x:Name="SHOBEH" Height="27" Margin="281,183,0,0" IsReadOnly="True" Tag="RD"  Style="{StaticResource FuzzyOut}" Padding="3"   TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible"  HorizontalAlignment="Left" Width="200" TabIndex="3" />
        <TextBox x:Name="MABL" Height="27" Margin="319,246,0,0" IsReadOnly="True" Tag="RD"  Style="{StaticResource FuzzyOut}" Padding="3"   TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible"  HorizontalAlignment="Left" Width="161" IsTabStop="False" IsHitTestVisible="False" IsEnabled="False" />
        <Label x:Name="Label3_Copy4" Content=": مبلغ" HorizontalAlignment="Left" Margin="487,243,0,0" VerticalAlignment="Top" Width="auto"/>
        <Label x:Name="Label3_Copy5" Content=": نام پرداخت کننده" HorizontalAlignment="Left" Margin="487,276,0,0" VerticalAlignment="Top" Width="auto"/>
        <TextBox x:Name="NAME_TAH" Height="27" Margin="0,277,130,0" IsReadOnly="True" Tag="RD"  Style="{StaticResource FuzzyOut}" Padding="3"   TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible"  HorizontalAlignment="Right" Width="182" TabIndex="5" />
        <TextBox x:Name="N_HESAB" Height="27" Margin="0,308,130,0" IsReadOnly="True" Tag="RD"  Style="{StaticResource FuzzyOut}" Padding="3"   TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible"  HorizontalAlignment="Right" Width="161" TabIndex="6" />
        <Label x:Name="Label3_Copy6" Content=": شماره حساب" HorizontalAlignment="Left" Margin="487,305,0,0" VerticalAlignment="Top" Width="auto"/>
        <ComboBox x:Name="HES1" Tag="RD" IsEnabled="False" IsReadOnly="True" Padding="7,0,10,0" Style="{StaticResource MaterialDesignOutlinedComboBox}" IsTextSearchEnabled="True" Margin="112,340,130,0" VerticalAlignment="Top" Height="28" FlowDirection="RightToLeft"   IsEditable="True" SelectedIndex="0" Background="{x:Null}" BorderThickness="1">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <Label x:Name="Label3_Copy3" Content=": به حساب" HorizontalAlignment="Left" Margin="487,340,0,0" VerticalAlignment="Top" Width="auto"/>
        <ComboBox x:Name="SANDUGH" Tag="RD" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Margin="279,373,130,0" VerticalAlignment="Top" Height="28" FlowDirection="RightToLeft"   IsEditable="True" SelectedIndex="0" Background="{x:Null}" BorderThickness="1" IsTabStop="True" TabIndex="7">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <Label x:Name="Label3_Copy7" Content=": موقعیت چک" HorizontalAlignment="Left" Margin="487,373,0,0" VerticalAlignment="Top" Width="auto"/>
        <ComboBox x:Name="VAZ" Tag="RD" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Margin="346,406,130,0" VerticalAlignment="Top" Height="28" FlowDirection="RightToLeft"   IsEditable="True" SelectedIndex="0" Background="{x:Null}" BorderThickness="1" IsTabStop="True" TabIndex="8">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <Label x:Name="Label3_Copy9" Content=": وضعیت چک" HorizontalAlignment="Left" Margin="487,406,0,0" VerticalAlignment="Top" Width="auto"/>
        <Button x:Name="_Exit" Content="خروج" Margin="319,517,0,0"    BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="12" Height="37" VerticalAlignment="Top" HorizontalAlignment="Left" Width="112" Foreground="#DDFFFFFF" FontWeight="Bold" Click="_Exit_Click"/>
        <Button x:Name="_SaveExit" Content="تصویب و خروج" Margin="176,517,0,0"    BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="12" Height="38" VerticalAlignment="Top" HorizontalAlignment="Left" Width="122" Foreground="#DDFFFFFF" FontWeight="Bold" Click="_SaveExit_Click" TabIndex="9"/>
        <TextBox x:Name="KOL" Height="27" Margin="0,65,452,0" IsReadOnly="True" Tag="RD"  Style="{StaticResource FuzzyOut}" Padding="3"   TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible"  HorizontalAlignment="Right" Width="134" IsTabStop="False" IsHitTestVisible="False" IsEnabled="False" />
        <Label x:Name="Label3_Copy8" Content=": از حساب کل" HorizontalAlignment="Left" Margin="165,62,0,0" VerticalAlignment="Top" Width="auto"/>
        <TextBox x:Name="MOIN" Height="27" Margin="0,99,452,0" IsReadOnly="True" Tag="RD"  Style="{StaticResource FuzzyOut}" Padding="3"   TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible"  HorizontalAlignment="Right" Width="134" IsTabStop="False" IsHitTestVisible="False" IsEnabled="False" />
        <Label x:Name="Label3_Copy10" Content=": از حساب معین" HorizontalAlignment="Left" Margin="165,96,0,0" VerticalAlignment="Top" Width="auto"/>
        <TextBox x:Name="TAF" Height="27" Margin="0,133,452,0" IsReadOnly="True" Tag="RD"  Style="{StaticResource FuzzyOut}" Padding="3"   TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible"  HorizontalAlignment="Right" Width="134" IsEnabled="False" IsHitTestVisible="False" IsTabStop="False" />
        <Label x:Name="Label3_Copy11" Content=": از حساب تفضیلی" HorizontalAlignment="Left" Margin="165,130,0,0" VerticalAlignment="Top" Width="auto"/>
    </Grid>
</Window>
