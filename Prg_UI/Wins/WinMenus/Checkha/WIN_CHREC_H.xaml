<Window x:Class="Wins.WinMenus.Checkha.WIN_CHREC_H"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wins.WinMenus.Checkha"
        mc:Ignorable="d"
        
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:sfusion="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="{StaticResource IRANYEKAN}"
        WindowStartupLocation="CenterScreen"
        Height="600" Width="1024" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>

        <!-- Style for SfDataGrid -->
        <Style x:Key="KDG"  TargetType="syncfusion:SfDataGrid" BasedOn="{StaticResource SfDataGridStyle}">
            <Setter Property="CurrentCellBorderBrush" Value="{StaticResource GENERAL_Grlicom}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="BorderBrush" Value="{StaticResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="HeaderRowHeight" Value="40" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="GridLinesVisibility" Value="Both" />
        </Style>

        <!-- Modified Column Header Style -->
        <Style x:Key="KDGHeader" TargetType="syncfusion:GridHeaderCellControl" BasedOn="{StaticResource GridHeaderCellControlStyle}">
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="BorderBrush" Value="{Binding Background, ElementName=GENERAL_RANG}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="Auto"/>
        </Style>
        <Style TargetType="sfusion:GridCell" BasedOn="{StaticResource GridCellStyle}">
            <Setter Property="BorderBrush" Value="{Binding BorderBrush, ElementName=GENERAL_RANG}" />
        </Style>

        <ContextMenu x:Key="DataGridContextMenu" FontFamily="{StaticResource IRANYEKAN}">
            <MenuItem Header="پالودن با این بخش" Click="FilterBySelection_Click" />
            <!--Filter Excluding Selection-->
            <MenuItem Header="پالودن بدون این بخش" Click="FilterExcludingSelection_Click" />
            <Separator/>
            <!--Remove Filter/Sort-->
            <MenuItem Header="حذف پالودن (فیلتر)" Click="RemoveFilterSort_Click" />
        </ContextMenu>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="mygrid">
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="643,410,328,158"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label Content="اعلام وصول چکهای دریافتی" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                                                   Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <!--Start.......................................................................................-->
        <Button x:Name="BTN_UI_DELETE" Tag="hazfer" Visibility="Hidden" Margin="643,410,328,158"  Width="1"/>

        <syncfusion:SfDataGrid x:Name="VOSULMASTER_SUB" ContextMenu="{StaticResource DataGridContextMenu}"
                ItemsSource="{Binding VOSULMASTER_DATA}" 
                AutoGenerateColumns="False"     
                EnableDataVirtualization="True"
                SelectionUnit="Row"
                AllowDraggingRows="True"
                AllowDraggingColumns="True"
                AllowResizingColumns="True"
                AllowFiltering="True"
                AllowSorting="True"
                RowHeight="30"
                FrozenColumnCount="0"
                FlowDirection="RightToLeft"
                d:ItemsSource="{d:SampleData ItemCount=5}"
                Style="{StaticResource KDG}"
                HeaderStyle="{StaticResource KDGHeader}"
                AllowEditing="True"
                CurrentCellValidating="VOSULMASTER_SUB_CurrentCellValidating"
                PreviewMouseRightButtonDown="VOSULMASTER_SUB_PreviewMouseRightButtonDown"
                SelectionChanged="VOSULMASTER_SUB_SelectionChanged" 
                Margin="4,50,4,0" AllowRowHoverHighlighting="True" AllowSelectionOnPointerPressed="True" ScrollMode="Async" ShowRowHeader="True" ShowGroupDropArea="True" Height="226" VerticalAlignment="Top" RowValidating="VOSULMASTER_SUB_RowValidating">
            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridTextColumn HeaderText="تاریخ" MappingName="DATE">
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="DATE" StringFormat="####/##/##" />
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>
                <syncfusion:GridTextColumn MappingName="MOLAH" HeaderText="ملاحظات" ColumnSizer="Star" />
                <syncfusion:GridTextColumn MappingName="N_S" HeaderText="شماره سند" ColumnSizer="Auto" IsReadOnly="True" />
                <syncfusion:GridTemplateColumn HeaderText="باز کردن سند" x:Name="N_SCOLUMNBTN" Width="110" MappingName="IsButtony" IsHidden="False" AllowSorting="False" AllowFiltering="False" d:IsHidden="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="BTN_N_S_OPEN" IsTabStop="False" Click="BTN_N_S_OPEN_Click" Tag="{Binding}"
                                    materialDesign:ButtonAssist.CornerRadius="2"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                    HorizontalContentAlignment="Center">
                                <materialDesign:PackIcon Kind="FileDocument"/>
                            </Button>

                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>
                <syncfusion:GridTemplateColumn HeaderText="صدور سند" Width="110" MappingName="IsButtony" IsHidden="False" AllowSorting="False" AllowFiltering="False" d:IsHidden="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="BTN_N_SCHECK" IsTabStop="False" Click="BTN_N_SCHECK_Click" Tag="{Binding}"
                                    materialDesign:ButtonAssist.CornerRadius="2"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                    HorizontalContentAlignment="Center">
                                <materialDesign:PackIcon Kind="CheckBold"/>
                            </Button>

                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>
            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>

        <DataGrid   
                 x:Name="DETAIL_VOSUL_SUB"
                 IsReadOnly="True"
                 EnableColumnVirtualization="True"
                 EnableRowVirtualization="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.CanContentScroll="False"
                 ItemsSource="{Binding DETAILVOSUL_DATA}"
                 ColumnHeaderStyle="{StaticResource CenteryHeaderstyle}"
                 CellStyle="{StaticResource CellFocusyBorder}"
                 HorizontalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                 VerticalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                 KeyboardNavigation.TabNavigation="Contained"
                 AutoGenerateColumns="False" 
                 FlowDirection="RightToLeft" 
                 SelectionUnit="FullRow" 
                 CanUserDeleteRows="False"
                 Margin="4,334,4,47" BorderThickness="1" CanUserAddRows="False" IsEnabled="False" SelectionMode="Single" SelectionChanged="DETAIL_VOSUL_SUB_SelectionChanged">

            <DataGrid.Style>
                <!--خط بندی سطر های دیتاگرید-->
                <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource MaterialDesignDataGrid}"> <Setter Property="materialDesign:DataGridAssist.EnableEditBoxAssist" Value="False"/>
                    <Setter Property="GridLinesVisibility" Value="All"/>
                </Style>
            </DataGrid.Style>

            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding N_SERI,UpdateSourceTrigger=LostFocus}" Header="شماره سریال" Width="auto" />
                <DataGridTextColumn Binding="{Binding BANK_NAME,UpdateSourceTrigger=LostFocus}" Header="بانک" Width="auto" />
                <DataGridTextColumn Binding="{Binding SHOBEH,UpdateSourceTrigger=LostFocus}" Header="شعبه" Width="auto" MinWidth="100" />
                <DataGridTextColumn Binding="{Binding DATE_S, StringFormat=####/##/##}" Header="تاریخ سررسید" Width="auto"/>
                <DataGridTextColumn Binding="{Binding MABL,UpdateSourceTrigger=LostFocus ,StringFormat=\{0:N0\}}" Header="مبلغ" Width="auto"/>
                <DataGridTextColumn Binding="{Binding HES1_NAME,UpdateSourceTrigger=LostFocus}" Header="به حساب" Width="*" />
                <DataGridTextColumn Binding="{Binding N_TAF,UpdateSourceTrigger=LostFocus}" Header="حساب تفضیلی" Width="auto" />
            </DataGrid.Columns>

        </DataGrid>
        <Button x:Name="BTN_ESLAH" Margin="0,287,7,0" HorizontalAlignment="Right" VerticalAlignment="Top" Content="اصلاح" FontSize="10" BorderBrush="{x:Null}" Foreground="#DDFFFFFF" Height="35" Width="126" Click="BTN_ESLAH_Click" />

        <Button x:Name="BTN_DELETEVOSUL" Margin="0,287,148,0" Tag="hazfer" Content="حذف وصولی این چک" FontSize="10" BorderBrush="{x:Null}" Foreground="#DDFFFFFF" Height="35" HorizontalAlignment="Right" VerticalAlignment="Top" Width="181" Click="BTN_DELETEVOSUL_Click"/>
        <Button x:Name="PRINTC" Margin="0,287,345,0" Content="چاپ برگه" FontSize="10" BorderBrush="{x:Null}" Foreground="#DDFFFFFF" Height="35" HorizontalAlignment="Right" VerticalAlignment="Top" Width="108" Click="PRINTC_Click"/>

        <Label Content="جمع مبالغ :" Margin="175,0,0,10" FlowDirection="RightToLeft" Width="67" HorizontalAlignment="Left" Height="27" VerticalAlignment="Bottom"/>
        <CNC:NumericTextBox x:Name="MABL_JAM" DoesAcceptDouble="False" DigitGroupOnEnter="True" IsDigitGroupActive="True" IsReadOnly="True" Height="27" Margin="4,0,0,10"    VerticalAlignment="Bottom"  Visibility="Visible"  HorizontalAlignment="Left" Width="166" Text="0" />

    </Grid>
</Window>
