<Window x:Class="Wins.WinMenus.Checkha.CHAPCHEK"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wins.WinMenus.Checkha"
        mc:Ignorable="d"
        
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        MaxHeight="{Binding Height, Source={x:Static SystemParameters.WorkArea}}"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="{StaticResource IRANYEKAN}"
        WindowStartupLocation="CenterScreen"
        Title="Window4" Height="288" Width="586" MinHeight="288" MinWidth="586" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="mygrid">
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="557,410,462,353"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label Content="چاپ سریع چک" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Click="Btn_Close_Click" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False">
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False">
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False">
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                                                       Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <!--HEADER↑-->

        <!--Start.......................................................................................-->
        <StackPanel FlowDirection="RightToLeft" Margin="19,53,21,10">

            <StackPanel FlowDirection="RightToLeft" Orientation="Horizontal" Margin="0,5,0,0">
                <Label Content="تاریخ چک:" FlowDirection="RightToLeft" Width="auto" Padding="6,4,4,4"/>
                <xctk:MaskedTextBox x:Name="date_s" Style="{StaticResource FuzzyOut}" Padding="3" FlowDirection="LeftToRight" Mask="0000/00/00" Height="30" BorderThickness="1" FontSize="12" Width="88"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Label Content="مبلغ:" Width="auto" Padding="34,4,4,4"/>
                <CNC:NumericTextBox FlowDirection="LeftToRight" x:Name="mabl" DoesAcceptDouble="False" ThreeTwoZero="True" DigitGroupOnEnter="True" IsDigitGroupActive="True" Text="0" Height="30" Visibility="Visible" Width="170"/>
            </StackPanel>

            <StackPanel  Orientation="Horizontal" Margin="0,5,0,0">
                <Label Content="دروجه:" FlowDirection="RightToLeft" Width="auto" Padding="25,4,4,4"/>
                <TextBox x:Name="VAJH" Text="" Height="30" TextAlignment="Left" Style="{StaticResource FuzzyOut}" Padding="3" TextWrapping="Wrap"  Visibility="Visible" MaxLength="48" Width="467" />
            </StackPanel>

            <StackPanel  Orientation="Horizontal" Margin="0,5,0,0">
                <Label Content="از حساب:" FlowDirection="RightToLeft" Width="auto" Padding="12,4,4,4"/>
                <ComboBox x:Name="MOIN" Padding="7,0,10,0" SelectedValuePath="CODE" DisplayMemberPath="NAMES" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Height="30" FlowDirection="RightToLeft" IsEditable="True"  Background="{x:Null}" BorderThickness="1" Width="212">
                    <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                        </ItemsPanelTemplate>
                    </ComboBox.ItemsPanel>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <Label Content="دسته چک:" FlowDirection="RightToLeft" Width="auto"/>
                <ComboBox x:Name="kindp" SelectedValuePath="CO_KIND" DisplayMemberPath="KIND" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Height="30" FlowDirection="RightToLeft" IsEditable="True"  Background="{x:Null}" BorderThickness="1" Width="212">
                    <ComboBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                        </ItemsPanelTemplate>
                    </ComboBox.ItemsPanel>
                </ComboBox>
            </StackPanel>
            <DockPanel Margin="0,8,0,0">
                <Button x:Name="BTN_GO" Style="{StaticResource MaterialDesignFlatButton}" Content="چاپ چک" BorderBrush="{x:Null}" FontSize="12" Height="34" Click="BTN_GO_Click" Width="302" />
                <StackPanel Orientation="Horizontal" Width="213">
                    <RadioButton Content="فرمت پیش فرض"  IsChecked="True" FontSize="10" x:Name="RD_DEFAULT" GroupName="RDR" Margin="5" Foreground="{Binding ElementName=GENERAL_RANG,Path=Background}" Padding="4,-1,0,0"/>
                    <RadioButton Content="فرمت تنظیم شده" IsChecked="False" FontSize="10" x:Name="RD_FORMATDB" GroupName="RDR" Margin="5" Foreground="{Binding ElementName=GENERAL_RANG,Path=Background}" Padding="4,-1,0,0"/>
                </StackPanel>
            </DockPanel>
        </StackPanel>

        <Button x:Name="BTN_HELP" Style="{StaticResource MaterialDesignFlatButton}" Cursor="Hand" Content="?" BorderBrush="{x:Null}" FontSize="12" Click="BTN_HELP_Click" Margin="10,46,0,0" Height="39" VerticalAlignment="Top" HorizontalAlignment="Left" Width="49" />
    </Grid>
</Window>

