<Window x:Class="Prg_UI.Wins.WinMenus.Checkha.WIN_CHREC_HES"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.Checkha"
        mc:Ignorable="d"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Height="600" Width="1024"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        MinHeight="400"
        FontFamily="{StaticResource IRANYEKAN}"
        Background="{x:Null}"
        AllowsTransparency="True" AllowDrop="True"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="15"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Color="{Binding ElementName=GENERAL_RANG, Path=Background.Color}" Opacity="0.3"/>
    </Window.Resources>

    <Grid x:Name="mygrid" Margin="8,8,8,0">
        <!-- Hidden button for color binding reference -->
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Width="1" Height="1"/>
        <!-- Main container -->
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding ElementName=GENERAL_RANG, Path=Background}" BorderThickness="1" CornerRadius="10" Padding="8">
            <!-- Title bar -->
            <Border  x:Name="TitleDrawBar" Style="{StaticResource BordG}"  Background="{Binding ElementName=GENERAL_RANG, Path=Background}"  CornerRadius="10,10,0,0" Margin="-9,-9,-9,0"  Height="38"  VerticalAlignment="Top" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <!-- Window title -->
                    <Label x:Name="LABEL_HEADER" Content="به حساب گذاشتن چكهاي دریافتی" Padding="17,8,10,10" Foreground="White" Margin="0,0,110,0" VerticalAlignment="Center"/>
                    <!-- Window control buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0">
                        <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0,0,0,-1" IsTabStop="False" ToolTip="Minimize">
                            <materialDesign:PackIcon Kind="WindowMinimize" Width="18" Height="18" Foreground="White"/>
                        </Button>
                        <Button x:Name="Btn_Max" Click="Btn_Max_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" FontSize="12" Height="24" Padding="0" Margin="4,0,0,0" IsTabStop="False" ToolTip="Maximize">
                            <materialDesign:PackIcon Kind="WindowMaximize" Width="17" Height="17" Foreground="White"/>
                        </Button>
                        <Button x:Name="Btn_Close" Click="Btn_Close_Click" Style="{StaticResource MaterialDesignFlatButton}" Width="24" Height="24" Padding="0" Margin="4,0,0,0" FontSize="12" IsTabStop="False" ToolTip="Close">
                            <materialDesign:PackIcon Kind="WindowClose" Width="19" Height="19" Foreground="White"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>
        <!-- Notification popup -->
        <Popup x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative" Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Width="{Binding ElementName=mygrid, Path=ActualWidth, Mode=OneWay}" Height="84" Padding="10">
                <TextBox x:Name="Pop1Text1" IsReadOnly="True" Background="Transparent" BorderBrush="Transparent" Foreground="White" Text="محل نمایش اعلان های سیستم" TextAlignment="Center" VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
            </Border>
        </Popup>

        <!-- Content area -->
        <Grid Margin="0,38,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Title Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Header Controls -->
                <RowDefinition Height="*"/>
                <!-- DataGrid -->
                <RowDefinition Height="Auto"/>
                <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- Header Controls -->
            <Grid Grid.Row="1" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="377*"/>
                    <ColumnDefinition Width="Auto" MinWidth="37.414"/>
                    <ColumnDefinition Width="414*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 0 -->
                <Button x:Name="PRINTC" Content="چاپ برگه" IsEnabled="False" Click="PRINTC_Click" BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Grid.Row="0" Grid.Column="0" Margin="5,5,0,5" Width="100" HorizontalAlignment="Left"/>

                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0,0,0" Width="297">
                    <TextBlock Text="انتخاب بانک برای چاپ:" VerticalAlignment="Center" Margin="5"/>
                    <ComboBox x:Name="N_TAF" Width="200" DisplayMemberPath="NAME" SelectedValuePath="hes" FlowDirection="RightToLeft"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left" Grid.ColumnSpan="2" Margin="1,0,0,0" Width="443">
                    <TextBlock Text="شهرستان محل پرداخت:" VerticalAlignment="Center" Margin="5"/>
                    <TextBox x:Name="CITY" Width="150"/>
                    <TextBlock Text="تاریخ:" VerticalAlignment="Center" Margin="10,5,5,5"/>
                    <xctk:MaskedTextBox x:Name="DATE" Style="{StaticResource FuzzyOut}" Padding="3" Mask="0000/00/00" Height="30" BorderThickness="1" FontSize="12"  HorizontalAlignment="Right" Width="88"/>
                </StackPanel>

                <!-- Row 1 -->
                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="5,5,5,5">
                    <TextBlock Text="شماره فرمت چاپ:" VerticalAlignment="Center" Margin="5"/>
                    <CNC:NumericTextBox x:Name="CHK" Width="50" Text="0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="60,5,0,5" Width="357">
                    <TextBlock Text="ملاحظات:" VerticalAlignment="Center" Margin="5"/>
                    <TextBox x:Name="MOLAH" Width="300"/>
                </StackPanel>

                <!-- Row 2 -->
                <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="212,5,0,5" Width="205">
                    <TextBlock Text="ثبت در سند شماره:" VerticalAlignment="Center" Margin="5" />
                    <TextBox x:Name="N_S" Width="100" IsReadOnly="True" MouseDoubleClick="N_S_MouseDoubleClick"/>
                </StackPanel>
                <Button x:Name="Btn_Delete" Content="حذف" Tag="hazfer" Click="Btn_Delete_Click" BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Grid.Row="2" Grid.Column="0" Margin="5,5,0,3" Width="100" HorizontalAlignment="Left"/>
                <Button x:Name="Btn_Save" Content="ذخیره" Click="Btn_Save_Click" BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Grid.Row="2" Grid.Column="3" Margin="98,4,0,4" Width="100" HorizontalAlignment="Left"/>
            </Grid>

            <!-- DataGrid -->
            <DataGrid Grid.Row="2" x:Name="CHRE_LSTH_SUB" AutoGenerateColumns="False" Margin="10" FlowDirection="RightToLeft" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="شماره سریال" Binding="{Binding N_SERI}" Width="*"/>
                    <DataGridTextColumn Header="بانک" Binding="{Binding BANK_NAME}" Width="*"/>
                    <DataGridTextColumn Header="شعبه" Binding="{Binding SHOBEH}" Width="*"/>
                    <DataGridTextColumn Header="تاریخ سررسید" Binding="{Binding DATE_S, StringFormat={}{0:####/##/##}}" Width="*"/>
                    <DataGridTextColumn Header="مبلغ" Binding="{Binding MABL, StringFormat={}{0:N0}}" Width="*"/>
                    <DataGridTextColumn Header="کاربر" Binding="{Binding USER_NAME}" Width="*"/>
                    <!-- Assuming USER_NAME exists or needs to be added to query -->
                    <DataGridTextColumn Header="به حساب" Binding="{Binding HES1_NAME}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Footer -->
            <Grid Grid.Row="3" Margin="10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <!-- Navigation Buttons -->
                    <!--<Button x:Name="Btn_First" Content="|&lt;" Width="40" Margin="2" Click="Btn_First_Click"/>
                    <Button x:Name="Btn_Prev" Content="&lt;" Width="40" Margin="2" Click="Btn_Prev_Click"/>
                    <TextBox x:Name="Txt_RecordInfo" Width="100" TextAlignment="Center" IsReadOnly="True" VerticalContentAlignment="Center" Margin="2"/>
                    
                    <Button x:Name="Btn_Next" Content="&gt;" Width="40" Margin="2" Click="Btn_Next_Click"/>
                    <Button x:Name="Btn_Last" Content="&gt;|" Width="40" Margin="2" Click="Btn_Last_Click"/>
                    <Button x:Name="Btn_New" Content="*" Width="40" Margin="2" Click="Btn_New_Click" ToolTip="New Record"/>
                    <Button x:Name="Btn_Save" Content="Save" Width="60" Margin="10,2" Click="Btn_Save_Click"/>
                    <Button x:Name="Btn_Delete" Content="Delete" Width="60" Margin="2" Click="Btn_Delete_Click" Background="Red" Foreground="White"/>-->
                    <CNC:RecordNavigatorControl x:Name="navigatorControl" VerticalAlignment="Bottom"/>

                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <TextBlock Text="جمع مبالغ:" VerticalAlignment="Center" Margin="5"/>
                    <TextBox x:Name="Text10" Width="150" IsReadOnly="True" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>