<Window x:Class="Prg_UI.Wins.WinMenus.WinAutomasion.MAIN"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.WinAutomasion"
        mc:Ignorable="d"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:conv="clr-namespace:Validatory"
        
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        
        FontFamily="{StaticResource IRANYEKAN}"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Background="{x:Null}" AllowsTransparency="True"
        AllowDrop="True"
        WindowStyle="None"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Title="اتوماسیون اداری" Height="760" Width="1245" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" Closed="Window_Closed" PreviewKeyDown="Window_PreviewKeyDown" >
    <!--xmlns:Cnv="clr-namespace:Proccessy.Models.ConvertorsVals;assembly=Proccessy"-->
    <!--<Window.Resources>
        <Cnv:SALNAME_CONRETOR x:Key="SAL_NAMEConverter" />
    </Window.Resources>-->

    <Window.Resources>
        <conv:SlashyConverter x:Key="SlashyConverter"/>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>

        <!--<Style x:Key="AlternatingRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="0">
                    <Setter Property="Background" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#F0F8FF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FF0360AD"/>
                </Trigger>
            </Style.Triggers>
        </Style>-->


    </Window.Resources>

    <Grid x:Name="mygrid" Margin="10,10,10,10">
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="557,410,462,353"  Width="1"/>
        <Border  Background="{StaticResource MaterialDesign.Brush.Background}"   CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderBrush="{Binding ElementName=TitleDrawBar,Path=Background}" BorderThickness="1" d:IsHidden="False" Margin="4,0,0,0">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding ElementName=RefloadBtn,Path=Background}" Margin="-9,-9,-9,0" VerticalAlignment="Top" UseLayoutRounding="False" Height="38" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label Content="اتوماسیون اداری" Padding="21,10,10,10" Foreground="White" HorizontalAlignment="Left" Width="286"/>
                    <Button x:Name="Btn_Close" Margin="0,10,10,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,39,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowRestore" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,68,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>

        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                     Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>

        <!--HEADER-->

        <Grid Margin="0,38,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="193.333"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="UpdateSelectedRowsBTN" Click="UpdateSelectedRowsBTN_Click" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,172,424,0" Width="214" Height="35" Padding="15.5,4,16,4" FontSize="11">
                <Button.ContentTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,-1,0,0">
                            <materialDesign:PackIcon Kind="ModeEdit" Foreground="#DDFFFFFF" VerticalAlignment="Center" Margin="0,0,0,-1"/>
                            <Label Content="ذخیره به شکل ویرایش گروهی" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="4,0,4,2"/>
                        </StackPanel>
                    </DataTemplate>
                </Button.ContentTemplate>
            </Button>

            <DataGrid x:Name="tASKSDataGrid"
                  RowBackground="{DynamicResource MaterialDesignCardBackground}"
                  AlternationCount="2"
                      
                  d:ItemsSource="{d:SampleData ItemCount=5}"
                  ContextMenuOpening="tASKSDataGrid_ContextMenuOpening"
                  ItemsSource="{Binding TASK_DATA}"
                      
                  IsReadOnly="True"
                  CanUserDeleteRows="False"
                  CanUserAddRows="False"
                      
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  ScrollViewer.CanContentScroll="True"
                  FlowDirection="RightToLeft" AutoGenerateColumns="False"  Margin="10,220,3,10" BorderThickness="1"  SelectionChanged="tASKSDataGrid_SelectionChanged" PreviewMouseLeftButtonUp="tASKSDataGrid_PreviewMouseLeftButtonUp" SelectionMode="Single"  PreviewKeyDown="tASKSDataGrid_PreviewKeyDown" IsKeyboardFocusWithinChanged="tASKSDataGrid_IsKeyboardFocusWithinChanged">
                
                <DataGrid.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                    </ItemsPanelTemplate>
                </DataGrid.ItemsPanel>

                <DataGrid.Columns>
                    <DataGridCheckBoxColumn x:Name="COLUMN_SELECTIVE" CanUserSort="False" IsReadOnly="False" Header="انتخاب" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        <DataGridCheckBoxColumn.ElementStyle>
                            <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource MaterialDesignCheckBox}">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="IsTabStop" Value="False"/>
                                <EventSetter Event="ButtonBase.Click" Handler="COLUMN_SELECTIVE_Click"/>
                            </Style>
                        </DataGridCheckBoxColumn.ElementStyle>
                        <DataGridCheckBoxColumn.EditingElementStyle>
                            <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource MaterialDesignCheckBox}">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="IsTabStop" Value="False"/>
                            </Style>
                        </DataGridCheckBoxColumn.EditingElementStyle>
                    </DataGridCheckBoxColumn>


                    <DataGridTemplateColumn IsReadOnly="True" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button x:Name="Taeed_automasionBtn" IsTabStop="False" Click="Taeed_automasionBtn_Click" Tag="{Binding}" materialDesign:ButtonAssist.CornerRadius="2"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                        Margin="-14,-7,-14,-7" HorizontalContentAlignment="Center">
                                    <materialDesign:PackIcon Kind="Plus"/>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                <Setter Property = "IsTabStop" Value = "False" />
                            </Style>
                        </DataGridTemplateColumn.CellStyle>
                    </DataGridTemplateColumn>


                    <DataGridTextColumn x:Name="IDNUM" Binding="{Binding IDNUM,  UpdateSourceTrigger=PropertyChanged}"   Header="شماره" IsReadOnly="True" Width="90" />
                    <DataGridTextColumn x:Name="gRColumn" Binding="{Binding GR,  UpdateSourceTrigger=PropertyChanged}" Visibility="Hidden" Header="گروه"  />

                    <DataGridComboBoxColumn x:Name="PERIORITY_CMB" Width="100" Header="اولویت"
                        SelectedValueBinding="{Binding PERIORITY,  UpdateSourceTrigger=PropertyChanged}" 
                        DisplayMemberPath="PERIORITY_NAME" 
                        SelectedValuePath="PERIORITY">
                        <DataGridComboBoxColumn.ElementStyle>
                            <Style TargetType="{x:Type ComboBox}">
                                <Setter Property="ItemsSource" Value="{Binding DataContext.PERIORITY_COMBO_DATA, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PERIORITY}" Value="1">
                                        <Setter Property="Background" Value="#FFEF5350"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridComboBoxColumn.ElementStyle>

                        <DataGridComboBoxColumn.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PERIORITY}" Value="1">
                                        <Setter Property="Background" Value="#FFEF5350"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridComboBoxColumn.CellStyle>

                        <DataGridComboBoxColumn.EditingElementStyle>
                            <Style TargetType="{x:Type ComboBox}">
                                <Setter Property="ItemsSource" Value="{Binding DataContext.PERIORITY_COMBO_DATA, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PERIORITY}" Value="1">
                                        <Setter Property="Background" Value="#FFEF5350"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridComboBoxColumn.EditingElementStyle>
                    </DataGridComboBoxColumn>


                    <DataGridComboBoxColumn  x:Name="PERSONEL_CMB"  Width="200"   Header="مجری"
                                        SelectedValueBinding="{Binding PERSONEL,  UpdateSourceTrigger=PropertyChanged}" 
                                        DisplayMemberPath="SAL_NAME" 
                                        SelectedValuePath="USERCO">
                        <DataGridComboBoxColumn.EditingElementStyle>
                            <Style TargetType="{x:Type ComboBox}">
                                <Setter Property="IsEditable" Value="True"/>
                                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                            </Style>

                        </DataGridComboBoxColumn.EditingElementStyle>
                    </DataGridComboBoxColumn>

                    <DataGridTextColumn Binding="{Binding NAME,  UpdateSourceTrigger=PropertyChanged}"  Header="تماس گیرنده"  Width="250" >
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource MaterialDesignTextBox}">
                                <Setter Property="TextWrapping" Value="WrapWithOverflow"/>
                                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Binding="{Binding hes,  UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed" Header="کد تماس گیرنده"  />


                    <DataGridTextColumn Binding="{Binding TASK,  UpdateSourceTrigger=PropertyChanged}" Header="وظیفه" Width="400" >
                        <DataGridTextColumn.EditingElementStyle>
                            <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource MaterialDesignTextBox}">
                                <Setter Property="TextWrapping" Value="WrapWithOverflow"/>
                                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                            </Style>
                        </DataGridTextColumn.EditingElementStyle>
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="{x:Type TextBlock}">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn x:Name="sTATUSColumn" Visibility="Hidden"  Binding="{Binding STATUS,  UpdateSourceTrigger=PropertyChanged}" Header="وضعیت" />

                    <DataGridComboBoxColumn x:Name="STATUS_CMB"  Width="90"  Header=" وضعیت "
                                        SelectedValueBinding="{Binding STATUS,  UpdateSourceTrigger=PropertyChanged}" 
                                        DisplayMemberPath="STATUS_NAME" 
                                        SelectedValuePath="STATUS">
                        <DataGridComboBoxColumn.ElementStyle>
                            <Style TargetType="{x:Type ComboBox}">
                                <Setter Property="ItemsSource" Value="{Binding DataContext.STATUS_COMBO_DATA, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                            </Style>
                        </DataGridComboBoxColumn.ElementStyle>
                        <DataGridComboBoxColumn.EditingElementStyle>
                            <Style TargetType="{x:Type ComboBox}">
                                <Setter Property="ItemsSource" Value="{Binding DataContext.STATUS_COMBO_DATA, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                <Setter Property="IsEditable" Value="True"/>
                                <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                            </Style>
                        </DataGridComboBoxColumn.EditingElementStyle>
                    </DataGridComboBoxColumn>


                    <!--<DataGridTemplateColumn Header="تاریخ ارجاع" MinWidth="70" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding STDATE, Converter={StaticResource SlashyConverter}, UpdateSourceTrigger=PropertyChanged, IsAsync=True}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>-->

                    <DataGridTemplateColumn Header="تاریخ ارجاع" MinWidth="70" Width="Auto">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="Text" Value="{Binding STDATE,  StringFormat=####/##/##, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding STDATE}" Value="{x:Null}">
                                                    <Setter Property="Text" Value=""/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding STDATE}" Value="">
                                                    <Setter Property="Text" Value=""/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding STDATE}" Value="0">
                                                    <Setter Property="Text" Value=""/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>


                    <DataGridTextColumn   Binding="{Binding STTIME,  StringFormat=##:##, UpdateSourceTrigger=PropertyChanged}" Header="زمان ارجاع"  Width="90" />
                    <DataGridTextColumn   Binding="{Binding ENDATE,  StringFormat=####/##/##, UpdateSourceTrigger=PropertyChanged}" Header="تاریخ انجام"   Width="100" />
                    <DataGridTextColumn   Binding="{Binding ENTIME,  StringFormat=##:##, UpdateSourceTrigger=PropertyChanged}" Header="زمان انجام"  Width="90" />
                    <DataGridTextColumn  x:Name="uSERNAMEColumn" Binding="{Binding USERNAME,  UpdateSourceTrigger=PropertyChanged}" Header="کاربر"  Width="90" />
                    
                    <DataGridTextColumn  x:Name="skidColumn" Binding="{Binding skid,  UpdateSourceTrigger=PropertyChanged}" Header="نوع سند"  Width="90" />
                    <DataGridTextColumn  x:Name="sEEColumn" Binding="{Binding SEE,  UpdateSourceTrigger=PropertyChanged}" Header="دیدن"  Width="90" />
                    <DataGridTextColumn  x:Name="uSERCOColumn" Binding="{Binding USERCO,  UpdateSourceTrigger=PropertyChanged}" Header="کد کاربر" />
                    
                    <!--<DataGridTextColumn  x:Name="numColumn" Binding="{Binding num,  UpdateSourceTrigger=PropertyChanged}" Header="num" Visibility="Hidden" />
                    <DataGridTextColumn x:Name="sUMTIMEColumn" Binding="{Binding SUMTIME,  UpdateSourceTrigger=PropertyChanged}" Visibility="Hidden" Header="SUMTIME"  />
                    <DataGridTextColumn x:Name="ssColumn" Binding="{Binding ss,  UpdateSourceTrigger=PropertyChanged}" Visibility="Hidden" Header="ss"  />
                    <DataGridTextColumn x:Name="tgColumn" Binding="{Binding tg,  UpdateSourceTrigger=PropertyChanged}" Visibility="Hidden" Header="tg"  />
                    <DataGridTextColumn  Binding="{Binding CTIM,  UpdateSourceTrigger=PropertyChanged}" Visibility="Hidden" Header="CTIM"  Width="auto" />-->
                </DataGrid.Columns>
            </DataGrid>
            <TextBox x:Name="IDNUM1" HorizontalAlignment="Right" Style="{StaticResource FuzzyOut}" Padding="3" Margin="0,57,45,0" TextWrapping="Wrap" Text="{Binding SelectedItem.IDNUM, ElementName=tASKSDataGrid, Mode=OneWay}" VerticalAlignment="Top" Width="92" FlowDirection="RightToLeft" Height="30" IsReadOnly="True" IsTabStop="False"/>
            <Label Content="شماره:" HorizontalAlignment="Right" Width="43" Margin="0,60,2,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Height="26" PreviewMouseDoubleClick="Label_PreviewMouseDoubleClick"/>

            <ComboBox x:Name="PERSONEL" Margin="0,57,184,0" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" Background="{x:Null}" BorderThickness="1" IsTextSearchEnabled="True" Height="30" VerticalAlignment="Top" FlowDirection="RightToLeft" IsEditable="True" HorizontalAlignment="Right" Width="200"
                   DisplayMemberPath="SAL_NAME"
                   SelectedValuePath="USERCO"
                   TextBoxBase.TextChanged="PERSONEL_TextChanged"
                   PreviewLostKeyboardFocus="PERSONEL_PreviewLostKeyboardFocus">
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
            </ComboBox>
            <Label Content="مجری:" HorizontalAlignment="Right" Width="40" Margin="0,59,143,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Height="26"/>
            <Label Content="تماس گیرنده:" Margin="0,60,387,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Height="26" HorizontalAlignment="Right" Width="76"/>
            <TextBox x:Name="TASK" Style="{StaticResource FuzzyOut}" Padding="3" MaxLength="3999" Margin="290,108,49,0" TextWrapping="Wrap"  VerticalAlignment="Top" FlowDirection="RightToLeft" Height="52" Text="{Binding SelectedItem.TASK, ElementName=tASKSDataGrid, UpdateSourceTrigger=LostFocus}" TabIndex="0"/>
            <Label Content="وظیفه:" Width="45" Margin="0,112,2,0" VerticalAlignment="Top" FlowDirection="RightToLeft" HorizontalAlignment="Right" Height="26"/>
            <Label Content="اولویت:" HorizontalAlignment="Left" Width="48" Margin="240,112,0,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Height="26"/>
            <Label Content="وضعیت:" HorizontalAlignment="Left" Width="53" Margin="103,112,0,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Height="26"/>
            <ComboBox x:Name="PERIORITY" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" Background="{x:Null}" BorderThickness="1" IsTextSearchEnabled="True" HorizontalAlignment="Left" Margin="160,108,0,0" VerticalAlignment="Top" Width="80" IsEditable="True" Height="30" SelectedIndex="1"        DisplayMemberPath="PERIORITY_NAME" 
                  SelectedValue="{Binding SelectedItem.PERIORITY, ElementName=tASKSDataGrid, Mode=OneWay, UpdateSourceTrigger=LostFocus}"
                                        SelectedValuePath="PERIORITY" TabIndex="1" />
            <ComboBox x:Name="STATUS" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" Background="{x:Null}" BorderThickness="1" IsTextSearchEnabled="True" HorizontalAlignment="Left" Margin="11,108,0,0" VerticalAlignment="Top" Width="92" IsEditable="True" Height="30" SelectedIndex="0"   DisplayMemberPath="STATUS_NAME" 
                  SelectedValue="{Binding SelectedItem.STATUS, ElementName=tASKSDataGrid, Mode=OneWay, UpdateSourceTrigger=LostFocus}"
                                        SelectedValuePath="STATUS" TabIndex="2"/>



            <ComboBox x:Name="COMP_COD" Margin="0,57,467,0" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" Background="{x:Null}" BorderThickness="1" IsTextSearchEnabled="True" VerticalAlignment="Top" FlowDirection="RightToLeft" Height="30" IsEditable="True" HorizontalAlignment="Right" Width="574"
                   DisplayMemberPath="NAME"
                   SelectedValuePath="hes"
                   SelectedValue="{Binding SelectedItem.COMP_COD, ElementName=tASKSDataGrid, UpdateSourceTrigger=PropertyChanged}"
                   ItemsSource="{Binding COMP_COD_DATA}"
                  
                   PreviewLostKeyboardFocus="COMP_COD_PreviewLostKeyboardFocus" PreviewKeyDown="COMP_COD_PreviewKeyDown" PreviewTextInput="COMP_COD_PreviewTextInput">
                <ComboBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                    </ItemsPanelTemplate>
                </ComboBox.ItemsPanel>
            </ComboBox>

            <Button x:Name="RefloadBtn" Content="بروزرسانی کارتابل" Click="RefloadBtn_Click" HorizontalAlignment="Right" Margin="0,172,148,0" VerticalAlignment="Top" Height="35" Width="129" Foreground="White" FontSize="11" FontWeight="Bold"/>
            <Button x:Name="SaveBtn" Content="ذخیره" HorizontalAlignment="Right" Margin="0,172,10,0" VerticalAlignment="Top" Height="35" Width="129" Click="SaveBtn_Click" Foreground="White" FontSize="11" TabIndex="3"/>

            <Button x:Name="FRESH_BTN" Click="FRESH_BTN_Click" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,172,287,0" Width="125" Height="35" Padding="15.5,4,16,4" FontSize="11">
                <Button.ContentTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,-1,0,0">
                            <materialDesign:PackIcon Kind="AddBold" Foreground="#DDFFFFFF" VerticalAlignment="Center" Margin="0,0,0,-1"/>
                            <Label Content="سطر جدید" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Padding="4,0,4,2"/>
                        </StackPanel>
                    </DataTemplate>
                </Button.ContentTemplate>
            </Button>

            <Grid Margin="11,171,0,0" HorizontalAlignment="Left" Width="239" Height="37" VerticalAlignment="Top">
                <Label Content="بروز رسانی خودکار:" FlowDirection="RightToLeft" Width="104" Height="auto" Margin="134,3,0,7" HorizontalAlignment="Left"/>
                <ToggleButton x:Name="AutoRefreshToggle" Margin="96,6,0,6" HorizontalAlignment="Left" Width="34" Click="AutoRefreshToggle_Click"/>
                <ComboBox x:Name="RefreshIntervalCombo" DisplayMemberPath="NAME" SelectedValuePath="ID" SelectionChanged="RefreshIntervalCombo_SelectionChanged" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" HorizontalAlignment="Left" Width="89" Height="27"/>
            </Grid>

            <WrapPanel x:Name="gro" Margin="11,9,5,0" Orientation="Horizontal" FlowDirection="RightToLeft" Height="43" VerticalAlignment="Top" Opacity="0.9">
                <CheckBox x:Name="CHBX_HAMEH" Foreground="{DynamicResource HeaderForegroundBrush}" Click="RefloadBtn_Click" Content="همه" Tag="1000" IsChecked="True" Margin="5" VerticalAlignment="Top" HorizontalAlignment="Right" Width="auto" FlowDirection="RightToLeft" FontSize="11" />
                <CheckBox Click="RefloadBtn_Click" Foreground="{StaticResource MaterialDesignBody}" Content="پیش فاکتورها" Tag="20" Margin="5"  VerticalAlignment="Top" HorizontalAlignment="Right" Width="auto" FlowDirection="RightToLeft" FontSize="11" />
                <CheckBox Click="RefloadBtn_Click" Foreground="{DynamicResource MaterialDesignBody}" Content="فاکتورهای خرید" Tag="12" Margin="5" VerticalAlignment="Top" HorizontalAlignment="Right" Width="auto" FlowDirection="RightToLeft" FontSize="11"  />
                <CheckBox Click="RefloadBtn_Click" Foreground="{DynamicResource MaterialDesignBody}" Content="فاکتورهای فروش" Tag="13" Margin="5" VerticalAlignment="Top" HorizontalAlignment="Right" Width="auto" FlowDirection="RightToLeft" FontSize="11" />
                <CheckBox Click="RefloadBtn_Click" Foreground="{DynamicResource MaterialDesignBody}" Content="درخواست پرداخت" Tag="100" Margin="5" VerticalAlignment="Top" HorizontalAlignment="Right" Width="auto" FlowDirection="RightToLeft" FontSize="11" />
                <CheckBox Click="RefloadBtn_Click" Foreground="{DynamicResource MaterialDesignBody}" Content="خزانه داری" Tag="34" Margin="5" VerticalAlignment="Top" HorizontalAlignment="Right" Width="auto" FlowDirection="RightToLeft" FontSize="11" />
                <CheckBox Click="RefloadBtn_Click" Foreground="{DynamicResource MaterialDesignBody}" Content="سند حسابداری" Tag="0" Margin="5" VerticalAlignment="Top" HorizontalAlignment="Right" Width="auto" FlowDirection="RightToLeft" FontSize="11" />
                <CheckBox Click="RefloadBtn_Click" Foreground="{DynamicResource MaterialDesignBody}" Content="رسید خرید" Tag="1" Margin="5" VerticalAlignment="Top" HorizontalAlignment="Right" Width="auto" FlowDirection="RightToLeft" FontSize="11" />
