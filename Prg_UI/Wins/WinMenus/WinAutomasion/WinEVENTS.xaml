<Window x:Class="Prg_UI.Wins.WinMenus.WinAutomasion.WinEVENTS"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.WinAutomasion"
        mc:Ignorable="d"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        FontFamily="{StaticResource IRANYEKAN}"
        Background="{x:Null}" AllowsTransparency="True"
        AllowDrop="True"
        WindowStyle="None"
        Height="600" Width="1280" Loaded="Window_Loaded" WindowStartupLocation="CenterScreen" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown" ContentRendered="Window_ContentRendered">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True"  VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>

        <ContextMenu x:Key="ContextUtilityMenu1" FontSize="12" FlowDirection="LeftToRight" FontFamily="{StaticResource IRANYEKAN}" ContextMenuOpening="ContextMenu_ContextMenuOpening">

            <MenuItem Header="حذف ضمیمه این سطر" x:Name="DeleteCurrentRowIMG" Click="DeleteCurrentRowIMG_Click">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="RemoveBox" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>


    </Window.Resources>
    <Grid>
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="95,56,0,0"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding ElementName=GENERAL_RANG,Path=Background}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1" d:IsHidden="False">
            <Border x:Name="TitleDrawBar"  Style="{StaticResource BordG}" Background="{Binding ElementName=GENERAL_RANG,Path=Background}" Margin="-9,-9,-9,0" VerticalAlignment="Top" UseLayoutRounding="False" Height="38" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label Content="رویداد ها" Padding="21,10,10,10" Foreground="White"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0" BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" IsEnabled="False" Focusable="False" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>


        <DataGrid x:Name="eVENTSDataGrid" ContextMenuOpening="eVENTSDataGrid_ContextMenuOpening"  MouseRightButtonUp="eVENTSDataGrid_MouseRightButtonUp"
                  ColumnHeaderStyle="{StaticResource CenteryHeaderstyle}"   
                  HorizontalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                  VerticalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                  ItemsSource="{Binding EVENTS_DATA}"
                  d:ItemsSource="{d:SampleData ItemCount=2}"
                  ContextMenu="{StaticResource ContextUtilityMenu1}"
                  AutoGenerateColumns="False"
                  
                  SelectionUnit="FullRow"
                  EnableRowVirtualization="True"
                  SelectedIndex="0"
                  CanUserDeleteRows="False"
                  KeyboardNavigation.TabNavigation="Contained"
                  IsKeyboardFocusWithinChanged="eVENTSDataGrid_IsKeyboardFocusWithinChanged"
                  FlowDirection="RightToLeft" Margin="10,50" CellEditEnding="eVENTSDataGrid_CellEditEnding" RowEditEnding="eVENTSDataGrid_RowEditEnding" AddingNewItem="eVENTSDataGrid_AddingNewItem" SelectionChanged="eVENTSDataGrid_SelectionChanged" KeyDown="eVENTSDataGrid_KeyDown">

            <DataGrid.Style>
                <!--خط بندی سطر های دیتاگرید-->
                <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource MaterialDesignDataGrid}"> <Setter Property="materialDesign:DataGridAssist.EnableEditBoxAssist" Value="False"/>
                    <Setter Property="GridLinesVisibility" Value="All"/>
                </Style>
            </DataGrid.Style>


            <DataGrid.Columns>
                <DataGridTextColumn x:Name="iDNUMColumn" Visibility="Hidden" Binding="{Binding IDNUM,UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Header="شماره"   Width="auto" >
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                            <Setter Property = "IsTabStop" Value = "False" />
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="iDDColumn" Binding="{Binding IDD,UpdateSourceTrigger=PropertyChanged}" Header="ردیف" IsReadOnly="True"   MinWidth="60" Width="auto" >
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                            <Setter Property = "IsTabStop" Value = "False" />
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>

                <DataGridTextColumn x:Name="eVENTSColumn" Binding="{Binding EVENTS, UpdateSourceTrigger=LostFocus}" Header="رویداد" Width="*">
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource MaterialDesignTextBox}">
                            <Setter Property="MaxLength" Value="3999"/>
                            <Setter Property="TextWrapping" Value="WrapWithOverflow"/>
                            <Setter Property="AcceptsReturn" Value="True"/>
                            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Setter Property="MaxHeight" Value="100"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn Header="ساعت کار" MinWidth="60" Width="auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding SUMTIME, StringFormat='##:##', UpdateSourceTrigger=PropertyChanged}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SUMTIME}" Value="{x:Null}">
                                                <Setter Property="Text" Value=""/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SUMTIME}" Value="">
                                                <Setter Property="Text" Value=""/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SUMTIME}" Value="0">
                                                <Setter Property="Text" Value=""/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="فایل">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Text" Value="دارد" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding pic}" Value="{x:Null}">
                                                <Setter Property="Text" Value="" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="ضمیمه" Width="auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <materialDesign:PackIcon Kind="AttachFile" IsTabStop="False" Focusable="False" IsHitTestVisible="False" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">

                                        <Setter Property="Foreground" Value="#FF41CC52" />

                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding pic}" Value="{x:Null}">
                                                <Setter Property="Foreground" Value="Black" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>

                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <Button x:Name="ZamimehBtnColum" Click="ZamimehBtnColum_Click" IsTabStop="False" Cursor="Hand" Tag="{Binding}" BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5" FontSize="10" Background="{x:Null}">
                                <Button.Content>
                                    <materialDesign:PackIcon Kind="AttachFile" IsTabStop="False" IsHitTestVisible="False" Focusable="False"/>
                                </Button.Content>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <DataGridTextColumn x:Name="numColumn" Header="شماره" Binding="{Binding num,UpdateSourceTrigger=LostFocus}" Width="auto">
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource MaterialDesignTextBox}">
                            <Setter Property="MaxLength" Value="50" />
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="{x:Type TextBlock}">
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                
                <DataGridComboBoxColumn x:Name="skidColumn" Width="auto" Header="نوع سند" 
                                        SelectedValueBinding="{Binding skid,UpdateSourceTrigger=LostFocus}" DisplayMemberPath="NAME" SelectedValuePath="ID">
                    <DataGridComboBoxColumn.EditingElementStyle>
                        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource MaterialDesignComboBox}">
                            <Setter Property="IsEditable" Value="True"/>
                            <Setter Property="ItemsPanel" Value="{StaticResource VSP}"/>
                            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                        </Style>
                    </DataGridComboBoxColumn.EditingElementStyle>
                    <DataGridComboBoxColumn.ElementStyle>
                        <Style TargetType="{x:Type ComboBox}">
                        </Style>
                    </DataGridComboBoxColumn.ElementStyle>
                </DataGridComboBoxColumn>

                <DataGridTemplateColumn IsReadOnly="True" CanUserResize="False" Header="باز کردن برگه">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="BTN_OPN" IsTabStop="False" Click="BTN_OPN_Click" Tag="{Binding}"
                                    materialDesign:ButtonAssist.CornerRadius="2"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" VerticalContentAlignment="Center"
                                    Margin="-14,-7,-14,-7" HorizontalContentAlignment="Center">
                                <materialDesign:PackIcon Kind="OpenInNew"/>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellStyle>
                        <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                            <Setter Property = "IsTabStop" Value = "False" />
                        </Style>
                    </DataGridTemplateColumn.CellStyle>
                </DataGridTemplateColumn>

                <DataGridTextColumn x:Name="uSERNAMEColumn" Binding="{Binding USERNAME,UpdateSourceTrigger=LostFocus}" IsReadOnly="True" Header="کاربر" Width="auto">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                            <Setter Property = "IsTabStop" Value = "False" />
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="sTDATEColumn" Binding="{Binding STDATE,StringFormat=####/##/##,UpdateSourceTrigger=LostFocus}" IsReadOnly="True" Header="تاریخ ارجاع" Width="auto" >
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                            <Setter Property = "IsTabStop" Value = "False" />
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="sTTIMEColumn" Binding="{Binding STTIME,UpdateSourceTrigger=LostFocus}" IsReadOnly="True" Header="زمان ارجاع" Width="auto" >
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                            <Setter Property = "IsTabStop" Value = "False" />
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="cOMPANYColumn" Visibility="Hidden" Binding="{Binding COMPANY,UpdateSourceTrigger=LostFocus}" IsReadOnly="True" Header="COMPANY" Width="auto" >
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                            <Setter Property = "IsTabStop" Value = "False" />
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>



            </DataGrid.Columns>
        </DataGrid>
        <Button x:Name="Command8"  Margin="10,0,10,10" Style="{StaticResource MaterialDesignFlatButton}"  BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5" FontSize="10" Background="{x:Null}" FlowDirection="LeftToRight" Foreground="{Binding Background, ElementName=GENERAL_RANG}" Height="35" VerticalAlignment="Bottom" Click="Command8_Click">
            <Button.Content>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="بستن"  FontSize="12"/>
                </StackPanel>
            </Button.Content>
        </Button>

    </Grid>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
</Window>
