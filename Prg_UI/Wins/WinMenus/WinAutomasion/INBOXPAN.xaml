<Window x:Class="Wins.WinMenus.WinAutomasion.INBOXPAN"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wins.WinMenus.WinAutomasion"
        mc:Ignorable="d"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="{StaticResource IRANYEKAN}"
        WindowStartupLocation="CenterScreen"
        Title="" Height="465" Width="575" MinHeight="465" MinWidth="575" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="mygrid">
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="557,410,17,23"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label Content="پیام" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                                                       Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <Label Content="شماره:" HorizontalAlignment="Right" Margin="0,53,36,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <TextBox x:Name="USERNAME" Text="" Height="30" Margin="32,52,213,0"  Style="{StaticResource FuzzyOut}" Padding="3"  TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible" MaxLength="48" IsReadOnly="True" />
        <Label Content="فرستنده:" HorizontalAlignment="Right" Margin="0,53,158,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <Label Content="تماس گیرنده:" HorizontalAlignment="Right" Margin="0,93,36,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <Label Content="متن" HorizontalAlignment="Right" Margin="0,122,36,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <Label Content="وضعیت:" HorizontalAlignment="Right" Margin="0,0,36,102" VerticalAlignment="Bottom" FlowDirection="RightToLeft" Width="auto"/>
        <Label Content="تاریخ ارجاع:" HorizontalAlignment="Left" Margin="270,0,0,102" VerticalAlignment="Bottom" FlowDirection="RightToLeft" Width="auto"/>
        <Label Content="زمان ارجاع:" HorizontalAlignment="Left" Margin="114,0,0,102" VerticalAlignment="Bottom" FlowDirection="RightToLeft" Width="auto"/>
        <UniformGrid Margin="0,406,0,0" Columns="3" Rows="1" FlowDirection="RightToLeft">
            <Button x:Name="BTN_FORWARD" Content="ارجاع به دیگری (Forward)" FlowDirection="RightToLeft" BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF"  Height="34"  Width="163" Click="BTN_FORWARD_Click"/>
            <Button x:Name="BTN_REPONSE" Content="پاسخ" FlowDirection="RightToLeft" BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Height="34" Width="150" Click="BTN_REPONSE_Click" />
            <Button x:Name="BTN_GOTIT" Content="متوجه شدم" FlowDirection="RightToLeft" BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Height="34" Width="146" Click="BTN_GOTIT_Click" />
        </UniformGrid>
        <TextBox x:Name="IDNUM" Text="" Height="30" Margin="0,52,76,0"  Style="{StaticResource FuzzyOut}" Padding="3"  TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible" MaxLength="48" HorizontalAlignment="Right" Width="82" IsReadOnly="True" />
        <TextBox x:Name="COMP_COD_TXT" Text="" Height="30" Margin="32,93,113,0"  Style="{StaticResource FuzzyOut}" Padding="3"  TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible" MaxLength="48" IsReadOnly="True" />
        <ComboBox x:Name="COMP_COD" Margin="32,92,0,0" Padding="7,0,10,0" Visibility="Collapsed" Style="{StaticResource FuzzyOutComboBox}" Background="{x:Null}" BorderThickness="1" IsTextSearchEnabled="True" VerticalAlignment="Top" FlowDirection="RightToLeft" Height="30" HorizontalAlignment="Left" Width="430"
            DisplayMemberPath="NAME" SelectedValuePath="hes">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <TextBox x:Name="PAYAM" Text="" Margin="32,153,39,138" Style="{StaticResource FuzzyOut}" Padding="3" TextWrapping="Wrap" TextAlignment="Right"  Visibility="Visible" MaxLength="2047" IsReadOnly="True" />
        <ComboBox x:Name="STATUS" IsHitTestVisible="False" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" Background="{x:Null}" BorderThickness="1" IsTextSearchEnabled="True" Margin="348,0,87,101" VerticalAlignment="Bottom" IsEditable="True" Height="30" SelectedIndex="0"   DisplayMemberPath="STATUS_NAME" 
            SelectedValue="{Binding SelectedItem.STATUS, ElementName=tASKSDataGrid, Mode=OneWay, UpdateSourceTrigger=LostFocus}"
            SelectedValuePath="STATUS" TabIndex="2" Focusable="False"/>
        <TextBox x:Name="STDATE" Text="" Height="30" Margin="178,0,0,101"  Style="{StaticResource FuzzyOut}" Padding="3"  TextWrapping="Wrap" VerticalAlignment="Bottom" TextAlignment="Right"  Visibility="Visible" MaxLength="48" HorizontalAlignment="Left" Width="92" Focusable="False" IsHitTestVisible="False" />
        <TextBox x:Name="STTIME" Text="" Height="30" Margin="32,0,0,101"  Style="{StaticResource FuzzyOut}" Padding="3"  TextWrapping="Wrap" VerticalAlignment="Bottom" TextAlignment="Right"  Visibility="Visible" MaxLength="48" HorizontalAlignment="Left" Width="82" Focusable="False" IsHitTestVisible="False" />
        <ComboBox x:Name="PERSONEL" Focusable="False" IsHitTestVisible="False" Margin="31,0,87,64" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" Background="{x:Null}" BorderThickness="1" IsTextSearchEnabled="True" Height="30" VerticalAlignment="Bottom" FlowDirection="RightToLeft" IsEditable="True"
            DisplayMemberPath="SAL_NAME"
            SelectedValuePath="USERCO">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <Label Content="مجری:" HorizontalAlignment="Right" Width="40" Margin="0,0,35,68" VerticalAlignment="Bottom" FlowDirection="RightToLeft" Height="26"/>


    </Grid>
</Window>

