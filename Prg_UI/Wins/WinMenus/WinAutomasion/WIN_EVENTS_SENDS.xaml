<Window x:Class="Wins.WinMenus.WinAutomasion.WIN_EVENTS_SENDS"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wins.WinMenus.WinAutomasion"
        mc:Ignorable="d"
        
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        FontFamily="IRANYekanFN"
        Background="{x:Null}" AllowsTransparency="True"
        AllowDrop="True"
        WindowStyle="None"
        WindowState="Maximized"
        Height="450" Width="930" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True"  VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>
    </Window.Resources>
    <Grid>
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="95,56,0,0"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding ElementName=GENERAL_RANG,Path=Background}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1" d:IsHidden="False">
            <Border x:Name="TitleDrawBar"  Style="{StaticResource BordG}" Background="{Binding ElementName=GENERAL_RANG,Path=Background}" Margin="-9,-9,-9,0" VerticalAlignment="Top" UseLayoutRounding="False" Height="38" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label Content="ارسال شده ها (Sents)" Padding="21,10,10,10" Foreground="White"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0" BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" IsEnabled="True" Focusable="False" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>

        <DataGrid x:Name="DG_SENT_TASKS"
              CanUserDeleteRows="False"
              Style="{StaticResource DATAGRIDSTYLISH}"
              ColumnHeaderStyle="{StaticResource CenteryHeaderstyle}"   
              HorizontalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
              VerticalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
              ItemsSource="{Binding TASK_DATA}"
              d:ItemsSource="{d:SampleData ItemCount=2}"
              SelectedIndex="0"
                  
              IsReadOnly="True"
              EnableRowVirtualization="True"
              EnableColumnVirtualization="True"
              VirtualizingPanel.IsVirtualizing="True"
              VirtualizingPanel.VirtualizationMode="Recycling"
              VirtualizingPanel.ScrollUnit="Pixel"
              ScrollViewer.CanContentScroll="True"
                  
              FlowDirection="RightToLeft" AutoGenerateColumns="False" Margin="10,50,10,55">
            <DataGrid.Columns>

                <DataGridTextColumn x:Name="IDNUM" Binding="{Binding IDNUM, UpdateSourceTrigger=LostFocus,IsAsync=True}"   Header="شماره" IsReadOnly="True" Width="auto" />
                <DataGridTextColumn x:Name="iDDColumn" Binding="{Binding IDD}" Header="ردیف" IsReadOnly="True" Width="auto"/>

                <DataGridComboBoxColumn  x:Name="PERSONEL_CMB"  Width="auto"   Header=" مجری "
                    SelectedValueBinding="{Binding PERSONEL, UpdateSourceTrigger=LostFocus,IsAsync=True}" 
                    DisplayMemberPath="SAL_NAME" 
                    SelectedValuePath="USERCO">
                    <DataGridComboBoxColumn.EditingElementStyle>
                        <Style TargetType="{x:Type ComboBox}">
                            <Setter Property="IsEditable" Value="True"/>
                            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
                            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
                        </Style>
                    </DataGridComboBoxColumn.EditingElementStyle>
                </DataGridComboBoxColumn>

                <!--<DataGridComboBoxColumn  x:Name="COMP_COD_CMB"  Width="auto"   Header="تماس گیرنده"
                    SelectedValueBinding="{Binding COMP_COD, UpdateSourceTrigger=LostFocus,IsAsync=True}" 
                    DisplayMemberPath="NAME" 
                    SelectedValuePath="hes">
                    <DataGridComboBoxColumn.EditingElementStyle>
                        <Style TargetType="{x:Type ComboBox}">
                            <Setter Property="IsEditable" Value="True"/>
                            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
                            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
                        </Style>
                    </DataGridComboBoxColumn.EditingElementStyle>
                </DataGridComboBoxColumn>-->

                <DataGridTextColumn Binding="{Binding NAME, UpdateSourceTrigger=LostFocus,IsAsync=True}"  Header="تماس گیرنده" Width="auto" />
                <DataGridTextColumn Binding="{Binding hes, UpdateSourceTrigger=LostFocus,IsAsync=True}" Visibility="Collapsed" Header="کد تماس گیرنده"  Width="auto" />

                <DataGridTextColumn Binding="{Binding TASK, UpdateSourceTrigger=LostFocus,IsAsync=True}" Header="وظیفه" Width="400"  />
                <DataGridTextColumn Binding="{Binding EVENTS, UpdateSourceTrigger=LostFocus,IsAsync=True}" Header="رویداد" Width="400" />
                <DataGridTextColumn   Binding="{Binding SUMTIME, StringFormat=##:##, UpdateSourceTrigger=LostFocus,IsAsync=True}" Header="ساعت کار" Width="auto" />
                <DataGridTextColumn   Binding="{Binding USERNAME, UpdateSourceTrigger=LostFocus,IsAsync=True}" Header="کاربر" Width="auto" />

                <DataGridTextColumn Binding="{Binding num, UpdateSourceTrigger=LostFocus,IsAsync=True}" Header="شماره برگه" Width="auto" />



                <DataGridComboBoxColumn x:Name="skidColumn" Width="auto" Header="نوع سند" 
                        SelectedValueBinding="{Binding skid,UpdateSourceTrigger=LostFocus}" DisplayMemberPath="NAME" SelectedValuePath="ID">
                    <DataGridComboBoxColumn.EditingElementStyle>
                        <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource MaterialDesignComboBox}">
                            <Setter Property="IsEditable" Value="True"/>
                            <Setter Property="ItemsPanel" Value="{StaticResource VSP}"/>
                            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                        </Style>
                    </DataGridComboBoxColumn.EditingElementStyle>
                    <DataGridComboBoxColumn.ElementStyle>
                        <Style TargetType="{x:Type ComboBox}">
                        </Style>
                    </DataGridComboBoxColumn.ElementStyle>
                </DataGridComboBoxColumn>

                <DataGridTextColumn   Binding="{Binding ENDATE, StringFormat=####/##/##, UpdateSourceTrigger=LostFocus,IsAsync=True}" Header="تاریخ انجام"  Width="auto" />
                <DataGridTextColumn   Binding="{Binding ENTIME, StringFormat=##:##, UpdateSourceTrigger=LostFocus,IsAsync=True}" Header="زمان انجام"  Width="auto" />

                <DataGridTextColumn x:Name="tgColumn" Binding="{Binding tg}" Header="نوع برگه" Width="auto"/>
                <DataGridComboBoxColumn x:Name="PERIORITY_CMB" Width="auto"  Header=" اولویت "
                                        SelectedValueBinding="{Binding PERIORITY, UpdateSourceTrigger=LostFocus,IsAsync=True}" 
                                        DisplayMemberPath="PERIORITY_NAME" 
                                        SelectedValuePath="PERIORITY">
                    <DataGridComboBoxColumn.ElementStyle>
                        <Style TargetType="{x:Type ComboBox}">
                            <Setter Property="ItemsSource" Value="{Binding Path=DataContext.PERIORITY_COMBO_DATA, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PERIORITY}" Value="1">
                                    <Setter Property="Background" >
                                        <Setter.Value>
                                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                                <GradientStop Color="#CC750303"/>
                                                <GradientStop Color="#CCFF0000"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridComboBoxColumn.ElementStyle>
                    <DataGridComboBoxColumn.EditingElementStyle>
                        <Style TargetType="{x:Type ComboBox}">
                            <Setter Property="ItemsSource" Value="{Binding Path=DataContext.PERIORITY_COMBO_DATA, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
                            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
                        </Style>
                    </DataGridComboBoxColumn.EditingElementStyle>
                </DataGridComboBoxColumn>
                <DataGridComboBoxColumn x:Name="STATUS_CMB" Width="auto"  Header=" وضعیت "
                                        SelectedValueBinding="{Binding STATUS, UpdateSourceTrigger=LostFocus,IsAsync=True}" 
                                        DisplayMemberPath="STATUS_NAME" 
                                        SelectedValuePath="STATUS">
                    <DataGridComboBoxColumn.ElementStyle>
                        <Style TargetType="{x:Type ComboBox}">
                            <Setter Property="ItemsSource" Value="{Binding Path=DataContext.STATUS_COMBO_DATA, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Style>
                    </DataGridComboBoxColumn.ElementStyle>
                    <DataGridComboBoxColumn.EditingElementStyle>
                        <Style TargetType="{x:Type ComboBox}">
                            <Setter Property="ItemsSource" Value="{Binding Path=DataContext.STATUS_COMBO_DATA, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter Property="IsEditable" Value="True"/>
                            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
                            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
                        </Style>
                    </DataGridComboBoxColumn.EditingElementStyle>
                </DataGridComboBoxColumn>

                <DataGridTemplateColumn Header="تاریخ ارجاع" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding STDATE, StringFormat=####/##/##, UpdateSourceTrigger=LostFocus, IsAsync=True}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding STDATE}" Value="{x:Null}">
                                                <Setter Property="Text" Value=""/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding STDATE}" Value="">
                                                <Setter Property="Text" Value=""/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding STDATE}" Value="0">
                                                <Setter Property="Text" Value=""/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn   Binding="{Binding STTIME, StringFormat=##:##, UpdateSourceTrigger=LostFocus,IsAsync=True}" Header="زمان ارجاع" Width="auto" />

                <DataGridTemplateColumn Header="تاریخ انجام" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding ENDATE, StringFormat=####/##/##, UpdateSourceTrigger=LostFocus, IsAsync=True}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ENDATE}" Value="{x:Null}">
                                                <Setter Property="Text" Value=""/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ENDATE}" Value="">
                                                <Setter Property="Text" Value=""/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ENDATE}" Value="0">
                                                <Setter Property="Text" Value=""/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn   Binding="{Binding ENTIME, StringFormat=##:##, UpdateSourceTrigger=LostFocus,IsAsync=True}" Header="زمان انجام" Width="auto" />


                <DataGridTextColumn x:Name="sEEColumn" Header="دیدن" Width="auto" Binding="{Binding SEE}">
                    <DataGridTextColumn.CellStyle>
                        <Style TargetType="DataGridCell" BasedOn="{StaticResource MaterialDesignDataGridCell}">
                            <Setter Property="IsTabStop" Value="False" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SEE}" Value="1">
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    <Setter Property="VerticalContentAlignment" Value="Center" />
                                    <Setter Property="TextBlock.TextAlignment" Value="Center" />
                                    <Setter Property="Background" Value="#F25AFF44" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.CellStyle>
                </DataGridTextColumn>

                <DataGridTemplateColumn x:Name="sEETColumn" Header="زمان مشاهده" Width="auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <DatePicker SelectedDate="{Binding SEET, Mode=TwoWay, NotifyOnValidationError=true, ValidatesOnExceptions=true}"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

            </DataGrid.Columns>
        </DataGrid>

        <CNC:DataGridNavigationControl x:Name="GR_NAV_DATAGRID" NewButtonEnabled="False" Height="55" TargetDataGrid="{Binding ElementName=DG_SENT_TASKS}" VerticalAlignment="Bottom"/>
    </Grid>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
</Window>
