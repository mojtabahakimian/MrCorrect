<Window x:Class="Wins.WinMenus.WinAutomasion.WIN_MESSAGE_DTL"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wins.WinMenus.WinAutomasion"
        mc:Ignorable="d"
        
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:sfusion="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        FontFamily="{StaticResource IRANYEKAN}"
        Background="{x:Null}" AllowsTransparency="True"
        AllowDrop="True"
        WindowStyle="None"
        WindowState="Maximized"
        Height="450" Width="1280" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>

        <!-- Style for SfDataGrid -->
        <Style x:Key="KDG"  TargetType="syncfusion:SfDataGrid" BasedOn="{StaticResource SfDataGridStyle}">
            <Setter Property="CurrentCellBorderBrush" Value="{StaticResource GENERAL_Grlicom}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="BorderBrush" Value="{StaticResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="HeaderRowHeight" Value="40" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="GridLinesVisibility" Value="Both" />
        </Style>
        <!-- Modified Column Header Style -->
        <Style x:Key="KDGHeader" TargetType="syncfusion:GridHeaderCellControl" BasedOn="{StaticResource GridHeaderCellControlStyle}">
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="BorderBrush" Value="{Binding Background, ElementName=GENERAL_RANG}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="Auto"/>
        </Style>

        <Style TargetType="sfusion:GridCell" BasedOn="{StaticResource GridCellStyle}">
            <Setter Property="BorderBrush" Value="{Binding BorderBrush, ElementName=GENERAL_RANG}" />
        </Style>


        <ContextMenu x:Key="DataGridContextMenu" FontFamily="{StaticResource IRANYEKAN}">
            <MenuItem Header="پالودن با این بخش" Click="FilterBySelection_Click">
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="Filter"  FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <!--Filter Excluding Selection-->
            <MenuItem Header="پالودن بدون این بخش" Click="FilterExcludingSelection_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FilterRemove" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="کـپـی" Click="MenuItem_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="ContentCopy" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="حذف پالودن (فیلتر)" Click="RemoveFilterSort_Click" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FilterRemoveOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="خروجی اکسل" Click="EXPORTEXCEL_BTN" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FileExcelOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>
    </Window.Resources>
    <Grid>
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="95,56,0,0"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding ElementName=GENERAL_RANG,Path=Background}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1" d:IsHidden="False">
            <Border x:Name="TitleDrawBar"  Style="{StaticResource BordG}" Background="{Binding ElementName=GENERAL_RANG,Path=Background}" Margin="-9,-9,-9,0" VerticalAlignment="Top" UseLayoutRounding="False" Height="38" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label Content="مشاهده پیام ها" Padding="21,10,10,10" Foreground="White"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0" BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" IsEnabled="True" Focusable="False" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                                                 Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>

        <syncfusion:SfDataGrid x:Name="SYNCFUSION_DG" FilterRowPosition="Top"
            ContextMenu="{StaticResource DataGridContextMenu}"
            ItemsSource="{Binding MESSAGE_DATA}"  SelectedIndex="0"
            AutoGenerateColumns="False"
            EnableDataVirtualization="True"
            SelectionUnit="Row"
            AllowEditing="True"
            IsReadOnly="True"
            AllowDraggingColumns="True"
            AllowResizingColumns="True"
            AllowSorting="True"
            SelectionMode="Extended"
            AllowFiltering="True"
            RowHeight="40"
            FrozenColumnCount="0"
            FlowDirection="RightToLeft"
            d:ItemsSource="{d:SampleData ItemCount=5}"
            Style="{StaticResource KDG}"
            HeaderStyle="{StaticResource KDGHeader}"
                          
            CurrentCellActivated="SYNCFUSION_DG_CurrentCellActivated"
            QueryRowHeight="SYNCFUSION_DG_QueryRowHeight"
            PreviewMouseRightButtonDown="SYNCFUSION_DG_PreviewMouseRightButtonDown"
            Margin="10,49,10,10" AllowRowHoverHighlighting="True" AllowSelectionOnPointerPressed="True" ScrollMode="Async" ShowRowHeader="True" ShowGroupDropArea="True" SelectionChanged="SYNCFUSION_DG_SelectionChanged" PreviewKeyDown="SYNCFUSION_DG_PreviewKeyDown">

            <syncfusion:SfDataGrid.Columns>
                
                <!-- IDNUM Column -->
                <syncfusion:GridTextColumn MappingName="IDNUM" HeaderText="شماره" Width="80" />

                <!-- تاریخ ارجاع Column -->
                <syncfusion:GridTextColumn HeaderText="تاریخ ارجاع" MappingName="STDATE">
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="STDATE" StringFormat="####/##/##" />
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>

                <!-- زمان ارجاع Column -->
                <syncfusion:GridTextColumn MappingName="STTIME"
                                   HeaderText="زمان ارجاع"
                                   Width="100">
                    <syncfusion:GridTextColumn.DisplayBinding>
                        <Binding Path="STTIME" StringFormat="{}{0:##:##}" />
                    </syncfusion:GridTextColumn.DisplayBinding>
                </syncfusion:GridTextColumn>

                <!-- گیرنده Column (ComboBox) -->
                <syncfusion:GridComboBoxColumn x:Name="PERSONEL_CMB"
                                               MappingName="PERSONEL"
                                               HeaderText="گیرنده"
                                               DisplayMemberPath="SAL_NAME" 
                                               SelectedValuePath="USERCO"
                                               Width="120" />

                <!-- فرستنده Column -->
                <syncfusion:GridTextColumn MappingName="USERNAME" HeaderText="فرستنده" Width="120" ColumnSizer="None" />
                <syncfusion:GridTextColumn MappingName="PAYAM" HeaderText="پیام" Width="300" ColumnSizer="Auto" TextWrapping="Wrap" TextAlignment="Justify" />
                
                <!--<syncfusion:GridTemplateColumn HeaderText="پیام" MappingName="PAYAM" MinimumWidth="500">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding PAYAM}" />
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                    <syncfusion:GridTemplateColumn.EditTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding PAYAM, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="50"  TextWrapping="Wrap"  />
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.EditTemplate>
                </syncfusion:GridTemplateColumn>-->


                <!-- پاسخ Button -->
                <syncfusion:GridTemplateColumn HeaderText="پاسخ" MappingName="IsButtony" AllowSorting="False" AllowFiltering="False" AllowEditing="False" AllowGrouping="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Tag="{Binding}" Click="Button_Click_1"
                                    Style="{StaticResource MaterialDesignFlatButton}">
                                <materialDesign:PackIcon Kind="QuestionAnswer" />
                            </Button>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>

                <!-- ارجاع به دیگری Button -->
                <syncfusion:GridTemplateColumn HeaderText="ارجاع به دیگری" MappingName="IsButtony" AllowSorting="False" AllowFiltering="False" AllowEditing="False" AllowGrouping="False">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Tag="{Binding}" Click="Button_Click_2"
                                    Style="{StaticResource MaterialDesignFlatButton}">
                                <materialDesign:PackIcon Kind="Forward" />
                            </Button>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                </syncfusion:GridTemplateColumn>

                <!-- تماس گیرنده Column -->
                <syncfusion:GridTextColumn MappingName="NAME"
                                   HeaderText="تماس گیرنده"
                                   Width="120" />

                <!-- وضعیت ComboBox Column -->
                <syncfusion:GridComboBoxColumn x:Name="STATUS_CMB"
                                               MappingName="STATUS"
                                               ItemsSource="{Binding STATUS_COMBO_DATA}"
                                               HeaderText="وضعیت"
                                               DisplayMemberPath="STATUS_NAME" 
                                               SelectedValuePath="STATUS"
                                               Width="120" />

                <syncfusion:GridDateTimeColumn HeaderText="زمان ایجاد" Width="120" MappingName="CRT" Pattern="CustomPattern" CustomPattern="yyyy/MM/dd" >
                    
                </syncfusion:GridDateTimeColumn>
               

            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>


    </Grid>
</Window>
