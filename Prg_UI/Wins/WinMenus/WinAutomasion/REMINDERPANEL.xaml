<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wins.WinMenus.WinAutomasion"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit" x:Class="Wins.WinMenus.WinAutomasion.REMINDERPANEL"
        mc:Ignorable="d"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="{StaticResource IRANYEKAN}"
        WindowStartupLocation="CenterScreen"
        Title="" Height="520" Width="790" MinHeight="465" MinWidth="575" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown" Closed="Window_Closed">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="mygrid">
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="557,410,17,23"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label Content="یادآوری" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                                                       Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>

        <Label Content="شماره:" HorizontalAlignment="Right" Margin="0,53,35,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <Label Content="در خصوص (تماس گیرنده):" HorizontalAlignment="Right" Margin="0,94,36,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <Label Content="متن" HorizontalAlignment="Right" Margin="0,126,36,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <Label Content="وضعیت:" HorizontalAlignment="Right" Margin="0,0,36,119" VerticalAlignment="Bottom" FlowDirection="RightToLeft" Width="auto"/>
        <UniformGrid Columns="1" Rows="1" FlowDirection="RightToLeft" Height="65" VerticalAlignment="Bottom">
            <Button x:Name="BTN_SAVEREMIND" Click="BTN_SAVEREMIND_Click" Content="ذخیره" BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Height="34" Width="170"/>
        </UniformGrid>

        <TextBox x:Name="IDNUM" Text="" Height="30" Margin="0,52,75,0"  Style="{StaticResource FuzzyOut}" Padding="3"  TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible" MaxLength="48" HorizontalAlignment="Right" Width="82" IsReadOnly="True" Focusable="False" IsHitTestVisible="False" />
        <ComboBox x:Name="COMP_COD" Margin="32,94,178,0" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" Background="{x:Null}" BorderThickness="1" IsTextSearchEnabled="True" VerticalAlignment="Top" FlowDirection="RightToLeft" Height="30" IsEditable="True"
                  DisplayMemberPath="NAME"
                  SelectedValuePath="hes"
                  ItemsSource="{Binding COMP_COD_DATA}" PreviewLostKeyboardFocus="COMP_COD_PreviewLostKeyboardFocus" PreviewKeyDown="COMP_COD_PreviewKeyDown" PreviewTextInput="COMP_COD_PreviewTextInput">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <TextBox x:Name="PAYAM" Text="" Margin="32,156,39,160" Style="{StaticResource FuzzyOut}" Padding="3" TextWrapping="Wrap"  FlowDirection="RightToLeft" Visibility="Visible" MaxLength="2047" />
        <ComboBox x:Name="STATUS" IsHitTestVisible="False" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" Background="{x:Null}" BorderThickness="1" IsTextSearchEnabled="True" Margin="570,0,87,118" VerticalAlignment="Bottom" IsEditable="True" Height="30" SelectedIndex="0" DisplayMemberPath="STATUS_NAME" 
            SelectedValuePath="STATUS" TabIndex="2"/>
        <ComboBox x:Name="PERSONEL" Margin="191,52,240,0" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" Background="{x:Null}" BorderThickness="1" IsTextSearchEnabled="True" Height="30" VerticalAlignment="Top" FlowDirection="RightToLeft" IsEditable="True"
            DisplayMemberPath="SAL_NAME"
            SelectedValuePath="USERCO">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <Label Content="برای (گیرنده):" HorizontalAlignment="Right" Width="auto" Margin="0,53,162,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Height="26"/>
        <Label Content="کاربر:" HorizontalAlignment="Right" Margin="0,0,52,81" VerticalAlignment="Bottom" FlowDirection="RightToLeft" Width="auto"/>
        <TextBox x:Name="USERNAME" Text="" Height="30" Margin="32,0,87,80"  Style="{StaticResource FuzzyOut}" Padding="3"  TextWrapping="Wrap" VerticalAlignment="Bottom" TextAlignment="Right"  Visibility="Visible" MaxLength="48" IsReadOnly="True" Focusable="False" IsHitTestVisible="False" />

        <Button x:Name="BTN_GIRANDEGAN_MORE" Content="گیرندگان بیشتر" FlowDirection="RightToLeft" BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Height="34" Margin="32,50,0,0" VerticalAlignment="Top" HorizontalAlignment="Left" Width="150" Click="BTN_GIRANDEGAN_MORE_Click" />
        <Grid Margin="32,50,210,65" x:Name="GRID_MOREUSER" Background="White" Visibility="Collapsed" d:Visibility="Hidden">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0" x:Name="BTN_SELECTALL" Content="انتخاب همه" Style="{StaticResource MaterialDesignFlatButton}" FontSize="12" Height="34" VerticalAlignment="Top" Click="BTN_SELECTALL_Click"/>

            <TextBox Grid.Row="1" FlowDirection="RightToLeft" x:Name="SearchBox" Height="auto"
                     Margin="0,5,0,5" TextChanged="SearchBox_TextChanged" materialDesign:HintAssist.Hint="جستجو..." 
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

            <Border Grid.Row="2" BorderThickness="1,1,1,1" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}" CornerRadius="5" Margin="0,5,0,5">
                <ListBox x:Name="CheckListBox" Cursor="Hand" FlowDirection="RightToLeft" ItemsSource="{Binding Users, UpdateSourceTrigger=PropertyChanged}" SelectionMode="Multiple" d:ItemsSource="{d:SampleData ItemCount=5}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="ItemCheckBox" 
                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                      VerticalAlignment="Center"
                                      Margin="5,0,5,0"/>
                                <TextBlock Text="{Binding SAL_NAME}" 
                                       Grid.Column="1" 
                                       VerticalAlignment="Center"/>
                            </Grid>

                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Border>

            <Button Grid.Row="3" x:Name="BTN_APPLY" Content="اعمال" Style="{StaticResource MaterialDesignFlatButton}" Margin="2" FontSize="12"  Height="34" VerticalAlignment="Bottom" Click="BTN_APPLY_Click"/>
        </Grid>

        <xctk:MaskedTextBox x:Name="STDATE" Style="{StaticResource FuzzyOut}" Padding="3"  Mask="0000/00/00" Height="30" Margin="399,0,0,118" TextWrapping="Wrap" VerticalAlignment="Bottom"  BorderThickness="1" FontSize="12"  HorizontalAlignment="Left" Width="82" PreviewLostKeyboardFocus="STDATE_PreviewLostKeyboardFocus"/>
        <xctk:MaskedTextBox x:Name="STTIME" Style="{StaticResource FuzzyOut}" Padding="3" Mask="00:00:00" Height="30" Margin="207,0,0,118" TextWrapping="Wrap" VerticalAlignment="Bottom"  BorderThickness="1" FontSize="12"  HorizontalAlignment="Left" Width="54" PreviewLostKeyboardFocus="STTIME_PreviewLostKeyboardFocus"/>
        <Label Content="تاریخ یادآوری:" HorizontalAlignment="Left" Margin="486,0,0,119" VerticalAlignment="Bottom" FlowDirection="RightToLeft" Width="auto"/>
        <Label Content="زمان یادآوری (24:00:00) :" HorizontalAlignment="Left" Margin="261,0,0,119" VerticalAlignment="Bottom" FlowDirection="RightToLeft" Width="auto"/>
        <CheckBox x:Name="SMSOK" Content="برای یادآوری پيامک هم ارسال شود" HorizontalAlignment="Left" Margin="32,0,0,124" VerticalAlignment="Bottom" Width="auto" FontSize="10"/>

    </Grid>
</Window>