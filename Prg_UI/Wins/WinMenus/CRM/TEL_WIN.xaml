<Window x:Class="Prg_UI.Wins.WinMenus.CRM.TEL_WIN"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.CRM"
        mc:Ignorable="d"
        MaxHeight="{Binding Height, Source={x:Static SystemParameters.WorkArea}}"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:sfusion="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:grid="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"

        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="{StaticResource IRANYEKAN}"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Title="دفترچه تلفن" Height="600" Width="1024" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>

        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>

        <Style x:Key="KDG" TargetType="syncfusion:SfDataGrid" BasedOn="{StaticResource SfDataGridStyle}">
            <Setter Property="CurrentCellBorderBrush" Value="{StaticResource GENERAL_Grlicom}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="BorderBrush" Value="{StaticResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="HeaderRowHeight" Value="40" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="GridLinesVisibility" Value="Both" />
        </Style>

        <Style x:Key="KDGHeader" TargetType="syncfusion:GridHeaderCellControl" BasedOn="{StaticResource GridHeaderCellControlStyle}">
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="BorderBrush" Value="{Binding Background, ElementName=GENERAL_RANG}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="Auto"/>
        </Style>

        <Style TargetType="sfusion:GridCell" BasedOn="{StaticResource GridCellStyle}">
            <Setter Property="BorderBrush" Value="{Binding BorderBrush, ElementName=GENERAL_RANG}" />
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="mygrid">
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Width="1"/>

        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}" CornerRadius="10" Padding="8" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- 0. Title Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- 1. Search Panel -->
                    <RowDefinition Height="Auto"/>
                    <!-- 2. DataGrid (Fills Remaining Vertical Space) -->
                    <RowDefinition Height="*"/>
                    <!-- 3. Navigation Footer Bar -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER BAR -->
                <Border Grid.Row="0" x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-8,-8,-8,6" MinHeight="38" Height="38" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" BorderBrush="{x:Null}" Background="Transparent" Height="28" Width="28" Padding="0" IsTabStop="False" ToolTip="کمینه">
                                <materialDesign:PackIcon Kind="WindowMinimize" Height="17" Width="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button x:Name="Btn_Max" Click="Btn_Max_Click" BorderBrush="{x:Null}" Background="Transparent" Height="28" Width="28" Padding="0" IsTabStop="False" ToolTip="بیشینه">
                                <materialDesign:PackIcon Kind="WindowMaximize" Height="17" Width="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                            <Button x:Name="Btn_Close" Click="Btn_Close_Click" BorderBrush="{x:Null}" Background="Transparent" Height="28" Width="28" Padding="0" IsTabStop="False" ToolTip="بستن">
                                <materialDesign:PackIcon Kind="WindowClose" Height="17" Width="17" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>

                        <Label x:Name="WINTILENAME" Content="دفترچه تلفن" Padding="15,0" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- FILTER & SEARCH PANEL -->
                <GroupBox Grid.Row="1" Header="جستجو و فیلتر" FlowDirection="RightToLeft" Margin="4,2,4,6" Style="{StaticResource MaterialDesignCardGroupBox}" materialDesign:ColorZoneAssist.Mode="PrimaryLight">
                    <Grid Margin="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0" Content="نام:" VerticalAlignment="Center" Margin="5,0"/>
                        <TextBox Grid.Column="1" x:Name="TXT_SEARCH_NAME" Height="30" Style="{StaticResource FuzzyOut}" Padding="4" TextWrapping="NoWrap" VerticalAlignment="Center" TextChanged="TXT_SEARCH_NAME_TextChanged"/>

                        <Label Grid.Column="2" Content="تلفن / همراه / آدرس / توضیحات:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                        <TextBox Grid.Column="3" x:Name="TXT_SEARCH_TEL" Height="30" Style="{StaticResource FuzzyOut}" Padding="4" TextWrapping="NoWrap" VerticalAlignment="Center" TextChanged="TXT_SEARCH_TEL_TextChanged"/>
                    </Grid>
                </GroupBox>

                <!-- DATA GRID (RESPONSIVE FILL) -->
                <syncfusion:SfDataGrid Grid.Row="2" x:Name="SYNCFUSION_DG"
                                       HeaderRowHeight="36"
                                       RowHeight="32"
                                       HeaderStyle="{StaticResource KDGHeader}"
                                       Style="{StaticResource KDG}"
                                       AllowSorting="True"
                                       AllowFiltering="True"
                                       AutoGenerateColumns="False"
                                       AllowResizingColumns="True"
                                       ColumnSizer="Star"
                                       FlowDirection="RightToLeft"
                                       Margin="4,2,4,6"
                                       NavigationMode="Cell">

                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTextColumn HeaderText="نام" MappingName="NAME"  Width="300" TextAlignment="Right"/>
                        <syncfusion:GridTextColumn HeaderText="تلفن / اطلاعات تماس (ترکیبی)" MappingName="TEL_FULL" Width="250" TextAlignment="Right"/>
                        <syncfusion:GridTextColumn HeaderText="تلفن ثابت" MappingName="TEL" TextAlignment="Right"/>
                        <syncfusion:GridTextColumn HeaderText="همراه" MappingName="MOBILE" TextAlignment="Right"/>
                        <syncfusion:GridTextColumn HeaderText="آدرس" MappingName="ADDRESS" TextAlignment="Right"/>
                        <syncfusion:GridTextColumn HeaderText="توضیحات" MappingName="TOZIH" TextAlignment="Right"/>
                    </syncfusion:SfDataGrid.Columns>

                </syncfusion:SfDataGrid>

                <!-- FOOTER / COUNTER & NAVIGATION -->
                <Border Grid.Row="3" Background="{DynamicResource MaterialDesignDivider}" Padding="10,4" Margin="4,0,4,2" CornerRadius="5">
                    <DockPanel LastChildFill="False">
                        <!-- Record Count Label -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="تعداد رکوردها: " FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TXT_COUNT" Text="0" FontWeight="Bold" Foreground="Blue" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>

                        <!-- Navigation Buttons -->
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight">
                            <Button ToolTip="اولین رکورد" Click="Btn_First_Click" Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32">
                                <materialDesign:PackIcon Kind="PageFirst" Width="22" Height="22" Foreground="{StaticResource PrimaryHueMidBrush}"/>
                            </Button>

                            <Button ToolTip="رکورد قبلی" Click="Btn_Prev_Click" Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32">
                                <materialDesign:PackIcon Kind="ChevronLeft" Width="24" Height="24" Foreground="{StaticResource PrimaryHueMidBrush}"/>
                            </Button>

                            <Border Background="#10000000" CornerRadius="4" Margin="5,0" Padding="8,2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TXT_CURRENT_INDEX" Text="0" FontWeight="Bold" VerticalAlignment="Center"/>
                                    <TextBlock Text=" / " Foreground="Gray" Margin="4,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TXT_TOTAL_COUNT" Text="0" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Button ToolTip="رکورد بعدی" Click="Btn_Next_Click" Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32">
                                <materialDesign:PackIcon Kind="ChevronRight" Width="24" Height="24" Foreground="{StaticResource PrimaryHueMidBrush}"/>
                            </Button>

                            <Button ToolTip="آخرین رکورد" Click="Btn_Last_Click" Style="{StaticResource MaterialDesignIconButton}" Width="32" Height="32">
                                <materialDesign:PackIcon Kind="PageLast" Width="22" Height="22" Foreground="{StaticResource PrimaryHueMidBrush}"/>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
        </Border>

        <!-- SYSTEM NOTIFICATION POPUP -->
        <Popup x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative" Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1" VerticalAlignment="Center" Background="{x:Null}"
                             Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
    </Grid>
</Window>
