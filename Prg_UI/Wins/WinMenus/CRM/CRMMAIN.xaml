<Window x:Class="Prg_UI.Wins.WinMenus.CRM.CRMMAIN"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.CRM"
        mc:Ignorable="d"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="{StaticResource IRANYEKAN}"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Height="600" Width="1200"
        Loaded="Window_Loaded" ContentRendered="Window_ContentRendered" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>

    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="mygrid">
        <Grid.RowDefinitions>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Width="1" />
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}" CornerRadius="10" Padding="8" BorderThickness="1" Margin="0,0,0,-185">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label Content="مدیریت ارتباط با مشتری" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0" BorderBrush="{x:Null}" Background="Transparent" FontSize="12" Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0" BorderBrush="{x:Null}" Background="Transparent" FontSize="12" Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0" BorderBrush="{x:Null}" Background="Transparent" FontSize="12" Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <DataGrid x:Name="CRM_MASTER_SUB"
                  Grid.Row="0"
                  ItemsSource="{Binding CUSTOMER_DATA}"
                  AutoGenerateColumns="False"
                  ColumnHeaderStyle="{StaticResource CenteryHeaderstyle}"
                  CellStyle="{StaticResource CellFocusyBorder}"
                  HorizontalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                  VerticalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                  KeyboardNavigation.TabNavigation="Contained"
                  FlowDirection="RightToLeft"
                  SelectionUnit="FullRow"
                  CanUserDeleteRows="False"
                  CanUserAddRows="True"
                  EnableColumnVirtualization="True"
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  Margin="4,50,4,0"
                  Height="226"
                  VerticalAlignment="Top"
                  IsReadOnly="False"
                  SelectionChanged="CRM_MASTER_SUB_SelectionChanged"
                  CellEditEnding="CRM_MASTER_SUB_CellEditEnding"
                  InitializingNewItem="CRM_MASTER_SUB_InitializingNewItem"
                  RowEditEnding="CRM_MASTER_SUB_RowEditEnding" PreviewKeyDown="CRM_MASTER_SUB_PreviewKeyDown">
            <DataGrid.Style>
                <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource MaterialDesignDataGrid}">
                    <Setter Property="materialDesign:DataGridAssist.EnableEditBoxAssist" Value="False"/>
                    <Setter Property="GridLinesVisibility" Value="All"/>
                </Style>
            </DataGrid.Style>
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding DT}" Header="تاریخ" Width="100"/>
                <DataGridTextColumn Binding="{Binding IDCN}" Header="گردش" Width="70"/>
                <DataGridTextColumn Binding="{Binding COMPANY_NAME}" Header="نام شرکت" Width="300"/>
                <DataGridTextColumn Binding="{Binding MANAGER}" Header="مدیر عامل" Width="300"/>
                <DataGridTextColumn Binding="{Binding FACT_TEL}" Header="تلفن کارخانه" Width="300"/>
                <DataGridTextColumn Binding="{Binding MOBILE}" Header="موبایل مدیرعامل" Width="150"/>

                <!-- STATUS: مثل GridComboBoxColumn در SfDataGrid -->
                <DataGridComboBoxColumn x:Name="STATUS_COLUMN"
                                        Header="وضعیت"
                                        Width="200"
                                        DisplayMemberPath="NAME"
                                        SelectedValuePath="CODE"
                                        ItemsSource="{Binding DataContext.StatusItems, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        SelectedValueBinding="{Binding STATUS, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>

                <DataGridTextColumn Binding="{Binding USER_NAME}" Header="نام کارشناس" Width="150" IsReadOnly="True"/>
                <DataGridTextColumn Binding="{Binding PERNUM}" Header="تعداد پرسنل" Width="100"/>

                <!-- STATUS_FACT: مثل GridComboBoxColumn در SfDataGrid -->
                <DataGridComboBoxColumn x:Name="STATUS_FAC_COLUMN"
                                        Header="وضعیت کارخانه"
                                        Width="130"
                                        DisplayMemberPath="STATUS_FACT"
                                        SelectedValuePath="STATUS_FACT"
                                        ItemsSource="{Binding DataContext.StatusFactItems, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        SelectedValueBinding="{Binding STATUS_FACT, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>

                <DataGridTextColumn Binding="{Binding PRODUCTS}" Header="محصولات" Width="250"/>
                <DataGridTextColumn Binding="{Binding ACCOUNTANT}" Header="حسابدار" Width="100"/>
                <!-- توجه: در SfDataGrid برای SOFTWARE هدر "سابقه کار" بود -->
                <DataGridTextColumn Binding="{Binding SOFTWARE}" Header="سابقه کار" Width="300"/>
                <DataGridTextColumn Binding="{Binding ESP_PERSON}" Header="اشخاص ذی نفوذ" Width="300"/>
                <DataGridTextColumn Binding="{Binding ADDR}" Header="آدرس" Width="400"/>
                <DataGridTextColumn Binding="{Binding REAGENT}" Header="معرف" Width="150"/>
                <DataGridTextColumn Binding="{Binding COMMENT}" Header="توضیحات" Width="500"/>
                <DataGridTextColumn Binding="{Binding CITY}" Header="شهر" Width="70"/>
                <DataGridTextColumn Binding="{Binding DATE_SABT}" Header="تاریخ ثبت" Width="200"/>
                <DataGridTextColumn Binding="{Binding PIC}" Header="ضمیمه" Width="100" IsReadOnly="True"/>
                <DataGridTextColumn Binding="{Binding ID}" Header="شماره" Width="100"/>

                <!-- ستون‌های مخفی مثل SfDataGrid (IsHidden=True -> Visibility=Collapsed) -->
                <DataGridTextColumn Binding="{Binding USERID}" Header="کد کارشناس" Visibility="Collapsed"/>
                <DataGridTextColumn Binding="{Binding LONGITUDE}" Header="طول" Visibility="Collapsed"/>
                <DataGridTextColumn Binding="{Binding LATITUDE}" Header="عرض" Visibility="Collapsed"/>
                <DataGridTextColumn Binding="{Binding OSTANID}" Header="کد استان" Visibility="Collapsed"/>
                <DataGridTextColumn Binding="{Binding SHAHRID}" Header="کد شهرستان" Visibility="Collapsed"/>
                <DataGridTextColumn Binding="{Binding CRT}" Header="CRT" Visibility="Collapsed"/>
                <DataGridTextColumn Binding="{Binding UID}" Header="UID" Visibility="Collapsed"/>
            </DataGrid.Columns>
        </DataGrid>

        <DataGrid x:Name="DETAIL_CRM_SUB" IsReadOnly="False"
                  EnableColumnVirtualization="True" 
                  EnableRowVirtualization="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ItemsSource="{Binding EVENT_DATA}" ColumnHeaderStyle="{StaticResource CenteryHeaderstyle}" CellStyle="{StaticResource CellFocusyBorder}" HorizontalGridLinesBrush="{StaticResource GENERAL_Grlicom}" VerticalGridLinesBrush="{StaticResource GENERAL_Grlicom}" KeyboardNavigation.TabNavigation="Contained" AutoGenerateColumns="False" FlowDirection="RightToLeft" SelectionUnit="FullRow" CanUserDeleteRows="False" Margin="4,334,4,47" BorderThickness="1" CanUserAddRows="True" IsEnabled="False" RowEditEnding="DETAIL_CRM_SUB_RowEditEnding" InitializingNewItem="DETAIL_CRM_SUB_InitializingNewItem" PreviewKeyDown="DETAIL_CRM_SUB_PreviewKeyDown">
            <DataGrid.Style>
                <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource MaterialDesignDataGrid}">
                    <Setter Property="materialDesign:DataGridAssist.EnableEditBoxAssist" Value="False"/>
                    <Setter Property="GridLinesVisibility" Value="All"/>
                </Style>
            </DataGrid.Style>
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding INFO_DATE, StringFormat=####/##/##}" Header="تاریخ" Width="100" />
                <DataGridTextColumn Binding="{Binding INFO_TIME, StringFormat={}{0:00\:00}}" Header="ساعت" Width="Auto" />

                <DataGridComboBoxColumn x:Name="SALER_COLUMN" SelectedValueBinding="{Binding SALER, UpdateSourceTrigger=LostFocus}" DisplayMemberPath="SALER" SelectedValuePath="SALER" Header="تماس گیرنده" Width="200" />
                <DataGridComboBoxColumn x:Name="BUYER_COLUMN" SelectedValueBinding="{Binding BUYER, UpdateSourceTrigger=LostFocus}" DisplayMemberPath="BUYER" SelectedValuePath="BUYER" Header="طرف مذاکره" Width="200" />
                <DataGridTextColumn Binding="{Binding COMMENT}" Header="توضیحات" Width="300" />
                
                <DataGridTextColumn Binding="{Binding NEXT_DATE, StringFormat=####/##/##}" Header="تماس بعدی" Width="Auto" />
                <DataGridTextColumn Binding="{Binding NEXT_TIME}" Header="ساعت تماس" Width="Auto" />
                <DataGridTextColumn Binding="{Binding MITING}" Header="جلسه" Width="Auto" />

                <DataGridComboBoxColumn x:Name="STATUS2_COLUMN" SelectedValueBinding="{Binding STATUS, UpdateSourceTrigger=LostFocus}" DisplayMemberPath="NAME" SelectedValuePath="CODE" Header="وضعیت" Width="Auto" />

                <DataGridTextColumn Binding="{Binding PIC}" Header="ضمیمه" IsReadOnly="True" Width="Auto" />

                
                <DataGridTextColumn Binding="{Binding PAYAM}" Header="پیام" Width="Auto" />
                <DataGridTextColumn Binding="{Binding USERID}" Header="کد کاربر" Width="Auto" />
                <DataGridTextColumn x:Name="CDATETI_COLUMN" Binding="{Binding CDATETI}" Header="تاریخ و ساعت ایجاد" Width="Auto" />
                
                <DataGridTextColumn Binding="{Binding IDDE}" Header="شناسه" Width="Auto" Visibility="Collapsed" />
                <DataGridTextColumn Binding="{Binding COMPANY_NAME}" Header="نام شرکت" Width="200" Visibility="Collapsed" />
                <DataGridTextColumn Binding="{Binding IDC}" Header="ID مشتری" Width="Auto" Visibility="Collapsed"/>
                <DataGridTextColumn Binding="{Binding CRT}" Header="CRT" Width="Auto" Visibility="Collapsed"/>
                <DataGridTextColumn Binding="{Binding UID}" Header="UID" Width="Auto" Visibility="Collapsed"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>

</Window>