<Window x:Class="Prg_UI.Wins.WinMenus.SALARY.WIN_SALARY_MANAGE"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.SALARY"
        mc:Ignorable="d"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        FontFamily="{StaticResource IRANYEKAN}"
        Title="مستر کارکت - سیستم حقوق و دستمزد PAY2" Height="850" Width="1400" d:Height="2000" d:Width="2000"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#f8fafc"
        SnapsToDevicePixels="True">

    <Window.Resources>
        <SolidColorBrush x:Key="Primary" Color="#2563eb"/>
        <SolidColorBrush x:Key="PrimaryHover" Color="#1d4ed8"/>
        <SolidColorBrush x:Key="PrimaryLight" Color="#eff6ff"/>
        <SolidColorBrush x:Key="BgMain" Color="#f8fafc"/>
        <SolidColorBrush x:Key="BgWhite" Color="#ffffff"/>

        <SolidColorBrush x:Key="TextMain" Color="#1e293b"/>
        <SolidColorBrush x:Key="TextMuted" Color="#64748b"/>
        <SolidColorBrush x:Key="TextLight" Color="#94a3b8"/>

        <SolidColorBrush x:Key="BorderColor" Color="#e2e8f0"/>
        <SolidColorBrush x:Key="BorderLight" Color="#f1f5f9"/>

        <SolidColorBrush x:Key="SuccessBg" Color="#ecfdf5"/>
        <SolidColorBrush x:Key="SuccessText" Color="#059669"/>
        <SolidColorBrush x:Key="WarningBg" Color="#fffbeb"/>
        <SolidColorBrush x:Key="WarningText" Color="#d97706"/>
        <SolidColorBrush x:Key="ErrorText" Color="#ef4444"/>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolConverter x:Key="InverseBool"/>

        <Style x:Key="FadeInGrid" TargetType="Grid">
            <Style.Triggers>
                <Trigger Property="IsVisible" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                                <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,15,0,0" To="0,0,0,0" Duration="0:0:0.4">
                                    <ThicknessAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </ThicknessAnimation.EasingFunction>
                                </ThicknessAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgWhite}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderLight}"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" Opacity="0.03" BlurRadius="15" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnPrimary" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Primary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryHover}"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnOutline" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryLight}"/>
                    <Setter Property="BorderBrush" Value="#93c5fd"/>
                    <Setter Property="Foreground" Value="{StaticResource Primary}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BtnGhost" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BorderLight}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="GroupName" Value="Menu"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}" Name="border">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BgMain}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryLight}"/>
                                <Setter Property="Foreground" Value="{StaticResource Primary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InputStyle" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Background" Value="{StaticResource BgMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#93c5fd"/>
                    <Setter Property="Background" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InputLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="IsTextSearchEnabled" Value="True"/>
            <Setter Property="IsTextSearchCaseSensitive" Value="False"/>
            <Setter Property="StaysOpenOnEdit" Value="False"/>
            <Setter Property="Padding" Value="12,0,0,0"/>
            <Setter Property="Background" Value="{StaticResource BgMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="MaxDropDownHeight" Value="300"/>
            <!-- ✅ CRITICAL -->
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <!-- ✅ Virtualization settings -->
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel"/>

            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel/>
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="PART_EditableTextBox"
                                 Grid.Column="0"
                                 Background="Transparent"
                                 BorderThickness="0" 
                                 materialDesign:TextFieldAssist.UnderlineBrush="{x:Null}"
                                 Foreground="{TemplateBinding Foreground}"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"
                                 VerticalAlignment="Center"
                                 Padding="{TemplateBinding Padding}"
                                 CaretBrush="{TemplateBinding Foreground}"
                                 FocusVisualStyle="{x:Null}"/>

                                <ToggleButton x:Name="toggleBtn"
                                      Grid.Column="1"
                                      IsChecked="{Binding IsDropDownOpen,
                                                  RelativeSource={RelativeSource TemplatedParent},
                                                  Mode=TwoWay}"
                                      Focusable="False"
                                      Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent">
                                                <Path Data="M0,0 L5,5 L10,0"
                                              Stroke="#64748b"
                                              StrokeThickness="1.5"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              StrokeLineJoin="Round"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <Popup x:Name="PART_Popup"
                               Grid.ColumnSpan="2"
                               Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Focusable="False"
                               PopupAnimation="Slide">
                                    <Grid SnapsToDevicePixels="True"
                                  MinWidth="{TemplateBinding ActualWidth}"
                                  MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <Border Background="White"
                                        BorderThickness="1"
                                        BorderBrush="{StaticResource BorderColor}"
                                        CornerRadius="10"
                                        Margin="0,4,0,0">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="12" ShadowDepth="3"/>
                                            </Border.Effect>

                                            <!-- ✅ FIXED: Use ItemsPresenter to preserve virtualization -->
                                            <ScrollViewer Margin="4,6" 
                                                  SnapsToDevicePixels="True"
                                                  CanContentScroll="True"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                                <ItemsPresenter/>
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Popup>

                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#93c5fd"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#93c5fd"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#93c5fd"/>
                                <Setter TargetName="border" Property="Background" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Padding" Value="12,8"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="itemBorder"
                                Background="Transparent"
                                CornerRadius="6"
                                Margin="4,2"
                                Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource PrimaryLight}"/>
                                        <Setter Property="Foreground" Value="{StaticResource Primary}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource PrimaryLight}"/>
                                        <Setter Property="Foreground" Value="{StaticResource Primary}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Style.Resources>
        </Style>

        <!-- Nav Action Button — برای دکمه‌های modal که تب نیستند -->
        <Style x:Key="NavActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12"
                        Padding="{TemplateBinding Padding}" Name="border">
                            <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BgMain}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource PrimaryLight}"/>
                                <Setter Property="Foreground" Value="{StaticResource Primary}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="2" FlowDirection="LeftToRight" Panel.ZIndex="200" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,20,0,0" 
                Background="#1e293b" CornerRadius="16" Padding="20,12"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <Border Background="#30059669" CornerRadius="20" Width="24" Height="24" Margin="0,0,10,0">
                    <Path Data="M20 6L9 17l-5-5" Stroke="#34d399" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform" Margin="4"/>
                </Border>
                <TextBlock Text="{Binding ToastMessage}" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <Border Background="White" BorderThickness="0,0,1,0" BorderBrush="{StaticResource BorderColor}" Panel.ZIndex="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="24">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="12" Margin="0,0,12,0" Background="{StaticResource Primary}">
                            <TextBlock Text="P2" Foreground="White" FontWeight="Bold" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="مستر کارکت" FontWeight="Bold" Foreground="{StaticResource TextMain}" FontSize="15"/>
                            <TextBlock Text="نسخه PAY2 v6.0" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Background="{StaticResource BgMain}" CornerRadius="12" Margin="16,0,16,16" Padding="12" BorderThickness="1" BorderBrush="{StaticResource BorderLight}">
                    <StackPanel>
                        <TextBlock Text="دوره فعال" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,0,4"/>
                        <Grid>
                            <TextBlock Text="۱۴۰۴/۰۱" FontWeight="Bold" Foreground="{StaticResource Primary}" Margin="36,0,0,0"/>
                            <Border Background="{StaticResource PrimaryLight}" CornerRadius="10" HorizontalAlignment="Left" Padding="10,2">
                                <TextBlock Text="باز" Foreground="{StaticResource Primary}" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Hidden" Margin="12,0">
                    <StackPanel>
                        <RadioButton Style="{StaticResource NavButtonStyle}" Content="داشبورد" IsChecked="True" Checked="Tab_Checked" Tag="dashboard"/>
                        <RadioButton Style="{StaticResource NavButtonStyle}" Content="مدیریت کارگاه‌ها" Checked="Tab_Checked" Tag="workshops"/>
                        <RadioButton Style="{StaticResource NavButtonStyle}" Content="پرسنل و احکام" Checked="Tab_Checked" Tag="employees"/>
                        <RadioButton Style="{StaticResource NavButtonStyle}" Content="کارکرد و مرخصی" Checked="Tab_Checked" Tag="attendance"/>
                        <RadioButton Style="{StaticResource NavButtonStyle}" Content="مساعده هوشمند" Checked="Tab_Checked" Tag="advances"/>
                        <RadioButton Style="{StaticResource NavButtonStyle}" Content="محاسبه حقوق" Checked="Tab_Checked" Tag="payroll"/>
                        <RadioButton Style="{StaticResource NavButtonStyle}" Content="تنظیمات سیستم" Checked="Tab_Checked" Tag="settings"/>
                        <RadioButton Style="{StaticResource NavButtonStyle}" Content="آیتم‌های حقوقی" Checked="Tab_Checked" Tag="itemdefs"/>

                        <!-- جداکننده بصری -->
                        <Separator Margin="4,10,4,4" Background="{StaticResource BorderLight}"/>
                        <!--<TextBlock Text="تعاریف پایه سیستم" Foreground="{StaticResource TextLight}" FontSize="11" Margin="16,2,16,4"/>-->
                        <Button Style="{StaticResource NavActionButtonStyle}" Content="آیتم‌های حقوقی" Click="ShowItemDefModal_Click" FlowDirection="LeftToRight"/>
                        <Button Style="{StaticResource NavActionButtonStyle}" Content="قالب‌های حکم" Click="ShowTemplateModal_Click" FlowDirection="LeftToRight"/>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="3" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderLight}" Padding="16">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource BorderColor}" Margin="0,0,12,0">
                            <TextBlock Text="مد" Foreground="{StaticResource TextMuted}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="مدیر سیستم" FontWeight="SemiBold" Foreground="{StaticResource TextMain}" FontSize="13"/>
                            <TextBlock Text="کارگاه مرکزی" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="64"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="White" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderColor}">
                <Grid Margin="24,0">
                    <TextBlock x:Name="TxtHeaderTitle" Text="داشبورد" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBox Style="{StaticResource InputStyle}" Width="250" Padding="35,8,12,8" Margin="0,0,12,0" Text="جستجوی سریع..."/>
                        <Border Width="40" Height="40" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource BorderColor}" Background="Transparent">
                            <Path Data="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9 M13.73 21a2 2 0 01-3.46 0" Stroke="{StaticResource TextMuted}" StrokeThickness="2" Stretch="Uniform" Width="18" Margin="10" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="32">

                    <!-- Dashboard -->
                    <Grid x:Name="TabDashboard" Style="{StaticResource FadeInGrid}" Visibility="Visible" d:Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Style="{StaticResource CardStyle}" Grid.Column="0" Margin="0,0,8,0">
                                <StackPanel>
                                    <Border Background="{StaticResource PrimaryLight}" CornerRadius="10" Width="48" Height="48" HorizontalAlignment="Right" Margin="0,0,0,16">
                                        <Path Data="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2 M9 7a4 4 0 100-8 4 4 0 000 8z M23 21v-2a4 4 0 00-3-3.87" Stroke="{StaticResource Primary}" StrokeThickness="2" Stretch="Uniform" Margin="12" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                                    </Border>
                                    <TextBlock Text="پرسنل فعال" Foreground="{StaticResource TextMuted}" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Text="۱۲۴ نفر" FontWeight="Bold" FontSize="26" Foreground="{StaticResource TextMain}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Grid.Column="1" Margin="8,0">
                                <StackPanel>
                                    <Border Background="#ecfdf5" CornerRadius="10" Width="48" Height="48" HorizontalAlignment="Right" Margin="0,0,0,16">
                                        <Path Data="M21 4H3C1.9 4 1 4.9 1 6v12c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2z M1 10h22" Stroke="#059669" StrokeThickness="2" Stretch="Uniform" Margin="12" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                                    </Border>
                                    <TextBlock Text="تخمین حقوق خالص" Foreground="{StaticResource TextMuted}" FontSize="13" Margin="0,0,0,4"/>
                                    <TextBlock Text="۲.۴ میلیارد" FontWeight="Bold" FontSize="26" Foreground="{StaticResource TextMain}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}" Grid.Column="2" Margin="8,0">
                                <StackPanel>
                                    <Border Background="#fffbeb" CornerRadius="10" Width="48" Height="48" HorizontalAlignment="Right" Margin="0,0,0,16">
                                        <Path Data="M20 12V8H6a2 2 0 01-2-2c0-1.1.9-2 2-2h12v4 M4 6v12c0 1.1.9 2 2 2h14v-4 M18 12a2 2 0 110-4 2 2 0 010 4z" Stroke="#d97706" StrokeThickness="2" Stretch="Uniform" Margin="12" StrokeStartLineCap="Round" StrokeLineJoin="Round"/>
                                    </Border>
                                    <TextBlock Text="مساعده کسر شده" Foreground="{StaticResource TextMuted}" FontSize="13" Margin="0,0,0,4"/>
