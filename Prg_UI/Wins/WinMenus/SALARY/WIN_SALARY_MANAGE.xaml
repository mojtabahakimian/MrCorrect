                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Style="{StaticResource BtnGhost}" Content="ویرایش" Foreground="{StaticResource Primary}" Click="EditContract_Click" CommandParameter="{Binding}" Margin="0,0,4,0" Padding="8,4"/>
                                                    <Button Style="{StaticResource BtnGhost}" Content="حذف" Foreground="{StaticResource ErrorText}" Click="DeleteContract_Click" CommandParameter="{Binding}" Padding="8,4"/>
                                                </StackPanel>
                                            </DataTemplate>
