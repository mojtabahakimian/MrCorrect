                                        <DataTemplate>
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource BgMain}" Padding="20,16">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.5*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="1.5*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="1.5*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FullName}" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                                        <TextBlock Text="{Binding Code}" Foreground="{StaticResource TextLight}" FontFamily="Consolas" FontSize="11" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="T-1050" Foreground="{StaticResource TextMuted}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding RawBalanceText}" Foreground="{StaticResource TextMain}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="0" Foreground="{StaticResource ErrorText}" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding AdvanceText}" Foreground="{StaticResource Primary}" FontWeight="Bold" FontSize="16" FontFamily="Consolas" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Payroll -->
                    <Grid x:Name="TabPayroll" Style="{StaticResource FadeInGrid}" Visibility="Collapsed" d:Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="مدیریت اجرای حقوق (PAY2_RUN)" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,0,0,8"/>
                                <TextBlock Text="انتخاب کارگاه و دوره ماهیانه، اجرای موتور محاسبه و مشاهده ریز نتایج." Foreground="{StaticResource TextMuted}"/>

                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource InputLabel}" Text="انتخاب کارگاه *"/>
                                        <ComboBox ItemsSource="{Binding Workshops}" DisplayMemberPath="WS_NAME" SelectedValuePath="WS_ID" SelectedValue="{Binding SelectedPayrollWsId}" Width="250" Background="{StaticResource BgMain}" Padding="10"/>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource InputLabel}" Text="ماه (YYYYMM00) *"/>
                                        <TextBox Style="{StaticResource InputStyle}" Width="150" Text="{Binding PayrollSearchDate, UpdateSourceTrigger=PropertyChanged}" ToolTip="مثال: 14030100"/>
                                    </StackPanel>

                                    <Button Style="{StaticResource BtnPrimary}" Content="فراخوانی دوره" Margin="0,22,0,0" Click="BtnLoadPayroll_Click" Padding="16,8"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,16,0,0">
                                <!--<Button Style="{StaticResource BtnOutline}" Content="پیش‌نمایش فیش‌ها" Margin="0,0,12,0" Click="ShowPayslipModal_Click" IsEnabled="{Binding IsPeriodOpened}"/>-->
                                <Button Style="{StaticResource BtnPrimary}" Content="تایید نهایی و صدور سند" Click="FinalizePayroll_Click" IsEnabled="{Binding IsPeriodOpened}"/>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource CardStyle}" Grid.Row="1" Padding="0" BorderBrush="{StaticResource Primary}" BorderThickness="1,4,1,1" Visibility="{Binding IsPeriodOpened, Converter={StaticResource BoolToVis}}">
