                                        <CNC:NumericTextBox IsPersianDateMode="True" TextBoxStyle="{StaticResource InputStyle}" Text="{Binding CurrentEmployee.FIRE_DATE, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/>
                                    </StackPanel>
