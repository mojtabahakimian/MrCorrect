                    </Border>

                    <!-- F-08 — TabItemDef — تعریف آیتم‌های حقوقی (PAY2_ITEM_DEF) -->
                    <Grid x:Name="TabItemDefs" Style="{StaticResource FadeInGrid}" Visibility="Collapsed"  d:Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- هدر صفحه -->
                        <Grid Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="تعریف آیتم‌های حقوقی (PAY2_ITEM_DEF)" 
                       FontSize="24" FontWeight="Bold" 
                       Foreground="{StaticResource TextMain}" Margin="0,0,0,8"/>
                                <TextBlock Text="مدیریت آیتم‌های پرداختی و کسوری — آیتم‌های سیستمی (IS_SYSTEM=1) قابل حذف نیستند." 
                       Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                        </Grid>

                        <!-- محتوا: گرید سمت راست + فرم سمت چپ -->
                        <!-- محتوا: گرید سمت راست + فرم سمت چپ -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <!-- پنل راست (جدول) -->
                                <ColumnDefinition Width="6*"/>
                                <!-- پنل اسپلیتر -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- پنل چپ (فرم) -->
                                <ColumnDefinition Width="4*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ──────── گرید آیتم‌ها (ستون ۰) ──────── -->
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,6,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Background="{StaticResource BgMain}" Padding="16" 
                        BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderLight}" 
                        CornerRadius="16,16,0,0">
                                        <TextBlock Text="لیست آیتم‌های تعریف‌شده" 
                               FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                    </Border>

                                    <DataGrid x:Name="GridItemDefs" Grid.Row="1" d:ItemsSource="{d:SampleData}"
                                              ItemsSource="{Binding ItemDefs}"
                                              SelectionChanged="GridItemDefs_SelectionChanged"
                                              AutoGenerateColumns="False" IsReadOnly="True"
                                              Background="White" RowBackground="White"
                                              AlternatingRowBackground="#f8fafc"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              HorizontalGridLinesBrush="#e2e8f0"
                                              BorderThickness="0"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto" 
                                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <DataGrid.Columns>
                                            <!-- عرض‌های ثابت به جای Auto برای جلوگیری از فشرده شدن -->
                                            <DataGridTextColumn Header="کد آیتم" Binding="{Binding ITEM_CODE}" Width="120">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontFamily" Value="Consolas"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                        <Setter Property="Margin" Value="10,0"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <!-- ستون متغیر که بقیه فضا را می‌گیرد -->
                                            <DataGridTextColumn Header="نام فارسی" Binding="{Binding ITEM_NAME}" Width="Auto" MinWidth="100">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                        <Setter Property="Margin" Value="4,0"/>
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Header="نوع" Binding="{Binding ItemTypeText}" Width="110">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Header="مبنا" Binding="{Binding CalcBasisText}" Width="75">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                                        <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTemplateColumn Header="بیمه" Width="80">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding InsBgColor}" CornerRadius="8" Padding="8,4" HorizontalAlignment="Center" Margin="4">
                                                            <TextBlock Text="{Binding InsText}" FontSize="11" Foreground="{Binding InsTextColor}" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="مالیات" Width="80">
