                                                                        <Button Style="{StaticResource BtnGhost}" Content="استثنا مشمولیت" Click="ShowOverrideModal_Click" CommandParameter="{Binding}" Foreground="#ec4899" HorizontalContentAlignment="Left" Margin="4,2"/>
                                                                        <Button Style="{StaticResource BtnGhost}" Content="استثنا مساعده" Click="ShowAdvanceExclModal_Click" CommandParameter="{Binding}" Foreground="#f59e0b" HorizontalContentAlignment="Left" Margin="4,2"/>

                                                                        <!-- کد جدید برای تسویه حساب -->
