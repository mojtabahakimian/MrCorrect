                                                                        <Button Style="{StaticResource BtnGhost}" Content="مانده مرخصی" Click="ShowLeaveBalModal_Click" CommandParameter="{Binding}" Foreground="#10b981" HorizontalContentAlignment="Left" Margin="4,2"/>
