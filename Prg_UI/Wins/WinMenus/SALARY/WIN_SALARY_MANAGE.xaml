                                    <StackPanel Margin="0,0,8,0">
                                        <TextBlock Style="{StaticResource InputLabel}" Text="ملیت *"/>
                                        <ComboBox SelectedValuePath="Tag" Style="{StaticResource ComboStyle}" IsEditable="True" SelectedValue="{Binding CurrentEmployee.NATIONALITY}" Background="{StaticResource BgMain}" Padding="10">
