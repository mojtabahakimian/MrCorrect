                                        <ItemsControl ItemsSource="{Binding CurrentPayslip.Earnings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,12">
                                                        <TextBlock Text="{Binding ItemName}" Foreground="{StaticResource TextMuted}"/>
                                                        <TextBlock Text="{Binding AmountStr}" FontFamily="Consolas" HorizontalAlignment="Left"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Margin="0,16,0,0" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderLight}" Padding="0,12,0,0">
                                            <Grid>
                                                <TextBlock Text="جمع ناخالص پرداختی" FontWeight="Bold" Foreground="{StaticResource Primary}"/>
                                                <TextBlock Text="{Binding CurrentPayslip.TotalEarningsStr}" Foreground="{StaticResource Primary}" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Left"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!-- خط جداکننده وسط -->
                                    <Border Grid.Column="1" BorderThickness="1,0,0,0" BorderBrush="{StaticResource BorderLight}" Margin="10,0"/>

                                    <!-- کسورات -->
                                    <StackPanel Grid.Column="2">
                                        <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderLight}" Padding="0,0,0,8" Margin="0,0,0,16">
                                            <TextBlock Text="کسورات (ریال)" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding CurrentPayslip.Deductions}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,12">
                                                        <TextBlock Text="{Binding ItemName}" Foreground="{StaticResource TextMuted}"/>
                                                        <TextBlock Text="{Binding AmountStr}" Foreground="{StaticResource ErrorText}" FontFamily="Consolas" HorizontalAlignment="Left"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Margin="0,16,0,0" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderLight}" Padding="0,12,0,0">
                                            <Grid>
                                                <TextBlock Text="جمع کسورات" FontWeight="Bold" Foreground="{StaticResource ErrorText}"/>
                                                <TextBlock Text="{Binding CurrentPayslip.TotalDeductionsStr}" Foreground="{StaticResource ErrorText}" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Left"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <Border Background="{StaticResource SuccessBg}" BorderThickness="1" BorderBrush="#a7f3d0" CornerRadius="12" Padding="20" Margin="0,32,0,0">
                                    <Grid>
                                        <TextBlock Text="خالص پرداختی (NET_PAY)" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding CurrentPayslip.NetPayStr}" FontSize="28" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource SuccessText}" HorizontalAlignment="Left"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Row="2" Padding="24" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderLight}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Style="{StaticResource BtnOutline}" Content="بستن" Margin="0,0,12,0" Click="CloseModals_Click"/>
                            <Button Style="{StaticResource BtnPrimary}" Content="چاپ فیش حقوقی" Click="PrintPayslip_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <!-- Tax Bracket Modal -->
        <Grid x:Name="ModalTaxBracket" Grid.ColumnSpan="2" Background="#660f172a" Panel.ZIndex="100" d:Visibility="Collapsed" Visibility="Collapsed">
