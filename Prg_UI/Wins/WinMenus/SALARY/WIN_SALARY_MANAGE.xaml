                                                <TextBlock Text="{Binding CurrentPayslip.EmpCode, StringFormat='کد پرسنلی: {0}'}" FontFamily="Consolas" Foreground="{StaticResource TextMuted}" Margin="0,0,16,0"/>
                                                <TextBlock Text="کارکرد: " Foreground="{StaticResource TextMuted}"/>
                                                <TextBlock Text="{Binding CurrentPayslip.WorkDaysStr}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource Primary}"/>
