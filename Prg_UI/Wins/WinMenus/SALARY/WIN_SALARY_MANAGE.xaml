                                        <TextBlock Grid.Column="2" Text="رسمی (DAYSB)" Foreground="{StaticResource SuccessText}" FontWeight="SemiBold" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="اضافه کار (ساعت)" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="مرخصی (روز)" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" TextAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Attendance}">
