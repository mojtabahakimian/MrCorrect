                                                        <Border Background="{Binding ActiveBgColor}" CornerRadius="8" Padding="8,4" HorizontalAlignment="Center" Margin="4">
                                                            <TextBlock Text="{Binding ActiveText}" FontSize="11" Foreground="{Binding ActiveTextColor}" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="سیستمی" Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
