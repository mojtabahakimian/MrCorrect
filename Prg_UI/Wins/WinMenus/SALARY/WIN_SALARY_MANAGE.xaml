                                        <ComboBox SelectedValuePath="Tag" Style="{StaticResource ComboStyle}" IsEditable="True" SelectedValue="{Binding CurrentEmployee.MARITAL}" Background="{StaticResource BgMain}" Padding="10">
                                            <ComboBoxItem Content="متأهل" Tag="1"/>
                                            <ComboBoxItem Content="مجرد" Tag="2"/>
