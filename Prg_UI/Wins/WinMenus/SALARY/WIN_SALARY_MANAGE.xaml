                                        <CNC:NumericTextBox DoesAcceptDouble="False" TextAlignment="Left" RestoreLastValidValue="False" LastValueShouldZero="False" TextBoxStyle="{StaticResource InputStyle}" Text="{Binding CurrentEmployee.ID_NUMBER, UpdateSourceTrigger=PropertyChanged}"/>
