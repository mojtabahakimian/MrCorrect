                                        <CNC:NumericTextBox IsPersianDateMode="True" TextBoxStyle="{StaticResource InputStyle}" Text="{Binding CurrentEmployee.BIRTH_DATE, UpdateSourceTrigger=PropertyChanged}" FlowDirection="LeftToRight"/>
                                    </StackPanel>
