                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="مبلغ کل (ریال)" Binding="{Binding AMOUNT, StringFormat=N0}" Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="{StaticResource Primary}"/>
                                                <Setter Property="FontFamily" Value="Consolas"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="مبلغ قسط" Binding="{Binding INSTALLMENT, StringFormat=N0}" Width="110"/>
                                    <DataGridTextColumn Header="تعداد" Binding="{Binding TOTAL_INST}" Width="60"/>
                                    <DataGridTextColumn Header="پرداخت شده" Binding="{Binding PAID_INST}" Width="80"/>
                                    <DataGridTextColumn Header="مانده وام" Binding="{Binding BALANCE, StringFormat=N0}" Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource ErrorText}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="FontFamily" Value="Consolas"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridCheckBoxColumn Header="فعال" Binding="{Binding IS_ACTIVE}"/>
                                    <DataGridTemplateColumn Header="عملیات" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Style="{StaticResource BtnGhost}" Content="ویرایش" Foreground="{StaticResource Primary}" Click="EditLoan_Click" CommandParameter="{Binding}" Margin="0,0,4,0"/>
                                                    <Button Style="{StaticResource BtnGhost}" Content="حذف" Foreground="{StaticResource ErrorText}" Click="DeleteLoan_Click" CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Padding="24" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderLight}">
                        <Button Style="{StaticResource BtnOutline}" Content="بستن" HorizontalAlignment="Left" Click="CloseLoanModal_Click"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <!-- Modal Settlement Manage (PAY2_SETTLEMENT) -->
        <Grid x:Name="ModalSettlementManage" Grid.ColumnSpan="2" Background="#660f172a" Panel.ZIndex="108" Visibility="Collapsed">
            <Border Background="White" CornerRadius="24" Width="1050" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Padding="24" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderLight}">
                        <Grid>
                            <TextBlock Text="{Binding SettlementModalTitle, FallbackValue='مدیریت تسویه حساب'}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource TextMain}"/>
                            <Button Style="{StaticResource BtnGhost}" Content="X" HorizontalAlignment="Left" Click="CloseSettlementModal_Click" FontFamily="Arial" FontSize="16" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Padding="24" Background="{StaticResource BgMain}">
                        <StackPanel>
                            <TextBlock Text="محاسبه تسویه حساب جدید (این عملیات باعث غیرفعال شدن پرسنل می‌شود)" FontWeight="Bold" FontSize="14" Foreground="{StaticResource ErrorText}" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Style="{StaticResource InputLabel}" Text="تاریخ تسویه (شمسی) *"/>
                                    <TextBox Style="{StaticResource InputStyle}" Background="White" Text="{Binding SettlementInput.SETTLE_DATE, UpdateSourceTrigger=PropertyChanged}" ToolTip="مثال: 14031229"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                    <TextBlock Style="{StaticResource InputLabel}" Text="تاریخ پایان کار (شمسی) *"/>
                                    <TextBox Style="{StaticResource InputStyle}" Background="White" Text="{Binding SettlementInput.END_DATE, UpdateSourceTrigger=PropertyChanged}" ToolTip="مثال: 14031229"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="8,0,8,0">
                                    <TextBlock Style="{StaticResource InputLabel}" Text="سایر درآمدها (ریال)"/>
                                    <TextBox Style="{StaticResource InputStyle}" Background="White" Text="{Binding SettlementInput.OTHER_INCOME, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Margin="8,0,8,0">
                                    <TextBlock Style="{StaticResource InputLabel}" Text="سایر کسورات (ریال)"/>
                                    <TextBox Style="{StaticResource InputStyle}" Background="White" Text="{Binding SettlementInput.OTHER_DED, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4" Margin="8,0,0,0">
                                    <TextBlock Style="{StaticResource InputLabel}" Text="بستانکاری قبلی (ریال)"/>
                                    <TextBox Style="{StaticResource InputStyle}" Background="White" Text="{Binding SettlementInput.PREV_CREDIT, StringFormat=N0, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource BtnPrimary}" Content="محاسبه تسویه حساب (اجرای موتور)" Background="#ef4444" Click="CalculateSettlement_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Padding="24">
                        <StackPanel>
                            <TextBlock Text="لیست تسویه حساب‌های این پرسنل" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextMain}" Margin="0,0,0,12"/>
                            <DataGrid ItemsSource="{Binding EmployeeSettlements}" AutoGenerateColumns="False" IsReadOnly="True" Background="White" RowBackground="White" AlternatingRowBackground="#f8fafc" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#e2e8f0" BorderThickness="1" BorderBrush="#e2e8f0" MinHeight="150" MaxHeight="250">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="تاریخ تسویه" Binding="{Binding SETTLE_DATE}" Width="90">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontFamily" Value="Consolas"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="وضعیت" Binding="{Binding StatusText}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{Binding StatusColor}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="خالص پرداختی" Binding="{Binding NET_SETTLE, StringFormat=N0}" Width="120">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                                <Setter Property="Foreground" Value="{StaticResource SuccessText}"/>
                                                <Setter Property="FontFamily" Value="Consolas"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Header="عیدی" Binding="{Binding EIDI, StringFormat=N0}" Width="100"/>
                                    <DataGridTextColumn Header="سنوات" Binding="{Binding SANAVAT, StringFormat=N0}" Width="100"/>
                                    <DataGridTextColumn Header="مانده مرخصی" Binding="{Binding LEAVE_PAY, StringFormat=N0}" Width="100"/>
                                    <DataGridTextColumn Header="جمع کسورات" Binding="{Binding TOTAL_DED, StringFormat=N0}" Width="100">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource ErrorText}"/>
                                                <Setter Property="VerticalAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Header="عملیات" Width="180">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Style="{StaticResource BtnGhost}" Content="تأیید نهایی" Foreground="{StaticResource Primary}" Click="FinalizeSettlement_Click" CommandParameter="{Binding}" Margin="0,0,4,0" IsEnabled="{Binding CanEdit}"/>
                                                    <Button Style="{StaticResource BtnGhost}" Content="حذف" Foreground="{StaticResource ErrorText}" Click="DeleteSettlement_Click" CommandParameter="{Binding}" IsEnabled="{Binding CanEdit}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Padding="24" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderLight}">
                        <Button Style="{StaticResource BtnOutline}" Content="بستن فرم" HorizontalAlignment="Left" Click="CloseSettlementModal_Click"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>


    </Grid>
</Window>