                            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,12,0">
                                <StackPanel>
                                    <TextBlock Text="محدوده بررسی (ADV_SCOPE)" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBlock Text="اسناد ماه جاری (CURRENT_MONTH)" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Grid.Column="1" Padding="16" Margin="12,0">
                                <StackPanel>
                                    <TextBlock Text="کد کل/معین (حسابداری)" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBlock Text="1140 / 001" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource TextMain}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Grid.Column="2" Padding="16" Margin="12,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="فیلتر مانده (ADV_MIN_POSITIVE)" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,0,0,4"/>
                                    <TextBlock Text="فقط مانده‌های بدهکار" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardStyle}" Grid.Row="2" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="{StaticResource BgMain}" Padding="20,16" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderLight}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="پرسنل" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="کد تفصیلی" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="2" Text="مانده خام حسابداری (ریال)" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="3" Text="استثنا دستی" Foreground="{StaticResource ErrorText}" FontWeight="SemiBold"/>
