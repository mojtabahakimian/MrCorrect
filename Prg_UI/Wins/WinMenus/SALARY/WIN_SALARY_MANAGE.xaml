                    <Border Grid.Row="3" Padding="24" BorderThickness="0,1,0,0" BorderBrush="{StaticResource BorderLight}">
                        <Button Style="{StaticResource BtnOutline}" Content="بستن" HorizontalAlignment="Left" Click="CloseModals_Click"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Advance Settings Modal -->
