                                    <StackPanel Grid.Column="0">
                                        <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderLight}" Padding="0,0,0,8" Margin="0,0,0,16">
                                            <TextBlock Text="پرداختی‌ها و مزایا (ریال)" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
