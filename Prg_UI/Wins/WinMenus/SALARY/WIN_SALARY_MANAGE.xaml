                            <StackPanel Margin="0,0,0,24">
                                <TextBlock Text="پیکربندی سیستم (PAY2_CONFIG)" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,0,0,8"/>
