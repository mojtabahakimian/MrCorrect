                                        <DataTemplate>
                                            <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource BgMain}" Padding="20,16">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding FullName}" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                                        <TextBlock Text="{Binding Code}" Foreground="{StaticResource TextLight}" FontFamily="Consolas" FontSize="11" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Days}" Foreground="{StaticResource Primary}" FontWeight="Bold" FontFamily="Consolas" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding DaysB}" Foreground="{StaticResource SuccessText}" FontWeight="Bold" FontFamily="Consolas" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding OtNormal}" Foreground="{StaticResource TextMain}" FontFamily="Consolas" TextAlignment="Center" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding LeaveDays}" Foreground="{StaticResource WarningText}" FontFamily="Consolas" TextAlignment="Center" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Advances -->
                    <Grid x:Name="TabAdvances" Style="{StaticResource FadeInGrid}" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,24">
                            <StackPanel>
                                <TextBlock Text="مساعده هوشمند (Smart Advances)" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,0,0,8"/>
                                <TextBlock Text="موتور حقوق به صورت خودکار با فیلتر (HES_K, HES_M) مانده بدهی را از حسابداری می‌خواند." Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Width="265" Margin="811,0,0,0">
                                <Button Style="{StaticResource BtnOutline}" Content="تنظیمات اتصال" Margin="0,0,0,0" Click="ShowAdvSettingsModal_Click"/>
                                <Button Style="{StaticResource BtnPrimary}" Content="بروزرسانی از حسابداری" Margin="12,0,0,0" Click="SyncAdvances_Click"/>
