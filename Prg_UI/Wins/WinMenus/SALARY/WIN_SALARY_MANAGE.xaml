                                                            <TextBlock Text="{Binding SystemText}" FontSize="11" Foreground="{Binding SystemTextColor}" FontWeight="SemiBold"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTemplateColumn Header="عملیات" Width="140">
