                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                            <Button Style="{StaticResource BtnGhost}" Content="ویرایش" Foreground="{StaticResource Primary}" Click="EditItemDef_Click" CommandParameter="{Binding}" Margin="0,0,4,0"/>
                                                            <Button Style="{StaticResource BtnGhost}" Content="حذف" Foreground="{StaticResource ErrorText}" Click="DeleteItemDef_Click" CommandParameter="{Binding}" IsEnabled="{Binding CanDelete}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <!-- ──────── اسپلیتر (ستون ۱) ──────── -->
                            <GridSplitter Grid.Column="1" Width="8" 
                      HorizontalAlignment="Center" VerticalAlignment="Stretch" 
                      Background="Transparent" Cursor="SizeWE" />

                            <!-- ──────── فرم ورود/ویرایش (ستون ۲) ──────── -->
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="24" Margin="6,0,0,0">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ItemDefFormTitle}" 
                               FontWeight="Bold" FontSize="16" 
                               Foreground="{StaticResource Primary}" Margin="0,0,0,20"/>

                                        <!-- کد آیتم -->
                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Style="{StaticResource InputLabel}" Text="کد آیتم (انگلیسی) *"/>
                                            <TextBox Style="{StaticResource InputStyle}"
                                 Text="{Binding CurrentItemDef.ITEM_CODE, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding IsItemCodeEnabled}"
                                 ToolTip="مثال: BASE_SAL — پس از ذخیره قابل تغییر نیست"/>
                                        </StackPanel>

                                        <!-- نام فارسی -->
                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Style="{StaticResource InputLabel}" Text="نام فارسی (روی فیش) *"/>
                                            <TextBox Style="{StaticResource InputStyle}"
                                 Text="{Binding CurrentItemDef.ITEM_NAME, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>

                                        <!-- نوع آیتم -->
                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Style="{StaticResource InputLabel}" Text="نوع آیتم *"/>
                                            <ComboBox x:Name="CmbItemType"
                                  SelectedValue="{Binding CurrentItemDef.ITEM_TYPE}"
                                  SelectedValuePath="Tag"
                                  Background="{StaticResource BgMain}" Padding="10">
                                                <ComboBoxItem Tag="1" Content="۱ — پرداختی ثابت"/>
                                                <ComboBoxItem Tag="2" Content="۲ — پرداختی متغیر/کارکردی"/>
                                                <ComboBoxItem Tag="3" Content="۳ — کسر ثابت"/>
                                                <ComboBoxItem Tag="4" Content="۴ — کسر متغیر"/>
                                                <ComboBoxItem Tag="5" Content="۵ — آگاهی (نمایش)"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- مبنای محاسبه -->
                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Style="{StaticResource InputLabel}" Text="مبنای محاسبه *"/>
                                            <ComboBox x:Name="CmbCalcBasis"
                                  SelectedValue="{Binding CurrentItemDef.CALC_BASIS}"
                                  SelectedValuePath="Tag"
                                  Background="{StaticResource BgMain}" Padding="10">
                                                <ComboBoxItem Tag="1" Content="۱ — روزانه (×روزکارکرد÷مبنا)"/>
                                                <ComboBoxItem Tag="2" Content="۲ — ماهیانه (مبلغ کامل)"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- INS_BASE_DAYS / PAY_BASE_DAYS -->
                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,6,0">
                                                <TextBlock Style="{StaticResource InputLabel}" Text="مبنای بیمه"/>
                                                <ComboBox x:Name="CmbInsBaseDays"
                                      SelectedValue="{Binding CurrentItemDef.INS_BASE_DAYS}"
                                      SelectedValuePath="Tag"
                                      Background="{StaticResource BgMain}" Padding="10"
                                      ToolTip="DAYS=کارکرد اسمی | DAYSB=کارکرد رسمی">
                                                    <ComboBoxItem Tag="1" Content="DAYS (اسمی)"/>
                                                    <ComboBoxItem Tag="2" Content="DAYSB (رسمی)"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                                <TextBlock Style="{StaticResource InputLabel}" Text="مبنای پرداخت"/>
                                                <ComboBox x:Name="CmbPayBaseDays"
                                      SelectedValue="{Binding CurrentItemDef.PAY_BASE_DAYS}"
                                      SelectedValuePath="Tag"
                                      Background="{StaticResource BgMain}" Padding="10">
                                                    <ComboBoxItem Tag="1" Content="DAYS (اسمی)"/>
                                                    <ComboBoxItem Tag="2" Content="DAYSB (رسمی)"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <!-- چک‌باکس‌های مشمولیت (اصلاح‌شده به صورت WrapPanel) -->
                                        <Border Background="{StaticResource BgMain}" CornerRadius="10" 
                            Padding="14" BorderThickness="1" 
                            BorderBrush="{StaticResource BorderColor}" Margin="0,0,0,14">
                                            <StackPanel>
                                                <TextBlock Text="تنظیمات مشمولیت" FontWeight="SemiBold" 
                                       Foreground="{StaticResource TextMuted}" 
                                       FontSize="12" Margin="0,0,0,10"/>

                                                <WrapPanel Orientation="Horizontal">
                                                    <CheckBox IsChecked="{Binding CurrentItemDef.INS_SUBJECT}"
                                          Content="مشمول بیمه" VerticalAlignment="Center"
                                          Margin="0,0,16,10"/>

                                                    <CheckBox IsChecked="{Binding CurrentItemDef.TAX_SUBJECT}"
                                          Content="مشمول مالیات" VerticalAlignment="Center"
                                          Margin="0,0,16,10"/>

                                                    <CheckBox IsChecked="{Binding CurrentItemDef.SHOW_IN_SLIP}"
                                          Content="نمایش در فیش" VerticalAlignment="Center"
                                          Margin="0,0,16,10"/>

                                                    <CheckBox IsChecked="{Binding CurrentItemDef.IS_ACTIVE}"
                                          Content="آیتم فعال است" VerticalAlignment="Center"
                                          Margin="0,0,16,10"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>

                                        <!-- ترتیب نمایش -->
                                        <StackPanel Margin="0,0,0,14">
                                            <TextBlock Style="{StaticResource InputLabel}" Text="ترتیب نمایش (SORT_ORDER)"/>
                                            <TextBox Style="{StaticResource InputStyle}"
                                 Text="{Binding CurrentItemDef.SORT_ORDER, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="عدد کمتر = اول نمایش داده می‌شود"/>
                                        </StackPanel>

                                        <!-- توضیحات -->
                                        <StackPanel Margin="0,0,0,20">
                                            <TextBlock Style="{StaticResource InputLabel}" Text="یادداشت"/>
                                            <TextBox Style="{StaticResource InputStyle}"
                                 Text="{Binding CurrentItemDef.NOTES, UpdateSourceTrigger=PropertyChanged}"
                                 Height="55" TextWrapping="Wrap" AcceptsReturn="True"/>
                                        </StackPanel>

                                        <!-- دکمه‌های عملیات -->
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource BtnOutline}" Content="انصراف"
                                Click="CancelEditItemDef_Click"
                                Visibility="{Binding IsEditingItemDef, Converter={StaticResource BoolToVis}}"
                                Margin="0,0,8,0"/>
                                            <Button Style="{StaticResource BtnPrimary}"
                                Content="{Binding ItemDefSaveButtonText}"
                                Click="SaveItemDef_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>

                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Modals -->
        <Grid x:Name="ModalNewEmp" Grid.ColumnSpan="2" Background="#660f172a" Panel.ZIndex="100" Visibility="Collapsed" d:Visibility="Collapsed">
            <Border Background="White" CornerRadius="24" Width="800" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="0" Style="{StaticResource CardStyle}">
