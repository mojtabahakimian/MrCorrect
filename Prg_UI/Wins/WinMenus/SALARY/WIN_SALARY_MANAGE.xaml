                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Padding="24" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderLight}">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{StaticResource BorderLight}" CornerRadius="10" Padding="16,8" Margin="0,0,16,0">
                                                <TextBlock Text="وضعیت محاسبه" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource TextMain}" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="سیستم موتور حقوق PAY2" FontWeight="Bold" Foreground="{StaticResource TextMain}" Margin="0,0,0,4"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="وضعیت فعلی: " Foreground="{StaticResource TextMuted}" FontSize="12"/>
                                                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource WarningText}" FontWeight="SemiBold" FontSize="12"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button x:Name="BtnRevertPayroll" Style="{StaticResource BtnGhost}" Content="برگشت محاسبه" Click="BtnRevertPayroll_Click" IsEnabled="{Binding IsCalcEnabled}" Foreground="{StaticResource ErrorText}" FontWeight="Bold" Padding="16,8" Margin="0,0,12,0"/>
                                            <Button Style="{StaticResource BtnGhost}" Content="اجرای موتور / بازمحاسبه" Click="RunPayroll_Click" IsEnabled="{Binding IsCalcEnabled}" Background="{StaticResource PrimaryLight}" Foreground="{StaticResource Primary}" FontWeight="Bold" Padding="16,8"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1" Background="{StaticResource BgMain}" Padding="20,16" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderLight}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="پرسنل" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold"/>
                                        <TextBlock Grid.Column="1" Text="ناخالص پرداختی" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="بیمه (۷٪)" Foreground="{StaticResource ErrorText}" FontWeight="SemiBold" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="مالیات" Foreground="{StaticResource ErrorText}" FontWeight="SemiBold" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="مساعده کسر شده" Foreground="{StaticResource ErrorText}" FontWeight="SemiBold" TextAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="خالص (NET)" Foreground="{StaticResource SuccessText}" FontWeight="SemiBold" TextAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MinHeight="150" MaxHeight="400">
                                    <ItemsControl ItemsSource="{Binding RunLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderThickness="0,0,0,1" BorderBrush="{StaticResource BgMain}" Padding="20,16">
                                                    <Grid VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.5*"/>
                                                            <ColumnDefinition Width="1.5*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="1.5*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding FULL_NAME}" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                <TextBlock Text="کارکرد: " Foreground="{StaticResource TextLight}" FontSize="11"/>
                                                                <TextBlock Text="{Binding WORK_DAYS}" Foreground="{StaticResource Primary}" FontSize="11" FontFamily="Consolas"/>
                                                                <TextBlock Text=" روز" Foreground="{StaticResource TextLight}" FontSize="11"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="1" Text="{Binding GROSS_PAY_STR}" Foreground="{StaticResource TextMain}" FontFamily="Consolas" TextAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding INS_WORKER_STR}" Foreground="{StaticResource ErrorText}" FontFamily="Consolas" TextAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding TAX_AMOUNT_STR}" Foreground="{StaticResource ErrorText}" FontFamily="Consolas" TextAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding ADVANCE_DED_STR}" Foreground="{StaticResource ErrorText}" FontFamily="Consolas" TextAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="5" Text="{Binding NET_PAY_STR}" Foreground="{StaticResource SuccessText}" FontWeight="Bold" FontSize="16" FontFamily="Consolas" TextAlignment="Center" VerticalAlignment="Center"/>

                                                        <!-- دکمه مشاهده فیش برای هر شخص -->
                                                        <Button Grid.Column="6" Style="{StaticResource BtnGhost}" Content="فیش حقوق" Foreground="{StaticResource Primary}" Padding="12,6" Click="ViewPayslip_Click" CommandParameter="{Binding}" Margin="8,0,0,0"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <!-- Empty State: دوره باز نشده است -->
                        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Visibility="{Binding IsPeriodNotOpened, Converter={StaticResource BoolToVis}}" d:Visibility="Hidden">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40">
                                <Path Data="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" 
                                      Stroke="{StaticResource BorderColor}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeLineJoin="Round" Width="64" Height="64" Stretch="Uniform" Margin="0,0,0,16"/>
