<Window x:Class="Wins.WinMenus.SALARY.PMORAKH"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wins.WinMenus.SALARY"
        mc:Ignorable="d"
        
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        MaxHeight="{Binding Height, Source={x:Static SystemParameters.WorkArea}}"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="IRANYekanFN"
        WindowStartupLocation="CenterScreen"
        Height="750" Width="800" MinHeight="662" MinWidth="800" MaxWidth="800" Closing="Window_Closing" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="mygrid">
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="557,410,462,353"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label Content="ثبت مرخصی" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Click="Btn_Close_Click" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False">
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button IsEnabled="False" x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False">
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False">
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                                                   Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <!--HEADER↑-->

        <!--Start.......................................................................................-->
        <Button x:Name="BTN_SAVE" Content="ذخیره"  BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Margin="0,538,518,0" Height="34" VerticalAlignment="Top" HorizontalAlignment="Right" Width="114" Click="BTN_SAVE_Click" TabIndex="9" />
        <Button x:Name="ESLAH"  Content="اصلاح"  BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Margin="0,359,519,0" Height="34" VerticalAlignment="Top" HorizontalAlignment="Right" Width="99" Click="ESLAH_Click" />
        <Button x:Name="BTN_DELETE"  Content="حذف" Tag="hazfer" BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Margin="0,538,651,0" Height="34" VerticalAlignment="Top" HorizontalAlignment="Right" Width="79" Click="BTN_DELETE_Click" />
        <Label Content="شماره برگه:" HorizontalAlignment="Right" Margin="0,56,215,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <TextBox x:Name="MOLAH" Text="" Height="30" MaxLength="99" Margin="69,203,278,0"  Style="{StaticResource FuzzyOut}" Padding="3"  TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible" TabIndex="3"/>
        <CNC:NumericTextBox x:Name="minu" DoesAcceptDouble="False" NumericLostFocus="minu_NumericLostFocus" TextAlignment="Center" Height="30" Margin="460,361,0,0" VerticalAlignment="Top" Visibility="Visible"  HorizontalAlignment="Left" Width="53" TabIndex="8"/>
        <ComboBox x:Name="CODE" SelectedValuePath="CODE" DisplayMemberPath="PER" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Margin="111,92,278,0" VerticalAlignment="Top" Height="30" FlowDirection="RightToLeft" IsEditable="True"  Background="{x:Null}" BorderThickness="1" PreviewLostKeyboardFocus="CODE_PreviewLostKeyboardFocus" TabIndex="0">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>

        <xctk:MaskedTextBox x:Name="MODATE" Style="{StaticResource FuzzyOut}" Padding="3" Mask="0000/00/00" Height="30" Margin="0,129,278,0" VerticalAlignment="Top" BorderThickness="1" FontSize="12" HorizontalAlignment="Right" Width="88" PreviewMouseDoubleClick="MODATE_PreviewMouseDoubleClick" TabIndex="1" PreviewGotKeyboardFocus="MODATE_PreviewGotKeyboardFocus"/>
        <Label Content="پرسنل:" HorizontalAlignment="Right" Margin="0,93,237,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <Label Content="تاریخ درخواست:" HorizontalAlignment="Right" Margin="0,130,190,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <Label Content="نوع مرخصی:" HorizontalAlignment="Right" Margin="0,166,210,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <Label Content="توضيحات (ساعت ورود خروج):" HorizontalAlignment="Right" Margin="0,204,120,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <Label Content="تاریخ شروع:" HorizontalAlignment="Right" Margin="0,241,210,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <Label Content="تاریخ پایان:" HorizontalAlignment="Right" Margin="0,277,213,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <Label Content="دقیقه" HorizontalAlignment="Left" Margin="466,330,0,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <Label Content="ساعت" HorizontalAlignment="Left" Margin="386,330,0,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <Label Content="روز" HorizontalAlignment="Left" Margin="316,329,0,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <TextBox x:Name="IDNUM" Text="0" Height="30" Margin="401,55,278,0"  Style="{StaticResource FuzzyOut}" Padding="3"  TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible" IsReadOnly="True" />
        <ComboBox x:Name="KINDM" SelectedValuePath="ID" DisplayMemberPath="NAME" Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Margin="300,166,278,0" VerticalAlignment="Top" Height="30" FlowDirection="RightToLeft" IsEditable="True"  Background="{x:Null}" BorderThickness="1" PreviewLostKeyboardFocus="KINDM_PreviewLostKeyboardFocus" TabIndex="2">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <xctk:MaskedTextBox x:Name="MOSTDATE" Style="{StaticResource FuzzyOut}" Padding="3" Mask="0000/00/00" Height="30" Margin="0,240,278,0" VerticalAlignment="Top" BorderThickness="1" FontSize="12" HorizontalAlignment="Right" Width="88" PreviewLostKeyboardFocus="MOSTDATE_PreviewLostKeyboardFocus" TabIndex="4" PreviewGotKeyboardFocus="MOSTDATE_PreviewGotKeyboardFocus"/>
        <xctk:MaskedTextBox x:Name="MOENDATE" Style="{StaticResource FuzzyOut}" Padding="3" Mask="0000/00/00" Height="30" Margin="0,277,278,0" VerticalAlignment="Top" BorderThickness="1" FontSize="12" HorizontalAlignment="Right" Width="88" PreviewLostKeyboardFocus="MOENDATE_PreviewLostKeyboardFocus" TabIndex="5" PreviewGotKeyboardFocus="MOENDATE_PreviewGotKeyboardFocus"/>
        <CNC:NumericTextBox x:Name="HOU" DoesAcceptDouble="False" TextAlignment="Center" Height="30" Margin="379,361,0,0" VerticalAlignment="Top" Visibility="Visible"  HorizontalAlignment="Left" Width="54" NumericLostFocus="HOU_NumericLostFocus" TabIndex="7"/>
        <CNC:NumericTextBox x:Name="DA" DoesAcceptDouble="False" TextAlignment="Center" Height="30" Margin="300,361,0,0" VerticalAlignment="Top" Visibility="Visible"  HorizontalAlignment="Left" Width="54" NumericLostFocus="DA_NumericLostFocus" TabIndex="6"/>
        <Label Content="مرخصی درخواستی:" HorizontalAlignment="Right" Margin="0,360,178,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <Label Content="مانده مرخصی:" HorizontalAlignment="Right" Margin="0,402,202,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <CNC:NumericTextBox x:Name="MMINU" DoesAcceptDouble="False" TextAlignment="Center" Height="30" Margin="460,402,0,0" VerticalAlignment="Top" Visibility="Visible"  HorizontalAlignment="Left" Width="53" IsReadOnly="True"/>
        <CNC:NumericTextBox x:Name="MHOU" DoesAcceptDouble="False" TextAlignment="Center" Height="30" Margin="380,402,0,0" VerticalAlignment="Top" Visibility="Visible"  HorizontalAlignment="Left" Width="53" IsReadOnly="True"/>
        <CNC:NumericTextBox x:Name="MDA" DoesAcceptDouble="False" TextAlignment="Center" Height="30" Margin="301,402,0,0" VerticalAlignment="Top" Visibility="Visible"  HorizontalAlignment="Left" Width="53" IsReadOnly="True"/>
        <Label Content="مرخصی به دقیقه:" HorizontalAlignment="Right" Margin="0,441,183,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <Label Content="مانده مرخصی به دقیقه:" HorizontalAlignment="Right" Margin="0,480,153,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
        <TextBox x:Name="MORAKHDAY" Text="" Height="30" Margin="301,441,287,0"  Style="{StaticResource FuzzyOut}" Padding="3"  TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible" IsReadOnly="True" />
        <TextBox x:Name="MAND" Text="" Height="30" Margin="301,479,287,0"  Style="{StaticResource FuzzyOut}" Padding="3"  TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible" IsReadOnly="True" />
        <Button x:Name="BTN_CHAP"  Content="چاپ برگه"  BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Margin="0,359,628,0" Height="34" VerticalAlignment="Top" HorizontalAlignment="Right" Width="103" Click="BTN_CHAP_Click" />
        <TextBlock Margin="70,238,375,0" Padding="5" TextWrapping="Wrap" TextAlignment="Justify" FlowDirection="RightToLeft" Text="نحوه محاسبه مرخصی: هر کارمند سالانه  26 روز مرخصی دارد که تقسیم بر 365 روز سال = مرخصی یک روز کارکرد. این عدد ضربدر روزهای کارکرد که در ثبت و ویرایش کارکرد پرسنل  ثبت شده است میشود میزان مرخصی کارمند.جمعه ها حساب نمیشوند . " Foreground="#E5A90000" Height="93" VerticalAlignment="Top"/>
        <CheckBox x:Name="OKF" Content="تایید" Foreground="{Binding ElementName=GENERAL_RANG,Path=Background}" HorizontalAlignment="Left" Margin="343,59,0,0" VerticalAlignment="Top" Width="49" Padding="4,-1,0,0" IsChecked="False" IsHitTestVisible="False"/>
        <CheckBox x:Name="SGN1" IsChecked="False"  Content="درخواست کننده" Margin="0,0,13,149" Height="23" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="109" Click="SGN1_Click">
        </CheckBox>
        <CheckBox x:Name="SGN2" Content="مدیر واحد" IsChecked="False"  Margin="0,0,40,117" HorizontalAlignment="Right" Width="82" Height="23" VerticalAlignment="Bottom" Click="SGN2_Click">
        </CheckBox>
        <CheckBox x:Name="SGN3" Content="مدیر عامل" IsChecked="False"  Margin="0,0,40,84" HorizontalAlignment="Right" Width="82" Height="23" VerticalAlignment="Bottom" Click="SGN3_Click">
        </CheckBox>
        <TextBox x:Name="SGN1usid"   Style="{StaticResource FuzzyOut}" Padding="3"  Margin="0,0,125,146" VerticalAlignment="Bottom" Height="28" FlowDirection="RightToLeft" HorizontalAlignment="Right" Width="191" IsReadOnly="True"/>
        <TextBox x:Name="SGN2usid"   Style="{StaticResource FuzzyOut}" Padding="3"  Margin="0,0,125,113" VerticalAlignment="Bottom" Height="28" FlowDirection="RightToLeft" HorizontalAlignment="Right" Width="191" IsReadOnly="True"/>
        <TextBox x:Name="SGN3usid"   Style="{StaticResource FuzzyOut}" Padding="3"  Margin="0,0,125,81" VerticalAlignment="Bottom" Height="28" FlowDirection="RightToLeft"  HorizontalAlignment="Right" Width="191" IsReadOnly="True"/>
        <Label Content="ارجاع به:" Margin="0,0,338,82"  FlowDirection="RightToLeft" FontSize="10" HorizontalAlignment="Right" Width="44" Height="26" VerticalAlignment="Bottom"/>
        <ComboBox x:Name="PERSONEL"  Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}" IsTextSearchEnabled="True" Margin="70,0,384,81" Height="28" FlowDirection="RightToLeft" IsEditable="True"  Background="{x:Null}" BorderThickness="1" SelectionChanged="PERSONEL_SelectionChanged" VerticalAlignment="Bottom">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <Button x:Name="BTN_MORAKH_LST" Content="لیست مرخصی های من"  BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Margin="0,419,518,0" Height="34" VerticalAlignment="Top" HorizontalAlignment="Right" Width="212" Click="BTN_MORAKH_LST_Click" />
        <Button x:Name="BTN_MYDAYOFF"  Content="مانده مرخصی من صرفا تا امروز" BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Margin="0,476,518,0" Height="34" VerticalAlignment="Top" HorizontalAlignment="Right" Width="212" Click="BTN_MYDAYOFF_Click" />
        <Button x:Name="BTN_NEWDAYOFF" Content="ثبت مرخصی جدید"  BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Margin="0,541,486,0" Height="34" VerticalAlignment="Top" HorizontalAlignment="Right" Width="134" Click="BTN_NEWDAYOFF_Click" Visibility="Collapsed" />

        <Popup x:Name="MANDDAYOFF_POP" IsOpen="False" Placement="Center" PopupAnimation="Fade" StaysOpen="True" AllowsTransparency="True"  Width="400" Height="200">
            <Border BorderThickness="1,1,1,1" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}" CornerRadius="5" Margin="10">
                <Grid Background="White" Margin="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" CornerRadius="5" Margin="5,5,5,5">
                        <StackPanel FlowDirection="RightToLeft">
                            <TextBlock x:Name="TEXTB_POP" TextAlignment="Justify" TextWrapping="Wrap" Margin="5"/>
                            <UniformGrid Rows="1" Columns="3" Height="30" >
                                <Label Content="دقیقه" HorizontalContentAlignment="Center"/>
                                <Label Content="ساعت" HorizontalContentAlignment="Center"/>
                                <Label Content="روز"  HorizontalContentAlignment="Center"/>
                            </UniformGrid>
                            <UniformGrid Rows="1" Columns="3" Height="32">
                                <CNC:NumericTextBox x:Name="SEE_MINUT" IsReadOnly="True"   DoesAcceptDouble="False" NumericLostFocus="minu_NumericLostFocus" TextAlignment="Center" Height="30" Text=""/>
                                <CNC:NumericTextBox x:Name="SEE_HOUR"  IsReadOnly="True"   DoesAcceptDouble="False" NumericLostFocus="minu_NumericLostFocus" TextAlignment="Center" Height="30" Text=""/>
                                <CNC:NumericTextBox x:Name="SEE_DAY"   IsReadOnly="True"   DoesAcceptDouble="False" NumericLostFocus="minu_NumericLostFocus" TextAlignment="Center" Height="30" Text=""/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Button Grid.Row="1" x:Name="BTN_DAYOFFPOP" FontSize="12" Style="{StaticResource MaterialDesignFlatButton}" Click="BTN_DAYOFFPOP_Click" Content="بستن" Margin="2" Height="34" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
        </Popup>

        <Button x:Name="End" Tag ="RD" Click="End_Click" Style="{StaticResource GerdB}" BorderBrush="{x:Null}"
                                    RenderTransformOrigin="0.5,0.5"  FontSize="10" Margin="0,0,302,23" Height="26" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="34">
            <materialDesign:PackIcon  Kind="SkipNext"  HorizontalAlignment="Center" VerticalAlignment="Center" Height="20" Width="21" Foreground="#CCFFFFFF" RenderTransformOrigin="0.206,0.45"  FontSize="10" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="26,-44,0,0" Margin="-19,0,-18,0">
                <materialDesign:PackIcon.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </materialDesign:PackIcon.RenderTransform>
            </materialDesign:PackIcon>
        </Button>
        <Button x:Name="First" Click="First_Click"  Tag ="RD"  Style="{StaticResource GerdB}" BorderBrush="{x:Null}"
                                    RenderTransformOrigin="0.5,0.5"  FontSize="10" Margin="0,0,498,23" HorizontalAlignment="Right" Width="34" Height="26" VerticalAlignment="Bottom">
            <materialDesign:PackIcon Kind="SkipNext"  HorizontalAlignment="Right" VerticalAlignment="Top" Height="20" Width="23" Foreground="#CCFFFFFF" RenderTransformOrigin="0.515,0.533"  FontSize="10" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="-30,-1,-5,0">
                <materialDesign:PackIcon.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="-1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform X="4.946"/>
                    </TransformGroup>
                </materialDesign:PackIcon.RenderTransform>
            </materialDesign:PackIcon>
        </Button>
        <Button x:Name="Next" Click="Next_Click" Tag ="RD" Style="{StaticResource GerdB}" BorderBrush="{x:Null}"
                                    RenderTransformOrigin="0.5,0.5"  FontSize="10" Margin="0,0,344,23"  Height="26" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="34">
            <materialDesign:PackIcon Kind="triangle"  HorizontalAlignment="Center" VerticalAlignment="Center" Height="15" Width="15" Foreground="#CCFFFFFF" RenderTransformOrigin="0.254,0.083"  FontSize="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0" Margin="-24,-13,-32,0">
                <materialDesign:PackIcon.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                        <SkewTransform/>
                        <RotateTransform Angle="90"/>
                        <TranslateTransform X="5" Y="10"/>
                    </TransformGroup>
                </materialDesign:PackIcon.RenderTransform>
            </materialDesign:PackIcon>
        </Button>
        <Button x:Name="Back"  Tag ="RD" Click="Back_Click" Style="{StaticResource GerdB}" BorderBrush="{x:Null}"
                                    RenderTransformOrigin="0.5,0.5"  FontSize="10" Margin="0,0,458,23" HorizontalAlignment="Right" Width="34"  Height="26" VerticalAlignment="Bottom">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Button.RenderTransform>
            <materialDesign:PackIcon  Kind="triangle"  HorizontalAlignment="Center" VerticalAlignment="Center" Height="15" Width="15" Foreground="#CCFFFFFF" RenderTransformOrigin="0.254,0.083"  FontSize="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0" Margin="-24,-13,-32,0">
                <materialDesign:PackIcon.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                        <SkewTransform/>
                        <RotateTransform Angle="90"/>
                        <TranslateTransform X="5" Y="10"/>
                    </TransformGroup>
                </materialDesign:PackIcon.RenderTransform>
            </materialDesign:PackIcon>
        </Button>
        <Button x:Name="NEWRECORD_BTN" Click="NEWRECORD_BTN_Click"  Tag ="RD" Style="{StaticResource GerdB}" BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="10"  Margin="0,0,262,23" Height="26" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="34">
            <materialDesign:PackIcon Kind="AddBold"  HorizontalAlignment="Center" VerticalAlignment="Center" Height="15" Width="15" Foreground="#CCFFFFFF" RenderTransformOrigin="0.254,0.083"  FontSize="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0" Margin="-24,-13,-32,0">
                <materialDesign:PackIcon.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                        <SkewTransform/>
                        <RotateTransform Angle="90"/>
                        <TranslateTransform X="5" Y="10"/>
                    </TransformGroup>
                </materialDesign:PackIcon.RenderTransform>
            </materialDesign:PackIcon>
        </Button>
        <TextBox x:Name="RecCount"  HorizontalContentAlignment="Center" TextAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource FuzzyOut}" IsReadOnly="True" Tag="RD" Padding="7,0,10,0" Margin="0,0,185,21" VerticalAlignment="Bottom" FlowDirection="RightToLeft" Background="{x:Null}" BorderThickness="1" Height="30" HorizontalAlignment="Right" Width="72" />
        <TextBox x:Name="Current_Rec"   HorizontalContentAlignment="Center" TextAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource FuzzyOut}" IsReadOnly="True" Tag="RD" Padding="7,0,10,0" Margin="0,0,383,21" VerticalAlignment="Bottom" FlowDirection="RightToLeft" Background="{x:Null}" BorderThickness="1" Height="30" HorizontalAlignment="Right" Width="72" />
        <Button x:Name="SERVERRELOAD_Btn" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Tag ="RD"  Style="{StaticResource GerdB}" BorderBrush="{x:Null}"  FontSize="10" Margin="0,0,537,23" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="#DDFFFFFF" Height="26" Width="34" Click="SERVERRELOAD_Btn_Click">
            <Viewbox Margin="-9,0,-9,0" >
                <materialDesign:PackIcon Kind="Refresh" />
            </Viewbox>
        </Button>

    </Grid>
</Window>
