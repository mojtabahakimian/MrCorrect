<Window x:Class="Prg_UI.Wins.WinMenus.MANAGE_DASHBOARD.BUDGET.BUDGET0"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinMenus.MANAGE_DASHBOARD.BUDGET"
        mc:Ignorable="d"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        FontFamily="{StaticResource IRANYEKAN}"
        Background="{x:Null}" AllowsTransparency="True"
        AllowDrop="True"
        Height="528" Width="1033" WindowStyle="None" MinWidth="1033" MinHeight="528" Margin="0" Loaded="Window_Loaded" WindowStartupLocation="CenterScreen" ContentRendered="Window_ContentRendered" >
    <Window.Resources>
        <ControlTemplate TargetType="{x:Type Button}" x:Key="ButtonTemplateRed">
            <Border x:Name="RootElement">
                <Border.Background>
                    <SolidColorBrush x:Name="BorderBrush" Color="Black" />
                </Border.Background>

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="MouseOver">
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetName="ButtonBackground"
                                    Storyboard.TargetProperty="Color" To="Red" />
                            </Storyboard>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <Storyboard>
                                <ColorAnimation Storyboard.TargetName="ButtonBackground"
                                    Storyboard.TargetProperty="Color" To="Red" />
                            </Storyboard>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>

                <Grid x:Name="mygrid">
                    <Grid.Background>
                        <SolidColorBrush x:Name="ButtonBackground" Color="Black" />
                    </Grid.Background>
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="4,5,4,4" />
                </Grid>
            </Border>
        </ControlTemplate>
        <Style x:Key="FocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Margin="2" SnapsToDevicePixels="true" Stroke="{StaticResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="1" StrokeDashArray="1 2"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="Button.Static.Background" Color="#FFDDDDDD"/>
        <SolidColorBrush x:Key="Button.Static.Border" Color="#FF707070"/>
        <SolidColorBrush x:Key="Button.MouseOver.Background" Color="#FFBEE6FD"/>
        <SolidColorBrush x:Key="Button.MouseOver.Border" Color="#FF3C7FB1"/>
        <SolidColorBrush x:Key="Button.Pressed.Background" Color="#FFC4E5F6"/>
        <SolidColorBrush x:Key="Button.Pressed.Border" Color="#FF2C628B"/>
        <SolidColorBrush x:Key="Button.Disabled.Background" Color="#FFF4F4F4"/>
        <SolidColorBrush x:Key="Button.Disabled.Border" Color="#FFADB2B5"/>
        <SolidColorBrush x:Key="Button.Disabled.Foreground" Color="#FF838383"/>
        <Style x:Key="RONDBtn" TargetType="{x:Type Button}">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
            <Setter Property="Background" Value="{StaticResource Button.Static.Background}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Button.Static.Border}"/>
            <Setter Property="Foreground" Value="{StaticResource {x:Static SystemColors.ControlTextBrushKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="border" CornerRadius="18,18,18,18" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" SnapsToDevicePixels="true">
                            <ContentPresenter x:Name="contentPresenter" Focusable="False" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsDefaulted" Value="true">
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource {x:Static SystemColors.HighlightBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter Property="Background" TargetName="border" Value="{StaticResource Button.MouseOver.Background}"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.MouseOver.Border}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="true">
                                <Setter Property="Background" TargetName="border" Value="{StaticResource Button.Pressed.Background}"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.Pressed.Border}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter Property="Background" TargetName="border" Value="{StaticResource Button.Disabled.Background}"/>
                                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource Button.Disabled.Border}"/>
                                <Setter Property="TextElement.Foreground" TargetName="contentPresenter" Value="{StaticResource Button.Disabled.Foreground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
    <Grid>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding ElementName=GENERAL_RANG,Path=Background}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding ElementName=GENERAL_RANG,Path=Background}" Margin="-7.999,-7.928,-8,0" VerticalAlignment="Top" MinHeight="50" UseLayoutRounding="False" Height="52" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid/>
            </Border>
        </Border>
        <Label x:Name="lbl_budget" Content="بودجه" Height="68" Style="{StaticResource LBLG}" HorizontalContentAlignment="Center" VerticalAlignment="Top" FontWeight="Bold" FontSize="20" VerticalContentAlignment="Center" Margin="0,52,1,0"  MouseLeftButtonDown="lbl_budget_MouseLeftButtonDown" Foreground="{Binding Background, ElementName=GENERAL_RANG}"/>
        <TextBlock Margin="350,249,48,0"  TextWrapping="Wrap" LineHeight="22" TextAlignment="Center" Padding="0" FlowDirection="RightToLeft"  Height="123" VerticalAlignment="Top"><Run Text="همونطور که میدونید اساس بودجه , پیش بینی آینده است .فقط کافیه پیش بینی میزان فروش دوره هایی که  Mr CORRECT  ازتون میخواد , بهش بدین مابقی محاسباتش با  Mr CORRECT  "/><LineBreak/><Run/><LineBreak/><Run Text="راستی اگر تو روند فروش نسبت به ماه ها یا دوره های قبل تفاوتی ایجاد شده از طریق قسمت پیش فرض ها میتونیین اونا رو اصلاح کنید. "/></TextBlock>
        <Button x:Name="Command4" Content="شروع" Margin="481,436,420,54"   Style="{StaticResource GerdC}" Width="130" Height="37" Click="Command4_Click" BorderBrush="{x:Null}" TabIndex="0" Foreground="#DDFFFFFF" FontSize="12"/>
        <xctk:MaskedTextBox  x:Name="TextBM_Date_N"  Style="{StaticResource MaterialDesignOutlinedTextBox}" Padding="3"  Mask="0000/00/00" IsReadOnly="True" HorizontalAlignment="Left" Height="22" Margin="871,76,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="73"  BorderThickness="0" TabIndex="0" FontSize="12" />
        <TextBlock HorizontalAlignment="Left" Margin="942,76,0,0" TextWrapping="Wrap" TextAlignment="Justify"  Text="تاریخ محاسبه :" VerticalAlignment="Top" Height="25" Width="75"  FlowDirection="RightToLeft" FontSize="12" Style="{StaticResource TxBLOCK}" />
        <TextBlock Margin="382,208,121,0"  TextWrapping="Wrap" LineHeight="22" TextAlignment="Center" Padding="0" FontSize="14" FlowDirection="RightToLeft"  Height="23" VerticalAlignment="Top"><Run Text="سلام  به برنامه بودجه Mr CORRECT خوش آمدید ."/></TextBlock>
        <Image x:Name="imgBudget0" Margin="32,186,719,119" Stretch="None" Source="/UiDrive/IMGS/budget.jpg"/>
        <TextBlock x:Name="blk" Margin="350,377,48,0"  TextWrapping="Wrap" LineHeight="22" TextAlignment="Center" Padding="0" FlowDirection="RightToLeft"  Height="32" VerticalAlignment="Top"><Run FlowDirection="RightToLeft" Text="اگر اماده اید کلید شروع را بزنید"/></TextBlock>
        <Label x:Name="cnnparamlbl" Foreground="{Binding ElementName=blk,Path=Foreground}" Visibility="Hidden" Content="اتصال به دیتابیس" Margin="10,488,903,10"   FontSize="14" TabIndex="1" PreviewMouseLeftButtonUp="cnnparamlbl_PreviewMouseLeftButtonUp"/>
        <Label x:Name="preloader" HorizontalContentAlignment="Center" d:Visibility="Hidden" VerticalContentAlignment="Center" Content=" . . . در حال آماده سازی" Margin="0,52,0,0"  FontSize="40" Foreground="WhiteSmoke">
            <Label.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF20BFA9" Offset="1"/>
                    <GradientStop Color="#FF01BAEF"/>
                </LinearGradientBrush>
            </Label.Background>
        </Label>


        <Button x:Name="Btn_Close" Margin="0,15,15,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="18" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
            <Button.Content>
                <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
            </Button.Content>
        </Button>
        <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,15,44,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="18" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
            <Button.Content>
                <materialDesign:PackIcon Kind="WindowRestore" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
            </Button.Content>
        </Button>
        <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,15,73,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="18" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
            <Button.Content>
                <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
            </Button.Content>
        </Button>
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="95,56,0,0"  Width="1"/>
    </Grid>
</Window>
