<Window x:Class="Prg_UI.Wins.WinSamplesEmpty.WinRealExampleSfDG"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinSamplesEmpty"
        mc:Ignorable="d"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
        xmlns:sfusion="clr-namespace:Syncfusion.UI.Xaml.Grid;assembly=Syncfusion.SfGrid.WPF"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        FontFamily="{StaticResource IRANYEKAN}"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        WindowState="Maximized"
        Title="" Height="415" Width="1024" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>
        <!-- Style for SfDataGrid -->
        <Style x:Key="KDG"  TargetType="syncfusion:SfDataGrid" BasedOn="{StaticResource SfDataGridStyle}">
            <Setter Property="CurrentCellBorderBrush" Value="{StaticResource GENERAL_Grlicom}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="BorderBrush" Value="{StaticResource MaterialDesignDivider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="RowHeight" Value="32" />
            <Setter Property="HeaderRowHeight" Value="40" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="GridLinesVisibility" Value="Both" />
        </Style>
        <!-- Modified Column Header Style -->
        <Style x:Key="KDGHeader" TargetType="syncfusion:GridHeaderCellControl" BasedOn="{StaticResource GridHeaderCellControlStyle}">
            <Setter Property="Background" Value="{StaticResource MaterialDesign.Brush.Background}" />
            <Setter Property="Foreground" Value="{StaticResource MaterialDesignBody}" />
            <Setter Property="BorderBrush" Value="{Binding Background, ElementName=GENERAL_RANG}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="Auto"/>
        </Style>

        <Style TargetType="sfusion:GridCell" BasedOn="{StaticResource GridCellStyle}">
            <Setter Property="BorderBrush" Value="{Binding BorderBrush, ElementName=GENERAL_RANG}" />
        </Style>
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="mygrid">
        <Border Background="{DynamicResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5"  Grid.ColumnSpan="5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{DynamicResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label x:Name="Label_hesab" Content="کدینگ" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="95,56,0,0" Opacity="0.2" Width="1"/>
        <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
            <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
        </Button>
        <!--EndOfHeader ↑-->
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True" Grid.RowSpan="2">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                             Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>

        <syncfusion:SfDataGrid x:Name="SYNCFUSION_DG"
                               FlowDirection="RightToLeft"
                               d:ItemsSource="{d:SampleData ItemCount=5}"
                               Margin="10,49,10,10"
                               Style="{StaticResource KDG}"
                               HeaderStyle="{StaticResource KDGHeader}"
                               ItemsSource="{Binding SFDG_DATA}" 
                               AllowRowHoverHighlighting="True" 
                               AllowSelectionOnPointerPressed="True" 
                               ScrollMode="Async" 
                               ShowRowHeader="True" 
                               ShowGroupDropArea="True"
                               AutoGenerateColumns="False"
                               AllowEditing="True"
                               EnableDataVirtualization="True"
                               SelectionUnit="Row"
                               SelectionMode="Extended"
                               AllowDraggingColumns="True"
                               AllowResizingColumns="True"
                               AllowFiltering="True"
                               AllowDeleting="True"
                               AllowSorting="True"
                               RowHeight="35"
                               FrozenColumnCount="0"
                               
                               PreviewKeyDown="SYNCFUSION_DG_PreviewKeyDown"
                               SelectionChanged="SYNCFUSION_DG_SelectionChanged"
                               PreviewMouseRightButtonDown="SYNCFUSION_DG_PreviewMouseRightButtonDown"
                               CurrentCellActivated="SYNCFUSION_DG_CurrentCellActivated"
                               
                               KeyboardNavigation.TabNavigation="Contained"
                               KeyboardNavigation.ControlTabNavigation="Contained"
                               
                               RowValidating="TCOD_MAP_SUB_RowValidating"
                               RowValidated="TCOD_MAP_SUB_RowValidated"
                               CurrentCellBeginEdit="TCOD_MAP_SUB_CurrentCellBeginEdit"
                               CurrentCellEndEdit="TCOD_MAP_SUB_CurrentCellEndEdit"
                               RecordDeleting="TCOD_MAP_SUB_RecordDeleting"
                               RecordDeleted="TCOD_MAP_SUB_RecordDeleted"
                               
                               NavigationMode="Cell"
                               AddNewRowPosition="Bottom"
                               GridValidationMode="InEdit" 
                               GroupDropAreaText="برای گروه‌بندی، سربرگ ستون را به اینجا بکشید"
                               GridLinesVisibility="Horizontal"
                               >
            <syncfusion:SfDataGrid.Resources>
                <ResourceDictionary>
                    <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                        <Setter Property="Height" Value="35" />
                    </Style>
                </ResourceDictionary>
            </syncfusion:SfDataGrid.Resources>

            <syncfusion:SfDataGrid.AddNewRowText>
                برای سطر جدید دابل کلیک کنید
            </syncfusion:SfDataGrid.AddNewRowText>

            <syncfusion:SfDataGrid.Columns>
                <syncfusion:GridComboBoxColumn x:Name="MPP_COLUMN" MappingName="MPP" HeaderText="کد گروه" Width="150" DisplayMemberPath="MPNAME" SelectedValuePath="MPP" IsEditable="True"/>
                <syncfusion:GridNumericColumn MappingName="MPCODE" TextAlignment="Left" HeaderText="کد" Width="100" NumberDecimalDigits="0">
                    <!--<syncfusion:GridNumericColumn.CellStyle>
                        <Style TargetType="sfusion:GridCell" BasedOn="{StaticResource GridCellStyle}">
                            <Setter Property="HorizontalContentAlignment" Value="Right"/>
                            <Setter Property="FlowDirection" Value="LeftToRight"/>
                            <Setter Property="Padding" Value="5,0,5,0"/>
                        </Style>
                    </syncfusion:GridNumericColumn.CellStyle>-->
                </syncfusion:GridNumericColumn>
                <syncfusion:GridTextColumn x:Name="MPNAME_COLUMN" HeaderText="نام" MappingName="MPNAME" Width="200" />

                <!--<syncfusion:GridTemplateColumn HeaderText="MPNAME GridTemplateColumn"  MappingName="MPNAME" Width="250">
                    <syncfusion:GridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding MPNAME}" Padding="4,0,4,0" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.CellTemplate>
                    <syncfusion:GridTemplateColumn.EditTemplate>
                        <DataTemplate>
                            <TextBox Text="{Binding MPNAME, UpdateSourceTrigger=LostFocus}" Loaded="txtMPName_Loaded"
                                     MaxLength="50"
                                     VerticalContentAlignment="Center"
                                     BorderThickness="0"/>
                        </DataTemplate>
                    </syncfusion:GridTemplateColumn.EditTemplate>
                </syncfusion:GridTemplateColumn>-->


            </syncfusion:SfDataGrid.Columns>
        </syncfusion:SfDataGrid>
    </Grid>
</Window>
