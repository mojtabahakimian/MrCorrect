<Window x:Class="Wins.WinSetting.F_USER_PERMITION_FORMS"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wins.WinSetting"
        mc:Ignorable="d"

        MaxHeight="{Binding Height, Source={x:Static SystemParameters.WorkArea}}"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"

        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        FontFamily="{StaticResource IRANYEKAN}"
        WindowStartupLocation="CenterScreen"
        Title="تعیین سطح دسترسی" Height="600" Width="1024" ContentRendered="Window_ContentRendered" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <ItemsPanelTemplate x:Key="VSP">
            <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </ItemsPanelTemplate>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>

        <ContextMenu x:Key="ContextUtilityMenu1" FontSize="12" FontFamily="{StaticResource IRANYEKAN}">
            <MenuItem Header="کپـــی | Copy" Click="COPY_CLICK" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="ContentCopy" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="انتقال کپی | Paste" Click="PASTE_CLICK" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="ContentPaste" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator/>
            <MenuItem Header="خروجی اکسل" Click="EXPORTEXCEL_BTN" >
                <MenuItem.Icon>
                    <materialDesign:PackIcon Kind="FileExcelOutline" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <Style TargetType="{x:Type TabControl}" BasedOn="{StaticResource MaterialDesignTabControl}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <!-- Row for the tab headers -->
                                <RowDefinition Height="Auto"/>
                                <!-- Row for the tab content -->
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <!-- Wrap the TabPanel inside a ScrollViewer -->
                            <ScrollViewer Grid.Row="0"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled"
                                      CanContentScroll="True">
                                <TabPanel x:Name="HeaderPanel"
                                      IsItemsHost="True"
                                      Margin="2,2,2,0"
                                      Background="Transparent"/>
                            </ScrollViewer>
                            <!-- Content presenter for the selected tab content -->
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          ContentSource="SelectedContent"
                                          Focusable="False"
                                          Grid.Row="1"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="mygrid">
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="557,410,462,353"  Width="1"/>
        <Border Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="38" UseLayoutRounding="False" Height="10" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Label x:Name="HEADWIN_LABEL" Content="تعیین سطح دسترسی" Padding="21,10,10,10" Foreground="White" Margin="0,0,110,0"/>
                    <Button x:Name="Btn_Close" Margin="0,10,13,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,10,70,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,10,41,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right"  Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowMaximize" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Relative"  Focusable="False" PlacementTarget="{Binding ElementName=TitleDrawBar}" StaysOpen="True">
            <StackPanel  Width="{Binding ActualWidth, ElementName=mygrid, Mode=OneWay}">
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#F20584AA" Height="84">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                                                       Text="محل نمایش اعلان های سیستم" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>
        <!--HEADER↑-->
        <!--Start.......................................................................................-->

        <TabControl Margin="10,46,10,10" SelectionChanged="TabControl_SelectionChanged">
            <TabItem Header="مجوز" x:Name="Page52" IsSelected="True">
                <Grid>
                    <Border BorderThickness="1,1,1,1" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}" CornerRadius="5" Margin="302,109,10,195">

                        <ListBox x:Name="PermissionListBox" IsEnabled="False" Cursor="Hand" FlowDirection="RightToLeft" ItemsSource="{Binding PERMISIONS_DATA, UpdateSourceTrigger=PropertyChanged,IsAsync=True}" SelectionMode="Single" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionChanged="PermissionListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ItemCheckBox" 
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                  VerticalAlignment="Center"
                                                  Margin="5,0,5,0"/>
                                        <TextBlock Text="{Binding CAPTION}" 
                                                   Grid.Column="1" 
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>

                    <Button x:Name="BTN_USERS_PERMIS" Content="چاپ دسترسی کاربر" Click="BTN_USERS_PERMIS_Click" BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Margin="10,0,0,150" HorizontalAlignment="Left" Width="126" VerticalAlignment="Bottom" Height="34"/>
                    <Label Content="منو ها و عملیات ها:" Cursor="Hand" HorizontalAlignment="Right" Margin="0,13,10,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
                    <TextBox x:Name="srch" Text="" Height="30" Margin="302,13,118,0"  Style="{StaticResource FuzzyOut}" Padding="3"  TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible" MaxLength="48" TextChanged="srch_TextChanged" />
                    <TextBox x:Name="serus" Text="" Height="30" Margin="10,13,0,0"  Style="{StaticResource FuzzyOut}" Padding="3"  TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible" MaxLength="48" HorizontalAlignment="Left" Width="253" TextChanged="serus_TextChanged" />


                    <Button x:Name="BTN_ITEM_PERCHAP" Content="چاپ دسترسی آیتم"  BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Margin="141,0,0,150" HorizontalAlignment="Left" Width="122" Click="BTN_ITEM_PERCHAP_Click" VerticalAlignment="Bottom" Height="34" IsEnabled="False">


                    </Button>
                    <Button x:Name="BTN_MAKE_ACTIVE_ALL"  Content="همه فعال"  BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Margin="302,0,0,148"  HorizontalAlignment="Left" Width="98" VerticalAlignment="Bottom" Click="BTN_MAKE_ACTIVE_ALL_Click" Height="34" />
                    <Button x:Name="BTN_MAKE_DEACTIVE_ALL"  Content="همه غیر فعال"  BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Margin="302,0,0,98"  HorizontalAlignment="Left" Width="100" VerticalAlignment="Bottom" Click="BTN_MAKE_DEACTIVE_ALL_Click" Height="34" />
                    <Button x:Name="BTN_SAVE" Click="BTN_SAVE_Click" Content="ذخیره دسترسی ها"  BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Margin="0,0,6,103" Height="34" VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="126" />
                    <CheckBox x:Name="read"   FlowDirection="RightToLeft" IsEnabled="false" IsChecked="{Binding ElementName=PermissionListBox,Path=SelectedItem.SEE,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Content="مشاهده داده ها" Margin="0,0,256,155" Height="24" VerticalAlignment="Bottom" HorizontalAlignment="Right" Cursor="Hand" Click="read_Click"/>
                    <CheckBox x:Name="insert" FlowDirection="RightToLeft" IsEnabled="false" IsChecked="{Binding ElementName=PermissionListBox,Path=SelectedItem.INP,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Content="اضافه کردن داده ها (ورود داده)" Margin="0,0,374,110" Height="24" VerticalAlignment="Bottom" HorizontalAlignment="Right" Cursor="Hand" Click="insert_Click"/>
                    <CheckBox x:Name="update" FlowDirection="RightToLeft" IsEnabled="false" IsChecked="{Binding ElementName=PermissionListBox,Path=SelectedItem.UPD,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Content="تغییر داده ها (بهنگام سازی)" Margin="0,0,170,110" Height="24" VerticalAlignment="Bottom" HorizontalAlignment="Right" Cursor="Hand" Click="update_Click"/>
                    <CheckBox x:Name="delete" FlowDirection="RightToLeft" IsEnabled="false" IsChecked="{Binding ElementName=PermissionListBox,Path=SelectedItem.DEL,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Content="حذف داده ها" Margin="0,0,374,156" Height="22" VerticalAlignment="Bottom" HorizontalAlignment="Right" Cursor="Hand" Click="delete_Click"/>
                    <CheckBox x:Name="runn"   FlowDirection="RightToLeft" IsEnabled="false" IsChecked="{Binding ElementName=PermissionListBox,Path=SelectedItem.RUN,UpdateSourceTrigger=PropertyChanged,Mode=TwoWay}" Content="اجرا" Margin="0,0,170,155" Height="24" VerticalAlignment="Bottom" HorizontalAlignment="Right" Cursor="Hand" Click="runn_Click"/>

                    <Button x:Name="BTN_UNDO" Content="بازگشت حالت اولیه دسترسی ها" Click="BTN_UNDO_Click" Visibility="Collapsed" BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Margin="10,0,0,98" HorizontalAlignment="Left" Width="253" Height="34" VerticalAlignment="Bottom" />
                    <Label Content="منو ها و عملیات ها:" HorizontalAlignment="Right" Margin="0,0,6,154" VerticalAlignment="Bottom" FlowDirection="RightToLeft" Width="auto"/>

                    <Border BorderThickness="1,1,1,1" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}" CornerRadius="5" Margin="10,109,0,195" HorizontalAlignment="Left" Width="253">
                        <ListBox x:Name="UserListBox" Cursor="Hand" FlowDirection="RightToLeft" ItemsSource="{Binding ALL_USERS, IsAsync=True, UpdateSourceTrigger=PropertyChanged}" SelectionMode="Single" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionChanged="UserListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ItemCheckBox" 
                                            IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                            VerticalAlignment="Center"
                                            Margin="5,0,5,0"/>
                                        <TextBlock Text="{Binding SAL_NAME}" 
                                            Grid.Column="1" 
                                            VerticalAlignment="Center"/>
                                    </Grid>

                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>
                    <Label Content="کاربر:" HorizontalAlignment="Left" Margin="263,14,0,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>
                    <Button x:Name="BTN_SELECT_ALLUSER" Content="انتخاب همه کاربران" IsEnabled="False" Style="{StaticResource MaterialDesignFlatButton}" FontSize="10" Margin="10,78,0,0" Click="BTN_SELECT_ALLUSER_Click" VerticalAlignment="Top" Height="28" HorizontalAlignment="Left" Width="253"/>
                    <Button x:Name="BTN_SELECT_ALLPERMIS" Content="انتخاب همه دسترسی ها" Style="{StaticResource MaterialDesignOutlinedSecondaryButton}" materialDesign:ButtonAssist.CornerRadius="15" FontSize="10" Margin="311,78,0,0" VerticalAlignment="Top" Height="28" Click="BTN_SELECT_ALLPERMIS_Click" HorizontalAlignment="Left" Width="180" />
                    <StackPanel Margin="0,48,10,0" Orientation="Horizontal" FlowDirection="RightToLeft" HorizontalAlignment="Right" Width="403" Height="30" VerticalAlignment="Top">
                        <Button x:Name="BTN_CLEAN_PSELECT" Content="پاکسازی دسترسی های انتخاب شده" Style="{StaticResource MaterialDesignFlatButton}" FontSize="10" Height="28" Click="BTN_CLEAN_PSELECT_Click" Width="184" />
                        <RadioButton x:Name="MLT" Content="انتخاب چندگانه" GroupName="GRP1" Margin="20,3,3,3" Click="MLT_Click"/>
                        <RadioButton x:Name="SS" Content="انتخاب تکی" GroupName="GRP1" IsChecked="True" Margin="10,3,3,3" Click="SS_Click"/>
                    </StackPanel>
                    <UniformGrid Margin="407,304,660,75">
                        <CheckBox IsEnabled="True" IsChecked="{Binding SelectedItem.SEE, ElementName=PermissionListBox, UpdateSourceTrigger=PropertyChanged}" Content="SEE"/>
                        <CheckBox IsEnabled="True" IsChecked="{Binding SelectedItem.INP, ElementName=PermissionListBox, UpdateSourceTrigger=PropertyChanged}" Content="INP"/>
                        <CheckBox IsEnabled="True" IsChecked="{Binding SelectedItem.INP, ElementName=PermissionListBox, UpdateSourceTrigger=PropertyChanged}" Content="INP"/>
                        <CheckBox IsEnabled="True" IsChecked="{Binding SelectedItem.DEL, ElementName=PermissionListBox, UpdateSourceTrigger=PropertyChanged}" Content="DEL"/>
                        <CheckBox IsEnabled="True" IsChecked="{Binding SelectedItem.RUN, ElementName=PermissionListBox, UpdateSourceTrigger=PropertyChanged}" Content="RUN"/>
                    </UniformGrid>
                </Grid>
            </TabItem>
            <TabItem Header="کلید انبار ها" IsKeyboardFocusWithinChanged="TabItem_IsKeyboardFocusWithinChanged">
                <Grid>
                    <DataGrid   
                              x:Name="OPANBACCESS_SUB"
                              d:ItemsSource="{d:SampleData ItemCount=5}"
                              EnableColumnVirtualization="True"
                              EnableRowVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ContextMenu="{StaticResource ContextUtilityMenu1}" ContextMenuOpening="OPANBACCESS_SUB_ContextMenuOpening" MouseRightButtonUp="OPANBACCESS_SUB_MouseRightButtonUp"
                              SelectedIndex="0"
                              ColumnHeaderStyle="{StaticResource CenteryHeaderstyle}"
                              CellStyle="{StaticResource CellFocusyBorder}"
                              HorizontalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                              VerticalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
                              ItemsSource="{Binding OPANBACCESS_DATA}"
                              KeyboardNavigation.TabNavigation="Contained"
                              AutoGenerateColumns="False" 
                              FlowDirection="RightToLeft" 
                              SelectionUnit="FullRow" 
                              CanUserDeleteRows="False"
                              IsEnabled="False"
                              Margin="319,57,10,10" BorderThickness="1" IsKeyboardFocusWithinChanged="OPANBACCESS_SUB_IsKeyboardFocusWithinChanged" CellEditEnding="OPANBACCESS_SUB_CellEditEnding" PreviewMouseLeftButtonUp="OPANBACCESS_SUB_PreviewMouseLeftButtonUp" SelectionChanged="OPANBACCESS_SUB_SelectionChanged" RowEditEnding="OPANBACCESS_SUB_RowEditEnding" PreviewKeyDown="OPANBACCESS_SUB_PreviewKeyDown" PreparingCellForEdit="OPANBACCESS_SUB_PreparingCellForEdit" BeginningEdit="OPANBACCESS_SUB_BeginningEdit"  ScrollViewer.HorizontalScrollBarVisibility="Auto">

                        <DataGrid.Style>
                            <!--خط بندی سطر های دیتاگرید-->
                            <Style TargetType="{x:Type DataGrid}" BasedOn="{StaticResource MaterialDesignDataGrid}">
                                <Setter Property="materialDesign:DataGridAssist.EnableEditBoxAssist" Value="False"/>
                                <Setter Property="GridLinesVisibility" Value="All"/>
                            </Style>
                        </DataGrid.Style>

                        <DataGrid.Columns>
                            <DataGridComboBoxColumn x:Name="ANBAR_COLUMN" Width="*" Header="انبار"
                                                    SelectedValueBinding="{Binding ANBCO,UpdateSourceTrigger=LostFocus}" DisplayMemberPath="NAMES" SelectedValuePath="CODE">
                                <DataGridComboBoxColumn.EditingElementStyle>
                                    <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource MaterialDesignComboBox}">
                                        <Setter Property="IsEditable" Value="True"/>
                                        <Setter Property="ItemsPanel" Value="{StaticResource VSP}"/>
                                        <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
                                        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                                        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
                                    </Style>
                                </DataGridComboBoxColumn.EditingElementStyle>
                                <DataGridComboBoxColumn.ElementStyle>
                                    <Style TargetType="{x:Type ComboBox}">
                                    </Style>
                                </DataGridComboBoxColumn.ElementStyle>
                            </DataGridComboBoxColumn>
                        </DataGrid.Columns>

                    </DataGrid>

                    <Border BorderThickness="1,1,1,1" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}" CornerRadius="5" Margin="13,57,0,11" HorizontalAlignment="Left" Width="253">
                        <ListBox x:Name="UserListBoxAnbar" SelectionMode="Single" Cursor="Hand" FlowDirection="RightToLeft" ItemsSource="{Binding SECOND_ALL_USERS, IsAsync=True, UpdateSourceTrigger=PropertyChanged}" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionChanged="UserListBoxAnbar_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox x:Name="ItemCheckBox" 
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                  VerticalAlignment="Center"
                                                  Margin="5,0,5,0"/>
                                        <TextBlock Text="{Binding SAL_NAME}" 
                                                   Grid.Column="1" 
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>
                    <TextBox x:Name="UserSearchBox" Text="" Height="30" Margin="13,16,0,0"  Style="{StaticResource FuzzyOut}" Padding="3"  TextWrapping="Wrap" VerticalAlignment="Top" TextAlignment="Right"  Visibility="Visible" MaxLength="48" HorizontalAlignment="Left" Width="253" TextChanged="UserSearchBox_TextChanged" />
                    <Label Content="کاربر:" HorizontalAlignment="Left" Margin="266,17,0,0" VerticalAlignment="Top" FlowDirection="RightToLeft" Width="auto"/>

                    <Button x:Name="BTN_DELETE_ANBAR" Tag="hazfer" Content="حذف انبار" BorderBrush="{x:Null}" FontSize="10" Foreground="#DDFFFFFF" Margin="319,14,0,0" Height="34" VerticalAlignment="Top" HorizontalAlignment="Left" Width="110" Click="BTN_DELETE_ANBAR_Click" />

                    <TextBlock Text="{Binding ElementName=UserListBoxAnbar,Path=SelectedItem.SAL_NAME}" VerticalAlignment="Top" TextAlignment="Center" Margin="459,22,19,0"/>


                </Grid>
            </TabItem>
            <TabItem Header="حق امضا" x:Name="RIGHT_SIGN" IsKeyboardFocusWithinChanged="RIGHT_SIGN_IsKeyboardFocusWithinChanged" >
                <Grid>
                    <ScrollViewer x:Name="SV_SGINS" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Margin="335,57,0,0" IsEnabled="False">
                        <UniformGrid Columns="2" Margin="10" x:Name="UNG_SIGN">
                            <StackPanel>
                                <!-- Row for "فاکتور خرید" -->
                                <GroupBox FlowDirection="RightToLeft" Header="فاکتور خرید" Style="{x:Null}" Foreground="{Binding Background, ElementName=GENERAL_RANG}">
                                    <DockPanel LastChildFill="True" Margin="3">
                                        <StackPanel Orientation="Vertical" >
                                            <CheckBox x:Name="KFR_BAZAR"  Content="بازرگانی" Margin="1,5,0,0" Width="auto" IsChecked="False" />
                                            <CheckBox x:Name="KFR_HESAB" Margin="1,7,1,1"  Content="حسابداری" Width="auto" IsChecked="False"  />
                                            <CheckBox x:Name="KFR_MODIR" Margin="1,6,1,1"  Content="مدیر عامل" Width="auto" IsChecked="False" />
                                        </StackPanel>
                                        <UniformGrid Rows="3" Margin="5,0,0,0">
                                            <TextBox x:Name="KFR_BAZARTX" Style="{StaticResource FuzzyOut}" Margin="1" Padding="3" Width="auto" />
                                            <TextBox x:Name="KFR_HESABTX" Style="{StaticResource FuzzyOut}" Margin="1" Padding="3" Width="auto"  />
                                            <TextBox x:Name="KFR_MODIRTX" Style="{StaticResource FuzzyOut}" Margin="1" Padding="3" Width="auto"  />
                                        </UniformGrid>

                                    </DockPanel>
                                </GroupBox>

                                <GroupBox FlowDirection="RightToLeft" Header="حواله انبار فروش" Style="{x:Null}" Foreground="{Binding Background, ElementName=GENERAL_RANG}">
                                    <DockPanel LastChildFill="True" Margin="3">
                                        <StackPanel Orientation="Vertical" >
                                            <CheckBox x:Name="ANB_HAVL_FROSH"   Content="فروش" Margin="1,5,0,0" Width="auto" />
                                            <CheckBox x:Name="ANB_HAVL_ANB" Margin="1,7,1,1"  Content="انباردار" Width="auto" />
                                            <CheckBox x:Name="ANB_HAVL_MODIR" Margin="1,6,1,1"  Content="مدیر عامل" Width="auto"/>
                                        </StackPanel>
                                        <UniformGrid Rows="3" Margin="5,0,0,0">
                                            <TextBox x:Name="ANB_HAVL_FROSHTX"  Style="{StaticResource FuzzyOut}" Margin="1" Padding="3" Width="auto" />
                                            <TextBox x:Name="ANB_HAVL_ANBTX" Style="{StaticResource FuzzyOut}" Margin="1" Padding="3" Width="auto"  />
                                            <TextBox x:Name="ANB_HAVL_MODIRTX" Style="{StaticResource FuzzyOut}" Margin="1" Padding="3" Width="auto"  />
                                        </UniformGrid>
                                    </DockPanel>
                                </GroupBox>

                                <GroupBox FlowDirection="RightToLeft" Header="رسید تولید" Style="{x:Null}" Foreground="{Binding Background, ElementName=GENERAL_RANG}">
                                    <DockPanel LastChildFill="True" Margin="3">
                                        <StackPanel Orientation="Vertical" >
                                            <CheckBox IsChecked="False"  x:Name="ANB_TOLID_MODIRT"    Content="مدیر تولید" Margin="1,5,0,0" Width="auto" />
                                            <CheckBox IsChecked="False"  x:Name="ANB_TOLID_QC"  Margin="1,7,1,1"  Content="کنترل کیفیت" Width="auto" />
                                            <CheckBox IsChecked="False"  x:Name="ANB_TOLID_ANB"  Margin="1,6,1,1"  Content="انبار" Width="auto"/>
                                        </StackPanel>
                                        <UniformGrid Rows="3" Margin="5,0,0,0">
                                            <TextBox x:Name="ANB_TOLID_MODIRTTX"  Style="{StaticResource FuzzyOut}" Margin="1" Padding="3" Width="auto" />
                                            <TextBox x:Name="ANB_TOLID_QCTX"  Style="{StaticResource FuzzyOut}" Margin="1" Padding="3" Width="auto"  />
                                            <TextBox x:Name="ANB_TOLID_ANBTX"  Style="{StaticResource FuzzyOut}" Margin="1" Padding="3" Width="auto"  />
                                        </UniformGrid>
