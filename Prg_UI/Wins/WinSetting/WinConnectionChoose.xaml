<Window x:Class="Prg_UI.Wins.WinSetting.WinConnectionChoose"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinSetting"
        mc:Ignorable="d"
        Topmost="True"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        FontFamily="{StaticResource IRANYEKAN}"
        WindowStartupLocation="CenterScreen"
        Background="{x:Null}" AllowsTransparency="True"
        AllowDrop="True"
        ShowInTaskbar="False"
        WindowStyle="None" MinHeight="365" MinWidth="600"
        Title="" Height="365" Width="600" Loaded="Window_Loaded">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5"	  Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding ElementName=GENERAL_RANG,Path=Background}" BorderThickness="1,0,1,1">
            <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" Background="{Binding ElementName=GENERAL_RANG,Path=Background}" Margin="-8,-8,-8,0" VerticalAlignment="Top" MinHeight="50" UseLayoutRounding="False" Height="23" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Grid>
                    <Button x:Name="Btn_Close" Margin="0,15,10,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="20" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" Grid.Column="4" >
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="535,0,0,0" IsEnabled="False" BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="20" VerticalAlignment="Center" HorizontalAlignment="Left" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
                        <materialDesign:PackIcon Kind="WindowRestore" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                    <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,15,68,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="20" VerticalAlignment="Top" HorizontalAlignment="Right" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" Grid.Column="3" Grid.ColumnSpan="2" >
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button>
                </Grid>
            </Border>
        </Border>
        <Button x:Name="Btn_TestConnection" Content="تست اتصال" Margin="157,294,333,0" Cursor="Hand"    Height="36" VerticalAlignment="Top" TabIndex="5" Foreground="#DDFFFFFF" FontSize="11" Click="Btn_TestConnection_Click" Width="110"/>
        <TextBox x:Name="Textbox_Servername" Visibility="Hidden"   Padding="3" HorizontalAlignment="Left" Height="26" Margin="142,94,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="158"  Text="{Binding SelectedItem, ElementName=ServerChooser}" TabIndex="0"/>
        <Label Content="نام یا آیپی سرور :"  HorizontalAlignment="Right" Margin="0,112,101,0" VerticalAlignment="Top"  FlowDirection="RightToLeft" Height="27" FontSize="11"/>
        <Label Content="نام دیتابیس :" Margin="0,147,119,0" VerticalAlignment="Top"  FlowDirection="RightToLeft" Height="27" HorizontalAlignment="Right" FontSize="11"/>
        <Label IsEnabled="{Binding IsChecked, ElementName=rd_SqlAuth}" Content="نام کاربری :" Margin="0,185,131,0" VerticalAlignment="Top"  FlowDirection="RightToLeft" Height="27" HorizontalAlignment="Right" FontSize="11"/>
        <TextBox x:Name="Textbox_Dataname" Visibility="Hidden"  Style="{StaticResource FuzzyOut}" Padding="3" HorizontalAlignment="Left" Height="27" Margin="-13,71,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="158"  Text="" TabIndex="1"/>
        <TextBox IsEnabled="{Binding IsChecked, ElementName=rd_SqlAuth}"   Style="{StaticResource FuzzyOut}"  Padding="3" x:Name="Textbox_DataUsername" Height="27" Margin="159,186,197,0" TextWrapping="Wrap" VerticalAlignment="Top"  TabIndex="2"/>
        <Button x:Name="Btn_SaveConnection" Content="تایید" Margin="302,294,188,0" Cursor="Hand"      Height="36" VerticalAlignment="Top" FontWeight="Bold" TabIndex="6" FontSize="11" Foreground="#DDFFFFFF" Click="Btn_SaveConnection_Click" Width="110"/>
        <Label  IsEnabled="{Binding IsChecked, ElementName=rd_SqlAuth}" Content="رمز عبور :" Margin="0,220,140,0" VerticalAlignment="Top"  FlowDirection="RightToLeft" Height="27" HorizontalAlignment="Right" FontSize="11"/>
        <TextBox IsEnabled="{Binding IsChecked, ElementName=rd_SqlAuth}" Style="{StaticResource FuzzyOut}"  Padding="3" x:Name="Textbox_Datapass" Height="27" Margin="159,221,197,0" TextWrapping="Wrap" VerticalAlignment="Top"  TabIndex="3"/>
        <RadioButton x:Name="rd_SqlAuth" GroupName="auth" Content="SQL Athentication" Margin="299,257,0,0" VerticalAlignment="Top" IsChecked="True" HorizontalAlignment="Left" Width="104" Height="23" FontSize="10"/>
        <RadioButton x:Name="rd_WinAuth" GroupName="auth" Content="Windows Athentication" Margin="158,257,0,0" VerticalAlignment="Top" IsChecked="True" TabIndex="4" HorizontalAlignment="Left" Width="126" Height="23" FontSize="10"/>
        <ComboBox x:Name="ServerChooser"   Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}"  Margin="159,113,197,0" VerticalAlignment="Top" Height="27"   SelectedIndex="0" Foreground="#FF252526" IsEditable="True" IsTextSearchEnabled="True" ToolTip="نام سرور رو انتخاب کنید یا  اسم یا آیپی شبکه" SelectionChanged="ServerChooser_SelectionChanged" >
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <ComboBox x:Name="DbChooser"  Padding="7,0,10,0" Style="{StaticResource FuzzyOutComboBox}"   IsTextSearchEnabled="True" Margin="159,149,197,0" VerticalAlignment="Top" Height="27"   IsEditable="True" SelectedIndex="0" Foreground="#FF252526" DropDownOpened="DbChooser_DropDownOpened">
            <ComboBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                </ItemsPanelTemplate>
            </ComboBox.ItemsPanel>
        </ComboBox>
        <Label Content="اتصال به سرور"   HorizontalContentAlignment="Center" Margin="0,50,0,0" VerticalAlignment="Top"  FlowDirection="RightToLeft" FontSize="14" Foreground="#E51B1B1C" Height="34" PreviewMouseLeftButtonDown="Label_PreviewMouseLeftButtonDown"/>

        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="109,204,550,149"/>
        <Button x:Name="Btn_GetServers"  Style="{StaticResource MaterialDesignFlatButton}" Content="دریافت سرور ها" HorizontalAlignment="Left" Margin="11,90,0,0" VerticalAlignment="Top" Height="31" Width="108" Click="Btn_GetServers_Click" FontSize="11" Foreground="#FF1A1A1A" Background="{x:Null}" BorderBrush="{x:Null}"/>
        <Label x:Name="lblconnecting" Visibility="Hidden" Content=". . . در حال تست" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#D8252526" Foreground="White"  FontSize="22"/>
    </Grid>
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
</Window>
