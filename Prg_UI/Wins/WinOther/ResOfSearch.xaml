<Window x:Class="Prg_UI.Wins.WinOther.ResOfSearch"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins.WinOther"
        mc:Ignorable="d"
        
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        FontFamily="{StaticResource IRANYEKAN}"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None"
        WindowState="Maximized"
        Title="نتایج جستجو" Height="473.684" Width="985" WindowStartupLocation="CenterScreen" Closed="Window_Closed" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <SolidColorBrush x:Key="GENERAL_Grlicom" Opacity="0.3" Color="{Binding Background.Color, ElementName=GENERAL_RANG}"/>
    </Window.Resources>
    <Grid  x:Name="mygrid">
        <Border CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" 	  Background="{DynamicResource MaterialDesign.Brush.Background}" BorderBrush="{Binding Background, ElementName=GENERAL_RANG}"  Grid.ColumnSpan="5" BorderThickness="1">
            <Border x:Name="TitleDrawBar" Style="{DynamicResource BordG}" Background="{Binding Background, ElementName=GENERAL_RANG}" Margin="-9,-9,-9,0" VerticalAlignment="Top" MinHeight="34" UseLayoutRounding="False" Height="35.072" MouseLeftButtonDown="TitleDrawBar_MouseLeftButtonDown">
                <Label Content="لیست مشتریان بر اساس جستجو" Padding="21,7,11,10" Foreground="White"/>
            </Border>
        </Border>
        <Label Content="کل رکورد ها : " Margin="707,0,18,9" VerticalAlignment="Bottom" FlowDirection="RightToLeft"/>
        <Label x:Name="DGRCount_LBL" Content="{Binding Items.Count, ElementName=ResDGR1, StringFormat=\{0:N0\}}" Margin="506,0,98,12" Height="26" VerticalAlignment="Bottom" FlowDirection="RightToLeft"/>

        <DataGrid x:Name="ResDGR1"        
                    Style="{StaticResource DATAGRIDSTYLISH}"
                    ColumnHeaderStyle="{StaticResource CenteryHeaderstyle}"           
                    HorizontalGridLinesBrush="{StaticResource GENERAL_Grlicom}"
					VerticalGridLinesBrush="{StaticResource GENERAL_Grlicom}" Margin="10,55,10,43" FlowDirection="RightToLeft" PreviewKeyDown="ResDGR1_PreviewKeyDown" AutoGenerateColumns="False" EnableRowVirtualization="True" RowDetailsVisibilityMode="VisibleWhenSelected" SelectedIndex="0" CanUserAddRows="False" IsReadOnly="True" BorderThickness="1">
            <DataGrid.Columns>
                <DataGridTextColumn x:Name="n_KOLColumn" Binding="{Binding N_KOL}" Header="کل" Width="auto"  MinWidth="50"/>
                <DataGridTextColumn x:Name="nKOLColumn" Binding="{Binding NKOL}" Header="نام کل" Width="auto"  MinWidth="150"/>
                <DataGridTextColumn x:Name="nUMBERColumn" Binding="{Binding NUMBER}" Header="معین" Width="auto"  MinWidth="50"/>
                <DataGridTextColumn x:Name="nAMEColumn" Binding="{Binding NAME}" Header="نام مشتری" Width="auto"  MinWidth="200"/>
                <DataGridTextColumn x:Name="tNUMBERColumn" Binding="{Binding TNUMBER}" Header="تفضیلی" Width="auto"  MinWidth="50"/>
                <DataGridTextColumn x:Name="nMOINColumn" Binding="{Binding NMOIN}" Header="نام معین" Width="auto"  MinWidth="150"/>
                <DataGridTextColumn x:Name="aDDRESSColumn" Binding="{Binding ADDRESS}" Header="آدرس" Width="auto"  MinWidth="150"/>
                <DataGridTextColumn x:Name="tnumber2Column" Binding="{Binding tnumber2}" Header="تفضیلی های بعد" Width="auto"  MinWidth="100"/>
                <DataGridTextColumn x:Name="tNAMEColumn" Binding="{Binding TNAME}" Header="نام حساب تفضیلی های بعد" Width="auto"  MinWidth="150"/>
                <DataGridTextColumn x:Name="cODE_EColumn" Binding="{Binding CODE_E}" Header="CODE E" Width="auto"  Visibility="Collapsed"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Margin="95,56,0,0"  Width="1"/>

        <Button x:Name="Btn_Close" Margin="0,8,8,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" Click="Btn_Close_Click" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
            <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
        </Button>
        <Button x:Name="Btn_Max" Click="Btn_Max_Click" Margin="0,8,37,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
            <materialDesign:PackIcon Kind="WindowRestore" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
        </Button>
        <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,8,66,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="19" VerticalAlignment="Top" HorizontalAlignment="Right" FontFamily="Tahoma" Foreground="White" Width="24" Padding="1,-2,1,1" IsTabStop="False" >
            <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
        </Button>

    </Grid>
</Window>
