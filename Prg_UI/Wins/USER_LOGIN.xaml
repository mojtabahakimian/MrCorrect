<Window x:Class="Prg_UI.Wins.USER_LOGIN"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Prg_UI.Wins"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        AllowsTransparency="True" Background="Transparent" FontFamily="{StaticResource IRANYEKAN}" 
        Height="460" ResizeMode="NoResize" UseLayoutRounding="True" Width="700" 
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Loaded="Window_Loaded" ContentRendered="Window_ContentRendered" 
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" GlassFrameThickness="0" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Window Controls -->
        <Style TargetType="Button" x:Key="CaptionBtnStyle">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" x:Name="border">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#10000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style BasedOn="{StaticResource CaptionBtnStyle}" TargetType="Button" x:Key="CloseBtnStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="0,12,0,0" x:Name="border">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button -->
        <Style TargetType="Button" x:Key="PrimaryBtnStyle">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#29B6F6" CornerRadius="12" x:Name="border">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#03A9F4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#0288D1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Checkbox -->
        <Style TargetType="CheckBox" x:Key="SoftCheckbox">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel FlowDirection="RightToLeft" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="4" Height="18" Width="18" x:Name="box">
                                <materialDesign:PackIcon x:Name="check" Kind="Check" Width="14" Height="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" TargetName="box" Value="#29B6F6"/>
                                <Setter Property="BorderBrush" TargetName="box" Value="#29B6F6"/>
                                <Setter Property="Opacity" TargetName="check" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Rounded ComboBox Items -->
        <Style TargetType="ComboBoxItem" x:Key="RoundedComboBoxItemStyle">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border Background="Transparent" CornerRadius="8" Margin="6,2" x:Name="Bd">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" TargetName="Bd" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" TargetName="Bd" Value="#E0F2FE"/>
                                <Setter Property="Foreground" Value="#0288D1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fixed Custom Rounded ComboBox -->
        <Style TargetType="ComboBox" x:Key="RoundedComboBoxStyle">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,0,10,0"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource RoundedComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- FlowDirection=RightToLeft ensures Column 0 is on the physical Right, Column 1 is on physical Left -->
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Style="{x:Null}" explicitly removes MaterialDesign default blue underline -->
                            <TextBox Background="Transparent" BorderThickness="0" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" Grid.Column="0" HorizontalContentAlignment="Left" Padding="{TemplateBinding Padding}" Style="{x:Null}" VerticalContentAlignment="Center" x:Name="PART_EditableTextBox"/>

                            <ToggleButton Background="Transparent" BorderThickness="0" ClickMode="Press" Focusable="false" Grid.Column="1" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" x:Name="ToggleButton">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Width="36">
                                            <Path Data="M 0 0 L 4.5 4.5 L 9 0 Z" Fill="#94A3B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Popup List -->
                            <Popup AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Slide" x:Name="Popup">
                                <Grid MaxHeight="220" Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Margin="0,4,0,8">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" Color="Black" Opacity="0.1" ShadowDepth="4"/>
                                        </Border.Effect>
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" Margin="0,4,0,4" VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Outer Frame -->
        <Border Background="White" CornerRadius="12" x:Name="Brd">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" Color="Black" Direction="270" Opacity="0.12" ShadowDepth="5"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Blue Panel -->
                <Border ClipToBounds="True" CornerRadius="12,0,0,12" Grid.Column="0">
                    <Border.Background>
                        <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                            <GradientStop Color="#4FC3F7" Offset="0"/>
                            <GradientStop Color="#0288D1" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <!-- Soft abstract shapes -->
                        <Ellipse Fill="#15FFFFFF" Height="250" HorizontalAlignment="Left" Margin="-80,-80,0,0" VerticalAlignment="Top" Width="250"/>
                        <Ellipse Fill="#10FFFFFF" Height="200" HorizontalAlignment="Right" Margin="0,0,-50,-50" VerticalAlignment="Bottom" Width="200"/>

                        <StackPanel HorizontalAlignment="Center" Margin="16" VerticalAlignment="Center">
                            <Border Background="#26FFFFFF" CornerRadius="42" Height="84" HorizontalAlignment="Center" Margin="0,0,0,20" Width="84">
                                <materialDesign:PackIcon Kind="AccountCheckOutline" Width="46" Height="46" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock FontFamily="Segoe UI" FontSize="34" FontWeight="Light" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock.Text>Mr Correct</TextBlock.Text>
                            </TextBlock>
                            <TextBlock FontSize="14" Foreground="#E0F7FA" HorizontalAlignment="Center">
                                <TextBlock.Text>سیستم مدیریت هوشمند</TextBlock.Text>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Left" Margin="20,0,20,20" VerticalAlignment="Bottom">
                            <!-- SD_Status label restored -->
                            <Label FontSize="10" Foreground="#B3E5FC" Padding="0" x:Name="SD_Status">
                                <Label.Content>SERVER : MERCEDES\SQL2022 | DATABASE : NEWFOODRIP05</Label.Content>
                            </Label>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right Form Panel -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- TitleBar Controls -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Right" Margin="0,4,4,0" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Click="Btn_Minimize_Click" Style="{StaticResource CaptionBtnStyle}" x:Name="Btn_Minimize">
                            <materialDesign:PackIcon Kind="WindowMinimize" Width="14" Height="14"/>
                        </Button>
                        <Button Click="Button_Click" Style="{StaticResource CloseBtnStyle}" x:Name="Btn_Close">
                            <materialDesign:PackIcon Kind="WindowClose" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>

                    <!-- Main Form -->
                    <Grid FlowDirection="RightToLeft" Grid.Row="1" Margin="45,0,45,0">
                        <StackPanel VerticalAlignment="Center">

                            <TextBlock FontSize="26" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,30">
                                <TextBlock.Text>ورود به سیستم</TextBlock.Text>
                            </TextBlock>

                            <!-- User Input -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon Kind="AccountOutline" Width="26" Height="26" Foreground="#29B6F6" VerticalAlignment="Center" Margin="0,0,16,0"/>

                                <Grid Grid.Column="1">
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Height="48">
                                        <!-- Applied custom ComboBox style -->
                                        <ComboBox DisplayMemberPath="SAL_NAME" FlowDirection="RightToLeft" IsEditable="True" SelectedValuePath="IDD" SelectionChanged="CmbUsers_SelectionChanged" Style="{StaticResource RoundedComboBoxStyle}" Text="{Binding ElementName=Krbri, Path=Text, UpdateSourceTrigger=PropertyChanged}" x:Name="CmbUsers"/>
                                    </Border>
                                    <TextBox TextChanged="Krbri_TextChanged" Visibility="Hidden" x:Name="Krbri"/>
                                </Grid>
                            </Grid>

                            <!-- Password Input -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon Kind="LockOutline" Width="26" Height="26" Foreground="#29B6F6" VerticalAlignment="Center" Margin="0,0,16,0"/>

                                <Grid Grid.Column="1">
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Height="48">
                                        <Grid>
                                            <PasswordBox Background="Transparent" BorderThickness="0" CommandManager.PreviewExecuted="Rmzo_PreviewExecuted" FlowDirection="RightToLeft" FontSize="14" Foreground="#334155" HorizontalContentAlignment="Left" Padding="10,0,10,0" PasswordChanged="Rmzo_PasswordChanged" VerticalContentAlignment="Center" materialDesign:TextFieldAssist.UnderlineBrush="Transparent" x:Name="Rmzo"/>
                                            <TextBox Background="Transparent" BorderThickness="0" CommandManager.PreviewExecuted="SecoRmzo_PreviewExecuted" FlowDirection="RightToLeft" FontSize="14" Foreground="#334155" HorizontalContentAlignment="Left" Padding="10,0,10,0" TextChanged="SecoRmzo_TextChanged" VerticalContentAlignment="Center" Visibility="Hidden" materialDesign:TextFieldAssist.UnderlineBrush="Transparent" x:Name="SecoRmzo"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- Checkbox -->
                            <CheckBox Checked="PutedTick" Margin="42,0,0,24" Style="{StaticResource SoftCheckbox}" Unchecked="RemovedTick" x:Name="dispass">
                                <CheckBox.Content>نمایش رمز عبور</CheckBox.Content>
                            </CheckBox>

                            <!-- Login Button -->
                            <Button Click="Btn_Goin" GotFocus="Greet_GotFocus" IsDefault="True" IsEnabled="False" LostFocus="Greet_LostFocus" Style="{StaticResource PrimaryBtnStyle}" x:Name="Greet">
                                <Button.Content>ورود</Button.Content>
                            </Button>

                        </StackPanel>
                    </Grid>

                    <!-- Footer -->
                    <Grid Grid.Row="2" Margin="24,0,24,20">
                        <Label FlowDirection="LeftToRight" FontFamily="Segoe UI" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Left" Padding="0" PreviewMouseDoubleClick="LBL_VERSION_PreviewMouseDoubleClick" VerticalAlignment="Center" x:Name="LBL_VERSION">
                            <Label.Content>Version 1.0.0.396  •  Date: 1405/01/30</Label.Content>
                        </Label>

                        <Button Background="Transparent" BorderThickness="0" Click="Button_Click_1" Cursor="Hand" FontSize="12" Foreground="#0288D1" HorizontalAlignment="Right" Padding="0" VerticalAlignment="Center">
                            <Button.Content>اتصال به پایگاه داده</Button.Content>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- Overlays and Popups -->

        <!-- Connection Loader (Restored) -->
        <Label Background="#D8252526" FontSize="20" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Visibility="Hidden" x:Name="lblconnecting">
            <Label.Content>. . . در حال تست</Label.Content>
        </Label>

        <!-- Main Login Loader -->
        <Label Background="#BF1B1B1C" FlowDirection="RightToLeft" FontSize="16" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Visibility="Collapsed" x:Name="lbloader">
            <Label.Content>در حال ورود به سیستم ...</Label.Content>
        </Label>

        <!-- Error Alert Popup -->
        <Popup AllowsTransparency="True" Placement="Center" PopupAnimation="Fade" StaysOpen="False" VerticalOffset="-4" x:Name="Pop1">
            <Border Background="#EF5350" CornerRadius="10" Padding="18,10" x:Name="Pop_Border1">
                <TextBox Background="Transparent" BorderThickness="0" FontSize="13" Foreground="White" HorizontalContentAlignment="Center" IsReadOnly="True" VerticalContentAlignment="Center" x:Name="Pop1Text1">
                    <TextBox.Text>رمز عبور وارد شده صحیح نمی باشد</TextBox.Text>
                </TextBox>
            </Border>
        </Popup>

        <!-- Auto Update Panel -->
        <Border Background="#E6212121" CornerRadius="14" Height="200" HorizontalAlignment="Center" Panel.ZIndex="1000" VerticalAlignment="Center" Visibility="Collapsed" Width="400" x:Name="UpdatePanel">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <materialDesign:PackIcon Kind="CloudDownload" Width="44" Height="44" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock FontSize="15" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock.Text>در حال دانلود نسخه جدید...</TextBlock.Text>
                </TextBlock>
                <ProgressBar Background="#40FFFFFF" BorderThickness="0" Foreground="#4FC3F7" Height="8" Margin="0,0,0,8" Maximum="100" Minimum="0" Width="300" x:Name="UpdatePrg"/>
                <Label FontSize="13" Foreground="White" HorizontalAlignment="Center" Padding="0" x:Name="UpdateLbl">
                    <Label.Content>0%</Label.Content>
                </Label>
                <TextBlock FontSize="11" Foreground="#BBFFFFFF" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <TextBlock.Text>(پس از اتمام برنامه خودکار باز خواهد شد)</TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Legacy labels -->
        <Label PreviewMouseDoubleClick="Lbl_usernam_PreviewMouseDoubleClick" Visibility="Collapsed" x:Name="Lbl_usernam"/>
        <Label PreviewMouseLeftButtonUp="Label_PreviewMouseLeftButtonUp" Visibility="Collapsed" x:Name="label"/>
        <Label PreviewMouseLeftButtonUp="VorudLabel_PreviewMouseLeftButtonUp" Visibility="Collapsed" x:Name="VorudLabel"/>
        <Label MouseLeftButtonUp="cnnparamlbl_MouseLeftButtonUp" Visibility="Hidden" x:Name="cnnparamlbl"/>
    </Grid>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Duration="0:0:0.4" From="0" Storyboard.TargetName="Brd" Storyboard.TargetProperty="Opacity" To="1">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>