<!-- STREAMING_CHUNK:Fixing BiDi text parsing issues by using element syntax for content... -->
<Window x:Class="Prg_UI.Wins.USER_LOGIN"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:Prg_UI.Wins"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        AllowsTransparency="True" Background="Transparent" FontFamily="{StaticResource IRANYEKAN}" 
        Height="460" ResizeMode="NoResize" UseLayoutRounding="True" Width="700" 
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Loaded="Window_Loaded" ContentRendered="Window_ContentRendered" 
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" GlassFrameThickness="0" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Window Controls -->
        <Style TargetType="Button" x:Key="CaptionBtnStyle">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" x:Name="border">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#10000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style BasedOn="{StaticResource CaptionBtnStyle}" TargetType="Button" x:Key="CloseBtnStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="0,12,0,0" x:Name="border">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Button -->
        <Style TargetType="Button" x:Key="PrimaryBtnStyle">
            <Setter Property="Height" Value="48"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#29B6F6" CornerRadius="12" x:Name="border">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#03A9F4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" TargetName="border" Value="#0288D1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Checkbox -->
        <Style TargetType="CheckBox" x:Key="SoftCheckbox">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel FlowDirection="RightToLeft" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="White" BorderBrush="#CBD5E1" BorderThickness="1.5" CornerRadius="4" Height="18" Width="18" x:Name="box">
                                <materialDesign:PackIcon x:Name="check" Kind="Check" Width="14" Height="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" TargetName="box" Value="#29B6F6"/>
                                <Setter Property="BorderBrush" TargetName="box" Value="#29B6F6"/>
                                <Setter Property="Opacity" TargetName="check" Value="1"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Outer Frame -->
        <Border Background="White" CornerRadius="12" x:Name="Brd">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" Color="Black" Direction="270" Opacity="0.12" ShadowDepth="5"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left Blue Panel -->
                <Border ClipToBounds="True" CornerRadius="12,0,0,12" Grid.Column="0">
                    <Border.Background>
                        <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                            <GradientStop Color="#4FC3F7" Offset="0"/>
                            <GradientStop Color="#0288D1" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <!-- Soft abstract shapes -->
                        <Ellipse Fill="#15FFFFFF" Height="250" HorizontalAlignment="Left" Margin="-80,-80,0,0" VerticalAlignment="Top" Width="250"/>
                        <Ellipse Fill="#10FFFFFF" Height="200" HorizontalAlignment="Right" Margin="0,0,-50,-50" VerticalAlignment="Bottom" Width="200"/>

                        <StackPanel HorizontalAlignment="Center" Margin="16" VerticalAlignment="Center">
                            <Border Background="#26FFFFFF" CornerRadius="42" Height="84" HorizontalAlignment="Center" Margin="0,0,0,20" Width="84">
                                <materialDesign:PackIcon Kind="AccountCheckOutline" Width="46" Height="46" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock FontFamily="Segoe UI" FontSize="34" FontWeight="Light" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8">
                                <TextBlock.Text>Mr Correct</TextBlock.Text>
                            </TextBlock>
                            <TextBlock FontSize="14" Foreground="#E0F7FA" HorizontalAlignment="Center">
                                <TextBlock.Text>سیستم مدیریت هوشمند</TextBlock.Text>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Left" Margin="20,0,20,20" VerticalAlignment="Bottom">
                            <!-- SD_Status label restored -->
                            <Label x:Name="SD_Status" FontSize="10" Foreground="#B3E5FC" Padding="0">
                                <Label.Content>SERVER : MERCEDES\SQL2022 | DATABASE : NEWFOODRIP05</Label.Content>
                            </Label>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Right Form Panel -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- TitleBar Controls -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Right" Margin="0,4,4,0" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource CaptionBtnStyle}" x:Name="Btn_Minimize" Click="Btn_Minimize_Click">
                            <materialDesign:PackIcon Kind="WindowMinimize" Width="14" Height="14"/>
                        </Button>
                        <Button Style="{StaticResource CloseBtnStyle}" x:Name="Btn_Close" Click="Button_Click">
                            <materialDesign:PackIcon Kind="WindowClose" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>

                    <!-- Main Form -->
                    <Grid FlowDirection="RightToLeft" Grid.Row="1" Margin="45,0,45,0">
                        <StackPanel VerticalAlignment="Center">

                            <TextBlock FontSize="26" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,30">
                                <TextBlock.Text>ورود به سیستم</TextBlock.Text>
                            </TextBlock>

                            <!-- User Input -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon Kind="AccountOutline" Width="26" Height="26" Foreground="#29B6F6" VerticalAlignment="Center" Margin="0,0,16,0"/>

                                <Grid Grid.Column="1">
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Height="48">
                                        <ComboBox Background="Transparent" BorderThickness="0" FlowDirection="RightToLeft" FontSize="14" Foreground="#334155" HorizontalContentAlignment="Right" IsEditable="True" Padding="10,0,10,0" VerticalContentAlignment="Center" materialDesign:TextFieldAssist.UnderlineBrush="Transparent" x:Name="CmbUsers" DisplayMemberPath="SAL_NAME" SelectedValuePath="IDD" SelectionChanged="CmbUsers_SelectionChanged" Text="{Binding ElementName=Krbri, Path=Text, UpdateSourceTrigger=PropertyChanged}"/>
                                    </Border>
                                    <TextBox x:Name="Krbri" Visibility="Hidden" TextChanged="Krbri_TextChanged"/>
                                </Grid>
                            </Grid>

                            <!-- Password Input -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon Kind="LockOutline" Width="26" Height="26" Foreground="#29B6F6" VerticalAlignment="Center" Margin="0,0,16,0"/>

                                <Grid Grid.Column="1">
                                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="10" Height="48">
                                        <Grid>
                                            <PasswordBox Background="Transparent" BorderThickness="0" FlowDirection="RightToLeft" FontSize="14" Foreground="#334155" HorizontalContentAlignment="Right" Padding="10,0,10,0" VerticalContentAlignment="Center" materialDesign:TextFieldAssist.UnderlineBrush="Transparent" x:Name="Rmzo" PasswordChanged="Rmzo_PasswordChanged" CommandManager.PreviewExecuted="Rmzo_PreviewExecuted"/>
                                            <TextBox x:Name="SecoRmzo" Visibility="Hidden" Background="Transparent" BorderThickness="0" FlowDirection="RightToLeft" FontSize="14" Foreground="#334155" HorizontalContentAlignment="Right" Padding="10,0,10,0" VerticalContentAlignment="Center" materialDesign:TextFieldAssist.UnderlineBrush="Transparent" TextChanged="SecoRmzo_TextChanged" CommandManager.PreviewExecuted="SecoRmzo_PreviewExecuted"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>

                            <!-- Checkbox -->
                            <CheckBox Margin="42,0,0,24" Style="{StaticResource SoftCheckbox}" x:Name="dispass" Checked="PutedTick" Unchecked="RemovedTick">
                                <CheckBox.Content>نمایش رمز عبور</CheckBox.Content>
                            </CheckBox>

                            <!-- Login Button -->
                            <Button IsDefault="True" IsEnabled="False" Style="{StaticResource PrimaryBtnStyle}" x:Name="Greet" Click="Btn_Goin" GotFocus="Greet_GotFocus" LostFocus="Greet_LostFocus">
                                <Button.Content>ورود</Button.Content>
                            </Button>

                        </StackPanel>
                    </Grid>

                    <!-- Footer -->
                    <Grid Grid.Row="2" Margin="24,0,24,20">
                        <Label x:Name="LBL_VERSION" FlowDirection="LeftToRight" FontFamily="Segoe UI" FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Left" VerticalAlignment="Center" Padding="0" PreviewMouseDoubleClick="LBL_VERSION_PreviewMouseDoubleClick">
                            <Label.Content>Version 1.0.0.396  •  Date: 1405/01/30</Label.Content>
                        </Label>

                        <Button Background="Transparent" BorderThickness="0" Cursor="Hand" FontSize="12" Foreground="#0288D1" HorizontalAlignment="Right" Padding="0" VerticalAlignment="Center" Click="Button_Click_1">
                            <Button.Content>اتصال به پایگاه داده</Button.Content>
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- STREAMING_CHUNK:Overlays and Popups -->

        <!-- Connection Loader (Restored) -->
        <Label x:Name="lblconnecting" Visibility="Hidden" Background="#D8252526" Foreground="White" FontSize="20" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Label.Content>. . . در حال تست</Label.Content>
        </Label>

        <!-- Main Login Loader -->
        <Label x:Name="lbloader" Visibility="Collapsed" Background="#BF1B1B1C" Foreground="White" FontSize="16" FlowDirection="RightToLeft" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
            <Label.Content>در حال ورود به سیستم ...</Label.Content>
        </Label>

        <!-- Error Alert Popup -->
        <Popup x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Center" StaysOpen="False" VerticalOffset="-4">
            <Border x:Name="Pop_Border1" CornerRadius="10" Background="#EF5350" Padding="18,10">
                <TextBox x:Name="Pop1Text1" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="13" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                    <TextBox.Text>رمز عبور وارد شده صحیح نمی باشد</TextBox.Text>
                </TextBox>
            </Border>
        </Popup>

        <!-- Auto Update Panel -->
        <Border x:Name="UpdatePanel" Visibility="Collapsed" CornerRadius="14" Background="#E6212121" Width="400" Height="200" VerticalAlignment="Center" HorizontalAlignment="Center" Panel.ZIndex="1000">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="CloudDownload" Width="44" Height="44" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Foreground="White" FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,12">
                    <TextBlock.Text>در حال دانلود نسخه جدید...</TextBlock.Text>
                </TextBlock>
                <ProgressBar x:Name="UpdatePrg" Width="300" Height="8" Minimum="0" Maximum="100" BorderThickness="0" Background="#40FFFFFF" Foreground="#4FC3F7" Margin="0,0,0,8"/>
                <Label x:Name="UpdateLbl" Foreground="White" HorizontalAlignment="Center" FontSize="13" Padding="0">
                    <Label.Content>0%</Label.Content>
                </Label>
                <TextBlock Foreground="#BBFFFFFF" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0">
                    <TextBlock.Text>(پس از اتمام برنامه خودکار باز خواهد شد)</TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Legacy labels -->
        <Label x:Name="Lbl_usernam" Visibility="Collapsed" PreviewMouseDoubleClick="Lbl_usernam_PreviewMouseDoubleClick"/>
        <Label x:Name="label" Visibility="Collapsed" PreviewMouseLeftButtonUp="Label_PreviewMouseLeftButtonUp"/>
        <Label x:Name="VorudLabel" Visibility="Collapsed" PreviewMouseLeftButtonUp="VorudLabel_PreviewMouseLeftButtonUp"/>
        <Label x:Name="cnnparamlbl" Visibility="Hidden" MouseLeftButtonUp="cnnparamlbl_MouseLeftButtonUp"/>
    </Grid>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Duration="0:0:0.4" From="0" Storyboard.TargetName="Brd" Storyboard.TargetProperty="Opacity" To="1">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>