<Window x:Class="Prg_UI.Wins.USER_LOGIN"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins"
        mc:Ignorable="d"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Background="{x:Null}" AllowsTransparency="True"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        FontFamily="{StaticResource IRANYEKAN}"
        Title="" Width="565" Height="375"  WindowStyle="None" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" ResizeMode="NoResize" ContentRendered="Window_ContentRendered"  Foreground="{Binding Background, ElementName=Greet}" PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing" >
    <!--FontFamily="{StaticResource IRANYEKAN}"-->

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="12"/>
    </WindowChrome.WindowChrome>
    <Grid x:Name="grid">
        <!--Headeing-->
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Width="1" IsHitTestVisible="False" Focusable="False" IsTabStop="False"/>
        <Border x:Name="Brd" CornerRadius="10,10,10,10" Padding="8" RenderTransformOrigin="0.5,0.5" Background="{StaticResource MaterialDesign.Brush.Background}" BorderBrush="{Binding ElementName=GENERAL_RANG,Path=Background}" BorderThickness="1">
        </Border>
        <Border x:Name="TitleDrawBar" Style="{StaticResource BordG}" VerticalAlignment="Top" MinHeight="50" UseLayoutRounding="False" Height="25" Background="{Binding Background, ElementName=GENERAL_RANG}" BorderBrush="Black" >
            <Grid>
                <Button x:Name="Btn_Close" Click="Button_Click" Margin="0,12,11,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="23" VerticalAlignment="Top" HorizontalAlignment="Right" FontFamily="Tahoma" Foreground="White" Width="29" Padding="1,-2,1,1" IsTabStop="False" >
                    <Button.Content>
                        <materialDesign:PackIcon Kind="WindowClose" Margin="0,0,0,0" Height="17" Width="21" Foreground="White" />
                    </Button.Content>
                </Button>
                <Button x:Name="Btn_Minimize" Click="Btn_Minimize_Click" Margin="0,12,43,0"  BorderBrush="{x:Null}" Background="Transparent" FontSize="12"  Height="23" VerticalAlignment="Top" HorizontalAlignment="Right" FontFamily="Tahoma" Foreground="White" Width="29" Padding="1,-2,1,1" IsTabStop="False" >
                    <Button.Content>
                        <materialDesign:PackIcon Kind="WindowMinimize" Margin="0,4,0,0" Height="17" Width="21" Foreground="White" />
                    </Button.Content>
                </Button>


            </Grid>
        </Border>
        <!--Headeing-->
        <Label x:Name="Lbl_usernam" Visibility="Collapsed"  Content="نام کاربری :"  HorizontalAlignment="Left" Margin="316,108,0,0" VerticalAlignment="Top" Width="64"  FlowDirection="RightToLeft" Height="32" PreviewMouseDoubleClick="Lbl_usernam_PreviewMouseDoubleClick"/>
        <Label x:Name="label" Visibility="Collapsed"   Content="رمز عبور :"  HorizontalAlignment="Left" Margin="316,147,0,0" VerticalAlignment="Top" Width="54"  FlowDirection="RightToLeft" Height="30" Cursor="Hand" PreviewMouseLeftButtonUp="Label_PreviewMouseLeftButtonUp" />
        <materialDesign:PackIcon Kind="User" Visibility="Visible" PreviewMouseDoubleClick="Lbl_usernam_PreviewMouseDoubleClick" Margin="313,140,0,0" Height="30" Width="27"/>

        <ComboBox x:Name="CmbUsers" FlowDirection="RightToLeft"
                  IsEditable="True" Text="{Binding ElementName=Krbri,Path=Text,UpdateSourceTrigger=PropertyChanged}"
                  IsTextSearchEnabled="True"
                  StaysOpenOnEdit="True"
                  materialDesign:HintAssist.Hint="انتخاب کاربر"
                  DisplayMemberPath="SAL_NAME"
                  SelectedValuePath="IDD"
                  SelectionChanged="CmbUsers_SelectionChanged"
                  Margin="316,141,18,0" VerticalAlignment="Top"/>

        <TextBox x:Name="Krbri" HorizontalAlignment="Left" Visibility="Hidden" Height="28" Padding="3" materialDesign:HintAssist.Hint="نام کاربری" Margin="317,142,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="230" FlowDirection="RightToLeft" TextChanged="Krbri_TextChanged"/>

        <Label x:Name="VorudLabel" Content="ورود کاربران" Visibility="Collapsed" HorizontalContentAlignment="Center" Margin="0,56,1,0" VerticalAlignment="Top"  FlowDirection="RightToLeft" FontSize="14"  PreviewMouseLeftButtonUp="VorudLabel_PreviewMouseLeftButtonUp" Cursor="Hand"/>

        <Button x:Name="Greet" Content="ورود" Margin="0,273,21,0" Cursor="Hand"  
                GotFocus="Greet_GotFocus"
                LostFocus="Greet_LostFocus"
                Height="39" VerticalAlignment="Top" HorizontalAlignment="Right" Width="227" FontWeight="Bold" Click="Btn_Goin" Padding="0,-1,3,4" Foreground="White" BorderBrush="#00000000" FontSize="14" IsDefault="True" IsEnabled="False">
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="{Binding Background.Color, ElementName=GENERAL_RANG}" />
                </LinearGradientBrush>
            </Button.Background>
        </Button>

        <Popup  x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Center"  StaysOpen="False"  VerticalOffset="-4">
            <StackPanel>
                <Border x:Name="Pop_Border1" CornerRadius="7" Background="#FF007ACC" Height="auto">
                    <TextBox Padding="10" IsReadOnly="True" x:Name="Pop1Text1"   VerticalAlignment="Center" Background="{x:Null}"
                     Text="رمز عبور وارد شده صحیح نمی باشد" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="auto" Width="auto" BorderBrush="{x:Null}" SelectionBrush="{x:Null}" HorizontalAlignment="Center" Foreground="White"/>
                </Border>
            </StackPanel>
        </Popup>


        <Label x:Name="lblconnecting" Visibility="Hidden" Content=". . . در حال تست" HorizontalAlignment="Left" Margin="0,49,0,0" VerticalAlignment="Center" Height="271" Width="400" Background="#D8252526" Foreground="White" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"  FontSize="22"/>

        <CheckBox x:Name="dispass" Content="نمایش رمز"  HorizontalAlignment="Left" Margin="315,225,0,0" VerticalAlignment="Top" Width="78"  Height="21"  Unchecked="RemovedTick" Checked="PutedTick" Padding="5,-3,0,0" UseLayoutRounding="False" Cursor="Hand" Foreground="{Binding Foreground, ElementName=label}" FontSize="11"/>

        <PasswordBox x:Name="Rmzo"  CommandManager.PreviewExecuted="Rmzo_PreviewExecuted" Padding="3"  materialDesign:HintAssist.Hint="رمز عبور"  ContextMenu="{x:Null}" HorizontalAlignment="Left" Height="28" Margin="317,187,0,0" VerticalAlignment="Top" Width="230" FlowDirection="RightToLeft" PasswordChanged="Rmzo_PasswordChanged"/>
        <TextBox x:Name="SecoRmzo"  Visibility="Hidden" HorizontalAlignment="Left"   materialDesign:HintAssist.Hint="رمز عبور" Padding="3" Height="28" Margin="313,192,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="230" FlowDirection="RightToLeft"  CommandManager.PreviewExecuted="SecoRmzo_PreviewExecuted"  ContextMenu="{x:Null}"  TextChanged="SecoRmzo_TextChanged" />
        <ComboBox x:Name="mycmb" HorizontalAlignment="Left" Margin="313,199,0,0" VerticalAlignment="Top" Width="135" Background="White" Visibility="Collapsed"/>
        <Label x:Name="cnnparamlbl" Visibility="Hidden" Cursor="Hand" Content="اتصال به دیتابیس" Margin="9,274,411,10"  MouseLeftButtonUp="cnnparamlbl_MouseLeftButtonUp" FontSize="10"/>
        <Border BorderThickness="1" CornerRadius="1,1,1,10" HorizontalAlignment="Left" Height="328" Margin="-1,48,0,0" VerticalAlignment="Top" Width="291">
            <Border.Background>
                <!--<LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF5AEBDC" Offset="0"/>
                    <GradientStop Color="#FF1BBBEF" Offset="1"/>
                </LinearGradientBrush>-->
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="{Binding Background.Color, ElementName=GENERAL_RANG}" Offset="0"/>
                    <GradientStop Color="{Binding Background.Color, ElementName=GENERAL_RANG}" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <materialDesign:PackIcon Kind="Password" Margin="312,189,0,0" Visibility="Visible" Height="23" Width="26"/>
        <Label x:Name="SD_Status" Content="Server : SERVER1      Database : COR1"  VerticalContentAlignment="Center" HorizontalAlignment="Left" Height="26" Margin="10,339,0,0" VerticalAlignment="Top" Width="275"  Foreground="#DDFFFFFF" FontSize="9"/>
        <Button  Cursor="Hand" Margin="0,0,4,15" Content="اتصال به پایگاه داده" Click="Button_Click_1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Height="27" Width="124" FontSize="11" Background="{x:Null}" BorderBrush="{x:Null}" />
        <Label HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="0,52,280,39" Foreground="#DDFFFFFF" FontSize="30" FontFamily="/WpfApp5;component/FNT/#Raleway Light" IsHitTestVisible="False" d:IsLocked="True">Mr Correct</Label>
        <Label x:Name="lbloader" Content="در حال ورود به سیستم ..." HorizontalContentAlignment="Center" Visibility="Collapsed" VerticalContentAlignment="Center"   Background="#BF1B1B1C" Foreground="White" FontSize="16" FlowDirection="RightToLeft"/>
        <Label x:Name="LBL_VERSION" Content="Version 1.0.0.396 Date : 1405/01/30" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="288,335,129,16" FontSize="9" PreviewMouseDoubleClick="LBL_VERSION_PreviewMouseDoubleClick" />

        <!--SmallDarkOverlay:-->
        <Border CornerRadius="10,10,0,0" Margin="0,0,0,325" Background="#11000000" IsHitTestVisible="False" Focusable="False">
            <Border.Effect>
                <BlurEffect Radius="1"/>
            </Border.Effect>
        </Border>

        <Border CornerRadius="0,0,0,10" Margin="0,50,276,0" Background="#11000000" Focusable="False">
            <Border.Effect>
                <BlurEffect Radius="1"/>
            </Border.Effect>
        </Border>


        <!-- Update Progress UI -->
        <Border x:Name="UpdatePanel" Visibility="Collapsed" CornerRadius="10" Background="#E6212121" Width="450" Height="210" VerticalAlignment="Center" HorizontalAlignment="Center" Panel.ZIndex="1000">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="CloudDownload" Width="50" Height="50" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,15" />

                <Label Content="در حال دانلود نسخه جدید..." Foreground="White" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,10" FontFamily="{StaticResource IRANYEKAN}"/>

                <ProgressBar x:Name="UpdatePrg" Width="350" Height="15" Minimum="0" Maximum="100" BorderBrush="White" BorderThickness="1" Background="Transparent" Foreground="#FF4CAF50"/>

                <Label x:Name="UpdateLbl" Content="0%" Foreground="White" HorizontalAlignment="Center" Margin="0,5,0,0" FontSize="14" FontFamily="{StaticResource IRANYEKAN}"/>

                <TextBlock Text="(پس از اتمام برنامه خودکار باز خواهد شد)" 
                           Foreground="#CCFFFFFF" 
                           FontSize="11" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,0" 
                           FontFamily="{StaticResource IRANYEKAN}"/>
            </StackPanel>
        </Border>

    </Grid>
</Window>
