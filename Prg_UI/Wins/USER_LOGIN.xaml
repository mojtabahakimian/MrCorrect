<Window x:Class="Prg_UI.Wins.USER_LOGIN"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        mc:Ignorable="d"
        FontFamily="{StaticResource IRANYEKAN}"
        Title=""
        Width="720" Height="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        ContentRendered="Window_ContentRendered"
        PreviewKeyDown="Window_PreviewKeyDown"
        Closing="Window_Closing"
        Foreground="{Binding Background, ElementName=Greet}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Soft Card Shadow -->
        <DropShadowEffect x:Key="CardShadow"
                          BlurRadius="28"
                          ShadowDepth="6"
                          Direction="270"
                          Color="#000000"
                          Opacity="0.25"/>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#29B6F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="10"
                                Padding="15,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#03A9F4"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0288D1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#CFD8DC"/>
                                <Setter Property="Foreground" Value="#78909C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Responsive Input Styles -->
        <Style x:Key="ModernTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignFloatingHintTextBox}">
            <Setter Property="materialDesign:HintAssist.HintOpacity" Value="0.6"/>
            <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="#29B6F6"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignFloatingHintPasswordBox}">
            <Setter Property="materialDesign:HintAssist.HintOpacity" Value="0.6"/>
            <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="#29B6F6"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignFloatingHintComboBox}">
            <Setter Property="materialDesign:HintAssist.HintOpacity" Value="0.6"/>
            <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="#29B6F6"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="grid">
        <!-- Hidden theme helper -->
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Width="1" IsHitTestVisible="False" Focusable="False" IsTabStop="False"/>

        <!-- Window Main Card -->
        <Border x:Name="Brd"
                CornerRadius="16"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                Effect="{StaticResource CardShadow}"
                Margin="12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ========== LEFT BRAND PANEL ========== -->
                <Border Grid.Column="0" CornerRadius="15,0,0,15" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4FC3F7" Offset="0"/>
                            <GradientStop Color="#29B6F6" Offset="0.5"/>
                            <GradientStop Color="#03A9F4" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <!-- Background Decorative Shapes -->
                        <Ellipse Width="180" Height="180" Fill="#20FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-60,-40,0,0"/>
                        <Ellipse Width="130" Height="130" Fill="#15FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-30,-20"/>

                        <!-- Branding Logo/Text -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                            <TextBlock Text="Mr Correct"
                                       FontSize="32"
                                       FontWeight="Light"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       FontFamily="Segoe UI Light, IRANYEKAN"/>
                        </StackPanel>

                        <!-- Server Status Info -->
                        <Label x:Name="SD_Status"
                               Content="SERVER : MERCEDES\SQL2022&#10;DATABASE : NEWFOODRIP05"
                               FontSize="9.5"
                               Foreground="#E0F7FA"
                               VerticalAlignment="Bottom"
                               HorizontalAlignment="Left"
                               Margin="16,0,16,14"
                               Padding="0"/>
                    </Grid>
                </Border>

                <!-- ========== RIGHT FORM PANEL ========== -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="46"/>
                    </Grid.RowDefinitions>

                    <!-- TitleBar Window Buttons -->
                    <Border Grid.Row="0" Background="Transparent">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,4,8,0">
                            <Button x:Name="Btn_Minimize"
                                    Click="Btn_Minimize_Click"
                                    Width="32" Height="28"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    IsTabStop="False"
                                    ToolTip="کوچک کردن">
                                <materialDesign:PackIcon Kind="WindowMinimize" Width="14" Height="14" Foreground="#78909C"/>
                            </Button>
                            <Button x:Name="Btn_Close"
                                    Click="Button_Click"
                                    Width="32" Height="28"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    IsTabStop="False"
                                    ToolTip="بستن">
                                <materialDesign:PackIcon Kind="WindowClose" Width="14" Height="14" Foreground="#78909C"/>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Login Form Body -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="38,0,38,0" FlowDirection="RightToLeft">

                        <TextBlock Text="ورود به سیستم"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   Foreground="#263238"
                                   HorizontalAlignment="Left"
                                   Margin="0,0,0,20"/>

                        <!-- User Selection Dropdown -->
                        <ComboBox x:Name="CmbUsers"
                                  Style="{StaticResource ModernComboBox}"
                                  materialDesign:HintAssist.Hint="انتخاب کاربر"
                                  IsEditable="True"
                                  IsTextSearchEnabled="True"
                                  StaysOpenOnEdit="True"
                                  DisplayMemberPath="SAL_NAME"
                                  SelectedValuePath="IDD"
                                  SelectionChanged="CmbUsers_SelectionChanged"
                                  Text="{Binding ElementName=Krbri, Path=Text, UpdateSourceTrigger=PropertyChanged}"
                                  FlowDirection="RightToLeft"/>

                        <TextBox x:Name="Krbri" Visibility="Hidden" TextChanged="Krbri_TextChanged"/>

                        <!-- Password Field -->
                        <PasswordBox x:Name="Rmzo"
                                     Style="{StaticResource ModernPasswordBox}"
                                     materialDesign:HintAssist.Hint="رمز عبور"
                                     PasswordChanged="Rmzo_PasswordChanged"
                                     CommandManager.PreviewExecuted="Rmzo_PreviewExecuted"
                                     ContextMenu="{x:Null}"
                                     FlowDirection="RightToLeft"/>

                        <TextBox x:Name="SecoRmzo"
                                 Visibility="Hidden"
                                 Style="{StaticResource ModernTextBox}"
                                 materialDesign:HintAssist.Hint="رمز عبور"
                                 TextChanged="SecoRmzo_TextChanged"
                                 CommandManager.PreviewExecuted="SecoRmzo_PreviewExecuted"
                                 ContextMenu="{x:Null}"
                                 FlowDirection="RightToLeft"/>

                        <!-- Show Password Option -->
                        <CheckBox x:Name="dispass"
                                  Content="نمایش رمز"
                                  Margin="0,4,0,20"
                                  FontSize="12"
                                  Foreground="#546E7A"
                                  Cursor="Hand"
                                  Checked="PutedTick"
                                  Unchecked="RemovedTick"
                                  HorizontalAlignment="Right"/>

                        <!-- Submit Button -->
                        <Button x:Name="Greet"
                                Content="ورود"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="Btn_Goin"
                                GotFocus="Greet_GotFocus"
                                LostFocus="Greet_LostFocus"
                                IsDefault="True"
                                IsEnabled="False"
                                HorizontalAlignment="Stretch"/>
                    </StackPanel>

                    <!-- Footer Section -->
                    <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,15,0" Padding="24,0">
                        <Grid>
                            <Label x:Name="LBL_VERSION"
                                   Content="Version 1.0.0.396  •  Date : 1405/01/30"
                                   FontSize="10.5"
                                   Foreground="#94A3B8"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Padding="0"
                                   PreviewMouseDoubleClick="LBL_VERSION_PreviewMouseDoubleClick"/>

                            <Button Content="اتصال به پایگاه داده"
                                    Click="Button_Click_1"
                                    FontSize="11.5"
                                    Foreground="#29B6F6"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Padding="4,2"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ========== OVERLAYS & POPUPS ========== -->

        <!-- Connection Loader -->
        <Label x:Name="lblconnecting"
               Visibility="Hidden"
               Content=". . . در حال تست"
               Background="#D8252526"
               Foreground="White"
               FontSize="20"
               HorizontalContentAlignment="Center"
               VerticalContentAlignment="Center"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"/>

        <!-- Login Loader -->
        <Label x:Name="lbloader"
               Content="در حال ورود به سیستم ..."
               Visibility="Collapsed"
               Background="#BF1B1B1C"
               Foreground="White"
               FontSize="16"
               FlowDirection="RightToLeft"
               HorizontalContentAlignment="Center"
               VerticalContentAlignment="Center"/>

        <!-- Password Error Popup -->
        <Popup x:Name="Pop1"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Placement="Center"
               StaysOpen="False"
               VerticalOffset="-4">
            <Border x:Name="Pop_Border1"
                    CornerRadius="10"
                    Background="#EF5350"
                    Padding="20,12"
                    Effect="{StaticResource CardShadow}">
                <TextBox x:Name="Pop1Text1"
                         IsReadOnly="True"
                         Text="رمز عبور وارد شده صحیح نمی باشد"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="White"
                         FontSize="13"
                         HorizontalContentAlignment="Center"
                         VerticalContentAlignment="Center"/>
            </Border>
        </Popup>

        <!-- Auto Update Panel -->
        <Border x:Name="UpdatePanel"
                Visibility="Collapsed"
                CornerRadius="14"
                Background="#E6212121"
                Width="400"
                Height="200"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Panel.ZIndex="1000"
                Effect="{StaticResource CardShadow}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="CloudDownload" Width="44" Height="44" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="در حال دانلود نسخه جدید..." Foreground="White" FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <ProgressBar x:Name="UpdatePrg" Width="300" Height="8" Minimum="0" Maximum="100" BorderThickness="0" Background="#40FFFFFF" Foreground="#4FC3F7" Margin="0,0,0,8"/>
                <Label x:Name="UpdateLbl" Content="0%" Foreground="White" HorizontalAlignment="Center" FontSize="13" Padding="0"/>
                <TextBlock Text="(پس از اتمام برنامه خودکار باز خواهد شد)" Foreground="#BBFFFFFF" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Hidden Legacy Elements for Backend Compatibility -->
        <Label x:Name="Lbl_usernam" Visibility="Collapsed"/>
        <Label x:Name="label" Visibility="Collapsed"/>
        <Label x:Name="VorudLabel" Visibility="Collapsed"/>
        <Label x:Name="cnnparamlbl" Visibility="Hidden"/>
        <ComboBox x:Name="mycmb" Visibility="Collapsed"/>
        <materialDesign:PackIcon Kind="User" Visibility="Collapsed"/>
        <materialDesign:PackIcon Kind="Password" Visibility="Collapsed"/>
    </Grid>
</Window>