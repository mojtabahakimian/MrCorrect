<Window x:Class="Prg_UI.Wins.USER_LOGIN"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.Wins"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:CNC="clr-namespace:Prg_UI.CUC"
        mc:Ignorable="d"
        Title="" Width="700" Height="460"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FontFamily="{StaticResource IRANYEKAN}" UseLayoutRounding="True"
        Loaded="Window_Loaded" ContentRendered="Window_ContentRendered"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Soft Ambient Shadow -->
        <DropShadowEffect x:Key="CardShadow" BlurRadius="28" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.22"/>

        <!-- Minimize Button Style -->
        <Style x:Key="CaptionBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1F000000"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3D000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Close Button Style -->
        <Style x:Key="CloseBtnStyle" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C10B1A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Custom Animated CheckBox -->
        <Style x:Key="ModernCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" VerticalAlignment="Center">
                            <Grid Width="18" Height="18">
                                <Border x:Name="Box" CornerRadius="5" Background="White" BorderBrush="#CBD5E1" BorderThickness="1.5"/>
                                <Border x:Name="Fill" CornerRadius="5" Background="#29B6F6" Opacity="0"/>
                                <materialDesign:PackIcon x:Name="Check" Kind="Check" Width="14" Height="14" Foreground="White" 
                                                         HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0"/>
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Fill" Property="Opacity" Value="1"/>
                                <Setter TargetName="Check" Property="Opacity" Value="1"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="#29B6F6"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#03A9F4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Primary Button Style -->
        <Style x:Key="PrimaryBtnStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root">
                            <Border x:Name="Glow" CornerRadius="12" Background="#29B6F6" Opacity="0.3" Margin="0,3,0,-2">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Direction="270" Color="#0288D1" Opacity="0.4"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="Base" CornerRadius="12">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#4FC3F7" Offset="0"/>
                                        <GradientStop Color="#0288D1" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="0.6"/>
                                <Setter TargetName="Base" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Base" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                                <Setter TargetName="Glow" Property="Opacity" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fixed Input Container Styles -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignFilledComboBox}">
            <Setter Property="materialDesign:HintAssist.HintOpacity" Value="0.55"/>
            <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="#29B6F6"/>
            <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="10"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignFilledPasswordBox}">
            <Setter Property="materialDesign:HintAssist.HintOpacity" Value="0.55"/>
            <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="#29B6F6"/>
            <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="10"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignFilledTextBox}">
            <Setter Property="materialDesign:HintAssist.HintOpacity" Value="0.55"/>
            <Setter Property="materialDesign:TextFieldAssist.UnderlineBrush" Value="#29B6F6"/>
            <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="10"/>
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="grid">

        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Width="1" Height="1" IsHitTestVisible="False" Focusable="False" IsTabStop="False"/>

        <!-- Main Window Frame -->
        <Border x:Name="Brd" Margin="12" CornerRadius="18"
                Background="White"
                BorderBrush="#E2E8F0" BorderThickness="1"
                Effect="{StaticResource CardShadow}"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
            </Border.RenderTransform>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ========== LEFT BRAND PANEL (Sky Blue Gradient) ========== -->
                <Border Grid.Column="0" CornerRadius="17,0,0,17" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4FC3F7" Offset="0"/>
                            <GradientStop Color="#29B6F6" Offset="0.5"/>
                            <GradientStop Color="#0288D1" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <!-- Soft Abstract Background Bubbles -->
                        <Ellipse Width="190" Height="190" Fill="#20FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-70,-50,0,0"/>
                        <Ellipse Width="130" Height="130" Fill="#15FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-40,-30"/>

                        <!-- App Branding -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                            <Border Width="72" Height="72" CornerRadius="36" Background="#26FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <materialDesign:PackIcon Kind="AccountCheckOutline" Width="40" Height="40" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="Mr Correct" FontSize="30" FontWeight="Light" Foreground="White" HorizontalAlignment="Center" FontFamily="Segoe UI Light, IRANYEKAN"/>
                            <Border Height="2" Width="40" CornerRadius="1" Background="#60FFFFFF" Margin="0,8,0,8"/>
                            <TextBlock Text="سیستم مدیریت هوشمند" FontSize="12" Foreground="#E0F7FA" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Server Info Footer -->
                        <Label x:Name="SD_Status"
                               Content="SERVER : MERCEDES\SQL2022&#10;DATABASE : NEWFOODRIP05"
                               FontSize="9.5" Foreground="#E0F7FA"
                               VerticalAlignment="Bottom" HorizontalAlignment="Left"
                               Margin="16,0,16,14" Padding="0"/>
                    </Grid>
                </Border>

                <!-- ========== RIGHT FORM PANEL ========== -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="38"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="46"/>
                    </Grid.RowDefinitions>

                    <!-- Drag TitleBar Controls -->
                    <Border x:Name="TitleDrawBar" Grid.Row="0" Style="{StaticResource BordG}" Background="Transparent">
                        <Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,2,8,0">
                                <Button x:Name="Btn_Minimize" Style="{StaticResource CaptionBtnStyle}" Click="Btn_Minimize_Click" ToolTip="کوچک کردن">
                                    <materialDesign:PackIcon Kind="WindowMinimize" Width="14" Height="14" Foreground="#64748B"/>
                                </Button>
                                <Button x:Name="Btn_Close" Style="{StaticResource CloseBtnStyle}" Click="Button_Click" ToolTip="بستن">
                                    <materialDesign:PackIcon Kind="WindowClose" Width="14" Height="14" Foreground="#64748B"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main Login Form -->
                    <Grid Grid.Row="1" Margin="36,0,36,0" FlowDirection="RightToLeft">
                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="ورود به سیستم" FontSize="20" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,18"/>

                            <!-- User Selection Dropdown -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon Kind="AccountOutline" Width="22" Height="22" Foreground="#29B6F6" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                                <Grid Grid.Column="1">
                                    <ComboBox x:Name="CmbUsers"
                                              Style="{StaticResource ModernComboBox}"
                                              materialDesign:HintAssist.Hint="انتخاب کاربر"
                                              IsEditable="True" IsTextSearchEnabled="True" StaysOpenOnEdit="True"
                                              DisplayMemberPath="SAL_NAME" SelectedValuePath="IDD"
                                              SelectionChanged="CmbUsers_SelectionChanged"
                                              Text="{Binding ElementName=Krbri, Path=Text, UpdateSourceTrigger=PropertyChanged}"
                                              FlowDirection="RightToLeft"/>

                                    <TextBox x:Name="Krbri" Visibility="Hidden" TextChanged="Krbri_TextChanged"/>
                                </Grid>
                            </Grid>

                            <!-- Password Input -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <materialDesign:PackIcon Kind="LockOutline" Width="21" Height="21" Foreground="#29B6F6" VerticalAlignment="Center" HorizontalAlignment="Left"/>

                                <Grid Grid.Column="1">
                                    <PasswordBox x:Name="Rmzo"
                                                 Style="{StaticResource ModernPasswordBox}"
                                                 materialDesign:HintAssist.Hint="رمز عبور"
                                                 PasswordChanged="Rmzo_PasswordChanged"
                                                 CommandManager.PreviewExecuted="Rmzo_PreviewExecuted"
                                                 ContextMenu="{x:Null}" FlowDirection="RightToLeft"/>

                                    <TextBox x:Name="SecoRmzo" Visibility="Hidden"
                                             Style="{StaticResource ModernTextBox}"
                                             materialDesign:HintAssist.Hint="رمز عبور"
                                             TextChanged="SecoRmzo_TextChanged"
                                             CommandManager.PreviewExecuted="SecoRmzo_PreviewExecuted"
                                             ContextMenu="{x:Null}" FlowDirection="RightToLeft"/>
                                </Grid>
                            </Grid>

                            <!-- Show Password Checkbox -->
                            <DockPanel Margin="30,4,0,18" FlowDirection="RightToLeft">
                                <CheckBox x:Name="dispass" Content="نمایش رمز" Style="{StaticResource ModernCheckBoxStyle}"
                                          FontSize="12" Checked="PutedTick" Unchecked="RemovedTick"/>
                            </DockPanel>

                            <!-- Submit Button -->
                            <Button x:Name="Greet" Content="ورود"
                                    Style="{StaticResource PrimaryBtnStyle}"
                                    Click="Btn_Goin" GotFocus="Greet_GotFocus" LostFocus="Greet_LostFocus"
                                    IsDefault="True" IsEnabled="False" HorizontalAlignment="Stretch"/>
                        </StackPanel>
                    </Grid>

                    <!-- Footer Options -->
                    <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="0,0,17,0" Padding="20,0">
                        <Grid>
                            <Label x:Name="LBL_VERSION"
                                   Content="Version 1.0.0.396  •  Date : 1405/01/30"
                                   FontSize="10" Foreground="#94A3B8"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   Padding="0" PreviewMouseDoubleClick="LBL_VERSION_PreviewMouseDoubleClick"/>

                            <Button Content="اتصال به پایگاه داده"
                                    Click="Button_Click_1"
                                    FontSize="11" Foreground="#0288D1"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" HorizontalAlignment="Right"
                                    VerticalAlignment="Center" Padding="4,2"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- ========== POPUPS & OVERLAYS ========== -->

        <!-- Connection Loader -->
        <Label x:Name="lblconnecting" Visibility="Hidden" Content=". . . در حال تست"
               Background="#D8252526" Foreground="White" FontSize="20"
               HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <!-- Main Login Loader -->
        <Label x:Name="lbloader" Content="در حال ورود به سیستم ..." Visibility="Collapsed"
               Background="#BF1B1B1C" Foreground="White" FontSize="16" FlowDirection="RightToLeft"
               HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>

        <!-- Error Alert Popup -->
        <Popup x:Name="Pop1" AllowsTransparency="True" PopupAnimation="Fade" Placement="Center" StaysOpen="False" VerticalOffset="-4">
            <Border x:Name="Pop_Border1" CornerRadius="10" Background="#EF5350" Padding="18,10" Effect="{StaticResource CardShadow}">
                <TextBox x:Name="Pop1Text1" IsReadOnly="True" Text="رمز عبور وارد شده صحیح نمی باشد"
                         Background="Transparent" BorderThickness="0" Foreground="White"
                         FontSize="13" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
            </Border>
        </Popup>

        <!-- Auto Update Panel -->
        <Border x:Name="UpdatePanel" Visibility="Collapsed" CornerRadius="14" Background="#E6212121"
                Width="400" Height="200" VerticalAlignment="Center" HorizontalAlignment="Center"
                Panel.ZIndex="1000" Effect="{StaticResource CardShadow}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="CloudDownload" Width="44" Height="44" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="در حال دانلود نسخه جدید..." Foreground="White" FontSize="15" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <ProgressBar x:Name="UpdatePrg" Width="300" Height="8" Minimum="0" Maximum="100" BorderThickness="0" Background="#40FFFFFF" Foreground="#4FC3F7" Margin="0,0,0,8"/>
                <Label x:Name="UpdateLbl" Content="0%" Foreground="White" HorizontalAlignment="Center" FontSize="13" Padding="0"/>
                <TextBlock Text="(پس از اتمام برنامه خودکار باز خواهد شد)" Foreground="#BBFFFFFF" FontSize="11" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- Hidden Legacy Elements for Backend Compatibility -->
        <Label x:Name="Lbl_usernam" Visibility="Collapsed" PreviewMouseDoubleClick="Lbl_usernam_PreviewMouseDoubleClick"/>
        <Label x:Name="label" Visibility="Collapsed" PreviewMouseLeftButtonUp="Label_PreviewMouseLeftButtonUp"/>
        <Label x:Name="VorudLabel" Visibility="Collapsed" PreviewMouseLeftButtonUp="VorudLabel_PreviewMouseLeftButtonUp"/>
        <Label x:Name="cnnparamlbl" Visibility="Hidden" MouseLeftButtonUp="cnnparamlbl_MouseLeftButtonUp"/>
        <ComboBox x:Name="mycmb" Visibility="Collapsed"/>
    </Grid>

    <!-- Smooth Entrance Animation -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Brd" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Brd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.97" To="1" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Brd" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.97" To="1" Duration="0:0:0.35">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
</Window>