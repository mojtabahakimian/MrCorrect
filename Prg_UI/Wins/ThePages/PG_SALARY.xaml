<Page x:Class="Wins.ThePages.PG_SALARY"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Wins.ThePages"
      mc:Ignorable="d" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      FontFamily="{StaticResource IRANYEKAN}"
      d:DesignHeight="900" d:DesignWidth="1000"
      Title="PG_HESABDARI_SUB">
    <Page.Resources>
        <Storyboard x:Key="OnMouseCome">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)">
                <EasingDoubleKeyFrame KeyTime="00:00:00" Value="2"/>
                <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="31">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ExponentialEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="OnMouseLeave">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)">
                <SplineDoubleKeyFrame KeyTime="00:00:00" Value="31"/>
                <SplineDoubleKeyFrame KeyTime="00:00:00.2000000" Value="2"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
        <Storyboard x:Key="OnMousePressed">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.ShadowDepth)">
                <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ExponentialEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="10">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ExponentialEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="00:00:00.4000000" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ExponentialEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)">
                <EasingDoubleKeyFrame KeyTime="00:00:00" Value="0">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ExponentialEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="40">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ExponentialEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="00:00:00.4000000" Value="2">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ExponentialEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
            <ColorAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Color)">
                <EasingColorKeyFrame KeyTime="00:00:00" Value="White">
                    <EasingColorKeyFrame.EasingFunction>
                        <ExponentialEase EasingMode="EaseInOut"/>
                    </EasingColorKeyFrame.EasingFunction>
                </EasingColorKeyFrame>
            </ColorAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Direction)">
                <EasingDoubleKeyFrame KeyTime="00:00:00" Value="315">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ExponentialEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="00:00:00.2000000" Value="600">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ExponentialEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
                <EasingDoubleKeyFrame KeyTime="00:00:00.4000000" Value="315">
                    <EasingDoubleKeyFrame.EasingFunction>
                        <ExponentialEase EasingMode="EaseInOut"/>
                    </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>

        <Style TargetType="Image" x:Key="LightyBlue">
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="White" Direction="0" ShadowDepth="0" BlurRadius="2"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard Storyboard="{StaticResource OnMouseCome}" />
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard Storyboard="{StaticResource OnMouseLeave}" />
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseDown">
                    <BeginStoryboard Storyboard="{StaticResource OnMousePressed}" />
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeftButtonUp">
                    <BeginStoryboard Storyboard="{StaticResource OnMouseCome}" />
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="{Binding Background.Color, ElementName=GENERAL_RANG}" Offset="0"/>
                <GradientStop Color="{Binding Background.Color, ElementName=GENERAL_RANG}" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Button x:Name="GENERAL_RANG" Visibility="Collapsed" Width="1" IsHitTestVisible="False" Focusable="False" IsTabStop="False"/>

        <Button x:Name="BackerBtn" Margin="10,10,0,0" FontSize="20"  Height="28" FontFamily="Tahoma" Foreground="White" Width="35" Padding="1,-2,1,1" IsTabStop="False" Background="{x:Null}" BorderBrush="Transparent" Click="BackerBtn_Click" VerticalAlignment="Top" HorizontalAlignment="Left" >
            <materialDesign:PackIcon Kind="ArrowBack" Height="23" Width="25" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
        </Button>

        <!--HEADER-->

        <ScrollViewer FlowDirection="RightToLeft" Margin="50,35,50,20" VerticalScrollBarVisibility="Auto">
            <ItemsControl>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                        <!--MotherbasePanel-->
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <StackPanel FlowDirection="RightToLeft" Orientation="Vertical" Width="315">
                    <WrapPanel FlowDirection="RightToLeft" Orientation="Horizontal">
                        <Image Stretch="Uniform" Style="{StaticResource LightyBlue}" Width="78" Height="77" VerticalAlignment="Top" Cursor="Hand">
                            <Image.Source>
                                <BitmapImage DecodePixelWidth="130" DecodePixelHeight="130" UriSource="/UiDrive/IMGS/PICMENU/SALARY/User_Detail.png" CacheOption="OnLoad"/>
                            </Image.Source>
                        </Image>
                        <Label Content="تعریف مشخصات پرسنل" Foreground="#DDFFFFFF" Height="27"/>
                    </WrapPanel>

                    <WrapPanel FlowDirection="RightToLeft" Orientation="Horizontal">
                        <Image Stretch="Uniform" Style="{StaticResource LightyBlue}" Width="78" Height="77" VerticalAlignment="Top" Cursor="Hand">
                            <Image.Source>
                                <BitmapImage DecodePixelWidth="130" DecodePixelHeight="130" UriSource="/UiDrive/IMGS/PICMENU/SALARY/Hokm.png" CacheOption="OnLoad"/>
                            </Image.Source>
                        </Image>
                        <Label Content="صدور احکام پرسنل" Foreground="#DDFFFFFF" Height="27"/>
                    </WrapPanel>

                    <WrapPanel FlowDirection="RightToLeft" Orientation="Horizontal">
                        <Image Stretch="Uniform" Style="{StaticResource LightyBlue}" PreviewMouseDown="Image_PreviewMouseDown" Width="78" Height="77" VerticalAlignment="Top" Cursor="Hand">
                            <Image.Source>
                                <BitmapImage DecodePixelWidth="130" DecodePixelHeight="130" UriSource="/UiDrive/IMGS/PICMENU/SALARY/User_DayOff.png" CacheOption="OnLoad"/>
                            </Image.Source>
                        </Image>
                        <Label Content="ثبت و ویرایش مرخصی پرسنل" Foreground="#DDFFFFFF" Height="27"/>
                    </WrapPanel>

                    <WrapPanel FlowDirection="RightToLeft" Orientation="Horizontal">
                        <Image Stretch="Uniform" Style="{StaticResource LightyBlue}" Width="78" Height="77" VerticalAlignment="Top" Cursor="Hand">
                            <Image.Source>
                                <BitmapImage DecodePixelWidth="130" DecodePixelHeight="130" UriSource="/UiDrive/IMGS/PICMENU/SALARY/Gharardad.png" CacheOption="OnLoad"/>
                            </Image.Source>
                        </Image>
                        <Label Content="ثبت و ویرایش قرارداد پرسنل" Foreground="#DDFFFFFF" Height="27"/>
                    </WrapPanel>

                    <WrapPanel FlowDirection="RightToLeft" Orientation="Horizontal">
                        <Image Stretch="Uniform" Style="{StaticResource LightyBlue}" Width="78" Height="77" VerticalAlignment="Top" Cursor="Hand">
                            <Image.Source>
                                <BitmapImage DecodePixelWidth="130" DecodePixelHeight="130" UriSource="/UiDrive/IMGS/PICMENU/SALARY/Koosoorat.png" CacheOption="OnLoad"/>
                            </Image.Source>
                        </Image>
                        <Label Content="سایر کسورات و صندوق کارکنان" Foreground="#DDFFFFFF" Height="27"/>
                    </WrapPanel>

                    <WrapPanel FlowDirection="RightToLeft" Orientation="Horizontal">
                        <Image Stretch="Uniform" Style="{StaticResource LightyBlue}" Width="78" Height="77" VerticalAlignment="Top" Cursor="Hand">
                            <Image.Source>
                                <BitmapImage DecodePixelWidth="130" DecodePixelHeight="130" UriSource="/UiDrive/IMGS/PICMENU/SALARY/Vam.png" CacheOption="OnLoad"/>
                            </Image.Source>
                        </Image>
                        <Label Content="وام پرسنل" Foreground="#DDFFFFFF" Height="27"/>
                    </WrapPanel>

                    <WrapPanel FlowDirection="RightToLeft" Orientation="Horizontal">
                        <Image Stretch="Uniform" Style="{StaticResource LightyBlue}" Width="78" Height="77" VerticalAlignment="Top" Cursor="Hand">
                            <Image.Source>
                                <BitmapImage DecodePixelWidth="130" DecodePixelHeight="130" UriSource="/UiDrive/IMGS/PICMENU/SALARY/Full_Parvandeh.png" CacheOption="OnLoad"/>
                            </Image.Source>
                        </Image>
                        <Label Content="پرونده کامل پرسنل" Foreground="#DDFFFFFF" Height="27"/>
                    </WrapPanel>

                    <WrapPanel FlowDirection="RightToLeft" Orientation="Horizontal">
                        <Image Stretch="Uniform" Style="{StaticResource LightyBlue}" Width="78" Height="77" VerticalAlignment="Top" Cursor="Hand">
                            <Image.Source>
                                <BitmapImage DecodePixelWidth="130" DecodePixelHeight="130" UriSource="/UiDrive/IMGS/PICMENU/SALARY/Bill_List.png" CacheOption="OnLoad"/>
                            </Image.Source>
                        </Image>
                        <Label Content="چاپ لیست حقوق پرداختی پرسنل" Foreground="#DDFFFFFF" Height="27"/>
                    </WrapPanel>

                </StackPanel>


                <StackPanel FlowDirection="RightToLeft" Orientation="Vertical">

                    <WrapPanel FlowDirection="RightToLeft" Orientation="Horizontal">
                        <Image Stretch="Uniform" Style="{StaticResource LightyBlue}" Width="78" Height="77" VerticalAlignment="Top" Cursor="Hand">
                            <Image.Source>
                                <BitmapImage DecodePixelWidth="130" DecodePixelHeight="130" UriSource="/UiDrive/IMGS/PICMENU/SALARY/Bill_Hooghoogh.png" CacheOption="OnLoad"/>
                            </Image.Source>
                        </Image>
                        <Label Content="چاپ فیش حقوق ماهانه" Foreground="#DDFFFFFF" Height="27"/>
                    </WrapPanel>

                    <WrapPanel FlowDirection="RightToLeft" Orientation="Horizontal">
                        <Image Stretch="Uniform" Style="{StaticResource LightyBlue}" Width="78" Height="77" VerticalAlignment="Top" Cursor="Hand">
                            <Image.Source>
                                <BitmapImage DecodePixelWidth="130" DecodePixelHeight="130" UriSource="/UiDrive/IMGS/PICMENU/SALARY/BillPrint.png" CacheOption="OnLoad"/>
                            </Image.Source>
                        </Image>
                        <Label Content="چاپ فیش حقوق فقط پارامتر های حقوق" Foreground="#DDFFFFFF" Height="27"/>
                    </WrapPanel>

                    <WrapPanel FlowDirection="RightToLeft" Orientation="Horizontal">
                        <Image Stretch="Uniform" Style="{StaticResource LightyBlue}" Width="78" Height="77" VerticalAlignment="Top" Cursor="Hand">
                            <Image.Source>
                                <BitmapImage DecodePixelWidth="130" DecodePixelHeight="130" UriSource="/UiDrive/IMGS/PICMENU/SALARY/Bime_List.png" CacheOption="OnLoad"/>
                            </Image.Source>
                        </Image>
                        <Label Content="چاپ لیست بیمه" Foreground="#DDFFFFFF" Height="27"/>
                    </WrapPanel>

                    <WrapPanel FlowDirection="RightToLeft" Orientation="Horizontal">
                        <Image Stretch="Uniform" Style="{StaticResource LightyBlue}" Width="78" Height="77" VerticalAlignment="Top" Cursor="Hand">
                            <Image.Source>
                                <BitmapImage DecodePixelWidth="130" DecodePixelHeight="130" UriSource="/UiDrive/IMGS/PICMENU/SALARY/Bime_Disk.png" CacheOption="OnLoad"/>
                            </Image.Source>
                        </Image>
                        <Label Content="تهیه دیسکت بیمه" Foreground="#DDFFFFFF" Height="27"/>
                    </WrapPanel>

                    <WrapPanel FlowDirection="RightToLeft" Orientation="Horizontal">
                        <Image Stretch="Uniform" Style="{StaticResource LightyBlue}" Width="78" Height="77" VerticalAlignment="Top" Cursor="Hand">
                            <Image.Source>
                                <BitmapImage DecodePixelWidth="130" DecodePixelHeight="130" UriSource="/UiDrive/IMGS/PICMENU/SALARY/Bime_List.png" CacheOption="OnLoad"/>
                            </Image.Source>
                        </Image>
                        <Label Content="لیست مالیات حقوق پرسنل" Foreground="#DDFFFFFF" Height="27"/>
                    </WrapPanel>

                    <WrapPanel FlowDirection="RightToLeft" Orientation="Horizontal">
                        <Image Stretch="Uniform" Style="{StaticResource LightyBlue}" Width="78" Height="77" VerticalAlignment="Top" Cursor="Hand">
                            <Image.Source>
                                <BitmapImage DecodePixelWidth="130" DecodePixelHeight="130" UriSource="/UiDrive/IMGS/PICMENU/SALARY/Tax.png" CacheOption="OnLoad"/>
                            </Image.Source>
                        </Image>
                        <Label Content="تهیه فایل های مالیات" Foreground="#DDFFFFFF" Height="27"/>
                    </WrapPanel>

                    <WrapPanel FlowDirection="RightToLeft" Orientation="Horizontal">
                        <Image Stretch="Uniform" Style="{StaticResource LightyBlue}" Width="78" Height="77" VerticalAlignment="Top" Cursor="Hand">
                            <Image.Source>
                                <BitmapImage DecodePixelWidth="130" DecodePixelHeight="130" UriSource="/UiDrive/IMGS/PICMENU/SALARY/Eydi_Sanavat.png" CacheOption="OnLoad"/>
                            </Image.Source>
                        </Image>
                        <Label Content="محاسبه عیدی پاداش و سنوات پایان سال" Foreground="#DDFFFFFF" Height="27"/>
                    </WrapPanel>

                    <WrapPanel FlowDirection="RightToLeft" Orientation="Horizontal">
                        <Image Stretch="Uniform" Style="{StaticResource LightyBlue}" Width="78" Height="77" VerticalAlignment="Top" Cursor="Hand">
                            <Image.Source>
                                <BitmapImage DecodePixelWidth="130" DecodePixelHeight="130" UriSource="/UiDrive/IMGS/PICMENU/SALARY/CheckOut.png" CacheOption="OnLoad"/>
                            </Image.Source>
                        </Image>
                        <Label Content="تسویه حساب با پرسنل" Foreground="#DDFFFFFF" Height="27"/>
                    </WrapPanel>

                </StackPanel>

            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>