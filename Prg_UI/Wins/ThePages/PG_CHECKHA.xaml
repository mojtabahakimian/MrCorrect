                        <Image Stretch="Uniform" Style="{StaticResource LightyBlue}" PreviewMouseDown="Image_PreviewMouseDown_1" Width="78" Height="77" VerticalAlignment="Top" Cursor="Hand">
                            <Image.Source>
                                <BitmapImage DecodePixelWidth="130" DecodePixelHeight="130" UriSource="/UiDrive/IMGS/PICMENU/CHECKHA/Daftar_Daryafti.png" CacheOption="OnLoad"/>
                            </Image.Source>
                        </Image>
                        <Label Content="دفتر چکهای دریافتی" Foreground="#DDFFFFFF" Height="27"/>
