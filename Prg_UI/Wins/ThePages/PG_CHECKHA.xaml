                        </Image>
                        <Label Content="لیست چکهای پرداختی سررسید شده" Foreground="#DDFFFFFF" Height="27"/>
                    </WrapPanel>

                    <WrapPanel FlowDirection="RightToLeft" Orientation="Horizontal">
                        <Image Stretch="Uniform" Style="{StaticResource LightyBlue}" Width="78" PreviewMouseDown="Image_PreviewMouseDown_7" Height="77" VerticalAlignment="Top" Cursor="Hand">
                            <Image.Source>
                                <BitmapImage DecodePixelWidth="130" DecodePixelHeight="130" UriSource="/UiDrive/IMGS/PICMENU/CHECKHA/Pardakhti_Vosool_Nashode.png" CacheOption="OnLoad"/>
