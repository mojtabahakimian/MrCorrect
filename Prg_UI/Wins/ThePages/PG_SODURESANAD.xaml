        </Image>
        <Image Stretch="Uniform"  Style="{StaticResource LightyBlue}" HorizontalAlignment="Right" Width="68" Height="62" VerticalAlignment="Top" Cursor="Hand" Margin="0,160,23,0" PreviewMouseLeftButtonDown="Image_PreviewMouseLeftButtonDown_2" >
            <Image.Source>
                <BitmapImage DecodePixelWidth="130" DecodePixelHeight="130" UriSource="/UiDrive/IMGS/PICMENU/SayerMavadExit.png" CacheOption="OnLoad"/>
