        </Image>
        <Image Stretch="Uniform"  Style="{StaticResource LightyBlue}" HorizontalAlignment="Right" Width="68" Height="63" VerticalAlignment="Top" Cursor="Hand" Margin="0,92,284,0" PreviewMouseLeftButtonDown="Image_PreviewMouseLeftButtonDown_6" >
            <Image.Source>
