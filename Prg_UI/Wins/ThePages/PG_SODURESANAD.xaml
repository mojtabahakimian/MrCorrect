        <Label Content="بازسازی نرخ میانگین انبار" HorizontalAlignment="Right" Margin="0,312,352,0" Foreground="#DDFFFFFF" Height="28" VerticalAlignment="Top" FontSize="11"/>





    </Grid>
</Page>
