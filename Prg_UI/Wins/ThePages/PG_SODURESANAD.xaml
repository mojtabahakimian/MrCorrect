        </Image>
        <Image Stretch="Uniform"  Style="{StaticResource LightyBlue}" HorizontalAlignment="Right" Width="68" Height="63" VerticalAlignment="Top" Cursor="Hand" Margin="0,160,284,0" PreviewMouseLeftButtonDown="Image_PreviewMouseLeftButtonDown_7" >
            <Image.Source>
                <BitmapImage DecodePixelWidth="130" DecodePixelHeight="130" UriSource="/UiDrive/IMGS/PICMENU/DaryaftExit.png" CacheOption="OnLoad"/>
