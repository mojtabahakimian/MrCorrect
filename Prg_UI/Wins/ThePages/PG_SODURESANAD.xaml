        <Label Content="صدور اسناد برگشت فروش" HorizontalAlignment="Right" Margin="0,375,352,0" Foreground="#DDFFFFFF" Height="28" VerticalAlignment="Top" FontSize="11"/>
        <Image Stretch="Uniform"  Style="{StaticResource LightyBlue}" HorizontalAlignment="Right" Width="68" Height="63" VerticalAlignment="Top" Cursor="Hand" Margin="0,293,284,0" PreviewMouseLeftButtonDown="Image_PreviewMouseLeftButtonDown_10" >
            <Image.Source>
                <BitmapImage DecodePixelWidth="130" DecodePixelHeight="130" UriSource="/UiDrive/IMGS/PICMENU/MianginRepair.png" CacheOption="OnLoad"/>
