        <TextBlock Text="صدور سند برگه های ورود کالای ساخته شده" HorizontalAlignment="Right" Margin="0,245,95,0" Foreground="#DDFFFFFF" Height="38" VerticalAlignment="Top" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" Width="142"/>
        <Label Content="صدور سند های خزانه داری" HorizontalAlignment="Right" Margin="0,312,95,0" Foreground="#DDFFFFFF" Height="26" VerticalAlignment="Top" FontSize="11"/>
        <Label Content="صدور سند فاکتور های خدمات" HorizontalAlignment="Right" Margin="0,43,353,0" Foreground="#DDFFFFFF" Height="27" VerticalAlignment="Top" FontSize="11"/>
        <Label Content="انتقال کالا از انبار به انبار" HorizontalAlignment="Right" Margin="0,110,353,0" Foreground="#DDFFFFFF" Height="27" VerticalAlignment="Top" FontSize="11"/>
        <Label Content="صدور برگه های وصولی اسناد دریافتنی" HorizontalAlignment="Right" Margin="0,178,353,0" Foreground="#DDFFFFFF" Height="27" VerticalAlignment="Top" FontSize="11"/>
        <Image Stretch="Uniform"  Style="{StaticResource LightyBlue}" HorizontalAlignment="Right" Width="68" Height="62" VerticalAlignment="Top" Cursor="Hand" Margin="0,93,23,0" PreviewMouseLeftButtonDown="Image_PreviewMouseLeftButtonDown_1" >
            <Image.Source>
