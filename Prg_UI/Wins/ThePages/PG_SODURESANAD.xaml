        <Label Content="صدور سند انبار گردانی" HorizontalAlignment="Right" Margin="0,374,92,0" Foreground="#DDFFFFFF" Height="28" VerticalAlignment="Top" FontSize="11"/>

        <Image Stretch="Uniform"  Style="{StaticResource LightyBlue}" HorizontalAlignment="Right" Width="68" Height="63" VerticalAlignment="Top" Cursor="Hand" Margin="0,357,284,0" PreviewMouseLeftButtonDown="Image_PreviewMouseLeftButtonDown_11">
            <Image.Source>
