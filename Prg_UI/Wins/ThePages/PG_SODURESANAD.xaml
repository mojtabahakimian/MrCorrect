        </Image>
        <Image Stretch="Uniform"  Style="{StaticResource LightyBlue}" HorizontalAlignment="Right" Width="68" Height="62" VerticalAlignment="Top" Cursor="Hand" Margin="0,227,23,0" PreviewMouseLeftButtonDown="Image_PreviewMouseLeftButtonDown_3" >
            <Image.Source>
                <BitmapImage DecodePixelWidth="130" DecodePixelHeight="130" UriSource="/UiDrive/IMGS/PICMENU/KalaMadeEnter.png" CacheOption="OnLoad"/>
            </Image.Source>
        </Image>
        <Image Stretch="Uniform"  Style="{StaticResource LightyBlue}" HorizontalAlignment="Right" Width="68" Height="62" VerticalAlignment="Top" Cursor="Hand" Margin="0,294,23,0" PreviewMouseLeftButtonDown="Image_PreviewMouseLeftButtonDown_4" >
            <Image.Source>
                <BitmapImage DecodePixelWidth="130" DecodePixelHeight="130" UriSource="/UiDrive/IMGS/PICMENU/SanadKhazaneDari.png" CacheOption="OnLoad"/>
            </Image.Source>
        </Image>
        <Image Stretch="Uniform"  Style="{StaticResource LightyBlue}" HorizontalAlignment="Right" Width="68" Height="63" VerticalAlignment="Top" Cursor="Hand" Margin="0,25,284,0" PreviewMouseLeftButtonDown="Image_PreviewMouseLeftButtonDown_5" >
            <Image.Source>
                <BitmapImage DecodePixelWidth="130" DecodePixelHeight="130" UriSource="/UiDrive/IMGS/PICMENU/SanadFactorService.png" CacheOption="OnLoad"/>
