                        <Image.Source>
                            <BitmapImage DecodePixelWidth="130" DecodePixelHeight="130" UriSource="/UiDrive/IMGS/PICMENU/SMART_SALES/Nahve_Pardakht.png" CacheOption="OnLoad"/>
                        </Image.Source>
                    </Image>
