                        <Image.Source>
                            <BitmapImage DecodePixelWidth="130" DecodePixelHeight="130" UriSource="/UiDrive/IMGS/PICMENU/SMART_SALES/Mohasebe_Pardakht.png" CacheOption="OnLoad"/>
                        </Image.Source>
                    </Image>
                    <TextBlock Text="محاسبه تاخیر پرداخت ها"  TextAlignment="Center" TextWrapping="Wrap"  Foreground="#DDFFFFFF"  Height="40" Width="120"/>
                </WrapPanel>

                <WrapPanel FlowDirection="RightToLeft" Orientation="Vertical" Margin="10">
                    <Image Stretch="Uniform" Style="{StaticResource LightyBlue}" Width="78" Height="77" VerticalAlignment="Top" Cursor="Hand" Margin="5,0,0,0">
                        <Image.Source>
                            <BitmapImage DecodePixelWidth="130" DecodePixelHeight="130" UriSource="/UiDrive/IMGS/PICMENU/SMART_SALES/Enhesar.png" CacheOption="OnLoad"/>
