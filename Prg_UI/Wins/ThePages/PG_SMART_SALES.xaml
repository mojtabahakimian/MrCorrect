                        <Image.Source>
                            <BitmapImage DecodePixelWidth="130" DecodePixelHeight="130" UriSource="/UiDrive/IMGS/PICMENU/SMART_SALES/Elamieh_Takhfif.png" CacheOption="OnLoad"/>
                        </Image.Source>
                    </Image>
                    <TextBlock Text="اعلامیه قیمت"  TextAlignment="Center" TextWrapping="Wrap"  Foreground="#DDFFFFFF"  Height="40" Width="120"/>
                </WrapPanel>

