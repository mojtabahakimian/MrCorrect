                </WrapPanel>

                <WrapPanel FlowDirection="RightToLeft" Orientation="Vertical" Margin="10">
                    <Image Stretch="Uniform" Style="{StaticResource LightyBlue}" Width="78" PreviewMouseDown="Image_PreviewMouseDown_4" Height="77" VerticalAlignment="Top" Cursor="Hand" Margin="5,0,0,0">
                        <Image.Source>
                            <BitmapImage DecodePixelWidth="130" DecodePixelHeight="130" UriSource="/UiDrive/IMGS/PICMENU/SMART_SALES/Grade_Shart.png" CacheOption="OnLoad"/>
                        </Image.Source>
                    </Image>
                    <TextBlock Text="تعریف شروط برای گرید"  TextAlignment="Center" TextWrapping="Wrap"  Foreground="#DDFFFFFF"  Height="40" Width="120"/>
                </WrapPanel>

                <WrapPanel FlowDirection="RightToLeft" Orientation="Vertical" Margin="10">
                    <Image Stretch="Uniform" Style="{StaticResource LightyBlue}" PreviewKeyDown="Image_PreviewKeyDown" Width="78" Height="77" VerticalAlignment="Top" Cursor="Hand" Margin="5,0,0,0">
                        <Image.Source>
                            <BitmapImage DecodePixelWidth="130" DecodePixelHeight="130" UriSource="/UiDrive/IMGS/PICMENU/SMART_SALES/GradBandi_Customer.png" CacheOption="OnLoad"/>
                        </Image.Source>
                    </Image>
                    <TextBlock Text="تعریف فرمت بندی گرید مشتریان"  TextAlignment="Center" TextWrapping="Wrap"  Foreground="#DDFFFFFF"  Height="40" Width="120"/>
                </WrapPanel>

                <WrapPanel FlowDirection="RightToLeft" Orientation="Vertical" Margin="10">
                    <Image Stretch="Uniform" Style="{StaticResource LightyBlue}" Width="78" Height="77" VerticalAlignment="Top" Cursor="Hand" Margin="5,0,0,0">
                        <Image.Source>
                            <BitmapImage DecodePixelWidth="130" DecodePixelHeight="130" UriSource="/UiDrive/IMGS/PICMENU/SMART_SALES/Takgir_Pardakht.png" CacheOption="OnLoad"/>
                        </Image.Source>
                    </Image>
                    <TextBlock Text="تنظیمات تاخیر و تعجیل پرداخت"  TextAlignment="Center" TextWrapping="Wrap"  Foreground="#DDFFFFFF"  Height="40" Width="120"/>
                </WrapPanel>

                <WrapPanel FlowDirection="RightToLeft" Orientation="Vertical" Margin="10">
                    <Image Stretch="Uniform" Style="{StaticResource LightyBlue}" Width="78" Height="77" VerticalAlignment="Top" Cursor="Hand" Margin="5,0,0,0">
