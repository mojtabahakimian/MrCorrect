<Window x:Class="Prg_UI.MySplashScreen.WinSplashy"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.MySplashScreen"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:gifplayer="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
        mc:Ignorable="d"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Width="480"
        Height="280"
        Title=""
        Loaded="Window_Loaded">

    <Border x:Name="MainBorder" Background="White" CornerRadius="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" Color="Black" Direction="270" Opacity="0.16" ShadowDepth="7"/>
        </Border.Effect>

        <Grid>
            <!-- Background Gradient (رنگ مورد علاقه شما) -->
            <Border x:Name="BgBorder" CornerRadius="14" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4FC3F7" Offset="0"/>
                        <GradientStop Color="#0288D1" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <!-- Soft decorative circles -->
            <Ellipse x:Name="Circle1" Width="220" Height="220" Fill="#18FFFFFF"
                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-70,-70,0,0"/>
            <Ellipse x:Name="Circle2" Width="180" Height="180" Fill="#12FFFFFF"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-50,-50"/>

            <!-- محتوای عادی -->
            <StackPanel x:Name="NormalContent" VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Logo Circle -->
                <Border Width="90" Height="90" CornerRadius="45" Background="#28FFFFFF"
                        HorizontalAlignment="Center" Margin="0,0,0,22">
                    <materialDesign:PackIcon Kind="AccountCheckOutline"
                                             Width="48" Height="48"
                                             Foreground="White"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                </Border>

                <!-- Title -->
                <TextBlock Text="Mr Correct"
                           FontFamily="Segoe UI"
                           FontSize="36"
                           FontWeight="Light"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,6"/>

                <!-- Subtitle -->
                <TextBlock Text="سیستم مدیریت هوشمند"
                           FontSize="15"
                           Foreground="#E0F7FA"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- GIF -->
            <Image x:Name="myg"
                   Visibility="Collapsed"
                   gifplayer:AnimationBehavior.RepeatBehavior="2x"
                   gifplayer:AnimationBehavior.AutoStart="True"
                   gifplayer:AnimationBehavior.SourceUri="/UiDrive/IMGS/SplashHandwrite.gif"
                   Stretch="UniformToFill"
                   Opacity="0.92"/>

            <!-- حالت RDP (سبک) -->
            <TextBlock x:Name="RDP_LABEL"
                       Visibility="Collapsed"
                       Text="Mr Correct ..."
                       FontFamily="Segoe UI"
                       FontSize="40"
                       FontWeight="Light"
                       Foreground="White"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>
    </Border>
</Window>