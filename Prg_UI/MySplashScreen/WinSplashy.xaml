<Window x:Class="Prg_UI.MySplashScreen.WinSplashy"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prg_UI.MySplashScreen"
        mc:Ignorable="d"
        xmlns:gifplayer="https://github.com/XamlAnimatedGif/XamlAnimatedGif"
        Background="{x:Null}"
        AllowsTransparency="True"
        AllowDrop="True" WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Title="" Width="501" Height="308" ShowInTaskbar="False" Loaded="Window_Loaded" >
    <Grid>
        <Rectangle RadiusX="10" RadiusY="10">
            <Rectangle.Fill>
                <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
                    <GradientStop Color="#FF09D4AA" Offset="1"/>
                    <GradientStop Color="#FF14D66E"/>
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Image x:Name="myg" Margin="3,8,4,5" Visibility="Hidden" gifplayer:AnimationBehavior.RepeatBehavior="2x" gifplayer:AnimationBehavior.AutoStart="True" gifplayer:AnimationBehavior.SourceUri="/UiDrive/IMGS/SplashHandwrite.gif" Stretch="UniformToFill"/>
        <Border BorderBrush="White" BorderThickness="1" CornerRadius="10"/>
        <Label x:Name="RDP_LABEL" Visibility="Hidden" d:Visibility="Hidden" Content="Mr Correct ..." HorizontalAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Foreground="#DDFFFFFF" FontSize="60" FontFamily="Calibri"/>
    </Grid>
</Window>
