<?xml version="1.0" encoding="utf-8"?>
<!--
  ╔══════════════════════════════════════════════════════════════════╗
  ║  PUBLISH PROFILE: Self-Contained + Compressed                   ║
  ║                                                                  ║
  ║  حجم تخمینی خروجی: ~130-160 MB (با فشرده‌سازی)                 ║
  ║  شرط: بدون نیاز به نصب .NET Runtime روی دستگاه کاربر           ║
  ║                                                                  ║
  ║  مناسب برای: توزیع به مشتریانی که .NET ندارند                   ║
  ║                                                                  ║
  ║  نحوه publish از command line:                                   ║
  ║  dotnet publish Prg_UI/Prg_UI.csproj                            ║
  ║    -p:PublishProfile=SelfContained                               ║
  ╚══════════════════════════════════════════════════════════════════╝
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Release\net8.0-windows7.0\publish\SelfContained\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- SelfContained=true: .NET runtime داخل exe هست، نیاز به نصب جداگانه ندارد -->
    <SelfContained>true</SelfContained>
    <!-- تک فایل exe -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- فشرده‌سازی → ~30-40% کاهش نسبت به حالت بدون فشرده‌سازی -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- PublishTrimmed=false چون WPF با trimming مشکل دارد -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>
</Project>
