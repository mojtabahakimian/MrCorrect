<?xml version="1.0" encoding="utf-8"?>
<!--
  ╔══════════════════════════════════════════════════════════════════╗
  ║  PUBLISH PROFILE: Framework-Dependent (کوچک‌ترین حجم)           ║
  ║                                                                  ║
  ║  حجم تخمینی خروجی: ~50-80 MB                                    ║
  ║  شرط: کاربر باید .NET 8 Desktop Runtime نصب داشته باشد          ║
  ║  لینک دانلود runtime:                                            ║
  ║  https://dotnet.microsoft.com/download/dotnet/8.0               ║
  ║                                                                  ║
  ║  نحوه publish از Visual Studio:                                  ║
  ║  راست کلیک روی Prg_UI > Publish > این پروفایل را انتخاب کنید   ║
  ║                                                                  ║
  ║  یا از command line:                                             ║
  ║  dotnet publish Prg_UI/Prg_UI.csproj                            ║
  ║    -p:PublishProfile=FrameworkDependent                          ║
  ╚══════════════════════════════════════════════════════════════════╝
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Release\net8.0-windows7.0\publish\FrameworkDependent\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- SelfContained=false: .NET runtime در exe جاسازی نمی‌شود → ~200 MB کاهش -->
    <SelfContained>false</SelfContained>
    <!-- تک فایل exe -->
    <PublishSingleFile>true</PublishSingleFile>
    <!-- فشرده‌سازی فقط با SelfContained=true کار می‌کند، اینجا غیرفعال است -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- بهینه‌سازی پیوندهای اسمبلی -->
    <PublishReadyToRun>false</PublishReadyToRun>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
  </PropertyGroup>
</Project>
