        <Dictionary isRef="1" />
        <Key>2c3ffbcf7a0545708e4dd6cdeb9afeb5</Key>
        <Name>DataSource1</Name>
        <NameInSource>MS SQL</NameInSource>
        <Parameters isList="true" count="1">
          <value>NUMBER_PARAM,,6,50</value>
        </Parameters>
        <SqlCommand>SELECT 
	q.NUMBER,
	q.TAG,
	q.DATE_N,
	q.CUST_NO,
	q.NUMBER1,
	q.ANBAR,
	q.TAH,
	q.MAS,
	q.VAS,
	q.N_S,
	q.MOLAH,
	q.M_NAGHD,
	q.MABL_VAR,
	q.MOIN_VAR,
	q.MABL_HAV,
	q.MOIN_HAV,
	q.MABL_HAZ,
	q.MOIN_HAZ,
	q.TAKHFIF,
	q.MOIN_KHF,
	q.ANBARF,
	q.FNUMCO,
	q.INUMBER,
	q.ITAG,
	q.IANBAR,
	q.RADIF,
	q.CODE,
	q.MEGH,
	q.MEGHk,
	q.MEGH_MAR,
	q.MANDAH,
	q.MABL,
	q.MABL_K,
	q.FROM_A,
	q.N_RASID,
	q.MEGH_R,
	q.RADAH,
	q.SANAD_NO,
	q.ICUST_NO,
	q.IANBARF,
	q.VAHED_K,
	q.hes,
	q.NAME,
	q.NAMES,
	q.SNAME,
	q.Barcode,
	q.VNAMES,
	q.KALA,
	q.N_FANI,
	q.EMZA1,
	q.EMZA2,
	q.EMZA3,
	q.SGN1,
	q.SGN2,
	q.SGN3,
	q.SGN4,
	q.SGN1usid,
	q.sgn2usid,
	q.sgn3usid,
	c.nam AS N_RASID_NAME
	FROM 
	dbo.QSL_HAVALEH_EXIT AS q
	LEFT JOIN 
(
SELECT 
	dbo.HEAD_MANF.FNUMB, 
	dbo.STUF_DEF.NAME + ' ' + ISNULL(dbo.HEAD_MANF.TOZIH, N' ') AS nam, 
	dbo.HEAD_MANF.FNUMB AS Expr1
	FROM 
	dbo.STUF_DEF 
	INNER JOIN dbo.HEAD_MANF ON dbo.STUF_DEF.CODE = dbo.HEAD_MANF.CODE
    WHERE 
        dbo.STUF_DEF.NAME IS NOT NULL 
        AND dbo.HEAD_MANF.FNUMB = 501
) AS c
    ON q.N_RASID = c.Expr1
WHERE 
    q.TAG = 10 
    AND q.NUMBER = @NUMBER_PARAM
</SqlCommand>
      </DataSource1>
