        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>772d732311e544b08680bf9d80ff9739</Key>
        <Name>DataSource1</Name>
        <NameInSource>MS SQL</NameInSource>
        <Parameters isList="true" count="2">
          <value>NUMBER_PARM,,6,20</value>
          <value>TAG_PARM,,6,20</value>
        </Parameters>
        <SqlCommand>SELECT 
	QSL_HAVALEH_EXIT.*,
    NAM.NAM
FROM 
    dbo.QSL_HAVALEH_EXIT
LEFT JOIN
    (
SELECT
	dbo.HEAD_MANF.FNUMB, 
	ISNULL(dbo.HEAD_MANF.NAMES, dbo.STUF_DEF.NAME) AS NAM
	FROM
	dbo.STUF_DEF 
	RIGHT OUTER JOIN 
            dbo.HEAD_MANF ON dbo.STUF_DEF.CODE = dbo.HEAD_MANF.CODE 
        LEFT OUTER JOIN 
            dbo.DTL_MANF ON dbo.HEAD_MANF.FNUMB = dbo.DTL_MANF.FNUMB 
        WHERE
            dbo.DTL_MANF.CODE IS NULL
    ) AS NAM
ON QSL_HAVALEH_EXIT.N_RASID = NAM.FNUMB
WHERE 
    QSL_HAVALEH_EXIT.NUMBER = @NUMBER_PARM
    AND QSL_HAVALEH_EXIT.TAG = @TAG_PARM</SqlCommand>
      </DataSource1>
    </DataSources>
