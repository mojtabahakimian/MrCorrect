        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT TOP (0) CAST(N'' AS nvarchar(200)) AS [ContractNo], CAST(N'' AS nvarchar(200)) AS [CustName], CAST(N'' AS nvarchar(200)) AS [BrandName], CAST(N'' AS nvarchar(200)) AS [CODE], CAST(N'' AS nvarchar(200)) AS [ProductName], CAST(N'' AS nvarchar(200)) AS [ContractedQtyText], CAST(N'' AS nvarchar(200)) AS [ProducedQtyText], CAST(N'' AS nvarchar(200)) AS [RemainToProduceText], CAST(N'' AS nvarchar(200)) AS [OverProducedQtyText], CAST(N'' AS nvarchar(200)) AS [SoldQtyText], CAST(N'' AS nvarchar(200)) AS [ContractBalanceText], CAST(N'' AS nvarchar(200)) AS [ActualInventoryText]</SqlCommand>
      </DataSource1>
