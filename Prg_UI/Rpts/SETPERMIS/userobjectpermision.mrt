        <Name>DataSource1</Name>
        <NameInSource>MS SQL</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>SELECT TOP 0 dbo.TFORMS.CAPTION, dbo.SAL_CHEK.OBJECT, dbo.SAL_CHEK.RUN, dbo.SAL_CHEK.SEE, dbo.SAL_CHEK.INP, dbo.SAL_CHEK.UPD, dbo.SAL_CHEK.DEL, dbo.SAL_CHEK.USERCO, dbo.TFORMS.GRP, dbo.SALA_DTL.SAL_NAME
FROM dbo.TFORMS
     INNER JOIN dbo.SAL_CHEK ON dbo.TFORMS.IDH=dbo.SAL_CHEK.OBJECT
     INNER JOIN dbo.SALA_DTL ON dbo.SAL_CHEK.USERCO=dbo.SALA_DTL.IDD

WHERE(dbo.SAL_CHEK.RUN=1)AND(dbo.SAL_CHEK.USERCO=1)AND(dbo.SAL_CHEK.OBJECT=1)</SqlCommand>
      </DataSource1>
    </DataSources>
