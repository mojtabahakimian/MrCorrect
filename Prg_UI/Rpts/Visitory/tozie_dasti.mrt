        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>6ea7a4af796e40b7be9b397b717f62d1</Key>
        <Name>DataSource1</Name>
        <NameInSource>MS SQL</NameInSource>
        <Parameters isList="true" count="1">
          <value>TID_PARAM,,0,15</value>
        </Parameters>
        <SqlCommand>SELECT dbo.Q_LIST_FCT2.ADDRESS,
	dbo.Q_LIST_FCT2.NUMBER,
	dbo.Q_LIST_FCT2.NAME,
	dbo.Q_LIST_FCT2.SumOfMABL_K,
	dbo.Q_LIST_FCT2.DATE_N,
	dbo.Q_LIST_FCT2.TAG,
	dbo.Q_LIST_FCT2.AGHLAM,
	dbo.Q_LIST_FCT2.hes,
	ISNULL(dbo.[BED-BES].BEST, 0) AS mand,
	dbo.CUST_HESAB.CITY,
	dbo.TOZIE.TDATE,
	dbo.TOZIE.TDRIVER,
	dbo.TOZIE.TCITY,
	dbo.TOZIE.TID,
	dbo.TOZIE.TMAMUR
	FROM dbo.Q_LIST_FCT2
	INNER JOIN dbo.CUST_HESAB
        ON dbo.Q_LIST_FCT2.hes = dbo.CUST_HESAB.hes
    INNER JOIN dbo.TOZIE_SUB
        ON dbo.Q_LIST_FCT2.NUMBER = dbo.TOZIE_SUB.NUMBER
    INNER JOIN dbo.TOZIE
        ON dbo.TOZIE_SUB.TID = dbo.TOZIE.TID
    LEFT OUTER JOIN dbo.[BED-BES]
        ON dbo.Q_LIST_FCT2.hes = dbo.[BED-BES].HES
WHERE (
          dbo.TOZIE.TID = @TID_PARAM
          AND (Q_LIST_FCT2.TAG = 2)
      );</SqlCommand>
      </DataSource1>
    </DataSources>
