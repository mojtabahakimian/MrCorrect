          <value>TEL,System.String</value>
          <value>MOBILE,System.String</value>
          <value>VISITOR,System.String</value>
          <value>VDATE,System.Int64</value>
          <value>COUST_NO,System.String</value>
          <value>CLASS,System.String</value>
          <value>RACTIVE,System.Boolean</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>41b7654f5de64171a3a54302c090e7a5</Key>
        <Name>RST</Name>
        <NameInSource>MS SQL</NameInSource>
        <Parameters isList="true" count="2">
          <value>HES_PARAM,,12,100</value>
          <value>VDATE,,0,10</value>
        </Parameters>
        <SqlCommand>SELECT VISITORS_DAY.HES,
	VISITORS_DAY.CDATE,
	VISITORS_DAY.USERNAME,
	VISITORS_DAY.OKF,
	CUST_HESAB.NAME,
	CUST_HESAB.ADDRESS,
	CUST_HESAB.TEL,
	CUST_HESAB.MOBILE,
	CUST_HESAB_1.NAME AS VISITOR,
	VISITORS_DAY.VDATE,
	VISITORS_DAY_DTL.COUST_NO,
	VISITORS_DAY_DTL.CLASS,
	VISITORS_DAY_DTL.RACTIVE
	FROM VISITORS_DAY_DTL
	INNER JOIN VISITORS_DAY
        ON VISITORS_DAY_DTL.HES = VISITORS_DAY.HES
           AND VISITORS_DAY_DTL.VDATE = VISITORS_DAY.VDATE
    INNER JOIN CUST_HESAB CUST_HESAB_1
        ON CUST_HESAB_1.hes = VISITORS_DAY.HES
    INNER JOIN CUST_HESAB
        ON VISITORS_DAY_DTL.COUST_NO = CUST_HESAB.hes
WHERE dbo.VISITORS_DAY.HES = @HES_PARAM AND dbo.VISITORS_DAY.VDATE = @VDATE;</SqlCommand>
      </RST>
    </DataSources>
