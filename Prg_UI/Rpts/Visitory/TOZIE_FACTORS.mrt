        <Dictionary isRef="1" />
        <Key>3807307ca87d4c6c95d368df97ff6d46</Key>
        <Name>FACTOR_DATA</Name>
        <NameInSource>MS SQL</NameInSource>
        <Parameters isList="true" count="0" />
        <SqlCommand>-- CTE (Common Table Expression) برای محاسبات اولیه
-- CTE برای محاسبات اولیه فاکتور
WITH InvoiceCalculations
AS (SELECT NUMBER,
	TAG,
	SUM(ISNULL(MABL_K, 0)) AS InvoiceSubTotal,
	SUM(ISNULL(sd.VAZN, 0) * ISNULL(i.MEGHk, 0)) AS TotalWeight
	FROM dbo.INVO_LST i
        INNER JOIN dbo.STUF_DEF sd
            ON i.CODE = sd.CODE
    WHERE TAG = 2
    GROUP BY NUMBER,
             TAG)

-- SELECT اصلی که تمام اطلاعات را برای گزارش استخراج می‌کند
SELECT h.NUMBER1,
	h.NUMBER,
	h.DATE_N,
	i.NUMBER AS INUMBER,
	h.HTAG,
	i.ANBAR,
	i.RADIF,
	i.CODE,
	i.MEGH,
	i.MEGHk,
	i.MABL,
	i.MABL_K,
	sd.NAME,
	ta.NAMES,
	tv.NAMES AS VNAMES,
	h.TAH,
	h.MOLAH,
	ck.CUSTKNAME,
	d.DEPNAME,
	s.SHNAME,
	ch.NAME AS HESAB,
	ch.ADDRESS,
	ch.TEL,
	ISNULL(sd.NAME, N' ') + N' ' + ISNULL(i.MANDAH, N' ') AS KALA,
	h.CUST_NO,
	i.N_KOL,
	i.N_MOIN,
	h.FNUMCO,
	ch.ECODE,
	ch.PCODE,
	ch.IYALAT,
	ch.MCODEM,
	ch.CITY,
	i.MABL_K - i.N_MOIN AS mabkbt,
	i.IMBAA,
	i.MABL_K - i.N_MOIN + i.IMBAA AS mabkn,
	ch.CODE_E,
	h.TAKHFIF,
	h.MBAA,
	sd.N_FANI,
	h.SADER,
	h.ANBARF AS ANBARFF,
	odt.REQUEST_NO,
	odt.BARNAMEH,
	odt.DRIVER,
	odt.DRIVER_MOB,
	odt.CAMIUN_NUM,
	odt.MAGHSAD,
	odt.CAM_KHALY,
	odt.CAM_POOR,
	odt.TOZIH,
	odt.CAMIUN,
	ods.CODE AS CODEG,
	ods.CAM_KHALY AS CAM_KHALYG,
	ods.CAM_POOR AS CAM_POORG,
	ods.MEGHk AS MEGHkG,
	ods.TOZIH AS TOZIHG,
	ods.VAZNH,
	sd_1.NAME AS NAMEG,
	h.SHARAYET,
	d.DEPART,
	i.TKHN,
	h.MAS,
	h.HTAG AS TAG,
	sdtl.EMZA AS EMZA1,
	sdtl_1.EMZA AS EMZA2,
	sdtl_2.EMZA AS EMZA3,
	h.SGN1usid,
	h.sgn2usid,
	h.sgn3usid,
	hlst.SGN1,
	hlst.SGN2,
	hlst.SGN3,
	hlst.SGN4,
	h.NUMBER AS InvoiceNumber,
	sd.CODE AS ItemCode,
	sd.VAZN AS ItemWeight,
	i.MEGHk AS ItemQuantity,
	calcs.TotalWeight AS CalculatedTotalWeight,
	CASE
           WHEN ISNULL(calcs.TotalWeight, 0) &gt; 0 THEN
               N'وزن كل به كيلو : ' + CAST(ROUND(calcs.TotalWeight, 0) AS NVARCHAR(50))
           ELSE
               N'وزن محاسبه نشد'
       END AS TotalWeightText,
       -- محاسبه کل مانده حساب مشتری
       (
SELECT SUM(ISNULL(MAN.BED, 0) - ISNULL(MAN.BES, 0))
	FROM dbo.DEED_DTL AS MAN
	WHERE MAN.HES = h.CUST_NO
       ) AS TotalAccountBalance,

       -- استخراج اطلاعات ویزیتور بر اساس تنظیمات
       CASE
           WHEN SUBSTRING(saz.OPTIONSS, 26, 1) = '5' THEN
               'ويزيتور: ' + ISNULL(visitor_hesab.NAME, '')
           ELSE
               NULL
       END AS VisitorLabel,
       CASE
           WHEN SUBSTRING(saz.OPTIONSS, 26, 1) = '5' THEN
               'تلفن ويزيتور: ' + ISNULL(visitor_hesab.TEL, '')
           ELSE
               NULL
       END AS VisitorTelLabel,

       -- تجمیع اطلاعات چک‌ها یا نمایش شرایط فاکتور
       ISNULL(CheckDetails.CheckDescription, h.SHARAYET) AS DescriptionText,

       ---------------------------------------------------------------------------------
       -- ستون‌های محاسباتی نهایی معادل منطق کد #C
       ---------------------------------------------------------------------------------

       ISNULL(calcs.InvoiceSubTotal, 0) AS SumOfLines,
       ISNULL(h.TAKHFIF, 0) AS DiscountAmount,
       ISNULL(h.MABL_HAZ, 0) AS ServicesAmount,
       ISNULL(h.MBAA, 0) AS TaxAmount,
       (CASE
            WHEN ISNULL(h.TAKHFIF, 0) &gt; 0
                 AND ISNULL(calcs.InvoiceSubTotal, 0) &gt; 0 THEN
                CAST(CAST(h.TAKHFIF * 100.0 / calcs.InvoiceSubTotal AS DECIMAL(10, 2)) AS NVARCHAR(20)) + N' % تخفيف:'
            ELSE
                N'تخفيف:'
        END
       ) AS DiscountLabel,
       (CASE
            WHEN ISNULL(h.VAS, 1) = 1 THEN
                ISNULL(calcs.InvoiceSubTotal, 0) + ISNULL(h.MABL_HAZ, 0) + ISNULL(h.MBAA, 0) - ISNULL(h.TAKHFIF, 0)
            ELSE
                ISNULL(calcs.InvoiceSubTotal, 0) - ISNULL(h.MABL_HAZ, 0) + ISNULL(h.MBAA, 0) - ISNULL(h.TAKHFIF, 0)
        END
       ) AS PayableAmount,
       (ISNULL(h.M_NAGHD, 0) + ISNULL(h.MABL_VAR, 0) + ISNULL(h.MABL_HAV, 0) + ISNULL(CheckDetails.TotalCheckAmount, 0)) AS TotalPaidAmount,
       ((CASE
             WHEN ISNULL(h.VAS, 1) = 1 THEN
                 ISNULL(calcs.InvoiceSubTotal, 0) + ISNULL(h.MABL_HAZ, 0) + ISNULL(h.MBAA, 0) - ISNULL(h.TAKHFIF, 0)
             ELSE
                 ISNULL(calcs.InvoiceSubTotal, 0) - ISNULL(h.MABL_HAZ, 0) + ISNULL(h.MBAA, 0) - ISNULL(h.TAKHFIF, 0)
         END
        )
        - (ISNULL(h.M_NAGHD, 0) + ISNULL(h.MABL_VAR, 0) + ISNULL(h.MABL_HAV, 0)
           + ISNULL(CheckDetails.TotalCheckAmount, 0)
          )
       ) AS InvoiceBalance,
       (CASE
            WHEN ISNULL(h.VAS, 1) = 1 THEN
                ISNULL(calcs.InvoiceSubTotal, 0) + ISNULL(h.MABL_HAZ, 0) + ISNULL(h.MBAA, 0) - ISNULL(h.TAKHFIF, 0)
            ELSE
                ISNULL(calcs.InvoiceSubTotal, 0) - ISNULL(h.MABL_HAZ, 0) + ISNULL(h.MBAA, 0) - ISNULL(h.TAKHFIF, 0)
        END
       ) AS AmountToWords,

       -- نمایش مانده حساب قبلی (به‌روزرسانی شده)
       CASE
           WHEN
           (
SELECT SUM(BED - BES)
	FROM dbo.DEED_DTL
	WHERE HES = h.CUST_NO
	AND N_S &lt;&gt; h.N_S
           ) IS NULL THEN
               '0'
           ELSE
               CASE
                   WHEN
                   (
SELECT SUM(BED - BES)
	FROM dbo.DEED_DTL
	WHERE HES = h.CUST_NO
	AND N_S &lt; h.N_S
                   ) &gt;= 0 THEN
                       REPLACE(CONVERT(   VARCHAR,
                                          CAST(
                                          (
SELECT SUM(BED - BES)
	FROM dbo.DEED_DTL
	WHERE HES = h.CUST_NO
	AND N_S &lt;&gt; h.N_S
                                          ) AS MONEY),
                                          1
                                      ),
                               '.00',
                               ''
                              ) + N' ريال بدهكار'
                   ELSE
                       REPLACE(CONVERT(VARCHAR,
                                       CAST(ABS(
                                            (
SELECT SUM(BED - BES)
	FROM dbo.DEED_DTL
	WHERE HES = h.CUST_NO
	AND N_S &lt;&gt; h.N_S
                                            )
                                               ) AS MONEY),
                                       1
                                      ),
                               '.00',
                               ''
                              ) + N' ريال بستانكار'
               END
       END AS PreviousBalanceText,
       saz.TFCODE_E AS ServicesLabelText,
       CAST(saz.ARSESH AS NVARCHAR(10)) + N'% ماليات و عوارض:' AS TaxLabelText,
       CASE
           WHEN SUBSTRING(saz.OPTIONSS, 17, 1) = '5' THEN
               PreviousInvoices.FormattedString
           ELSE
               NULL
       END AS PreviousInvoicesText,
       CASE
           WHEN SUBSTRING(saz.OPTIONSS, 42, 1) = '5' THEN
               PaymentScenarios.FormattedString
           ELSE
               NULL
       END AS PaymentsText,
       CASE
           WHEN SUBSTRING(saz.OPTIONSS, 18, 1) = '5'
                AND ISNULL(calcs.TotalWeight, 0) &gt; 0 THEN
               N'وزن كل به كيلو : ' + CAST(ROUND(calcs.TotalWeight, 0) AS NVARCHAR(50))
           ELSE
               NULL
       END AS TotalWeightText,

       ---------------------------------------------------------------------------------
       -- بخش جدید: اضافه کردن اطلاعات امضا کنندگان
       ---------------------------------------------------------------------------------
       CASE
           WHEN hlst.SGN1 = 1 THEN
               dbo.Getusersemat(h.SGN1usid, 'FFR_FROOSHTX')
           ELSE
               NULL
       END AS Signatory1_Role,
       CASE
           WHEN hlst.SGN1 = 1 THEN
               dbo.GETHESNAME(dbo.GETUSERHES(h.SGN1usid))
           ELSE
               NULL
       END AS Signatory1_Name,
       CASE
           WHEN hlst.SGN2 = 1 THEN
               dbo.Getusersemat(h.sgn2usid, 'FFR_HESABTX')
           ELSE
               NULL
       END AS Signatory2_Role,
       CASE
           WHEN hlst.SGN2 = 1 THEN
               dbo.GETHESNAME(dbo.GETUSERHES(h.sgn2usid))
           ELSE
               NULL
       END AS Signatory2_Name,
       CASE
           WHEN hlst.SGN3 = 1 THEN
               dbo.Getusersemat(h.sgn3usid, 'FFR_MODIRTX')
           ELSE
               NULL
       END AS Signatory3_Role,
       CASE
           WHEN hlst.SGN3 = 1 THEN
               dbo.GETHESNAME(dbo.GETUSERHES(h.sgn3usid))
           ELSE
               NULL
       END AS Signatory3_Name
FROM dbo.STUF_DEF AS sd
    RIGHT OUTER JOIN dbo.SHIFT AS s
        RIGHT OUTER JOIN dbo.DEPART AS d
            RIGHT OUTER JOIN dbo.HEAD_LST AS hlst
                INNER JOIN dbo.INVO_LST AS i
                    INNER JOIN dbo.TCOD_ANBAR AS ta
                        ON i.ANBAR = ta.CODE
                    INNER JOIN HEAD_BACK_ANBAR AS h
                        ON i.NUMBER = h.NUMBER
                           AND i.TAG = h.HTAG
                    ON hlst.NUMBER = h.NUMBER
                       AND hlst.TAG = h.TAG
                ON d.DEPATMAN = h.DEPATMAN
            LEFT OUTER JOIN dbo.CUSTKIND AS ck
                ON h.CUST_KIND = ck.CUST_COD
            ON s.SHIFT_ID = h.SHIFT
        LEFT OUTER JOIN dbo.OTHER_DTL AS odt
            ON h.NUMBER = odt.NUMBER
               AND h.HTAG = odt.TAG
        LEFT OUTER JOIN dbo.SALA_DTL AS sdtl_2
            ON h.sgn3usid = sdtl_2.IDD
        LEFT OUTER JOIN dbo.SALA_DTL AS sdtl_1
            ON h.sgn2usid = sdtl_1.IDD
        LEFT OUTER JOIN dbo.SALA_DTL AS sdtl
            ON h.SGN1usid = sdtl.IDD
        LEFT OUTER JOIN dbo.STUF_DEF AS sd_1
            INNER JOIN dbo.OTHER_DTL_SUB AS ods
                ON sd_1.CODE = ods.CODE
            ON i.CODE = ods.CODE
               AND i.NUMBER = ods.NUMBER
               AND i.TAG = ods.TAGG
        LEFT OUTER JOIN CUST_HESAB AS ch
            ON h.CUST_NO = ch.hes
        LEFT OUTER JOIN dbo.TCOD_VAHEDS AS tv
            ON i.VAHED_K = tv.CODE
        ON sd.CODE = i.CODE
    LEFT JOIN dbo.VISITOR_DTL AS vdtl
        ON h.NUMBER = vdtl.NUMBER
           AND vdtl.TAG = 2
    LEFT JOIN dbo.CUST_HESAB AS visitor_hesab
        ON vdtl.CUST_NO = visitor_hesab.hes
    CROSS JOIN dbo.SAZMAN AS saz
    LEFT JOIN InvoiceCalculations AS calcs
        ON h.NUMBER = calcs.NUMBER
           AND h.HTAG = calcs.TAG
    OUTER APPLY
(
SELECT 'چكهاي دريافت شده ' + CAST(COUNT(*) AS NVARCHAR(10)) + ' فقره جمعاًبه مبلغ :'
           + REPLACE(CONVERT(VARCHAR, CAST(SUM(p.MABL) AS MONEY), 1), '.00', '') + ' ريال '
           + STUFF(
             (
SELECT 'ـ سريال:' + ISNULL(CAST(CAST(p2.N_SERI AS BIGINT) AS NVARCHAR(50)), '') + ' بانك:'
                        + ISNULL(b.NAMES, '') + ' شعبه:' + LTRIM(RTRIM(ISNULL(p2.SHOBEH, '')))
                 FROM dbo.PAY_GETD p2
                     INNER JOIN dbo.TCOD_BANKS b
                         ON p2.BANK = b.CODE
                 WHERE p2.NUMBER = h.NUMBER
                       AND p2.TAG = h.HTAG
                       AND
                       (
                           p2.N_KOL IS NULL
                           OR p2.N_KOL &lt;&gt; 911
                       )
                 FOR XML PATH('')
             ),
             1,
             0,
             ''
                  ) AS CheckDescription,
           SUM(p.MABL) AS TotalCheckAmount
    FROM dbo.PAY_GETD p
    WHERE p.NUMBER = h.NUMBER
          AND p.TAG = h.HTAG
          AND
          (
              p.N_KOL IS NULL
              OR p.N_KOL &lt;&gt; 911
          )
) AS CheckDetails
    OUTER APPLY
(
SELECT STUFF(
	(
	SELECT TOP 3
                      SUBSTRING(CAST(h_prev.DATE_N AS VARCHAR(8)), 1, 4) + '/'
                      + SUBSTRING(CAST(h_prev.DATE_N AS VARCHAR(8)), 5, 2) + '/'
                      + SUBSTRING(CAST(h_prev.DATE_N AS VARCHAR(8)), 7, 2) + N' شماره فاكتور: '
                      + CAST(CAST(h_prev.NUMBER AS BIGINT) AS VARCHAR(20)) + N'  مبلغ قابل پرداخت  فاكتور: '
                      + REPLACE(
                                   CONVERT(
                                              VARCHAR,
                                              CAST((CASE
                                                        WHEN ISNULL(h_prev.VAS, 1) = 1 THEN
                                                            ISNULL(prev_totals.Expr1, 0) + ISNULL(h_prev.MABL_HAZ, 0)
                                                            + ISNULL(h_prev.MBAA, 0) - ISNULL(h_prev.TAKHFIF, 0)
                                                        ELSE
                                                            ISNULL(prev_totals.Expr1, 0) - ISNULL(h_prev.MABL_HAZ, 0)
                                                            + ISNULL(h_prev.MBAA, 0) - ISNULL(h_prev.TAKHFIF, 0)
                                                    END
                                                   ) AS MONEY),
                                              1
                                          ),
                                   '.00',
                                   ''
                               ) + CHAR(13) + CHAR(10)
               FROM dbo.HEAD_LST AS h_prev
                   INNER JOIN
                   (
SELECT NUMBER,
	TAG,
	SUM(MABL_K) AS Expr1
	FROM dbo.INVO_LST
	GROUP BY NUMBER,
                                TAG
                   ) AS prev_totals
                       ON h_prev.NUMBER = prev_totals.NUMBER
                          AND h_prev.TAG = prev_totals.TAG
               WHERE h_prev.CUST_NO = h.CUST_NO
                     AND h_prev.TAG = 13
                     AND h_prev.NUMBER &lt;&gt; h.NUMBER
               ORDER BY h_prev.DATE_N DESC
               FOR XML PATH('')
           ),
           1,
           0,
           ''
                ) AS FormattedString
) AS PreviousInvoices
    OUTER APPLY
(
SELECT STUFF(
	(
	SELECT dt.ONVAN + N' ' + CAST(dt.DARSAD AS NVARCHAR(10)) + N' درصد تخفيف : '
                      + REPLACE(
                                   CONVERT(
                                              VARCHAR,
                                              CAST(ROUND(
                                                            ((CASE
                                                                  WHEN ISNULL(h.VAS, 1) = 1 THEN
                                                                      ISNULL(calcs.InvoiceSubTotal, 0)
                                                                      + ISNULL(h.MABL_HAZ, 0) + ISNULL(h.MBAA, 0)
                                                                      - ISNULL(h.TAKHFIF, 0)
                                                                  ELSE
                                                                      ISNULL(calcs.InvoiceSubTotal, 0)
                                                                      - ISNULL(h.MABL_HAZ, 0) + ISNULL(h.MBAA, 0)
                                                                      - ISNULL(h.TAKHFIF, 0)
                                                              END
                                                             ) * dt.DARSAD / 100
                                                            ),
                                                            0
                                                        ) AS MONEY),
                                              1
                                          ),
                                   '.00',
                                   ''
                               ) + N'  قابل پرداخت : '
                      + REPLACE(
                                   CONVERT(
                                              VARCHAR,
                                              CAST(((CASE
                                                         WHEN ISNULL(h.VAS, 1) = 1 THEN
                                                             ISNULL(calcs.InvoiceSubTotal, 0) + ISNULL(h.MABL_HAZ, 0)
                                                             + ISNULL(h.MBAA, 0) - ISNULL(h.TAKHFIF, 0)
                                                         ELSE
                                                             ISNULL(calcs.InvoiceSubTotal, 0) - ISNULL(h.MABL_HAZ, 0)
                                                             + ISNULL(h.MBAA, 0) - ISNULL(h.TAKHFIF, 0)
                                                     END
                                                    )
                                                    - ROUND(
                                                               ((CASE
                                                                     WHEN ISNULL(h.VAS, 1) = 1 THEN
                                                                         ISNULL(calcs.InvoiceSubTotal, 0)
                                                                         + ISNULL(h.MABL_HAZ, 0) + ISNULL(h.MBAA, 0)
                                                                         - ISNULL(h.TAKHFIF, 0)
                                                                     ELSE
                                                                         ISNULL(calcs.InvoiceSubTotal, 0)
                                                                         - ISNULL(h.MABL_HAZ, 0) + ISNULL(h.MBAA, 0)
                                                                         - ISNULL(h.TAKHFIF, 0)
                                                                 END
                                                                ) * dt.DARSAD / 100
                                                               ),
                                                               0
                                                           )
                                                   ) AS MONEY),
                                              1
                                          ),
                                   '.00',
                                   ''
                               ) + CHAR(13) + CHAR(10)
               FROM dbo.DARSAD_TAKHFIF dt
               ORDER BY dt.RDF
               FOR XML PATH('')
           ),
           1,
           0,
           ''
                ) AS FormattedString
) AS PaymentScenarios
WHERE hlst.NUMBER IN ({NUMBERS_PARAM}) AND h.HTAG = 2;</SqlCommand>
      </FACTOR_DATA>
