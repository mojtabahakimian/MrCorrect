      <DataSource1 Ref="3" type="Stimulsoft.Report.Dictionary.StiSqlSource" isKey="true">
        <Alias>DataSource1</Alias>
        <Columns isList="true" count="13">
          <value>CODE,System.String</value>
          <value>SMEGH,System.Double</value>
          <value>SMEGHK,System.Double</value>
          <value>vahed,System.String</value>
          <value>KALA,System.String</value>
          <value>MANDAH,System.String</value>
          <value>smabk,System.Double</value>
          <value>TID,System.Int32</value>
          <value>TDATE,System.Int64</value>
          <value>TDRIVER,System.String</value>
          <value>TCITY,System.String</value>
          <value>TMAMUR,System.String</value>
          <value>ANBAR,System.Int32</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>c673d841c81248759cc2f1ca8470a252</Key>
        <Name>DataSource1</Name>
        <NameInSource>MS SQL</NameInSource>
        <Parameters isList="true" count="1">
          <value>TID_PARAM,,0,15</value>
        </Parameters>
        <SqlCommand>SELECT INVO_LST.CODE,
	SUM(INVO_LST.MEGH) AS SMEGH,
	SUM(INVO_LST.MEGHk) AS SMEGHK,
	TCOD_VAHEDS.NAMES AS vahed,
	STUF_DEF.NAME + N' ' + ISNULL(INVO_LST.MANDAH, N'') AS KALA,
	INVO_LST.MANDAH,
	SUM(INVO_LST.MABL_K) AS smabk,
	TOZIE.TID,
	TOZIE.TDATE,
	TOZIE.TDRIVER,
	TOZIE.TCITY,
	TOZIE.TMAMUR,
	INVO_LST.ANBAR
	FROM TOZIE_SUB
	INNER JOIN TOZIE
        ON TOZIE_SUB.TID = TOZIE.TID
    INNER JOIN INVO_LST
        INNER JOIN STUF_DEF
            ON INVO_LST.CODE = STUF_DEF.CODE
        INNER JOIN TCOD_VAHEDS
            ON INVO_LST.VAHED_K = TCOD_VAHEDS.CODE
        ON TOZIE_SUB.NUMBER = INVO_LST.NUMBER
WHERE (INVO_LST.TAG = 2)
GROUP BY INVO_LST.CODE,
         TCOD_VAHEDS.NAMES,
         STUF_DEF.NAME + N' ' + ISNULL(INVO_LST.MANDAH, N''),
         INVO_LST.MANDAH,
         TOZIE.TID,
         TOZIE.TDATE,
         TOZIE.TDRIVER,
         TOZIE.TCITY,
         TOZIE.TMAMUR,
         INVO_LST.ANBAR
HAVING (TOZIE.TID = @TID_PARAM);</SqlCommand>
      </DataSource1>
    </DataSources>
