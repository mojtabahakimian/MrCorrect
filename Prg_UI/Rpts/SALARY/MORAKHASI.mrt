        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>3807307ca87d4c6c95d368df97ff6d46</Key>
        <Name>DataSource1</Name>
        <NameInSource>MS SQL</NameInSource>
        <Parameters isList="true" count="1">
          <value>NUMBER_PARAM,,0,20</value>
        </Parameters>
        <SqlCommand>SELECT        PERSONEL_1.BIMEH_NUM, PERSONEL_1.KHNOWNUM, PERSONEL_1.FATHER, PERSONEL_1.WSDATE, PERSONEL_1.MELLICOD, dbo.PMORAKH.MODATE, dbo.PMORAKH.MORAKHDAY, dbo.PMORAKH.MAND, 
	dbo.PMORAKH.KINDM, dbo.PMORAKH.MOLAH, dbo.PMORAKH.CODE, dbo.PMORAKH.MOSTDATE, dbo.PMORAKH.MOENDATE, dbo.PMORAKH.IDNUM, dbo.PMORAKH.sgn1usid, dbo.PMORAKH.sgn2usid, 
	dbo.PMORAKH.sgn3usid, dbo.PMORAKH.SGN1, dbo.PMORAKH.SGN2, dbo.PMORAKH.SGN3, dbo.SALA_DTL.EMZA AS EMZA1, SALA_DTL_1.EMZA AS EMZA2, SALA_DTL_2.EMZA AS EMZA3,
	(SELECT        PNAME + N' ' + PFAMILY + N' ' + RTRIM(CAST(CODE AS NVARCHAR)) AS PER
                                FROM            dbo.PERSONEL
                                WHERE        (CODE = dbo.PMORAKH.CODE)) AS CODE_NAME
FROM            dbo.SALA_DTL RIGHT OUTER JOIN
                         dbo.SALA_DTL AS SALA_DTL_1 RIGHT OUTER JOIN
                         dbo.PERSONEL AS PERSONEL_1 INNER JOIN
                         dbo.PMORAKH ON PERSONEL_1.CODE = dbo.PMORAKH.CODE LEFT OUTER JOIN
                         dbo.SALA_DTL AS SALA_DTL_2 ON dbo.PMORAKH.sgn3usid = SALA_DTL_2.IDD ON SALA_DTL_1.IDD = dbo.PMORAKH.sgn2usid ON dbo.SALA_DTL.IDD = dbo.PMORAKH.sgn1usid
WHERE        (dbo.PMORAKH.IDNUM = @NUMBER_PARAM)</SqlCommand>
      </DataSource1>
    </DataSources>
