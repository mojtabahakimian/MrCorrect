        <Dictionary isRef="1" />
        <Key>41b7654f5de64171a3a54302c090e7a5</Key>
        <Name>MOGHAYERAT</Name>
        <NameInSource>MS SQL</NameInSource>
        <Parameters isList="true" count="1">
          <value>NUMBER_PARAM,,6,7</value>
        </Parameters>
        <SqlCommand>SELECT MOGHHEAD.MONUM, MOGHHEAD.MODATE, MOGHHEAD.ONVAN, MOGHHEAD.HES, MOGHHEAD.FDATE, MOGHHEAD.TDATE, MO_DTL.N_S, MO_DTL.SHARH, MO_DTL.BED, MO_DTL.BES, MO_DTL.TICK, CUST_HESAB.NAME, DEED_HED.DATE_S
	FROM MOGHHEAD
	INNER JOIN MO_DTL ON MOGHHEAD.MONUM=MO_DTL.MONUM
     INNER JOIN CUST_HESAB ON MOGHHEAD.HES=CUST_HESAB.hes
     INNER JOIN DEED_HED ON MO_DTL.N_S=DEED_HED.N_S
WHERE MOGHHEAD.MONUM = @NUMBER_PARAM</SqlCommand>
      </MOGHAYERAT>
    </DataSources>
