        <Name>KART_KALA</Name>
        <NameInSource>MS SQL</NameInSource>
        <Parameters isList="true" count="4">
          <value>AZDATE,,12,10</value>
          <value>ANBAR,,12,30</value>
          <value>TADATE,,12,10</value>
          <value>KALACODE,,12,30</value>
        </Parameters>
        <SqlCommand>SELECT NAME, CODE, NAMES, N_FANI, MEGK, mabl_a, MABLK, MEG, BARGAH, NUMBER, FNUMCO, DATE_N, BEDNAME, avrage, TAG, MABM, MEGKM
	FROM dbo.KART_KALA(@AZDATE, @ANBAR, @TADATE)
WHERE CODE=@KALACODE
ORDER BY CONVERT(BIGINT, CODE), DATE_N, BARGAH, NUMBER</SqlCommand>
      </KART_KALA>
