        <Key>5fa3aa05cf824847afeef38f56da2715</Key>
        <Name>DataSource1</Name>
        <NameInSource>MS SQL</NameInSource>
        <Parameters isList="true" count="1">
          <value>NUMBER_PARM,,6,7</value>
        </Parameters>
        <SqlCommand>SELECT STUF_DEF.CODE, STUF_DEF.NAME, STUF_FSK.ANBAR, TCOD_ANBAR.NAMES, ANBGRD_LST.GRD_NUM, TCOD_VAHEDS.NAMES AS vahed, STUF_FSK.POSITION FROM STUF_DEF INNER JOIN STUF_FSK ON STUF_DEF.CODE = STUF_FSK.CODE INNER JOIN TCOD_ANBAR ON STUF_FSK.ANBAR = TCOD_ANBAR.CODE INNER JOIN ANBGRD_LST ON STUF_DEF.CODE = ANBGRD_LST.CODE INNER JOIN TCOD_VAHEDS ON STUF_DEF.VAHED = TCOD_VAHEDS.CODE WHERE GRD_NUM = @NUMBER_PARM</SqlCommand>
      </DataSource1>
