    <DataSources isList="true" count="1">
      <DataSource2 Ref="3" type="Stimulsoft.Report.Dictionary.StiSqlSource" isKey="true">
        <Alias>DataSource2</Alias>
        <Columns isList="true" count="8">
          <value>CODE,System.String</value>
          <value>SMEGH,System.Double</value>
          <value>SMEGHK,System.Double</value>
          <value>vahed,System.String</value>
          <value>anbar,System.String</value>
          <value>KALA,System.String</value>
          <value>MANDAH,System.String</value>
          <value>smabk,System.Double</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>b2e26a1269294934a828715eaa101acd</Key>
        <Name>DataSource2</Name>
        <NameInSource>MS SQL</NameInSource>
        <Parameters isList="true" count="4">
          <value>ANBAR_TAG_PARM,,6,20</value>
          <value>FNUMBER_PARM,,6,20</value>
          <value>SNUMBER_PARM,,6,20</value>
          <value>TNUMBER_PARM,,6,20</value>
        </Parameters>
        <SqlCommand>SELECT INVO_LST.CODE, SUM(INVO_LST.MEGH) AS SMEGH, SUM(INVO_LST.MEGHk) AS SMEGHK, TCOD_VAHEDS.NAMES AS vahed, TCOD_ANBAR.NAMES AS anbar, STUF_DEF.NAME + N' ' + ISNULL(INVO_LST.MANDAH, N' ') AS KALA, INVO_LST.MANDAH, SUM(INVO_LST.MABL_K) AS smabk FROM INVO_LST INNER JOIN STUF_DEF ON INVO_LST.CODE = STUF_DEF.CODE INNER JOIN TCOD_VAHEDS ON INVO_LST.VAHED_K = TCOD_VAHEDS.CODE INNER JOIN TCOD_ANBAR ON INVO_LST.ANBAR = TCOD_ANBAR.CODE WHERE (INVO_LST.TAG = @ANBAR_TAG_PARM) AND (INVO_LST.NUMBER BETWEEN @FNUMBER_PARM AND @SNUMBER_PARM) AND (INVO_LST.ANBAR = @TNUMBER_PARM) GROUP BY INVO_LST.CODE, TCOD_VAHEDS.NAMES, TCOD_ANBAR.NAMES, STUF_DEF.NAME + N' ' + ISNULL(INVO_LST.MANDAH, N' '), INVO_LST.MANDAH</SqlCommand>
      </DataSource2>
    </DataSources>
