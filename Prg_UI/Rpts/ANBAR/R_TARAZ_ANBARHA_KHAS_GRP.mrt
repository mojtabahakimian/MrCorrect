        <Columns isList="true" count="17">
          <value>FII_FIRST,System.Double</value>
          <value>FII_AFZAYESH,System.Double</value>
          <value>FII_KAHESH,System.Double</value>
          <value>FII_END,System.Double</value>
          <value>MABL_END,System.Double</value>
          <value>CODE,System.Double</value>
          <value>MEG,System.Double</value>
          <value>SumOfMABL_A,System.Double</value>
          <value>MEGHKH,System.Double</value>
          <value>MABKH,System.Int64</value>
          <value>MEGFR,System.Double</value>
          <value>MABFR,System.Int64</value>
          <value>MEGMA,System.Double</value>
          <value>MABMA,System.Int64</value>
          <value>RADAH,System.Double</value>
          <value>grname,System.String</value>
          <value>GG,System.Int32</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>0cee87afb5554b71a3becb950694f7ab</Key>
        <Name>DataSource1</Name>
        <NameInSource>MS SQL</NameInSource>
        <Parameters isList="true" count="1">
          <value>ANBAR_PARM,,6,8</value>
        </Parameters>
        <SqlCommand>SELECT 
	[SumOfMABL_A] / CASE WHEN [MEG] = 0 THEN 1 ELSE [MEG] END AS FII_FIRST,
    [MABKH] / CASE WHEN [MEGHKH] = 0 THEN 1 ELSE [MEGHKH] END AS FII_AFZAYESH,
    [MABFR] / CASE WHEN [MEGFR] = 0 THEN 1 ELSE [MEGFR] END AS FII_KAHESH,
    ([SumOfMABL_A] + [MABKH] - [MABFR]) / 
    CASE 
        WHEN [MEGMA] = 0 THEN 1 
        ELSE [MEGMA] 
    END AS FII_END,
    [SumOfMABL_A] + [MABKH] - [MABFR] AS MABL_END,*
FROM TARAZ_ANBAR_KHAS_GRP(@ANBAR_PARM);
</SqlCommand>
      </DataSource1>
    </DataSources>
