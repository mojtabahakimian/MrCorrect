    <DataSources isList="true" count="1">
      <DataSource1 Ref="3" type="Stimulsoft.Report.Dictionary.StiSqlSource" isKey="true">
        <Alias>DataSource1</Alias>
        <Columns isList="true" count="10">
          <value>CODE,System.String</value>
          <value>NAME,System.String</value>
          <value>NAMES,System.String</value>
          <value>GRD_NUM,System.Int32</value>
          <value>vahed,System.String</value>
          <value>MOG,System.Double</value>
          <value>NUM1,System.Double</value>
          <value>ekht,System.Double</value>
          <value>GRD_ANBAR,System.Int32</value>
          <value>POSITION,System.String</value>
        </Columns>
        <CommandTimeout>30</CommandTimeout>
        <Dictionary isRef="1" />
        <Key>5e6708600f024f609a0385349c42d9a8</Key>
        <Name>DataSource1</Name>
        <NameInSource>MS SQL</NameInSource>
        <Parameters isList="true" count="1">
          <value>NUMBER_PARM,,6,7</value>
        </Parameters>
        <SqlCommand>SELECT "NAMES", "GRD_NUM", "NAME", "CODE", "vahed", "MOG", "NUM1", "ekht", "POSITION" FROM (SELECT STUF_DEF.CODE, STUF_DEF.NAME, TCOD_ANBAR.NAMES, ANBGRD_LST.GRD_NUM, TCOD_VAHEDS.NAMES AS vahed, ANBGRD_LST.MOG, ANBGRD_LST.NUM1, ANBGRD_LST.MOG - ANBGRD_LST.NUM1 AS ekht, ANBGRD_HEAD.GRD_ANBAR, STUF_FSK.POSITION FROM ANBGRD_HEAD INNER JOIN TCOD_ANBAR ON ANBGRD_HEAD.GRD_ANBAR = TCOD_ANBAR.CODE INNER JOIN STUF_DEF INNER JOIN ANBGRD_LST ON STUF_DEF.CODE = ANBGRD_LST.CODE INNER JOIN TCOD_VAHEDS ON STUF_DEF.VAHED = TCOD_VAHEDS.CODE ON ANBGRD_HEAD.GRD_NUM = ANBGRD_LST.GRD_NUM INNER JOIN STUF_FSK ON ANBGRD_LST.CODE = STUF_FSK.CODE AND ANBGRD_HEAD.GRD_ANBAR = STUF_FSK.ANBAR) AS DRVD_TBL WHERE (GRD_NUM = @NUMBER_PARM) ORDER BY POSITION , NAME</SqlCommand>
      </DataSource1>
    </DataSources>
