        <Key>d50ec06705d4485f82d373014a619bcc</Key>
        <Name>DataSource1</Name>
        <NameInSource>MS SQL</NameInSource>
        <Parameters isList="true" count="1">
          <value>NUMBER_PARAM,,8,15</value>
        </Parameters>
        <SqlCommand>SELECT dbo.PRICE_ELAMIE.PEPID,
	dbo.PRICE_ELAMIE.PEPNAME,
	dbo.PRICE_ELAMIE.PEPDATE,
	dbo.PRICE_ELAMIE.TR_DATE,
	dbo.PRICE_ELAMIE.USERNAME,
	dbo.PRICE_ELAMIE.SGN1,
	dbo.PRICE_ELAMIE.SGN2,
	dbo.PRICE_ELAMIE.SGN3,
	dbo.PRICE_ELAMIE.PEPDEPART,
	dbo.DEPART.DEPNAME,
	dbo.PRICE_ELAMIE_DTL.PGID,
	dbo.PRICE_GRP.PGNAME,
	dbo.PRICE_ELAMIE_DTL.PRICE1
	FROM dbo.PRICE_ELAMIE
	INNER JOIN dbo.PRICE_ELAMIE_DTL
        ON dbo.PRICE_ELAMIE.PEPID = dbo.PRICE_ELAMIE_DTL.PEPID
    INNER JOIN dbo.PRICE_GRP
        ON dbo.PRICE_ELAMIE_DTL.PGID = dbo.PRICE_GRP.PGID
    INNER JOIN dbo.DEPART
        ON dbo.PRICE_ELAMIE.PEPDEPART = dbo.DEPART.DEPATMAN
WHERE (dbo.PRICE_ELAMIE.PEPID = @NUMBER_PARAM);</SqlCommand>
      </DataSource1>
    </DataSources>
