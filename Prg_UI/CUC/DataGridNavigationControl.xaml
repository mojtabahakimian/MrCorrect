<UserControl x:Class="Prg_UI.CUC.DataGridNavigationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Prg_UI.CUC"
             mc:Ignorable="d" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             d:DesignHeight="50" d:DesignWidth="400">
    <UserControl.Resources>
        <!-- Style for circular buttons -->
        <Style x:Key="NavCircleButton" TargetType="Button" BasedOn="{StaticResource MaterialDesignFloatingActionMiniButton}" >
            <Setter Property="Margin" Value="3" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="{x:Null}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="1" />
            <Setter Property="Foreground" Value="{Binding ButtonForeground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

        <!-- Reload Data -->
        <Button x:Name="btnReload" Click="btnReload_Click"
                Visibility="{Binding ReloadButtonVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"
                IsEnabled="{Binding ReloadButtonEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Margin="3" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Style="{StaticResource GerdB}" BorderBrush="{x:Null}" VerticalAlignment="Bottom" Foreground="#DDFFFFFF" Width="40">
            <Viewbox Margin="-9,0,-9,0" Height="20" Width="20" >
                <materialDesign:PackIcon Kind="Refresh" />
            </Viewbox>
        </Button>

        <!-- First Record -->
        <Button x:Name="btnFirst" Click="btnFirst_Click"
                 Visibility="{Binding FirstButtonVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 IsEnabled="{Binding FirstButtonEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 Margin="3" Style="{StaticResource GerdB}" BorderBrush="{x:Null}"
                 RenderTransformOrigin="0.5,0.5"  FontSize="10" HorizontalAlignment="Right" Width="40" VerticalAlignment="Bottom">
            <materialDesign:PackIcon Kind="SkipNext"  HorizontalAlignment="Right" VerticalAlignment="Top" Height="20" Width="23" Foreground="#CCFFFFFF" RenderTransformOrigin="0.515,0.533"  FontSize="10" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Margin="-30,-1,-5,0">
                <materialDesign:PackIcon.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="-1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform X="4.946"/>
                    </TransformGroup>
                </materialDesign:PackIcon.RenderTransform>
            </materialDesign:PackIcon>
        </Button>

        <!-- Back Record -->
        <Button  x:Name="btnBack" Click="btnBack_Click"
                 Visibility="{Binding BackButtonVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 IsEnabled="{Binding BackButtonEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 Margin="3" Style="{StaticResource GerdB}" BorderBrush="{x:Null}"
                  RenderTransformOrigin="0.5,0.5"  FontSize="10" HorizontalAlignment="Right" Width="40" VerticalAlignment="Bottom" Grid.Row="1">
            <Button.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </Button.RenderTransform>
            <materialDesign:PackIcon  Kind="triangle"  HorizontalAlignment="Center" VerticalAlignment="Center" Height="15" Width="15" Foreground="#CCFFFFFF" RenderTransformOrigin="0.254,0.083"  FontSize="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0" Margin="-24,-13,-32,0">
                <materialDesign:PackIcon.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                        <SkewTransform/>
                        <RotateTransform Angle="90"/>
                        <TranslateTransform X="5" Y="10"/>
                    </TransformGroup>
                </materialDesign:PackIcon.RenderTransform>
            </materialDesign:PackIcon>
        </Button>

        <!-- Display current index -->
        <TextBlock x:Name="txtCurrent" Text="0" VerticalAlignment="Center" Margin="5" />
        <TextBlock Text=" / " VerticalAlignment="Center"/>
        <!-- Display total records -->
        <TextBlock x:Name="txtTotal" Text="0" VerticalAlignment="Center" Margin="5" />

        <!-- Next Record -->
        <Button x:Name="btnNext" Click="btnNext_Click"
                 Visibility="{Binding NextButtonVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 IsEnabled="{Binding NextButtonEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 Margin="3" Style="{StaticResource GerdB}" BorderBrush="{x:Null}"
                 RenderTransformOrigin="0.5,0.5"  FontSize="10" HorizontalAlignment="Right" Width="40" VerticalAlignment="Bottom">
            <materialDesign:PackIcon Kind="triangle"  HorizontalAlignment="Center" VerticalAlignment="Center" Height="15" Width="15" Foreground="#CCFFFFFF" RenderTransformOrigin="0.254,0.083"  FontSize="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0" Margin="-24,-13,-32,0">
                <materialDesign:PackIcon.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                        <SkewTransform/>
                        <RotateTransform Angle="90"/>
                        <TranslateTransform X="5" Y="10"/>
                    </TransformGroup>
                </materialDesign:PackIcon.RenderTransform>
            </materialDesign:PackIcon>
        </Button>

        <!-- Last Record -->
        <Button x:Name="btnLast" Click="btnLast_Click"
                Visibility="{Binding LastButtonVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"
                IsEnabled="{Binding LastButtonEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Margin="3" Style="{StaticResource GerdB}" BorderBrush="{x:Null}"
                RenderTransformOrigin="0.5,0.5"  FontSize="10"  VerticalAlignment="Bottom" HorizontalAlignment="Right" Width="40" Grid.Row="1">
            <materialDesign:PackIcon  Kind="SkipNext"  HorizontalAlignment="Center" VerticalAlignment="Center" Height="20" Width="21" Foreground="#CCFFFFFF" RenderTransformOrigin="0.206,0.45"  FontSize="10" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="26,-44,0,0" Margin="-19,0,-18,0">
                <materialDesign:PackIcon.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </materialDesign:PackIcon.RenderTransform>
            </materialDesign:PackIcon>
        </Button>

        <!-- New Record -->
        <Button x:Name="btnNew" Click="btnNew_Click"
                Visibility="{Binding NewButtonVisibility, RelativeSource={RelativeSource AncestorType=UserControl}}"
                IsEnabled="{Binding NewButtonEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                Margin="3" Style="{StaticResource GerdB}" BorderBrush="{x:Null}" RenderTransformOrigin="0.5,0.5"  FontSize="10" Width="40" VerticalAlignment="Bottom" HorizontalAlignment="Right">
            <materialDesign:PackIcon Kind="AddBold"  HorizontalAlignment="Center" VerticalAlignment="Center" Height="15" Width="15" Foreground="#CCFFFFFF" RenderTransformOrigin="0.254,0.083"  FontSize="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Padding="0" Margin="-24,-13,-32,0">
                <materialDesign:PackIcon.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.75" ScaleY="0.75"/>
                        <SkewTransform/>
                        <RotateTransform Angle="90"/>
                        <TranslateTransform X="5" Y="10"/>
                    </TransformGroup>
                </materialDesign:PackIcon.RenderTransform>
            </materialDesign:PackIcon>
        </Button>

    </StackPanel>
</UserControl>
