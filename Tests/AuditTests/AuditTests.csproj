<Project Sdk="Microsoft.NET.Sdk">

  <!--
    تست‌های سیستم سابقه.

    عمداً یک برنامه‌ی کنسولی ساده است و نه پروژه‌ی تست با فریم‌ورک:
    هدف net8.0 خالص است تا روی لینوکس و ویندوز و در CI بدون هیچ وابستگی
    اضافه‌ای اجرا شود. در صورت شکست کد خروجی غیرصفر برمی‌گرداند، پس CI
    خودش job را قرمز می‌کند.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AuditTests</AssemblyName>
    <RootNamespace>AuditTests</RootNamespace>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Prg_Proccessy\Prg_Proccessy.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- پارسر رسمی T-SQL مایکروسافت، برای اعتبارسنجی اسکریپت‌های مایگریشن -->
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="161.8905.0" />
  </ItemGroup>

</Project>
